import "std/io";
import "std/mem";
import "std/conv";

fn put(label: cstring, v: int64) {
  var buf: uint8[24];
  int_to_dec(&buf[0], v);
  print(str_from_cstr(label));
  println(str_from_cstr(&buf[0]));
}

fn fill(order: int32*, n: int32) {
  var i: int32 = 0;
  while (i < n) {
    order[i] = i;
    i = i + 1;
  }
}

fn main() -> int32 {
  var n: int32 = 128;
  var q: int32 = 54;
  var mark: uint8* = (uint8*)malloc((int64)n);
  var order: int32* = (int32*)malloc((int64)n * 4);
  fill(order, n);
  var taken: int32 = 0;
  var r: int32 = 0;
  while (r < n) {
    var cell: int64 = (int64)order[r];
    if (r < q) {
      mark[cell] = 1;
      taken = taken + 1;
    }
    r = r + 1;
  }
  put("taken = ", (int64)taken);
  put("expected 54", 0);
  return 0;
}
