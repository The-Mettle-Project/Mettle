// histogram.mettle - exercises --safe proof paths, vectorizer shapes,
// structs/methods, and decorator contracts.

const NBUCKETS: int32 = 64;
const SCALE: int32 = 3;

struct Stats {
  total: int32;
  peak: int32;
  peak_at: int32;

  method mean(count: int32) -> int32 {
    if (count == 0) {
      return 0;
    }
    return this.total / count;
  }
}

// Masked index: cannot leave [0, 63] whatever `src` holds.
// Unit-stride read of src with unknown extent -> one check for the loop range.
fn tally(src: uint8*, n: int64, buckets: int32*) {
  for i in 0..n {
    var b: int32 = (int32)src[i] & 63;
    buckets[b] = buckets[b] + 1;
  }
}

// Counted loop over a fixed-size object: should settle at compile time.
@noalloc fn seed(table: int32*) {
  for i in 0..64 {
    table[i] = (int32)i * SCALE;
  }
}

// Unit-stride int32 '+' reduction, straight-line body, matched accumulator
// width. This is the shape the vectorizer names.
fn checksum(buckets: int32*, n: int64) -> int32 {
  var acc: int32 = 0;
  for i in 0..n {
    acc += buckets[i];
  }
  return acc;
}

// Unit-stride map (a[i] = expr) over int32.
fn scale_all(dst: int32*, src: int32*, n: int64, k: int32) {
  for i in 0..n {
    dst[i] = src[i] * k;
  }
}

@pure @noinline fn weight(k: int32) -> int32 {
  var m: int32 = k;
  m = m ^ (m >> 7);
  m = m * 31;
  m = m + 11;
  return m & 255;
}

// Loop-invariant @pure call: weight(k) should hoist to the preheader.
// No store in the body, so hoisting is permitted.
fn weighted_sum(buckets: int32*, n: int64, k: int32) -> int32 {
  var acc: int32 = 0;
  for i in 0..n {
    acc += buckets[i] * weight(k);
  }
  return acc;
}

fn summarize(buckets: int32*, n: int64) -> Stats {
  var s: Stats;
  s.total = 0;
  s.peak = 0;
  s.peak_at = 0;
  for i in 0..n {
    var v: int32 = buckets[i];
    s.total = s.total + v;
    if (v > s.peak) {
      s.peak = v;
      s.peak_at = (int32)i;
    }
  }
  return s;
}

fn main() -> int32 {
  var buckets: int32[64];
  var scaled: int32[64];
  var data: uint8[256];

  seed(buckets);
  for i in 0..256 {
    data[i] = (uint8)(i * 7);
  }

  tally(data, 256, buckets);
  scale_all(scaled, buckets, 64, 2);

  var c: int32 = checksum(scaled, 64);
  var w: int32 = weighted_sum(buckets, 64, 7);
  var s: Stats = summarize(buckets, 64);

  return (c + w + s.peak + s.mean(64)) & 127;
}
