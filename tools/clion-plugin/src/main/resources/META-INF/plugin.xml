<idea-plugin>
  <id>org.mettle.clion</id>
  <name>Mettle</name>
  <vendor url="https://github.com/The-Mettle-Project/mettle-core">The Mettle Project</vendor>

  <description><![CDATA[
    <p>Language support for <b>Mettle</b>, the systems language of the
    <a href="https://github.com/The-Mettle-Project/mettle-core">mettle-core</a> toolchain.</p>
    <ul>
      <li>Syntax highlighting, brace matching, code folding, structure view and a formatter.</li>
      <li>Resolve and navigate functions, structs, enums, traits, fields, parameters and locals;
          <code>import</code> paths jump to the imported module.</li>
      <li>Inline compiler diagnostics: the real <code>mettle</code> compiler is run with
          <code>--error-format=json</code>, so errors, warnings and memory-safety findings
          (E0001-E0007, M0101-M0112) appear as you type, with their notes and
          <code>help:</code> suggestions.</li>
      <li>Run configurations that build with <code>--build</code> and run the native
          executable, run <code>mettle test</code>, or print the <code>--explain</code>
          optimization report.</li>
      <li>An interactive debugger that speaks the compiler's own <code>--debug-hooks</code>
          protocol: breakpoints (conditional too), stepping, the call stack, and live
          variables you can expand and edit. Windows only, as the runtime transport is.</li>
    </ul>
  ]]></description>

  <change-notes><![CDATA[
    <h4>0.1.0</h4>
    <ul><li>First release: language support, compiler diagnostics, run configurations, debugger.</li></ul>
  ]]></change-notes>

  <depends>com.intellij.modules.lang</depends>

  <idea-version since-build="251"/>

  <extensions defaultExtensionNs="com.intellij">
    <!-- Language registration -->
    <fileType name="Mettle" language="Mettle" extensions="mettle"
              implementationClass="org.mettle.clion.lang.MettleFileType" fieldName="INSTANCE"/>
    <lang.parserDefinition language="Mettle"
                           implementationClass="org.mettle.clion.lang.MettleParserDefinition"/>

    <!-- Editor -->
    <lang.syntaxHighlighterFactory language="Mettle"
                                   implementationClass="org.mettle.clion.highlight.MettleSyntaxHighlighterFactory"/>
    <colorSettingsPage implementation="org.mettle.clion.highlight.MettleColorSettingsPage"/>
    <annotator language="Mettle" implementationClass="org.mettle.clion.highlight.MettleAnnotator"/>
    <externalAnnotator language="Mettle"
                       implementationClass="org.mettle.clion.diagnostics.MettleExternalAnnotator"/>
    <lang.braceMatcher language="Mettle" implementationClass="org.mettle.clion.editor.MettleBraceMatcher"/>
    <lang.commenter language="Mettle" implementationClass="org.mettle.clion.editor.MettleCommenter"/>
    <lang.quoteHandler language="Mettle" implementationClass="org.mettle.clion.editor.MettleQuoteHandler"/>
    <lang.foldingBuilder language="Mettle" implementationClass="org.mettle.clion.editor.MettleFoldingBuilder"/>
    <lang.formatter language="Mettle" implementationClass="org.mettle.clion.editor.MettleFormattingModelBuilder"/>
    <lang.namesValidator language="Mettle" implementationClass="org.mettle.clion.editor.MettleNamesValidator"/>
    <lang.refactoringSupport language="Mettle"
                             implementationClass="org.mettle.clion.editor.MettleRefactoringSupportProvider"/>
    <lang.documentationProvider language="Mettle"
                                implementationClass="org.mettle.clion.editor.MettleDocumentationProvider"/>
    <lang.psiStructureViewFactory language="Mettle"
                                  implementationClass="org.mettle.clion.editor.MettleStructureViewFactory"/>
    <lang.findUsagesProvider language="Mettle"
                             implementationClass="org.mettle.clion.editor.MettleFindUsagesProvider"/>
    <completion.contributor language="Mettle"
                            implementationClass="org.mettle.clion.editor.MettleCompletionContributor"/>
    <gotoSymbolContributor implementation="org.mettle.clion.editor.MettleGotoSymbolContributor"/>
    <defaultLiveTemplates file="/liveTemplates/Mettle.xml"/>
    <liveTemplateContext contextId="METTLE"
                         implementation="org.mettle.clion.editor.MettleTemplateContextType"/>

    <!-- Toolchain settings -->
    <projectService serviceImplementation="org.mettle.clion.settings.MettleSettings"/>
    <projectConfigurable parentId="language" id="org.mettle.clion.settings"
                         displayName="Mettle"
                         instance="org.mettle.clion.settings.MettleConfigurable"/>

    <!-- Run / build -->
    <configurationType implementation="org.mettle.clion.run.MettleRunConfigurationType"/>
    <runConfigurationProducer implementation="org.mettle.clion.run.MettleRunConfigurationProducer"/>
    <runLineMarkerContributor language="Mettle"
                              implementationClass="org.mettle.clion.run.MettleRunLineMarkerContributor"/>
    <consoleFilterProvider implementation="org.mettle.clion.run.MettleConsoleFilterProvider"/>

    <!-- Debugger -->
    <programRunner implementation="org.mettle.clion.debug.MettleDebugRunner"/>
    <xdebugger.breakpointType implementation="org.mettle.clion.debug.MettleLineBreakpointType"/>

    <!-- Optimization report -->
    <toolWindow id="Mettle Optimization" anchor="bottom" canCloseContents="false"
                icon="/icons/mettle.svg"
                factoryClass="org.mettle.clion.explain.MettleExplainToolWindowFactory"/>
    <intentionAction>
      <language>Mettle</language>
      <className>org.mettle.clion.explain.MettleExplainIntention</className>
      <category>Mettle</category>
    </intentionAction>
  </extensions>

  <projectListeners>
    <listener class="org.mettle.clion.explain.MettleExplainSaveListener"
              topic="com.intellij.openapi.vfs.newvfs.BulkFileListener"/>
  </projectListeners>

  <actions>
    <action id="Mettle.OptimizationReport"
            class="org.mettle.clion.explain.MettleExplainAction"
            text="Optimization Report"
            description="Compile this file with --release --explain and show what the optimizer did"
            icon="/icons/mettle.svg">
      <add-to-group group-id="EditorPopupMenu" anchor="last"/>
      <add-to-group group-id="ProjectViewPopupMenu" anchor="last"/>
      <keyboard-shortcut keymap="$default" first-keystroke="control alt shift E"/>
    </action>
  </actions>
</idea-plugin>
