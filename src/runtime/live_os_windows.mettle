extern fn mettle_live_os_alloc(address: int64, size: int64, kind: uint32, protect: uint32) -> int64 = "VirtualAlloc";
extern fn mettle_live_os_protect(address: int64, size: int64, protect: uint32, old: uint32*) -> int32 = "VirtualProtect";
extern fn mettle_live_os_free(address: int64, size: int64, kind: uint32) -> int32 = "VirtualFree";
extern fn mettle_live_os_module_name(module: int64, buffer: uint8*, size: uint32) -> uint32 = "GetModuleFileNameA";
extern fn mettle_live_os_open(name: uint8*, access: uint32, share: uint32, security: int64, disposition: uint32, flags: uint32, template: int64) -> int64 = "CreateFileA";
extern fn mettle_live_os_file_size(file: int64, size: int64*) -> int32 = "GetFileSizeEx";
extern fn mettle_live_os_read(file: int64, buffer: int64, count: uint32, done: uint32*, overlapped: int64) -> int32 = "ReadFile";
extern fn mettle_live_os_close(handle: int64) -> int32 = "CloseHandle";
extern fn mettle_live_os_ticks() -> uint64 = "GetTickCount64";
extern fn mettle_live_os_std_handle(which: int32) -> int64 = "GetStdHandle";
extern fn mettle_live_os_write(file: int64, buffer: uint8*, count: uint32, done: uint32*, overlapped: int64) -> int32 = "WriteFile";
extern fn mettle_live_os_process() -> int64 = "GetCurrentProcess";
extern fn mettle_live_os_flush(process: int64, address: int64, size: int64) -> int32 = "FlushInstructionCache";
extern fn mettle_live_os_lock(lock: int64*) = "AcquireSRWLockExclusive";
extern fn mettle_live_os_unlock(lock: int64*) = "ReleaseSRWLockExclusive";
extern fn mettle_live_os_load(name: int64) -> int64 = "LoadLibraryA";
extern fn mettle_live_os_proc(module: int64, name: int64) -> int64 = "GetProcAddress";
extern fn mettle_live_os_snapshot(flags: uint32, process: uint32) -> int64 = "CreateToolhelp32Snapshot";
extern fn mettle_live_os_thread_first(snapshot: int64, entry: uint8*) -> int32 = "Thread32First";
extern fn mettle_live_os_thread_next(snapshot: int64, entry: uint8*) -> int32 = "Thread32Next";
extern fn mettle_live_os_open_thread(access: uint32, inherit: int32, id: uint32) -> int64 = "OpenThread";
extern fn mettle_live_os_suspend(thread: int64) -> uint32 = "SuspendThread";
extern fn mettle_live_os_resume(thread: int64) -> uint32 = "ResumeThread";
extern fn mettle_live_os_process_id() -> uint32 = "GetCurrentProcessId";
extern fn mettle_live_os_thread_id() -> uint32 = "GetCurrentThreadId";
extern fn mettle_live_os_sleep(milliseconds: uint32) = "Sleep";

var mettle_live_os_threads: int64[1024];
var mettle_live_os_thread_count: int64 = 0;
var mettle_live_os_thread_entry: uint8[32];

fn mettle_live_os_u32(address: int64) -> int64 {
    var p: uint32* = (uint32*)address;
    return (int64)*p;
}

export fn mettle_live_port_write(buffer: uint8*, length: int64) {
    var written: uint32 = (uint32)0;
    mettle_live_os_write(mettle_live_os_std_handle(-12), buffer, (uint32)length, &written, 0);
}

export fn mettle_live_port_lock(lock: int64*) {
    mettle_live_os_lock(lock);
}

export fn mettle_live_port_unlock(lock: int64*) {
    mettle_live_os_unlock(lock);
}

export fn mettle_live_port_ticks() -> uint64 {
    return mettle_live_os_ticks();
}

export fn mettle_live_port_alloc(size: int64) -> int64 {
    return mettle_live_os_alloc(0, size, (uint32)0x3000, (uint32)0x04);
}

export fn mettle_live_port_free(address: int64, size: int64) {
    mettle_live_os_free(address, 0, (uint32)0x8000);
}

export fn mettle_live_port_alloc_near(base: int64, size: int64) -> int64 {
    var headers: int64 = base + mettle_live_os_u32(base + 60);
    var image: int64 = mettle_live_os_u32(headers + 80);
    var at: int64 = ((base + image + 65535) / 65536) * 65536;
    var limit: int64 = base + 0x70000000;
    while (at + size < limit) {
        var got: int64 = mettle_live_os_alloc(at, size, (uint32)0x3000, (uint32)0x04);
        if (got != 0) {
            return got;
        }
        at = at + 65536;
    }
    return 0;
}

export fn mettle_live_port_code_store(address: int64, value: int64) {
    var old: uint32 = (uint32)0;
    var ignored: uint32 = (uint32)0;
    mettle_live_os_protect(address, 8, (uint32)0x40, &old);
    var word: int64* = (int64*)address;
    *word = value;
    mettle_live_os_protect(address, 8, old, &ignored);
    mettle_live_os_flush(mettle_live_os_process(), address, 8);
}

@naked export fn mettle_live_site_check(flag: int64, table: string, key: int64, owner: string) -> int64 {
    asm {
        lea r10, [rsp + 8]
        push rcx
        push rdx
        push r8
        push r9
        mov rcx, r10
        sub rsp, 40
        call mettle_live_resume_slot
        add rsp, 40
        pop r9
        pop r8
        pop rdx
        pop rcx
        test rax, rax
        jz site_skip
        mov [rax], rbx
        mov [rax + 8], rbp
        mov [rax + 16], rdi
        mov [rax + 24], rsi
        mov [rax + 32], r12
        mov [rax + 40], r13
        mov [rax + 48], r14
        mov [rax + 56], r15
        lea r10, [rsp + 8]
        mov [rax + 64], r10
        mov r10, [rsp]
        mov [rax + 72], r10
        movdqu [rax + 128], xmm6
        movdqu [rax + 144], xmm7
        movdqu [rax + 160], xmm8
        movdqu [rax + 176], xmm9
        movdqu [rax + 192], xmm10
        movdqu [rax + 208], xmm11
        movdqu [rax + 224], xmm12
        movdqu [rax + 240], xmm13
        movdqu [rax + 256], xmm14
        movdqu [rax + 272], xmm15
    site_skip:
        jmp mettle_live_frame_check
    }
}

@naked export fn mettle_live_site_leave_here() {
    asm {
        lea rcx, [rsp + 8]
        jmp mettle_live_site_leave
    }
}

@naked export fn mettle_live_resume_jump(slot: int64) {
    asm {
        mov rax, rcx
        mov rbx, [rax]
        mov rbp, [rax + 8]
        mov rdi, [rax + 16]
        mov rsi, [rax + 24]
        mov r12, [rax + 32]
        mov r13, [rax + 40]
        mov r14, [rax + 48]
        mov r15, [rax + 56]
        movdqu xmm6, [rax + 128]
        movdqu xmm7, [rax + 144]
        movdqu xmm8, [rax + 160]
        movdqu xmm9, [rax + 176]
        movdqu xmm10, [rax + 192]
        movdqu xmm11, [rax + 208]
        movdqu xmm12, [rax + 224]
        movdqu xmm13, [rax + 240]
        movdqu xmm14, [rax + 256]
        movdqu xmm15, [rax + 272]
        mov rsp, [rax + 64]
        mov r10, [rax + 72]
        mov rax, 1
        jmp r10
    }
}

export fn mettle_live_port_thread_id() -> int64 {
    return (int64)mettle_live_os_thread_id();
}

export fn mettle_live_port_sleep(milliseconds: int64) {
    mettle_live_os_sleep((uint32)milliseconds);
}

export fn mettle_live_port_seal(address: int64, size: int64) -> int64 {
    var old: uint32 = (uint32)0;
    if (mettle_live_os_protect(address, size, (uint32)0x20, &old) == 0) {
        return 0;
    }
    mettle_live_os_flush(mettle_live_os_process(), address, size);
    return 1;
}

export fn mettle_live_port_exe_path(buffer: uint8*, capacity: int64) -> int64 {
    return (int64)mettle_live_os_module_name(0, buffer, (uint32)capacity);
}

export fn mettle_live_port_read(path: uint8*, size_out: int64*) -> int64 {
    var file: int64 = mettle_live_os_open(path, (uint32)0x80000000, (uint32)7, 0, (uint32)3, (uint32)0x80, 0);
    if (file == -1) {
        return 0;
    }
    var size: int64 = 0;
    if (mettle_live_os_file_size(file, &size) == 0 || size < 64 || size > 0x40000000) {
        mettle_live_os_close(file);
        return -1;
    }
    var buffer: int64 = mettle_live_os_alloc(0, size, (uint32)0x3000, (uint32)0x04);
    if (buffer == 0) {
        mettle_live_os_close(file);
        return -1;
    }
    var done: uint32 = (uint32)0;
    var ok: int32 = mettle_live_os_read(file, buffer, (uint32)size, &done, 0);
    mettle_live_os_close(file);
    if (ok == 0 || (int64)done != size) {
        mettle_live_os_free(buffer, 0, (uint32)0x8000);
        return -1;
    }
    *size_out = size;
    return buffer;
}

export fn mettle_live_port_bind(library: int64, name: int64) -> int64 {
    var module: int64 = mettle_live_os_load(library);
    if (module == 0) {
        return 0;
    }
    return mettle_live_os_proc(module, name);
}

export fn mettle_live_port_suspend_others() {
    mettle_live_os_thread_count = 0;
    var snapshot: int64 = mettle_live_os_snapshot((uint32)4, (uint32)0);
    if (snapshot == -1 || snapshot == 0) {
        return;
    }
    var size: uint32* = (uint32*)&mettle_live_os_thread_entry[0];
    *size = (uint32)28;
    var process: int64 = (int64)mettle_live_os_process_id();
    var self: int64 = (int64)mettle_live_os_thread_id();
    var more: int32 = mettle_live_os_thread_first(snapshot, &mettle_live_os_thread_entry[0]);
    while (more != 0) {
        var entry: int64 = (int64)&mettle_live_os_thread_entry[0];
        var id: int64 = mettle_live_os_u32(entry + 8);
        var owner: int64 = mettle_live_os_u32(entry + 12);
        if (owner == process && id != self && mettle_live_os_thread_count < 1024) {
            var thread: int64 = mettle_live_os_open_thread((uint32)2, 0, (uint32)id);
            if (thread != 0) {
                if (mettle_live_os_suspend(thread) != (uint32)0xFFFFFFFF) {
                    mettle_live_os_threads[mettle_live_os_thread_count] = thread;
                    mettle_live_os_thread_count = mettle_live_os_thread_count + 1;
                } else {
                    mettle_live_os_close(thread);
                }
            }
        }
        *size = (uint32)28;
        more = mettle_live_os_thread_next(snapshot, &mettle_live_os_thread_entry[0]);
    }
    mettle_live_os_close(snapshot);
}

export fn mettle_live_port_resume_others() {
    var i: int64 = 0;
    while (i < mettle_live_os_thread_count) {
        mettle_live_os_resume(mettle_live_os_threads[i]);
        mettle_live_os_close(mettle_live_os_threads[i]);
        i = i + 1;
    }
    mettle_live_os_thread_count = 0;
}
