import "live_os_windows" if windows;
import "live_os_linux" if linux;

extern fn mettle_swap_apply() -> int64;

extern fn mettle_crash_register_extra_code(functions: int64, function_count: int64, locations: int64, location_count: int64);

const METTLE_LIVE_MAGIC: int64 = 0x48435441504C544D;
const METTLE_LIVE_PROBE_MS: uint64 = 50;

export var mettle_live_anchor: int64 = 1;
export var mettle_live_spare_slots: int64[4096];
export var mettle_live_arena: uint8[1048576];

var mettle_live_path: uint8[1100];
var mettle_live_path_length: int64 = 0;
var mettle_live_ready: int64 = 0;
var mettle_live_next: int64 = 1;
var mettle_live_last_probe: uint64 = 0;
var mettle_live_message: uint8[300];
var mettle_live_poll_lock: int64 = 0;
var mettle_live_message_lock: int64 = 0;
var mettle_live_heap_lock: int64 = 0;
var mettle_live_undo_logs: int64[4096];
var mettle_live_undo_counts: int64[4096];
var mettle_live_undo_moves: int64[4096];
var mettle_live_undo_move_counts: int64[4096];
var mettle_live_applied: int64[4096];
var mettle_live_applied_count: int64 = 0;
var mettle_live_blob_starts: int64[4096];
var mettle_live_blob_sizes: int64[4096];
var mettle_live_blob_count: int64 = 0;
var mettle_live_frame_lock: int64 = 0;

fn mettle_live_text(at: int64, text: string) -> int64 {
    if (at == 0) {
        mettle_live_port_lock(&mettle_live_message_lock);
    }
    var i: int64 = 0;
    var n: int64 = (int64)text.length;
    while (i < n && at + i < 290) {
        mettle_live_message[at + i] = text.chars[i];
        i = i + 1;
    }
    return at + i;
}

fn mettle_live_number(at: int64, value: int64) -> int64 {
    var digits: int64 = 1;
    var probe: int64 = value;
    while (probe >= 10) {
        probe = probe / 10;
        digits = digits + 1;
    }
    if (at + digits >= 290) {
        return at;
    }
    var i: int64 = at + digits;
    var v: int64 = value;
    while (i > at) {
        i = i - 1;
        mettle_live_message[i] = (uint8)(48 + v % 10);
        v = v / 10;
    }
    return at + digits;
}

fn mettle_live_send(length: int64) {
    mettle_live_message[length] = (uint8)10;
    mettle_live_port_write(&mettle_live_message[0], length + 1);
    mettle_live_port_unlock(&mettle_live_message_lock);
}

fn mettle_live_refuse(index: int64, reason: string) {
    var at: int64 = mettle_live_text(0, "[live] patch ");
    at = mettle_live_number(at, index);
    at = mettle_live_text(at, " refused: ");
    at = mettle_live_text(at, reason);
    mettle_live_send(at);
}

fn mettle_live_u32(address: int64) -> int64 {
    var p: uint32* = (uint32*)address;
    return (int64)*p;
}

fn mettle_live_u64(address: int64) -> int64 {
    var p: int64* = (int64*)address;
    return *p;
}

fn mettle_live_cstring_length(address: int64) -> int64 {
    var bytes: uint8* = (uint8*)address;
    var n: int64 = 0;
    while (bytes[n] != (uint8)0) {
        n = n + 1;
    }
    return n;
}

fn mettle_live_bind_imports(index: int64, code: int64, at: int64, count: int64) -> int64 {
    var start: int64 = at;
    var i: int64 = 0;
    while (i < count) {
        var slot: int64 = mettle_live_u32(at);
        var dll: int64 = at + 8;
        var name: int64 = dll + mettle_live_cstring_length(dll) + 1;
        var next: int64 = name + mettle_live_cstring_length(name) + 1;
        var proc: int64 = mettle_live_port_bind(dll, name);
        if (proc == 0) {
            mettle_live_refuse(index, "an imported function could not be found");
            return 0;
        }
        var target: int64* = (int64*)(code + slot);
        *target = proc;
        at = start + ((next - start + 7) / 8) * 8;
        i = i + 1;
    }
    return 1;
}

fn mettle_live_copy(target: int64, source: int64, count: int64) {
    var i: int64 = 0;
    var t: uint8* = (uint8*)target;
    var s: uint8* = (uint8*)source;
    while (i < count) {
        t[i] = s[i];
        i = i + 1;
    }
}

fn mettle_live_prepare_path() -> int64 {
    var n: int64 = mettle_live_port_exe_path(&mettle_live_path[0], 1024);
    if (n <= 0 || n >= 1024) {
        return 0;
    }
    var suffix: string = ".live.d/";
    var i: int64 = 0;
    while (i < (int64)suffix.length) {
        mettle_live_path[n + i] = suffix.chars[i];
        i = i + 1;
    }
    mettle_live_path_length = n + i;
    return 1;
}

fn mettle_live_name_patch(index: int64) {
    var at: int64 = mettle_live_path_length;
    var v: int64 = index;
    var d: int64 = 5;
    while (d >= 0) {
        mettle_live_path[at + d] = (uint8)(48 + v % 10);
        v = v / 10;
        d = d - 1;
    }
    var ext: string = ".mpatch";
    var i: int64 = 0;
    while (i < (int64)ext.length) {
        mettle_live_path[at + 6 + i] = ext.chars[i];
        i = i + 1;
    }
    mettle_live_path[at + 6 + i] = (uint8)0;
}

fn mettle_live_read(size_out: int64*) -> int64 {
    return mettle_live_port_read(&mettle_live_path[0], size_out);
}

fn mettle_live_alloc_near(base: int64, size: int64) -> int64 {
    return mettle_live_port_alloc_near(base, size);
}

fn mettle_live_container(address: int64) -> int64 {
    var i: int64 = 0;
    while (i < mettle_live_blob_count) {
        if (address >= mettle_live_blob_starts[i] && address < mettle_live_blob_starts[i] + mettle_live_blob_sizes[i]) {
            return i;
        }
        i = i + 1;
    }
    return -1;
}

fn mettle_live_undo(index: int64, target: int64) -> int64 {
    if (mettle_live_applied_count == 0 || mettle_live_applied[mettle_live_applied_count - 1] != target) {
        mettle_live_refuse(index, "only the latest applied patch can be undone");
        return 0;
    }
    var slot: int64 = mettle_live_applied_count - 1;
    var log: int64 = mettle_live_undo_logs[slot];
    var k: int64 = mettle_live_undo_counts[slot] - 1;
    mettle_live_port_suspend_others();
    var moves: int64 = mettle_live_undo_moves[slot];
    var m: int64 = mettle_live_undo_move_counts[slot] - 1;
    while (moves != 0 && m >= 0) {
        var back: int64* = (int64*)(moves + m * 48);
        var old_text: uint8* = (uint8*)back[2];
        mettle_live_frame_zero(back[0], mettle_live_desc_size(old_text, back[3], 0));
        mettle_live_convert(back[0], old_text, back[3], 0, back[1], (uint8*)back[4], back[5], 0);
        m = m - 1;
    }
    while (k >= 0) {
        var spot: int64 = mettle_live_u64(log + k * 16);
        if ((spot & 1) != 0) {
            mettle_live_port_code_store(spot - 1, mettle_live_u64(log + k * 16 + 8));
        } else {
            var place: int64* = (int64*)spot;
            *place = mettle_live_u64(log + k * 16 + 8);
        }
        k = k - 1;
    }
    mettle_live_port_resume_others();
    mettle_live_applied_count = slot;
    var at: int64 = mettle_live_text(0, "[live] patch ");
    at = mettle_live_number(at, index);
    at = mettle_live_text(at, " undoes patch ");
    at = mettle_live_number(at, target);
    mettle_live_send(at);
    return 1;
}

fn mettle_live_apply(index: int64, buffer: int64, size: int64) -> int64 {
    if (mettle_live_u64(buffer) != METTLE_LIVE_MAGIC || mettle_live_u32(buffer + 8) != 2) {
        mettle_live_refuse(index, "not a patch this runtime can read");
        return 0;
    }
    var undo_target: int64 = mettle_live_u32(buffer + 72);
    if (undo_target != 0) {
        return mettle_live_undo(index, undo_target);
    }
    if (mettle_live_applied_count >= 4096) {
        mettle_live_refuse(index, "the program has taken 4096 patches; restart it");
        return 0;
    }
    var anchor_rva: int64 = mettle_live_u64(buffer + 16);
    var blob_size: int64 = mettle_live_u64(buffer + 24);
    var fixups: int64 = mettle_live_u32(buffer + 32);
    var swaps: int64 = mettle_live_u32(buffer + 36);
    var inits: int64 = mettle_live_u32(buffer + 40);
    var functions: int64 = mettle_live_u32(buffer + 44);
    var blob: int64 = buffer + 80;
    var fixup_at: int64 = blob + ((blob_size + 7) / 8) * 8;
    var swap_at: int64 = fixup_at + fixups * 24;
    var init_at: int64 = swap_at + swaps * 16;
    var import_count: int64 = mettle_live_u32(buffer + 64);
    var import_at: int64 = init_at + inits * 24;
    var migrations: int64 = mettle_live_u32(buffer + 76);
    var migration_at: int64 = import_at + mettle_live_u32(buffer + 68);
    if (blob_size <= 0 || migration_at + migrations * 32 > buffer + size) {
        mettle_live_refuse(index, "the file is truncated");
        return 0;
    }
    var base: int64 = (int64)&mettle_live_anchor - anchor_rva;
    var code: int64 = mettle_live_alloc_near(base, blob_size);
    if (code == 0) {
        mettle_live_refuse(index, "no memory within reach of the program");
        return 0;
    }
    mettle_live_copy(code, blob, blob_size);
    var i: int64 = 0;
    while (i < inits) {
        var entry: int64 = init_at + i * 24;
        mettle_live_copy(base + mettle_live_u64(entry), blob + mettle_live_u64(entry + 8), mettle_live_u64(entry + 16));
        i = i + 1;
    }
    i = 0;
    while (i < fixups) {
        var fixup: int64 = fixup_at + i * 24;
        var site: int64 = mettle_live_u32(fixup);
        var kind: int64 = mettle_live_u32(fixup + 4);
        var target: int64 = mettle_live_u64(fixup + 8) + mettle_live_u64(fixup + 16);
        var site_address: int64 = code + site;
        if ((kind & 0x100) != 0) {
            site_address = base + site;
        }
        var target_address: int64 = code + target;
        if ((kind & 0x200) != 0) {
            target_address = base + target;
        }
        if ((kind & 0x400) != 0) {
            i = i + 1;
            continue;
        }
        if ((kind & 0xFF) == 1) {
            var wide: int64* = (int64*)site_address;
            *wide = target_address;
        } else if ((kind & 0xFF) == 3) {
            if (target_address > 2147483647 || target_address < -2147483648) {
                mettle_live_refuse(index, "an absolute address does not fit in 32 bits");
                return 0;
            }
            var small: int32* = (int32*)site_address;
            *small = (int32)target_address;
        } else if ((kind & 0xFF) == 2) {
            var distance: int64 = target_address - (site_address + 4);
            if (distance > 2147483647 || distance < -2147483648) {
                mettle_live_refuse(index, "a displacement does not reach");
                return 0;
            }
            var narrow: int32* = (int32*)site_address;
            *narrow = (int32)distance;
        } else {
            mettle_live_refuse(index, "unknown fixup kind");
            return 0;
        }
        i = i + 1;
    }
    if (import_count > 0 && mettle_live_bind_imports(index, code, import_at, import_count) == 0) {
        return 0;
    }
    if (mettle_live_port_seal(code, blob_size) == 0) {
        mettle_live_refuse(index, "the code could not be made executable");
        return 0;
    }
    if (mettle_live_blob_count < 4096) {
        mettle_live_blob_starts[mettle_live_blob_count] = code;
        mettle_live_blob_sizes[mettle_live_blob_count] = blob_size;
        mettle_live_blob_count = mettle_live_blob_count + 1;
    }
    var debug_functions: int64 = mettle_live_u32(buffer + 52);
    if (debug_functions > 0) {
        var debug_locations: int64 = mettle_live_u32(buffer + 60);
        var locations_at: int64 = 0;
        if (debug_locations > 0) {
            locations_at = code + mettle_live_u32(buffer + 56);
        }
        mettle_crash_register_extra_code(code + mettle_live_u32(buffer + 48), debug_functions, locations_at, debug_locations);
    }
    i = 0;
    var log: int64 = mettle_live_heap((swaps + fixups) * 16 + 16);
    var logged: int64 = 0;
    var moves: int64 = 0;
    if (migrations > 0) {
        moves = mettle_live_heap(migrations * 48);
    }
    mettle_live_port_suspend_others();
    var m: int64 = 0;
    while (m < migrations) {
        var move: int64 = migration_at + m * 32;
        var old_place: int64 = base + mettle_live_u32(move);
        var new_place: int64 = base + mettle_live_u32(move + 4);
        var new_size: int64 = mettle_live_u32(move + 8);
        var old_text: int64 = code + mettle_live_u32(move + 12);
        var new_text: int64 = code + mettle_live_u32(move + 20);
        mettle_live_frame_zero(new_place, new_size);
        mettle_live_convert(new_place, (uint8*)new_text, mettle_live_u32(move + 24), 0, old_place, (uint8*)old_text, mettle_live_u32(move + 16), 0);
        if (moves != 0) {
            var record: int64* = (int64*)(moves + m * 48);
            record[0] = old_place;
            record[1] = new_place;
            record[2] = old_text;
            record[3] = mettle_live_u32(move + 16);
            record[4] = new_text;
            record[5] = mettle_live_u32(move + 24);
        }
        m = m + 1;
    }
    while (i < swaps) {
        var swap: int64 = swap_at + i * 16;
        var target_rva: int64 = mettle_live_u64(swap);
        var body: int64 = code + mettle_live_u64(swap + 8);
        if (target_rva < 0) {
            var entry_at: int64 = base + (target_rva & 0x7FFFFFFFFFFFFFFF);
            var before: int64 = mettle_live_u64(entry_at);
            var tail: int64 = -1;
            var low: int64 = 4294967295;
            tail = tail << 40;
            var jump: int64 = (before & tail) | 0xE9 | (((body - (entry_at + 5)) & low) << 8);
            if (log != 0) {
                var undo_code: int64* = (int64*)(log + logged * 16);
                undo_code[0] = entry_at + 1;
                undo_code[1] = before;
                logged = logged + 1;
            }
            mettle_live_port_code_store(entry_at, jump);
        } else {
            var slot: int64* = (int64*)(base + target_rva);
            if (log != 0) {
                var entry: int64* = (int64*)(log + logged * 16);
                entry[0] = (int64)slot;
                entry[1] = *slot;
                logged = logged + 1;
            }
            *slot = body;
        }
        i = i + 1;
    }
    i = 0;
    while (i < fixups) {
        var late: int64 = fixup_at + i * 24;
        var late_kind: int64 = mettle_live_u32(late + 4);
        if ((late_kind & 0x400) != 0 && (late_kind & 0xFF) == 1) {
            var flag: int64* = (int64*)(base + mettle_live_u32(late));
            var value: int64 = code + mettle_live_u64(late + 8) + mettle_live_u64(late + 16);
            if ((late_kind & 0x200) != 0) {
                value = base + mettle_live_u64(late + 8) + mettle_live_u64(late + 16);
            }
            if (log != 0) {
                var record: int64* = (int64*)(log + logged * 16);
                record[0] = (int64)flag;
                record[1] = *flag;
                logged = logged + 1;
            }
            *flag = value;
        }
        i = i + 1;
    }
    mettle_live_port_resume_others();
    mettle_live_undo_logs[mettle_live_applied_count] = log;
    mettle_live_undo_counts[mettle_live_applied_count] = logged;
    mettle_live_undo_moves[mettle_live_applied_count] = moves;
    mettle_live_undo_move_counts[mettle_live_applied_count] = migrations;
    mettle_live_applied[mettle_live_applied_count] = index;
    mettle_live_applied_count = mettle_live_applied_count + 1;
    var at: int64 = mettle_live_text(0, "[live] patch ");
    at = mettle_live_number(at, index);
    at = mettle_live_text(at, ": ");
    at = mettle_live_number(at, functions);
    if (functions == 1) {
        at = mettle_live_text(at, " function");
    } else {
        at = mettle_live_text(at, " functions");
    }
    mettle_live_send(at);
    return 1;
}

fn mettle_live_poll() {
    if (mettle_live_ready == 0) {
        mettle_live_ready = 2;
        if (mettle_live_prepare_path() != 0) {
            mettle_live_ready = 1;
        }
    }
    if (mettle_live_ready != 1) {
        return;
    }
    while (1 == 1) {
        mettle_live_name_patch(mettle_live_next);
        var size: int64 = 0;
        var buffer: int64 = mettle_live_read(&size);
        if (buffer == 0) {
            return;
        }
        if (buffer == -1) {
            mettle_live_refuse(mettle_live_next, "the file could not be read");
        } else {
            mettle_live_apply(mettle_live_next, buffer, size);
            mettle_live_port_free(buffer, size);
        }
        mettle_live_next = mettle_live_next + 1;
    }
}

export fn mettle_live_quiesce() -> int64 {
    var now: uint64 = mettle_live_port_ticks();
    if (mettle_live_last_probe == (uint64)0 || now - mettle_live_last_probe >= METTLE_LIVE_PROBE_MS) {
        mettle_live_port_lock(&mettle_live_poll_lock);
        if (mettle_live_last_probe == (uint64)0 || now - mettle_live_last_probe >= METTLE_LIVE_PROBE_MS) {
            mettle_live_last_probe = now;
            mettle_live_poll();
        }
        mettle_live_port_unlock(&mettle_live_poll_lock);
    }
    return mettle_swap_apply();
}

const METTLE_LIVE_FRAME_LIMIT: int64 = 1024;
const METTLE_LIVE_SCRATCH_SIZE: int64 = 4194304;
const METTLE_LIVE_HEAP_CHUNK: int64 = 1048576;

var mettle_live_frame_names: string[1024];
var mettle_live_frame_keys: int64[1024];
var mettle_live_frame_sizes: int64[1024];
var mettle_live_frame_places: int64[1024];
var mettle_live_frame_copied: int64[1024];
var mettle_live_frame_descriptors: string[1024];
var mettle_live_frame_count: int64 = 0;
var mettle_live_frame_owner: string = "";
var mettle_live_frame_more: int64 = 0;
var mettle_live_frame_key: int64 = 0;
var mettle_live_scratch: int64 = 0;
var mettle_live_scratch_used: int64 = 0;
var mettle_live_heap_at: int64 = 0;
var mettle_live_heap_left: int64 = 0;
var mettle_live_hex_buffer: uint8[16];

fn mettle_live_same(a: string, b: string) -> int64 {
    if (a.length != b.length) {
        return 0;
    }
    var i: int64 = 0;
    var n: int64 = (int64)a.length;
    while (i < n) {
        if (a.chars[i] != b.chars[i]) {
            return 0;
        }
        i = i + 1;
    }
    return 1;
}

fn mettle_live_same_bytes(a: int64, b: int64, count: int64) -> int64 {
    var x: uint8* = (uint8*)a;
    var y: uint8* = (uint8*)b;
    var i: int64 = 0;
    while (i < count) {
        if (x[i] != y[i]) {
            return 0;
        }
        i = i + 1;
    }
    return 1;
}

fn mettle_live_table_has(table: int64, key: int64) -> int64 {
    var digits: string = "0123456789abcdef";
    var value: int64 = key;
    var i: int64 = 15;
    while (i >= 0) {
        mettle_live_hex_buffer[i] = digits.chars[value & 15];
        value = value >> 4;
        i = i - 1;
    }
    var bytes: uint8* = (uint8*)table;
    var at: int64 = 20;
    while (bytes[at] != (uint8)46 && bytes[at] != (uint8)0) {
        if (mettle_live_same_bytes(table + at, (int64)&mettle_live_hex_buffer[0], 16) != 0) {
            return 1;
        }
        at = at + 16;
    }
    return 0;
}

fn mettle_live_heap(size: int64) -> int64 {
    mettle_live_port_lock(&mettle_live_heap_lock);
    var got: int64 = mettle_live_heap_locked(size);
    mettle_live_port_unlock(&mettle_live_heap_lock);
    return got;
}

fn mettle_live_heap_locked(size: int64) -> int64 {
    var need: int64 = ((size + 15) / 16) * 16;
    if (need > mettle_live_heap_left) {
        var chunk: int64 = METTLE_LIVE_HEAP_CHUNK;
        if (need > chunk) {
            chunk = need;
        }
        mettle_live_heap_at = mettle_live_port_alloc(chunk);
        if (mettle_live_heap_at == 0) {
            mettle_live_heap_left = 0;
            return 0;
        }
        mettle_live_heap_left = chunk;
    }
    var got: int64 = mettle_live_heap_at;
    mettle_live_heap_at = mettle_live_heap_at + need;
    mettle_live_heap_left = mettle_live_heap_left - need;
    return got;
}

fn mettle_live_scratch_take(size: int64) -> int64 {
    var need: int64 = ((size + 15) / 16) * 16;
    if (mettle_live_scratch == 0) {
        mettle_live_scratch = mettle_live_port_alloc(METTLE_LIVE_SCRATCH_SIZE);
    }
    if (mettle_live_scratch == 0 || mettle_live_scratch_used + need > METTLE_LIVE_SCRATCH_SIZE) {
        return mettle_live_heap(size);
    }
    var got: int64 = mettle_live_scratch + mettle_live_scratch_used;
    mettle_live_scratch_used = mettle_live_scratch_used + need;
    return got;
}

fn mettle_live_frame_note(name: string, reason: string) {
    if (name.length == 0 || name.chars[0] == (uint8)46) {
        return;
    }
    if (name.length > 3 && name.chars[0] == (uint8)105 && name.chars[1] == (uint8)114 && name.chars[2] == (uint8)95) {
        return;
    }
    var at: int64 = mettle_live_text(0, "[live] ");
    at = mettle_live_text(at, mettle_live_frame_owner);
    at = mettle_live_text(at, ": '");
    at = mettle_live_text(at, name);
    at = mettle_live_text(at, "' ");
    at = mettle_live_text(at, reason);
    mettle_live_send(at);
}

export fn mettle_live_frame_moved(flag: int64, table: string, key: int64, owner: string) -> int64 {
    var current_slot: int64* = (int64*)flag;
    var current: int64 = *current_slot;
    var mine: int64 = (int64)table.chars;
    if (current == 0) {
        if (mettle_live_container(mine) == -1) {
            *current_slot = mine;
        }
        return 0;
    }
    if (current == mine || mettle_live_container(current) == mettle_live_container(mine)) {
        return 0;
    }
    if (mettle_live_same_bytes(current + 4, mine + 4, 16) == 0) {
        return 0;
    }
    if (mettle_live_table_has(current, key) == 0) {
        return 0;
    }
    mettle_live_port_lock(&mettle_live_frame_lock);
    mettle_live_frame_count = 0;
    mettle_live_scratch_used = 0;
    mettle_live_frame_more = 0;
    mettle_live_frame_owner = owner;
    var at: int64 = mettle_live_text(0, "[live] ");
    at = mettle_live_text(at, owner);
    at = mettle_live_text(at, " moves to the current code");
    mettle_live_send(at);
    return 1;
}

export fn mettle_live_frame_check(flag: int64, table: string, key: int64, owner: string) -> int64 {
    mettle_live_quiesce();
    return mettle_live_frame_moved(flag, table, key, owner);
}

export fn mettle_live_frame_put(name: string, key: int64, size: int64, place: int64, keep: int64, descriptor: string) -> int64 {
    var i: int64 = mettle_live_frame_count;
    if (i >= METTLE_LIVE_FRAME_LIMIT) {
        return 0;
    }
    var stored: int64 = place;
    mettle_live_frame_copied[i] = 0;
    if (keep == 0) {
        stored = mettle_live_scratch_take(size);
        if (stored == 0) {
            return 0;
        }
        mettle_live_copy(stored, place, size);
        mettle_live_frame_copied[i] = 1;
    }
    mettle_live_frame_names[i] = name;
    mettle_live_frame_descriptors[i] = descriptor;
    mettle_live_frame_keys[i] = key;
    mettle_live_frame_sizes[i] = size;
    mettle_live_frame_places[i] = stored;
    mettle_live_frame_count = i + 1;
    return 1;
}


fn mettle_live_desc_read(text: uint8*, length: int64, at: int64*) -> int64 {
    var value: int64 = 0;
    while (*at < length && text[*at] >= (uint8)48 && text[*at] <= (uint8)57) {
        value = value * 10 + ((int64)text[*at] - 48);
        *at = *at + 1;
    }
    return value;
}

fn mettle_live_desc_skip(text: uint8*, length: int64, at: int64) -> int64 {
    var kind: int64 = (int64)text[at];
    var cursor: int64 = at + 1;
    if (kind == 65) {
        mettle_live_desc_read(text, length, &cursor);
        cursor = mettle_live_desc_skip(text, length, cursor + 1);
        return cursor + 1;
    }
    if (kind == 83) {
        mettle_live_desc_read(text, length, &cursor);
        cursor = cursor + 1;
        while (cursor < length && text[cursor] != (uint8)125) {
            while (text[cursor] != (uint8)58) {
                cursor = cursor + 1;
            }
            cursor = cursor + 1;
            mettle_live_desc_read(text, length, &cursor);
            cursor = mettle_live_desc_skip(text, length, cursor + 1);
            cursor = cursor + 1;
        }
        return cursor + 1;
    }
    mettle_live_desc_read(text, length, &cursor);
    return cursor;
}

fn mettle_live_desc_size(text: uint8*, length: int64, at: int64) -> int64 {
    var kind: int64 = (int64)text[at];
    var cursor: int64 = at + 1;
    var count: int64 = mettle_live_desc_read(text, length, &cursor);
    if (kind == 65) {
        return count * mettle_live_desc_size(text, length, cursor + 1);
    }
    return count;
}

fn mettle_live_desc_field(text: uint8*, length: int64, at: int64, name: uint8*, name_start: int64, name_end: int64, offset: int64*) -> int64 {
    var cursor: int64 = at + 1;
    mettle_live_desc_read(text, length, &cursor);
    cursor = cursor + 1;
    while (cursor < length && text[cursor] != (uint8)125) {
        var start: int64 = cursor;
        while (text[cursor] != (uint8)58) {
            cursor = cursor + 1;
        }
        var same: int64 = 0;
        if (cursor - start == name_end - name_start) {
            same = 1;
            var k: int64 = 0;
            while (k < cursor - start) {
                if (text[start + k] != name[name_start + k]) {
                    same = 0;
                }
                k = k + 1;
            }
        }
        cursor = cursor + 1;
        var field_offset: int64 = mettle_live_desc_read(text, length, &cursor);
        cursor = cursor + 1;
        if (same != 0) {
            *offset = field_offset;
            return cursor;
        }
        cursor = mettle_live_desc_skip(text, length, cursor) + 1;
    }
    return -1;
}

fn mettle_live_read_integer(kind: int64, size: int64, address: int64) -> int64 {
    if (kind == 105) {
        if (size == 1) {
            var a: int8* = (int8*)address;
            return (int64)*a;
        }
        if (size == 2) {
            var b: int16* = (int16*)address;
            return (int64)*b;
        }
        if (size == 4) {
            var c: int32* = (int32*)address;
            return (int64)*c;
        }
    }
    if (size == 1) {
        var d: uint8* = (uint8*)address;
        return (int64)*d;
    }
    if (size == 2) {
        var e: uint16* = (uint16*)address;
        return (int64)*e;
    }
    if (size == 4) {
        var f: uint32* = (uint32*)address;
        return (int64)*f;
    }
    var g: int64* = (int64*)address;
    return *g;
}

fn mettle_live_write_integer(size: int64, address: int64, value: int64) {
    if (size == 1) {
        var a: uint8* = (uint8*)address;
        *a = (uint8)(value & 255);
    } else if (size == 2) {
        var b: uint16* = (uint16*)address;
        *b = (uint16)(value & 65535);
    } else if (size == 4) {
        var c: uint32* = (uint32*)address;
        *c = (uint32)(value & 4294967295);
    } else if (size == 8) {
        var d: int64* = (int64*)address;
        *d = value;
    }
}

fn mettle_live_read_float(size: int64, address: int64) -> float64 {
    if (size == 4) {
        var a: float32* = (float32*)address;
        return (float64)*a;
    }
    var b: float64* = (float64*)address;
    return *b;
}

fn mettle_live_write_float(size: int64, address: int64, value: float64) {
    if (size == 4) {
        var a: float32* = (float32*)address;
        *a = (float32)value;
    } else if (size == 8) {
        var b: float64* = (float64*)address;
        *b = value;
    }
}

fn mettle_live_convert(target: int64, to: uint8*, to_length: int64, to_at: int64, source: int64, from: uint8*, from_length: int64, from_at: int64) {
    var to_kind: int64 = (int64)to[to_at];
    var from_kind: int64 = (int64)from[from_at];
    var to_size: int64 = mettle_live_desc_size(to, to_length, to_at);
    var from_size: int64 = mettle_live_desc_size(from, from_length, from_at);
    if (to_kind == 83 && from_kind == 83) {
        var cursor: int64 = to_at + 1;
        mettle_live_desc_read(to, to_length, &cursor);
        cursor = cursor + 1;
        while (cursor < to_length && to[cursor] != (uint8)125) {
            var name_start: int64 = cursor;
            while (to[cursor] != (uint8)58) {
                cursor = cursor + 1;
            }
            var name_end: int64 = cursor;
            cursor = cursor + 1;
            var offset: int64 = mettle_live_desc_read(to, to_length, &cursor);
            cursor = cursor + 1;
            var field: int64 = cursor;
            cursor = mettle_live_desc_skip(to, to_length, cursor) + 1;
            var old_offset: int64 = 0;
            var old_field: int64 = mettle_live_desc_field(from, from_length, from_at, to, name_start, name_end, &old_offset);
            if (old_field >= 0) {
                mettle_live_convert(target + offset, to, to_length, field, source + old_offset, from, from_length, old_field);
            }
        }
        return;
    }
    if (to_kind == 65 && from_kind == 65) {
        var to_cursor: int64 = to_at + 1;
        var to_count: int64 = mettle_live_desc_read(to, to_length, &to_cursor);
        var from_cursor: int64 = from_at + 1;
        var from_count: int64 = mettle_live_desc_read(from, from_length, &from_cursor);
        var to_stride: int64 = mettle_live_desc_size(to, to_length, to_cursor + 1);
        var from_stride: int64 = mettle_live_desc_size(from, from_length, from_cursor + 1);
        var k: int64 = 0;
        while (k < to_count && k < from_count) {
            mettle_live_convert(target + k * to_stride, to, to_length, to_cursor + 1, source + k * from_stride, from, from_length, from_cursor + 1);
            k = k + 1;
        }
        return;
    }
    var to_scalar: int64 = 0;
    var from_scalar: int64 = 0;
    if (to_kind == 105 || to_kind == 117 || to_kind == 98 || to_kind == 101 || to_kind == 112 || to_kind == 102) {
        to_scalar = 1;
    }
    if (from_kind == 105 || from_kind == 117 || from_kind == 98 || from_kind == 101 || from_kind == 112 || from_kind == 102) {
        from_scalar = 1;
    }
    if (to_scalar == 0 || from_scalar == 0) {
        if (to_kind == from_kind && to_size == from_size) {
            mettle_live_copy(target, source, to_size);
        }
        return;
    }
    if (to_kind == 102) {
        if (from_kind == 102) {
            mettle_live_write_float(to_size, target, mettle_live_read_float(from_size, source));
        } else {
            mettle_live_write_float(to_size, target, (float64)mettle_live_read_integer(from_kind, from_size, source));
        }
        return;
    }
    if (to_kind == 98) {
        var truth: int64 = 0;
        if (from_kind == 102) {
            if (mettle_live_read_float(from_size, source) != 0.0) {
                truth = 1;
            }
        } else if (mettle_live_read_integer(from_kind, from_size, source) != 0) {
            truth = 1;
        }
        mettle_live_write_integer(to_size, target, truth);
        return;
    }
    if (from_kind == 102) {
        mettle_live_write_integer(to_size, target, (int64)mettle_live_read_float(from_size, source));
        return;
    }
    mettle_live_write_integer(to_size, target, mettle_live_read_integer(from_kind, from_size, source));
}

export fn mettle_live_frame_take(name: string, key: int64, size: int64, want_storage: int64, descriptor: string) -> int64 {
    var i: int64 = 0;
    while (i < mettle_live_frame_count) {
        if (mettle_live_same(mettle_live_frame_names[i], name) != 0) {
            if (mettle_live_frame_keys[i] == key && mettle_live_frame_sizes[i] == size) {
                if (want_storage != 0 && mettle_live_frame_copied[i] != 0) {
                    var kept: int64 = mettle_live_heap(size);
                    if (kept == 0) {
                        return 0;
                    }
                    mettle_live_copy(kept, mettle_live_frame_places[i], size);
                    return kept;
                }
                return mettle_live_frame_places[i];
            }
            var old: string = mettle_live_frame_descriptors[i];
            if (descriptor.length > 0 && old.length > 0) {
                var converted: int64 = 0;
                if (want_storage != 0) {
                    converted = mettle_live_heap(size);
                } else {
                    converted = mettle_live_scratch_take(size);
                }
                if (converted != 0) {
                    mettle_live_frame_zero(converted, size);
                    mettle_live_convert(converted, descriptor.chars, (int64)descriptor.length, 0, mettle_live_frame_places[i], old.chars, (int64)old.length, 0);
                    mettle_live_frame_note(name, "keeps its value in its new layout");
                    return converted;
                }
            }
            mettle_live_frame_note(name, "changed type and starts from its initial value");
            return 0;
        }
        i = i + 1;
    }
    mettle_live_frame_note(name, "is new here and starts from its initial value");
    return 0;
}

export fn mettle_live_frame_end() -> int64 {
    mettle_live_port_unlock(&mettle_live_frame_lock);
    return 0;
}

export fn mettle_live_frame_hand_back(key: int64) -> int64 {
    mettle_live_frame_more = 1;
    mettle_live_frame_key = key;
    return 0;
}

export fn mettle_live_frame_again() -> int64 {
    if (mettle_live_frame_more == 0) {
        return 0;
    }
    mettle_live_frame_more = 0;
    return 1;
}

export fn mettle_live_frame_last_key() -> int64 {
    return mettle_live_frame_key;
}

export fn mettle_live_frame_copy(target: int64, source: int64, size: int64) -> int64 {
    mettle_live_copy(target, source, size);
    return 0;
}

export fn mettle_live_frame_zero(place: int64, size: int64) -> int64 {
    var bytes: uint8* = (uint8*)place;
    var i: int64 = 0;
    while (i < size) {
        bytes[i] = (uint8)0;
        i = i + 1;
    }
    return 0;
}
