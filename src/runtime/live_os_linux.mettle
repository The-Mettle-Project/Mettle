extern fn mettle_atomic_exchange_i32(target: int32*, value: int32) -> int32;

var mettle_live_os_time: int64[2];
var mettle_live_os_stat: int64[24];
var mettle_live_os_self: uint8[16];

fn mettle_live_os_u16(address: int64) -> int64 {
    var p: uint16* = (uint16*)address;
    return (int64)*p;
}

fn mettle_live_os_u32(address: int64) -> int64 {
    var p: uint32* = (uint32*)address;
    return (int64)*p;
}

fn mettle_live_os_u64(address: int64) -> int64 {
    var p: int64* = (int64*)address;
    return *p;
}

fn mettle_live_os_failed(result: int64) -> int64 {
    if (result < 0 && result > -4096) {
        return 1;
    }
    return 0;
}

fn mettle_live_os_image_end(base: int64) -> int64 {
    var end: int64 = base;
    var table: int64 = base + mettle_live_os_u64(base + 32);
    var entry_size: int64 = mettle_live_os_u16(base + 54);
    var count: int64 = mettle_live_os_u16(base + 56);
    var i: int64 = 0;
    while (i < count) {
        var header: int64 = table + i * entry_size;
        if (mettle_live_os_u32(header) == 1) {
            var limit: int64 = mettle_live_os_u64(header + 16) + mettle_live_os_u64(header + 40);
            if (limit > end) {
                end = limit;
            }
        }
        i = i + 1;
    }
    return end;
}

export fn mettle_live_port_write(buffer: uint8*, length: int64) {
    syscall(1, 2, (int64)buffer, length);
}

export fn mettle_live_port_lock(lock: int64*) {
    var word: int32* = (int32*)lock;
    while (mettle_atomic_exchange_i32(word, 1) != 0) {
        syscall(24);
    }
}

export fn mettle_live_port_unlock(lock: int64*) {
    var word: int32* = (int32*)lock;
    mettle_atomic_exchange_i32(word, 0);
}

export fn mettle_live_port_ticks() -> uint64 {
    syscall(228, 1, (int64)&mettle_live_os_time[0]);
    return (uint64)(mettle_live_os_time[0] * 1000 + mettle_live_os_time[1] / 1000000);
}

export fn mettle_live_port_alloc(size: int64) -> int64 {
    var got: int64 = syscall(9, 0, size, 3, 34, -1, 0);
    if (mettle_live_os_failed(got) != 0) {
        return 0;
    }
    return got;
}

export fn mettle_live_port_free(address: int64, size: int64) {
    syscall(11, address, size);
}

export fn mettle_live_port_alloc_near(base: int64, size: int64) -> int64 {
    var end: int64 = mettle_live_os_image_end(base);
    var at: int64 = ((end + 65535) / 65536) * 65536;
    var limit: int64 = base + 0x70000000;
    while (at + size < limit) {
        var got: int64 = syscall(9, at, size, 3, 34 + 0x100000, -1, 0);
        if (got == at) {
            return got;
        }
        if (mettle_live_os_failed(got) == 0) {
            syscall(11, got, size);
        }
        at = at + 65536;
    }
    return 0;
}

export fn mettle_live_port_code_store(address: int64, value: int64) {
    var page: int64 = address & -4096;
    syscall(10, page, 4096, 7);
    var word: int64* = (int64*)address;
    *word = value;
    syscall(10, page, 4096, 5);
}

@naked export fn mettle_live_site_check(flag: int64, table: string, key: int64, owner: string) -> int64 {
    asm {
        lea r10, [rsp + 8]
        push rdi
        push rsi
        push rdx
        push rcx
        push r8
        push r9
        mov rdi, r10
        sub rsp, 8
        call mettle_live_resume_slot
        add rsp, 8
        pop r9
        pop r8
        pop rcx
        pop rdx
        pop rsi
        pop rdi
        test rax, rax
        jz site_skip
        mov [rax], rbx
        mov [rax + 8], rbp
        mov [rax + 32], r12
        mov [rax + 40], r13
        mov [rax + 48], r14
        mov [rax + 56], r15
        lea r10, [rsp + 8]
        mov [rax + 64], r10
        mov r10, [rsp]
        mov [rax + 72], r10
    site_skip:
        jmp mettle_live_frame_check
    }
}

@naked export fn mettle_live_site_leave_here() {
    asm {
        lea rdi, [rsp + 8]
        jmp mettle_live_site_leave
    }
}

@naked export fn mettle_live_resume_jump(slot: int64) {
    asm {
        mov rax, rdi
        mov rbx, [rax]
        mov rbp, [rax + 8]
        mov r12, [rax + 32]
        mov r13, [rax + 40]
        mov r14, [rax + 48]
        mov r15, [rax + 56]
        mov rsp, [rax + 64]
        mov r10, [rax + 72]
        mov rax, 1
        jmp r10
    }
}

export fn mettle_live_port_reserve(size: int64) -> int64 {
    var got: int64 = syscall(9, 0, size, 0, 34 + 0x4000, -1, 0);
    if (mettle_live_os_failed(got) != 0) {
        return 0;
    }
    return got;
}

export fn mettle_live_port_commit(address: int64, size: int64) -> int64 {
    if (syscall(10, address, size, 3) != 0) {
        return 0;
    }
    return 1;
}

export fn mettle_live_port_thread_id() -> int64 {
    return syscall(186);
}

export fn mettle_live_port_sleep(milliseconds: int64) {
    var spec: int64[2];
    spec[0] = milliseconds / 1000;
    spec[1] = (milliseconds % 1000) * 1000000;
    syscall(35, (int64)&spec[0], 0);
}

export fn mettle_live_port_seal(address: int64, size: int64) -> int64 {
    var length: int64 = ((size + 4095) / 4096) * 4096;
    if (syscall(10, address, length, 5) != 0) {
        return 0;
    }
    return 1;
}

export fn mettle_live_port_exe_path(buffer: uint8*, capacity: int64) -> int64 {
    var name: string = "/proc/self/exe";
    var i: int64 = 0;
    while (i < (int64)name.length) {
        mettle_live_os_self[i] = name.chars[i];
        i = i + 1;
    }
    mettle_live_os_self[i] = (uint8)0;
    var got: int64 = syscall(89, (int64)&mettle_live_os_self[0], (int64)buffer, capacity);
    if (got < 0) {
        return 0;
    }
    return got;
}

export fn mettle_live_port_read(path: uint8*, size_out: int64*) -> int64 {
    var file: int64 = syscall(257, -100, (int64)path, 0, 0);
    if (file < 0) {
        return 0;
    }
    if (syscall(5, file, (int64)&mettle_live_os_stat[0]) != 0) {
        syscall(3, file);
        return -1;
    }
    var size: int64 = mettle_live_os_stat[6];
    if (size < 64 || size > 0x40000000) {
        syscall(3, file);
        return -1;
    }
    var buffer: int64 = mettle_live_port_alloc(size);
    if (buffer == 0) {
        syscall(3, file);
        return -1;
    }
    var done: int64 = 0;
    while (done < size) {
        var got: int64 = syscall(0, file, buffer + done, size - done);
        if (got <= 0) {
            syscall(3, file);
            syscall(11, buffer, size);
            return -1;
        }
        done = done + got;
    }
    syscall(3, file);
    *size_out = size;
    return buffer;
}

export fn mettle_live_port_bind(library: int64, name: int64) -> int64 {
    return 0;
}

export fn mettle_live_port_suspend_others() {
}

export fn mettle_live_port_resume_others() {
