import "std/mem";

export const WMAX: int32 = 1024;
export const HKCU: int64 = -2147483647;
export const HKLM: int64 = -2147483646;
export const INVALID_HANDLE: int64 = -1;

const GENERIC_READ: uint32 = 0x80000000;
const GENERIC_WRITE: uint32 = 0x40000000;
const FILE_SHARE_READ: uint32 = 1;
const OPEN_EXISTING: uint32 = 3;
const CREATE_ALWAYS: uint32 = 2;
const FILE_ATTRIBUTE_DIRECTORY: uint32 = 16;
const FILE_ATTRIBUTE_NORMAL: uint32 = 128;
const INVALID_ATTRIBUTES: uint32 = 0xFFFFFFFF;
const PAGE_READONLY: uint32 = 2;
const FILE_MAP_READ: uint32 = 4;
const CP_UTF8: uint32 = 65001;
const KEY_READ: uint32 = 0x20019;
const KEY_WRITE: uint32 = 0x20006;
const KEY_WOW64_64KEY: uint32 = 0x0100;
const REG_SZ: uint32 = 1;
const REG_EXPAND_SZ: uint32 = 2;
const REG_DWORD: uint32 = 4;
const STARTF_USESTDHANDLES: uint32 = 0x100;
const STARTF_USESHOWWINDOW: uint32 = 1;
const CREATE_NO_WINDOW: uint32 = 0x08000000;
const HANDLE_FLAG_INHERIT: uint32 = 1;
const MOVEFILE_WRITE_THROUGH: uint32 = 8;
const FORMAT_FROM_SYSTEM: uint32 = 0x1000;
const FORMAT_IGNORE_INSERTS: uint32 = 0x200;
const WAIT_INFINITE: uint32 = 0xFFFFFFFF;
const WM_SETTINGCHANGE: uint32 = 0x001A;
const HWND_BROADCAST: int64 = 0xFFFF;
const SMTO_ABORTIFHUNG: uint32 = 2;
const SHCNE_ASSOCCHANGED: int32 = 0x08000000;
const SEE_MASK_NOCLOSEPROCESS: uint32 = 0x40;
const ATTACH_PARENT: uint32 = 0xFFFFFFFF;

struct FindData {
  attributes: uint32;
  created: uint32[2];
  accessed: uint32[2];
  written: uint32[2];
  size_high: uint32;
  size_low: uint32;
  reserved0: uint32;
  reserved1: uint32;
  name: uint16[260];
  alternate: uint16[14];
}

struct SecurityAttributes {
  length: uint32;
  descriptor: int64;
  inherit: int32;
}

struct StartupInfo {
  size: uint32;
  reserved: int64;
  desktop: int64;
  title: int64;
  x: uint32;
  y: uint32;
  x_size: uint32;
  y_size: uint32;
  x_chars: uint32;
  y_chars: uint32;
  fill: uint32;
  flags: uint32;
  show: uint16;
  reserved2: uint16;
  reserved3: int64;
  input: int64;
  output: int64;
  error: int64;
}

struct ProcessInfo {
  process: int64;
  thread: int64;
  process_id: uint32;
  thread_id: uint32;
}

struct ShellExecuteInfo {
  size: uint32;
  mask: uint32;
  window: int64;
  verb: uint16*;
  file: uint16*;
  parameters: uint16*;
  directory: uint16*;
  show: int32;
  instance: int64;
  id_list: int64;
  class_name: int64;
  class_key: int64;
  hot_key: uint32;
  icon: int64;
  process: int64;
}

