import "std/mem";
import "system";
import "lzma";
import "engine";
import "picture";
import "window";

var g_silent: int32 = 0;
var g_uninstall: int32 = 0;
var g_temp_copy: int32 = 0;
var g_go: int32 = 0;
var g_render_page: uint16* = 0;
var g_render_file: uint16* = 0;
var g_render_scale: int32 = 100;
var g_dir_given: int32 = 0;
var g_scope_given: int32 = 0;

fn say(text: uint16*) {
  if (g_silent != 0) {
    console_line(text);
  }
}

fn say_c(text: cstring) {
  var wide: uint16[WMAX];
  wc(&wide[0], text);
  say(&wide[0]);
}

fn parse_int(text: uint16*) -> int32 {
  var value: int32 = 0;
  var i: int32 = 0;
  var sign: int32 = 1;
  if (text[0] == 45) {
    sign = -1;
    i = 1;
  }
  while (text[i] >= 48 && text[i] <= 57) {
    value = value * 10 + (int32)text[i] - 48;
    i += 1;
  }
  return value * sign;
}

fn parse_arguments() -> int32 {
  var count: int32 = 0;
  var args: uint16** = args_get(&count);
  var i: int32 = 1;
  while (i < count) {
    var a: uint16* = args[i];
    if (wsame_c(a, "--silent") != 0) {
      g_silent = 1;
    } else if (wsame_c(a, "--uninstall") != 0) {
      g_uninstall = 1;
    } else if (wsame_c(a, "--temp-copy") != 0) {
      g_temp_copy = 1;
    } else if (wsame_c(a, "--go") != 0) {
      g_go = 1;
    } else if (wsame_c(a, "--everyone") != 0) {
      g_everyone = 1;
      g_scope_given = 1;
    } else if (wsame_c(a, "--just-me") != 0) {
      g_everyone = 0;
      g_scope_given = 1;
    } else if (wsame_c(a, "--no-path") != 0) {
      g_add_path = 0;
    } else if (wsame_c(a, "--no-association") != 0) {
      g_associate = 0;
    } else if (wsame_c(a, "--dir") != 0 && i + 1 < count) {
      i += 1;
      wcopy(&g_dir[0], args[i]);
      wfull_path(&g_dir[0]);
      g_dir_given = 1;
    } else if (wsame_c(a, "--registry-root") != 0 && i + 1 < count) {
      i += 1;
      wcopy(&g_test_root[0], args[i]);
    } else if (wsame_c(a, "--render") != 0 && i + 2 < count) {
      g_render_page = args[i + 1];
      g_render_file = args[i + 2];
      i += 2;
    } else if (wsame_c(a, "--scale") != 0 && i + 1 < count) {
      i += 1;
      g_render_scale = parse_int(args[i]);
    } else if (wsame_c(a, "--at") != 0 && i + 2 < count) {
      window_place(parse_int(args[i + 1]), parse_int(args[i + 2]));
      i += 2;
    } else {
      var message: uint16[WMAX];
      wc(&message[0], "Unknown option: ");
      wadd(&message[0], a);
      console_attach();
      console_line(&message[0]);
      return 0;
    }
    i += 1;
  }
  return 1;
}

fn run_silent_install() -> int32 {
  if (is_admin() == 0 && g_everyone != 0 && g_test_root[0] == 0) {
    say_c("Installing for everyone needs an administrator prompt.");
    return 1;
  }
  if (engine_start() == 0) {
    say(&g_error[0]);
    return 1;
  }
  while (g_phase != PHASE_DONE && g_phase != PHASE_FAILED) {
    engine_step(1000.0);
  }
  if (g_phase == PHASE_FAILED) {
    say(&g_error[0]);
    engine_cancel();
    return 1;
  }
  say(&g_verify_output[0]);
  return 0;
}

fn run_silent_remove() -> int32 {
  if (remove_start() == 0) {
    say(&g_error[0]);
    return 1;
  }
  while (g_phase != PHASE_DONE && g_phase != PHASE_FAILED) {
    engine_step(1000.0);
  }
  if (g_phase == PHASE_FAILED) {
    say(&g_error[0]);
    return 1;
  }
  return 0;
}

fn quote_argument(out: uint16*, flag: cstring, value: uint16*) {
  wa(out, " ");
  wa(out, flag);
  wa(out, " \"");
  wadd(out, value);
  wa(out, "\"");
}

fn copy_self_to_temp(out: uint16*) -> int32 {
  temp_dir(out);
  wa(out, "\\mettle-uninstall-");
  wadd_int(out, (int64)process_id());
  wa(out, ".exe");
  var file: int64 = file_create(out);
  if (file == -1) {
    return 0;
  }
  var ok: int32 = file_write(file, g_archive.base, g_archive.size);
  file_close(file);
  return ok;
}

fn relaunch_for_removal() -> int32 {
  var copy_path: uint16[WMAX];
  if (copy_self_to_temp(&copy_path[0]) == 0) {
    return 1;
  }
  var parameters: uint16[WMAX];
  parameters[0] = 0;
  wa(&parameters[0], "--temp-copy --uninstall");
  quote_argument(&parameters[0], "--dir", &g_dir[0]);
  if (g_everyone != 0) {
    wa(&parameters[0], " --everyone");
  }
  if (g_silent != 0) {
    wa(&parameters[0], " --silent");
  }
  if (g_test_root[0] != 0) {
    quote_argument(&parameters[0], "--registry-root", &g_test_root[0]);
  }
  var code: int32 = 0;
  if (g_everyone != 0 && is_admin() == 0 && g_test_root[0] == 0) {
    if (run_elevated(&copy_path[0], &parameters[0], 0, g_silent, &code) == 0) {
      return 1;
    }
    return code;
  }
  var command: uint16[WMAX];
  wc(&command[0], "\"");
  wadd(&command[0], &copy_path[0]);
  wa(&command[0], "\" ");
  wadd(&command[0], &parameters[0]);
  if (g_silent != 0) {
    if (run_wait(&command[0], &code) == 0) {
      return 1;
    }
    return code;
  }
  var empty: uint16* = 0;
  if (run_detached(&command[0], empty, 1) == 0) {
    return 1;
  }
  return 0;
}

fn delete_own_copy() {
  var self_path: uint16[WMAX];
  own_path(&self_path[0]);
  var command: uint16[WMAX];
  wc(&command[0], "cmd.exe /c ping -n 3 127.0.0.1 >nul & del /f /q \"");
  wadd(&command[0], &self_path[0]);
  wa(&command[0], "\"");
  if (g_phase == PHASE_DONE) {
    wa(&command[0], " & del /f /q \"");
    wadd(&command[0], &g_dir[0]);
    wa(&command[0], "\\uninstall.exe\" & rmdir \"");
    wadd(&command[0], &g_dir[0]);
    wa(&command[0], "\"");
  }
  var empty: uint16* = 0;
  run_detached(&command[0], empty, 1);
}

fn resolve_existing(uninstalling: int32) {
  var prior: Existing;
  find_existing(&prior);
  window_note_existing(&prior);
  if (g_scope_given == 0 && prior.found != 0) {
    g_everyone = prior.everyone;
  }
  if (g_dir_given == 0) {
    if (prior.found != 0) {
      wcopy(&g_dir[0], &prior.dir[0]);
    } else if (uninstalling != 0) {
      own_path(&g_dir[0]);
      wparent(&g_dir[0]);
    } else {
      default_dir(&g_dir[0], g_everyone);
    }
  }
}

fn main_program() -> int32 {
  if (parse_arguments() == 0) {
    return 2;
  }
  if (archive_open() == 0) {
    console_attach();
    var message: uint16[WMAX];
    wc(&message[0], "This program has no payload. Build it with installer/pack.py.");
    console_line(&message[0]);
    return 2;
  }
  if (g_silent != 0) {
    console_attach();
  }
  if (archive_has_files() == 0) {
    g_uninstall = 1;
  }
  if (g_uninstall != 0 && g_dir_given == 0) {
    own_path(&g_dir[0]);
    wparent(&g_dir[0]);
    g_dir_given = 1;
  }
  if (g_uninstall != 0 && g_temp_copy == 0 && g_render_page == 0) {
    return relaunch_for_removal();
  }
  var code: int32 = 0;
  if (g_silent != 0) {
    if (g_uninstall != 0) {
      code = run_silent_remove();
      if (g_temp_copy != 0) {
        delete_own_copy();
      }
      return code;
    }
    resolve_existing(0);
    return run_silent_install();
  }
  resolve_existing(g_uninstall);
  picture_load(g_archive.art, g_archive.art_size);
  window_set_mode(g_uninstall, g_go);
  if (g_render_page != 0) {
    return window_render_page(g_render_page, g_render_file, g_render_scale);
  }
  code = window_run();
  if (g_temp_copy != 0) {
    delete_own_copy();
  }
  return code;
}

fn main() -> int32 {
  var code: int32 = main_program();
  exit_now(code);
  return code;
}
