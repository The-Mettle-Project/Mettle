import "std/io";

struct Stack<T> { items: T[16]; count: int32; }

fn Stack_push__ptr<T>(s: Stack<T>*, v: T) { s->items[s->count] = v; s->count += 1; }

fn grade(score: int32) -> string {
  if score >= 90 { "A" } else if score >= 75 { "B" } else { "C" }
}

fn main() -> int32 {
  var s: Stack<int32>;
  s.count = 0;
  var top = &s;
  top->push(92); top->push(78); top->push(41);
  var curve = 5;
  var mark: Fn(int32) -> string = fn(i: int32) -> string { return grade(s.items[i] + curve); };
  println("{mark(0)} {mark(1)} {mark(2)}");
  return 0;
}
