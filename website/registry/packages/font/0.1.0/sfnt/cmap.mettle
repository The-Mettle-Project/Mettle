// cmap: maps Unicode code points to glyph numbers.
// Formats 0, 4, 6, 10, 12 and 13, plus format 14 variation sequences.
// Spec: OpenType "cmap - Character to glyph index mapping table".

import "face";

// Rank of a subtable: higher is better. 0 means we cannot use it.
fn cmap_rank(pid: uint32, eid: uint32, fmt: uint32) -> int32 {
  var full: bool = fmt == 12 || fmt == 13 || fmt == 10;
  var bmp: bool = fmt == 4 || fmt == 6 || fmt == 0;
  if (!full && !bmp) { return 0; }
  if (pid == 3 && eid == 10 && full) { return 9; }
  if (pid == 0 && (eid == 4 || eid == 6) && full) { return 8; }
  if (pid == 0 && full) { return 7; }
  if (pid == 3 && eid == 1 && bmp) { return 6; }
  if (pid == 0 && bmp) { return 5; }
  if (pid == 3 && eid == 0 && bmp) { return 3; }
  if (pid == 1 && eid == 0 && bmp) { return 1; }
  return 0;
}

/// Picks the best Unicode subtable. Called by font_init.
export fn font_cmap_select(f: FontFace*) {
  f->cmap_sub = 0; f->cmap_fmt = 0; f->cmap_symbol = false; f->cmap_uvs = 0;
  if (f->cmap == 0) { return; }
  var best: int32 = 0;
  var nsub: int64 = (int64)font_u16(f, f->cmap + 2);
  for i: int64 in 0..nsub {
    var rec: int64 = f->cmap + 4 + i * 8;
    var pid: uint32 = font_u16(f, rec);
    var eid: uint32 = font_u16(f, rec + 2);
    var sub: int64 = f->cmap + (int64)font_u32(f, rec + 4);
    if (sub >= f->cmap + f->cmap_len) { continue; }
    var fmt: uint32 = font_u16(f, sub);
    if (pid == 0 && eid == 5 && fmt == 14) { f->cmap_uvs = sub; continue; }
    var r: int32 = cmap_rank(pid, eid, fmt);
    if (r > best) {
      best = r;
      f->cmap_sub = sub;
      f->cmap_fmt = (int32)fmt;
      f->cmap_symbol = pid == 3 && eid == 0;
    }
  }
}

fn cmap4(f: FontFace*, sub: int64, cp: uint32) -> uint32 {
  if (cp > 0xFFFF) { return 0; }
  var segx2: int64 = (int64)font_u16(f, sub + 6);
  var nseg: int64 = segx2 / 2;
  if (nseg == 0) { return 0; }
  var ends: int64 = sub + 14;
  var starts: int64 = ends + segx2 + 2;
  var deltas: int64 = starts + segx2;
  var ranges: int64 = deltas + segx2;
  // Binary search for the first segment whose end code is >= cp.
  var lo: int64 = 0;
  var hi: int64 = nseg - 1;
  while (lo < hi) {
    var mid: int64 = (lo + hi) / 2;
    if (font_u16(f, ends + mid * 2) < cp) { lo = mid + 1; } else { hi = mid; }
  }
  var start: uint32 = font_u16(f, starts + lo * 2);
  if (cp < start || cp > font_u16(f, ends + lo * 2)) { return 0; }
  var delta: uint32 = font_u16(f, deltas + lo * 2);
  var ro: uint32 = font_u16(f, ranges + lo * 2);
  if (ro == 0) { return (cp + delta) & 0xFFFF; }
  var g: uint32 = font_u16(f, ranges + lo * 2 + (int64)ro + (int64)(cp - start) * 2);
  if (g == 0) { return 0; }
  return (g + delta) & 0xFFFF;
}

fn cmap12(f: FontFace*, sub: int64, cp: uint32, same: bool) -> uint32 {
  var ng: int64 = (int64)font_u32(f, sub + 12);
  if (ng > (f->len - sub) / 12) { ng = (f->len - sub) / 12; }
  var lo: int64 = 0;
  var hi: int64 = ng - 1;
  while (lo <= hi) {
    var mid: int64 = (lo + hi) / 2;
    var g: int64 = sub + 16 + mid * 12;
    var sc: uint32 = font_u32(f, g);
    var ec: uint32 = font_u32(f, g + 4);
    if (cp < sc) { hi = mid - 1; }
    else if (cp > ec) { lo = mid + 1; }
    else if (same) { return font_u32(f, g + 8); }
    else { return font_u32(f, g + 8) + (cp - sc); }
  }
  return 0;
}

fn cmap_lookup(f: FontFace*, cp: uint32) -> uint32 {
  var sub: int64 = f->cmap_sub;
  switch (f->cmap_fmt) {
    case 0: {
      if (cp > 255) { return 0; }
      return font_u8(f, sub + 6 + (int64)cp);
    }
    case 4: { return cmap4(f, sub, cp); }
    case 6: {
      var first: uint32 = font_u16(f, sub + 6);
      var count: uint32 = font_u16(f, sub + 8);
      if (cp < first || cp >= first + count) { return 0; }
      return font_u16(f, sub + 10 + (int64)(cp - first) * 2);
    }
    case 10: {
      var first: uint32 = font_u32(f, sub + 12);
      var count: uint32 = font_u32(f, sub + 16);
      if (cp < first || cp - first >= count) { return 0; }
      return font_u16(f, sub + 20 + (int64)(cp - first) * 2);
    }
    case 12: { return cmap12(f, sub, cp, false); }
    case 13: { return cmap12(f, sub, cp, true); }
    default: { return 0; }
  }
}

/// Glyph number for a code point, or 0 (.notdef) when the font has none.
export fn font_glyph_index(f: FontFace*, cp: uint32) -> int32 {
  if (f->cmap_sub == 0) { return 0; }
  var g: uint32 = cmap_lookup(f, cp);
  // Symbol fonts put their glyphs at U+F000 + byte.
  if (g == 0 && f->cmap_symbol && cp <= 0xFF) { g = cmap_lookup(f, cp + 0xF000); }
  if (g >= (uint32)f->num_glyphs) { return 0; }
  return (int32)g;
}

/// Glyph for a code point followed by a variation selector (format 14).
/// Falls back to the plain mapping when the sequence is not listed.
export fn font_glyph_index_vs(f: FontFace*, cp: uint32, vs: uint32) -> int32 {
  var base: int32 = font_glyph_index(f, cp);
  var sub: int64 = f->cmap_uvs;
  if (sub == 0) { return base; }
  var n: int64 = (int64)font_u32(f, sub + 6);
  if (n > (f->len - sub) / 11) { n = (f->len - sub) / 11; }
  var lo: int64 = 0;
  var hi: int64 = n - 1;
  while (lo <= hi) {
    var mid: int64 = (lo + hi) / 2;
    var rec: int64 = sub + 10 + mid * 11;
    var sel: uint32 = font_u24(f, rec);
    if (vs < sel) { hi = mid - 1; continue; }
    if (vs > sel) { lo = mid + 1; continue; }
    // Non-default table: explicit (code point, glyph) pairs.
    var ndef: uint32 = font_u32(f, rec + 7);
    if (ndef != 0) {
      var t: int64 = sub + (int64)ndef;
      var cnt: int64 = (int64)font_u32(f, t);
      var a: int64 = 0;
      var b: int64 = cnt - 1;
      while (a <= b) {
        var m: int64 = (a + b) / 2;
        var c: uint32 = font_u24(f, t + 4 + m * 5);
        if (cp < c) { b = m - 1; } else if (cp > c) { a = m + 1; }
        else {
          var g: uint32 = font_u16(f, t + 4 + m * 5 + 3);
          if (g < (uint32)f->num_glyphs) { return (int32)g; }
          return base;
        }
      }
    }
    return base;
  }
  return base;
}
