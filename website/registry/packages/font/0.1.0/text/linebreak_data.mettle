/// Packed class and flags of code point cp (see the top of this file).
export fn font_lb_value(cp: uint32) -> int32 {
  // Binary search for the last range that starts at or before cp.
  var lo: int64 = 0;
  var hi: int64 = LB_COUNT;
  while (lo < hi) {
    var mid: int64 = (lo + hi) / 2;
    if (LB_START[mid] <= cp) { lo = mid + 1; } else { hi = mid; }
  }
  if (lo == 0) { return FONT_LB_AL; }
  var i: int64 = lo - 1;
  if (cp > LB_END[i]) { return FONT_LB_AL; }
  return (int32)LB_VALUE[i];
}
