const DEC_COUNT: int64 = 2081;
const COMP_COUNT: int64 = 961;

// Hangul syllable arithmetic (Unicode chapter 3.12).
const S_BASE: uint32 = 0xAC00;
const L_BASE: uint32 = 0x1100;
const V_BASE: uint32 = 0x1161;
const T_BASE: uint32 = 0x11A7;
const L_COUNT: uint32 = 19;
const V_COUNT: uint32 = 21;
const T_COUNT: uint32 = 28;
const N_COUNT: uint32 = 588;
const S_COUNT: uint32 = 11172;

// Value of the last run that starts at or before cp. The first run starts at 0.
fn ucd_props(cp: uint32) -> int32 {
  if (cp > 0x10FFFF) { return 0; }
  var lo: int64 = 0;
  var hi: int64 = PROPS_COUNT;
  while (lo < hi) {
    var mid: int64 = (lo + hi) / 2;
    if (PROPS_START[mid] <= cp) { lo = mid + 1; } else { hi = mid; }
  }
  return (int32)PROPS_VALUE[lo - 1];
}

/// General_Category of cp, one of the FONT_GC_* values (FONT_GC_Cn if unassigned).
export fn font_ucd_gc(cp: uint32) -> uint8 {
  return (uint8)(ucd_props(cp) & 31);
}

/// True for Default_Ignorable_Code_Point.
export fn font_ucd_default_ignorable(cp: uint32) -> bool {
  return (ucd_props(cp) & 32) != 0;
}

/// True when Grapheme_Cluster_Break is Extend, SpacingMark or ZWJ.
export fn font_ucd_grapheme_extend(cp: uint32) -> bool {
  return (ucd_props(cp) & 64) != 0;
}

/// Canonical_Combining_Class of cp (0 for starters and unassigned code points).
export fn font_ucd_ccc(cp: uint32) -> uint8 {
  if (cp > 0x10FFFF) { return 0; }
  var lo: int64 = 0;
  var hi: int64 = CCC_COUNT;
  while (lo < hi) {
    var mid: int64 = (lo + hi) / 2;
    if (CCC_START[mid] <= cp) { lo = mid + 1; } else { hi = mid; }
  }
  return CCC_VALUE[lo - 1];
}

/// One level of canonical decomposition. A pair gives *a and *b; a singleton
/// gives *a and *b = 0. Returns false (and leaves a and b alone) when cp has
/// no canonical decomposition. Hangul syllables are decomposed by arithmetic.
export fn font_ucd_decompose(cp: uint32, a: uint32*, b: uint32*) -> bool {
  if (cp >= S_BASE && cp < S_BASE + S_COUNT) {
    var si: uint32 = cp - S_BASE;
    var t: uint32 = si % T_COUNT;
    if (t == 0) {
      *a = L_BASE + si / N_COUNT;
      *b = V_BASE + (si % N_COUNT) / T_COUNT;
    } else {
      *a = cp - t;
      *b = T_BASE + t;
    }
    return true;
  }
  var lo: int64 = 0;
  var hi: int64 = DEC_COUNT;
  while (lo < hi) {
    var mid: int64 = (lo + hi) / 2;
    if (DEC_CP[mid] < cp) { lo = mid + 1; } else { hi = mid; }
  }
  if (lo < DEC_COUNT && DEC_CP[lo] == cp) {
    *a = DEC_A[lo];
    *b = DEC_B[lo];
    return true;
  }
  return false;
}

/// The primary composite of the pair (a, b), or 0 when there is none. Pairs
/// whose composite is excluded from composition (Full_Composition_Exclusion)
/// give 0. Hangul jamo compose by arithmetic.
export fn font_ucd_compose(a: uint32, b: uint32) -> uint32 {
  if (a >= L_BASE && a < L_BASE + L_COUNT && b >= V_BASE && b < V_BASE + V_COUNT) {
    return S_BASE + ((a - L_BASE) * V_COUNT + (b - V_BASE)) * T_COUNT;
  }
  if (a >= S_BASE && a < S_BASE + S_COUNT && (a - S_BASE) % T_COUNT == 0
    && b > T_BASE && b < T_BASE + T_COUNT) {
    return a + (b - T_BASE);
  }
  var lo: int64 = 0;
  var hi: int64 = COMP_COUNT;
  while (lo < hi) {
    var mid: int64 = (lo + hi) / 2;
    var ma: uint32 = COMP_A[mid];
    if (ma < a || (ma == a && COMP_B[mid] < b)) { lo = mid + 1; } else { hi = mid; }
  }
  if (lo < COMP_COUNT && COMP_A[lo] == a && COMP_B[lo] == b) { return COMP_C[lo]; }
  return 0;
}
