// The legacy 'kern' table: Microsoft version 0 and Apple version 1 headers,
// sub-table formats 0 (sorted pairs) and 2 (class array). Used when a font
// has no GPOS kerning.
// Spec: OpenType "kern - Kerning" and Apple TrueType Reference "kern".

import "font/sfnt/face";

fn pairs0(f: FontFace*, p: int64, left: int32, right: int32) -> int32 {
  var n: int64 = (int64)font_u16(f, p);
  if (n > (f->len - p) / 6) { n = (f->len - p) / 6; }
  var key: uint32 = ((uint32)left << 16) | (uint32)right;
  var lo: int64 = 0;
  var hi: int64 = n - 1;
  while (lo <= hi) {
    var mid: int64 = (lo + hi) / 2;
    var r: int64 = p + 8 + mid * 6;
    var k: uint32 = font_u32(f, r);
    if (k < key) { lo = mid + 1; } else if (k > key) { hi = mid - 1; } else { return font_i16(f, r + 4); }
  }
  return 0;
}

fn class2(f: FontFace*, st: int64, t: int64, g: int32) -> int64 {
  if (t == st) { return -1; }
  var first: int32 = (int32)font_u16(f, t);
  var n: int32 = (int32)font_u16(f, t + 2);
  if (g < first || g >= first + n) { return -1; }
  return (int64)font_u16(f, t + 4 + (int64)(g - first) * 2);
}

fn pairs2(f: FontFace*, st: int64, p: int64, left: int32, right: int32) -> int32 {
  var lt: int64 = st + (int64)font_u16(f, p + 2);
  var rt: int64 = st + (int64)font_u16(f, p + 4);
  var arr: int64 = st + (int64)font_u16(f, p + 6);
  var l: int64 = class2(f, st, lt, left);
  var r: int64 = class2(f, st, rt, right);
  if (l < 0 || r < 0 || arr == st) { return 0; }
  return font_i16(f, st + l + r);
}

/// Horizontal kerning for the pair (left, right) in font units, summed over
/// the kern table's horizontal sub-tables (0 when none).
export fn font_kern(f: FontFace*, left: int32, right: int32) -> int32 {
  if (f->kern == 0) { return 0; }
  var k: int64 = f->kern;
  var end: int64 = k + f->kern_len;
  var total: int32 = 0;
  if (font_u16(f, k) == 0) {
    var n: int64 = (int64)font_u16(f, k + 2);
    var st: int64 = k + 4;
    for i: int64 in 0..n {
      if (st + 6 > end) { break; }
      var len: int64 = (int64)font_u16(f, st + 2);
      var cov: uint32 = font_u16(f, st + 4);
      var fmt: uint32 = cov >> 8;
      var horiz: bool = (cov & 1) != 0 && (cov & 4) == 0 && (cov & 2) == 0;
      if (horiz) {
        var v: int32 = 0;
        if (fmt == 0) { v = pairs0(f, st + 6, left, right); }
        else if (fmt == 2) { v = pairs2(f, st, st + 6, left, right); }
        if ((cov & 8) != 0) { total = v; } else { total = total + v; }
      }
      if (len < 6) { break; }
      // Some fonts have a format 0 table longer than 64 KB; the length
      // field then wraps, so only the last sub-table may be that big.
      st = st + len;
    }
    return total;
  }
  if (font_u32(f, k) == 0x00010000) {
    var n: int64 = (int64)font_u32(f, k + 4);
    var st: int64 = k + 8;
    for i: int64 in 0..n {
      if (st + 8 > end) { break; }
      var len: int64 = (int64)font_u32(f, st);
      var cov: uint32 = font_u16(f, st + 4);
      var fmt: uint32 = cov & 0xFF;
      if ((cov & 0xE000) == 0) {
        if (fmt == 0) { total = total + pairs0(f, st + 8, left, right); }
        else if (fmt == 2) { total = total + pairs2(f, st, st + 8, left, right); }
      }
      if (len < 8) { break; }
      st = st + len;
    }
  }
  return total;
}
