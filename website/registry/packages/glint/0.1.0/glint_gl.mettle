  p = glint_getproc_cb("glPolygonOffsetClamp"); if (p == 0) { miss += 1; } glPolygonOffsetClamp = (fn(float32, float32, float32) -> void)p;
  return miss;
}

// Fill every GL 4.6 core function pointer with glint_getproc_cb. A name the driver
// does not give stays 0. Returns how many were missing.
export fn glint_load_gl(glint_getproc_cb: fn(cstring) -> int64) -> int32 {
  var miss: int32 = 0;
  miss += glint_load_gl_part0(glint_getproc_cb);
  miss += glint_load_gl_part1(glint_getproc_cb);
  miss += glint_load_gl_part2(glint_getproc_cb);
  miss += glint_load_gl_part3(glint_getproc_cb);
  miss += glint_load_gl_part4(glint_getproc_cb);
  miss += glint_load_gl_part5(glint_getproc_cb);
  miss += glint_load_gl_part6(glint_getproc_cb);
  miss += glint_load_gl_part7(glint_getproc_cb);
  miss += glint_load_gl_part8(glint_getproc_cb);
  miss += glint_load_gl_part9(glint_getproc_cb);
  miss += glint_load_gl_part10(glint_getproc_cb);
  miss += glint_load_gl_part11(glint_getproc_cb);
  miss += glint_load_gl_part12(glint_getproc_cb);
  miss += glint_load_gl_part13(glint_getproc_cb);
  miss += glint_load_gl_part14(glint_getproc_cb);
  miss += glint_load_gl_part15(glint_getproc_cb);
  miss += glint_load_gl_part16(glint_getproc_cb);
  miss += glint_load_gl_part17(glint_getproc_cb);
  miss += glint_load_gl_part18(glint_getproc_cb);
  miss += glint_load_gl_part19(glint_getproc_cb);
  miss += glint_load_gl_part20(glint_getproc_cb);
  return miss;
}

export const GLINT_GL_FUNCTION_COUNT: int32 = 657;
