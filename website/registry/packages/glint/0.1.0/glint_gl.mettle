  p = glint_getproc_cb("glGetTextureSubImage"); if (p == 0) { miss += 1; } glGetTextureSubImage = (fn(uint32, int32, int32, int32, int32, int32, int32, int32, uint32, uint32, int32, rawptr) -> void)p;
  p = glint_getproc_cb("glGetCompressedTextureSubImage"); if (p == 0) { miss += 1; } glGetCompressedTextureSubImage = (fn(uint32, int32, int32, int32, int32, int32, int32, int32, int32, rawptr) -> void)p;
  p = glint_getproc_cb("glGetGraphicsResetStatus"); if (p == 0) { miss += 1; } glGetGraphicsResetStatus = (fn() -> uint32)p;
  p = glint_getproc_cb("glGetnCompressedTexImage"); if (p == 0) { miss += 1; } glGetnCompressedTexImage = (fn(uint32, int32, int32, rawptr) -> void)p;
  p = glint_getproc_cb("glGetnTexImage"); if (p == 0) { miss += 1; } glGetnTexImage = (fn(uint32, int32, uint32, uint32, int32, rawptr) -> void)p;
  p = glint_getproc_cb("glGetnUniformdv"); if (p == 0) { miss += 1; } glGetnUniformdv = (fn(uint32, int32, int32, float64*) -> void)p;
  p = glint_getproc_cb("glGetnUniformfv"); if (p == 0) { miss += 1; } glGetnUniformfv = (fn(uint32, int32, int32, float32*) -> void)p;
  p = glint_getproc_cb("glGetnUniformiv"); if (p == 0) { miss += 1; } glGetnUniformiv = (fn(uint32, int32, int32, int32*) -> void)p;
  p = glint_getproc_cb("glGetnUniformuiv"); if (p == 0) { miss += 1; } glGetnUniformuiv = (fn(uint32, int32, int32, uint32*) -> void)p;
  p = glint_getproc_cb("glReadnPixels"); if (p == 0) { miss += 1; } glReadnPixels = (fn(int32, int32, int32, int32, uint32, uint32, int32, rawptr) -> void)p;
  p = glint_getproc_cb("glTextureBarrier"); if (p == 0) { miss += 1; } glTextureBarrier = (fn() -> void)p;
  p = glint_getproc_cb("glSpecializeShader"); if (p == 0) { miss += 1; } glSpecializeShader = (fn(uint32, cstring, uint32, uint32*, uint32*) -> void)p;
  p = glint_getproc_cb("glMultiDrawArraysIndirectCount"); if (p == 0) { miss += 1; } glMultiDrawArraysIndirectCount = (fn(uint32, rawptr, int64, int32, int32) -> void)p;
