}

fn glint_load_gl_part20(glint_getproc_cb: fn(cstring) -> int64) -> int32 {
  var miss: int32 = 0;
  var p: int64 = 0;
  p = glint_getproc_cb("glGetQueryBufferObjectuiv"); if (p == 0) { miss += 1; } glGetQueryBufferObjectuiv = (fn(uint32, uint32, uint32, int64) -> void)p;
