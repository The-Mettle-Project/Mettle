  p = glint_getproc_cb("glGetQueryBufferObjectiv"); if (p == 0) { miss += 1; } glGetQueryBufferObjectiv = (fn(uint32, uint32, uint32, int64) -> void)p;
  p = glint_getproc_cb("glGetQueryBufferObjectui64v"); if (p == 0) { miss += 1; } glGetQueryBufferObjectui64v = (fn(uint32, uint32, uint32, int64) -> void)p;
