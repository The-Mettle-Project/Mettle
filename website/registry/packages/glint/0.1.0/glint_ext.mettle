  p = glint_getproc_cb("glGetLocalConstantFloatvEXT"); if (p == 0) { miss += 1; } glGetLocalConstantFloatvEXT = (fn(uint32, uint32, float32*) -> void)p;
  p = glint_getproc_cb("glVertexWeightfEXT"); if (p == 0) { miss += 1; } glVertexWeightfEXT = (fn(float32) -> void)p;
  p = glint_getproc_cb("glVertexWeightfvEXT"); if (p == 0) { miss += 1; } glVertexWeightfvEXT = (fn(float32*) -> void)p;
  p = glint_getproc_cb("glVertexWeightPointerEXT"); if (p == 0) { miss += 1; } glVertexWeightPointerEXT = (fn(int32, uint32, int32, rawptr) -> void)p;
  p = glint_getproc_cb("glAcquireKeyedMutexWin32EXT"); if (p == 0) { miss += 1; } glAcquireKeyedMutexWin32EXT = (fn(uint32, uint64, uint32) -> uint8)p;
