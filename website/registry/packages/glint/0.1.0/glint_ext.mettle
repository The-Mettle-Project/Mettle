  p = glint_getproc_cb("glGetInvariantBooleanvEXT"); if (p == 0) { miss += 1; } glGetInvariantBooleanvEXT = (fn(uint32, uint32, uint8*) -> void)p;
  p = glint_getproc_cb("glGetInvariantIntegervEXT"); if (p == 0) { miss += 1; } glGetInvariantIntegervEXT = (fn(uint32, uint32, int32*) -> void)p;
  p = glint_getproc_cb("glGetInvariantFloatvEXT"); if (p == 0) { miss += 1; } glGetInvariantFloatvEXT = (fn(uint32, uint32, float32*) -> void)p;
