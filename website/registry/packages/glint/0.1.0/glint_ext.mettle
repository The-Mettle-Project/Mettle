// Fill every extension function pointer with glint_getproc_cb. A name the driver
// does not give stays 0. Returns how many were missing.
export fn glint_load_ext(glint_getproc_cb: fn(cstring) -> int64) -> int32 {
  var miss: int32 = 0;
  miss += glint_load_ext_part0(glint_getproc_cb);
  miss += glint_load_ext_part1(glint_getproc_cb);
  miss += glint_load_ext_part2(glint_getproc_cb);
  miss += glint_load_ext_part3(glint_getproc_cb);
  miss += glint_load_ext_part4(glint_getproc_cb);
  miss += glint_load_ext_part5(glint_getproc_cb);
  miss += glint_load_ext_part6(glint_getproc_cb);
  miss += glint_load_ext_part7(glint_getproc_cb);
  miss += glint_load_ext_part8(glint_getproc_cb);
  miss += glint_load_ext_part9(glint_getproc_cb);
  miss += glint_load_ext_part10(glint_getproc_cb);
  miss += glint_load_ext_part11(glint_getproc_cb);
  miss += glint_load_ext_part12(glint_getproc_cb);
  miss += glint_load_ext_part13(glint_getproc_cb);
  miss += glint_load_ext_part14(glint_getproc_cb);
  miss += glint_load_ext_part15(glint_getproc_cb);
  miss += glint_load_ext_part16(glint_getproc_cb);
  miss += glint_load_ext_part17(glint_getproc_cb);
  miss += glint_load_ext_part18(glint_getproc_cb);
  miss += glint_load_ext_part19(glint_getproc_cb);
  miss += glint_load_ext_part20(glint_getproc_cb);
  miss += glint_load_ext_part21(glint_getproc_cb);
  miss += glint_load_ext_part22(glint_getproc_cb);
  miss += glint_load_ext_part23(glint_getproc_cb);
  miss += glint_load_ext_part24(glint_getproc_cb);
  miss += glint_load_ext_part25(glint_getproc_cb);
  miss += glint_load_ext_part26(glint_getproc_cb);
  miss += glint_load_ext_part27(glint_getproc_cb);
  return miss;
}

