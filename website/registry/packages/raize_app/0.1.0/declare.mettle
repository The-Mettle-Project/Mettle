/// example:
///   rz_delete(app, "/tasks/:id", &delete_task);
export fn rz_delete(app: RzApp*, pattern: string, handler: fn(RzContext*) -> int32) {
  rz_route(app, "DELETE", pattern, handler);
}

/// Sets a configuration default. Precedence: framework default < rz_default <
/// RAIZE_<KEY> environment variable < --port N. Keys are the environment names
/// without RAIZE_, lowercase ("port", "workers", "max_body_bytes").
///
/// in:      app    the app
///          key    the config key; copied
///          value  the value as text; copied; checked by rz_run
/// returns: nothing; an unknown key or a bad value is reported by rz_run
/// owns:    nothing kept from the caller
/// thread:  the declaration function only
/// example:
///   rz_default(app, "port", "8075");
export fn rz_default(app: RzApp*, key: string, value: string) {
  if (app == 0) { return; }
  if (app->state->ndefaults >= RZ__APP_MAX_DEFAULTS) {
    rz__app_error(app, "rz_default(\"{key}\"): more than {RZ__APP_MAX_DEFAULTS} defaults — set fewer");
    return;
  }
  app->state->defaults[app->state->ndefaults].key = rz_str_dup(key);
  app->state->defaults[app->state->ndefaults].value = rz_str_dup(value);
  app->state->ndefaults = app->state->ndefaults + 1;
}

/// Makes an in-memory data layer that the app owns and frees when rz_run returns.
///
/// in:      app       the app
///          def       the resource (`note_resource()`)
///          capacity  most records, 1..1000000
/// returns: the layer, or 0 after recording an error (rz_run then exits 1)
/// owns:    the app owns the layer; never free it yourself
/// thread:  the declaration function only; the layer itself is any-thread
/// example:
///   g_tasks = rz_mem_layer(app, task_resource(), 64);
export fn rz_mem_layer(app: RzApp*, def: RzResourceDef*, capacity: int32) -> RzDataLayer* {
  if (app == 0) { return 0; }
  if (app->state->nlayers >= RZ__APP_MAX_LAYERS) {
    rz__app_error(app, "rz_mem_layer: more than {RZ__APP_MAX_LAYERS} app layers — share a layer or make fewer");
    return 0;
  }
  var dl: RzDataLayer* = rz_mem_layer_new(def, capacity);
  if (dl == 0) {
    rz__app_error(app, "rz_mem_layer: cannot make a memory layer of capacity {capacity} — pass a built resource and a capacity 1..1000000");
    return 0;
  }
  app->state->layers[app->state->nlayers] = (rawptr)dl;
  app->state->nlayers = app->state->nlayers + 1;
  return dl;
}

/// internal: generated <snake>_json_api. Records a JSON API mount and checks it.
/// in:      app; base the route prefix; dl the layer; def the resource
/// returns: RZ_OK, or RZ_E_INVALID after recording an error
/// owns:    nothing kept
export fn rz__app_api(app: RzApp*, base: string, dl: RzDataLayer*, def: RzResourceDef*) -> int32 {
  if (app == 0) { return RZ_E_USAGE; }
  if (def == 0 || def->status != RZ_OK) {
    rz__app_error(app, "json api {base}: the resource definition is invalid — rebuild with tools/rzpp");
    return RZ_E_INVALID;
  }
  if (dl == 0) {
    rz__app_error(app, "json api {base}: no data layer — pass rz_mem_layer(app, {def->name}_resource(), N)");
    return RZ_E_INVALID;
  }
  if (dl->def != def) {
    rz__app_error(app, "json api {base}: the data layer stores {dl->def->type_name}, not {def->type_name} — pass a layer made for {def->name}_resource()");
    return RZ_E_INVALID;
  }
  if (base.length < 2 || base.chars[0] != 47 || base.chars[base.length - 1] == 47) {
    rz__app_error(app, "json api \"{base}\": the base must start with / and not end with / — e.g. \"/api/{def->name}s\"");
    return RZ_E_INVALID;
  }
  for i in 0..app->state->napis {
    if (app->state->apis[i] == (rawptr)def) {
      rz__app_error(app, "json api {base}: {def->name}_json_api is mounted twice — mount each resource once");
      return RZ_E_INVALID;
    }
  }
  if (app->state->napis >= RZ__APP_MAX_LAYERS) {
    rz__app_error(app, "json api {base}: more than {RZ__APP_MAX_LAYERS} API mounts — mount fewer");
    return RZ_E_INVALID;
  }
  app->state->apis[app->state->napis] = (rawptr)def;
  app->state->napis = app->state->napis + 1;
  return RZ_OK;
}

/// internal: generated <snake>_json_api. Declares route `verb` base+suffix.
/// in:      app; verb; base the API prefix; suffix "" or "/:id..."; handler
/// returns: nothing
/// owns:    nothing kept
export fn rz__app_route(app: RzApp*, verb: string, base: string, suffix: string, handler: fn(RzContext*) -> int32) {
  var b: RzBuf* = rz_buf_new();
  rz_buf_add(b, base);
  rz_buf_add(b, suffix);
  rz_route(app, verb, rz_buf_str(b), handler);
  rz_buf_free(b);
}

/// internal: generated <snake>_signal. Records a Signal mount; rz_run registers it
/// on the channel router and serves its page at `path`.
/// in:      app; name the snake name; path the page route; head extra <head> markup;
///          size sizeof the state; mount/handle/view/leave the generated wrappers
/// returns: nothing; mistakes are recorded for rz_run
/// owns:    copies name, path and head
export fn rz__app_signal(app: RzApp*, name: string, path: string, head: string, size: int64, mount: fn(rawptr, RzConn*) -> int32, handle: fn(rawptr, string, string) -> int32, view: fn(rawptr) -> RzHtml*, leave: fn(rawptr) -> void) {
  if (app == 0) { return; }
  if (app->state->nsignals >= RZ__APP_MAX_SIGNALS) {
    rz__app_error(app, "{name}_signal: more than {RZ__APP_MAX_SIGNALS} Signals — mount fewer");
    return;
  }
  for i in 0..app->state->nsignals {
    if (rz_str_eq(app->state->signals[i].name, name)) {
      rz__app_error(app, "{name}_signal(app, \"{path}\"): mounted twice — mount each Signal once");
      return;
    }
  }
  var m: Rz_SignalMount* = &app->state->signals[app->state->nsignals];
  m->name = rz_str_dup(name);
  m->path = rz_str_dup(path);
  m->head = rz_str_dup(head);
  m->size = size;
  m->mount = mount;
  m->handle = handle;
  m->view = view;
  m->leave = leave;
  app->state->nsignals = app->state->nsignals + 1;
  rz_route(app, "GET", path, &rz__app_signal_page);
}

/// internal: app (the route of every mounted Signal). Serves the page of the Signal
/// mounted at the request path.
/// in:      ctx the request
/// returns: the HTTP status set (200, or 404 when no Signal is mounted there)
/// owns:    nothing
export fn rz__app_signal_page(ctx: RzContext*) -> int32 {
  var app: RzApp* = g_app;
  for i in 0..app->state->nsignals {
    if (rz_str_eq(app->state->signals[i].path, ctx->req->path)) {
      return rz_signal_page(ctx, app->state->signals[i].name, app->state->signals[i].head);
    }
  }
  return rz_ctx_not_found(ctx);
}

// The app rz_run is serving: set before the first request, read-only afterwards.
var g_app: RzApp* = 0;

/// internal: app/run. Publishes the app the derived handlers read (before serving).
/// in:      app the app rz_run serves
/// returns: nothing
/// owns:    nothing; the app outlives every request
export fn rz__app_set_current(app: RzApp*) {
  g_app = app;
}

/// internal: app/run. The app rz_run is serving, or 0.
/// in:      nothing
/// returns: the app
/// owns:    nothing
export fn rz__app_current() -> RzApp* {
  return g_app;
}
