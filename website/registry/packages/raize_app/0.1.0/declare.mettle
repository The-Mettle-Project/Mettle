// raize/app/declare — the calls a declaration function makes.
// reference: app
// thread: the declaration function only (main thread, inside rz_run, before serving).
//
// Each call checks its arguments and records what it declares; mistakes are recorded
// as errors that rz_run prints before exiting 1. Nothing listens and no thread starts
// until every declaration is in.

import "raize_core/str/str";
import "raize_core/core/status";
import "raize_core/context/context";
import "raize_signal/html";
import "raize_signal/signal";
import "raize_resource/resource";
import "types";

fn rz__verb_ok(verb: string) -> bool {
  return rz_str_eq(verb, "GET") || rz_str_eq(verb, "POST") || rz_str_eq(verb, "PUT") ||
    rz_str_eq(verb, "PATCH") || rz_str_eq(verb, "DELETE") || rz_str_eq(verb, "HEAD") || rz_str_eq(verb, "OPTIONS");
}

/// Declares a route for any verb. The handler runs on a worker thread for each
/// request whose method is `verb` and whose path matches `pattern` (`/tasks/:id`,
/// `/static/*path`).
///
/// in:      app      the app being declared (from rz_run)
///          verb     "GET", "POST", "PUT", "PATCH", "DELETE", "HEAD" or "OPTIONS"
///          pattern  starts with "/"; borrowed, copied into the app
///          handler  returns the HTTP status it set (every rz_ctx_* returns it)
/// returns: nothing; a bad verb or pattern, or a duplicate, is reported by rz_run
/// owns:    nothing kept from the caller
/// thread:  the declaration function only
/// example:
///   rz_route(app, "PUT", "/tasks/:id", &replace_task);
export fn rz_route(app: RzApp*, verb: string, pattern: string, handler: fn(RzContext*) -> int32) {
  if (app == 0) { return; }
  if (!rz__verb_ok(verb)) {
    rz__app_error(app, "route {pattern}: unknown verb \"{verb}\" — use GET, POST, PUT, PATCH, DELETE, HEAD or OPTIONS");
    return;
  }
  if (pattern.length == 0 || pattern.chars[0] != 47) {
    rz__app_error(app, "route {verb} \"{pattern}\" does not start with / — write the full path, e.g. \"/{pattern}\"");
    return;
  }
  if (app->state->nroutes >= RZ__APP_MAX_ROUTES) {
    rz__app_error(app, "route {verb} {pattern}: more than {RZ__APP_MAX_ROUTES} routes — mount fewer routes");
    return;
  }
  var r: Rz_Route* = &app->state->routes[app->state->nroutes];
  r->verb = rz_str_dup(verb);
  r->path = rz_str_dup(pattern);
  r->handler = handler;
  app->state->nroutes = app->state->nroutes + 1;
}

/// Declares a GET route (see rz_route).
///
/// in:      app the app; pattern the path pattern (copied); handler returns its status
/// returns: nothing; mistakes are reported by rz_run
/// owns:    nothing kept from the caller
/// thread:  the declaration function only
/// example:
///   rz_get(app, "/healthz", &health);
export fn rz_get(app: RzApp*, pattern: string, handler: fn(RzContext*) -> int32) {
  rz_route(app, "GET", pattern, handler);
}

