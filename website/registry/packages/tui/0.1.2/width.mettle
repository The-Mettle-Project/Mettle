// Character widths in terminal columns, and UTF-8 decoding.
// The tables come from tools/gen_width.py (UAX #11 East Asian Width).

import "width_tables";

fn tui_in_table(t: uint32*, n: int32, cp: uint32) -> bool {
  if (cp < t[0] || cp > t[2 * n - 1]) { return false; }
  var lo: int32 = 0;
  var hi: int32 = n - 1;
  while (lo <= hi) {
    var mid: int32 = (lo + hi) / 2;
    if (cp < t[2 * mid]) {
      hi = mid - 1;
    } else if (cp > t[2 * mid + 1]) {
      lo = mid + 1;
    } else {
      return true;
    }
  }
  return false;
}

// Columns a code point takes: 0 (a mark that joins the character before),
// 1 or 2. Control characters give -1.
export fn tui_cp_width(cp: int32) -> int32 {
  if (cp < 0) { return -1; }
  if (cp >= 32 && cp < 127) { return 1; }
  if (cp < 32 || (cp >= 127 && cp < 160)) { return -1; }
  var u: uint32 = (uint32)cp;
  if (tui_in_table(&TUI_ZERO_W[0], TUI_ZERO_W_N, u)) { return 0; }
  if (tui_in_table(&TUI_WIDE_W[0], TUI_WIDE_W_N, u)) { return 2; }
  return 1;
}

export fn tui_is_regional(cp: int32) -> bool {
  return cp >= 0x1F1E6 && cp <= 0x1F1FF;
}

// Decodes one UTF-8 character at p[i] (n bytes in all). Writes the code
// point to *cp and returns its length in bytes (at least 1). Bad bytes give
// U+FFFD with length 1, following the Unicode "maximal subpart" practice.
export fn tui_utf8_next(p: uint8*, n: int64, i: int64, cp: int32*) -> int64 {
  var b0: int32 = (int32)p[i];
  if (b0 < 0x80) { *cp = b0; return 1; }
  var need: int64 = 0;
  var c: int32 = 0;
  var min: int32 = 0;
  if (b0 >= 0xC2 && b0 <= 0xDF) {
    need = 1; c = b0 & 0x1F; min = 0x80;
  } else if (b0 >= 0xE0 && b0 <= 0xEF) {
    need = 2; c = b0 & 0x0F; min = 0x800;
  } else if (b0 >= 0xF0 && b0 <= 0xF4) {
    need = 3; c = b0 & 0x07; min = 0x10000;
  } else {
    *cp = 0xFFFD;
    return 1;
  }
  if (i + need >= n + 1) { *cp = 0xFFFD; return 1; }
  for k: int64 in 1..need + 1 {
    var b: int32 = (int32)p[i + k];
    if ((b & 0xC0) != 0x80) { *cp = 0xFFFD; return 1; }
    c = (c << 6) | (b & 0x3F);
  }
  if (c < min || c > 0x10FFFF || (c >= 0xD800 && c <= 0xDFFF)) { *cp = 0xFFFD; return 1; }
  *cp = c;
  return need + 1;
}

// Writes cp as UTF-8 into out (room for 4) and returns the byte count.
export fn tui_utf8_put(out: uint8*, cp: int32) -> int32 {
  if (cp < 0 || cp > 0x10FFFF || (cp >= 0xD800 && cp <= 0xDFFF)) { cp = 0xFFFD; }
  if (cp < 0x80) { out[0] = (uint8)cp; return 1; }
  if (cp < 0x800) {
    out[0] = (uint8)(0xC0 | (cp >> 6));
    out[1] = (uint8)(0x80 | (cp & 0x3F));
    return 2;
  }
  if (cp < 0x10000) {
    out[0] = (uint8)(0xE0 | (cp >> 12));
    out[1] = (uint8)(0x80 | ((cp >> 6) & 0x3F));
    out[2] = (uint8)(0x80 | (cp & 0x3F));
    return 3;
  }
  out[0] = (uint8)(0xF0 | (cp >> 18));
  out[1] = (uint8)(0x80 | ((cp >> 12) & 0x3F));
  out[2] = (uint8)(0x80 | ((cp >> 6) & 0x3F));
  out[3] = (uint8)(0x80 | (cp & 0x3F));
  return 4;
}

// Columns a whole string takes when drawn with tui_put.
export fn tui_str_width(s: string) -> int32 {
  var w: int32 = 0;
  var i: int64 = 0;
  var n: int64 = (int64)s.length;
  var prev_ri: bool = false;
  var after_zwj: bool = false;
  while (i < n) {
    var cp: int32 = 0;
    i = i + tui_utf8_next(s.chars, n, i, &cp);
    var cw: int32 = tui_cp_width(cp);
    if (after_zwj) { after_zwj = false; continue; }
    if (cp == 0x200D) { after_zwj = true; continue; }
    if (tui_is_regional(cp)) {
      if (prev_ri) { prev_ri = false; w = w + 1; continue; }
      prev_ri = true;
    } else {
      prev_ri = false;
    }
    if (cw > 0) { w = w + cw; }
  }
  return w;
}
