import "std/mem";
import "std/time";
import "./tensor";
import "./kernels";

export const OP_LEAF = 0;
export const OP_ADD = 1;
export const OP_SUB = 2;
export const OP_MUL = 3;
export const OP_DIV = 4;
export const OP_ADD_SCALAR = 5;
export const OP_MUL_SCALAR = 6;
export const OP_POW_SCALAR = 7;
export const OP_NEG = 8;
export const OP_EXP = 9;
export const OP_LOG = 10;
export const OP_SQRT = 11;
export const OP_TANH = 12;
export const OP_SIGMOID = 13;
export const OP_RELU = 14;
export const OP_LEAKY_RELU = 15;
export const OP_GELU = 16;
export const OP_GELU_TANH = 17;
export const OP_SILU = 18;
export const OP_SOFTPLUS = 19;
export const OP_ABS = 20;
export const OP_CLAMP = 21;
export const OP_SQUARE = 22;
export const OP_SUM_ALL = 30;
export const OP_MEAN_ALL = 31;
export const OP_SUM = 32;
export const OP_MEAN = 33;
export const OP_MAX = 34;
export const OP_RESHAPE = 40;
export const OP_TRANSPOSE = 41;
export const OP_SLICE = 42;
export const OP_CONCAT = 43;
export const OP_MATMUL = 50;
export const OP_MATMUL_NT = 51;
export const OP_LINEAR = 52;
export const OP_SOFTMAX = 60;
export const OP_LOG_SOFTMAX = 61;
export const OP_CAUSAL_SOFTMAX = 62;
export const OP_CROSS_ENTROPY = 63;
export const OP_MSE = 64;
export const OP_BCE_LOGITS = 65;
export const OP_LAYER_NORM = 70;
export const OP_RMS_NORM = 71;
export const OP_DROPOUT = 72;
