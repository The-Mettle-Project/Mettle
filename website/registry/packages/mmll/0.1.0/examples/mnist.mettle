import "std/io";
import "std/mem";
import "std/core";
import "std/conv";
import "std/time";
import "../mmll";

struct Net {
  c1: Conv2d;
  b1: BatchNorm;
  c2: Conv2d;
  b2: BatchNorm;
  fc: Linear;
  out: Linear;
}

fn make_net(ps: Params*, rng: Rng*) -> Net {
  var n: Net;
  n.c1 = make_conv2d(ps, "c1", 1, 32, 3, 1, 1, false, rng);
  n.b1 = make_batch_norm(ps, "b1", 32);
  n.c2 = make_conv2d(ps, "c2", 32, 64, 3, 1, 1, false, rng);
  n.b2 = make_batch_norm(ps, "b2", 64);
  n.fc = make_linear(ps, "fc", 64 * 7 * 7, 256, true, rng);
  n.out = make_linear(ps, "out", 256, 10, true, rng);
  init_kaiming_normal(n.c1.weight, rng);
  init_kaiming_normal(n.c2.weight, rng);
  return n;
}

fn Net_forward(n: Net, x: Var) -> Var {
  var h: Var = max_pool2d(n.b1.forward(n.c1.forward(x)).relu(), 2, 2, 0);
  h = max_pool2d(n.b2.forward(n.c2.forward(h)).relu(), 2, 2, 0);
  h = dropout(n.fc.forward(h.flatten(1)).relu(), 0.4);
  return n.out.forward(h);
}

fn accuracy(n: Net, g: Graph*, images: Tensor, labels: Labels) -> float64 {
  g->record = false;
  g->training = false;
  var plane: int64 = images.shape.size() / images.shape.dims[0];
  var hits: int64 = 0;
  var at: int64 = 0;
  while (at < labels.count) {
    var count: int64 = labels.count - at;
    if (count > 1000) { count = 1000; }
    g->reset();
    var view: Tensor = tensor_view(images.data + at * plane, images.shape.with(0, count));
    hits = hits + count_correct(n.forward(g->input(view)).value(), labels.data + at);
    at = at + count;
  }
  g->record = true;
  g->training = true;
  return (float64)hits / (float64)labels.count;
}

fn load_images(path: string) -> Tensor {
  match (idx_images(path)) {
    case Ok(t): { return t; }
    case Err(e): {
      println("mnist: {e}");
      return tensor_new(shape(0, 1, 28, 28));
    }
  }
  return tensor_new(shape(0, 1, 28, 28));
}

fn load_labels(path: string) -> Labels {
  match (idx_labels(path)) {
    case Ok(l): { return l; }
    case Err(e): {
      println("mnist: {e}");
      return { data: (int32*)0, count: 0 };
    }
  }
  return { data: (int32*)0, count: 0 };
}

fn normalize(t: Tensor) {
  var mean: float32 = 0.1307;
  var inv_std: float32 = (float32)(1.0 / 0.3081);
  for i: int64 in 0..t.shape.size() { t.data[i] = (t.data[i] - mean) * inv_std; }
}

fn main(argc: int32, argv: cstring*) -> int32 {
  if (argc < 2) {
    println("usage: mnist <directory with the four IDX files> [epochs]");
    return 1;
  }
  var dir: string = str_from_cstr(argv[1]);
  var epochs: int64 = if argc > 2 { str_to_i64_or(str_from_cstr(argv[2]), 3) } else { 3 };
  var train_x: Tensor = load_images("{dir}/train-images-idx3-ubyte");
  var train_y: Labels = load_labels("{dir}/train-labels-idx1-ubyte");
  var test_x: Tensor = load_images("{dir}/t10k-images-idx3-ubyte");
  var test_y: Labels = load_labels("{dir}/t10k-labels-idx1-ubyte");
  if (train_y.count == 0 || test_y.count == 0 || train_x.shape.dims[0] != train_y.count || test_x.shape.dims[0] != test_y.count) {
    println("mnist: the image and label files do not match");
    return 1;
  }
  normalize(train_x);
  normalize(test_x);
  println("{train_y.count} training images, {test_y.count} test images");
  var rng: Rng = rng_new(1);
  var ps: Params* = params_new();
  var net: Net = make_net(ps, &rng);
  println("{ps->size()} parameters");
  var opt: Optimizer* = adamw(ps, 2.0e-3, 0.9, 0.999, 1.0e-8, 1.0e-4);
  var g: Graph* = graph_new();
  var batch: int64 = 128;
  var batches: Batches* = make_batches(train_y.count, batch, true, 2);
  var plane: int64 = 28 * 28;
  var bx: float32* = (float32*)malloc(batch * plane * 4);
  var by: int32* = (int32*)malloc(batch * 4);
  var per_epoch: int64 = (train_y.count + batch - 1) / batch;
  var step: int64 = 0;
  for epoch in 0..epochs {
    var started: int64 = time_mono_ns();
    var total: float64 = 0.0;
    var seen: int64 = 0;
    var n: int64 = batches->next();
    while (n > 0) {
      batches->take_rows(train_x, bx);
      batches->take_labels(train_y.data, by);
      opt->set_lr(lr_cosine(step, 100, epochs * per_epoch, 2.0e-3, 2.0e-5));
      g->reset();
      var loss: Var = cross_entropy(net.forward(g->input(tensor_view(bx, shape(n, 1, 28, 28)))), by, 0.0);
      loss.backward();
      opt->step();
      opt->zero_grad();
      total = total + (float64)loss.item() * (float64)n;
      seen = seen + n;
      step = step + 1;
      n = batches->next();
    }
    var secs: float64 = (float64)(time_mono_ns() - started) / 1.0e9;
    println("epoch {epoch + 1}: loss {total / (float64)seen}, test accuracy {100.0 * accuracy(net, g, test_x, test_y)}%, {(float64)seen / secs} images/s");
  }
  match (save_safetensors(ps, "mnist.safetensors")) {
    case Ok(bytes): { println("saved mnist.safetensors, {bytes} bytes"); }
    case Err(e): { println("mnist: {e}"); }
  }
  return 0;
}
