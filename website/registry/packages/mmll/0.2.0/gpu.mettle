struct Gemm {
  a: float32*;
  b: float32*;
  c: float32*;
  bias: float32*;
  m: int32;
  n: int32;
  k: int32;
  lda: int32;
  ldb: int32;
  ldc: int32;
  ta: int32;
  tb: int32;
  accumulate: int32;
  alpha: float32;
  inner: int32;
  sa_outer: int64;
  sa_inner: int64;
  sb_outer: int64;
  sb_inner: int64;
  sc_outer: int64;
  sc_inner: int64;
  splits: int32;
  chunk: int32;
  sp: int64;
}

struct Bcast {
  dims: int32[6];
  sa: int32[6];
  sb: int32[6];
  sd: int32[6];
  rank: int32;
  count: int32;
  op: int32;
  which: int32;
}

