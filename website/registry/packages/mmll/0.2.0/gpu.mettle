struct Conv {
  n: int32;
  c: int32;
  h: int32;
  w: int32;
  kh: int32;
  kw: int32;
  oh: int32;
  ow: int32;
  stride: int32;
  pad: int32;
  dilation: int32;
}

fn z32() -> float32 { return (float32)0.0; }
fn one32() -> float32 { return (float32)1.0; }

fn d_sigmoid(x: float32) -> float32 {
  return one32() / (one32() + expf(-x));
}

fn d_tanh(x: float32) -> float32 {
  var a: float32 = fabsf(x);
  var e: float32 = expf((float32)-2.0 * a);
  var t: float32 = (one32() - e) / (one32() + e);
  if (x < z32()) { return -t; }
  return t;
}

fn d_erf(x: float32) -> float32 {
  var a: float32 = fabsf(x);
  if (a < (float32)0.5) {
    var z: float32 = x * x;
    var s: float32 = (((((((float32)0.000106837606838 * z + (float32)-0.000757575757576) * z + (float32)0.00462962962963) * z + (float32)-0.0238095238095) * z + (float32)0.1) * z + (float32)-0.333333333333) * z + one32());
    return (float32)1.1283791670955126 * x * s;
  }
  var t: float32 = one32() / (one32() + (float32)0.5 * a);
  var poly: float32 = (float32)1.00002368 + t * ((float32)0.37409196 + t * ((float32)0.09678418 + t * ((float32)-0.18628806 + t * ((float32)0.27886807 + t * ((float32)-1.13520398 + t * ((float32)1.48851587 + t * ((float32)-0.82215223 + t * (float32)0.17087277)))))));
  var y: float32 = one32() - t * expf(-a * a + (float32)-1.26551223 + t * poly);
  if (x < z32()) { return -y; }
  return y;
}

fn unary_value(op: int32, v: float32, f0: float32, f1: float32) -> float32 {
  var half: float32 = 0.5;
  if (op == 8) { return -v; }
  if (op == 9) { return expf(v); }
  if (op == 10) { return logf(v); }
  if (op == 11) { return sqrtf(v); }
  if (op == 12) { return d_tanh(v); }
  if (op == 13) { return d_sigmoid(v); }
  if (op == 14) { if (v > z32()) { return v; } return z32(); }
  if (op == 15) { if (v > z32()) { return v; } return f0 * v; }
  if (op == 16) { return half * v * (one32() + d_erf(v * (float32)0.70710678118654752)); }
  if (op == 17) { return v / (one32() + expf((float32)-1.5957691216057308 * (v + (float32)0.044715 * v * v * v))); }
  if (op == 18) { return v * d_sigmoid(v); }
  if (op == 19) {
    var m: float32 = z32();
    if (v > z32()) { m = v; }
    return m + logf(one32() + expf(-fabsf(v)));
  }
  if (op == 20) { return fabsf(v); }
  if (op == 21) {
    var c: float32 = v;
    if (c < f0) { c = f0; }
    if (c > f1) { c = f1; }
    return c;
  }
  if (op == 22) { return v * v; }
  if (op == 5) { return v + f0; }
  if (op == 6) { return v * f0; }
  return expf(f0 * logf(v));
}

fn unary_slope(op: int32, d: float32, v: float32, y: float32, f0: float32, f1: float32) -> float32 {
  var half: float32 = 0.5;
  if (op == 8) { return -d; }
  if (op == 9) { return d * y; }
  if (op == 10) { return d / v; }
  if (op == 11) { if (y > z32()) { return d * half / y; } return z32(); }
  if (op == 12) { return d * (one32() - y * y); }
  if (op == 13) { return d * y * (one32() - y); }
  if (op == 14) { if (v > z32()) { return d; } return z32(); }
  if (op == 15) { if (v > z32()) { return d; } return f0 * d; }
  if (op == 16) {
    var cdf: float32 = half * (one32() + d_erf(v * (float32)0.70710678118654752));
    var pdf: float32 = (float32)0.39894228040143268 * expf(-half * v * v);
    return d * (cdf + v * pdf);
  }
  if (op == 17) {
    var k2: float32 = -1.5957691216057308;
    var s: float32 = one32() / (one32() + expf(k2 * (v + (float32)0.044715 * v * v * v)));
    return d * (s - k2 * v * s * (one32() - s) * (one32() + (float32)0.134145 * v * v));
  }
  if (op == 18) {
    var s: float32 = d_sigmoid(v);
    return d * s * (one32() + v * (one32() - s));
  }
  if (op == 19) { return d * d_sigmoid(v); }
  if (op == 20) {
    if (v > z32()) { return d; }
    if (v < z32()) { return -d; }
    return z32();
  }
  if (op == 21) { if (v >= f0 && v <= f1) { return d; } return z32(); }
  if (op == 22) { return (float32)2.0 * v * d; }
  if (op == 5) { return d; }
  if (op == 6) { return f0 * d; }
  return d * f0 * expf((f0 - one32()) * logf(v));
}

fn binary_value(op: int32, a: float32, b: float32) -> float32 {
  if (op == 1) { return a + b; }
  if (op == 2) { return a - b; }
  if (op == 3) { return a * b; }
  return a / b;
}

fn binary_slope(op: int32, which: int32, d: float32, a: float32, b: float32) -> float32 {
  if (op == 1) { return d; }
  if (op == 2) { if (which == 0) { return d; } return -d; }
  if (op == 3) { if (which == 0) { return d * b; } return d * a; }
  if (which == 0) { return d / b; }
  return -d * a / (b * b);
}

fn drop_bits(key: uint64, index: int64) -> uint64 {
  var z: uint64 = key + (uint64)index * (uint64)0x9E3779B97F4A7C15;
  z = (z ^ (z >> (uint64)30)) * (uint64)0xBF58476D1CE4E5B9;
  z = (z ^ (z >> (uint64)27)) * (uint64)0x94D049BB133111EB;
  return (z ^ (z >> (uint64)31)) >> (uint64)11;
}

kernel(block = 256) k_normal_rows(dst: float32*, seeds: int32*, count: int64, width: int64, scale: float32) {
  var e: int64 = (int64)block.x * 256 + (int64)thread.x;
  var step: int64 = (int64)grid_dim.x * 256;
  while (e < count * width) {
    var at: int64 = e / width;
    var seed: int32 = seeds[at];
    var v: float32 = z32();
    if (seed != 0) {
      var key: uint64 = (uint64)seed * (uint64)0xD1B54A32D192ED03;
      var a: uint64 = drop_bits(key, (e - at * width) * 2);
      var b: uint64 = drop_bits(key, (e - at * width) * 2 + 1);
      var u1: float32 = ((float32)(a >> (uint64)29) + (float32)0.5) / (float32)16777216.0;
      var u2: float32 = (float32)(b >> (uint64)29) / (float32)16777216.0;
      v = scale * sqrtf((float32)-2.0 * logf(u1)) * cosf((float32)6.2831853 * u2);
    }
    dst[e] = v;
    e = e + step;
  }
}

kernel(block = 256) k_fill(p: float32*, value: float32, n: int64) {
  var i: int64 = (int64)block.x * 256 + (int64)thread.x;
  var step: int64 = (int64)grid_dim.x * 256;
  while (i < n) {
    p[i] = value;
    i = i + step;
  }
}

kernel(block = 256) k_add(dst: float32*, src: float32*, alpha: float32, n: int64) {
  var i: int64 = (int64)block.x * 256 + (int64)thread.x;
  var step: int64 = (int64)grid_dim.x * 256;
  while (i < n) {
    dst[i] = dst[i] + alpha * src[i];
    i = i + step;
  }
}

kernel(block = 256) k_unary(op: int32, out: float32*, x: float32*, f0: float32, f1: float32, n: int64) {
  var i: int64 = (int64)block.x * 256 + (int64)thread.x;
  var step: int64 = (int64)grid_dim.x * 256;
  while (i < n) {
    out[i] = unary_value(op, x[i], f0, f1);
    i = i + step;
  }
}

kernel(block = 256) k_unary_back(op: int32, dx: float32*, dy: float32*, x: float32*, y: float32*, f0: float32, f1: float32, n: int64, fresh: int32) {
  var i: int64 = (int64)block.x * 256 + (int64)thread.x;
  var step: int64 = (int64)grid_dim.x * 256;
  var wants_y: bool = op == 9 || op == 11 || op == 12 || op == 13;
  while (i < n) {
    var yv: float32 = z32();
    if (wants_y) { yv = y[i]; }
    if (fresh != 0) {
      dx[i] = unary_slope(op, dy[i], x[i], yv, f0, f1);
    } else {
      dx[i] = dx[i] + unary_slope(op, dy[i], x[i], yv, f0, f1);
    }
    i = i + step;
  }
}

kernel(block = 256) k_binary(op: int32, out: float32*, a: float32*, b: float32*, n: int64) {
  var i: int64 = (int64)block.x * 256 + (int64)thread.x;
  var step: int64 = (int64)grid_dim.x * 256;
  while (i < n) {
    out[i] = binary_value(op, a[i], b[i]);
    i = i + step;
  }
}

kernel(block = 256) k_binary_back(op: int32, which: int32, dst: float32*, dy: float32*, a: float32*, b: float32*, n: int64, fresh: int32) {
  var i: int64 = (int64)block.x * 256 + (int64)thread.x;
  var step: int64 = (int64)grid_dim.x * 256;
  while (i < n) {
    if (fresh != 0) {
      dst[i] = binary_slope(op, which, dy[i], a[i], b[i]);
    } else {
      dst[i] = dst[i] + binary_slope(op, which, dy[i], a[i], b[i]);
    }
    i = i + step;
  }
}

kernel(block = 256) k_bcast(p: Bcast, out: float32*, a: float32*, b: float32*) {
  var i: int32 = block.x * 256 + thread.x;
  if (i >= p.count) { return; }
  var rest: int32 = i;
  var offa: int32 = 0;
  var offb: int32 = 0;
  var d: int32 = p.rank - 1;
  while (d >= 0) {
    var c: int32 = rest % p.dims[d];
    rest = rest / p.dims[d];
    offa = offa + c * p.sa[d];
    offb = offb + c * p.sb[d];
    d = d - 1;
  }
  out[i] = binary_value(p.op, a[offa], b[offb]);
}

kernel(block = 256) k_bcast_back(p: Bcast, dst: float32*, dst_count: int32, dy: float32*, a: float32*, b: float32*) {
  var e: int32 = block.x * 256 + thread.x;
  if (e >= dst_count) { return; }
  var base: int32[6];
  var reps: int32 = 1;
  for d in 0..p.rank {
    if (p.sd[d] != 0) {
      base[d] = (e / p.sd[d]) % p.dims[d];
    } else {
      base[d] = 0;
      reps = reps * p.dims[d];
    }
  }
  var total: float32 = z32();
  for r in 0..reps {
    var rest: int32 = r;
    var offo: int32 = 0;
    var offa: int32 = 0;
    var offb: int32 = 0;
    var scale: int32 = 1;
    var d: int32 = p.rank - 1;
    while (d >= 0) {
      var c: int32 = base[d];
      if (p.sd[d] == 0) {
        c = rest % p.dims[d];
        rest = rest / p.dims[d];
      }
      offo = offo + c * scale;
      scale = scale * p.dims[d];
      offa = offa + c * p.sa[d];
      offb = offb + c * p.sb[d];
      d = d - 1;
    }
    total = total + binary_slope(p.op, p.which, dy[offo], a[offa], b[offb]);
  }
  dst[e] = dst[e] + total;
}

kernel(block = 256) k_partials(x: float32*, y: float32*, mode: int32, n: int64, partial: float32*) {
  workgroup var lanes: float32[256];
  var t: int32 = thread.x;
  var i: int64 = (int64)block.x * 256 + (int64)t;
  var step: int64 = (int64)grid_dim.x * 256;
  var acc: float32 = z32();
  while (i < n) {
    var v: float32 = x[i];
    if (mode == 0) {
      acc = acc + v;
    } else if (mode == 1) {
      acc = acc + v * v;
    } else if (mode == 2) {
      var d: float32 = v - y[i];
      acc = acc + d * d;
    } else if (mode == 4) {
      acc = acc + v * y[i];
    } else {
      var m: float32 = z32();
      if (v > z32()) { m = v; }
      acc = acc + m - v * y[i] + logf(one32() + expf(-fabsf(v)));
    }
    i = i + step;
  }
  lanes[t] = acc;
  barrier(workgroup, acq_rel);
  var width: int32 = 128;
  while (width > 0) {
    if (t < width) { lanes[t] = lanes[t] + lanes[t + width]; }
    barrier(workgroup, acq_rel);
    width = width / 2;
  }
  if (t == 0) { partial[block.x] = lanes[0]; }
}

kernel(block = 256) k_total(partial: float32*, count: int32, out: float32*, scale: float32, accumulate: int32) {
  workgroup var lanes: float32[256];
  var t: int32 = thread.x;
  var acc: float32 = z32();
  var i: int32 = t;
  while (i < count) {
    acc = acc + partial[i];
    i = i + 256;
  }
  lanes[t] = acc;
  barrier(workgroup, acq_rel);
  var width: int32 = 128;
  while (width > 0) {
    if (t < width) { lanes[t] = lanes[t] + lanes[t + width]; }
    barrier(workgroup, acq_rel);
    width = width / 2;
  }
  if (t == 0) {
    if (accumulate != 0) { out[0] = out[0] + lanes[0] * scale; } else { out[0] = lanes[0] * scale; }
  }
}

kernel(block = 256) k_spread(dst: float32*, src: float32*, scale: float32, n: int64) {
  var s: float32 = src[0] * scale;
  var i: int64 = (int64)block.x * 256 + (int64)thread.x;
  var step: int64 = (int64)grid_dim.x * 256;
  while (i < n) {
    dst[i] = dst[i] + s;
    i = i + step;
  }
}

kernel(block = 256) k_pair_back(mode: int32, dx: float32*, x: float32*, y: float32*, dloss: float32*, scale: float32, sign: float32, n: int64) {
  var s: float32 = dloss[0] * scale;
  var i: int64 = (int64)block.x * 256 + (int64)thread.x;
  var step: int64 = (int64)grid_dim.x * 256;
  while (i < n) {
    var v: float32 = x[i];
    var g: float32 = z32();
    if (mode == 2) {
      g = (float32)2.0 * (v - y[i]);
    } else if (sign > z32()) {
      g = d_sigmoid(v) - y[i];
    } else {
      g = v;
    }
    dx[i] = dx[i] + sign * s * g;
    i = i + step;
  }
}

kernel(block = 256) k_reduce_axis(op: int32, out: float32*, arg: int32*, x: float32*, outer: int32, len: int32, inner: int32, scale: float32) {
  var id: int32 = block.x * 256 + thread.x;
  if (id >= outer * inner) { return; }
  var o: int32 = id / inner;
  var i: int32 = id - o * inner;
  var base: int64 = (int64)o * (int64)len * (int64)inner + (int64)i;
  if (op == 34) {
    var best: float32 = x[base];
    var at: int32 = 0;
    for k in 1..len {
      var v: float32 = x[base + (int64)k * (int64)inner];
      if (v > best) {
        best = v;
        at = k;
      }
    }
    out[id] = best;
    arg[id] = at;
    return;
  }
  var total: float32 = z32();
  for k in 0..len { total = total + x[base + (int64)k * (int64)inner]; }
  out[id] = total * scale;
}

kernel(block = 256) k_reduce_axis_back(op: int32, dx: float32*, dy: float32*, arg: int32*, outer: int32, len: int32, inner: int32, scale: float32) {
  var id: int64 = (int64)block.x * 256 + (int64)thread.x;
  if (id >= (int64)outer * (int64)len * (int64)inner) { return; }
  var span: int64 = (int64)len * (int64)inner;
  var o: int64 = id / span;
  var rest: int64 = id - o * span;
  var k: int32 = (int32)(rest / (int64)inner);
  var i: int64 = rest - (int64)k * (int64)inner;
  var src: int64 = o * (int64)inner + i;
  if (op == 34) {
    if (arg[src] == k) { dx[id] = dx[id] + dy[src]; }
    return;
  }
  dx[id] = dx[id] + dy[src] * scale;
}

kernel(block = 256) k_permute(dst: float32*, src: float32*, p: Bcast, accumulate: int32) {
  var i: int32 = block.x * 256 + thread.x;
  if (i >= p.count) { return; }
  var rest: int32 = i;
  var off: int32 = 0;
  var d: int32 = p.rank - 1;
  while (d >= 0) {
    var c: int32 = rest % p.dims[d];
    rest = rest / p.dims[d];
    off = off + c * p.sa[d];
    d = d - 1;
  }
  if (accumulate != 0) { dst[i] = dst[i] + src[off]; } else { dst[i] = src[off]; }
}

kernel(block = 256) k_blocks(dst: float32*, src: float32*, outer: int64, width: int64, dst_stride: int64, src_stride: int64, accumulate: int32) {
  var id: int64 = (int64)block.x * 256 + (int64)thread.x;
  var step: int64 = (int64)grid_dim.x * 256;
  var total: int64 = outer * width;
  while (id < total) {
    var o: int64 = id / width;
    var j: int64 = id - o * width;
    var s: float32 = src[o * src_stride + j];
    var at: int64 = o * dst_stride + j;
    if (accumulate != 0) { dst[at] = dst[at] + s; } else { dst[at] = s; }
    id = id + step;
  }
}

comptime for tile in GEMM_TILES.rows {
  kernel(block = 256) ident("k_gemm_", tile.name)(g: Gemm) {
    const TM: int32 = tile.tm;
    const TN: int32 = tile.tn;
    const BM: int32 = tile.tm * 16;
    const BN: int32 = tile.tn * 16;
    const SA: int32 = tile.tm * 16 + 4;
    const SB: int32 = tile.tn * 16 + 4;
    const TILE_A: int32 = tile.tm * 512 + 128;
    const TILE_B: int32 = tile.tn * 512 + 128;
    workgroup var as: float32[TILE_A];
    workgroup var bs: float32[TILE_B];
    var t: int32 = thread.x;
    var tx: int32 = t % 16;
    var ty: int32 = t / 16;
    var m: int32 = g.m;
    var n: int32 = g.n;
    var lda: int64 = (int64)g.lda;
    var ldb: int64 = (int64)g.ldb;
    var ldc: int64 = (int64)g.ldc;
    var ta: int32 = (int32)workgroup_uniform((uint32)g.ta);
    var tb: int32 = (int32)workgroup_uniform((uint32)g.tb);
    var splits: int32 = (int32)workgroup_uniform((uint32)g.splits);
    var chunk: int32 = (int32)workgroup_uniform((uint32)g.chunk);
    var k_all: int32 = (int32)workgroup_uniform((uint32)g.k);
    var inner: int32 = (int32)workgroup_uniform((uint32)g.inner);
    var zz: int32 = block.z;
    var split: int32 = zz % splits;
    var z: int32 = zz / splits;
    var zo: int32 = z / inner;
    var zi: int32 = z - zo * inner;
    var a: float32* = g.a + (int64)zo * g.sa_outer + (int64)zi * g.sa_inner;
    var b: float32* = g.b + (int64)zo * g.sb_outer + (int64)zi * g.sb_inner;
    var c: float32* = g.c + (int64)zo * g.sc_outer + (int64)zi * g.sc_inner + (int64)split * g.sp;
    var row0: int32 = block.y * BM;
    var col0: int32 = block.x * BN;
    var k_begin: int32 = split * chunk;
    var k_end: int32 = k_begin + chunk;
    if (k_end > k_all) { k_end = k_all; }
    var tiles: int32 = (k_end - k_begin + 15) / 16;
    if (tiles < 0) { tiles = 0; }
    var lane16: int32 = t % 16;
    var a_ptr: float32* = a;
    var b_ptr: float32* = b;
    var a_seen: int32 = 0;
    var b_seen: int32 = 0;
    var a_gap: int64 = 16;
    var b_gap: int64 = 16;
    if (ta == 0) {
      a_ptr = a + (int64)(row0 + ty) * lda + (int64)(k_begin + lane16);
      a_gap = lda * 16;
      comptime for i in 0..TM {
        if (row0 + ty + 16 * i < m) { a_seen = a_seen | (1 << i); }
      }
    } else {
      a_ptr = a + (int64)(k_begin + ty) * lda + (int64)(row0 + lane16);
      comptime for i in 0..TM {
        if (row0 + lane16 + 16 * i < m) { a_seen = a_seen | (1 << i); }
      }
    }
    if (tb != 0) {
      b_ptr = b + (int64)(col0 + ty) * ldb + (int64)(k_begin + lane16);
      b_gap = ldb * 16;
      comptime for j in 0..TN {
        if (col0 + ty + 16 * j < n) { b_seen = b_seen | (1 << j); }
      }
    } else {
      b_ptr = b + (int64)(k_begin + ty) * ldb + (int64)(col0 + lane16);
      comptime for j in 0..TN {
        if (col0 + lane16 + 16 * j < n) { b_seen = b_seen | (1 << j); }
      }
    }
    var a_step: int64 = if ta == 0 { (int64)16 } else { lda * 16 };
    var b_step: int64 = if tb != 0 { (int64)16 } else { ldb * 16 };
    var a_k: int32 = if ta == 0 { lane16 } else { ty };
    var b_k: int32 = if tb != 0 { lane16 } else { ty };
    var acc: float32[64];
    comptime for i in 0..64 { acc[i] = z32(); }
    var ra: float32[8];
    var rb: float32[8];
    var av: float32[8];
    var bv: float32[8];
    comptime for i in 0..8 {
      ra[i] = z32();
      rb[i] = z32();
    }
    for step in 0..tiles + 1 {
      var loading: bool = step < tiles;
      if (loading) {
        var k0: int32 = k_begin + step * 16;
        var a_in: bool = k0 + a_k < k_end;
        var b_in: bool = k0 + b_k < k_end;
        comptime for i in 0..TM {
          ra[i] = z32();
          if (a_in && (a_seen & (1 << i)) != 0) { ra[i] = a_ptr[(int64)i * a_gap]; }
        }
        comptime for j in 0..TN {
          rb[j] = z32();
          if (b_in && (b_seen & (1 << j)) != 0) { rb[j] = b_ptr[(int64)j * b_gap]; }
        }
        a_ptr = a_ptr + a_step;
        b_ptr = b_ptr + b_step;
      }
      if (step > 0) {
        var cur: int32 = (step - 1) % 2;
        var abuf: float32 shared align(16)* = (float32 shared align(16)*)&as[cur * 16 * SA + ty * 4];
        var bbuf: float32 shared align(16)* = (float32 shared align(16)*)&bs[cur * 16 * SB + tx * 4];
        comptime for kk in 0..16 {
          comptime for i in 0..TM { av[i] = abuf[kk * SA + (i / 4) * 64 + i % 4]; }
          comptime for j in 0..TN { bv[j] = bbuf[kk * SB + (j / 4) * 64 + j % 4]; }
          comptime for i in 0..TM {
            comptime for j in 0..TN {
              acc[i * TN + j] = acc[i * TN + j] + av[i] * bv[j];
            }
          }
        }
      }
      if (loading) {
        var nb: int32 = step % 2;
        var a_spot: int32 = if ta == 0 { nb * 16 * SA + lane16 * SA + ty } else { nb * 16 * SA + ty * SA + lane16 };
        var b_spot: int32 = if tb != 0 { nb * 16 * SB + lane16 * SB + ty } else { nb * 16 * SB + ty * SB + lane16 };
        comptime for i in 0..TM { as[a_spot + 16 * i] = ra[i]; }
        comptime for j in 0..TN { bs[b_spot + 16 * j] = rb[j]; }
      }
      barrier(workgroup, acq_rel);
    }
    var alpha: float32 = g.alpha;
    var accumulate: int32 = g.accumulate;
    var bias: float32* = g.bias;
    var has_bias: bool = bias != (float32*)0;
    comptime for i in 0..TM {
      var r: int32 = row0 + (i / 4) * 64 + ty * 4 + (i % 4);
      if (r < m) {
        var crow: float32* = c + (int64)r * ldc;
        comptime for j in 0..TN {
          var q: int32 = col0 + (j / 4) * 64 + tx * 4 + (j % 4);
          if (q < n) {
            var v: float32 = acc[i * TN + j] * alpha;
            if (has_bias) { v = v + bias[q]; }
            if (accumulate != 0) { v = v + crow[q]; }
            crow[q] = v;
          }
        }
      }
    }
  }
}

kernel(block = 256) k_gemm_gather(dst: float32*, ws: float32*, m: int32, n: int32, ldc: int64, splits: int32, sp: int64, accumulate: int32) {
  var id: int64 = (int64)block.x * 256 + (int64)thread.x;
  var step: int64 = (int64)grid_dim.x * 256;
  var total: int64 = (int64)m * (int64)n;
  while (id < total) {
    var r: int64 = id / (int64)n;
    var q: int64 = id - r * (int64)n;
    var acc: float32 = z32();
    for s in 0..splits { acc = acc + ws[(int64)s * sp + id]; }
    var at: int64 = r * ldc + q;
    if (accumulate != 0) { acc = acc + dst[at]; }
    dst[at] = acc;
    id = id + step;
  }
}

struct TcForm {
  name: string;
  ta: int32;
  tb: int32;
  acc: int32;
  bm: int32;
  threads: int32;
}

const TC_FORMS: TcForm[14] = [
  { name: "nt", ta: 0, tb: 1, acc: 0, bm: 128, threads: 256 },
  { name: "nn", ta: 0, tb: 0, acc: 0, bm: 128, threads: 256 },
  { name: "tn", ta: 1, tb: 0, acc: 0, bm: 128, threads: 256 },
  { name: "nt_acc", ta: 0, tb: 1, acc: 1, bm: 128, threads: 256 },
  { name: "nn_acc", ta: 0, tb: 0, acc: 1, bm: 128, threads: 256 },
  { name: "tn_acc", ta: 1, tb: 0, acc: 1, bm: 128, threads: 256 },
  { name: "nt_bias", ta: 0, tb: 1, acc: 2, bm: 128, threads: 256 },
  { name: "nt_64", ta: 0, tb: 1, acc: 0, bm: 64, threads: 128 },
  { name: "nn_64", ta: 0, tb: 0, acc: 0, bm: 64, threads: 128 },
  { name: "tn_64", ta: 1, tb: 0, acc: 0, bm: 64, threads: 128 },
  { name: "nt_acc_64", ta: 0, tb: 1, acc: 1, bm: 64, threads: 128 },
  { name: "nn_acc_64", ta: 0, tb: 0, acc: 1, bm: 64, threads: 128 },
  { name: "tn_acc_64", ta: 1, tb: 0, acc: 1, bm: 64, threads: 128 },
  { name: "nt_bias_64", ta: 0, tb: 1, acc: 2, bm: 64, threads: 128 }
];

comptime for form in TC_FORMS.rows {
  kernel(block = form.threads) ident("k_tc_", form.name)(pa: float32 global align(16)*, pb: float32 global align(16)*, pc: float32 global*, k: int32, lda4: int32, ldb4: int32, ldc: int32, sa4: int64, sb4: int64, sc: int64, splits: int32, chunk: int32, sp: int64, alpha: float32, bias: float32 global*, ldz: int32) {
    const TA: int32 = form.ta;
    const TB: int32 = form.tb;
    const BM: int32 = form.bm;
    const WM: int32 = form.bm / 2;
    const WN: int32 = form.bm / 32;
    const BUF: int32 = form.bm * 40;
    const SH: int32 = form.bm * 80;
    const LR: int32 = form.bm + 8;
    const RUN: int32 = form.bm / 4;
    const PASS: int32 = form.threads / 8;
    workgroup var as: uint16[SH];
    workgroup var bs: uint16[SH];
    var t: int32 = thread.x;
    var warp: int32 = thread.x >> 5;
    var wm: int32 = warp / WN;
    var wn: int32 = warp % WN;
    var row0: int32 = block.y * BM;
    var col0: int32 = block.x * BM;
    var split: int32 = block.z % splits;
    var bz: int64 = (int64)(block.z / splits);
    var k0: int32 = split * chunk;
    var k1: int32 = k0 + chunk;
    if (k1 > k) { k1 = k; }
    var tiles: int32 = (k1 - k0) / 32;
    var lda: int64 = (int64)lda4;
    var ldb: int64 = (int64)ldb4;
    var a_major: int32 = if TA == 0 { t / 8 } else { t / RUN };
    var a_minor: int32 = if TA == 0 { t % 8 } else { t % RUN };
    var b_major: int32 = if TB != 0 { t / 8 } else { t / RUN };
    var b_minor: int32 = if TB != 0 { t % 8 } else { t % RUN };
    var a_src: int64 = bz * sa4;
    var b_src: int64 = bz * sb4;
    var a_jump: int64 = 0;
    var b_jump: int64 = 0;
    var a_next: int64 = 0;
    var b_next: int64 = 0;
    if (TA == 0) {
      a_src = a_src + (int64)(row0 + a_major) * lda + (int64)(k0 / 4 + a_minor);
      a_jump = lda * (int64)PASS;
      a_next = 8;
    } else {
      a_src = a_src + (int64)(k0 + a_major) * lda + (int64)(row0 / 4 + a_minor);
      a_jump = lda * 8;
      a_next = lda * 32;
    }
    if (TB != 0) {
      b_src = b_src + (int64)(col0 + b_major) * ldb + (int64)(k0 / 4 + b_minor);
      b_jump = ldb * (int64)PASS;
      b_next = 8;
    } else {
      b_src = b_src + (int64)(k0 + b_major) * ldb + (int64)(col0 / 4 + b_minor);
      b_jump = ldb * 8;
      b_next = ldb * 32;
    }
    var a_spot: int32 = if TA == 0 { a_major * 40 + a_minor * 4 } else { a_minor * 160 + a_major };
    var a_gap: int32 = if TA == 0 { PASS * 40 } else { 8 };
    var a_lane: int32 = if TA == 0 { 1 } else { 40 };
    var b_spot: int32 = if TB != 0 { b_major * 40 + b_minor * 4 } else { b_major * LR + b_minor * 4 };
    var b_gap: int32 = if TB != 0 { PASS * 40 } else { 8 * LR };
    var ra: float32[16];
    var rb: float32[16];
    var dst: float32 global* = pc + bz * sc + (int64)split * sp + (int64)(row0 + wm * WM) * (int64)ldc + (int64)(col0 + wn * 32);
    var a_off: int32 = wm * WM * 40;
    var b_off: int32 = if TB != 0 { wn * 1280 } else { wn * 32 };
    comptime for j in 0..4 {
      var ap: float32 global align(16)* = (float32 global align(16)*)&pa[(a_src + (int64)j * a_jump) * 4];
      var bp: float32 global align(16)* = (float32 global align(16)*)&pb[(b_src + (int64)j * b_jump) * 4];
      comptime for q in 0..4 {
        ra[4 * j + q] = ap[q];
        rb[4 * j + q] = bp[q];
      }
    }
    comptime for j in 0..4 {
      comptime for q in 0..4 {
        as[a_spot + j * a_gap + q * a_lane] = (uint16)f2bf(ra[4 * j + q] * alpha);
        bs[b_spot + j * b_gap + q] = (uint16)f2bf(rb[4 * j + q]);
      }
    }
    barrier(workgroup, acq_rel);
    a_src = a_src + a_next;
    b_src = b_src + b_next;
    if (form.acc == 0) {
      if (TB != 0) {
        tensor_mma(&as[a_off], &bs[b_off], 0.0, dst, m: WM, n: 32, k: 32, a_type: bf16, b_type: bf16,
                   accumulator_type: f32, result_type: f32, a_layout: row, b_layout: col, d_layout: row, lda: 40, ldb: 40, ldd: ldc);
      } else {
        tensor_mma(&as[a_off], &bs[b_off], 0.0, dst, m: WM, n: 32, k: 32, a_type: bf16, b_type: bf16,
                   accumulator_type: f32, result_type: f32, a_layout: row, b_layout: row, d_layout: row, lda: 40, ldb: LR, ldd: ldc);
      }
    } else if (form.acc == 2) {
      tensor_mma(&as[a_off], &bs[b_off], bias + (int64)(col0 + wn * 32), dst, m: WM, n: 32, k: 32, a_type: bf16, b_type: bf16,
                 accumulator_type: f32, result_type: f32, a_layout: row, b_layout: col, c_layout: row, d_layout: row, lda: 40, ldb: 40, ldc: ldz, ldd: ldc);
    } else {
      if (TB != 0) {
        tensor_mma(&as[a_off], &bs[b_off], dst, dst, m: WM, n: 32, k: 32, a_type: bf16, b_type: bf16,
                   accumulator_type: f32, result_type: f32, a_layout: row, b_layout: col, c_layout: row, d_layout: row, lda: 40, ldb: 40, ldc: ldc, ldd: ldc);
      } else {
        tensor_mma(&as[a_off], &bs[b_off], dst, dst, m: WM, n: 32, k: 32, a_type: bf16, b_type: bf16,
                   accumulator_type: f32, result_type: f32, a_layout: row, b_layout: row, c_layout: row, d_layout: row, lda: 40, ldb: LR, ldc: ldc, ldd: ldc);
      }
    }
    for step in 1..tiles {
      comptime for j in 0..4 {
        var ap: float32 global align(16)* = (float32 global align(16)*)&pa[(a_src + (int64)j * a_jump) * 4];
        var bp: float32 global align(16)* = (float32 global align(16)*)&pb[(b_src + (int64)j * b_jump) * 4];
        comptime for q in 0..4 {
          ra[4 * j + q] = ap[q];
          rb[4 * j + q] = bp[q];
        }
      }
      a_src = a_src + a_next;
      b_src = b_src + b_next;
      var nb: int32 = (step % 2) * BUF;
      comptime for j in 0..4 {
        comptime for q in 0..4 {
          as[nb + a_spot + j * a_gap + q * a_lane] = (uint16)f2bf(ra[4 * j + q] * alpha);
          bs[nb + b_spot + j * b_gap + q] = (uint16)f2bf(rb[4 * j + q]);
        }
      }
      barrier(workgroup, acq_rel);
      if (TB != 0) {
        tensor_mma(&as[nb + a_off], &bs[nb + b_off], dst, dst, m: WM, n: 32, k: 32, a_type: bf16, b_type: bf16,
                   accumulator_type: f32, result_type: f32, a_layout: row, b_layout: col, c_layout: row, d_layout: row, lda: 40, ldb: 40, ldc: ldc, ldd: ldc);
      } else {
        tensor_mma(&as[nb + a_off], &bs[nb + b_off], dst, dst, m: WM, n: 32, k: 32, a_type: bf16, b_type: bf16,
                   accumulator_type: f32, result_type: f32, a_layout: row, b_layout: row, c_layout: row, d_layout: row, lda: 40, ldb: LR, ldc: ldc, ldd: ldc);
      }
    }
  }
}

kernel(block = 256) k_muon_mix(g: float32*, m: float32*, u: float32*, n: int64, beta: float32, factor: float32*) {
  var f: float32 = if factor != (float32*)0 { factor[0] } else { one32() };
  var i: int64 = (int64)block.x * 256 + (int64)thread.x;
  var step: int64 = (int64)grid_dim.x * 256;
  while (i < n) {
    var gi: float32 = g[i] * f;
    var mi: float32 = beta * m[i] + (one32() - beta) * gi;
    m[i] = mi;
    u[i] = gi + beta * (mi - gi);
    i = i + step;
  }
}

kernel(block = 256) k_muon_apply(w: float32*, u: float32*, n: int64, lr: float32, shrink: float32) {
  var i: int64 = (int64)block.x * 256 + (int64)thread.x;
  var step: int64 = (int64)grid_dim.x * 256;
  while (i < n) {
    w[i] = w[i] * shrink - lr * u[i];
    i = i + step;
  }
}

kernel(block = 256) k_scaled(dst: float32*, src: float32*, alpha: float32, n: int64) {
  var i: int64 = (int64)block.x * 256 + (int64)thread.x;
  var step: int64 = (int64)grid_dim.x * 256;
  while (i < n) {
    dst[i] = alpha * src[i];
    i = i + step;
  }
}

kernel(block = 256) k_poly(dst: float32*, src: float32*, alpha: float32, diag: float32, side: int64, total: int64) {
  var i: int64 = (int64)block.x * 256 + (int64)thread.x;
  var step: int64 = (int64)grid_dim.x * 256;
  var square: int64 = side * side;
  while (i < total) {
    var at: int64 = i % square;
    var r: int64 = at / side;
    var v: float32 = alpha * src[i];
    if (r * side + r == at) { v = v + diag; }
    dst[i] = v;
    i = i + step;
  }
}

kernel(block = 256) k_diag(dst: float32*, value: float32, side: int64, count: int64) {
  var i: int64 = (int64)block.x * 256 + (int64)thread.x;
  if (i >= side * count) { return; }
  var z: int64 = i / side;
  var d: int64 = i - z * side;
  var at: int64 = z * side * side + d * side + d;
  dst[at] = dst[at] + value;
}

kernel(block = 256) k_frob_partials(x: float32*, size: int64, parts: int32, partial: float32*) {
  workgroup var lanes: float32[256];
  var t: int32 = thread.x;
  var z: int64 = (int64)block.y;
  var chunk: int64 = (size + (int64)parts - 1) / (int64)parts;
  var lo: int64 = (int64)block.x * chunk;
  var hi: int64 = lo + chunk;
  if (hi > size) { hi = size; }
  var base: float32* = x + z * size;
  var acc: float32 = z32();
  var i: int64 = lo + (int64)t;
  while (i < hi) {
    acc = acc + base[i] * base[i];
    i = i + 256;
  }
  lanes[t] = acc;
  barrier(workgroup, acq_rel);
  var width: int32 = 128;
  while (width > 0) {
    if (t < width) { lanes[t] = lanes[t] + lanes[t + width]; }
    barrier(workgroup, acq_rel);
    width = width / 2;
  }
  if (t == 0) { partial[z * (int64)parts + (int64)block.x] = lanes[0]; }
}

kernel(block = 256) k_frob_scale(x: float32*, size: int64, parts: int32, partial: float32*) {
  var z: int64 = (int64)block.y;
  var total: float32 = z32();
  for p in 0..parts { total = total + partial[z * (int64)parts + (int64)p]; }
  var inv: float32 = one32() / (sqrtf(total) + (float32)1.0e-7);
  var chunk: int64 = (size + (int64)parts - 1) / (int64)parts;
  var lo: int64 = (int64)block.x * chunk;
  var hi: int64 = lo + chunk;
  if (hi > size) { hi = size; }
  var base: float32* = x + z * size;
  var i: int64 = lo + (int64)thread.x;
  while (i < hi) {
    base[i] = base[i] * inv;
    i = i + 256;
  }
}

kernel(block = 256) k_normalize(x: float32*, size: int64) {
  workgroup var lanes: float32[256];
  var t: int32 = thread.x;
  var base: float32* = x + (int64)block.x * size;
  var acc: float32 = z32();
  var i: int64 = (int64)t;
  while (i < size) {
    acc = acc + base[i] * base[i];
    i = i + 256;
  }
  lanes[t] = acc;
  barrier(workgroup, acq_rel);
  var width: int32 = 128;
  while (width > 0) {
    if (t < width) { lanes[t] = lanes[t] + lanes[t + width]; }
    barrier(workgroup, acq_rel);
    width = width / 2;
  }
  var inv: float32 = one32() / (sqrtf(lanes[0]) + (float32)1.0e-7);
  i = (int64)t;
  while (i < size) {
    base[i] = base[i] * inv;
    i = i + 256;
  }
}

kernel(block = 256) k_rope(y: float32*, x: float32*, rstd: float32*, table: float32*, rows: int64, time: int64, width: int32, heads: int32) {
  var w: int64 = (int64)block.x * 8 + (int64)(thread.x / 32);
  var lane: int32 = (int32)subgroup_local_id();
  var segs: int64 = (int64)(3 * heads);
  if (w >= rows * segs) { return; }
  var r: int64 = w / segs;
  var seg: int32 = (int32)(w - r * segs);
  var hd: int32 = width / heads;
  var half: int32 = hd / 2;
  var at: int64 = r * (int64)(3 * width) + (int64)(seg * hd);
  if (seg >= 2 * heads) {
    var c: int32 = lane;
    while (c < hd) {
      y[at + (int64)c] = x[at + (int64)c];
      c = c + 32;
    }
    return;
  }
  var sq: float32 = z32();
  var i: int32 = lane;
  while (i < half) {
    var a: float32 = x[at + (int64)(2 * i)];
    var b: float32 = x[at + (int64)(2 * i + 1)];
    sq = sq + a * a + b * b;
    i = i + 32;
  }
  var rs: float32 = rsqrtf(subgroup_reduce_add(sq) / (float32)hd + (float32)1.1920929e-7);
  if (lane == 0) { rstd[r * (int64)(2 * heads) + (int64)seg] = rs; }
  var tab: float32* = table + (r % time) * (int64)hd;
  i = lane;
  while (i < half) {
    var co: float32 = tab[2 * i];
    var si: float32 = tab[2 * i + 1];
    var a: float32 = x[at + (int64)(2 * i)] * rs;
    var b: float32 = x[at + (int64)(2 * i + 1)] * rs;
    y[at + (int64)(2 * i)] = a * co - b * si;
    y[at + (int64)(2 * i + 1)] = a * si + b * co;
    i = i + 32;
  }
}

kernel(block = 256) k_rope_back(dx: float32*, dy: float32*, x: float32*, rstd: float32*, table: float32*, rows: int64, time: int64, width: int32, heads: int32, fresh: int32) {
  var w: int64 = (int64)block.x * 8 + (int64)(thread.x / 32);
  var lane: int32 = (int32)subgroup_local_id();
  var segs: int64 = (int64)(3 * heads);
  if (w >= rows * segs) { return; }
  var r: int64 = w / segs;
  var seg: int32 = (int32)(w - r * segs);
  var hd: int32 = width / heads;
  var half: int32 = hd / 2;
  var at: int64 = r * (int64)(3 * width) + (int64)(seg * hd);
  if (seg >= 2 * heads) {
    var c: int32 = lane;
    while (c < hd) {
      dx[at + (int64)c] = (if fresh != 0 { z32() } else { dx[at + (int64)c] }) + dy[at + (int64)c];
      c = c + 32;
    }
    return;
  }
  var rs: float32 = rstd[r * (int64)(2 * heads) + (int64)seg];
  var tab: float32* = table + (r % time) * (int64)hd;
  var dot: float32 = z32();
  var i: int32 = lane;
  while (i < half) {
    var co: float32 = tab[2 * i];
    var si: float32 = tab[2 * i + 1];
    var d0: float32 = dy[at + (int64)(2 * i)];
    var d1: float32 = dy[at + (int64)(2 * i + 1)];
    var g0: float32 = d0 * co + d1 * si;
    var g1: float32 = d1 * co - d0 * si;
    dot = dot + g0 * x[at + (int64)(2 * i)] * rs + g1 * x[at + (int64)(2 * i + 1)] * rs;
    i = i + 32;
  }
  var mean: float32 = subgroup_reduce_add(dot) / (float32)hd;
  i = lane;
  while (i < half) {
    var co: float32 = tab[2 * i];
    var si: float32 = tab[2 * i + 1];
    var d0: float32 = dy[at + (int64)(2 * i)];
    var d1: float32 = dy[at + (int64)(2 * i + 1)];
    var g0: float32 = d0 * co + d1 * si;
    var g1: float32 = d1 * co - d0 * si;
    var o0: int64 = at + (int64)(2 * i);
    if (fresh != 0) {
      dx[o0] = rs * (g0 - x[o0] * rs * mean);
      dx[o0 + 1] = rs * (g1 - x[o0 + 1] * rs * mean);
    } else {
      dx[o0] = dx[o0] + rs * (g0 - x[o0] * rs * mean);
      dx[o0 + 1] = dx[o0 + 1] + rs * (g1 - x[o0 + 1] * rs * mean);
    }
    i = i + 32;
  }
}

kernel(block = 256) k_bias_rows(dst: float32*, bias: float32*, rows: int32, cols: int32, ldc: int64) {
  var id: int64 = (int64)block.x * 256 + (int64)thread.x;
  var step: int64 = (int64)grid_dim.x * 256;
  var total: int64 = (int64)rows * (int64)cols;
  while (id < total) {
    var r: int64 = id / (int64)cols;
    var q: int64 = id - r * (int64)cols;
    dst[r * ldc + q] = bias[q];
    id = id + step;
  }
}

comptime for h in HEAD_SHAPES.rows {
  kernel(block = 128) ident("k_flash_fwd_", h.name)(f: Flash) {
    const HD: int32 = h.dim;
    const P: int32 = h.parts;
    const ROWS: int32 = 128 / h.parts;
    const KT: int32 = 4096 / h.dim;
    workgroup var ks: float32[4096];
    workgroup var vs: float32[4096];
    var t: int32 = thread.x;
    var lane: int32 = (int32)subgroup_local_id();
    var part: int32 = t % P;
    var time: int32 = (int32)workgroup_uniform((uint32)f.time);
    var causal: int32 = (int32)workgroup_uniform((uint32)f.causal);
    var dropping: int32 = (int32)workgroup_uniform((uint32)f.dropping);
    var width: int32 = f.width;
    var heads: int32 = f.heads;
    var bh: int32 = block.y;
    var b: int32 = bh / heads;
    var hh: int32 = bh - b * heads;
    var q0: int32 = block.x * ROWS;
    var row: int32 = q0 + t / P;
    var live: bool = row < time;
    var stride: int64 = (int64)(3 * width);
    var head: float32* = f.qkv + (int64)b * (int64)time * stride + (int64)(hh * HD);
    var scale: float32 = f.scale;
    var key: uint64 = f.key;
    var threshold: uint64 = f.threshold;
    var keep: float32 = f.keep;
    var q: float32[32];
    var o: float32[32];
    comptime for e in 0..32 {
      q[e] = z32();
      o[e] = z32();
    }
    if (live) {
      var qrow: float32* = head + (int64)row * stride + (int64)(part * 32);
      comptime for e in 0..32 { q[e] = qrow[e] * scale; }
    }
    var m: float32 = -3.0e38;
    var l: float32 = z32();
    var kend: int32 = time;
    if (causal != 0) {
      kend = q0 + ROWS;
      if (kend > time) { kend = time; }
    }
    var tiles: int32 = (kend + KT - 1) / KT;
    var drop_base: int64 = ((int64)bh * (int64)time + (int64)row) * (int64)time;
    for tile in 0..tiles {
      var j0: int32 = tile * KT;
      comptime for i in 0..32 {
        var idx: int32 = t + 128 * i;
        var kr: int32 = idx / HD;
        var d: int32 = idx - kr * HD;
        var kv: float32 = z32();
        var vv: float32 = z32();
        if (j0 + kr < time) {
          var src: float32* = head + (int64)(j0 + kr) * stride + (int64)d;
          kv = src[width];
          vv = src[2 * width];
        }
        ks[idx] = kv;
        vs[idx] = vv;
      }
      barrier(workgroup, acq_rel);
      for g8 in 0..KT / 8 {
        var kgroup: float32 shared align(16)* = (float32 shared align(16)*)&ks[g8 * 8 * HD + part * 32];
        var vgroup: float32 shared align(16)* = (float32 shared align(16)*)&vs[g8 * 8 * HD + part * 32];
        var s: float32[8];
        var gmax: float32 = -3.0e38;
        comptime for u in 0..8 {
          var jj: int32 = g8 * 8 + u;
          var acc: float32 = z32();
          comptime for e in 0..32 { acc = acc + q[e] * kgroup[u * HD + e]; }
          if (P > 1) { acc = acc + subgroup_shuffle(acc, (uint32)(lane ^ 1)); }
          if (P > 2) { acc = acc + subgroup_shuffle(acc, (uint32)(lane ^ 2)); }
          var j: int32 = j0 + jj;
          var seen: bool = j < time && (causal == 0 || j <= row);
          s[u] = if seen { acc } else { (float32)-3.0e38 };
          if (s[u] > gmax) { gmax = s[u]; }
        }
        if (gmax > m) {
          var corr: float32 = expf(m - gmax);
          l = l * corr;
          comptime for e in 0..32 { o[e] = o[e] * corr; }
          m = gmax;
        }
        comptime for u in 0..8 {
          var jj: int32 = g8 * 8 + u;
          var pv: float32 = z32();
          if (s[u] > (float32)-1.0e38) { pv = expf(s[u] - m); }
          l = l + pv;
          if (dropping != 0) {
            if (drop_bits(key, drop_base + (int64)(j0 + jj)) >= threshold) { pv = pv * keep; } else { pv = z32(); }
          }
          comptime for e in 0..32 { o[e] = o[e] + pv * vgroup[u * HD + e]; }
        }
      }
      barrier(workgroup, acq_rel);
    }
    if (live) {
      var inv: float32 = one32() / l;
      var orow: float32* = f.out + ((int64)b * (int64)time + (int64)row) * (int64)width + (int64)(hh * HD + part * 32);
      comptime for e in 0..32 { orow[e] = o[e] * inv; }
      if (part == 0) { f.lse[(int64)bh * (int64)time + (int64)row] = m + logf(l); }
    }
  }

  kernel(block = 128) ident("k_flash_dq_", h.name)(f: Flash) {
    const HD: int32 = h.dim;
    const P: int32 = h.parts;
    const ROWS: int32 = 128 / h.parts;
    const KT: int32 = 4096 / h.dim;
    workgroup var ks: float32[4096];
    workgroup var vs: float32[4096];
    var t: int32 = thread.x;
    var lane: int32 = (int32)subgroup_local_id();
    var part: int32 = t % P;
    var time: int32 = (int32)workgroup_uniform((uint32)f.time);
    var causal: int32 = (int32)workgroup_uniform((uint32)f.causal);
    var dropping: int32 = (int32)workgroup_uniform((uint32)f.dropping);
    var width: int32 = f.width;
    var heads: int32 = f.heads;
    var bh: int32 = block.y;
    var b: int32 = bh / heads;
    var hh: int32 = bh - b * heads;
    var q0: int32 = block.x * ROWS;
    var row: int32 = q0 + t / P;
    var live: bool = row < time;
    var stride: int64 = (int64)(3 * width);
    var head: float32* = f.qkv + (int64)b * (int64)time * stride + (int64)(hh * HD);
    var scale: float32 = f.scale;
    var key: uint64 = f.key;
    var threshold: uint64 = f.threshold;
    var keep: float32 = f.keep;
    var q: float32[32];
    var dob: float32[32];
    var dq: float32[32];
    comptime for e in 0..32 {
      q[e] = z32();
      dob[e] = z32();
      dq[e] = z32();
    }
    var lse: float32 = z32();
    var dsum: float32 = z32();
    if (live) {
      var qrow: float32* = head + (int64)row * stride + (int64)(part * 32);
      var at: int64 = ((int64)b * (int64)time + (int64)row) * (int64)width + (int64)(hh * HD + part * 32);
      var orow: float32* = f.out + at;
      var drow: float32* = f.dout + at;
      comptime for e in 0..32 {
        q[e] = qrow[e];
        dob[e] = drow[e];
        dsum = dsum + drow[e] * orow[e];
      }
      lse = f.lse[(int64)bh * (int64)time + (int64)row];
    }
    if (P > 1) { dsum = dsum + subgroup_shuffle(dsum, (uint32)(lane ^ 1)); }
    if (P > 2) { dsum = dsum + subgroup_shuffle(dsum, (uint32)(lane ^ 2)); }
    if (live && part == 0) { f.delta[(int64)bh * (int64)time + (int64)row] = dsum; }
    var kend: int32 = time;
    if (causal != 0) {
      kend = q0 + ROWS;
      if (kend > time) { kend = time; }
    }
    var tiles: int32 = (kend + KT - 1) / KT;
    var drop_base: int64 = ((int64)bh * (int64)time + (int64)row) * (int64)time;
    for tile in 0..tiles {
      var j0: int32 = tile * KT;
      comptime for i in 0..32 {
        var idx: int32 = t + 128 * i;
        var kr: int32 = idx / HD;
        var d: int32 = idx - kr * HD;
        var kv: float32 = z32();
        var vv: float32 = z32();
        if (j0 + kr < time) {
          var src: float32* = head + (int64)(j0 + kr) * stride + (int64)d;
          kv = src[width];
          vv = src[2 * width];
        }
        ks[idx] = kv;
        vs[idx] = vv;
      }
      barrier(workgroup, acq_rel);
      for jj in 0..KT {
        var krow: float32 shared align(16)* = (float32 shared align(16)*)&ks[jj * HD + part * 32];
        var vrow: float32 shared align(16)* = (float32 shared align(16)*)&vs[jj * HD + part * 32];
        var sacc: float32 = z32();
        var dacc: float32 = z32();
        comptime for e in 0..32 {
          sacc = sacc + q[e] * krow[e];
          dacc = dacc + dob[e] * vrow[e];
        }
        if (P > 1) {
          sacc = sacc + subgroup_shuffle(sacc, (uint32)(lane ^ 1));
          dacc = dacc + subgroup_shuffle(dacc, (uint32)(lane ^ 1));
        }
        if (P > 2) {
          sacc = sacc + subgroup_shuffle(sacc, (uint32)(lane ^ 2));
          dacc = dacc + subgroup_shuffle(dacc, (uint32)(lane ^ 2));
        }
        var j: int32 = j0 + jj;
        var seen: bool = j < time && (causal == 0 || j <= row);
        if (seen) {
          var pv: float32 = expf(sacc * scale - lse);
          var mk: float32 = one32();
          if (dropping != 0) {
            mk = if drop_bits(key, drop_base + (int64)j) >= threshold { keep } else { z32() };
          }
          var ds: float32 = pv * (dacc * mk - dsum);
          comptime for e in 0..32 { dq[e] = dq[e] + ds * krow[e]; }
        }
      }
      barrier(workgroup, acq_rel);
    }
    if (live) {
      var dqrow: float32* = f.dqkv + (int64)b * (int64)time * stride + (int64)row * stride + (int64)(hh * HD + part * 32);
      comptime for e in 0..32 { dqrow[e] = dqrow[e] + dq[e] * scale; }
    }
  }

  kernel(block = 128) ident("k_flash_dkv_", h.name)(f: Flash) {
    const HD: int32 = h.dim;
    const P: int32 = h.parts;
    const KEYS: int32 = 128 / h.parts;
    const QT: int32 = 4096 / h.dim;
    workgroup var qs: float32[4096];
    workgroup var dos: float32[4096];
    workgroup var ls: float32[128];
    workgroup var dl: float32[128];
    var t: int32 = thread.x;
    var lane: int32 = (int32)subgroup_local_id();
    var part: int32 = t % P;
    var time: int32 = (int32)workgroup_uniform((uint32)f.time);
    var causal: int32 = (int32)workgroup_uniform((uint32)f.causal);
    var dropping: int32 = (int32)workgroup_uniform((uint32)f.dropping);
    var width: int32 = f.width;
    var heads: int32 = f.heads;
    var bh: int32 = block.y;
    var b: int32 = bh / heads;
    var hh: int32 = bh - b * heads;
    var k0: int32 = block.x * KEYS;
    var j: int32 = k0 + t / P;
    var live: bool = j < time;
    var stride: int64 = (int64)(3 * width);
    var head: float32* = f.qkv + (int64)b * (int64)time * stride + (int64)(hh * HD);
    var dout_head: float32* = f.dout + (int64)b * (int64)time * (int64)width + (int64)(hh * HD);
    var scale: float32 = f.scale;
    var key: uint64 = f.key;
    var threshold: uint64 = f.threshold;
    var keep: float32 = f.keep;
    var kk: float32[32];
    var vv: float32[32];
    var dk: float32[32];
    var dv: float32[32];
    comptime for e in 0..32 {
      kk[e] = z32();
      vv[e] = z32();
      dk[e] = z32();
      dv[e] = z32();
    }
    if (live) {
      var krow: float32* = head + (int64)j * stride + (int64)(width + part * 32);
      comptime for e in 0..32 {
        kk[e] = krow[e];
        vv[e] = krow[width + e];
      }
    }
    var qstart: int32 = 0;
    if (causal != 0) { qstart = k0 / QT * QT; }
    var tiles: int32 = (time - qstart + QT - 1) / QT;
    var row_base: int64 = (int64)bh * (int64)time;
    for tile in 0..tiles {
      var i0: int32 = qstart + tile * QT;
      comptime for i in 0..32 {
        var idx: int32 = t + 128 * i;
        var r: int32 = idx / HD;
        var d: int32 = idx - r * HD;
        var qv: float32 = z32();
        var dv0: float32 = z32();
        if (i0 + r < time) {
          qv = head[(int64)(i0 + r) * stride + (int64)d];
          dv0 = dout_head[(int64)(i0 + r) * (int64)width + (int64)d];
        }
        qs[idx] = qv;
        dos[idx] = dv0;
      }
      if (t < QT) {
        var lv: float32 = z32();
        var dd: float32 = z32();
        if (i0 + t < time) {
          lv = f.lse[row_base + (int64)(i0 + t)];
          dd = f.delta[row_base + (int64)(i0 + t)];
        }
        ls[t] = lv;
        dl[t] = dd;
      }
      barrier(workgroup, acq_rel);
      for ii in 0..QT {
        var qrow: float32 shared align(16)* = (float32 shared align(16)*)&qs[ii * HD + part * 32];
        var dorow: float32 shared align(16)* = (float32 shared align(16)*)&dos[ii * HD + part * 32];
        var sacc: float32 = z32();
        var dacc: float32 = z32();
        comptime for e in 0..32 {
          sacc = sacc + qrow[e] * kk[e];
          dacc = dacc + dorow[e] * vv[e];
        }
        if (P > 1) {
          sacc = sacc + subgroup_shuffle(sacc, (uint32)(lane ^ 1));
          dacc = dacc + subgroup_shuffle(dacc, (uint32)(lane ^ 1));
        }
        if (P > 2) {
          sacc = sacc + subgroup_shuffle(sacc, (uint32)(lane ^ 2));
          dacc = dacc + subgroup_shuffle(dacc, (uint32)(lane ^ 2));
        }
        var i: int32 = i0 + ii;
        var seen: bool = live && i < time && (causal == 0 || j <= i);
        if (seen) {
          var pv: float32 = expf(sacc * scale - ls[ii]);
          var mk: float32 = one32();
          if (dropping != 0) {
            mk = if drop_bits(key, (row_base + (int64)i) * (int64)time + (int64)j) >= threshold { keep } else { z32() };
          }
          var pd: float32 = pv * mk;
          var ds: float32 = pv * (dacc * mk - dl[ii]);
          comptime for e in 0..32 {
            dv[e] = dv[e] + pd * dorow[e];
            dk[e] = dk[e] + ds * qrow[e];
          }
        }
      }
      barrier(workgroup, acq_rel);
    }
    if (live) {
      var drow: float32* = f.dqkv + (int64)b * (int64)time * stride + (int64)j * stride + (int64)(width + hh * HD + part * 32);
      comptime for e in 0..32 {
        drow[e] = drow[e] + dk[e] * scale;
        drow[width + e] = drow[width + e] + dv[e];
      }
    }
  }
}

const TC_HEADS: HeadShape[2] = [
  { name: "32", dim: 32, parts: 1 },
  { name: "64", dim: 64, parts: 2 }
];

comptime for h in TC_HEADS.rows {
  kernel(block = 128) ident("k_tflash_fwd_", h.name)(qkv: float32*, out: float32*, lse: float32*, time: int32, width: int32, heads: int32, causal: int32, scale: float32) {
    const HD: int32 = h.dim;
    const LD: int32 = h.dim + 8;
    const PER: int32 = h.dim / 4;
    const KV: int32 = h.dim * 32 + 256;
    workgroup var ks: uint16[KV];
    workgroup var vs: uint16[KV];
    var t: int32 = thread.x;
    var warp: int32 = thread.x >> 5;
    var bh: int32 = block.y;
    var b: int32 = bh / heads;
    var hh: int32 = bh - b * heads;
    var q0: int32 = block.x * 64;
    var wq: int32 = q0 + warp * 16;
    var stride: int64 = (int64)(3 * width);
    var head: float32* = qkv + (int64)b * (int64)time * stride + (int64)(hh * HD);
    var rows: int32 = time - wq;
    if (rows > 16) { rows = 16; }
    if (rows < 0) { rows = 0; }
    var cap: int32 = if causal != 0 { 0 } else { 1 << 30 };
    var qt: bfloat16[16, HD] layout fragment_a;
    tile_load(qt, head + (int64)wq * stride, ld: stride, rows: rows);
    var o: float32[16, HD] layout fragment_c = 0.0;
    var m: float32[16] layout fragment_c = -1.0e30;
    var l: float32[16] layout fragment_c = 0.0;
    var kend: int32 = time;
    if (causal != 0 && q0 + 64 < kend) { kend = q0 + 64; }
    var chunks: int32 = (kend + 31) / 32;
    for c in 0..chunks {
      var j0: int32 = c * 32;
      comptime for i in 0..PER {
        var idx: int32 = t + 128 * i;
        var kr: int32 = idx / HD;
        var d: int32 = idx - kr * HD;
        var kv: float32 = z32();
        var vv: float32 = z32();
        if (j0 + kr < time) {
          var src: float32* = head + (int64)(j0 + kr) * stride + (int64)d;
          kv = src[width];
          vv = src[2 * width];
        }
        ks[kr * LD + d] = (uint16)f2bf(kv);
        vs[kr * LD + d] = (uint16)f2bf(vv);
      }
      barrier(workgroup, acq_rel);
      var s: float32[16, 32] layout fragment_c;
      tensor_mma(qt, &ks[0], 0.0, s, m: 16, n: 32, k: HD, a_type: bf16, b_type: bf16,
                 accumulator_type: f32, result_type: f32, b_layout: col, ldb: LD);
      s = s * scale;
      var seen: bool[16, 32] layout fragment_c = tile_col(s) + j0 < time && tile_col(s) + j0 <= tile_row(s) + wq + cap;
      var mx: float32[16] layout fragment_c = row_max(select(seen, s, -1.0e30));
      var mn: float32[16] layout fragment_c = max(m, mx);
      var alpha: float32[16] layout fragment_c = expf(m - mn);
      var p: float32[16, 32] layout fragment_c = select(seen, expf(s - mn), 0.0);
      l = l * alpha + row_sum(p);
      m = mn;
      var pa: bfloat16[16, 32] layout fragment_a = (bfloat16[16, 32] layout fragment_a)p;
      tensor_mma(pa, &vs[0], o, o, m: 16, n: HD, k: 32, a_type: bf16, b_type: bf16,
                 accumulator_type: f32, result_type: f32, b_layout: row, ldb: LD,
                 c_scale_mode: per_row, c_scale: alpha);
      barrier(workgroup, acq_rel);
    }
    o = o / l;
    tile_store(out + ((int64)b * (int64)time + (int64)wq) * (int64)width + (int64)(hh * HD), o, ld: width, rows: rows);
    var ls: float32[16] layout fragment_c = m + logf(l);
    tile_store(lse + (int64)bh * (int64)time + (int64)wq, ls, ld: 1, rows: rows);
  }

  kernel(block = 128) ident("k_tflash_dq_", h.name)(qkv: float32*, out: float32*, lse: float32*, dout: float32*, dqkv: float32*, delta: float32*, time: int32, width: int32, heads: int32, causal: int32, scale: float32, fresh: int32) {
    const HD: int32 = h.dim;
    const LD: int32 = h.dim + 8;
    const PER: int32 = h.dim / 4;
    const KV: int32 = h.dim * 32 + 256;
    workgroup var ks: uint16[KV];
    workgroup var vs: uint16[KV];
    var t: int32 = thread.x;
    var warp: int32 = thread.x >> 5;
    var bh: int32 = block.y;
    var b: int32 = bh / heads;
    var hh: int32 = bh - b * heads;
    var q0: int32 = block.x * 64;
    var wq: int32 = q0 + warp * 16;
    var stride: int64 = (int64)(3 * width);
    var head: float32* = qkv + (int64)b * (int64)time * stride + (int64)(hh * HD);
    var orow: int64 = ((int64)b * (int64)time + (int64)wq) * (int64)width + (int64)(hh * HD);
    var rows: int32 = time - wq;
    if (rows > 16) { rows = 16; }
    if (rows < 0) { rows = 0; }
    var cap: int32 = if causal != 0 { 0 } else { 1 << 30 };
    var qt: bfloat16[16, HD] layout fragment_a;
    tile_load(qt, head + (int64)wq * stride, ld: stride, rows: rows);
    var dot: bfloat16[16, HD] layout fragment_a;
    tile_load(dot, dout + orow, ld: width, rows: rows);
    var oc: float32[16, HD] layout fragment_c;
    tile_load(oc, out + orow, ld: width, rows: rows);
    var dc: float32[16, HD] layout fragment_c;
    tile_load(dc, dout + orow, ld: width, rows: rows);
    var dsum: float32[16] layout fragment_c = row_sum(oc * dc);
    tile_store(delta + (int64)bh * (int64)time + (int64)wq, dsum, ld: 1, rows: rows);
    var lr: float32[16] layout fragment_c;
    tile_load(lr, lse + (int64)bh * (int64)time + (int64)wq, ld: 1, rows: rows);
    var dq: float32[16, HD] layout fragment_c = 0.0;
    var kend: int32 = time;
    if (causal != 0 && q0 + 64 < kend) { kend = q0 + 64; }
    var chunks: int32 = (kend + 31) / 32;
    for c in 0..chunks {
      var j0: int32 = c * 32;
      comptime for i in 0..PER {
        var idx: int32 = t + 128 * i;
        var kr: int32 = idx / HD;
        var d: int32 = idx - kr * HD;
        var kv: float32 = z32();
        var vv: float32 = z32();
        if (j0 + kr < time) {
          var src: float32* = head + (int64)(j0 + kr) * stride + (int64)d;
          kv = src[width];
          vv = src[2 * width];
        }
        ks[kr * LD + d] = (uint16)f2bf(kv);
        vs[kr * LD + d] = (uint16)f2bf(vv);
      }
      barrier(workgroup, acq_rel);
      var s: float32[16, 32] layout fragment_c;
      tensor_mma(qt, &ks[0], 0.0, s, m: 16, n: 32, k: HD, a_type: bf16, b_type: bf16,
                 accumulator_type: f32, result_type: f32, b_layout: col, ldb: LD);
      var seen: bool[16, 32] layout fragment_c = tile_col(s) + j0 < time && tile_col(s) + j0 <= tile_row(s) + wq + cap;
      var p: float32[16, 32] layout fragment_c = select(seen, expf(s * scale - lr), 0.0);
      var dp: float32[16, 32] layout fragment_c;
      tensor_mma(dot, &vs[0], 0.0, dp, m: 16, n: 32, k: HD, a_type: bf16, b_type: bf16,
                 accumulator_type: f32, result_type: f32, b_layout: col, ldb: LD);
      var ds: float32[16, 32] layout fragment_c = p * (dp - dsum);
      var dsa: bfloat16[16, 32] layout fragment_a = (bfloat16[16, 32] layout fragment_a)ds;
      tensor_mma(dsa, &ks[0], dq, dq, m: 16, n: HD, k: 32, a_type: bf16, b_type: bf16,
                 accumulator_type: f32, result_type: f32, b_layout: row, ldb: LD);
      barrier(workgroup, acq_rel);
    }
    var dst: float32* = dqkv + (int64)b * (int64)time * stride + (int64)wq * stride + (int64)(hh * HD);
    dq = dq * scale;
    if (fresh == 0) {
      var prev: float32[16, HD] layout fragment_c;
      tile_load(prev, dst, ld: stride, rows: rows);
      dq = dq + prev;
    }
    tile_store(dst, dq, ld: stride, rows: rows);
  }

  kernel(block = 128) ident("k_tflash_dkv_", h.name)(qkv: float32*, lse: float32*, dout: float32*, dqkv: float32*, delta: float32*, time: int32, width: int32, heads: int32, causal: int32, scale: float32, fresh: int32) {
    const HD: int32 = h.dim;
    const LD: int32 = h.dim + 8;
    const PER: int32 = h.dim / 4;
    const KV: int32 = h.dim * 32 + 256;
    workgroup var qs: uint16[KV];
    workgroup var dos: uint16[KV];
    workgroup var ls: float32[32];
    workgroup var dl: float32[32];
    var t: int32 = thread.x;
    var warp: int32 = thread.x >> 5;
    var bh: int32 = block.y;
    var b: int32 = bh / heads;
    var hh: int32 = bh - b * heads;
    var k0: int32 = block.x * 64;
    var wk: int32 = k0 + warp * 16;
    var stride: int64 = (int64)(3 * width);
    var head: float32* = qkv + (int64)b * (int64)time * stride + (int64)(hh * HD);
    var dhead: float32* = dout + (int64)b * (int64)time * (int64)width + (int64)(hh * HD);
    var rows: int32 = time - wk;
    if (rows > 16) { rows = 16; }
    if (rows < 0) { rows = 0; }
    var cap: int32 = if causal != 0 { 0 } else { 1 << 30 };
    var kt: bfloat16[16, HD] layout fragment_a;
    tile_load(kt, head + (int64)wk * stride + (int64)width, ld: stride, rows: rows);
    var vt: bfloat16[16, HD] layout fragment_a;
    tile_load(vt, head + (int64)wk * stride + (int64)(2 * width), ld: stride, rows: rows);
    var dk: float32[16, HD] layout fragment_c = 0.0;
    var dv: float32[16, HD] layout fragment_c = 0.0;
    var qstart: int32 = 0;
    if (causal != 0) { qstart = k0 / 32 * 32; }
    var chunks: int32 = (time - qstart + 31) / 32;
    var row_base: int64 = (int64)bh * (int64)time;
    for c in 0..chunks {
      var i0: int32 = qstart + c * 32;
      comptime for i in 0..PER {
        var idx: int32 = t + 128 * i;
        var qr: int32 = idx / HD;
        var d: int32 = idx - qr * HD;
        var qv: float32 = z32();
        var dv0: float32 = z32();
        if (i0 + qr < time) {
          qv = head[(int64)(i0 + qr) * stride + (int64)d];
          dv0 = dhead[(int64)(i0 + qr) * (int64)width + (int64)d];
        }
        qs[qr * LD + d] = (uint16)f2bf(qv);
        dos[qr * LD + d] = (uint16)f2bf(dv0);
      }
      if (t < 32) {
        var lv: float32 = z32();
        var dd: float32 = z32();
        if (i0 + t < time) {
          lv = lse[row_base + (int64)(i0 + t)];
          dd = delta[row_base + (int64)(i0 + t)];
        }
        ls[t] = lv;
        dl[t] = dd;
      }
      barrier(workgroup, acq_rel);
      var st: float32[16, 32] layout fragment_c;
      tensor_mma(kt, &qs[0], 0.0, st, m: 16, n: 32, k: HD, a_type: bf16, b_type: bf16,
                 accumulator_type: f32, result_type: f32, b_layout: col, ldb: LD);
      var lt: float32[16, 32] layout fragment_c;
      tile_load(lt, &ls[0], ld: 0, rows: 16);
      var seen: bool[16, 32] layout fragment_c = tile_col(st) + i0 < time && tile_row(st) + wk <= tile_col(st) + i0 + cap;
      var pt: float32[16, 32] layout fragment_c = select(seen, expf(st * scale - lt), 0.0);
      var pta: bfloat16[16, 32] layout fragment_a = (bfloat16[16, 32] layout fragment_a)pt;
      tensor_mma(pta, &dos[0], dv, dv, m: 16, n: HD, k: 32, a_type: bf16, b_type: bf16,
                 accumulator_type: f32, result_type: f32, b_layout: row, ldb: LD);
      var dpt: float32[16, 32] layout fragment_c;
      tensor_mma(vt, &dos[0], 0.0, dpt, m: 16, n: 32, k: HD, a_type: bf16, b_type: bf16,
                 accumulator_type: f32, result_type: f32, b_layout: col, ldb: LD);
      var dt: float32[16, 32] layout fragment_c;
      tile_load(dt, &dl[0], ld: 0, rows: 16);
      var dst: float32[16, 32] layout fragment_c = pt * (dpt - dt);
      var dsa: bfloat16[16, 32] layout fragment_a = (bfloat16[16, 32] layout fragment_a)dst;
      tensor_mma(dsa, &qs[0], dk, dk, m: 16, n: HD, k: 32, a_type: bf16, b_type: bf16,
                 accumulator_type: f32, result_type: f32, b_layout: row, ldb: LD);
      barrier(workgroup, acq_rel);
    }
    var kdst: float32* = dqkv + (int64)b * (int64)time * stride + (int64)wk * stride + (int64)(width + hh * HD);
    dk = dk * scale;
    if (fresh == 0) {
      var prevk: float32[16, HD] layout fragment_c;
      tile_load(prevk, kdst, ld: stride, rows: rows);
      dk = dk + prevk;
      var prevv: float32[16, HD] layout fragment_c;
      tile_load(prevv, kdst + (int64)width, ld: stride, rows: rows);
      dv = dv + prevv;
    }
    tile_store(kdst, dk, ld: stride, rows: rows);
    tile_store(kdst + (int64)width, dv, ld: stride, rows: rows);
  }
}

kernel(block = 128) k_decode(qkv: float32*, keys: float32*, values: float32*, out: float32*, scores: float32*, at: int32, width: int32, heads: int32, scale: float32) {
  workgroup var lanes: float32[128];
  var t: int32 = thread.x;
  var h: int32 = block.x;
  var hd: int32 = width / heads;
  var col: int32 = h * hd;
  var seen: int32 = at + 1;
  var row: float32* = scores + (int64)h * (int64)seen;
  var e: int32 = t;
  while (e < hd) {
    keys[(int64)at * (int64)width + (int64)(col + e)] = qkv[width + col + e];
    values[(int64)at * (int64)width + (int64)(col + e)] = qkv[2 * width + col + e];
    e = e + 128;
  }
  barrier(workgroup, global, acq_rel);
  var best: float32 = (float32)-3.0e38;
  var j: int32 = t;
  while (j < seen) {
    var key: float32* = keys + (int64)j * (int64)width + (int64)col;
    var s: float32 = z32();
    for d in 0..hd { s = s + qkv[col + d] * key[d]; }
    s = s * scale;
    row[j] = s;
    if (s > best) { best = s; }
    j = j + 128;
  }
  lanes[t] = best;
  barrier(workgroup, global, acq_rel);
  var width2: int32 = 64;
  while (width2 > 0) {
    if (t < width2 && lanes[t + width2] > lanes[t]) { lanes[t] = lanes[t + width2]; }
    barrier(workgroup, acq_rel);
    width2 = width2 / 2;
  }
  var top: float32 = lanes[0];
  barrier(workgroup, acq_rel);
  var total: float32 = z32();
  j = t;
  while (j < seen) {
    var p: float32 = expf(row[j] - top);
    row[j] = p;
    total = total + p;
    j = j + 128;
  }
  lanes[t] = total;
  barrier(workgroup, global, acq_rel);
  width2 = 64;
  while (width2 > 0) {
    if (t < width2) { lanes[t] = lanes[t] + lanes[t + width2]; }
    barrier(workgroup, acq_rel);
    width2 = width2 / 2;
  }
  var inv: float32 = one32() / lanes[0];
  e = t;
  while (e < hd) {
    var acc: float32 = z32();
    for u in 0..seen { acc = acc + row[u] * values[(int64)u * (int64)width + (int64)(col + e)]; }
    out[col + e] = acc * inv;
    e = e + 128;
  }
}

kernel(block = 256) k_column_partials(src: float32*, x: float32*, mean: float32*, rstd: float32*, rows: int32, cols: int32, mode: int32, partial_a: float32*, partial_b: float32*) {
  workgroup var lanes: float32[512];
  var t: int32 = thread.x;
  var c: int32 = block.x * 32 + t % 32;
  var slab: int32 = block.y;
  var r: int32 = slab * 256 + t / 32;
  var live: bool = c < cols;
  var acc_a: float32 = z32();
  var acc_b: float32 = z32();
  for i in 0..32 {
    if (live && r < rows) {
      var at: int64 = (int64)r * (int64)cols + (int64)c;
      var d: float32 = src[at];
      if (mode == 0) {
        acc_a = acc_a + d;
      } else {
        var mu: float32 = z32();
        if (mode == 1) { mu = mean[r]; }
        acc_a = acc_a + d * (x[at] - mu) * rstd[r];
        acc_b = acc_b + d;
      }
    }
    r = r + 8;
  }
  lanes[t] = acc_a;
  lanes[256 + t] = acc_b;
  barrier(workgroup, acq_rel);
  if (t < 32 && live) {
    var sa: float32 = z32();
    var sb: float32 = z32();
    comptime for k in 0..8 {
      sa = sa + lanes[t + 32 * k];
      sb = sb + lanes[256 + t + 32 * k];
    }
    var at: int64 = (int64)slab * (int64)cols + (int64)c;
    partial_a[at] = sa;
    if (partial_b != (float32*)0) { partial_b[at] = sb; }
  }
}

kernel(block = 256) k_column_total(partial: float32*, chunks: int32, cols: int32, dst: float32*, scale: float32) {
  var c: int32 = block.x * 256 + thread.x;
  if (c >= cols) { return; }
  var acc: float32 = z32();
  for k in 0..chunks { acc = acc + partial[(int64)k * (int64)cols + (int64)c]; }
  dst[c] = dst[c] + acc * scale;
}

kernel(block = 256) k_softmax(kind: int32, y: float32*, x: float32*, rows: int32, cols: int32, q_len: int32, k_len: int32) {
  var row: int32 = block.x * 8 + thread.x / 32;
  var lane: int32 = (int32)subgroup_local_id();
  if (row >= rows) { return; }
  var base: int64 = (int64)row * (int64)cols;
  var visible: int32 = cols;
  if (kind == 2) {
    var q: int32 = row % q_len;
    visible = q + (k_len - q_len) + 1;
    if (visible > cols) { visible = cols; }
    if (visible < 0) { visible = 0; }
  }
  var best: float32 = (float32)-3.0e38;
  var c: int32 = lane;
  while (c < visible) {
    var v: float32 = x[base + (int64)c];
    if (v > best) { best = v; }
    c = c + 32;
  }
  best = subgroup_reduce_max(best);
  var total: float32 = z32();
  c = lane;
  while (c < visible) {
    total = total + expf(x[base + (int64)c] - best);
    c = c + 32;
  }
  total = subgroup_reduce_add(total);
  var lse: float32 = best + logf(total);
  var inv: float32 = one32() / total;
  c = lane;
  while (c < cols) {
    var v: float32 = z32();
    if (c < visible) {
      if (kind == 1) { v = x[base + (int64)c] - lse; } else { v = expf(x[base + (int64)c] - best) * inv; }
    }
    y[base + (int64)c] = v;
    c = c + 32;
  }
}

kernel(block = 256) k_softmax_back(kind: int32, dx: float32*, dy: float32*, y: float32*, rows: int32, cols: int32, scale: float32, accumulate: int32) {
  var row: int32 = block.x * 8 + thread.x / 32;
  var lane: int32 = (int32)subgroup_local_id();
  if (row >= rows) { return; }
  var base: int64 = (int64)row * (int64)cols;
  var s: float32 = z32();
  var c: int32 = lane;
  while (c < cols) {
    if (kind == 1) { s = s + dy[base + (int64)c]; } else { s = s + dy[base + (int64)c] * y[base + (int64)c]; }
    c = c + 32;
  }
  s = subgroup_reduce_add(s);
  c = lane;
  while (c < cols) {
    var at: int64 = base + (int64)c;
    var g: float32 = z32();
    if (kind == 1) { g = dy[at] - expf(y[at]) * s; } else { g = y[at] * (dy[at] - s); }
    g = g * scale;
    if (accumulate != 0) { dx[at] = dx[at] + g; } else { dx[at] = g; }
    c = c + 32;
  }
}

kernel(block = 256) k_xent(probs: float32*, losses: float32*, x: float32*, targets: int32*, rows: int32, cols: int32, smoothing: float32) {
  var row: int32 = block.x * 8 + thread.x / 32;
  var lane: int32 = (int32)subgroup_local_id();
  if (row >= rows) { return; }
  var base: int64 = (int64)row * (int64)cols;
  var target: int32 = (int32)subgroup_broadcast((uint32)targets[row], (uint32)0);
  var best: float32 = (float32)-3.0e38;
  var sum_x: float32 = z32();
  var c: int32 = lane;
  while (c < cols) {
    var v: float32 = x[base + (int64)c];
    if (v > best) { best = v; }
    sum_x = sum_x + v;
    c = c + 32;
  }
  best = subgroup_reduce_max(best);
  sum_x = subgroup_reduce_add(sum_x);
  var total: float32 = z32();
  c = lane;
  while (c < cols) {
    total = total + expf(x[base + (int64)c] - best);
    c = c + 32;
  }
  total = subgroup_reduce_add(total);
  var inv: float32 = one32() / total;
  var skip: bool = target < 0;
  c = lane;
  while (c < cols) {
    var p: float32 = z32();
    if (!skip) { p = expf(x[base + (int64)c] - best) * inv; }
    probs[base + (int64)c] = p;
    c = c + 32;
  }
  if (lane == 0) {
    var nll: float32 = z32();
    if (!skip) {
      var lse: float32 = best + logf(total);
      nll = lse - x[base + (int64)target];
      if (smoothing > z32()) {
        nll = (one32() - smoothing) * nll + smoothing * (lse - sum_x / (float32)cols);
      }
    }
    losses[row] = nll;
  }
}

kernel(block = 256) k_xent_back(dx: float32*, probs: float32*, targets: int32*, dloss: float32*, rows: int32, cols: int32, count: int32, smoothing: float32) {
  var id: int64 = (int64)block.x * 256 + (int64)thread.x;
  if (id >= (int64)rows * (int64)cols) { return; }
  var r: int32 = (int32)(id / (int64)cols);
  var c: int32 = (int32)(id - (int64)r * (int64)cols);
  var t: int32 = targets[r];
  if (t < 0) { return; }
  var scale: float32 = dloss[0] / (float32)count;
  var off: float32 = smoothing / (float32)cols;
  var g: float32 = scale * (probs[id] - off);
  if (c == t) { g = g - scale * (one32() - smoothing); }
  dx[id] = dx[id] + g;
}

kernel(block = 256) k_norm(rms: int32, y: float32*, x: float32*, gamma: float32*, beta: float32*, mean: float32*, rstd: float32*, rows: int32, cols: int32, eps: float32) {
  var row: int32 = block.x * 8 + thread.x / 32;
  var lane: int32 = (int32)subgroup_local_id();
  if (row >= rows) { return; }
  var base: int64 = (int64)row * (int64)cols;
  var inv_n: float32 = one32() / (float32)cols;
  var mu: float32 = z32();
  if (rms == 0) {
    var s: float32 = z32();
    var c: int32 = lane;
    while (c < cols) {
      s = s + x[base + (int64)c];
      c = c + 32;
    }
    mu = subgroup_reduce_add(s) * inv_n;
  }
  var q: float32 = z32();
  var c2: int32 = lane;
  while (c2 < cols) {
    var d: float32 = x[base + (int64)c2] - mu;
    q = q + d * d;
    c2 = c2 + 32;
  }
  var rs: float32 = rsqrtf(subgroup_reduce_add(q) * inv_n + eps);
  if (lane == 0) {
    mean[row] = mu;
    rstd[row] = rs;
  }
  var has_gamma: bool = gamma != (float32*)0;
  var has_beta: bool = beta != (float32*)0;
  var c3: int32 = lane;
  while (c3 < cols) {
    var v: float32 = (x[base + (int64)c3] - mu) * rs;
    if (has_gamma) { v = v * gamma[c3]; }
    if (has_beta) { v = v + beta[c3]; }
    y[base + (int64)c3] = v;
    c3 = c3 + 32;
  }
}

kernel(block = 256) k_norm_back(rms: int32, dx: float32*, dy: float32*, x: float32*, gamma: float32*, mean: float32*, rstd: float32*, rows: int32, cols: int32, fresh: int32) {
  var row: int32 = block.x * 8 + thread.x / 32;
  var lane: int32 = (int32)subgroup_local_id();
  if (row >= rows) { return; }
  var base: int64 = (int64)row * (int64)cols;
  var mu: float32 = z32();
  if (rms == 0) { mu = mean[row]; }
  var rs: float32 = rstd[row];
  var has_gamma: bool = gamma != (float32*)0;
  var sg: float32 = z32();
  var sgx: float32 = z32();
  var c: int32 = lane;
  while (c < cols) {
    var at: int64 = base + (int64)c;
    var gi: float32 = dy[at];
    if (has_gamma) { gi = gi * gamma[c]; }
    var xh: float32 = (x[at] - mu) * rs;
    sg = sg + gi;
    sgx = sgx + gi * xh;
    c = c + 32;
  }
  var inv_n: float32 = one32() / (float32)cols;
  var mg: float32 = subgroup_reduce_add(sg) * inv_n;
  var mgx: float32 = subgroup_reduce_add(sgx) * inv_n;
  if (rms != 0) { mg = z32(); }
  c = lane;
  while (c < cols) {
    var at: int64 = base + (int64)c;
    var gi: float32 = dy[at];
    if (has_gamma) { gi = gi * gamma[c]; }
    var xh: float32 = (x[at] - mu) * rs;
    if (fresh != 0) {
      dx[at] = rs * (gi - mg - xh * mgx);
    } else {
      dx[at] = dx[at] + rs * (gi - mg - xh * mgx);
    }
    c = c + 32;
  }
}

kernel(block = 256) k_dropout(dst: float32*, src: float32*, n: int64, key: uint64, threshold: uint64, keep: float32, accumulate: int32) {
  var i: int64 = (int64)block.x * 256 + (int64)thread.x;
  var step: int64 = (int64)grid_dim.x * 256;
  while (i < n) {
    var m: float32 = z32();
    if (drop_bits(key, i) >= threshold) { m = keep; }
    if (accumulate != 0) { dst[i] = dst[i] + src[i] * m; } else { dst[i] = src[i] * m; }
    i = i + step;
  }
}

kernel(block = 256) k_gather(dst: float32*, table: float32*, ids: int32*, count: int64, width: int64) {
  var id: int64 = (int64)block.x * 256 + (int64)thread.x;
  var step: int64 = (int64)grid_dim.x * 256;
  while (id < count * width) {
    var r: int64 = id / width;
    var d: int64 = id - r * width;
    dst[id] = table[(int64)ids[r] * width + d];
    id = id + step;
  }
}

kernel(block = 256) k_scatter(dtable: float32*, dy: float32*, order: int32*, starts: int32*, vocab: int64, width: int64) {
  var id: int64 = (int64)block.x * 256 + (int64)thread.x;
  var step: int64 = (int64)grid_dim.x * 256;
  while (id < vocab * width) {
    var v: int64 = id / width;
    var d: int64 = id - v * width;
    var s0: int32 = starts[v];
    var s1: int32 = starts[v + 1];
    if (s1 > s0) {
      var acc: float32 = z32();
      for k in s0..s1 { acc = acc + dy[(int64)order[k] * width + d]; }
      dtable[id] = dtable[id] + acc;
    }
    id = id + step;
  }
}

kernel(block = 256) k_step(w: float32*, g: float32*, m: float32*, v: float32*, n: int64, p: Adam, factor: float32*) {
  var f: float32 = one32();
  if (factor != (float32*)0) { f = factor[0]; }
  var i: int64 = (int64)block.x * 256 + (int64)thread.x;
  var step: int64 = (int64)grid_dim.x * 256;
  var has_m: bool = m != (float32*)0;
  while (i < n) {
    var d: float32 = g[i] * f + p.decay * w[i];
    if (p.kind == 0) {
      if (has_m) {
        var buf: float32 = d;
        if (p.first == 0) { buf = p.momentum * m[i] + (one32() - p.dampening) * d; }
        m[i] = buf;
        if (p.nesterov != 0) { d = d + p.momentum * buf; } else { d = buf; }
      }
      w[i] = w[i] - p.lr * d;
    } else {
      var mi: float32 = p.beta1 * m[i] + (one32() - p.beta1) * d;
      var vi: float32 = p.beta2 * v[i] + (one32() - p.beta2) * d * d;
      m[i] = mi;
      v[i] = vi;
      w[i] = w[i] * p.shrink - p.lr * (mi * p.correct1) / (sqrtf(vi * p.correct2) + p.eps);
    }
    i = i + step;
  }
}

kernel(block = 32) k_clip(total: float32*, max_norm: float32, factor: float32*) {
  if (thread.x != 0) { return; }
  var norm: float32 = sqrtf(total[0]);
  var f: float32 = one32();
  if (norm > max_norm && norm > z32()) { f = max_norm / (norm + (float32)0.000001); }
  factor[0] = f;
}

kernel(block = 256) k_im2col(cols: float32*, x: float32*, q: Conv) {
  var id: int64 = (int64)block.x * 256 + (int64)thread.x;
  var step: int64 = (int64)grid_dim.x * 256;
  var p_count: int64 = (int64)q.oh * (int64)q.ow;
  var np: int64 = (int64)q.n * p_count;
  var total: int64 = (int64)q.c * (int64)q.kh * (int64)q.kw * np;
  while (id < total) {
    var r: int64 = id / np;
    var col: int64 = id - r * np;
    var img: int64 = col / p_count;
    var pix: int64 = col - img * p_count;
    var oy: int32 = (int32)(pix / (int64)q.ow);
    var ox: int32 = (int32)(pix - (int64)oy * (int64)q.ow);
    var kx: int32 = (int32)(r % (int64)q.kw);
    var ky: int32 = (int32)((r / (int64)q.kw) % (int64)q.kh);
    var ch: int64 = r / ((int64)q.kw * (int64)q.kh);
    var iy: int32 = oy * q.stride - q.pad + ky * q.dilation;
    var ix: int32 = ox * q.stride - q.pad + kx * q.dilation;
    var v: float32 = z32();
    if (iy >= 0 && iy < q.h && ix >= 0 && ix < q.w) {
      v = x[((img * (int64)q.c + ch) * (int64)q.h + (int64)iy) * (int64)q.w + (int64)ix];
    }
    cols[id] = v;
    id = id + step;
  }
}

kernel(block = 256) k_col2im(dx: float32*, dcols: float32*, q: Conv) {
  var id: int64 = (int64)block.x * 256 + (int64)thread.x;
  var step: int64 = (int64)grid_dim.x * 256;
  var p_count: int64 = (int64)q.oh * (int64)q.ow;
  var np: int64 = (int64)q.n * p_count;
  var total: int64 = (int64)q.n * (int64)q.c * (int64)q.h * (int64)q.w;
  while (id < total) {
    var ix: int32 = (int32)(id % (int64)q.w);
    var iy: int32 = (int32)((id / (int64)q.w) % (int64)q.h);
    var ch: int64 = (id / ((int64)q.w * (int64)q.h)) % (int64)q.c;
    var img: int64 = id / ((int64)q.w * (int64)q.h * (int64)q.c);
    var acc: float32 = z32();
    for ky in 0..q.kh {
      var ty: int32 = iy + q.pad - ky * q.dilation;
      if (ty < 0 || ty % q.stride != 0) { continue; }
      var oy: int32 = ty / q.stride;
      if (oy >= q.oh) { continue; }
      for kx in 0..q.kw {
        var tx: int32 = ix + q.pad - kx * q.dilation;
        if (tx < 0 || tx % q.stride != 0) { continue; }
        var ox: int32 = tx / q.stride;
        if (ox >= q.ow) { continue; }
        var r: int64 = (ch * (int64)q.kh + (int64)ky) * (int64)q.kw + (int64)kx;
        acc = acc + dcols[r * np + img * p_count + (int64)oy * (int64)q.ow + (int64)ox];
      }
    }
    dx[id] = dx[id] + acc;
    id = id + step;
  }
}

kernel(block = 256) k_channel_bias(out: float32*, bias: float32*, n: int64, c: int64, spatial: int64) {
  var id: int64 = (int64)block.x * 256 + (int64)thread.x;
  var step: int64 = (int64)grid_dim.x * 256;
  while (id < n * c * spatial) {
    var ch: int64 = (id / spatial) % c;
    out[id] = out[id] + bias[ch];
    id = id + step;
  }
}

kernel(block = 256) k_channel_sums(dst: float32*, src: float32*, x: float32*, mean: float32*, rstd: float32*, n: int32, c: int32, spatial: int32, mode: int32) {
  workgroup var lanes: float32[256];
  var t: int32 = thread.x;
  var ch: int32 = block.x;
  var total: int64 = (int64)n * (int64)spatial;
  var mu: float32 = z32();
  var rs: float32 = one32();
  if (mode == 1) {
    mu = mean[ch];
    rs = rstd[ch];
  }
  var acc: float32 = z32();
  var i: int64 = (int64)t;
  while (i < total) {
    var img: int64 = i / (int64)spatial;
    var p: int64 = i - img * (int64)spatial;
    var at: int64 = (img * (int64)c + (int64)ch) * (int64)spatial + p;
    if (mode == 1) { acc = acc + src[at] * (x[at] - mu) * rs; } else { acc = acc + src[at]; }
    i = i + 256;
  }
  lanes[t] = acc;
  barrier(workgroup, acq_rel);
  var width: int32 = 128;
  while (width > 0) {
    if (t < width) { lanes[t] = lanes[t] + lanes[t + width]; }
    barrier(workgroup, acq_rel);
    width = width / 2;
  }
  if (t == 0) { dst[ch] = dst[ch] + lanes[0]; }
}

kernel(block = 256) k_pool(y: float32*, arg: int32*, x: float32*, planes: int64, h: int32, w: int32, oh: int32, ow: int32, k: int32, stride: int32, pad: int32, use_max: int32) {
  var id: int64 = (int64)block.x * 256 + (int64)thread.x;
  var step: int64 = (int64)grid_dim.x * 256;
  var out_plane: int64 = (int64)oh * (int64)ow;
  var area: float32 = one32() / (float32)(k * k);
  while (id < planes * out_plane) {
    var plane: int64 = id / out_plane;
    var pix: int32 = (int32)(id - plane * out_plane);
    var oy: int32 = pix / ow;
    var ox: int32 = pix - oy * ow;
    var src: float32* = x + plane * (int64)h * (int64)w;
    var y0: int32 = oy * stride - pad;
    var x0: int32 = ox * stride - pad;
    var best: float32 = z32();
    var best_at: int32 = -1;
    var total: float32 = z32();
    for ky in 0..k {
      var iy: int32 = y0 + ky;
      if (iy < 0 || iy >= h) { continue; }
      for kx in 0..k {
        var ix: int32 = x0 + kx;
        if (ix < 0 || ix >= w) { continue; }
        var v: float32 = src[iy * w + ix];
        total = total + v;
        if (best_at < 0 || v > best) {
          best = v;
          best_at = iy * w + ix;
        }
      }
    }
    if (use_max != 0) {
      y[id] = best;
      arg[id] = best_at;
    } else {
      y[id] = total * area;
    }
    id = id + step;
  }
}

kernel(block = 256) k_pool_back(dx: float32*, dy: float32*, arg: int32*, planes: int64, h: int32, w: int32, oh: int32, ow: int32, k: int32, stride: int32, pad: int32, use_max: int32) {
  var id: int64 = (int64)block.x * 256 + (int64)thread.x;
  var step: int64 = (int64)grid_dim.x * 256;
  var in_plane: int64 = (int64)h * (int64)w;
  var out_plane: int64 = (int64)oh * (int64)ow;
  var area: float32 = one32() / (float32)(k * k);
  while (id < planes * in_plane) {
    var plane: int64 = id / in_plane;
    var pix: int32 = (int32)(id - plane * in_plane);
    var iy: int32 = pix / w;
    var ix: int32 = pix - iy * w;
    var acc: float32 = z32();
    for oy in 0..oh {
      var y0: int32 = oy * stride - pad;
      if (iy < y0 || iy >= y0 + k) { continue; }
      for ox in 0..ow {
        var x0: int32 = ox * stride - pad;
        if (ix < x0 || ix >= x0 + k) { continue; }
        var at: int64 = plane * out_plane + (int64)(oy * ow + ox);
        if (use_max != 0) {
          if (arg[at] == pix) { acc = acc + dy[at]; }
        } else {
          acc = acc + dy[at] * area;
        }
      }
    }
    dx[id] = dx[id] + acc;
    id = id + step;
  }
}

kernel(block = 256) k_batch_norm(y: float32*, x: float32*, gamma: float32*, beta: float32*, mean: float32*, rstd: float32*, run_mean: float32*, run_var: float32*, n: int32, c: int32, spatial: int32, eps: float32, momentum: float32, training: int32) {
  workgroup var lanes: float32[256];
  var t: int32 = thread.x;
  var ch: int32 = block.x;
  var total: int64 = (int64)n * (int64)spatial;
  var mu: float32 = z32();
  var rs: float32 = z32();
  if (training != 0) {
    var acc: float32 = z32();
    var i: int64 = (int64)t;
    while (i < total) {
      var img: int64 = i / (int64)spatial;
      acc = acc + x[(img * (int64)c + (int64)ch) * (int64)spatial + (i - img * (int64)spatial)];
      i = i + 256;
    }
    lanes[t] = acc;
    barrier(workgroup, acq_rel);
    var width: int32 = 128;
    while (width > 0) {
      if (t < width) { lanes[t] = lanes[t] + lanes[t + width]; }
      barrier(workgroup, acq_rel);
      width = width / 2;
    }
    mu = lanes[0] / (float32)total;
    barrier(workgroup, acq_rel);
    var sq: float32 = z32();
    i = (int64)t;
    while (i < total) {
      var img: int64 = i / (int64)spatial;
      var d: float32 = x[(img * (int64)c + (int64)ch) * (int64)spatial + (i - img * (int64)spatial)] - mu;
      sq = sq + d * d;
      i = i + 256;
    }
    lanes[t] = sq;
    barrier(workgroup, acq_rel);
    width = 128;
    while (width > 0) {
      if (t < width) { lanes[t] = lanes[t] + lanes[t + width]; }
      barrier(workgroup, acq_rel);
      width = width / 2;
    }
    var variance: float32 = lanes[0] / (float32)total;
    rs = rsqrtf(variance + eps);
    if (t == 0 && run_mean != (float32*)0) {
      var count: float32 = (float32)total;
      var unbiased: float32 = variance;
      if (total > 1) { unbiased = variance * count / (count - one32()); }
      run_mean[ch] = (one32() - momentum) * run_mean[ch] + momentum * mu;
      run_var[ch] = (one32() - momentum) * run_var[ch] + momentum * unbiased;
    }
  } else {
    mu = run_mean[ch];
    rs = rsqrtf(run_var[ch] + eps);
  }
  if (t == 0) {
    mean[ch] = mu;
    rstd[ch] = rs;
  }
  var gm: float32 = gamma[ch];
  var bt: float32 = beta[ch];
  var i2: int64 = (int64)t;
  while (i2 < total) {
    var img: int64 = i2 / (int64)spatial;
    var at: int64 = (img * (int64)c + (int64)ch) * (int64)spatial + (i2 - img * (int64)spatial);
    y[at] = (x[at] - mu) * rs * gm + bt;
    i2 = i2 + 256;
  }
}

kernel(block = 256) k_batch_norm_back(dx: float32*, dgamma: float32*, dbeta: float32*, dy: float32*, x: float32*, gamma: float32*, mean: float32*, rstd: float32*, n: int32, c: int32, spatial: int32, training: int32) {
  workgroup var lanes: float32[256];
  workgroup var lanes2: float32[256];
  var t: int32 = thread.x;
  var ch: int32 = block.x;
  var total: int64 = (int64)n * (int64)spatial;
  var mu: float32 = mean[ch];
  var rs: float32 = rstd[ch];
  var sd: float32 = z32();
  var sdx: float32 = z32();
  var i: int64 = (int64)t;
  while (i < total) {
    var img: int64 = i / (int64)spatial;
    var at: int64 = (img * (int64)c + (int64)ch) * (int64)spatial + (i - img * (int64)spatial);
    var d: float32 = dy[at];
    sd = sd + d;
    sdx = sdx + d * (x[at] - mu) * rs;
    i = i + 256;
  }
  lanes[t] = sd;
  lanes2[t] = sdx;
  barrier(workgroup, acq_rel);
  var width: int32 = 128;
  while (width > 0) {
    if (t < width) {
      lanes[t] = lanes[t] + lanes[t + width];
      lanes2[t] = lanes2[t] + lanes2[t + width];
    }
    barrier(workgroup, acq_rel);
    width = width / 2;
  }
  var sum_dy: float32 = lanes[0];
  var sum_dy_xh: float32 = lanes2[0];
  if (t == 0) {
    if (dgamma != (float32*)0) { dgamma[ch] = dgamma[ch] + sum_dy_xh; }
    if (dbeta != (float32*)0) { dbeta[ch] = dbeta[ch] + sum_dy; }
  }
  if (dx == (float32*)0) { return; }
  var gm: float32 = gamma[ch];
  var mean_dy: float32 = sum_dy / (float32)total;
  var mean_dy_xh: float32 = sum_dy_xh / (float32)total;
  i = (int64)t;
  while (i < total) {
    var img: int64 = i / (int64)spatial;
    var at: int64 = (img * (int64)c + (int64)ch) * (int64)spatial + (i - img * (int64)spatial);
    if (training != 0) {
      var xh: float32 = (x[at] - mu) * rs;
      dx[at] = dx[at] + gm * rs * (dy[at] - mean_dy - xh * mean_dy_xh);
    } else {
      dx[at] = dx[at] + gm * rs * dy[at];
    }
    i = i + 256;
  }
}

export const MATMUL_FP32 = 0;
export const MATMUL_BF16 = 1;

struct GpuState {
  sms: int32;
  partials: float32*;
  matmul: int32;
  dev: Device*;
  scratch: Graph*;
  narrow: bool;
}

export fn gpu_matmul(dev: Device*, mode: int32) {
  state_of(dev->state)->matmul = mode;
}

export fn gpu_normal_rows(dev: Device*, dst: float32*, seeds: int32*, count: int64, width: int64, scale: float64) {
  dispatch k_normal_rows[spread(state_of(dev->state), count * width), 256](dst, seeds, count, width, (float32)scale);
}

export fn gpu_tiles(dev: Device*, narrow: bool) {
  state_of(dev->state)->narrow = narrow;
}

fn state_of(p: rawptr) -> GpuState* {
  return (GpuState*)p;
}

fn spread(s: GpuState*, n: int64) -> int32 {
  var blocks: int64 = (n + 255) / 256;
  var cap: int64 = (int64)s->sms * 16;
  if (blocks > cap) { blocks = cap; }
  if (blocks < 1) { blocks = 1; }
  return (int32)blocks;
}

fn cover(n: int64) -> int32 {
  var blocks: int64 = (n + 255) / 256;
  if (blocks < 1) { blocks = 1; }
  return (int32)blocks;
}

fn row_blocks(rows: int64) -> int32 {
  var blocks: int64 = (rows + 7) / 8;
  if (blocks < 1) { blocks = 1; }
  return (int32)blocks;
}

fn gpu_persist(state: rawptr, bytes: int64) -> rawptr {
  return (rawptr)gpu_malloc(bytes);
}

fn gpu_release(state: rawptr, p: rawptr) {
  gpu_free((int64)p);
}

fn gpu_set(state: rawptr, p: float32*, value: float32, n: int64) {
  gpu_memset_u32_async((int64)p, (uint32)f32_bits_of(value), n, 0);
}

fn gpu_upload(state: rawptr, dst: rawptr, src: rawptr, bytes: int64) {
  gpu_to_device((int64)dst, (uint8*)src, bytes);
}

fn gpu_download(state: rawptr, dst: rawptr, src: rawptr, bytes: int64) {
  gpu_to_host((uint8*)dst, (int64)src, bytes);
}

fn gpu_add(state: rawptr, dst: float32*, src: float32*, alpha: float32, n: int64) {
  dispatch k_add[spread(state_of(state), n), 256](dst, src, alpha, n);
}

fn sum_into(s: GpuState*, out: float32*, x: float32*, y: float32*, mode: int32, n: int64, scale: float32, accumulate: bool) {
  var blocks: int32 = spread(s, n);
  if (blocks > 1024) { blocks = 1024; }
  dispatch k_partials[blocks, 256](x, y, mode, n, s->partials);
  dispatch k_total[1, 256](s->partials, blocks, out, scale, if accumulate { 1 } else { 0 });
}

fn gpu_squares(state: rawptr, out: float32*, x: float32*, n: int64) {
  if (n <= 0) { return; }
  sum_into(state_of(state), out, x, (float32*)0, 1, n, 1.0, true);
}

fn gpu_clip(state: rawptr, total: float32*, max_norm: float32, factor: float32*) {
  dispatch k_clip[1, 32](total, max_norm, factor);
}

fn gpu_step(state: rawptr, w: float32*, g: float32*, m: float32*, v: float32*, n: int64, c: StepCall*, factor: float32*) {
  var p: Adam;
  p.lr = c->lr;
  p.beta1 = c->beta1;
  p.beta2 = c->beta2;
  p.eps = c->eps;
  p.decay = c->decay;
  p.shrink = c->shrink;
  p.correct1 = c->correct1;
  p.correct2 = c->correct2;
  p.momentum = c->momentum;
  p.dampening = c->dampening;
  p.nesterov = if c->nesterov { 1 } else { 0 };
  p.first = if c->first { 1 } else { 0 };
  p.kind = if c->kind == 0 { 0 } else { 1 };
  dispatch k_step[spread(state_of(state), n), 256](w, g, m, v, n, p, factor);
}

fn gpu_wait(state: rawptr) {
  gpu_sync();
}

fn gpu_muon(state: rawptr, c: MuonCall*) {
  var s: GpuState* = state_of(state);
  if (c->apply) {
    dispatch k_muon_apply[spread(s, c->n), 256](c->w, c->u, c->n, c->lr, c->shrink);
  } else {
    dispatch k_muon_mix[spread(s, c->n), 256](c->g, c->m, c->u, c->n, c->beta, c->factor);
  }
}

fn batched(a: float32*, b: float32*, c: float32*, m: int64, n: int64, k: int64, lda: int64, ldb: int64, ta: bool, tb: bool, accumulate: bool, count: int64, sa: int64, sb: int64, sc: int64) -> GemmShape {
  var q: GemmShape = gemm_shape(a, b, c, m, n, k, lda, ldb, n, ta, tb, accumulate);
  q.outer = count;
  q.sa_outer = sa;
  q.sb_outer = sb;
  q.sc_outer = sc;
  return q;
}

fn gpu_orth(state: rawptr, x: float32*, count: int64, rows: int64, cols: int64, steps: int32) {
  var s: GpuState* = state_of(state);
  if (s->scratch == 0) { s->scratch = graph_on(s->dev); }
  var g: Graph* = s->scratch;
  g->reset();
  var tall: bool = rows > cols;
  var small: int64 = if tall { cols } else { rows };
  var rc: int64 = rows * cols;
  var ss: int64 = small * small;
  var all: int64 = rc * count;
  var sq: float32* = g->floats(ss * count);
  var tq: float32* = g->floats(ss * count);
  var bq: float32* = g->floats(ss * count);
  var other: float32* = g->floats(all);
  var parts: int32 = 16;
  var partial: float32* = g->floats(count * (int64)parts);
  dispatch k_frob_partials[grid: (parts, (int32)count, 1), block: (256, 1, 1)](x, rc, parts, partial);
  dispatch k_frob_scale[grid: (parts, (int32)count, 1), block: (256, 1, 1)](x, rc, parts, partial);
  var cur: float32* = x;
  var nxt: float32* = other;
  var blocks: int32 = spread(s, ss * count);
  for it in 0..steps {
    if (tall) {
      run_gemm(s, g, batched(cur, cur, sq, cols, cols, rows, cols, cols, true, false, false, count, rc, rc, ss));
    } else {
      run_gemm(s, g, batched(cur, cur, sq, rows, rows, cols, cols, cols, false, true, false, count, rc, rc, ss));
    }
    dispatch k_poly[blocks, 256](tq, sq, (float32)2.0315, (float32)-4.7750, small, ss * count);
    run_gemm(s, g, batched(sq, tq, bq, small, small, small, small, small, false, false, false, count, ss, ss, ss));
    dispatch k_diag[cover(small * count), 256](bq, (float32)3.4445, small, count);
    if (tall) {
      run_gemm(s, g, batched(cur, bq, nxt, rows, cols, cols, cols, cols, false, false, false, count, rc, ss, rc));
    } else {
      run_gemm(s, g, batched(bq, cur, nxt, rows, cols, rows, rows, cols, false, false, false, count, ss, rc, rc));
    }
    var keep: float32* = cur;
    cur = nxt;
    nxt = keep;
  }
  if (cur != x) { dispatch k_scaled[spread(s, all), 256](x, cur, one32(), all); }
}

export fn gpu_device() -> Device* {
  if (gpu_init() == 0) { mmll_fail("no CUDA device answered; check that the NVIDIA driver is installed"); }
  var s: GpuState* = new GpuState;
  s->sms = gpu_sm_count(0);
  s->partials = (float32*)gpu_malloc(4096 * 4);
  var d: Device* = new Device;
  d->state = (rawptr)s;
  d->persist = &gpu_persist;
  d->release = &gpu_release;
  d->set = &gpu_set;
  d->upload = &gpu_upload;
  d->download = &gpu_download;
  d->forward = &gpu_forward;
  d->backward = &gpu_backward;
  d->add = &gpu_add;
  d->squares = &gpu_squares;
  d->clip = &gpu_clip;
  d->step = &gpu_step;
  d->sync = &gpu_wait;
  d->muon = &gpu_muon;
  d->orth = &gpu_orth;
  s->dev = d;
  return d;
}

struct GemmShape {
  a: float32*;
  b: float32*;
  c: float32*;
  m: int64;
  n: int64;
  k: int64;
  lda: int64;
  ldb: int64;
  ldc: int64;
  ta: bool;
  tb: bool;
  accumulate: bool;
  alpha: float32;
  bias: float32*;
  outer: int64;
  inner: int64;
  sa_outer: int64;
  sa_inner: int64;
  sb_outer: int64;
  sb_inner: int64;
  sc_outer: int64;
  sc_inner: int64;
  exact: bool;
}

fn gemm_shape(a: float32*, b: float32*, c: float32*, m: int64, n: int64, k: int64, lda: int64, ldb: int64, ldc: int64, ta: bool, tb: bool, accumulate: bool) -> GemmShape {
  var s: GemmShape;
  s.a = a;
  s.b = b;
  s.c = c;
  s.m = m;
  s.n = n;
  s.k = k;
  s.lda = lda;
  s.ldb = ldb;
  s.ldc = ldc;
  s.ta = ta;
  s.tb = tb;
  s.accumulate = accumulate;
  s.alpha = 1.0;
  s.exact = false;
  s.bias = (float32*)0;
  s.outer = 1;
  s.inner = 1;
  s.sa_outer = 0;
  s.sa_inner = 0;
  s.sb_outer = 0;
  s.sb_inner = 0;
  s.sc_outer = 0;
  s.sc_inner = 0;
  return s;
}

fn aligned16(p: float32*) -> bool {
  return (int64)p % 16 == 0;
}

fn tensor_launch(form: int32, gx: int32, gy: int32, gz: int32, q: GemmShape, c: float32*, ldc: int64, sa: int64, sb: int64, sc: int64, splits: int64, chunk: int64, sp: int64) {
  var a: int64 = (int64)q.a;
  var b: int64 = (int64)q.b;
  var d: int64 = (int64)c;
  var k: int32 = (int32)q.k;
  var la: int32 = (int32)(q.lda / 4);
  var lb: int32 = (int32)(q.ldb / 4);
  var lc: int32 = (int32)ldc;
  var s4a: int64 = sa / 4;
  var s4b: int64 = sb / 4;
  var cut: int32 = (int32)splits;
  var part: int32 = (int32)chunk;
  var e: int64 = (int64)q.bias;
  var z: int32 = 0;
  if (form == 0) { dispatch k_tc_nt[grid: (gx, gy, gz), block: (256, 1, 1)](a, b, d, k, la, lb, lc, s4a, s4b, sc, cut, part, sp, q.alpha, e, z); }
  if (form == 1) { dispatch k_tc_nn[grid: (gx, gy, gz), block: (256, 1, 1)](a, b, d, k, la, lb, lc, s4a, s4b, sc, cut, part, sp, q.alpha, e, z); }
  if (form == 2) { dispatch k_tc_tn[grid: (gx, gy, gz), block: (256, 1, 1)](a, b, d, k, la, lb, lc, s4a, s4b, sc, cut, part, sp, q.alpha, e, z); }
  if (form == 3) { dispatch k_tc_nt_acc[grid: (gx, gy, gz), block: (256, 1, 1)](a, b, d, k, la, lb, lc, s4a, s4b, sc, cut, part, sp, q.alpha, e, z); }
  if (form == 4) { dispatch k_tc_nn_acc[grid: (gx, gy, gz), block: (256, 1, 1)](a, b, d, k, la, lb, lc, s4a, s4b, sc, cut, part, sp, q.alpha, e, z); }
  if (form == 5) { dispatch k_tc_tn_acc[grid: (gx, gy, gz), block: (256, 1, 1)](a, b, d, k, la, lb, lc, s4a, s4b, sc, cut, part, sp, q.alpha, e, z); }
  if (form == 6) { dispatch k_tc_nt_bias[grid: (gx, gy, gz), block: (256, 1, 1)](a, b, d, k, la, lb, lc, s4a, s4b, sc, cut, part, sp, q.alpha, e, z); }
  if (form == 7) { dispatch k_tc_nt_64[grid: (gx, gy, gz), block: (128, 1, 1)](a, b, d, k, la, lb, lc, s4a, s4b, sc, cut, part, sp, q.alpha, e, z); }
  if (form == 8) { dispatch k_tc_nn_64[grid: (gx, gy, gz), block: (128, 1, 1)](a, b, d, k, la, lb, lc, s4a, s4b, sc, cut, part, sp, q.alpha, e, z); }
  if (form == 9) { dispatch k_tc_tn_64[grid: (gx, gy, gz), block: (128, 1, 1)](a, b, d, k, la, lb, lc, s4a, s4b, sc, cut, part, sp, q.alpha, e, z); }
  if (form == 10) { dispatch k_tc_nt_acc_64[grid: (gx, gy, gz), block: (128, 1, 1)](a, b, d, k, la, lb, lc, s4a, s4b, sc, cut, part, sp, q.alpha, e, z); }
  if (form == 11) { dispatch k_tc_nn_acc_64[grid: (gx, gy, gz), block: (128, 1, 1)](a, b, d, k, la, lb, lc, s4a, s4b, sc, cut, part, sp, q.alpha, e, z); }
  if (form == 12) { dispatch k_tc_tn_acc_64[grid: (gx, gy, gz), block: (128, 1, 1)](a, b, d, k, la, lb, lc, s4a, s4b, sc, cut, part, sp, q.alpha, e, z); }
  if (form == 13) { dispatch k_tc_nt_bias_64[grid: (gx, gy, gz), block: (128, 1, 1)](a, b, d, k, la, lb, lc, s4a, s4b, sc, cut, part, sp, q.alpha, e, z); }
}

fn run_tensor(s: GpuState*, g: Graph*, q: GemmShape) -> bool {
  if (s->matmul != MATMUL_BF16) { return false; }
  if (q.m % 64 != 0 || q.n % 64 != 0 || q.k % 32 != 0 || q.k <= 0) { return false; }
  if (q.ta && q.tb) { return false; }
  var tile: int64 = if q.m % 128 == 0 && q.n % 128 == 0 { (int64)128 } else { (int64)64 };
  if (tile == 128 && s->narrow && (q.m / 128) * (q.n / 128) * q.outer * q.inner < (int64)s->sms) { tile = 64; }
  var shift: int32 = if tile == 128 { 0 } else { 7 };
  if (q.lda % 4 != 0 || q.ldb % 4 != 0 || !aligned16(q.a) || !aligned16(q.b)) { return false; }
  if (q.outer > 1 && q.inner > 1) { return false; }
  if (q.bias != 0 && q.accumulate) { return false; }
  var batch: int64 = q.outer * q.inner;
  var sa: int64 = if q.inner > 1 { q.sa_inner } else { q.sa_outer };
  var sb: int64 = if q.inner > 1 { q.sb_inner } else { q.sb_outer };
  var sc: int64 = if q.inner > 1 { q.sc_inner } else { q.sc_outer };
  if (batch > 1 && (sa % 4 != 0 || sb % 4 != 0)) { return false; }
  var base: int32 = if q.tb { 0 } else { if q.ta { 2 } else { 1 } };
  var accumulate: bool = q.accumulate;
  if (q.bias != 0 && (q.ta || !q.tb)) {
    dispatch k_bias_rows[spread(s, q.m * q.n), 256](q.c, q.bias, (int32)q.m, (int32)q.n, q.ldc);
    accumulate = true;
  }
  var gx: int32 = (int32)(q.n / tile);
  var gy: int32 = (int32)(q.m / tile);
  var blocks: int64 = (q.m / tile) * (q.n / tile) * batch;
  var waves: int64 = (int64)s->sms * (if tile == 128 { (int64)2 } else { (int64)6 });
  var splits: int64 = 1;
  if (batch == 1 && q.bias == 0 && blocks < waves && q.k >= 1024) {
    splits = (waves + blocks - 1) / blocks;
    if (splits > q.k / 256) { splits = q.k / 256; }
    if (splits > 16) { splits = 16; }
  }
  if (splits <= 1) {
    var form: int32 = if q.bias != 0 && !accumulate { 6 } else { if accumulate { base + 3 } else { base } };
    tensor_launch(form + shift, gx, gy, (int32)batch, q, q.c, q.ldc, sa, sb, sc, 1, q.k, 0);
    return true;
  }
  var chunk: int64 = (q.k + splits - 1) / splits;
  chunk = (chunk + 31) / 32 * 32;
  splits = (q.k + chunk - 1) / chunk;
  var plane: int64 = q.m * q.n;
  var ws: float32* = g->floats(plane * splits);
  tensor_launch(base + shift, gx, gy, (int32)splits, q, ws, q.n, 0, 0, 0, splits, chunk, plane);
  dispatch k_gemm_gather[spread(s, plane), 256](q.c, ws, (int32)q.m, (int32)q.n, q.ldc, (int32)splits, plane, if accumulate { 1 } else { 0 });
  return true;
}

fn run_gemm(s: GpuState*, g: Graph*, q: GemmShape) {
  if (q.m <= 0 || q.n <= 0) { return; }
  if (!q.exact && run_tensor(s, g, q)) { return; }
  var p: Gemm;
  p.a = q.a;
  p.b = q.b;
  p.bias = q.bias;
  p.m = (int32)q.m;
  p.n = (int32)q.n;
  p.k = (int32)q.k;
  p.lda = (int32)q.lda;
  p.ldb = (int32)q.ldb;
  p.ta = if q.ta { 1 } else { 0 };
  p.tb = if q.tb { 1 } else { 0 };
  p.alpha = q.alpha;
  p.inner = (int32)q.inner;
  p.sa_outer = q.sa_outer;
  p.sa_inner = q.sa_inner;
  p.sb_outer = q.sb_outer;
  p.sb_inner = q.sb_inner;
  var batch: int64 = q.outer * q.inner;
  var waves: int64 = (int64)s->sms * 2;
  var splittable: bool = batch == 1 && q.bias == 0 && q.k >= 512;
  var choice: int32 = 0;
  var best: float64 = -1.0;
  var splits: int64 = 1;
  for v in 0..3 {
    var bm: int64 = if v == 2 { (int64)64 } else { (int64)128 };
    var bn: int64 = if v == 0 { (int64)128 } else { (int64)64 };
    var weight: float64 = if v == 0 { 1.0 } else { if v == 1 { 0.9 } else { 0.72 } };
    var blocks: int64 = ((q.m + bm - 1) / bm) * ((q.n + bn - 1) / bn) * batch;
    var cut: int64 = 1;
    if (splittable && blocks < waves) {
      cut = (waves + blocks - 1) / blocks;
      if (cut > q.k / 256) { cut = q.k / 256; }
      if (cut > 32) { cut = 32; }
      if (cut < 1) { cut = 1; }
    }
    var useful: float64 = (float64)(q.m * q.n * batch) / (float64)(blocks * bm * bn);
    var fill: float64 = (float64)(blocks * cut) / (float64)waves;
    if (fill > 1.0) { fill = 1.0; }
    var score: float64 = weight * useful * fill;
    if (score > best) {
      best = score;
      choice = v;
      splits = cut;
    }
  }
  var bm: int64 = if choice == 2 { (int64)64 } else { (int64)128 };
  var bn: int64 = if choice == 0 { (int64)128 } else { (int64)64 };
  var gx: int32 = (int32)((q.n + bn - 1) / bn);
  var gy: int32 = (int32)((q.m + bm - 1) / bm);
  var gz: int32 = (int32)batch;
  var ws: float32* = (float32*)0;
  var plane: int64 = q.m * q.n;
  if (splits == 1) {
    p.c = q.c;
    p.ldc = (int32)q.ldc;
    p.accumulate = if q.accumulate { 1 } else { 0 };
    p.sc_outer = q.sc_outer;
    p.sc_inner = q.sc_inner;
    p.splits = 1;
    p.chunk = (int32)q.k;
    p.sp = 0;
  } else {
    var chunk: int64 = (q.k + splits - 1) / splits;
    chunk = (chunk + 15) / 16 * 16;
    splits = (q.k + chunk - 1) / chunk;
    ws = g->floats(plane * splits);
    p.c = ws;
    p.ldc = (int32)q.n;
    p.accumulate = 0;
    p.sc_outer = 0;
    p.sc_inner = 0;
    p.splits = (int32)splits;
    p.chunk = (int32)chunk;
    p.sp = plane;
    gz = (int32)splits;
  }
  if (choice == 0) { dispatch k_gemm_128x128[grid: (gx, gy, gz), block: (256, 1, 1)](p); }
  if (choice == 1) { dispatch k_gemm_128x64[grid: (gx, gy, gz), block: (256, 1, 1)](p); }
  if (choice == 2) { dispatch k_gemm_64x64[grid: (gx, gy, gz), block: (256, 1, 1)](p); }
  if (splits > 1) {
    dispatch k_gemm_gather[spread(s, plane), 256](q.c, ws, (int32)q.m, (int32)q.n, q.ldc, (int32)splits, plane, if q.accumulate { 1 } else { 0 });
  }
}

fn bcast_record(so: Shape, sa: Shape, sb: Shape, op: int32) -> Bcast {
  var p: Bcast;
  var stra: int64[6] = broadcast_strides(sa, so);
  var strb: int64[6] = broadcast_strides(sb, so);
  p.rank = so.rank;
  p.count = (int32)so.size();
  p.op = op;
  for d in 0..so.rank {
    p.dims[d] = (int32)so.dims[d];
    p.sa[d] = (int32)stra[d];
    p.sb[d] = (int32)strb[d];
  }
  return p;
}

fn fwd_binary(s: GpuState*, g: Graph*, id: int32) {
  var n: Node* = g->node(id);
  var so: Shape = n->value.shape;
  var sa: Shape = g->nodes[n->a].value.shape;
  var sb: Shape = g->nodes[n->b].value.shape;
  var size: int64 = so.size();
  if (sa.equal(so) && sb.equal(so)) {
    dispatch k_binary[spread(s, size), 256](n->op, n->value.data, g->data(n->a), g->data(n->b), size);
    return;
  }
  var p: Bcast = bcast_record(so, sa, sb, n->op);
  dispatch k_bcast[cover(size), 256](p, n->value.data, g->data(n->a), g->data(n->b));
}

fn trailing_slice(part: Shape, whole: Shape) -> bool {
  var first: int32 = 0;
  while (first < part.rank && part.dims[first] == 1) { first = first + 1; }
  var kept: int32 = part.rank - first;
  if (kept > whole.rank || part.size() < 1) { return false; }
  for i in 0..kept {
    if (part.dims[part.rank - 1 - i] != whole.dims[whole.rank - 1 - i]) { return false; }
  }
  return true;
}

fn back_binary(s: GpuState*, g: Graph*, id: int32) {
  var n: Node* = g->node(id);
  var so: Shape = n->value.shape;
  var sa: Shape = g->nodes[n->a].value.shape;
  var sb: Shape = g->nodes[n->b].value.shape;
  var size: int64 = so.size();
  var pa: float32* = g->data(n->a);
  var pb: float32* = g->data(n->b);
  var dy: float32* = n->grad;
  for which in 0..2 {
    var target: int32 = if (which == 0) n->a else n->b;
    if (!g->nodes[target].requires) { continue; }
    var st: Shape = if (which == 0) sa else sb;
    if (sa.equal(so) && sb.equal(so)) {
      var slot: GradSlot = g->grad_take(target);
      dispatch k_binary_back[spread(s, size), 256](n->op, which, slot.data, dy, pa, pb, size, if slot.fresh { 1 } else { 0 });
      continue;
    }
    var dst: float32* = g->grad_of(target);
    if (n->op == OP_ADD || n->op == OP_SUB) {
      var sign: float32 = if n->op == OP_SUB && which == 1 { (float32)-1.0 } else { (float32)1.0 };
      if (st.equal(so)) {
        dispatch k_add[spread(s, size), 256](dst, dy, sign, size);
        continue;
      }
      if (trailing_slice(st, so)) {
        var cols: int64 = st.size();
        column_sums(s, g, dst, (float32*)0, dy, (float32*)0, (float32*)0, (float32*)0, size / cols, cols, 0, sign);
        continue;
      }
    }
    var p: Bcast = bcast_record(so, sa, sb, n->op);
    p.which = which;
    var own: int64[6] = broadcast_strides(st, so);
    var running: int64 = 1;
    var d: int32 = so.rank - 1;
    while (d >= 0) {
      p.sd[d] = if own[d] == 0 { 0 } else { (int32)running };
      if (own[d] != 0) { running = running * so.dims[d]; }
      d = d - 1;
    }
    var count: int64 = st.size();
    dispatch k_bcast_back[cover(count), 256](p, dst, (int32)count, dy, pa, pb);
  }
}

fn fwd_unary(s: GpuState*, g: Graph*, id: int32) {
  var n: Node* = g->node(id);
  var size: int64 = n->value.shape.size();
  dispatch k_unary[spread(s, size), 256](n->op, n->value.data, g->data(n->a), n->f0, n->f1, size);
}

fn back_unary(s: GpuState*, g: Graph*, id: int32) {
  var n: Node* = g->node(id);
  if (!g->nodes[n->a].requires) { return; }
  var size: int64 = n->value.shape.size();
  var slot: GradSlot = g->grad_take(n->a);
  dispatch k_unary_back[spread(s, size), 256](n->op, slot.data, n->grad, g->data(n->a), n->value.data, n->f0, n->f1, size, if slot.fresh { 1 } else { 0 });
}

fn fwd_reduce(s: GpuState*, g: Graph*, id: int32) {
  var n: Node* = g->node(id);
  var xs: Shape = g->nodes[n->a].value.shape;
  var total: int64 = xs.size();
  if (n->op == OP_SUM_ALL || n->op == OP_MEAN_ALL) {
    var scale: float32 = if n->op == OP_MEAN_ALL { (float32)(1.0 / (float64)(if (total < 1) 1 else total)) } else { (float32)1.0 };
    if (total < 1) {
      g->dev->fill(n->value.data, 0.0, 1);
      return;
    }
    sum_into(s, n->value.data, g->data(n->a), (float32*)0, 0, total, scale, false);
    return;
  }
  var outer: int64 = 0;
  var len: int64 = 0;
  var inner: int64 = 0;
  split_axis(xs, (int32)n->i0, &outer, &len, &inner);
  var scale: float32 = if n->op == OP_MEAN { (float32)(1.0 / (float64)(if (len < 1) 1 else len)) } else { (float32)1.0 };
  dispatch k_reduce_axis[cover(outer * inner), 256](n->op, n->value.data, n->ints, g->data(n->a), (int32)outer, (int32)len, (int32)inner, scale);
}

fn back_reduce(s: GpuState*, g: Graph*, id: int32) {
  var n: Node* = g->node(id);
  if (!g->nodes[n->a].requires) { return; }
  var xs: Shape = g->nodes[n->a].value.shape;
  var total: int64 = xs.size();
  var dx: float32* = g->grad_of(n->a);
  if (n->op == OP_SUM_ALL || n->op == OP_MEAN_ALL) {
    var scale: float32 = if n->op == OP_MEAN_ALL { (float32)(1.0 / (float64)(if (total < 1) 1 else total)) } else { (float32)1.0 };
    dispatch k_spread[spread(s, total), 256](dx, n->grad, scale, total);
    return;
  }
  var outer: int64 = 0;
  var len: int64 = 0;
  var inner: int64 = 0;
  split_axis(xs, (int32)n->i0, &outer, &len, &inner);
  var scale: float32 = if n->op == OP_MEAN { (float32)(1.0 / (float64)(if (len < 1) 1 else len)) } else { (float32)1.0 };
  dispatch k_reduce_axis_back[cover(total), 256](n->op, dx, n->grad, n->ints, (int32)outer, (int32)len, (int32)inner, scale);
}

fn permute_record(s: Shape, a: int32, b: int32) -> Bcast {
  var p: Bcast;
  var in_strides: int64[6];
  var running: int64 = 1;
  var i: int32 = s.rank - 1;
  while (i >= 0) {
    in_strides[i] = running;
    running = running * s.dims[i];
    i = i - 1;
  }
  p.rank = s.rank;
  p.count = (int32)s.size();
  for d in 0..s.rank {
    var from: int32 = if d == a { b } else { if d == b { a } else { d } };
    p.dims[d] = (int32)s.dims[from];
    p.sa[d] = (int32)in_strides[from];
  }
  return p;
}

fn fwd_transpose(s: GpuState*, g: Graph*, id: int32) {
  var n: Node* = g->node(id);
  var xs: Shape = g->nodes[n->a].value.shape;
  var p: Bcast = permute_record(xs, (int32)n->i0, (int32)n->i1);
  dispatch k_permute[cover(xs.size()), 256](n->value.data, g->data(n->a), p, 0);
}

fn back_transpose(s: GpuState*, g: Graph*, id: int32) {
  var n: Node* = g->node(id);
  if (!g->nodes[n->a].requires) { return; }
  var ys: Shape = n->value.shape;
  var p: Bcast = permute_record(ys, (int32)n->i0, (int32)n->i1);
  var slot: GradSlot = g->grad_take(n->a);
  dispatch k_permute[cover(ys.size()), 256](slot.data, n->grad, p, if slot.fresh { 0 } else { 1 });
}

fn fwd_slice(s: GpuState*, g: Graph*, id: int32) {
  var n: Node* = g->node(id);
  var xs: Shape = g->nodes[n->a].value.shape;
  var outer: int64 = 0;
  var len: int64 = 0;
  var inner: int64 = 0;
  split_axis(xs, (int32)n->i0, &outer, &len, &inner);
  var width: int64 = n->i2 * inner;
  dispatch k_blocks[spread(s, outer * width), 256](n->value.data, g->data(n->a) + n->i1 * inner, outer, width, width, len * inner, 0);
}

fn back_slice(s: GpuState*, g: Graph*, id: int32) {
  var n: Node* = g->node(id);
  if (!g->nodes[n->a].requires) { return; }
  var xs: Shape = g->nodes[n->a].value.shape;
  var outer: int64 = 0;
  var len: int64 = 0;
  var inner: int64 = 0;
  split_axis(xs, (int32)n->i0, &outer, &len, &inner);
  var width: int64 = n->i2 * inner;
  dispatch k_blocks[spread(s, outer * width), 256](g->grad_of(n->a) + n->i1 * inner, n->grad, outer, width, len * inner, width, 1);
}

fn fwd_concat(s: GpuState*, g: Graph*, id: int32) {
  var n: Node* = g->node(id);
  var sa: Shape = g->nodes[n->a].value.shape;
  var outer: int64 = 0;
  var la: int64 = 0;
  var inner: int64 = 0;
  split_axis(sa, (int32)n->i0, &outer, &la, &inner);
  var lb: int64 = g->nodes[n->b].value.shape.dims[(int32)n->i0];
  var row: int64 = (la + lb) * inner;
  dispatch k_blocks[spread(s, outer * la * inner), 256](n->value.data, g->data(n->a), outer, la * inner, row, la * inner, 0);
  dispatch k_blocks[spread(s, outer * lb * inner), 256](n->value.data + la * inner, g->data(n->b), outer, lb * inner, row, lb * inner, 0);
}

fn back_concat(s: GpuState*, g: Graph*, id: int32) {
  var n: Node* = g->node(id);
  var sa: Shape = g->nodes[n->a].value.shape;
  var outer: int64 = 0;
  var la: int64 = 0;
  var inner: int64 = 0;
  split_axis(sa, (int32)n->i0, &outer, &la, &inner);
  var lb: int64 = g->nodes[n->b].value.shape.dims[(int32)n->i0];
  var row: int64 = (la + lb) * inner;
  if (g->nodes[n->a].requires) {
    var slot: GradSlot = g->grad_take(n->a);
    dispatch k_blocks[spread(s, outer * la * inner), 256](slot.data, n->grad, outer, la * inner, la * inner, row, if slot.fresh { 0 } else { 1 });
  }
  if (g->nodes[n->b].requires) {
    var slot: GradSlot = g->grad_take(n->b);
    dispatch k_blocks[spread(s, outer * lb * inner), 256](slot.data, n->grad + la * inner, outer, lb * inner, lb * inner, row, if slot.fresh { 0 } else { 1 });
  }
}

kernel(block = 256) k_small_mm(c: float32*, a: float32*, b: float32*, z: int64, m: int64, n: int64, k: int64, ta: int32, tb: int32, add: int32) {
  var i: int64 = (int64)block.x * 256 + (int64)thread.x;
  var step: int64 = (int64)grid_dim.x * 256;
  var plane: int64 = m * n;
  var rise: int64 = if ta != 0 { m } else { 1 };
  var run: int64 = if tb != 0 { 1 } else { n };
  while (i < z * plane) {
    var q: int64 = i / plane;
    var rc: int64 = i - q * plane;
    var r: int64 = rc / n;
    var col: int64 = rc - r * n;
    var pa: float32* = if ta != 0 { a + q * k * m + r } else { a + (q * m + r) * k };
    var pb: float32* = if tb != 0 { b + (q * n + col) * k } else { b + q * k * n + col };
    var sum: float32 = z32();
    for j: int64 in 0..k { sum = sum + pa[j * rise] * pb[j * run]; }
    if (add != 0) { c[i] = c[i] + sum; } else { c[i] = sum; }
    i = i + step;
  }
}

const SMALL_MM: int64 = 100000000;
const SMALL_ONE: int64 = 200000;

fn small_mm(s: GpuState*, c: float32*, a: float32*, b: float32*, z: int64, m: int64, n: int64, k: int64, ta: bool, tb: bool, add: bool) {
  dispatch k_small_mm[spread(s, z * m * n), 256](c, a, b, z, m, n, k, if ta { 1 } else { 0 }, if tb { 1 } else { 0 }, if add { 1 } else { 0 });
}

fn fwd_matmul(s: GpuState*, g: Graph*, id: int32) {
  var n: Node* = g->node(id);
  var trans_b: bool = n->op == OP_MATMUL_NT;
  var sa: Shape = g->nodes[n->a].value.shape;
  var sb: Shape = g->nodes[n->b].value.shape;
  var m: int64 = sa.dims[sa.rank - 2];
  var k: int64 = sa.dims[sa.rank - 1];
  var cols: int64 = if trans_b { sb.dims[sb.rank - 2] } else { sb.dims[sb.rank - 1] };
  var ldb: int64 = if trans_b { k } else { cols };
  if (n->i0 == 0) {
    var rows: int64 = sa.size() / (if (k < 1) 1 else k);
    var flat: GemmShape = gemm_shape(g->data(n->a), g->data(n->b), n->value.data, rows, cols, k, k, ldb, cols, false, trans_b, false);
    flat.exact = n->i2 != 0;
    run_gemm(s, g, flat);
    return;
  }
  if (batch_of(sa) * m * cols * k <= SMALL_MM && m * cols * k <= SMALL_ONE) {
    small_mm(s, n->value.data, g->data(n->a), g->data(n->b), batch_of(sa), m, cols, k, false, trans_b, false);
    return;
  }
  var q: GemmShape = gemm_shape(g->data(n->a), g->data(n->b), n->value.data, m, cols, k, k, ldb, cols, false, trans_b, false);
  q.inner = batch_of(sa);
  q.sa_inner = m * k;
  q.sb_inner = k * cols;
  q.sc_inner = m * cols;
  q.exact = n->i2 != 0;
  run_gemm(s, g, q);
}

fn back_matmul(s: GpuState*, g: Graph*, id: int32) {
  var n: Node* = g->node(id);
  var trans_b: bool = n->op == OP_MATMUL_NT;
  var sa: Shape = g->nodes[n->a].value.shape;
  var sb: Shape = g->nodes[n->b].value.shape;
  var m: int64 = sa.dims[sa.rank - 2];
  var k: int64 = sa.dims[sa.rank - 1];
  var cols: int64 = if trans_b { sb.dims[sb.rank - 2] } else { sb.dims[sb.rank - 1] };
  var batched: bool = n->i0 == 1;
  var rows: int64 = if batched { m } else { sa.size() / (if (k < 1) 1 else k) };
  var z: int64 = if batched { batch_of(sa) } else { 1 };
  var pa: float32* = g->data(n->a);
  var pb: float32* = g->data(n->b);
  var dc: float32* = n->grad;
  if (batched && z * rows * cols * k <= SMALL_MM && rows * cols * k <= SMALL_ONE) {
    if (g->nodes[n->a].requires) {
      var slot: GradSlot = g->grad_take(n->a);
      small_mm(s, slot.data, dc, pb, z, rows, k, cols, false, !trans_b, !slot.fresh);
    }
    if (g->nodes[n->b].requires) {
      var slot: GradSlot = g->grad_take(n->b);
      if (trans_b) {
        small_mm(s, slot.data, dc, pa, z, cols, k, rows, true, false, !slot.fresh);
      } else {
        small_mm(s, slot.data, pa, dc, z, k, cols, rows, true, false, !slot.fresh);
      }
    }
    return;
  }
  if (g->nodes[n->a].requires) {
    var slot: GradSlot = g->grad_take(n->a);
    var q: GemmShape = if trans_b {
      gemm_shape(dc, pb, slot.data, rows, k, cols, cols, k, k, false, false, !slot.fresh)
    } else {
      gemm_shape(dc, pb, slot.data, rows, k, cols, cols, cols, k, false, true, !slot.fresh)
    };
    q.inner = z;
    q.sa_inner = rows * cols;
    q.sb_inner = k * cols;
    q.sc_inner = rows * k;
    q.exact = n->i2 != 0;
    run_gemm(s, g, q);
  }
  if (g->nodes[n->b].requires) {
    var slot: GradSlot = g->grad_take(n->b);
    var q: GemmShape = if trans_b {
      gemm_shape(dc, pa, slot.data, cols, k, rows, cols, k, k, true, false, !slot.fresh)
    } else {
      gemm_shape(pa, dc, slot.data, k, cols, rows, k, cols, cols, true, false, !slot.fresh)
    };
    q.inner = z;
    q.sa_inner = if trans_b { rows * cols } else { rows * k };
    q.sb_inner = if trans_b { rows * k } else { rows * cols };
    q.sc_inner = k * cols;
    q.exact = n->i2 != 0;
    run_gemm(s, g, q);
  }
}

fn fwd_linear(s: GpuState*, g: Graph*, id: int32) {
  var n: Node* = g->node(id);
  var sx: Shape = g->nodes[n->a].value.shape;
  var k: int64 = sx.last();
  var cols: int64 = g->nodes[n->b].value.shape.dims[0];
  var rows: int64 = sx.size() / (if (k < 1) 1 else k);
  var q: GemmShape = gemm_shape(g->data(n->a), g->data(n->b), n->value.data, rows, cols, k, k, k, cols, false, true, false);
  if (n->c >= 0) { q.bias = g->data(n->c); }
  run_gemm(s, g, q);
}

fn column_sums(s: GpuState*, g: Graph*, dst_a: float32*, dst_b: float32*, src: float32*, x: float32*, mean: float32*, rstd: float32*, rows: int64, cols: int64, mode: int32, scale: float32) {
  var slabs: int64 = (rows + 255) / 256;
  if (slabs < 1 || cols < 1) { return; }
  var partial_a: float32* = g->floats(slabs * cols);
  var partial_b: float32* = if dst_b != 0 { g->floats(slabs * cols) } else { (float32*)0 };
  var gx: int32 = (int32)((cols + 31) / 32);
  dispatch k_column_partials[grid: (gx, (int32)slabs, 1), block: (256, 1, 1)](src, x, mean, rstd, (int32)rows, (int32)cols, mode, partial_a, partial_b);
  var tx: int32 = (int32)((cols + 255) / 256);
  if (dst_a != 0) { dispatch k_column_total[tx, 256](partial_a, (int32)slabs, (int32)cols, dst_a, scale); }
  if (dst_b != 0) { dispatch k_column_total[tx, 256](partial_b, (int32)slabs, (int32)cols, dst_b, scale); }
}

fn back_linear(s: GpuState*, g: Graph*, id: int32) {
  var n: Node* = g->node(id);
  var sx: Shape = g->nodes[n->a].value.shape;
  var k: int64 = sx.last();
  var cols: int64 = g->nodes[n->b].value.shape.dims[0];
  var rows: int64 = sx.size() / (if (k < 1) 1 else k);
  var dc: float32* = n->grad;
  if (g->nodes[n->a].requires) {
    var slot: GradSlot = g->grad_take(n->a);
    run_gemm(s, g, gemm_shape(dc, g->data(n->b), slot.data, rows, k, cols, cols, k, k, false, false, !slot.fresh));
  }
  if (g->nodes[n->b].requires) {
    var wslot: GradSlot = g->grad_take(n->b);
    run_gemm(s, g, gemm_shape(dc, g->data(n->a), wslot.data, cols, k, rows, cols, k, k, true, false, !wslot.fresh));
  }
  if (n->c >= 0 && g->nodes[n->c].requires) {
    column_sums(s, g, g->grad_of(n->c), (float32*)0, dc, (float32*)0, (float32*)0, (float32*)0, rows, cols, 0, 1.0);
  }
}

fn fwd_softmax(s: GpuState*, g: Graph*, id: int32) {
  var n: Node* = g->node(id);
  var sh: Shape = n->value.shape;
  var kind: int32 = if n->op == OP_LOG_SOFTMAX { 1 } else { if n->op == OP_CAUSAL_SOFTMAX { 2 } else { 0 } };
  var q_len: int64 = if sh.rank >= 2 { sh.dims[sh.rank - 2] } else { 1 };
  var rows: int64 = sh.rows();
  dispatch k_softmax[row_blocks(rows), 256](kind, n->value.data, g->data(n->a), (int32)rows, (int32)sh.last(), (int32)q_len, (int32)sh.last());
}

fn back_softmax(s: GpuState*, g: Graph*, id: int32) {
  var n: Node* = g->node(id);
  if (!g->nodes[n->a].requires) { return; }
  var sh: Shape = n->value.shape;
  var kind: int32 = if n->op == OP_LOG_SOFTMAX { 1 } else { 0 };
  var rows: int64 = sh.rows();
  dispatch k_softmax_back[row_blocks(rows), 256](kind, g->grad_of(n->a), n->grad, n->value.data, (int32)rows, (int32)sh.last(), 1.0, 1);
}

fn fwd_cross_entropy(s: GpuState*, g: Graph*, id: int32) {
  var n: Node* = g->node(id);
  var sh: Shape = g->nodes[n->a].value.shape;
  var rows: int64 = sh.rows();
  var cols: int64 = sh.last();
  dispatch k_xent[row_blocks(rows), 256](n->saved, n->saved2, g->data(n->a), n->ints, (int32)rows, (int32)cols, n->f0);
  var counted: int64 = if n->i0 < 1 { 1 } else { n->i0 };
  sum_into(s, n->value.data, n->saved2, (float32*)0, 0, rows, (float32)(1.0 / (float64)counted), false);
}

fn back_cross_entropy(s: GpuState*, g: Graph*, id: int32) {
  var n: Node* = g->node(id);
  if (!g->nodes[n->a].requires) { return; }
  var sh: Shape = g->nodes[n->a].value.shape;
  var rows: int64 = sh.rows();
  var cols: int64 = sh.last();
  var counted: int64 = if n->i0 < 1 { 1 } else { n->i0 };
  dispatch k_xent_back[cover(rows * cols), 256](g->grad_of(n->a), n->saved, n->ints, n->grad, (int32)rows, (int32)cols, (int32)counted, n->f0);
}

fn fwd_pair_loss(s: GpuState*, g: Graph*, id: int32) {
  var n: Node* = g->node(id);
  var size: int64 = g->nodes[n->a].value.shape.size();
  var mode: int32 = if n->op == OP_MSE { 2 } else { 3 };
  sum_into(s, n->value.data, g->data(n->a), g->data(n->b), mode, size, (float32)(1.0 / (float64)(if (size < 1) 1 else size)), false);
}

fn back_pair_loss(s: GpuState*, g: Graph*, id: int32) {
  var n: Node* = g->node(id);
  var size: int64 = g->nodes[n->a].value.shape.size();
  var scale: float32 = (float32)(1.0 / (float64)(if (size < 1) 1 else size));
  var pa: float32* = g->data(n->a);
  var pb: float32* = g->data(n->b);
  var mode: int32 = if n->op == OP_MSE { 2 } else { 3 };
  if (g->nodes[n->a].requires) {
    dispatch k_pair_back[spread(s, size), 256](mode, g->grad_of(n->a), pa, pb, n->grad, scale, 1.0, size);
  }
  if (g->nodes[n->b].requires) {
    dispatch k_pair_back[spread(s, size), 256](mode, g->grad_of(n->b), pa, pb, n->grad, scale, -1.0, size);
  }
}

fn fwd_norm(s: GpuState*, g: Graph*, id: int32) {
  var n: Node* = g->node(id);
  var sh: Shape = n->value.shape;
  var rows: int64 = sh.rows();
  var gamma: float32* = if n->b >= 0 { g->data(n->b) } else { (float32*)0 };
  var beta: float32* = if n->c >= 0 { g->data(n->c) } else { (float32*)0 };
  var rms: int32 = if n->op == OP_RMS_NORM { 1 } else { 0 };
  dispatch k_norm[row_blocks(rows), 256](rms, n->value.data, g->data(n->a), gamma, beta, n->saved, n->saved2, (int32)rows, (int32)sh.last(), n->f0);
}

fn back_norm(s: GpuState*, g: Graph*, id: int32) {
  var n: Node* = g->node(id);
  var sh: Shape = n->value.shape;
  var rows: int64 = sh.rows();
  var cols: int64 = sh.last();
  var rms: int32 = if n->op == OP_RMS_NORM { 1 } else { 0 };
  var gamma: float32* = if n->b >= 0 { g->data(n->b) } else { (float32*)0 };
  var x: float32* = g->data(n->a);
  if (g->nodes[n->a].requires) {
    var slot: GradSlot = g->grad_take(n->a);
    dispatch k_norm_back[row_blocks(rows), 256](rms, slot.data, n->grad, x, gamma, n->saved, n->saved2, (int32)rows, (int32)cols, if slot.fresh { 1 } else { 0 });
  }
  var dgamma: float32* = if n->b >= 0 && g->nodes[n->b].requires { g->grad_of(n->b) } else { (float32*)0 };
  var dbeta: float32* = if n->c >= 0 && g->nodes[n->c].requires { g->grad_of(n->c) } else { (float32*)0 };
  if (dgamma != 0) {
    column_sums(s, g, dgamma, dbeta, n->grad, x, n->saved, n->saved2, rows, cols, if rms == 1 { 2 } else { 1 }, 1.0);
  } else if (dbeta != 0) {
    column_sums(s, g, dbeta, (float32*)0, n->grad, x, n->saved, n->saved2, rows, cols, 0, 1.0);
  }
}

fn drop_into(s: GpuState*, dst: float32*, src: float32*, n: int64, key: uint64, p: float32, accumulate: bool) {
  var threshold: uint64 = drop_threshold((float64)p);
  var keep: float32 = (float32)(1.0 / (1.0 - (float64)p));
  dispatch k_dropout[spread(s, n), 256](dst, src, n, key, threshold, keep, if accumulate { 1 } else { 0 });
}

fn fwd_dropout(s: GpuState*, g: Graph*, id: int32) {
  var n: Node* = g->node(id);
  drop_into(s, n->value.data, g->data(n->a), n->value.shape.size(), (uint64)n->i0, n->f0, false);
}

fn back_dropout(s: GpuState*, g: Graph*, id: int32) {
  var n: Node* = g->node(id);
  if (!g->nodes[n->a].requires) { return; }
  drop_into(s, g->grad_of(n->a), n->grad, n->value.shape.size(), (uint64)n->i0, n->f0, true);
}

kernel(block = 256) k_take_last(dst: float32*, x: float32*, ids: int32*, rows: int64, m: int64, l: int64, picks: int64, add: int32) {
  var i: int64 = (int64)block.x * 256 + (int64)thread.x;
  var step: int64 = (int64)grid_dim.x * 256;
  while (i < rows * m * picks) {
    var k: int64 = i % picks;
    var rj: int64 = i / picks;
    var at: int64 = (int64)ids[(rj / m) * picks + k];
    var v: float32 = z32();
    if (at < l) { v = x[rj * l + at]; }
    if (add != 0) { dst[i] = dst[i] + v; } else { dst[i] = v; }
    i = i + step;
  }
}

kernel(block = 256) k_spread_last(dst: float32*, x: float32*, ids: int32*, rows: int64, m: int64, l: int64, picks: int64, add: int32) {
  var i: int64 = (int64)block.x * 256 + (int64)thread.x;
  var step: int64 = (int64)grid_dim.x * 256;
  while (i < rows * m * l) {
    var at: int64 = i % l;
    var rj: int64 = i / l;
    var base: int64 = (rj / m) * picks;
    var sum: float32 = z32();
    for k: int64 in 0..picks {
      if ((int64)ids[base + k] == at) { sum = sum + x[rj * picks + k]; }
    }
    if (add != 0) { dst[i] = dst[i] + sum; } else { dst[i] = sum; }
    i = i + step;
  }
}

fn fwd_take(s: GpuState*, g: Graph*, id: int32) {
  var n: Node* = g->node(id);
  var sx: Shape = g->nodes[n->a].value.shape;
  var picks: int64 = n->value.shape.last();
  dispatch k_take_last[spread(s, n->value.shape.size()), 256](n->value.data, g->data(n->a), n->ints, sx.dims[0], sx.dims[1], sx.dims[2], picks, 0);
}

fn back_take(s: GpuState*, g: Graph*, id: int32) {
  var n: Node* = g->node(id);
  if (!g->nodes[n->a].requires) { return; }
  var sx: Shape = g->nodes[n->a].value.shape;
  var picks: int64 = n->value.shape.last();
  var slot: GradSlot = g->grad_take(n->a);
  dispatch k_spread_last[spread(s, sx.size()), 256](slot.data, n->grad, n->ints, sx.dims[0], sx.dims[1], sx.dims[2], picks, if slot.fresh { 0 } else { 1 });
}

fn fwd_spread(s: GpuState*, g: Graph*, id: int32) {
  var n: Node* = g->node(id);
  var sx: Shape = g->nodes[n->a].value.shape;
  var width: int64 = n->value.shape.last();
  dispatch k_spread_last[spread(s, n->value.shape.size()), 256](n->value.data, g->data(n->a), n->ints, sx.dims[0], sx.dims[1], width, sx.dims[2], 0);
}

fn back_spread(s: GpuState*, g: Graph*, id: int32) {
  var n: Node* = g->node(id);
  if (!g->nodes[n->a].requires) { return; }
  var sx: Shape = g->nodes[n->a].value.shape;
  var width: int64 = n->value.shape.last();
  var slot: GradSlot = g->grad_take(n->a);
  dispatch k_take_last[spread(s, sx.size()), 256](slot.data, n->grad, n->ints, sx.dims[0], sx.dims[1], width, sx.dims[2], if slot.fresh { 0 } else { 1 });
}

fn fwd_fold(s: GpuState*, g: Graph*, id: int32) {
  var n: Node* = g->node(id);
  var width: int64 = n->value.shape.last();
  var classes: int64 = n->value.shape.dims[0];
  var count: int64 = g->nodes[n->a].value.shape.dims[0];
  var order: int32* = (int32*)n->ext;
  g->dev->fill(n->value.data, 0.0, classes * width);
  dispatch k_scatter[spread(s, classes * width), 256](n->value.data, g->data(n->a), order, order + count, classes, width);
}

fn back_fold(s: GpuState*, g: Graph*, id: int32) {
  var n: Node* = g->node(id);
  if (!g->nodes[n->a].requires) { return; }
  var width: int64 = n->value.shape.last();
  var count: int64 = g->nodes[n->a].value.shape.dims[0];
  var slot: GradSlot = g->grad_take(n->a);
  if (slot.fresh) {
    dispatch k_gather[spread(s, count * width), 256](slot.data, n->grad, n->ints, count, width);
    return;
  }
  var held: float32* = g->floats(count * width);
  dispatch k_gather[spread(s, count * width), 256](held, n->grad, n->ints, count, width);
  dispatch k_add[spread(s, count * width), 256](slot.data, held, (float32)1.0, count * width);
}

fn fwd_gather(s: GpuState*, g: Graph*, id: int32) {
  var n: Node* = g->node(id);
  var width: int64 = n->value.shape.last();
  var count: int64 = n->value.shape.rows();
  dispatch k_gather[spread(s, count * width), 256](n->value.data, g->data(n->a), n->ints, count, width);
}

fn back_gather(s: GpuState*, g: Graph*, id: int32) {
  var n: Node* = g->node(id);
  if (!g->nodes[n->a].requires) { return; }
  var width: int64 = n->value.shape.last();
  var count: int64 = n->value.shape.rows();
  var vocab: int64 = g->nodes[n->a].value.shape.dims[0];
  var order: int32* = (int32*)n->ext;
  dispatch k_scatter[spread(s, vocab * width), 256](g->grad_of(n->a), n->grad, order, order + count, vocab, width);
}

fn attn_gemm(a: float32*, lda: int64, sa_outer: int64, sa_inner: int64, ta: bool, b: float32*, ldb: int64, sb_outer: int64, sb_inner: int64, tb: bool, c: float32*, ldc: int64, sc_outer: int64, sc_inner: int64, m: int64, n: int64, k: int64, outer: int64, inner: int64, alpha: float32, accumulate: bool) -> GemmShape {
  var q: GemmShape = gemm_shape(a, b, c, m, n, k, lda, ldb, ldc, ta, tb, accumulate);
  q.alpha = alpha;
  q.outer = outer;
  q.inner = inner;
  q.sa_outer = sa_outer;
  q.sa_inner = sa_inner;
  q.sb_outer = sb_outer;
  q.sb_inner = sb_inner;
  q.sc_outer = sc_outer;
  q.sc_inner = sc_inner;
  return q;
}

fn flash_parts(hd: int64) -> int64 {
  if (hd == 32) { return 1; }
  if (hd == 64) { return 2; }
  if (hd == 128) { return 4; }
  return 0;
}

fn flash_record(g: Graph*, n: Node*) -> Flash {
  var sh: Shape = g->nodes[n->a].value.shape;
  var width: int64 = sh.dims[2] / 3;
  var f: Flash;
  f.qkv = g->data(n->a);
  f.out = n->value.data;
  f.lse = n->saved;
  f.dout = (float32*)0;
  f.dqkv = (float32*)0;
  f.delta = (float32*)0;
  f.time = (int32)sh.dims[1];
  f.width = (int32)width;
  f.heads = (int32)n->i0;
  f.causal = (int32)n->i1;
  f.scale = (float32)(1.0 / sqrt((float64)(width / n->i0)));
  f.dropping = (int32)n->i2;
  f.key = (uint64)n->i3;
  f.threshold = drop_threshold((float64)n->f0);
  f.keep = (float32)(1.0 / (1.0 - (float64)n->f0));
  return f;
}

fn fwd_attention(s: GpuState*, g: Graph*, id: int32) {
  var n: Node* = g->node(id);
  var sh: Shape = g->nodes[n->a].value.shape;
  var batch: int64 = sh.dims[0];
  var time: int64 = sh.dims[1];
  var width: int64 = sh.dims[2] / 3;
  var heads: int64 = n->i0;
  var hd: int64 = width / heads;
  var parts: int64 = flash_parts(hd);
  var qkv: float32* = g->data(n->a);
  if (s->matmul == MATMUL_BF16 && n->i2 == 0 && (hd == 32 || hd == 64)) {
    n->saved = g->floats(batch * heads * time);
    n->i4 = 2;
    var gx: int32 = (int32)((time + 63) / 64);
    var gy: int32 = (int32)(batch * heads);
    var sc: float32 = (float32)(1.0 / sqrt((float64)hd));
    if (hd == 32) { dispatch k_tflash_fwd_32[grid: (gx, gy, 1), block: (128, 1, 1)](qkv, n->value.data, n->saved, (int32)time, (int32)width, (int32)heads, (int32)n->i1, sc); }
    if (hd == 64) { dispatch k_tflash_fwd_64[grid: (gx, gy, 1), block: (128, 1, 1)](qkv, n->value.data, n->saved, (int32)time, (int32)width, (int32)heads, (int32)n->i1, sc); }
    return;
  }
  if (parts > 0) {
    n->saved = g->floats(batch * heads * time);
    n->i4 = 1;
    var f: Flash = flash_record(g, n);
    var gx: int32 = (int32)((time * parts + 127) / 128);
    var gy: int32 = (int32)(batch * heads);
    if (hd == 32) { dispatch k_flash_fwd_32[grid: (gx, gy, 1), block: (128, 1, 1)](f); }
    if (hd == 64) { dispatch k_flash_fwd_64[grid: (gx, gy, 1), block: (128, 1, 1)](f); }
    if (hd == 128) { dispatch k_flash_fwd_128[grid: (gx, gy, 1), block: (128, 1, 1)](f); }
    return;
  }
  n->saved = g->floats(batch * heads * time * time);
  n->i4 = 0;
  var scale: float32 = (float32)(1.0 / sqrt((float64)hd));
  var probs: float32* = n->saved;
  var row: int64 = 3 * width;
  var seq: int64 = time * row;
  var square: int64 = time * time;
  run_gemm(s, g, attn_gemm(qkv, row, seq, hd, false, qkv + width, row, seq, hd, true, probs, time, heads * square, square, time, time, hd, batch, heads, scale, false));
  var kind: int32 = if n->i1 == 1 { 2 } else { 0 };
  var rows: int64 = batch * heads * time;
  dispatch k_softmax[row_blocks(rows), 256](kind, probs, probs, (int32)rows, (int32)time, (int32)time, (int32)time);
  var used: float32* = probs;
  if (n->i2 == 1) {
    used = g->floats(rows * time);
    drop_into(s, used, probs, rows * time, (uint64)n->i3, n->f0, false);
  }
  run_gemm(s, g, attn_gemm(used, time, heads * square, square, false, qkv + 2 * width, row, seq, hd, false, n->value.data, width, time * width, hd, time, hd, time, batch, heads, 1.0, false));
}

fn back_attention(s: GpuState*, g: Graph*, id: int32) {
  var n: Node* = g->node(id);
  if (!g->nodes[n->a].requires) { return; }
  var sh: Shape = g->nodes[n->a].value.shape;
  var batch: int64 = sh.dims[0];
  var time: int64 = sh.dims[1];
  var width: int64 = sh.dims[2] / 3;
  var heads: int64 = n->i0;
  var hd: int64 = width / heads;
  if (n->i4 == 2) {
    var delta: float32* = g->floats(batch * heads * time);
    var gx: int32 = (int32)((time + 63) / 64);
    var gy: int32 = (int32)(batch * heads);
    var sc: float32 = (float32)(1.0 / sqrt((float64)hd));
    var qkv: float32* = g->data(n->a);
    var slot: GradSlot = g->grad_take(n->a);
    var dqkv: float32* = slot.data;
    var fresh: int32 = if slot.fresh { 1 } else { 0 };
    if (hd == 32) {
      dispatch k_tflash_dq_32[grid: (gx, gy, 1), block: (128, 1, 1)](qkv, n->value.data, n->saved, n->grad, dqkv, delta, (int32)time, (int32)width, (int32)heads, (int32)n->i1, sc, fresh);
      dispatch k_tflash_dkv_32[grid: (gx, gy, 1), block: (128, 1, 1)](qkv, n->saved, n->grad, dqkv, delta, (int32)time, (int32)width, (int32)heads, (int32)n->i1, sc, fresh);
    }
    if (hd == 64) {
      dispatch k_tflash_dq_64[grid: (gx, gy, 1), block: (128, 1, 1)](qkv, n->value.data, n->saved, n->grad, dqkv, delta, (int32)time, (int32)width, (int32)heads, (int32)n->i1, sc, fresh);
      dispatch k_tflash_dkv_64[grid: (gx, gy, 1), block: (128, 1, 1)](qkv, n->saved, n->grad, dqkv, delta, (int32)time, (int32)width, (int32)heads, (int32)n->i1, sc, fresh);
    }
    return;
  }
  if (n->i4 == 1) {
    var f: Flash = flash_record(g, n);
    f.dout = n->grad;
    f.dqkv = g->grad_of(n->a);
    f.delta = g->floats(batch * heads * time);
    var parts: int64 = flash_parts(hd);
    var gx: int32 = (int32)((time * parts + 127) / 128);
    var gy: int32 = (int32)(batch * heads);
    if (hd == 32) {
      dispatch k_flash_dq_32[grid: (gx, gy, 1), block: (128, 1, 1)](f);
      dispatch k_flash_dkv_32[grid: (gx, gy, 1), block: (128, 1, 1)](f);
    }
    if (hd == 64) {
      dispatch k_flash_dq_64[grid: (gx, gy, 1), block: (128, 1, 1)](f);
      dispatch k_flash_dkv_64[grid: (gx, gy, 1), block: (128, 1, 1)](f);
    }
    if (hd == 128) {
      dispatch k_flash_dq_128[grid: (gx, gy, 1), block: (128, 1, 1)](f);
      dispatch k_flash_dkv_128[grid: (gx, gy, 1), block: (128, 1, 1)](f);
    }
    return;
  }
  var scale: float32 = (float32)(1.0 / sqrt((float64)hd));
  var qkv: float32* = g->data(n->a);
  var dqkv: float32* = g->grad_of(n->a);
  var probs: float32* = n->saved;
  var dout: float32* = n->grad;
  var row: int64 = 3 * width;
  var seq: int64 = time * row;
  var square: int64 = time * time;
  var rows: int64 = batch * heads * time;
  var dp: float32* = g->floats(rows * time);
  run_gemm(s, g, attn_gemm(dout, width, time * width, hd, false, qkv + 2 * width, row, seq, hd, true, dp, time, heads * square, square, time, time, hd, batch, heads, 1.0, false));
  var used: float32* = probs;
  if (n->i2 == 1) {
    drop_into(s, dp, dp, rows * time, (uint64)n->i3, n->f0, false);
    used = g->floats(rows * time);
    drop_into(s, used, probs, rows * time, (uint64)n->i3, n->f0, false);
  }
  dispatch k_softmax_back[row_blocks(rows), 256](0, dp, dp, probs, (int32)rows, (int32)time, scale, 0);
  run_gemm(s, g, attn_gemm(dp, time, heads * square, square, false, qkv + width, row, seq, hd, false, dqkv, row, seq, hd, time, hd, time, batch, heads, 1.0, true));
  run_gemm(s, g, attn_gemm(dp, time, heads * square, square, true, qkv, row, seq, hd, false, dqkv + width, row, seq, hd, time, hd, time, batch, heads, 1.0, true));
  run_gemm(s, g, attn_gemm(used, time, heads * square, square, true, dout, width, time * width, hd, false, dqkv + 2 * width, row, seq, hd, time, hd, time, batch, heads, 1.0, true));
}

fn fwd_cached_attention(s: GpuState*, g: Graph*, id: int32) {
  var n: Node* = g->node(id);
  var width: int64 = n->value.shape.last();
  var heads: int64 = n->i0;
  var scale: float32 = (float32)(1.0 / sqrt((float64)(width / heads)));
  dispatch k_decode[(int32)heads, 128](g->data(n->a), (float32*)n->ext, n->saved, n->value.data, n->saved2, (int32)n->i1, (int32)width, (int32)heads, scale);
}

kernel(block = 256) k_recall_prep(kn: float32*, qn: float32*, vg: float32*, norms: float32*, kv: float32*, q: float32*, gate: float32*, rows: int64, chunk: int64, width: int32, heads: int32, gated: int32) {
  var w: int64 = (int64)block.x * 8 + (int64)(thread.x / 32);
  var lane: int32 = (int32)subgroup_local_id();
  var total: int64 = rows * (int64)heads;
  if (w >= total) { return; }
  var r: int64 = w / (int64)heads;
  var h: int32 = (int32)(w - r * (int64)heads);
  var d: int32 = width / heads;
  var key: int64 = r * (int64)(2 * width) + (int64)(h * d);
  var ask: int64 = r * (int64)width + (int64)(h * d);
  var flat: int64 = (((r / chunk) * (int64)heads + (int64)h) * chunk + r % chunk) * (int64)d;
  var sk: float32 = z32();
  var sq: float32 = z32();
  var i: int32 = lane;
  while (i < d) {
    var a: float32 = kv[key + (int64)i];
    var b: float32 = q[ask + (int64)i];
    sk = sk + a * a;
    sq = sq + b * b;
    i = i + 32;
  }
  var rk: float32 = rsqrtf(subgroup_reduce_add(sk) / (float32)d + (float32)1.0e-6);
  var rq: float32 = rsqrtf(subgroup_reduce_add(sq) / (float32)d + (float32)1.0e-6);
  var rate: float32 = one32();
  if (gated != 0) { rate = one32() / (one32() + expf(-gate[w])); }
  if (lane == 0) {
    norms[w] = rk;
    norms[total + w] = rq;
    norms[2 * total + w] = rate;
  }
  i = lane;
  while (i < d) {
    kn[flat + (int64)i] = kv[key + (int64)i] * rk;
    qn[flat + (int64)i] = q[ask + (int64)i] * rq;
    vg[flat + (int64)i] = kv[key + (int64)(width + i)] * rate;
    i = i + 32;
  }
}

kernel(block = 256) k_recall_fade(scores: float32*, powers: float32*, count: int64, heads: int64, chunk: int64, shrink: float32) {
  var id: int64 = (int64)block.x * 256 + (int64)thread.x;
  var step: int64 = (int64)grid_dim.x * 256;
  while (id < count) {
    var from: int64 = id % chunk;
    var to: int64 = (id / chunk) % chunk;
    var h: int64 = (id / (chunk * chunk)) % heads;
    if (from > to) {
      scores[id] = z32();
    } else {
      scores[id] = scores[id] * shrink * powers[h * (chunk + 1) + to - from];
    }
    id = id + step;
  }
}

kernel(block = 256) k_recall_rows(dst: float32*, src: float32*, powers: float32*, count: int64, heads: int64, chunk: int64, dim: int64, tail: int32, scale: float32, accumulate: int32) {
  var id: int64 = (int64)block.x * 256 + (int64)thread.x;
  var step: int64 = (int64)grid_dim.x * 256;
  while (id < count) {
    var row: int64 = id / dim;
    var at: int64 = row % chunk;
    var h: int64 = (row / chunk) % heads;
    var power: int64 = at + 1;
    if (tail != 0) { power = chunk - 1 - at; }
    var v: float32 = src[id] * scale * powers[h * (chunk + 1) + power];
    if (accumulate != 0) { dst[id] = dst[id] + v; } else { dst[id] = v; }
    id = id + step;
  }
}

kernel(block = 256) k_recall_chain(dst: float32*, src: float32*, far: float32*, count: int64, chunks: int64, heads: int64, plane: int64, back: int32) {
  var id: int64 = (int64)block.x * 256 + (int64)thread.x;
  var step: int64 = (int64)grid_dim.x * 256;
  var span: int64 = heads * plane;
  while (id < count) {
    var h: int64 = (id / plane) % heads;
    var c: int64 = (id / span) % chunks;
    var base: int64 = id - c * span;
    var acc: float32 = z32();
    if (back == 0) {
      var from: int64 = 0;
      while (from < c) {
        acc = acc + far[h * chunks + c - 1 - from] * src[base + from * span];
        from = from + 1;
      }
    } else {
      var to: int64 = c + 1;
      while (to < chunks) {
        acc = acc + far[h * chunks + to - 1 - c] * src[base + to * span];
        to = to + 1;
      }
    }
    dst[id] = acc;
    id = id + step;
  }
}

kernel(block = 256) k_recall_move(flat: float32*, wide: float32*, count: int64, chunk: int64, width: int64, heads: int64, to_flat: int32) {
  var id: int64 = (int64)block.x * 256 + (int64)thread.x;
  var step: int64 = (int64)grid_dim.x * 256;
  var d: int64 = width / heads;
  while (id < count) {
    var r: int64 = id / width;
    var col: int64 = id - r * width;
    var h: int64 = col / d;
    var at: int64 = (((r / chunk) * heads + h) * chunk + r % chunk) * d + col - h * d;
    if (to_flat != 0) { flat[at] = wide[id]; } else { wide[id] = flat[at]; }
    id = id + step;
  }
}

kernel(block = 256) k_recall_back(dkv: float32*, dq: float32*, dgate: float32*, dkn: float32*, dqn: float32*, dvg: float32*, kn: float32*, qn: float32*, kv: float32*, norms: float32*, rows: int64, chunk: int64, width: int32, heads: int32, wants: int32) {
  var w: int64 = (int64)block.x * 8 + (int64)(thread.x / 32);
  var lane: int32 = (int32)subgroup_local_id();
  var total: int64 = rows * (int64)heads;
  if (w >= total) { return; }
  var r: int64 = w / (int64)heads;
  var h: int32 = (int32)(w - r * (int64)heads);
  var d: int32 = width / heads;
  var key: int64 = r * (int64)(2 * width) + (int64)(h * d);
  var ask: int64 = r * (int64)width + (int64)(h * d);
  var flat: int64 = (((r / chunk) * (int64)heads + (int64)h) * chunk + r % chunk) * (int64)d;
  var dk: float32 = z32();
  var dqs: float32 = z32();
  var dg: float32 = z32();
  var i: int32 = lane;
  while (i < d) {
    var at: int64 = flat + (int64)i;
    dk = dk + dkn[at] * kn[at];
    dqs = dqs + dqn[at] * qn[at];
    dg = dg + dvg[at] * kv[key + (int64)(width + i)];
    i = i + 32;
  }
  var mean_k: float32 = subgroup_reduce_add(dk) / (float32)d;
  var mean_q: float32 = subgroup_reduce_add(dqs) / (float32)d;
  var pull: float32 = subgroup_reduce_add(dg);
  var rk: float32 = norms[w];
  var rq: float32 = norms[total + w];
  var rate: float32 = norms[2 * total + w];
  if ((wants & 4) != 0 && lane == 0) { dgate[w] = dgate[w] + rate * (one32() - rate) * pull; }
  i = lane;
  while (i < d) {
    var at: int64 = flat + (int64)i;
    if ((wants & 1) != 0) {
      var k0: int64 = key + (int64)i;
      var v0: int64 = key + (int64)(width + i);
      dkv[k0] = dkv[k0] + rk * (dkn[at] - kn[at] * mean_k);
      dkv[v0] = dkv[v0] + dvg[at] * rate;
    }
    if ((wants & 2) != 0) {
      var q0: int64 = ask + (int64)i;
      dq[q0] = dq[q0] + rq * (dqn[at] - qn[at] * mean_q);
    }
    i = i + 32;
  }
}

kernel(block = 256) k_recall_seed(state: float32*, seed: float32*, far: float32*, count: int64, chunks: int64, heads: int64, plane: int64) {
  var id: int64 = (int64)block.x * 256 + (int64)thread.x;
  var step: int64 = (int64)grid_dim.x * 256;
  var span: int64 = heads * plane;
  while (id < count) {
    var h: int64 = (id / plane) % heads;
    var c: int64 = (id / span) % chunks;
    var b: int64 = id / (chunks * span);
    state[id] = state[id] + far[h * chunks + c] * seed[(b * heads + h) * plane + id % plane];
    id = id + step;
  }
}

kernel(block = 256) k_recall_last(into: float32*, state: float32*, wrote: float32*, powers: float32*, count: int64, chunks: int64, heads: int64, chunk: int64, plane: int64, linked: int32) {
  var id: int64 = (int64)block.x * 256 + (int64)thread.x;
  var step: int64 = (int64)grid_dim.x * 256;
  while (id < count) {
    var h: int64 = (id / plane) % heads;
    var b: int64 = id / (heads * plane);
    var src: int64 = ((b * chunks + chunks - 1) * heads + h) * plane + id % plane;
    var v: float32 = wrote[src];
    if (linked != 0) { v = v + powers[h * (chunk + 1) + chunk] * state[src]; }
    into[id] = v;
    id = id + step;
  }
}

struct RecallParts {
  kn: float32*;
  qn: float32*;
  vg: float32*;
  scores: float32*;
  found: float32*;
  spare: float32*;
  state: float32*;
}

fn fwd_recall(s: GpuState*, g: Graph*, id: int32) {
  var n: Node* = g->node(id);
  var sh: Shape = n->value.shape;
  var rows: int64 = sh.dims[0] * sh.dims[1];
  var width: int64 = sh.dims[2];
  var heads: int64 = n->i0;
  var chunk: int64 = n->i1;
  var d: int64 = width / heads;
  var chunks: int64 = sh.dims[1] / chunk;
  var groups: int64 = sh.dims[0] * chunks * heads;
  var nd: int64 = chunk * d;
  var nn: int64 = chunk * chunk;
  var dd: int64 = d * d;
  var all: int64 = rows * width;
  var shrink: float32 = (float32)(1.0 / sqrt((float64)d));
  var powers: float32* = (float32*)n->ext;
  var p: RecallParts* = (RecallParts*)g->host_alloc(sizeof(RecallParts));
  p->kn = g->floats(all);
  p->qn = g->floats(all);
  p->vg = g->floats(all);
  p->scores = g->floats(groups * nn);
  p->found = g->floats(all);
  var seed: float32* = (float32*)n->i3;
  var into: float32* = (float32*)n->i4;
  var linked: bool = chunks > 1 || seed != 0;
  p->spare = if linked || into != 0 { g->floats(all) } else { (float32*)0 };
  p->state = if linked { g->floats(groups * dd) } else { (float32*)0 };
  n->i2 = (int64)p;
  var gate: float32* = if n->c >= 0 { g->data(n->c) } else { (float32*)0 };
  dispatch k_recall_prep[row_blocks(rows * heads), 256](p->kn, p->qn, p->vg, n->saved, g->data(n->a), g->data(n->b), gate, rows, chunk, (int32)width, (int32)heads, if n->c >= 0 { 1 } else { 0 });
  run_gemm(s, g, batched(p->qn, p->kn, p->scores, chunk, chunk, d, d, d, false, true, false, groups, nd, nd, nn));
  dispatch k_recall_fade[spread(s, groups * nn), 256](p->scores, powers, groups * nn, heads, chunk, shrink);
  run_gemm(s, g, batched(p->scores, p->vg, p->found, chunk, d, chunk, chunk, d, false, false, false, groups, nn, nd, nd));
  if (linked || into != 0) {
    var far: float32* = powers + heads * (chunk + 1);
    var wrote: float32* = g->floats(groups * dd);
    dispatch k_recall_rows[spread(s, all), 256](p->spare, p->vg, powers, all, heads, chunk, d, 1, shrink, 0);
    run_gemm(s, g, batched(p->spare, p->kn, wrote, d, d, chunk, d, d, true, false, false, groups, nd, nd, dd));
    if (linked) {
      dispatch k_recall_chain[spread(s, groups * dd), 256](p->state, wrote, far, groups * dd, chunks, heads, dd, 0);
      if (seed != 0) { dispatch k_recall_seed[spread(s, groups * dd), 256](p->state, seed, far, groups * dd, chunks, heads, dd); }
    }
    if (into != 0) { dispatch k_recall_last[spread(s, sh.dims[0] * heads * dd), 256](into, p->state, wrote, powers, sh.dims[0] * heads * dd, chunks, heads, chunk, dd, if linked { 1 } else { 0 }); }
    if (linked) {
      dispatch k_recall_rows[spread(s, all), 256](p->spare, p->qn, powers, all, heads, chunk, d, 0, one32(), 0);
      run_gemm(s, g, batched(p->spare, p->state, p->found, chunk, d, d, d, d, false, true, true, groups, nd, dd, nd));
    }
  }
  dispatch k_recall_move[spread(s, all), 256](p->found, n->value.data, all, chunk, width, heads, 0);
}

fn back_recall(s: GpuState*, g: Graph*, id: int32) {
  var n: Node* = g->node(id);
  var sh: Shape = n->value.shape;
  var rows: int64 = sh.dims[0] * sh.dims[1];
  var width: int64 = sh.dims[2];
  var heads: int64 = n->i0;
  var chunk: int64 = n->i1;
  var d: int64 = width / heads;
  var chunks: int64 = sh.dims[1] / chunk;
  var groups: int64 = sh.dims[0] * chunks * heads;
  var nd: int64 = chunk * d;
  var nn: int64 = chunk * chunk;
  var dd: int64 = d * d;
  var all: int64 = rows * width;
  var shrink: float32 = (float32)(1.0 / sqrt((float64)d));
  var powers: float32* = (float32*)n->ext;
  var p: RecallParts* = (RecallParts*)n->i2;
  var dvg: float32* = g->floats(all);
  var dqn: float32* = g->floats(all);
  var dkn: float32* = g->floats(all);
  dispatch k_recall_move[spread(s, all), 256](p->found, n->grad, all, chunk, width, heads, 1);
  run_gemm(s, g, batched(p->scores, p->found, dvg, chunk, d, chunk, chunk, d, true, false, false, groups, nn, nd, nd));
  run_gemm(s, g, batched(p->found, p->vg, p->scores, chunk, chunk, d, d, d, false, true, false, groups, nd, nd, nn));
  dispatch k_recall_fade[spread(s, groups * nn), 256](p->scores, powers, groups * nn, heads, chunk, shrink);
  run_gemm(s, g, batched(p->scores, p->kn, dqn, chunk, d, chunk, chunk, d, false, false, false, groups, nn, nd, nd));
  run_gemm(s, g, batched(p->scores, p->qn, dkn, chunk, d, chunk, chunk, d, true, false, false, groups, nn, nd, nd));
  if (chunks > 1 || n->i3 != 0) {
    var dstate: float32* = g->floats(groups * dd);
    var dwrote: float32* = g->floats(groups * dd);
    dispatch k_recall_rows[spread(s, all), 256](p->spare, p->found, powers, all, heads, chunk, d, 0, one32(), 0);
    run_gemm(s, g, batched(p->spare, p->state, dqn, chunk, d, d, d, d, false, false, true, groups, nd, dd, nd));
    run_gemm(s, g, batched(p->spare, p->qn, dstate, d, d, chunk, d, d, true, false, false, groups, nd, nd, dd));
    dispatch k_recall_chain[spread(s, groups * dd), 256](dwrote, dstate, powers + heads * (chunk + 1), groups * dd, chunks, heads, dd, 1);
    dispatch k_recall_rows[spread(s, all), 256](p->spare, p->vg, powers, all, heads, chunk, d, 1, shrink, 0);
    run_gemm(s, g, batched(p->spare, dwrote, dkn, chunk, d, d, d, d, false, false, true, groups, nd, dd, nd));
    run_gemm(s, g, batched(p->kn, dwrote, p->spare, chunk, d, d, d, d, false, true, false, groups, nd, dd, nd));
    dispatch k_recall_rows[spread(s, all), 256](dvg, p->spare, powers, all, heads, chunk, d, 1, shrink, 1);
  }
  var wants: int32 = 0;
  var dkv: float32* = (float32*)0;
  var dq: float32* = (float32*)0;
  var dgate: float32* = (float32*)0;
  if (g->nodes[n->a].requires) {
    dkv = g->grad_of(n->a);
    wants = wants | 1;
  }
  if (g->nodes[n->b].requires) {
    dq = g->grad_of(n->b);
    wants = wants | 2;
  }
  if (n->c >= 0 && g->nodes[n->c].requires) {
    dgate = g->grad_of(n->c);
    wants = wants | 4;
  }
  dispatch k_recall_back[row_blocks(rows * heads), 256](dkv, dq, dgate, dkn, dqn, dvg, p->kn, p->qn, g->data(n->a), n->saved, rows, chunk, (int32)width, (int32)heads, wants);
}
kernel(block = 256) k_exact_prep(kn: float32*, qn: float32*, v: float32*, rates: float32*, norms: float32*, kv: float32*, q: float32*, gate: float32*, rows: int64, time: int64, chunk: int64, width: int32, heads: int32, gated: int32, kv_stride: int64, q_stride: int64) {
  var w: int64 = (int64)block.x * 8 + (int64)(thread.x / 32);
  var lane: int32 = (int32)subgroup_local_id();
  var total: int64 = rows * (int64)heads;
  if (w >= total) { return; }
  var r: int64 = w / (int64)heads;
  var h: int32 = (int32)(w - r * (int64)heads);
  var d: int32 = width / heads;
  var key: int64 = r * kv_stride + (int64)(h * d);
  var ask: int64 = r * q_stride + (int64)(h * d);
  var b: int64 = r / time;
  var t: int64 = r - b * time;
  var row: int64 = (((t / chunk) * (rows / time) + b) * (int64)heads + (int64)h) * chunk + t % chunk;
  var flat: int64 = row * (int64)d;
  var sk: float32 = z32();
  var sq: float32 = z32();
  var i: int32 = lane;
  while (i < d) {
    var a: float32 = kv[key + (int64)i];
    var c: float32 = q[ask + (int64)i];
    sk = sk + a * a;
    sq = sq + c * c;
    i = i + 32;
  }
  var rk: float32 = rsqrtf(subgroup_reduce_add(sk) / (float32)d + (float32)1.0e-6);
  var rq: float32 = rsqrtf(subgroup_reduce_add(sq) / (float32)d + (float32)1.0e-6);
  var unit: float32 = rk * rsqrtf((float32)d);
  var rate: float32 = one32();
  if (gated != 0) { rate = one32() / (one32() + expf(-gate[w])); }
  if (lane == 0) {
    norms[w] = rk;
    norms[total + w] = rq;
    norms[2 * total + w] = rate;
    rates[row] = rate;
  }
  i = lane;
  while (i < d) {
    kn[flat + (int64)i] = kv[key + (int64)i] * unit;
    qn[flat + (int64)i] = q[ask + (int64)i] * rq;
    v[flat + (int64)i] = kv[key + (int64)(width + i)];
    i = i + 32;
  }
}

kernel(block = 256) k_exact_lower(lower: float32*, powers: float32*, count: int64, heads: int64, chunk: int64) {
  var id: int64 = (int64)block.x * 256 + (int64)thread.x;
  var step: int64 = (int64)grid_dim.x * 256;
  while (id < count) {
    var from: int64 = id % chunk;
    var to: int64 = (id / chunk) % chunk;
    var h: int64 = (id / (chunk * chunk)) % heads;
    if (from >= to) {
      lower[id] = z32();
    } else {
      lower[id] = lower[id] * powers[h * (chunk + 1) + to - from];
    }
    id = id + step;
  }
}

kernel(block = 256) k_exact_gap(gap: float32*, wrote: float32*, v: float32*, pulled: float32*, rates: float32*, powers: float32*, count: int64, heads: int64, chunk: int64, dim: int64, first: int32) {
  var id: int64 = (int64)block.x * 256 + (int64)thread.x;
  var step: int64 = (int64)grid_dim.x * 256;
  while (id < count) {
    var row: int64 = id / dim;
    var at: int64 = row % chunk;
    var h: int64 = (row / chunk) % heads;
    var z: float32 = v[id];
    if (first == 0) { z = z - powers[h * (chunk + 1) + at + 1] * pulled[id]; }
    gap[id] = z;
    wrote[id] = rates[row] * z;
    id = id + step;
  }
}

kernel(block = 256) k_exact_carried(dst: float32*, x: float32*, rates: float32*, powers: float32*, count: int64, heads: int64, chunk: int64, dim: int64) {
  var id: int64 = (int64)block.x * 256 + (int64)thread.x;
  var step: int64 = (int64)grid_dim.x * 256;
  while (id < count) {
    var row: int64 = id / dim;
    var at: int64 = row % chunk;
    var h: int64 = (row / chunk) % heads;
    dst[id] = rates[row] * powers[h * (chunk + 1) + at + 1] * x[id];
    id = id + step;
  }
}

kernel(block = 256) k_exact_decay(next: float32*, state: float32*, powers: float32*, count: int64, heads: int64, chunk: int64, plane: int64) {
  var id: int64 = (int64)block.x * 256 + (int64)thread.x;
  var step: int64 = (int64)grid_dim.x * 256;
  while (id < count) {
    var h: int64 = (id / plane) % heads;
    next[id] = next[id] + powers[h * (chunk + 1) + chunk] * state[id];
    id = id + step;
  }
}

kernel(block = 256) k_exact_pull(p: float32*, lower: float32*, rates: float32*, drate: float32*, x: float32*, gap: float32*, powers: float32*, rows: int64, heads: int64, chunk: int64, dim: int64) {
  var row: int64 = (int64)block.x * 256 + (int64)thread.x;
  if (row >= rows) { return; }
  var to: int64 = row % chunk;
  var h: int64 = (row / chunk) % heads;
  var line: int64 = row * chunk;
  var rate: float32 = rates[row];
  var acc: float32 = z32();
  var j: int64 = 0;
  while (j < chunk) {
    if (j < to) {
      acc = acc - p[line + j] * lower[line + j];
      p[line + j] = -p[line + j] * rate * powers[h * (chunk + 1) + to - j];
    } else {
      p[line + j] = z32();
    }
    j = j + 1;
  }
  var e: int64 = 0;
  while (e < dim) {
    acc = acc + x[row * dim + e] * gap[row * dim + e];
    e = e + 1;
  }
  drate[row] = acc;
}

kernel(block = 256) k_exact_move(flat: float32*, wide: float32*, count: int64, time: int64, chunk: int64, width: int64, heads: int64, to_flat: int32) {
  var id: int64 = (int64)block.x * 256 + (int64)thread.x;
  var step: int64 = (int64)grid_dim.x * 256;
  var d: int64 = width / heads;
  var batch: int64 = count / (time * width);
  while (id < count) {
    var r: int64 = id / width;
    var col: int64 = id - r * width;
    var h: int64 = col / d;
    var b: int64 = r / time;
    var t: int64 = r - b * time;
    var at: int64 = ((((t / chunk) * batch + b) * heads + h) * chunk + t % chunk) * d + col - h * d;
    if (to_flat != 0) { flat[at] = wide[id]; } else { wide[id] = flat[at]; }
    id = id + step;
  }
}

kernel(block = 256) k_exact_back(dkv: float32*, dq: float32*, dgate: float32*, dkn: float32*, dqn: float32*, x: float32*, drate: float32*, kn: float32*, qn: float32*, norms: float32*, rows: int64, time: int64, chunk: int64, width: int32, heads: int32, wants: int32, kv_stride: int64, q_stride: int64) {
  var w: int64 = (int64)block.x * 8 + (int64)(thread.x / 32);
  var lane: int32 = (int32)subgroup_local_id();
  var total: int64 = rows * (int64)heads;
  if (w >= total) { return; }
  var r: int64 = w / (int64)heads;
  var h: int32 = (int32)(w - r * (int64)heads);
  var d: int32 = width / heads;
  var key: int64 = r * kv_stride + (int64)(h * d);
  var ask: int64 = r * q_stride + (int64)(h * d);
  var b: int64 = r / time;
  var t: int64 = r - b * time;
  var row: int64 = (((t / chunk) * (rows / time) + b) * (int64)heads + (int64)h) * chunk + t % chunk;
  var flat: int64 = row * (int64)d;
  var dk: float32 = z32();
  var dqs: float32 = z32();
  var i: int32 = lane;
  while (i < d) {
    var at: int64 = flat + (int64)i;
    dk = dk + dkn[at] * kn[at];
    dqs = dqs + dqn[at] * qn[at];
    i = i + 32;
  }
  var lean: float32 = subgroup_reduce_add(dk);
  var mean_q: float32 = subgroup_reduce_add(dqs) / (float32)d;
  var rk: float32 = norms[w] * rsqrtf((float32)d);
  var rq: float32 = norms[total + w];
  var rate: float32 = norms[2 * total + w];
  if ((wants & 4) != 0 && lane == 0) {
    var before: float32 = z32();
    if ((wants & 16) == 0) { before = dgate[w]; }
    dgate[w] = before + rate * (one32() - rate) * drate[row];
  }
  i = lane;
  while (i < d) {
    var at: int64 = flat + (int64)i;
    var old_k: float32 = z32();
    var old_v: float32 = z32();
    var old_q: float32 = z32();
    if ((wants & 1) != 0) {
      var k0: int64 = key + (int64)i;
      var v0: int64 = key + (int64)(width + i);
      if ((wants & 8) == 0) {
        old_k = dkv[k0];
        old_v = dkv[v0];
      }
      dkv[k0] = old_k + rk * (dkn[at] - kn[at] * lean);
      dkv[v0] = old_v + rate * x[at];
    }
    if ((wants & 2) != 0) {
      var q0: int64 = ask + (int64)i;
      if ((wants & 32) == 0) { old_q = dq[q0]; }
      dq[q0] = old_q + rq * (dqn[at] - qn[at] * mean_q);
    }
    i = i + 32;
  }
}

kernel(block = 256) k_span_rows(dst: float32*, src: float32*, powers: float32*, count: int64, heads: int64, chunk: int64, span: int64, dim: int64, accumulate: int32) {
  var id: int64 = (int64)block.x * 256 + (int64)thread.x;
  var step: int64 = (int64)grid_dim.x * 256;
  while (id < count) {
    var row: int64 = id / dim;
    var at: int64 = row % chunk;
    var h: int64 = (row / chunk) % heads;
    var v: float32 = src[id] * powers[h * (chunk + 1) + span - 1 - at % span];
    if (accumulate != 0) { dst[id] = dst[id] + v; } else { dst[id] = v; }
    id = id + step;
  }
}

kernel(block = 256) k_span_scan(blocks: float32*, start: float32*, end: float32*, deltas: float32*, powers: float32*, count: int64, heads: int64, chunk: int64, span: int64, subs: int64, plane: int64) {
  var id: int64 = (int64)block.x * 256 + (int64)thread.x;
  var step: int64 = (int64)grid_dim.x * 256;
  while (id < count) {
    var group: int64 = id / plane;
    var e: int64 = id - group * plane;
    var keep: float32 = powers[(group % heads) * (chunk + 1) + span];
    var acc: float32 = start[id];
    var m: int64 = 0;
    while (m < subs) {
      acc = keep * acc + deltas[(group * subs + m) * plane + e];
      blocks[(m + 1) * count + id] = acc;
      m = m + 1;
    }
    end[id] = acc;
    id = id + step;
  }
}

kernel(block = 256) k_span_back_scan(held: float32*, later: float32*, taps: float32*, powers: float32*, count: int64, heads: int64, chunk: int64, span: int64, subs: int64, plane: int64, last: int32) {
  var id: int64 = (int64)block.x * 256 + (int64)thread.x;
  var step: int64 = (int64)grid_dim.x * 256;
  while (id < count) {
    var group: int64 = id / plane;
    var e: int64 = id - group * plane;
    var keep: float32 = powers[(group % heads) * (chunk + 1) + span];
    var acc: float32 = z32();
    if (last != 0) { acc = taps[subs * count + id]; } else { acc = later[id]; }
    held[(group * subs + subs - 1) * plane + e] = acc;
    var m: int64 = subs - 2;
    while (m >= 0) {
      acc = taps[(m + 1) * count + id] + keep * acc;
      held[(group * subs + m) * plane + e] = acc;
      m = m - 1;
    }
    id = id + step;
  }
}

kernel(block = 256) k_span_decay(next: float32*, held: float32*, taps: float32*, powers: float32*, count: int64, heads: int64, chunk: int64, span: int64, subs: int64, plane: int64) {
  var id: int64 = (int64)block.x * 256 + (int64)thread.x;
  var step: int64 = (int64)grid_dim.x * 256;
  while (id < count) {
    var group: int64 = id / plane;
    next[id] = next[id] + powers[(group % heads) * (chunk + 1) + span] * held[group * subs * plane + id - group * plane] + taps[id];
    id = id + step;
  }
}

kernel(block = 256) k_exact_inverse(inverse: float32*, lower: float32*, rates: float32*, groups: int64, chunk: int64) {
  var id: int64 = (int64)block.x * 256 + (int64)thread.x;
  if (id >= groups * chunk) { return; }
  var group: int64 = id / chunk;
  var col: int64 = id - group * chunk;
  var inv: float32* = inverse + group * chunk * chunk;
  var tri: float32* = lower + group * chunk * chunk;
  var rate: float32* = rates + group * chunk;
  var i: int64 = 0;
  while (i < col) {
    inv[i * chunk + col] = z32();
    i = i + 1;
  }
  inv[col * chunk + col] = one32();
  i = col + 1;
  while (i < chunk) {
    var acc: float32 = z32();
    var l: int64 = col;
    while (l < i) {
      acc = acc + tri[i * chunk + l] * inv[l * chunk + col];
      l = l + 1;
    }
    inv[i * chunk + col] = -rate[i] * acc;
    i = i + 1;
  }
}

struct ExactParts {
  inverse: float32*;
  kn: float32*;
  qn: float32*;
  v: float32*;
  gap: float32*;
  wrote: float32*;
  rates: float32*;
  lower: float32*;
  scores: float32*;
  states: float32*;
  starts: float32*;
}

fn minus(q: GemmShape) -> GemmShape {
  var r: GemmShape = q;
  r.alpha = -one32();
  return r;
}

fn fwd_exact(s: GpuState*, g: Graph*, id: int32) {
  var n: Node* = g->node(id);
  var sh: Shape = n->value.shape;
  var time: int64 = sh.dims[1];
  var rows: int64 = sh.dims[0] * time;
  var width: int64 = sh.dims[2];
  var heads: int64 = n->i0;
  var chunk: int64 = n->i1;
  var d: int64 = width / heads;
  var chunks: int64 = time / chunk;
  var groups: int64 = sh.dims[0] * heads;
  var nd: int64 = chunk * d;
  var nn: int64 = chunk * chunk;
  var dd: int64 = d * d;
  var gnd: int64 = groups * nd;
  var gnn: int64 = groups * nn;
  var gdd: int64 = groups * dd;
  var all: int64 = rows * width;
  var every: int64 = chunks * groups;
  var powers: float32* = (float32*)n->ext;
  var tapped: bool = n->i5 != 0;
  var span: int64 = if tapped { (int64)n->ints[0] } else { chunk };
  var subs: int64 = chunk / span;
  var stride: int64 = subs * gdd;
  var t: Graph* = spare(s);
  var p: ExactParts* = (ExactParts*)g->host_alloc(sizeof(ExactParts));
  n->i2 = (int64)p;
  p->kn = g->floats(all);
  p->qn = g->floats(all);
  p->v = t->floats(all);
  p->gap = g->floats(all);
  p->wrote = g->floats(all);
  p->rates = g->floats(rows * heads);
  p->lower = g->floats(chunks * gnn);
  p->scores = g->floats(chunks * gnn);
  p->inverse = g->floats(chunks * gnn);
  p->states = g->floats((chunks * subs + 1) * gdd);
  p->starts = if tapped { g->floats((chunks + 1) * gdd) } else { p->states };
  var found: float32* = t->floats(all);
  var spare_rows: float32* = t->floats(gnd);
  var rhs: float32* = t->floats(gnd);
  var deltas: float32* = if tapped { t->floats(groups * subs * dd) } else { (float32*)0 };
  var seed: float32* = (float32*)n->i3;
  var into: float32* = (float32*)n->i4;
  if (seed != 0) { dispatch k_scaled[spread(s, gdd), 256](p->starts, seed, one32(), gdd); }
  if (tapped) {
    if (seed != 0) {
      dispatch k_scaled[spread(s, gdd), 256](p->states, seed, one32(), gdd);
    } else {
      s->dev->fill(p->states, 0.0, gdd);
      s->dev->fill(p->starts, 0.0, gdd);
    }
  }
  var gate: float32* = if n->c >= 0 { g->data(n->c) } else { (float32*)0 };
  dispatch k_exact_prep[row_blocks(rows * heads), 256](p->kn, p->qn, p->v, p->rates, n->saved, g->data(n->a), g->data(n->b), gate, rows, time, chunk, (int32)width, (int32)heads, if n->c >= 0 { 1 } else { 0 }, 2 * width, width);
  run_gemm(s, t, batched(p->kn, p->kn, p->lower, chunk, chunk, d, d, d, false, true, false, every, nd, nd, nn));
  dispatch k_exact_lower[spread(s, chunks * gnn), 256](p->lower, powers, chunks * gnn, heads, chunk);
  dispatch k_exact_inverse[cover(every * chunk), 256](p->inverse, p->lower, p->rates, every, chunk);
  run_gemm(s, t, batched(p->qn, p->kn, p->scores, chunk, chunk, d, d, d, false, true, false, every, nd, nd, nn));
  dispatch k_recall_fade[spread(s, chunks * gnn), 256](p->scores, powers, chunks * gnn, heads, chunk, one32());
  for c: int64 in 0..chunks {
    var k: float32* = p->kn + c * gnd;
    var u: float32* = p->wrote + c * gnd;
    var rate: float32* = p->rates + c * groups * chunk;
    var state: float32* = p->starts + c * gdd;
    var fed: bool = c > 0 || seed != 0;
    if (fed) { run_gemm(s, t, batched(k, state, spare_rows, chunk, d, d, d, d, false, true, false, groups, nd, dd, nd)); }
    dispatch k_exact_gap[spread(s, gnd), 256](p->gap + c * gnd, rhs, p->v + c * gnd, spare_rows, rate, powers, gnd, heads, chunk, d, if fed { 0 } else { 1 });
    run_gemm(s, t, batched(p->inverse + c * gnn, rhs, u, chunk, d, chunk, chunk, d, false, false, false, groups, nn, nd, nd));
    if (tapped) {
      dispatch k_span_rows[spread(s, gnd), 256](spare_rows, u, powers, gnd, heads, chunk, span, d, 0);
      run_gemm(s, t, batched(spare_rows, k, deltas, d, d, span, d, d, true, false, false, groups * subs, span * d, span * d, dd));
      dispatch k_span_scan[spread(s, gdd), 256](p->states + c * stride, state, state + gdd, deltas, powers, gdd, heads, chunk, span, subs, dd);
    } else if (c + 1 < chunks || into != 0) {
      dispatch k_recall_rows[spread(s, gnd), 256](spare_rows, u, powers, gnd, heads, chunk, d, 1, one32(), 0);
      run_gemm(s, t, batched(spare_rows, k, state + gdd, d, d, chunk, d, d, true, false, false, groups, nd, nd, dd));
      if (fed) { dispatch k_exact_decay[spread(s, gdd), 256](state + gdd, state, powers, gdd, heads, chunk, dd); }
    }
  }
  run_gemm(s, t, batched(p->scores, p->wrote, found, chunk, d, chunk, chunk, d, false, false, false, every, nn, nd, nd));
  var first: int64 = if seed != 0 { 0 } else { 1 };
  if (chunks > first) {
    var fed_groups: int64 = (chunks - first) * groups;
    var faded: float32* = t->floats(fed_groups * nd);
    dispatch k_recall_rows[spread(s, fed_groups * nd), 256](faded, p->qn + first * gnd, powers, fed_groups * nd, heads, chunk, d, 0, one32(), 0);
    run_gemm(s, t, batched(faded, p->starts + first * gdd, found + first * gnd, chunk, d, d, d, d, false, true, true, fed_groups, nd, dd, nd));
  }
  if (into != 0) { dispatch k_scaled[spread(s, gdd), 256](into, p->starts + chunks * gdd, one32(), gdd); }
  dispatch k_exact_move[spread(s, all), 256](found, n->value.data, all, time, chunk, width, heads, 0);
}

fn back_exact(s: GpuState*, g: Graph*, id: int32) {
  var n: Node* = g->node(id);
  var sh: Shape = n->value.shape;
  var time: int64 = sh.dims[1];
  var rows: int64 = sh.dims[0] * time;
  var width: int64 = sh.dims[2];
  var heads: int64 = n->i0;
  var chunk: int64 = n->i1;
  var d: int64 = width / heads;
  var chunks: int64 = time / chunk;
  var groups: int64 = sh.dims[0] * heads;
  var nd: int64 = chunk * d;
  var nn: int64 = chunk * chunk;
  var dd: int64 = d * d;
  var gnd: int64 = groups * nd;
  var gnn: int64 = groups * nn;
  var gdd: int64 = groups * dd;
  var all: int64 = rows * width;
  var every: int64 = chunks * groups;
  var powers: float32* = (float32*)n->ext;
  var p: ExactParts* = (ExactParts*)n->i2;
  var tapped: bool = n->i5 != 0;
  var span: int64 = if tapped { (int64)n->ints[0] } else { chunk };
  var subs: int64 = chunk / span;
  var stride: int64 = subs * gdd;
  var taps: float32* = (float32*)n->i5;
  var seeded: bool = n->i3 != 0;
  var t: Graph* = spare(s);
  var dkn: float32* = t->zeros_raw(all);
  var dqn: float32* = t->zeros_raw(all);
  var dout: float32* = t->floats(all);
  var solved: float32* = t->floats(all);
  var raw: float32* = t->floats(all);
  var faded: float32* = t->floats(all);
  var tails: float32* = t->floats(all);
  var drate: float32* = t->floats(rows * heads);
  var slope: float32* = t->floats((chunks + 1) * gdd);
  var spare_rows: float32* = t->floats(gnd);
  var held: float32* = if tapped { t->floats(every * subs * dd) } else { (float32*)0 };
  var first: int64 = if seeded { 0 } else { 1 };
  var fed_groups: int64 = (chunks - first) * groups;
  dispatch k_exact_move[spread(s, all), 256](dout, n->grad, all, time, chunk, width, heads, 1);
  run_gemm(s, t, batched(p->scores, dout, raw, chunk, d, chunk, chunk, d, true, false, false, every, nn, nd, nd));
  run_gemm(s, t, batched(dout, p->wrote, p->scores, chunk, chunk, d, d, d, false, true, false, every, nd, nd, nn));
  dispatch k_recall_fade[spread(s, chunks * gnn), 256](p->scores, powers, chunks * gnn, heads, chunk, one32());
  run_gemm(s, t, batched(p->scores, p->kn, dqn, chunk, d, chunk, chunk, d, false, false, true, every, nn, nd, nd));
  run_gemm(s, t, batched(p->scores, p->qn, dkn, chunk, d, chunk, chunk, d, true, false, true, every, nn, nd, nd));
  if (fed_groups > 0) {
    dispatch k_recall_rows[spread(s, fed_groups * nd), 256](faded + first * gnd, dout + first * gnd, powers, fed_groups * nd, heads, chunk, d, 0, one32(), 0);
    run_gemm(s, t, batched(faded + first * gnd, p->qn + first * gnd, slope + first * gdd, d, d, chunk, d, d, true, false, false, fed_groups, nd, nd, dd));
  }
  var c: int64 = chunks - 1;
  while (c >= 0) {
    var k: float32* = p->kn + c * gnd;
    var x: float32* = solved + c * gnd;
    var pulled: float32* = raw + c * gnd;
    var rate: float32* = p->rates + c * groups * chunk;
    var later: float32* = slope + (c + 1) * gdd;
    var sooner: float32* = slope + c * gdd;
    var hc: float32* = if tapped { held + c * groups * subs * dd } else { (float32*)0 };
    var last: bool = c + 1 == chunks;
    var fed: bool = c > 0 || seeded;
    if (tapped) {
      dispatch k_span_back_scan[spread(s, gdd), 256](hc, later, taps + c * stride, powers, gdd, heads, chunk, span, subs, dd, if last { 1 } else { 0 });
      run_gemm(s, t, batched(k, hc, spare_rows, span, d, d, d, d, false, true, false, groups * subs, span * d, dd, span * d));
      dispatch k_span_rows[spread(s, gnd), 256](pulled, spare_rows, powers, gnd, heads, chunk, span, d, 1);
    } else if (!last) {
      run_gemm(s, t, batched(k, later, spare_rows, chunk, d, d, d, d, false, true, false, groups, nd, dd, nd));
      dispatch k_recall_rows[spread(s, gnd), 256](pulled, spare_rows, powers, gnd, heads, chunk, d, 1, one32(), 1);
    }
    run_gemm(s, t, batched(p->inverse + c * gnn, pulled, x, chunk, d, chunk, chunk, d, true, false, false, groups, nn, nd, nd));
    if (fed) {
      if (tapped) {
        dispatch k_span_decay[spread(s, gdd), 256](sooner, hc, taps + c * stride, powers, gdd, heads, chunk, span, subs, dd);
      } else if (!last) {
        dispatch k_exact_decay[spread(s, gdd), 256](sooner, later, powers, gdd, heads, chunk, dd);
      }
      dispatch k_exact_carried[spread(s, gnd), 256](pulled, x, rate, powers, gnd, heads, chunk, d);
      run_gemm(s, t, minus(batched(pulled, k, sooner, d, d, chunk, d, d, true, false, true, groups, nd, nd, dd)));
    }
    c = c - 1;
  }
  if (tapped) {
    dispatch k_span_rows[spread(s, all), 256](tails, p->wrote, powers, all, heads, chunk, span, d, 0);
    run_gemm(s, t, batched(tails, held, dkn, span, d, d, d, d, false, false, true, every * subs, span * d, dd, span * d));
  } else if (chunks > 1) {
    dispatch k_recall_rows[spread(s, (chunks - 1) * gnd), 256](tails, p->wrote, powers, (chunks - 1) * gnd, heads, chunk, d, 1, one32(), 0);
    run_gemm(s, t, batched(tails, slope + gdd, dkn, chunk, d, d, d, d, false, false, true, (chunks - 1) * groups, nd, dd, nd));
  }
  if (fed_groups > 0) {
    run_gemm(s, t, batched(faded + first * gnd, p->starts + first * gdd, dqn + first * gnd, chunk, d, d, d, d, false, false, true, fed_groups, nd, dd, nd));
    run_gemm(s, t, minus(batched(raw + first * gnd, p->starts + first * gdd, dkn + first * gnd, chunk, d, d, d, d, false, false, true, fed_groups, nd, dd, nd)));
  }
  run_gemm(s, t, batched(solved, p->wrote, p->scores, chunk, chunk, d, d, d, false, true, false, every, nd, nd, nn));
  dispatch k_exact_pull[cover(every * chunk), 256](p->scores, p->lower, p->rates, drate, solved, p->gap, powers, every * chunk, heads, chunk, d);
  run_gemm(s, t, batched(p->scores, p->kn, dkn, chunk, d, chunk, chunk, d, false, false, true, every, nn, nd, nd));
  run_gemm(s, t, batched(p->scores, p->kn, dkn, chunk, d, chunk, chunk, d, true, false, true, every, nn, nd, nd));
  var wants: int32 = 0;
  var dkv: float32* = (float32*)0;
  var dq: float32* = (float32*)0;
  var dgate: float32* = (float32*)0;
  if (g->nodes[n->a].requires) {
    var slot: GradSlot = g->grad_take(n->a);
    dkv = slot.data;
    wants = wants | (if slot.fresh { 9 } else { 1 });
  }
  if (g->nodes[n->b].requires) {
    var slot: GradSlot = g->grad_take(n->b);
    dq = slot.data;
    wants = wants | (if slot.fresh { 34 } else { 2 });
  }
  if (n->c >= 0 && g->nodes[n->c].requires) {
    var slot: GradSlot = g->grad_take(n->c);
    dgate = slot.data;
    wants = wants | (if slot.fresh { 20 } else { 4 });
  }
  dispatch k_exact_back[row_blocks(rows * heads), 256](dkv, dq, dgate, dkn, dqn, solved, drate, p->kn, p->qn, n->saved, rows, time, chunk, (int32)width, (int32)heads, wants, 2 * width, width);
}

struct MingleParts {
  kn: float32*;
  qn: float32*;
  v: float32*;
  scores: float32*;
  norms: float32*;
}

fn scaled_by(q: GemmShape, alpha: float32) -> GemmShape {
  var r: GemmShape = q;
  r.alpha = alpha;
  return r;
}

fn spare(s: GpuState*) -> Graph* {
  if (s->scratch == 0) { s->scratch = graph_on(s->dev); }
  s->scratch->reset();
  return s->scratch;
}

fn mingle_fwd(s: GpuState*, g: Graph*, t: Graph*, p: MingleParts*, packed: float32*, stride: int64, out: float32*, batch: int64, rooms: int64, width: int64, heads: int64) {
  var rows: int64 = batch * rooms;
  var d: int64 = width / heads;
  var groups: int64 = batch * heads;
  var nd: int64 = rooms * d;
  var nn: int64 = rooms * rooms;
  var all: int64 = rows * width;
  p->kn = g->floats(all);
  p->qn = g->floats(all);
  p->v = g->floats(all);
  p->scores = g->floats(groups * nn);
  p->norms = g->floats(4 * rows * heads);
  var found: float32* = t->floats(all);
  dispatch k_exact_prep[row_blocks(rows * heads), 256](p->kn, p->qn, p->v, p->norms + 3 * rows * heads, p->norms, packed, packed + 2 * width, (float32*)0, rows, rooms, rooms, (int32)width, (int32)heads, 0, stride, stride);
  run_gemm(s, t, batched(p->qn, p->kn, p->scores, rooms, rooms, d, d, d, false, true, false, groups, nd, nd, nn));
  run_gemm(s, t, scaled_by(batched(p->scores, p->v, found, rooms, d, rooms, rooms, d, false, false, false, groups, nn, nd, nd), one32() / (float32)rooms));
  dispatch k_exact_move[spread(s, all), 256](found, out, all, rooms, rooms, width, heads, 0);
}

fn mingle_back(s: GpuState*, t: Graph*, p: MingleParts*, dout: float32*, dp: float32*, stride: int64, batch: int64, rooms: int64, width: int64, heads: int64, wants: int32) {
  var rows: int64 = batch * rooms;
  var d: int64 = width / heads;
  var groups: int64 = batch * heads;
  var nd: int64 = rooms * d;
  var nn: int64 = rooms * rooms;
  var all: int64 = rows * width;
  var share: float32 = one32() / (float32)rooms;
  var found: float32* = t->floats(all);
  var dv: float32* = t->floats(all);
  var dqn: float32* = t->floats(all);
  var dkn: float32* = t->floats(all);
  dispatch k_exact_move[spread(s, all), 256](found, dout, all, rooms, rooms, width, heads, 1);
  run_gemm(s, t, scaled_by(batched(p->scores, found, dv, rooms, d, rooms, rooms, d, true, false, false, groups, nn, nd, nd), share));
  run_gemm(s, t, scaled_by(batched(found, p->v, p->scores, rooms, rooms, d, d, d, false, true, false, groups, nd, nd, nn), share));
  run_gemm(s, t, batched(p->scores, p->kn, dqn, rooms, d, rooms, rooms, d, false, false, false, groups, nn, nd, nd));
  run_gemm(s, t, batched(p->scores, p->qn, dkn, rooms, d, rooms, rooms, d, true, false, false, groups, nn, nd, nd));
  dispatch k_exact_back[row_blocks(rows * heads), 256](dp, dp + 2 * width, (float32*)0, dkn, dqn, dv, p->norms, p->kn, p->qn, p->norms, rows, rooms, rooms, (int32)width, (int32)heads, wants, stride, stride);
}

fn fwd_mingle(s: GpuState*, g: Graph*, id: int32) {
  var n: Node* = g->node(id);
  var sh: Shape = n->value.shape;
  var p: MingleParts* = (MingleParts*)g->host_alloc(sizeof(MingleParts));
  n->i2 = (int64)p;
  mingle_fwd(s, g, spare(s), p, g->data(n->a), 3 * sh.dims[2], n->value.data, sh.dims[0], sh.dims[1], sh.dims[2], n->i0);
}

fn back_mingle(s: GpuState*, g: Graph*, id: int32) {
  var n: Node* = g->node(id);
  if (!g->nodes[n->a].requires) { return; }
  var sh: Shape = n->value.shape;
  mingle_back(s, spare(s), (MingleParts*)n->i2, n->grad, g->grad_of(n->a), 3 * sh.dims[2], sh.dims[0], sh.dims[1], sh.dims[2], n->i0, 3);
}

kernel(block = 256) k_think_open(y: float32*, rstd: float32*, amt: float32*, a: float32*, b: float32*, heed: float32*, gate: float32*, bias: float32*, rows: int32, cols: int32, eps: float32) {
  var row: int32 = block.x * 8 + thread.x / 32;
  var lane: int32 = (int32)subgroup_local_id();
  if (row >= rows) { return; }
  var base: int64 = (int64)row * (int64)cols;
  var q: float32 = z32();
  var c: int32 = lane;
  while (c < cols) {
    var x: float32 = a[base + (int64)c] + b[base + (int64)c];
    q = q + x * x;
    c = c + 32;
  }
  var rs: float32 = rsqrtf(subgroup_reduce_add(q) / (float32)cols + eps);
  var gated: bool = gate != (float32*)0;
  var heeded: bool = heed != (float32*)0;
  var hit: float32 = z32();
  c = lane;
  while (c < cols) {
    var v: float32 = (a[base + (int64)c] + b[base + (int64)c]) * rs;
    if (heeded) { v = v + heed[base + (int64)c]; }
    y[base + (int64)c] = v;
    if (gated) { hit = hit + v * gate[c]; }
    c = c + 32;
  }
  var z: float32 = subgroup_reduce_add(hit);
  if (lane == 0) {
    rstd[row] = rs;
    if (gated) { amt[row] = d_sigmoid(z + bias[0]); }
  }
}

kernel(block = 256) k_think_close(out: float32*, sum: float32*, rooms: float32*, told: float32*, worked: float32*, amt: float32*, n: int64, cols: int64) {
  var i: int64 = (int64)block.x * 256 + (int64)thread.x;
  var step: int64 = (int64)grid_dim.x * 256;
  while (i < n) {
    var both: float32 = told[i] + worked[i];
    sum[i] = both;
    out[i] = rooms[i] + both * amt[i / cols];
    i = i + step;
  }
}

kernel(block = 256) k_think_close_back(dsum: float32*, dz: float32*, drooms: float32*, dout: float32*, sum: float32*, amt: float32*, rows: int32, cols: int32, wants: int32) {
  var row: int32 = block.x * 8 + thread.x / 32;
  var lane: int32 = (int32)subgroup_local_id();
  if (row >= rows) { return; }
  var base: int64 = (int64)row * (int64)cols;
  var share: float32 = amt[row];
  var acc: float32 = z32();
  var c: int32 = lane;
  while (c < cols) {
    var at: int64 = base + (int64)c;
    var d: float32 = dout[at];
    acc = acc + d * sum[at];
    dsum[at] = d * share;
    if (wants != 0) { drooms[at] = drooms[at] + d; }
    c = c + 32;
  }
  var total: float32 = subgroup_reduce_add(acc);
  if (lane == 0) { dz[row] = total * share * (one32() - share); }
}

kernel(block = 256) k_think_mid_back(drooms: float32*, dtold: float32*, dmn: float32*, dsum: float32*, mn: float32*, rstd: float32*, rows: int32, cols: int32, wants: int32) {
  var row: int32 = block.x * 8 + thread.x / 32;
  var lane: int32 = (int32)subgroup_local_id();
  if (row >= rows) { return; }
  var base: int64 = (int64)row * (int64)cols;
  var rs: float32 = rstd[row];
  var acc: float32 = z32();
  var c: int32 = lane;
  while (c < cols) {
    var at: int64 = base + (int64)c;
    acc = acc + dmn[at] * mn[at];
    c = c + 32;
  }
  var lean: float32 = subgroup_reduce_add(acc) / (float32)cols;
  c = lane;
  while (c < cols) {
    var at: int64 = base + (int64)c;
    var d: float32 = rs * (dmn[at] - mn[at] * lean);
    if (wants != 0) { drooms[at] = drooms[at] + d; }
    dtold[at] = d + dsum[at];
    c = c + 32;
  }
}

kernel(block = 256) k_think_open_back(drooms: float32*, dseats: float32*, dheed: float32*, dhere: float32*, dz: float32*, gate: float32*, here: float32*, heed: float32*, rstd: float32*, rows: int32, cols: int32, wants: int32) {
  var row: int32 = block.x * 8 + thread.x / 32;
  var lane: int32 = (int32)subgroup_local_id();
  if (row >= rows) { return; }
  var base: int64 = (int64)row * (int64)cols;
  var rs: float32 = rstd[row];
  var pull: float32 = dz[row];
  var heeded: bool = heed != (float32*)0;
  var acc: float32 = z32();
  var c: int32 = lane;
  while (c < cols) {
    var at: int64 = base + (int64)c;
    var y: float32 = here[at];
    if (heeded) { y = y - heed[at]; }
    acc = acc + (dhere[at] + pull * gate[c]) * y;
    c = c + 32;
  }
  var lean: float32 = subgroup_reduce_add(acc) / (float32)cols;
  c = lane;
  while (c < cols) {
    var at: int64 = base + (int64)c;
    var full: float32 = dhere[at] + pull * gate[c];
    var y: float32 = here[at];
    if (heeded) { y = y - heed[at]; }
    var d: float32 = rs * (full - y * lean);
    if ((wants & 1) != 0) { drooms[at] = drooms[at] + d; }
    if ((wants & 2) != 0) { dseats[at] = dseats[at] + d; }
    if ((wants & 4) != 0) { dheed[at] = dheed[at] + full; }
    c = c + 32;
  }
}

kernel(block = 256) k_rms_back(dx: float32*, dy: float32*, y: float32*, rstd: float32*, rows: int32, cols: int32) {
  var row: int32 = block.x * 8 + thread.x / 32;
  var lane: int32 = (int32)subgroup_local_id();
  if (row >= rows) { return; }
  var base: int64 = (int64)row * (int64)cols;
  var rs: float32 = rstd[row];
  var acc: float32 = z32();
  var c: int32 = lane;
  while (c < cols) {
    var at: int64 = base + (int64)c;
    acc = acc + dy[at] * y[at];
    c = c + 32;
  }
  var lean: float32 = subgroup_reduce_add(acc) / (float32)cols;
  c = lane;
  while (c < cols) {
    var at: int64 = base + (int64)c;
    dx[at] = rs * (dy[at] - y[at] * lean);
    c = c + 32;
  }
}

kernel(block = 256) k_period_add(out: float32*, a: float32*, b: float32*, n: int64, period: int64) {
  var i: int64 = (int64)block.x * 256 + (int64)thread.x;
  var step: int64 = (int64)grid_dim.x * 256;
  while (i < n) {
    out[i] = a[i] + b[i % period];
    i = i + step;
  }
}

kernel(block = 256) k_period_sum(dst: float32*, src: float32*, period: int64, times: int64) {
  var i: int64 = (int64)block.x * 256 + (int64)thread.x;
  var step: int64 = (int64)grid_dim.x * 256;
  while (i < period) {
    var acc: float32 = z32();
    var k: int64 = 0;
    while (k < times) {
      acc = acc + src[k * period + i];
      k = k + 1;
    }
    dst[i] = dst[i] + acc;
    i = i + step;
  }
}

kernel(block = 256) k_foresee_pick(dst: float32*, trace: float32*, n: int64, rounds: int64, ahead: int64, unit: int64, first: int64) {
  var i: int64 = (int64)block.x * 256 + (int64)thread.x;
  var step: int64 = (int64)grid_dim.x * 256;
  while (i < n) {
    var local: int64 = i / unit;
    var slot: int64 = first + local;
    var at: int64 = (slot / rounds + ahead) * rounds + rounds - 1;
    dst[i] = trace[at * unit + i - local * unit];
    i = i + step;
  }
}

kernel(block = 256) k_foresee_slope(d: float32*, a: float32*, b: float32*, lead: float32*, scale: float32, n: int64) {
  var i: int64 = (int64)block.x * 256 + (int64)thread.x;
  var step: int64 = (int64)grid_dim.x * 256;
  var by: float32 = lead[0] * scale;
  while (i < n) {
    d[i] = (a[i] - b[i]) * by;
    i = i + step;
  }
}

kernel(block = 256) k_think_consult(found: float32*, qn: float32*, qr: float32*, sq: float32*, stride: int64, states: float32*, count: int32, width: int32, heads: int32, eps: float32) {
  workgroup var st: float32[4160];
  var group: int32 = block.x;
  var b: int32 = group / heads;
  var h: int32 = group - b * heads;
  var d: int32 = width / heads;
  var pad: int32 = d + 1;
  var base: int64 = (int64)group * (int64)(d * d);
  var fill: int32 = thread.x;
  while (fill < d * d) {
    var line_at: int32 = fill / d;
    st[line_at * pad + fill - line_at * d] = states[base + (int64)fill];
    fill = fill + 256;
  }
  barrier();
  var lane: int32 = (int32)subgroup_local_id();
  var warp: int32 = thread.x / 32;
  var first: int32 = 0;
  while (first < count) {
    var r: int32 = first + warp;
    if (r < count) {
      var row: int64 = (int64)b * (int64)count + (int64)r;
      var line: int64 = row * (int64)width + (int64)(h * d);
      var ask: int64 = row * stride + (int64)(h * d);
      var lo: float32 = z32();
      var hi: float32 = z32();
      if (lane < d) { lo = sq[ask + (int64)lane]; }
      if (lane + 32 < d) { hi = sq[ask + (int64)(lane + 32)]; }
      var rs: float32 = rsqrtf(subgroup_reduce_add(lo * lo + hi * hi) / (float32)d + eps);
      lo = lo * rs;
      hi = hi * rs;
      if (lane < d) { qn[ask + (int64)lane] = lo; }
      if (lane + 32 < d) { qn[ask + (int64)(lane + 32)] = hi; }
      if (lane == 0) { qr[((int64)b * (int64)count + (int64)r) * (int64)heads + (int64)h] = rs; }
      var out_lo: float32 = z32();
      var out_hi: float32 = z32();
      var f: int32 = 0;
      while (f < d) {
        var pick: float32 = hi;
        if (f < 32) { pick = lo; }
        var v: float32 = subgroup_broadcast(pick, (uint32)(f % 32));
        if (lane < d) { out_lo = out_lo + st[lane * pad + f] * v; }
        if (lane + 32 < d) { out_hi = out_hi + st[(lane + 32) * pad + f] * v; }
        f = f + 1;
      }
      if (lane < d) { found[line + (int64)lane] = out_lo; }
      if (lane + 32 < d) { found[line + (int64)(lane + 32)] = out_hi; }
    }
    first = first + 8;
  }
}

kernel(block = 256) k_think_consult_back(dsq: float32*, taps: float32*, dfound: float32*, qn: float32*, stride: int64, qr: float32*, states: float32*, count: int32, width: int32, heads: int32) {
  workgroup var st: float32[4160];
  var group: int32 = block.x;
  var b: int32 = group / heads;
  var h: int32 = group - b * heads;
  var d: int32 = width / heads;
  var pad: int32 = d + 1;
  var base: int64 = (int64)group * (int64)(d * d);
  var fill: int32 = thread.x;
  while (fill < d * d) {
    var line_at: int32 = fill / d;
    st[line_at * pad + fill - line_at * d] = states[base + (int64)fill];
    fill = fill + 256;
  }
  barrier();
  var lane: int32 = (int32)subgroup_local_id();
  var warp: int32 = thread.x / 32;
  var first: int32 = 0;
  while (first < count) {
    var r: int32 = first + warp;
    if (r < count) {
      var row: int64 = (int64)b * (int64)count + (int64)r;
      var line: int64 = row * (int64)width + (int64)(h * d);
      var ask: int64 = row * stride + (int64)(h * d);
      var g_lo: float32 = z32();
      var g_hi: float32 = z32();
      var q_lo: float32 = z32();
      var q_hi: float32 = z32();
      if (lane < d) {
        g_lo = dfound[line + (int64)lane];
        q_lo = qn[ask + (int64)lane];
      }
      if (lane + 32 < d) {
        g_hi = dfound[line + (int64)(lane + 32)];
        q_hi = qn[ask + (int64)(lane + 32)];
      }
      var pull_lo: float32 = z32();
      var pull_hi: float32 = z32();
      var src: int32 = 0;
      while (src < d) {
        var pick: float32 = g_hi;
        if (src < 32) { pick = g_lo; }
        var v: float32 = subgroup_broadcast(pick, (uint32)(src % 32));
        if (lane < d) { pull_lo = pull_lo + st[src * pad + lane] * v; }
        if (lane + 32 < d) { pull_hi = pull_hi + st[src * pad + lane + 32] * v; }
        src = src + 1;
      }
      var lean: float32 = subgroup_reduce_add(pull_lo * q_lo + pull_hi * q_hi) / (float32)d;
      var rs: float32 = qr[((int64)b * (int64)count + (int64)r) * (int64)heads + (int64)h];
      if (lane < d) { dsq[ask + (int64)lane] = rs * (pull_lo - q_lo * lean); }
      if (lane + 32 < d) { dsq[ask + (int64)(lane + 32)] = rs * (pull_hi - q_hi * lean); }
    }
    first = first + 8;
  }
  if (taps != (float32*)0) {
    var cell: int32 = thread.x;
    while (cell < d * d) {
      var row: int32 = cell / d;
      var col: int32 = cell - row * d;
      var acc: float32 = z32();
      var room: int32 = 0;
      while (room < count) {
        var at: int64 = (int64)b * (int64)count + (int64)room;
        acc = acc + dfound[at * (int64)width + (int64)(h * d + row)] * qn[at * stride + (int64)(h * d + col)];
        room = room + 1;
      }
      taps[base + (int64)cell] = taps[base + (int64)cell] + acc;
      cell = cell + 256;
    }
  }
}

kernel(block = 256) k_think_mingle(out: float32*, packed: float32*, stride: int64, count: int32, width: int32, heads: int32, eps: float32) {
  workgroup var kn: float32[2080];
  workgroup var qn: float32[2080];
  workgroup var vs: float32[2080];
  workgroup var sc: float32[1056];
  var group: int32 = block.x;
  var b: int32 = group / heads;
  var h: int32 = group - b * heads;
  var d: int32 = width / heads;
  var pad: int32 = d + 1;
  var lane: int32 = (int32)subgroup_local_id();
  var warp: int32 = thread.x / 32;
  var shrink: float32 = rsqrtf((float32)d);
  var first: int32 = 0;
  while (first < count) {
    var r: int32 = first + warp;
    if (r < count) {
      var line: int64 = ((int64)b * (int64)count + (int64)r) * stride + (int64)(h * d);
      var k_lo: float32 = z32();
      var k_hi: float32 = z32();
      var q_lo: float32 = z32();
      var q_hi: float32 = z32();
      if (lane < d) {
        k_lo = packed[line + (int64)lane];
        q_lo = packed[line + (int64)(2 * width + lane)];
        vs[r * pad + lane] = packed[line + (int64)(width + lane)];
      }
      if (lane + 32 < d) {
        k_hi = packed[line + (int64)(lane + 32)];
        q_hi = packed[line + (int64)(2 * width + lane + 32)];
        vs[r * pad + lane + 32] = packed[line + (int64)(width + lane + 32)];
      }
      var rk: float32 = shrink * rsqrtf(subgroup_reduce_add(k_lo * k_lo + k_hi * k_hi) / (float32)d + eps);
      var rq: float32 = rsqrtf(subgroup_reduce_add(q_lo * q_lo + q_hi * q_hi) / (float32)d + eps);
      if (lane < d) {
        kn[r * pad + lane] = k_lo * rk;
        qn[r * pad + lane] = q_lo * rq;
      }
      if (lane + 32 < d) {
        kn[r * pad + lane + 32] = k_hi * rk;
        qn[r * pad + lane + 32] = q_hi * rq;
      }
    }
    first = first + 8;
  }
  barrier();
  var cell: int32 = thread.x;
  while (cell < count * count) {
    var i: int32 = cell / count;
    var j: int32 = cell - i * count;
    var acc: float32 = z32();
    var f: int32 = 0;
    while (f < d) {
      acc = acc + qn[i * pad + f] * kn[j * pad + f];
      f = f + 1;
    }
    sc[i * 33 + j] = acc;
    cell = cell + 256;
  }
  barrier();
  var share: float32 = one32() / (float32)count;
  var row: int32 = warp;
  while (row < count) {
    var line: int64 = ((int64)b * (int64)count + (int64)row) * (int64)width + (int64)(h * d);
    var lo: float32 = z32();
    var hi: float32 = z32();
    var j: int32 = 0;
    while (j < count) {
      var weight: float32 = sc[row * 33 + j];
      if (lane < d) { lo = lo + weight * vs[j * pad + lane]; }
      if (lane + 32 < d) { hi = hi + weight * vs[j * pad + lane + 32]; }
      j = j + 1;
    }
    if (lane < d) { out[line + (int64)lane] = lo * share; }
    if (lane + 32 < d) { out[line + (int64)(lane + 32)] = hi * share; }
    row = row + 8;
  }
}

kernel(block = 256) k_think_mingle_back(dp: float32*, dout: float32*, packed: float32*, stride: int64, count: int32, width: int32, heads: int32, eps: float32) {
  workgroup var kn: float32[2080];
  workgroup var qn: float32[2080];
  workgroup var vs: float32[2080];
  workgroup var go: float32[2080];
  workgroup var sc: float32[1056];
  workgroup var ds: float32[1056];
  workgroup var scales: float32[64];
  var group: int32 = block.x;
  var b: int32 = group / heads;
  var h: int32 = group - b * heads;
  var d: int32 = width / heads;
  var pad: int32 = d + 1;
  var lane: int32 = (int32)subgroup_local_id();
  var warp: int32 = thread.x / 32;
  var shrink: float32 = rsqrtf((float32)d);
  var share: float32 = one32() / (float32)count;
  var first: int32 = 0;
  while (first < count) {
    var r: int32 = first + warp;
    if (r < count) {
      var line: int64 = ((int64)b * (int64)count + (int64)r) * stride + (int64)(h * d);
      var wide: int64 = ((int64)b * (int64)count + (int64)r) * (int64)width + (int64)(h * d);
      var k_lo: float32 = z32();
      var k_hi: float32 = z32();
      var q_lo: float32 = z32();
      var q_hi: float32 = z32();
      if (lane < d) {
        k_lo = packed[line + (int64)lane];
        q_lo = packed[line + (int64)(2 * width + lane)];
        vs[r * pad + lane] = packed[line + (int64)(width + lane)];
        go[r * pad + lane] = dout[wide + (int64)lane];
      }
      if (lane + 32 < d) {
        k_hi = packed[line + (int64)(lane + 32)];
        q_hi = packed[line + (int64)(2 * width + lane + 32)];
        vs[r * pad + lane + 32] = packed[line + (int64)(width + lane + 32)];
        go[r * pad + lane + 32] = dout[wide + (int64)(lane + 32)];
      }
      var rk: float32 = shrink * rsqrtf(subgroup_reduce_add(k_lo * k_lo + k_hi * k_hi) / (float32)d + eps);
      var rq: float32 = rsqrtf(subgroup_reduce_add(q_lo * q_lo + q_hi * q_hi) / (float32)d + eps);
      if (lane == 0) {
        scales[2 * r] = rk;
        scales[2 * r + 1] = rq;
      }
      if (lane < d) {
        kn[r * pad + lane] = k_lo * rk;
        qn[r * pad + lane] = q_lo * rq;
      }
      if (lane + 32 < d) {
        kn[r * pad + lane + 32] = k_hi * rk;
        qn[r * pad + lane + 32] = q_hi * rq;
      }
    }
    first = first + 8;
  }
  barrier();
  var cell: int32 = thread.x;
  while (cell < count * count) {
    var i: int32 = cell / count;
    var j: int32 = cell - i * count;
    var hit: float32 = z32();
    var pull: float32 = z32();
    var f: int32 = 0;
    while (f < d) {
      hit = hit + qn[i * pad + f] * kn[j * pad + f];
      pull = pull + go[i * pad + f] * vs[j * pad + f];
      f = f + 1;
    }
    sc[i * 33 + j] = hit;
    ds[i * 33 + j] = pull * share;
    cell = cell + 256;
  }
  barrier();
  first = 0;
  while (first < count) {
    var r: int32 = first + warp;
    if (r < count) {
      var line: int64 = ((int64)b * (int64)count + (int64)r) * stride + (int64)(h * d);
      var dv_lo: float32 = z32();
      var dv_hi: float32 = z32();
      var dk_lo: float32 = z32();
      var dk_hi: float32 = z32();
      var dq_lo: float32 = z32();
      var dq_hi: float32 = z32();
      var other: int32 = 0;
      while (other < count) {
        var into: float32 = sc[other * 33 + r];
        var back: float32 = ds[other * 33 + r];
        var ahead: float32 = ds[r * 33 + other];
        if (lane < d) {
          dv_lo = dv_lo + into * go[other * pad + lane];
          dk_lo = dk_lo + back * qn[other * pad + lane];
          dq_lo = dq_lo + ahead * kn[other * pad + lane];
        }
        if (lane + 32 < d) {
          dv_hi = dv_hi + into * go[other * pad + lane + 32];
          dk_hi = dk_hi + back * qn[other * pad + lane + 32];
          dq_hi = dq_hi + ahead * kn[other * pad + lane + 32];
        }
        other = other + 1;
      }
      var k_lo: float32 = z32();
      var k_hi: float32 = z32();
      var q_lo: float32 = z32();
      var q_hi: float32 = z32();
      if (lane < d) {
        k_lo = kn[r * pad + lane];
        q_lo = qn[r * pad + lane];
      }
      if (lane + 32 < d) {
        k_hi = kn[r * pad + lane + 32];
        q_hi = qn[r * pad + lane + 32];
      }
      var lean: float32 = subgroup_reduce_add(dk_lo * k_lo + dk_hi * k_hi);
      var mean: float32 = subgroup_reduce_add(dq_lo * q_lo + dq_hi * q_hi) / (float32)d;
      var rk: float32 = scales[2 * r];
      var rq: float32 = scales[2 * r + 1];
      if (lane < d) {
        dp[line + (int64)lane] = rk * (dk_lo - k_lo * lean);
        dp[line + (int64)(width + lane)] = dv_lo * share;
        dp[line + (int64)(2 * width + lane)] = rq * (dq_lo - q_lo * mean);
      }
      if (lane + 32 < d) {
        dp[line + (int64)(lane + 32)] = rk * (dk_hi - k_hi * lean);
        dp[line + (int64)(width + lane + 32)] = dv_hi * share;
        dp[line + (int64)(2 * width + lane + 32)] = rq * (dq_hi - q_hi * mean);
      }
    }
    first = first + 8;
  }
}

fn small_mingle(count: int64, width: int64, heads: int64) -> bool {
  return count <= 32 && width / heads <= 64;
}

struct PonderParts {
  here: float32*;
  cat: float32*;
  mn: float32*;
  pre: float32*;
  act: float32*;
  sum: float32*;
  amt: float32*;
  rstd: float32*;
  qr: float32*;
  packed: float32*;
  w1: float32*;
  w2: float32*;
  mix: MingleParts;
}

struct PonderBook {
  here: float32*;
  cat: float32*;
  mn: float32*;
  pre: float32*;
  w1: float32*;
  w2: float32*;
  dp: float32*;
  dtold: float32*;
  dpre: float32*;
  dsum: float32*;
  dz: float32*;
  group: int64;
  done: int64*;
  seen: bool*;
}

const BOOK_ROWS: int64 = 4096;

kernel(block = 256) k_side_by_side(dst: float32*, left: float32*, right: float32*, rows: int64, cols: int64) {
  var i: int64 = (int64)block.x * 256 + (int64)thread.x;
  var step: int64 = (int64)grid_dim.x * 256;
  var both: int64 = 2 * cols;
  while (i < rows * both) {
    var r: int64 = i / both;
    var j: int64 = i - r * both;
    if (j < cols) { dst[i] = left[r * cols + j]; } else { dst[i] = right[r * cols + j - cols]; }
    i = i + step;
  }
}

kernel(block = 256) k_rows_rms(y: float32*, ldy: int64, x: float32*, ldx: int64, rstd: float32*, rows: int32, cols: int32, eps: float32) {
  var row: int32 = block.x * 8 + thread.x / 32;
  var lane: int32 = (int32)subgroup_local_id();
  if (row >= rows) { return; }
  var from: int64 = (int64)row * ldx;
  var into: int64 = (int64)row * ldy;
  var q: float32 = z32();
  var c: int32 = lane;
  while (c < cols) {
    var v: float32 = x[from + (int64)c];
    q = q + v * v;
    c = c + 32;
  }
  var rs: float32 = rsqrtf(subgroup_reduce_add(q) * (one32() / (float32)cols) + eps);
  if (lane == 0) { rstd[row] = rs; }
  c = lane;
  while (c < cols) {
    y[into + (int64)c] = x[from + (int64)c] * rs;
    c = c + 32;
  }
}

kernel(block = 256) k_rows_rms_back(dx: float32*, dy: float32*, ldy: int64, y: float32*, rstd: float32*, rows: int32, cols: int32) {
  var row: int32 = block.x * 8 + thread.x / 32;
  var lane: int32 = (int32)subgroup_local_id();
  if (row >= rows) { return; }
  var from: int64 = (int64)row * ldy;
  var into: int64 = (int64)row * (int64)cols;
  var rs: float32 = rstd[row];
  var acc: float32 = z32();
  var c: int32 = lane;
  while (c < cols) {
    acc = acc + dy[from + (int64)c] * y[from + (int64)c];
    c = c + 32;
  }
  var lean: float32 = subgroup_reduce_add(acc) / (float32)cols;
  c = lane;
  while (c < cols) {
    dx[into + (int64)c] = rs * (dy[from + (int64)c] - y[from + (int64)c] * lean);
    c = c + 32;
  }
}

fn lead_of(n: Node*, w: int64) -> int64 {
  return if n->ints[6] >= 0 { 4 * w } else { 3 * w };
}

fn wide_of(n: Node*, w: int64) -> int64 {
  return if n->ints[6] >= 0 { 2 * w } else { w };
}

fn stage_thinking(s: GpuState*, g: Graph*, n: Node*, into: Graph*, w: int64, w1: float32**, w2: float32**) {
  if (n->ints[6] < 0) {
    *w1 = g->data(n->ints[0]);
    *w2 = g->data(n->ints[1]);
    return;
  }
  var ww: int64 = w * w;
  var first: float32* = into->floats(4 * ww);
  var second: float32* = into->floats(2 * ww);
  dispatch k_scaled[spread(s, 3 * ww), 256](first, g->data(n->ints[0]), one32(), 3 * ww);
  dispatch k_scaled[spread(s, ww), 256](first + 3 * ww, g->data(n->ints[6]), one32(), ww);
  dispatch k_side_by_side[spread(s, 2 * ww), 256](second, g->data(n->ints[1]), g->data(n->ints[7]), w, w);
  *w1 = first;
  *w2 = second;
}

fn fwd_ponder_sum(s: GpuState*, g: Graph*, id: int32) {
  var n: Node* = g->node(id);
  var slots: int64 = n->i1;
  var each: int64 = n->i3;
  var rows: int64 = slots * each;
  var w: int64 = n->i4;
  var hid: int64 = g->nodes[n->ints[2]].value.shape.dims[0];
  var lead: int64 = lead_of(n, w);
  var wide: int64 = wide_of(n, w);
  var book: PonderBook* = (PonderBook*)g->host_alloc(sizeof(PonderBook));
  n->i2 = (int64)book;
  book->here = g->floats(rows * w);
  book->cat = g->floats(rows * wide);
  book->mn = g->floats(rows * w);
  book->pre = g->floats(rows * hid);
  stage_thinking(s, g, n, g, w, &book->w1, &book->w2);
  if (!n->requires) { return; }
  var group: int64 = (BOOK_ROWS + each - 1) / each;
  if (group > slots) { group = slots; }
  book->group = group;
  var held: int64 = group * each;
  book->dp = g->floats(held * lead);
  book->dtold = g->floats(held * w);
  book->dpre = g->floats(held * hid);
  book->dsum = g->floats(held * w);
  book->dz = g->floats(held);
  var parts: int64 = (slots + group - 1) / group;
  book->done = (int64*)g->host_alloc(parts * 8);
  book->seen = (bool*)g->host_alloc(slots);
  for i: int64 in 0..parts { book->done[i] = 0; }
  for i: int64 in 0..slots { book->seen[i] = false; }
}

fn book_size(n: Node*, book: PonderBook*, part: int64) -> int64 {
  var left: int64 = n->i1 - part * book->group;
  return if left < book->group { left } else { book->group };
}

fn thinking_grads(s: GpuState*, g: Graph*, t: Graph*, ids: int32*, rows: int64, w: int64, hid: int64, here: float32*, cat: float32*, mn: float32*, pre: float32*, dp: float32*, dtold: float32*, dpre: float32*, dsum: float32*, dz: float32*) {
  var looks: bool = ids[6] >= 0;
  var lead: int64 = if looks { 4 * w } else { 3 * w };
  var wide: int64 = if looks { 2 * w } else { w };
  var act: float32* = t->floats(rows * hid);
  dispatch k_unary[spread(s, rows * hid), 256](17, act, pre, z32(), z32(), rows * hid);
  run_gemm(s, t, gemm_shape(dsum, act, g->grad_of(ids[3]), w, hid, rows, w, hid, hid, true, false, true));
  run_gemm(s, t, gemm_shape(dpre, mn, g->grad_of(ids[2]), hid, w, rows, hid, w, w, true, false, true));
  run_gemm(s, t, gemm_shape(dtold, cat, g->grad_of(ids[1]), w, w, rows, w, wide, w, true, false, true));
  run_gemm(s, t, gemm_shape(dp, here, g->grad_of(ids[0]), 3 * w, w, rows, lead, w, w, true, false, true));
  run_gemm(s, t, gemm_shape(dz, here, g->grad_of(ids[4]), 1, w, rows, 1, w, w, true, false, true));
  sum_into(s, g->grad_of(ids[5]), dz, (float32*)0, 0, rows, one32(), true);
  if (looks) {
    run_gemm(s, t, gemm_shape(dp + 3 * w, here, g->grad_of(ids[6]), w, w, rows, lead, w, w, true, false, true));
    run_gemm(s, t, gemm_shape(dtold, cat + w, g->grad_of(ids[7]), w, w, rows, w, wide, w, true, false, true));
  }
}

fn book_flush(s: GpuState*, g: Graph*, n: Node*, t: Graph*, part: int64) {
  var book: PonderBook* = (PonderBook*)n->i2;
  var each: int64 = n->i3;
  var w: int64 = n->i4;
  var hid: int64 = g->nodes[n->ints[2]].value.shape.dims[0];
  var lead: int64 = lead_of(n, w);
  var wide: int64 = wide_of(n, w);
  var first: int64 = part * book->group;
  var count: int64 = book_size(n, book, part);
  var base: int64 = first * each;
  for slot: int64 in first..first + count {
    if (book->seen[slot]) { continue; }
    var at: int64 = (slot - first) * each;
    s->dev->fill(book->dp + at * lead, 0.0, each * lead);
    s->dev->fill(book->dtold + at * w, 0.0, each * w);
    s->dev->fill(book->dpre + at * hid, 0.0, each * hid);
    s->dev->fill(book->dsum + at * w, 0.0, each * w);
    s->dev->fill(book->dz + at, 0.0, each);
  }
  thinking_grads(s, g, t, n->ints, count * each, w, hid, book->here + base * w, book->cat + base * wide, book->mn + base * w, book->pre + base * hid, book->dp, book->dtold, book->dpre, book->dsum, book->dz);
}

fn back_ponder_sum(s: GpuState*, g: Graph*, id: int32) {
  var n: Node* = g->node(id);
  var book: PonderBook* = (PonderBook*)n->i2;
  var parts: int64 = (n->i1 + book->group - 1) / book->group;
  var t: Graph* = spare(s);
  for part: int64 in 0..parts {
    if (book->done[part] > 0 && book->done[part] < book_size(n, book, part)) { book_flush(s, g, n, t, part); }
  }
}

fn grid_states(g: Graph*, n: Node*, groups: int64, plane: int64) -> float32* {
  return ((ExactParts*)g->nodes[(int32)n->i3].i2)->states + n->i4 * groups * plane;
}

fn fwd_ponder(s: GpuState*, g: Graph*, id: int32) {
  var n: Node* = g->node(id);
  var sh: Shape = n->value.shape;
  var batch: int64 = sh.dims[0];
  var count: int64 = sh.dims[1];
  var w: int64 = sh.dims[2];
  var rows: int64 = batch * count;
  var all: int64 = rows * w;
  var hid: int64 = g->nodes[n->ints[2]].value.shape.dims[0];
  var heads: int64 = n->i0;
  var eps: float32 = (float32)1.0e-6;
  var size: int32 = (int32)rows;
  var cols: int32 = (int32)w;
  var lead: int64 = lead_of(n, w);
  var wide: int64 = wide_of(n, w);
  var looks: bool = n->i3 >= 0;
  var small: bool = small_mingle(count, w, heads);
  var t: Graph* = spare(s);
  var kept: Graph* = if n->requires { g } else { t };
  var p: PonderParts* = (PonderParts*)g->host_alloc(sizeof(PonderParts));
  n->i2 = (int64)p;
  if (n->c >= 0) {
    var book: PonderBook* = (PonderBook*)g->nodes[n->c].i2;
    var at: int64 = n->i1 * rows;
    p->here = book->here + at * w;
    p->cat = book->cat + at * wide;
    p->mn = book->mn + at * w;
    p->pre = book->pre + at * hid;
    p->act = t->floats(rows * hid);
    p->w1 = book->w1;
    p->w2 = book->w2;
  } else {
    p->here = kept->floats(all);
    p->cat = kept->floats(rows * wide);
    p->mn = kept->floats(all);
    p->pre = kept->floats(rows * hid);
    p->act = kept->floats(rows * hid);
    stage_thinking(s, g, n, kept, w, &p->w1, &p->w2);
  }
  p->sum = kept->floats(all);
  p->amt = kept->floats(rows);
  p->rstd = kept->floats(4 * rows);
  p->packed = if small || looks { kept->floats(rows * lead) } else { t->floats(rows * lead) };
  var heard: float32* = t->floats(all);
  var told: float32* = t->floats(all);
  var worked: float32* = t->floats(all);
  var rooms: float32* = g->data(n->a);
  var heed: float32* = if n->ints[8] >= 0 { g->data(n->ints[8]) } else { (float32*)0 };
  dispatch k_think_open[row_blocks(rows), 256](p->here, p->rstd, p->amt, rooms, g->data(n->b), heed, g->data(n->ints[4]), g->data(n->ints[5]), size, cols, eps);
  run_gemm(s, t, gemm_shape(p->here, p->w1, p->packed, rows, lead, w, w, w, lead, false, true, false));
  if (small) {
    dispatch k_think_mingle[(int32)(batch * heads), 256](heard, p->packed, lead, (int32)count, cols, (int32)heads, eps);
  } else {
    mingle_fwd(s, kept, t, &p->mix, p->packed, lead, heard, batch, count, w, heads);
  }
  dispatch k_rows_rms[row_blocks(rows), 256](p->cat, wide, heard, w, p->rstd + rows, size, cols, eps);
  if (looks) {
    var d: int64 = w / heads;
    if (d > 64) { mmll_fail("lookups on the GPU take heads of at most 64 values, got {d}"); }
    var groups: int64 = batch * heads;
    var found: float32* = t->floats(all);
    p->qr = kept->floats(rows * heads);
    dispatch k_think_consult[(int32)groups, 256](found, p->packed + 3 * w, p->qr, p->packed + 3 * w, lead, grid_states(g, n, groups, d * d), (int32)count, cols, (int32)heads, eps);
    dispatch k_rows_rms[row_blocks(rows), 256](p->cat + w, wide, found, w, p->rstd + 3 * rows, size, cols, eps);
  }
  run_gemm(s, t, gemm_shape(p->cat, p->w2, told, rows, w, wide, wide, wide, w, false, true, false));
  dispatch k_think_open[row_blocks(rows), 256](p->mn, p->rstd + 2 * rows, (float32*)0, rooms, told, (float32*)0, (float32*)0, (float32*)0, size, cols, eps);
  run_gemm(s, t, gemm_shape(p->mn, g->data(n->ints[2]), p->pre, rows, hid, w, w, w, hid, false, true, false));
  dispatch k_unary[spread(s, rows * hid), 256](17, p->act, p->pre, z32(), z32(), rows * hid);
  run_gemm(s, t, gemm_shape(p->act, g->data(n->ints[3]), worked, rows, w, hid, hid, hid, w, false, true, false));
  dispatch k_think_close[spread(s, all), 256](n->value.data, p->sum, rooms, told, worked, p->amt, all, w);
}

fn back_ponder(s: GpuState*, g: Graph*, id: int32) {
  var n: Node* = g->node(id);
  var sh: Shape = n->value.shape;
  var batch: int64 = sh.dims[0];
  var count: int64 = sh.dims[1];
  var w: int64 = sh.dims[2];
  var rows: int64 = batch * count;
  var all: int64 = rows * w;
  var hid: int64 = g->nodes[n->ints[2]].value.shape.dims[0];
  var heads: int64 = n->i0;
  var size: int32 = (int32)rows;
  var cols: int32 = (int32)w;
  var lead: int64 = lead_of(n, w);
  var wide: int64 = wide_of(n, w);
  var looks: bool = n->i3 >= 0;
  var p: PonderParts* = (PonderParts*)n->i2;
  var t: Graph* = spare(s);
  var wants: int32 = 0;
  var drooms: float32* = (float32*)0;
  var dseats: float32* = (float32*)0;
  if (g->nodes[n->a].requires) {
    wants = wants + 1;
    drooms = g->grad_of(n->a);
  }
  if (g->nodes[n->b].requires) {
    wants = wants + 2;
    dseats = g->grad_of(n->b);
  }
  var heed: float32* = (float32*)0;
  var dheed: float32* = (float32*)0;
  if (n->ints[8] >= 0) {
    heed = g->data(n->ints[8]);
    if (g->nodes[n->ints[8]].requires) {
      wants = wants + 4;
      dheed = g->grad_of(n->ints[8]);
    }
  }
  var booked: bool = n->c >= 0;
  var dsum: float32* = (float32*)0;
  var dz: float32* = (float32*)0;
  var dpre: float32* = (float32*)0;
  var dtold: float32* = (float32*)0;
  var dp: float32* = (float32*)0;
  if (booked) {
    var book: PonderBook* = (PonderBook*)g->nodes[n->c].i2;
    var at: int64 = (n->i1 % book->group) * rows;
    dsum = book->dsum + at * w;
    dz = book->dz + at;
    dpre = book->dpre + at * hid;
    dtold = book->dtold + at * w;
    dp = book->dp + at * lead;
  } else {
    dsum = t->floats(all);
    dz = t->floats(rows);
    dpre = t->floats(rows * hid);
    dtold = t->floats(all);
    dp = t->floats(rows * lead);
  }
  var dact: float32* = t->floats(rows * hid);
  var dmn: float32* = t->floats(all);
  var dcat: float32* = t->floats(rows * wide);
  var dheard: float32* = t->floats(all);
  var dhere: float32* = t->floats(all);
  dispatch k_think_close_back[row_blocks(rows), 256](dsum, dz, drooms, n->grad, p->sum, p->amt, size, cols, wants & 1);
  run_gemm(s, t, gemm_shape(dsum, g->data(n->ints[3]), dact, rows, hid, w, w, hid, hid, false, false, false));
  dispatch k_unary_back[spread(s, rows * hid), 256](17, dpre, dact, p->pre, p->pre, z32(), z32(), rows * hid, 1);
  run_gemm(s, t, gemm_shape(dpre, g->data(n->ints[2]), dmn, rows, w, hid, hid, w, w, false, false, false));
  dispatch k_think_mid_back[row_blocks(rows), 256](drooms, dtold, dmn, dsum, p->mn, p->rstd + 2 * rows, size, cols, wants & 1);
  run_gemm(s, t, gemm_shape(dtold, p->w2, dcat, rows, wide, w, w, wide, wide, false, false, false));
  if (looks) {
    var d: int64 = w / heads;
    var groups: int64 = batch * heads;
    var grid: Node* = g->node((int32)n->i3);
    var dfound: float32* = t->floats(all);
    dispatch k_rows_rms_back[row_blocks(rows), 256](dfound, dcat + w, wide, p->cat + w, p->rstd + 3 * rows, size, cols);
    var taps: float32* = if grid->requires { (float32*)grid->i5 + n->i4 * groups * d * d } else { (float32*)0 };
    dispatch k_think_consult_back[(int32)groups, 256](dp + 3 * w, taps, dfound, p->packed + 3 * w, lead, p->qr, grid_states(g, n, groups, d * d), (int32)count, cols, (int32)heads);
  }
  dispatch k_rows_rms_back[row_blocks(rows), 256](dheard, dcat, wide, p->cat, p->rstd + rows, size, cols);
  if (small_mingle(count, w, heads)) {
    dispatch k_think_mingle_back[(int32)(batch * heads), 256](dp, dheard, p->packed, lead, (int32)count, cols, (int32)heads, (float32)1.0e-6);
  } else {
    mingle_back(s, t, &p->mix, dheard, dp, lead, batch, count, w, heads, 43);
  }
  run_gemm(s, t, gemm_shape(dp, p->w1, dhere, rows, w, lead, lead, w, w, false, false, false));
  if (!booked) { thinking_grads(s, g, t, n->ints, rows, w, hid, p->here, p->cat, p->mn, p->pre, dp, dtold, dpre, dsum, dz); }
  dispatch k_think_open_back[row_blocks(rows), 256](drooms, dseats, dheed, dhere, dz, g->data(n->ints[4]), p->here, heed, p->rstd, size, cols, wants);
  if (booked) {
    var owner: Node* = g->node(n->c);
    var book: PonderBook* = (PonderBook*)owner->i2;
    var part: int64 = n->i1 / book->group;
    book->seen[n->i1] = true;
    book->done[part] = book->done[part] + 1;
    if (book->done[part] == book_size(owner, book, part)) { book_flush(s, g, owner, t, part); }
  }
}

fn fwd_consult(s: GpuState*, g: Graph*, id: int32) {
  var n: Node* = g->node(id);
  var sh: Shape = n->value.shape;
  var count: int64 = sh.dims[1];
  var w: int64 = sh.dims[2];
  var heads: int64 = n->i0;
  var d: int64 = w / heads;
  var rows: int64 = sh.dims[0] * count;
  var all: int64 = rows * w;
  var groups: int64 = sh.dims[0] * heads;
  var t: Graph* = spare(s);
  var state: float32* = ((ExactParts*)g->nodes[n->b].i2)->states + n->i1 * groups * d * d;
  var mean: float32* = t->floats(rows * heads);
  var flat: float32* = t->floats(all);
  var found: float32* = t->floats(all);
  dispatch k_norm[row_blocks(rows * heads), 256](1, n->saved, g->data(n->a), (float32*)0, (float32*)0, mean, n->saved2, (int32)(rows * heads), (int32)d, (float32)1.0e-6);
  dispatch k_exact_move[spread(s, all), 256](flat, n->saved, all, count, count, w, heads, 1);
  run_gemm(s, t, batched(flat, state, found, count, d, d, d, d, false, true, false, groups, count * d, d * d, count * d));
  dispatch k_exact_move[spread(s, all), 256](found, n->value.data, all, count, count, w, heads, 0);
}

fn back_consult(s: GpuState*, g: Graph*, id: int32) {
  var n: Node* = g->node(id);
  var sh: Shape = n->value.shape;
  var count: int64 = sh.dims[1];
  var w: int64 = sh.dims[2];
  var heads: int64 = n->i0;
  var d: int64 = w / heads;
  var rows: int64 = sh.dims[0] * count;
  var all: int64 = rows * w;
  var groups: int64 = sh.dims[0] * heads;
  var t: Graph* = spare(s);
  var grid: Node* = g->node(n->b);
  var state: float32* = ((ExactParts*)grid->i2)->states + n->i1 * groups * d * d;
  var flat: float32* = t->floats(all);
  var dflat: float32* = t->floats(all);
  dispatch k_exact_move[spread(s, all), 256](dflat, n->grad, all, count, count, w, heads, 1);
  if (grid->requires) {
    dispatch k_exact_move[spread(s, all), 256](flat, n->saved, all, count, count, w, heads, 1);
    run_gemm(s, t, batched(dflat, flat, (float32*)grid->i5 + n->i1 * groups * d * d, d, d, count, d, d, true, false, true, groups, count * d, count * d, d * d));
  }
  if (!g->nodes[n->a].requires) { return; }
  var pulled: float32* = t->floats(all);
  var wide: float32* = t->floats(all);
  var raw: float32* = t->floats(all);
  run_gemm(s, t, batched(dflat, state, pulled, count, d, d, d, d, false, false, false, groups, count * d, d * d, count * d));
  dispatch k_exact_move[spread(s, all), 256](pulled, wide, all, count, count, w, heads, 0);
  dispatch k_rms_back[row_blocks(rows * heads), 256](raw, wide, n->saved, n->saved2, (int32)(rows * heads), (int32)d);
  dispatch k_add[spread(s, all), 256](g->grad_of(n->a), raw, one32(), all);
}

struct ForeseeParts {
  x: float32*;
  h: float32*;
  gn: float32*;
  tn: float32*;
  rstd: float32*;
}

const FORESEE_ROWS: int64 = 8192;

fn foresee_slab(slots: int64, per: int64) -> int64 {
  var slab: int64 = FORESEE_ROWS / per;
  if (slab < 1) { slab = 1; }
  return if slab > slots { slots } else { slab };
}

fn fwd_foresee(s: GpuState*, g: Graph*, id: int32) {
  var n: Node* = g->node(id);
  var ts: Shape = g->nodes[n->a].value.shape;
  var ss: Shape = g->nodes[n->b].value.shape;
  var w: int64 = ss.last();
  var unit: int64 = ss.size();
  var per: int64 = unit / w;
  var hid: int64 = g->nodes[n->c].value.shape.dims[0];
  var rounds: int64 = ts.dims[1];
  var slots: int64 = (ts.dims[0] - n->i5) * rounds;
  var rows: int64 = slots * per;
  var all: int64 = rows * w;
  var eps: float32 = (float32)1.0e-6;
  var cols: int32 = (int32)w;
  var t: Graph* = spare(s);
  var p: ForeseeParts* = (ForeseeParts*)g->host_alloc(sizeof(ForeseeParts));
  n->i2 = (int64)p;
  p->x = g->floats(all);
  p->h = g->floats(rows * hid);
  p->gn = g->floats(all);
  p->tn = g->floats(all);
  p->rstd = g->floats(2 * rows);
  var slab: int64 = foresee_slab(slots, per);
  var mean: float32* = t->floats(slab * per);
  var unused: float32* = t->floats(slab * per);
  var xin: float32* = t->floats(slab * unit);
  var hg: float32* = t->floats(slab * per * hid);
  var guess: float32* = t->floats(slab * unit);
  var tin: float32* = t->floats(slab * unit);
  var trace: float32* = g->data(n->a);
  var first: int64 = 0;
  while (first < slots) {
    var count: int64 = if slots - first < slab { slots - first } else { slab };
    var r0: int64 = first * per;
    var nrow: int64 = count * per;
    var at: int64 = first * unit;
    var size: int32 = (int32)nrow;
    dispatch k_period_add[spread(s, count * unit), 256](xin, trace + at, g->data(n->b), count * unit, unit);
    dispatch k_norm[row_blocks(nrow), 256](1, p->x + at, xin, (float32*)0, (float32*)0, mean, p->rstd + r0, size, cols, eps);
    run_gemm(s, t, gemm_shape(p->x + at, g->data(n->c), p->h + r0 * hid, nrow, hid, w, w, w, hid, false, true, false));
    dispatch k_unary[spread(s, nrow * hid), 256](17, hg, p->h + r0 * hid, z32(), z32(), nrow * hid);
    run_gemm(s, t, gemm_shape(hg, g->data(n->ints[0]), guess, nrow, w, hid, hid, hid, w, false, true, false));
    dispatch k_norm[row_blocks(nrow), 256](1, p->gn + at, guess, (float32*)0, (float32*)0, mean, p->rstd + rows + r0, size, cols, eps);
    dispatch k_foresee_pick[spread(s, count * unit), 256](tin, trace, count * unit, rounds, n->i5, unit, first);
    dispatch k_norm[row_blocks(nrow), 256](1, p->tn + at, tin, (float32*)0, (float32*)0, mean, unused, size, cols, eps);
    sum_into(s, n->value.data, p->gn + at, p->tn + at, 2, count * unit, n->f0, first > 0);
    first = first + count;
  }
}

fn back_foresee(s: GpuState*, g: Graph*, id: int32) {
  var n: Node* = g->node(id);
  var ts: Shape = g->nodes[n->a].value.shape;
  var ss: Shape = g->nodes[n->b].value.shape;
  var w: int64 = ss.last();
  var unit: int64 = ss.size();
  var per: int64 = unit / w;
  var hid: int64 = g->nodes[n->c].value.shape.dims[0];
  var slots: int64 = (ts.dims[0] - n->i5) * ts.dims[1];
  var rows: int64 = slots * per;
  var cols: int32 = (int32)w;
  var p: ForeseeParts* = (ForeseeParts*)n->i2;
  var t: Graph* = spare(s);
  var slab: int64 = foresee_slab(slots, per);
  var dgn: float32* = t->floats(slab * unit);
  var dguess: float32* = t->floats(slab * unit);
  var hg: float32* = t->floats(slab * per * hid);
  var dhg: float32* = t->floats(slab * per * hid);
  var dh: float32* = t->floats(slab * per * hid);
  var dx: float32* = t->floats(slab * unit);
  var first: int64 = 0;
  while (first < slots) {
    var count: int64 = if slots - first < slab { slots - first } else { slab };
    var r0: int64 = first * per;
    var nrow: int64 = count * per;
    var at: int64 = first * unit;
    var size: int32 = (int32)nrow;
    var h: float32* = p->h + r0 * hid;
    dispatch k_foresee_slope[spread(s, count * unit), 256](dgn, p->gn + at, p->tn + at, n->grad, n->f0 + n->f0, count * unit);
    dispatch k_rms_back[row_blocks(nrow), 256](dguess, dgn, p->gn + at, p->rstd + rows + r0, size, cols);
    dispatch k_unary[spread(s, nrow * hid), 256](17, hg, h, z32(), z32(), nrow * hid);
    run_gemm(s, t, gemm_shape(dguess, hg, g->grad_of(n->ints[0]), w, hid, nrow, w, hid, hid, true, false, true));
    run_gemm(s, t, gemm_shape(dguess, g->data(n->ints[0]), dhg, nrow, hid, w, w, hid, hid, false, false, false));
    dispatch k_unary_back[spread(s, nrow * hid), 256](17, dh, dhg, h, h, z32(), z32(), nrow * hid, 1);
    run_gemm(s, t, gemm_shape(dh, p->x + at, g->grad_of(n->c), hid, w, nrow, hid, w, w, true, false, true));
    run_gemm(s, t, gemm_shape(dh, g->data(n->c), dx, nrow, w, hid, hid, w, w, false, false, false));
    dispatch k_rms_back[row_blocks(nrow), 256](dgn, dx, p->x + at, p->rstd + r0, size, cols);
    if (g->nodes[n->a].requires) { dispatch k_add[spread(s, count * unit), 256](g->grad_of(n->a) + at, dgn, one32(), count * unit); }
    if (g->nodes[n->b].requires) { dispatch k_period_sum[spread(s, unit), 256](g->grad_of(n->b), dgn, unit, count); }
    first = first + count;
  }
}
fn conv_record(g: Graph*, n: Node*) -> Conv {
  var sx: Shape = g->nodes[n->a].value.shape;
  var sw: Shape = g->nodes[n->b].value.shape;
  var q: Conv;
  q.n = (int32)sx.dims[0];
  q.c = (int32)sx.dims[1];
  q.h = (int32)sx.dims[2];
  q.w = (int32)sx.dims[3];
  q.kh = (int32)sw.dims[2];
  q.kw = (int32)sw.dims[3];
  q.oh = (int32)n->value.shape.dims[2];
  q.ow = (int32)n->value.shape.dims[3];
  q.stride = (int32)n->i0;
  q.pad = (int32)n->i1;
  q.dilation = (int32)n->i2;
  return q;
}

fn fwd_conv(s: GpuState*, g: Graph*, id: int32) {
  var n: Node* = g->node(id);
  var q: Conv = conv_record(g, n);
  var o: int64 = g->nodes[n->b].value.shape.dims[0];
  var ckk: int64 = (int64)q.c * (int64)q.kh * (int64)q.kw;
  var p_count: int64 = (int64)q.oh * (int64)q.ow;
  var np: int64 = (int64)q.n * p_count;
  dispatch k_im2col[spread(s, ckk * np), 256](n->saved, g->data(n->a), q);
  var gs: GemmShape = gemm_shape(g->data(n->b), n->saved, n->value.data, o, p_count, ckk, ckk, np, p_count, false, false, false);
  gs.inner = (int64)q.n;
  gs.sb_inner = p_count;
  gs.sc_inner = o * p_count;
  run_gemm(s, g, gs);
  if (n->c >= 0) {
    dispatch k_channel_bias[spread(s, (int64)q.n * o * p_count), 256](n->value.data, g->data(n->c), (int64)q.n, o, p_count);
  }
}

fn back_conv(s: GpuState*, g: Graph*, id: int32) {
  var n: Node* = g->node(id);
  var q: Conv = conv_record(g, n);
  var o: int64 = g->nodes[n->b].value.shape.dims[0];
  var ckk: int64 = (int64)q.c * (int64)q.kh * (int64)q.kw;
  var p_count: int64 = (int64)q.oh * (int64)q.ow;
  var np: int64 = (int64)q.n * p_count;
  var dout: float32* = n->grad;
  var dout_t: float32* = g->floats(o * np);
  var p: Bcast;
  p.rank = 3;
  p.count = (int32)(o * np);
  p.dims[0] = (int32)o;
  p.dims[1] = q.n;
  p.dims[2] = (int32)p_count;
  p.sa[0] = (int32)p_count;
  p.sa[1] = (int32)(o * p_count);
  p.sa[2] = 1;
  dispatch k_permute[cover(o * np), 256](dout_t, dout, p, 0);
  if (g->nodes[n->b].requires) {
    run_gemm(s, g, gemm_shape(dout_t, n->saved, g->grad_of(n->b), o, ckk, np, np, np, ckk, false, true, true));
  }
  if (n->c >= 0 && g->nodes[n->c].requires) {
    dispatch k_channel_sums[(int32)o, 256](g->grad_of(n->c), dout, (float32*)0, (float32*)0, (float32*)0, q.n, (int32)o, (int32)p_count, 0);
  }
  if (g->nodes[n->a].requires) {
    var dcols: float32* = g->floats(ckk * np);
    run_gemm(s, g, gemm_shape(g->data(n->b), dout_t, dcols, ckk, np, o, ckk, np, np, true, false, false));
    dispatch k_col2im[spread(s, (int64)q.n * (int64)q.c * (int64)q.h * (int64)q.w), 256](g->grad_of(n->a), dcols, q);
  }
}

fn fwd_pool(s: GpuState*, g: Graph*, id: int32) {
  var n: Node* = g->node(id);
  var xs: Shape = g->nodes[n->a].value.shape;
  var planes: int64 = xs.dims[0] * xs.dims[1];
  var oh: int64 = n->value.shape.dims[2];
  var ow: int64 = n->value.shape.dims[3];
  var max: int32 = if n->op == OP_MAX_POOL2D { 1 } else { 0 };
  dispatch k_pool[spread(s, planes * oh * ow), 256](n->value.data, n->ints, g->data(n->a), planes, (int32)xs.dims[2], (int32)xs.dims[3], (int32)oh, (int32)ow, (int32)n->i0, (int32)n->i1, (int32)n->i2, max);
}

fn back_pool(s: GpuState*, g: Graph*, id: int32) {
  var n: Node* = g->node(id);
  if (!g->nodes[n->a].requires) { return; }
  var xs: Shape = g->nodes[n->a].value.shape;
  var planes: int64 = xs.dims[0] * xs.dims[1];
  var oh: int64 = n->value.shape.dims[2];
  var ow: int64 = n->value.shape.dims[3];
  var max: int32 = if n->op == OP_MAX_POOL2D { 1 } else { 0 };
  dispatch k_pool_back[spread(s, planes * xs.dims[2] * xs.dims[3]), 256](g->grad_of(n->a), n->grad, n->ints, planes, (int32)xs.dims[2], (int32)xs.dims[3], (int32)oh, (int32)ow, (int32)n->i0, (int32)n->i1, (int32)n->i2, max);
}

fn fwd_batch_norm(s: GpuState*, g: Graph*, id: int32) {
  var n: Node* = g->node(id);
  var sh: Shape = n->value.shape;
  var c: int64 = sh.dims[1];
  dispatch k_batch_norm[(int32)c, 256](n->value.data, g->data(n->a), g->data(n->b), g->data(n->c), n->saved, n->saved2, (float32*)n->i2, (float32*)n->i3, (int32)sh.dims[0], (int32)c, (int32)n->i1, n->f0, n->f1, (int32)n->i0);
}

fn back_batch_norm(s: GpuState*, g: Graph*, id: int32) {
  var n: Node* = g->node(id);
  var sh: Shape = n->value.shape;
  var c: int64 = sh.dims[1];
  var dx: float32* = if g->nodes[n->a].requires { g->grad_of(n->a) } else { (float32*)0 };
  var dgamma: float32* = if g->nodes[n->b].requires { g->grad_of(n->b) } else { (float32*)0 };
  var dbeta: float32* = if g->nodes[n->c].requires { g->grad_of(n->c) } else { (float32*)0 };
  dispatch k_batch_norm_back[(int32)c, 256](dx, dgamma, dbeta, n->grad, g->data(n->a), g->data(n->b), n->saved, n->saved2, (int32)sh.dims[0], (int32)c, (int32)n->i1, (int32)n->i0);
}

kernel(block = 256) k_add_mul(out: float32*, a: float32*, b: float32*, c: float32*, n: int64) {
  var i: int64 = (int64)block.x * 256 + (int64)thread.x;
  var step: int64 = (int64)grid_dim.x * 256;
  while (i < n) {
    out[i] = (a[i] + b[i]) * c[i];
    i = i + step;
  }
}

kernel(block = 256) k_add_mul_back(da: float32*, db: float32*, dc: float32*, dy: float32*, a: float32*, b: float32*, c: float32*, n: int64) {
  var i: int64 = (int64)block.x * 256 + (int64)thread.x;
  var step: int64 = (int64)grid_dim.x * 256;
  while (i < n) {
    var slope: float32 = dy[i];
    if (da != (float32*)0) { da[i] = da[i] + slope * c[i]; }
    if (db != (float32*)0) { db[i] = db[i] + slope * c[i]; }
    if (dc != (float32*)0) { dc[i] = dc[i] + slope * (a[i] + b[i]); }
    i = i + step;
  }
}

fn fwd_add_mul(s: GpuState*, g: Graph*, id: int32) {
  var n: Node* = g->node(id);
  var size: int64 = n->value.shape.size();
  dispatch k_add_mul[spread(s, size), 256](n->value.data, g->data(n->a), g->data(n->b), g->data(n->c), size);
}

fn back_add_mul(s: GpuState*, g: Graph*, id: int32) {
  var n: Node* = g->node(id);
  var size: int64 = n->value.shape.size();
  var da: float32* = if g->nodes[n->a].requires { g->grad_of(n->a) } else { (float32*)0 };
  var db: float32* = if g->nodes[n->b].requires { g->grad_of(n->b) } else { (float32*)0 };
  var dc: float32* = if g->nodes[n->c].requires { g->grad_of(n->c) } else { (float32*)0 };
  dispatch k_add_mul_back[spread(s, size), 256](da, db, dc, n->grad, g->data(n->a), g->data(n->b), g->data(n->c), size);
}

kernel(block = 256) k_pairing(out: float32*, x: float32*, head: float32*, b: int64, t: int64, w: int64) {
  var i: int64 = (int64)block.x * 256 + (int64)thread.x;
  var step: int64 = (int64)grid_dim.x * 256;
  var both: int64 = 2 * w;
  while (i < b * t * both) {
    var row: int64 = i / both;
    var c: int64 = i - row * both;
    var at: int64 = row % t;
    if (c < w) {
      out[i] = x[row * w + c];
    } else if (at > 0) {
      out[i] = x[(row - 1) * w + c - w];
    } else if (head != (float32*)0) {
      out[i] = head[(row / t) * w + c - w];
    } else {
      out[i] = z32();
    }
    i = i + step;
  }
}

kernel(block = 256) k_pairing_back(dx: float32*, dy: float32*, b: int64, t: int64, w: int64, fresh: int32) {
  var i: int64 = (int64)block.x * 256 + (int64)thread.x;
  var step: int64 = (int64)grid_dim.x * 256;
  while (i < b * t * w) {
    var row: int64 = i / w;
    var c: int64 = i - row * w;
    var v: float32 = dy[row * 2 * w + c];
    if (row % t + 1 < t) { v = v + dy[(row + 1) * 2 * w + w + c]; }
    if (fresh != 0) { dx[i] = v; } else { dx[i] = dx[i] + v; }
    i = i + step;
  }
}

kernel(block = 256) k_pairing_head(dh: float32*, dy: float32*, b: int64, t: int64, w: int64) {
  var i: int64 = (int64)block.x * 256 + (int64)thread.x;
  var step: int64 = (int64)grid_dim.x * 256;
  while (i < b * w) {
    var r: int64 = i / w;
    dh[i] = dh[i] + dy[r * t * 2 * w + w + i - r * w];
    i = i + step;
  }
}

kernel(block = 256) k_mix(out: float32*, a: float32*, x: float32*, y: float32*, rows: int64, picks: int64, k: int64, first: int64, w: int64) {
  var i: int64 = (int64)block.x * 256 + (int64)thread.x;
  var step: int64 = (int64)grid_dim.x * 256;
  var second: int64 = k - first;
  while (i < rows * picks * w) {
    var c: int64 = i % w;
    var rp: int64 = i / w;
    var r: int64 = rp / picks;
    var sum: float32 = z32();
    for j: int64 in 0..first { sum = sum + a[rp * k + j] * x[(r * first + j) * w + c]; }
    for j: int64 in 0..second { sum = sum + a[rp * k + first + j] * y[(r * second + j) * w + c]; }
    out[i] = sum;
    i = i + step;
  }
}

kernel(block = 256) k_mix_back_x(dx: float32*, a: float32*, dy: float32*, rows: int64, picks: int64, k: int64, lo: int64, part: int64, w: int64, fresh: int32) {
  var i: int64 = (int64)block.x * 256 + (int64)thread.x;
  var step: int64 = (int64)grid_dim.x * 256;
  while (i < rows * part * w) {
    var c: int64 = i % w;
    var rj: int64 = i / w;
    var r: int64 = rj / part;
    var j: int64 = rj - r * part;
    var sum: float32 = z32();
    for p: int64 in 0..picks { sum = sum + a[(r * picks + p) * k + lo + j] * dy[(r * picks + p) * w + c]; }
    if (fresh != 0) { dx[i] = sum; } else { dx[i] = dx[i] + sum; }
    i = i + step;
  }
}

kernel(block = 256) k_mix_back_a(da: float32*, x: float32*, y: float32*, dy: float32*, rows: int64, picks: int64, k: int64, first: int64, w: int64, fresh: int32) {
  var at: int64 = (int64)block.x * 8 + (int64)(thread.x / 32);
  var lane: int64 = (int64)subgroup_local_id();
  if (at >= rows * picks * k) { return; }
  var j: int64 = at % k;
  var rp: int64 = at / k;
  var r: int64 = rp / picks;
  var src: float32* = if j < first { x + (r * first + j) * w } else { y + (r * (k - first) + j - first) * w };
  var sum: float32 = z32();
  var c: int64 = lane;
  while (c < w) {
    sum = sum + dy[rp * w + c] * src[c];
    c = c + 32;
  }
  var total: float32 = subgroup_reduce_add(sum);
  if (lane == 0) {
    if (fresh != 0) { da[at] = total; } else { da[at] = da[at] + total; }
  }
}

fn mix_first(g: Graph*, n: Node*, k: int64) -> int64 {
  return if n->c >= 0 { n->i0 } else { k };
}

fn fwd_mix(s: GpuState*, g: Graph*, id: int32) {
  var n: Node* = g->node(id);
  var sh: Shape = n->value.shape;
  var rows: int64 = sh.dims[0];
  var picks: int64 = sh.dims[1];
  var w: int64 = sh.dims[2];
  var k: int64 = g->nodes[n->a].value.shape.size() / (rows * picks);
  var first: int64 = mix_first(g, n, k);
  var y: float32* = if n->c >= 0 { g->data(n->c) } else { (float32*)0 };
  dispatch k_mix[spread(s, sh.size()), 256](n->value.data, g->data(n->a), g->data(n->b), y, rows, picks, k, first, w);
}

fn back_mix(s: GpuState*, g: Graph*, id: int32) {
  var n: Node* = g->node(id);
  var sh: Shape = n->value.shape;
  var rows: int64 = sh.dims[0];
  var picks: int64 = sh.dims[1];
  var w: int64 = sh.dims[2];
  var k: int64 = g->nodes[n->a].value.shape.size() / (rows * picks);
  var first: int64 = mix_first(g, n, k);
  var y: float32* = if n->c >= 0 { g->data(n->c) } else { (float32*)0 };
  if (g->nodes[n->b].requires) {
    var slot: GradSlot = g->grad_take(n->b);
    dispatch k_mix_back_x[spread(s, rows * first * w), 256](slot.data, g->data(n->a), n->grad, rows, picks, k, 0, first, w, if slot.fresh { 1 } else { 0 });
  }
  if (n->c >= 0 && g->nodes[n->c].requires) {
    var slot: GradSlot = g->grad_take(n->c);
    dispatch k_mix_back_x[spread(s, rows * (k - first) * w), 256](slot.data, g->data(n->a), n->grad, rows, picks, k, first, k - first, w, if slot.fresh { 1 } else { 0 });
  }
  if (g->nodes[n->a].requires) {
    var slot: GradSlot = g->grad_take(n->a);
    dispatch k_mix_back_a[(int32)((rows * picks * k + 7) / 8), 256](slot.data, g->data(n->b), y, n->grad, rows, picks, k, first, w, if slot.fresh { 1 } else { 0 });
  }
}

fn fwd_pair(s: GpuState*, g: Graph*, id: int32) {
  var n: Node* = g->node(id);
  var sh: Shape = n->value.shape;
  var head: float32* = if n->b >= 0 { g->data(n->b) } else { (float32*)0 };
  dispatch k_pairing[spread(s, sh.size()), 256](n->value.data, g->data(n->a), head, sh.dims[0], sh.dims[1], sh.dims[2] / 2);
}

fn back_pair(s: GpuState*, g: Graph*, id: int32) {
  var n: Node* = g->node(id);
  var sh: Shape = n->value.shape;
  var b: int64 = sh.dims[0];
  var t: int64 = sh.dims[1];
  var w: int64 = sh.dims[2] / 2;
  if (g->nodes[n->a].requires) {
    var slot: GradSlot = g->grad_take(n->a);
    dispatch k_pairing_back[spread(s, b * t * w), 256](slot.data, n->grad, b, t, w, if slot.fresh { 1 } else { 0 });
  }
  if (n->b >= 0 && g->nodes[n->b].requires) { dispatch k_pairing_head[spread(s, b * w), 256](g->grad_of(n->b), n->grad, b, t, w); }
}

fn fwd_residual(s: GpuState*, g: Graph*, id: int32) {
  var n: Node* = g->node(id);
  var sx: Shape = n->value.shape;
  var cols: int64 = sx.last();
  var k: int64 = g->nodes[n->b].value.shape.last();
  var rows: int64 = sx.size() / cols;
  var t: Graph* = spare(s);
  var hn: float32* = t->floats(rows * k);
  var mean: float32* = t->floats(rows);
  dispatch k_norm[row_blocks(rows), 256](1, hn, g->data(n->b), (float32*)0, (float32*)0, mean, n->saved, (int32)rows, (int32)k, n->f0);
  dispatch k_scaled[spread(s, rows * cols), 256](n->value.data, g->data(n->a), one32(), rows * cols);
  run_gemm(s, t, gemm_shape(hn, g->data(n->c), n->value.data, rows, cols, k, k, k, cols, false, true, true));
}

fn take_slope(s: GpuState*, g: Graph*, id: int32, dy: float32*, count: int64) {
  var slot: GradSlot = g->grad_take(id);
  if (slot.fresh) {
    dispatch k_scaled[spread(s, count), 256](slot.data, dy, one32(), count);
  } else {
    dispatch k_add[spread(s, count), 256](slot.data, dy, one32(), count);
  }
}

fn back_residual(s: GpuState*, g: Graph*, id: int32) {
  var n: Node* = g->node(id);
  var sx: Shape = n->value.shape;
  var cols: int64 = sx.last();
  var k: int64 = g->nodes[n->b].value.shape.last();
  var rows: int64 = sx.size() / cols;
  var dy: float32* = n->grad;
  if (g->nodes[n->a].requires) { take_slope(s, g, n->a, dy, rows * cols); }
  var wants_h: bool = g->nodes[n->b].requires;
  var wants_w: bool = g->nodes[n->c].requires;
  if (!wants_h && !wants_w) { return; }
  var t: Graph* = spare(s);
  var hn: float32* = t->floats(rows * k);
  var mean: float32* = t->floats(rows);
  var rstd: float32* = t->floats(rows);
  if (wants_w) {
    dispatch k_norm[row_blocks(rows), 256](1, hn, g->data(n->b), (float32*)0, (float32*)0, mean, rstd, (int32)rows, (int32)k, n->f0);
    var wslot: GradSlot = g->grad_take(n->c);
    run_gemm(s, t, gemm_shape(dy, hn, wslot.data, cols, k, rows, cols, k, k, true, false, !wslot.fresh));
  }
  if (wants_h) {
    var dhn: float32* = t->floats(rows * k);
    run_gemm(s, t, gemm_shape(dy, g->data(n->c), dhn, rows, k, cols, cols, k, k, false, false, false));
    var hslot: GradSlot = g->grad_take(n->b);
    dispatch k_norm_back[row_blocks(rows), 256](1, hslot.data, dhn, g->data(n->b), (float32*)0, mean, n->saved, (int32)rows, (int32)k, if hslot.fresh { 1 } else { 0 });
  }
}

fn fwd_feed(s: GpuState*, g: Graph*, id: int32) {
  var n: Node* = g->node(id);
  var sx: Shape = n->value.shape;
  var w: int64 = sx.last();
  var hid: int64 = g->nodes[n->b].value.shape.dims[0];
  var rows: int64 = sx.size() / w;
  var t: Graph* = spare(s);
  var xn: float32* = t->floats(rows * w);
  var act: float32* = t->floats(rows * hid);
  var mean: float32* = t->floats(rows);
  dispatch k_norm[row_blocks(rows), 256](1, xn, g->data(n->a), (float32*)0, (float32*)0, mean, n->saved, (int32)rows, (int32)w, n->f0);
  run_gemm(s, t, gemm_shape(xn, g->data(n->b), n->saved2, rows, hid, w, w, w, hid, false, true, false));
  dispatch k_unary[spread(s, rows * hid), 256](17, act, n->saved2, z32(), z32(), rows * hid);
  dispatch k_scaled[spread(s, rows * w), 256](n->value.data, g->data(n->a), one32(), rows * w);
  run_gemm(s, t, gemm_shape(act, g->data(n->c), n->value.data, rows, w, hid, hid, hid, w, false, true, true));
}

fn back_feed(s: GpuState*, g: Graph*, id: int32) {
  var n: Node* = g->node(id);
  var sx: Shape = n->value.shape;
  var w: int64 = sx.last();
  var hid: int64 = g->nodes[n->b].value.shape.dims[0];
  var rows: int64 = sx.size() / w;
  var dy: float32* = n->grad;
  var wants_x: bool = g->nodes[n->a].requires;
  if (wants_x) { take_slope(s, g, n->a, dy, rows * w); }
  var t: Graph* = spare(s);
  var xn: float32* = t->floats(rows * w);
  var act: float32* = t->floats(rows * hid);
  var dact: float32* = t->floats(rows * hid);
  var dpre: float32* = t->floats(rows * hid);
  var mean: float32* = t->floats(rows);
  var rstd: float32* = t->floats(rows);
  dispatch k_norm[row_blocks(rows), 256](1, xn, g->data(n->a), (float32*)0, (float32*)0, mean, rstd, (int32)rows, (int32)w, n->f0);
  dispatch k_unary[spread(s, rows * hid), 256](17, act, n->saved2, z32(), z32(), rows * hid);
  if (g->nodes[n->c].requires) {
    var oslot: GradSlot = g->grad_take(n->c);
    run_gemm(s, t, gemm_shape(dy, act, oslot.data, w, hid, rows, w, hid, hid, true, false, !oslot.fresh));
  }
  run_gemm(s, t, gemm_shape(dy, g->data(n->c), dact, rows, hid, w, w, hid, hid, false, false, false));
  dispatch k_unary_back[spread(s, rows * hid), 256](17, dpre, dact, n->saved2, n->saved2, z32(), z32(), rows * hid, 1);
  if (g->nodes[n->b].requires) {
    var fslot: GradSlot = g->grad_take(n->b);
    run_gemm(s, t, gemm_shape(dpre, xn, fslot.data, hid, w, rows, hid, w, w, true, false, !fslot.fresh));
  }
  if (wants_x) {
    var dxn: float32* = t->floats(rows * w);
    run_gemm(s, t, gemm_shape(dpre, g->data(n->b), dxn, rows, w, hid, hid, w, w, false, false, false));
    dispatch k_norm_back[row_blocks(rows), 256](1, g->grad_of(n->a), dxn, g->data(n->a), (float32*)0, mean, n->saved, (int32)rows, (int32)w, 0);
  }
}

const FUSED_TILE: int32 = 2304;
const FUSED_EDGE: int32 = 48;

kernel(block = 256) k_join(out: float32*, rules: float32*, at: int32*, side: int32) {
  workgroup var as: float32[FUSED_TILE];
  workgroup var bs: float32[FUSED_TILE];
  workgroup var cs: float32[FUSED_TILE];
  workgroup var ls: float32[FUSED_EDGE];
  var t: int32 = thread.x;
  var row: int64 = (int64)block.x;
  var plane: int32 = side * side;
  var a: float32* = rules + row * (int64)plane;
  var b: float32* = rules + (int64)at[row] * (int64)plane;
  var i: int32 = t;
  while (i < plane) {
    as[i] = a[i];
    bs[i] = b[i];
    i = i + 256;
  }
  barrier(workgroup, acq_rel);
  i = t;
  while (i < plane) {
    var r: int32 = i / side;
    var c: int32 = i - r * side;
    var sum: float32 = z32();
    for j in 0..side { sum = sum + as[r * side + j] * bs[j * side + c]; }
    cs[i] = sum * sum;
    i = i + 256;
  }
  barrier(workgroup, acq_rel);
  if (t < side) {
    var total: float32 = z32();
    for r in 0..side { total = total + cs[r * side + t]; }
    ls[t] = total;
  }
  barrier(workgroup, acq_rel);
  var o: float32* = out + row * (int64)plane;
  i = t;
  while (i < plane) {
    o[i] = cs[i] / ls[i % side];
    i = i + 256;
  }
}

kernel(block = 256) k_join_back(da: float32*, db: float32*, dy: float32*, rules: float32*, at: int32*, side: int32, fresh: int32) {
  workgroup var as: float32[FUSED_TILE];
  workgroup var bs: float32[FUSED_TILE];
  workgroup var cs: float32[FUSED_TILE];
  workgroup var ls: float32[FUSED_EDGE];
  workgroup var ds: float32[FUSED_EDGE];
  var t: int32 = thread.x;
  var row: int64 = (int64)block.x;
  var plane: int32 = side * side;
  var a: float32* = rules + row * (int64)plane;
  var b: float32* = rules + (int64)at[row] * (int64)plane;
  var d: float32* = dy + row * (int64)plane;
  var i: int32 = t;
  while (i < plane) {
    as[i] = a[i];
    bs[i] = b[i];
    i = i + 256;
  }
  barrier(workgroup, acq_rel);
  i = t;
  while (i < plane) {
    var r: int32 = i / side;
    var c: int32 = i - r * side;
    var sum: float32 = z32();
    for j in 0..side { sum = sum + as[r * side + j] * bs[j * side + c]; }
    cs[i] = sum;
    i = i + 256;
  }
  barrier(workgroup, acq_rel);
  if (t < side) {
    var total: float32 = z32();
    var dot: float32 = z32();
    for r in 0..side {
      var c: float32 = cs[r * side + t];
      total = total + c * c;
      dot = dot + d[r * side + t] * c * c;
    }
    ls[t] = total;
    ds[t] = dot / total;
  }
  barrier(workgroup, acq_rel);
  i = t;
  while (i < plane) {
    var c: int32 = i % side;
    cs[i] = (float32)2.0 * cs[i] * (d[i] - ds[c]) / ls[c];
    i = i + 256;
  }
  barrier(workgroup, acq_rel);
  var ga: float32* = da + row * (int64)plane;
  var gb: float32* = db + row * (int64)plane;
  i = t;
  while (i < plane) {
    var r: int32 = i / side;
    var j: int32 = i - r * side;
    var left: float32 = z32();
    var right: float32 = z32();
    for q in 0..side {
      left = left + cs[r * side + q] * bs[j * side + q];
      right = right + as[q * side + r] * cs[q * side + j];
    }
    if (fresh != 0) { ga[i] = left; } else { ga[i] = ga[i] + left; }
    gb[i] = right;
    i = i + 256;
  }
}

kernel(block = 256) k_rules(out: float32*, tables: float32*, choice: float32*, unseen: float32*, letters: int32) {
  workgroup var ts: float32[FUSED_TILE];
  workgroup var icol: float32[FUSED_EDGE];
  workgroup var irow: float32[FUSED_EDGE];
  workgroup var iqf: float32[FUSED_EDGE];
  workgroup var iqr: float32[FUSED_EDGE];
  workgroup var pf: float32[FUSED_EDGE];
  workgroup var pr: float32[FUSED_EDGE];
  var t: int32 = thread.x;
  var row: int64 = (int64)block.x;
  var side: int32 = letters + 1;
  var flat: int32 = letters * letters;
  var plane: int32 = side * side;
  var u: float32 = unseen[0];
  var src: float32* = tables + row * (int64)flat;
  var i: int32 = t;
  while (i < flat) {
    ts[i] = src[i];
    i = i + 256;
  }
  barrier(workgroup, acq_rel);
  if (t < letters) {
    var down: float32 = z32();
    var along: float32 = z32();
    for r in 0..letters {
      down = down + ts[r * letters + t];
      along = along + ts[t * letters + r];
    }
    var ic: float32 = one32() / (down + u);
    var ir: float32 = one32() / (along + u);
    var sum_f: float32 = z32();
    var sq_f: float32 = z32();
    var sum_r: float32 = z32();
    var sq_r: float32 = z32();
    for r in 0..letters {
      var x: float32 = ts[r * letters + t] * ic;
      var h: float32 = ts[t * letters + r] * ir;
      sum_f = sum_f + x;
      sq_f = sq_f + x * x;
      sum_r = sum_r + h;
      sq_r = sq_r + h * h;
    }
    var pad_f: float32 = one32() - sum_f;
    var pad_r: float32 = one32() - sum_r;
    icol[t] = ic;
    irow[t] = ir;
    pf[t] = pad_f;
    pr[t] = pad_r;
    iqf[t] = one32() / (sq_f + pad_f * pad_f);
    iqr[t] = one32() / (sq_r + pad_r * pad_r);
  }
  barrier(workgroup, acq_rel);
  var c0: float32 = choice[row * 3];
  var c1: float32 = choice[row * 3 + 1];
  var c2: float32 = choice[row * 3 + 2];
  var o: float32* = out + row * (int64)plane;
  i = t;
  while (i < plane) {
    var r: int32 = i / side;
    var c: int32 = i - r * side;
    var v: float32 = z32();
    if (c == letters) {
      if (r == letters) { v = c1 + c2; }
    } else {
      var x: float32 = pf[c];
      var h: float32 = pr[c];
      if (r < letters) {
        x = ts[r * letters + c] * icol[c];
        h = ts[c * letters + r] * irow[c];
      }
      v = c1 * x * x * iqf[c] + c2 * h * h * iqr[c];
    }
    if (r == c) { v = v + c0; }
    o[i] = v;
    i = i + 256;
  }
}

kernel(block = 256) k_rules_back(dt: float32*, dc: float32*, du: float32*, dy: float32*, tables: float32*, choice: float32*, unseen: float32*, letters: int32, fresh_t: int32, fresh_c: int32) {
  workgroup var ts: float32[FUSED_TILE];
  workgroup var icol: float32[FUSED_EDGE];
  workgroup var irow: float32[FUSED_EDGE];
  workgroup var iqf: float32[FUSED_EDGE];
  workgroup var iqr: float32[FUSED_EDGE];
  workgroup var dotf: float32[FUSED_EDGE];
  workgroup var dotr: float32[FUSED_EDGE];
  workgroup var padf: float32[FUSED_EDGE];
  workgroup var padr: float32[FUSED_EDGE];
  workgroup var slopef: float32[FUSED_EDGE];
  workgroup var sloper: float32[FUSED_EDGE];
  workgroup var w0: float32[FUSED_EDGE];
  workgroup var w1: float32[FUSED_EDGE];
  workgroup var w2: float32[FUSED_EDGE];
  var t: int32 = thread.x;
  var row: int64 = (int64)block.x;
  var side: int32 = letters + 1;
  var flat: int32 = letters * letters;
  var plane: int32 = side * side;
  var u: float32 = unseen[0];
  var src: float32* = tables + row * (int64)flat;
  var d: float32* = dy + row * (int64)plane;
  var c1: float32 = choice[row * 3 + 1];
  var c2: float32 = choice[row * 3 + 2];
  var two: float32 = (float32)2.0;
  var i: int32 = t;
  while (i < flat) {
    ts[i] = src[i];
    i = i + 256;
  }
  barrier(workgroup, acq_rel);
  if (t < side) {
    var g0: float32 = d[t * side + t];
    var g1: float32 = z32();
    var g2: float32 = z32();
    if (t == letters) {
      g1 = g0;
      g2 = g0;
    } else {
      var down: float32 = z32();
      var along: float32 = z32();
      for r in 0..letters {
        down = down + ts[r * letters + t];
        along = along + ts[t * letters + r];
      }
      var ic: float32 = one32() / (down + u);
      var ir: float32 = one32() / (along + u);
      var sum_f: float32 = z32();
      var sq_f: float32 = z32();
      var u_f: float32 = z32();
      var sum_r: float32 = z32();
      var sq_r: float32 = z32();
      var u_r: float32 = z32();
      for r in 0..letters {
        var x: float32 = ts[r * letters + t] * ic;
        var h: float32 = ts[t * letters + r] * ir;
        var dv: float32 = d[r * side + t];
        sum_f = sum_f + x;
        sq_f = sq_f + x * x;
        u_f = u_f + dv * x * x;
        sum_r = sum_r + h;
        sq_r = sq_r + h * h;
        u_r = u_r + dv * h * h;
      }
      var dl: float32 = d[letters * side + t];
      var pad_f: float32 = one32() - sum_f;
      var pad_r: float32 = one32() - sum_r;
      var iq_f: float32 = one32() / (sq_f + pad_f * pad_f);
      var iq_r: float32 = one32() / (sq_r + pad_r * pad_r);
      g1 = (u_f + dl * pad_f * pad_f) * iq_f;
      g2 = (u_r + dl * pad_r * pad_r) * iq_r;
      var dot_f: float32 = c1 * g1;
      var dot_r: float32 = c2 * g2;
      var dpad_f: float32 = two * pad_f * (c1 * dl - dot_f) * iq_f;
      var dpad_r: float32 = two * pad_r * (c2 * dl - dot_r) * iq_r;
      icol[t] = ic;
      irow[t] = ir;
      iqf[t] = iq_f;
      iqr[t] = iq_r;
      dotf[t] = dot_f;
      dotr[t] = dot_r;
      padf[t] = dpad_f;
      padr[t] = dpad_r;
      slopef[t] = -(two * iq_f * (c1 * u_f - dot_f * sq_f) - dpad_f * sum_f) * ic;
      sloper[t] = -(two * iq_r * (c2 * u_r - dot_r * sq_r) - dpad_r * sum_r) * ir;
    }
    w0[t] = g0;
    w1[t] = g1;
    w2[t] = g2;
  }
  barrier(workgroup, acq_rel);
  if (t == 0) {
    var s0: float32 = z32();
    var s1: float32 = z32();
    var s2: float32 = z32();
    var su: float32 = z32();
    for q in 0..side {
      s0 = s0 + w0[q];
      s1 = s1 + w1[q];
      s2 = s2 + w2[q];
    }
    for q in 0..letters { su = su + slopef[q] + sloper[q]; }
    if (fresh_c != 0) {
      dc[row * 3] = s0;
      dc[row * 3 + 1] = s1;
      dc[row * 3 + 2] = s2;
    } else {
      dc[row * 3] = dc[row * 3] + s0;
      dc[row * 3 + 1] = dc[row * 3 + 1] + s1;
      dc[row * 3 + 2] = dc[row * 3 + 2] + s2;
    }
    du[row] = su;
  }
  var gt: float32* = dt + row * (int64)flat;
  i = t;
  while (i < flat) {
    var a: int32 = i / letters;
    var b: int32 = i - a * letters;
    var x: float32 = ts[i] * icol[b];
    var h: float32 = ts[i] * irow[a];
    var via_f: float32 = (two * x * (c1 * d[a * side + b] - dotf[b]) * iqf[b] - padf[b]) * icol[b] + slopef[b];
    var via_r: float32 = (two * h * (c2 * d[b * side + a] - dotr[a]) * iqr[a] - padr[a]) * irow[a] + sloper[a];
    if (fresh_t != 0) { gt[i] = via_f + via_r; } else { gt[i] = gt[i] + via_f + via_r; }
    i = i + 256;
  }
}

const JOIN_AREA: int32 = 3888;
const JOIN_ROOM: int32 = 1296;

kernel(block = 256) k_join3(out: float32*, rules: float32*, at: int32*, side: int32, rows: int32) {
  workgroup var as: float32[JOIN_AREA];
  workgroup var bs: float32[JOIN_AREA];
  workgroup var cs: float32[JOIN_AREA];
  workgroup var ls: float32[108];
  var t: int32 = thread.x;
  var first: int32 = block.x * 3;
  var plane: int32 = side * side;
  var i: int32 = t;
  while (i < 3 * plane) {
    var mat: int32 = i / plane;
    var e: int32 = i - mat * plane;
    var row: int32 = first + mat;
    var av: float32 = z32();
    var bv: float32 = z32();
    if (row < rows) {
      av = rules[(int64)row * (int64)plane + (int64)e];
      bv = rules[(int64)at[row] * (int64)plane + (int64)e];
    }
    as[mat * JOIN_ROOM + e] = av;
    bs[mat * JOIN_ROOM + e] = bv;
    i = i + 256;
  }
  barrier(workgroup, acq_rel);
  var which: int32 = t / 81;
  var tile: int32 = t - which * 81;
  if (which < 3) {
    var r0: int32 = (tile / 9) * 4;
    var c0: int32 = (tile - (tile / 9) * 9) * 4;
    var base: int32 = which * JOIN_ROOM;
    var acc: float32[16];
    var ra: int32[4];
    var cb: int32[4];
    var av: float32[4];
    var bv: float32[4];
    comptime for k in 0..16 { acc[k] = z32(); }
    comptime for x in 0..4 {
      ra[x] = r0 + x;
      cb[x] = c0 + x;
      if (ra[x] >= side) { ra[x] = side - 1; }
      if (cb[x] >= side) { cb[x] = side - 1; }
      ra[x] = base + ra[x] * side;
      cb[x] = base + cb[x];
    }
    for j in 0..side {
      comptime for x in 0..4 {
        av[x] = as[ra[x] + j];
        bv[x] = bs[cb[x] + j * side];
      }
      comptime for x in 0..4 {
        comptime for y in 0..4 { acc[x * 4 + y] = acc[x * 4 + y] + av[x] * bv[y]; }
      }
    }
    comptime for x in 0..4 {
      comptime for y in 0..4 {
        if (r0 + x < side && c0 + y < side) { cs[base + (r0 + x) * side + c0 + y] = acc[x * 4 + y] * acc[x * 4 + y]; }
      }
    }
  }
  barrier(workgroup, acq_rel);
  if (t < 3 * side) {
    var m2: int32 = t / side;
    var col: int32 = t - m2 * side;
    var total: float32 = z32();
    for r in 0..side { total = total + cs[m2 * JOIN_ROOM + r * side + col]; }
    ls[m2 * 36 + col] = total;
  }
  barrier(workgroup, acq_rel);
  i = t;
  while (i < 3 * plane) {
    var mat: int32 = i / plane;
    var e: int32 = i - mat * plane;
    var row: int32 = first + mat;
    if (row < rows) { out[(int64)row * (int64)plane + (int64)e] = cs[mat * JOIN_ROOM + e] / ls[mat * 36 + e % side]; }
    i = i + 256;
  }
}

kernel(block = 256) k_round_vec(vecs: float32*, rules: float32*, resting: float32*, q: Round) {
  var e: int64 = (int64)block.x * 256 + (int64)thread.x;
  var step: int64 = (int64)grid_dim.x * 256;
  var side: int64 = (int64)q.side;
  var total: int64 = (int64)q.batch * (int64)q.time * side;
  while (e < total) {
    var i: int64 = e / side;
    var rule: float32* = rules + e * side;
    var far: float32* = resting + (int64)q.at[i] * side;
    var sum: float32 = z32();
    for y: int64 in 0..side { sum = sum + rule[y] * far[y]; }
    vecs[e] = sum;
    e = e + step;
  }
}

kernel(block = 256) k_round_slopes(dv: float32*, dr: float32*, dzs: float32*, dtot: float32*, keep: float32*, king: float32*, q: Round) {
  var i: int64 = (int64)block.x * 256 + (int64)thread.x;
  var step: int64 = (int64)grid_dim.x * 256;
  var side: int64 = (int64)q.side;
  var letters: int64 = side - 1;
  var vocab: int64 = (int64)q.vocab;
  var time: int64 = (int64)q.time;
  var rows: int64 = (int64)q.batch * time;
  while (i < rows) {
    var r: int64 = i / time;
    var pos: int64 = i - r * time;
    var syms: int32* = q.syms + r * letters;
    var slopes: float32* = dr + i * vocab;
    var acc: float32 = z32();
    for s: int64 in 0..vocab { acc = acc + slopes[s] * q.spread[r * vocab + s]; }
    var back: float32 = z32();
    for j: int64 in 0..time { back = back + king[(r * time + j) * time + pos] * dzs[r * time + j]; }
    var nx: int32 = q.nexts[i];
    var extra: float32 = z32();
    if (nx >= 0) {
      extra = back / (keep[i * vocab + (int64)nx] + (float32)0.02);
      acc = acc + extra * q.spread[r * vocab + (int64)nx];
    }
    var dtotal: float32 = dtot[i] - acc;
    for x: int64 in 0..letters {
      var sym: int32 = syms[x];
      var v: float32 = z32();
      if (sym >= 0) {
        v = slopes[sym] + dtotal;
        if (sym == nx) { v = v + extra; }
      }
      dv[i * side + x] = v;
    }
    dv[i * side + letters] = z32();
    i = i + step;
  }
}

kernel(block = 256) k_round_far(dfar: float32*, rules: float32*, dv: float32*, q: Round) {
  var e: int64 = (int64)block.x * 256 + (int64)thread.x;
  var step: int64 = (int64)grid_dim.x * 256;
  var side: int64 = (int64)q.side;
  var total: int64 = (int64)q.batch * (int64)q.time * side;
  while (e < total) {
    var i: int64 = e / side;
    var y: int64 = e - i * side;
    var rule: float32* = rules + i * side * side + y;
    var slope: float32* = dv + i * side;
    var sum: float32 = z32();
    for x: int64 in 0..side { sum = sum + rule[x * side] * slope[x]; }
    dfar[e] = sum;
    e = e + step;
  }
}

kernel(block = 256) k_round_rules_back(drules: float32*, dv: float32*, resting: float32*, q: Round, fresh: int32) {
  var e: int64 = (int64)block.x * 256 + (int64)thread.x;
  var step: int64 = (int64)grid_dim.x * 256;
  var side: int64 = (int64)q.side;
  var total: int64 = (int64)q.batch * (int64)q.time * side * side;
  while (e < total) {
    var ix: int64 = e / side;
    var i: int64 = ix / side;
    var v: float32 = dv[ix] * resting[(int64)q.at[i] * side + e - ix * side];
    if (fresh != 0) { drules[e] = v; } else { drules[e] = drules[e] + v; }
    e = e + step;
  }
}

fn fwd_join(s: GpuState*, g: Graph*, id: int32) {
  var n: Node* = g->node(id);
  var sh: Shape = n->value.shape;
  if (sh.dims[1] <= 36) {
    dispatch k_join3[(int32)((sh.dims[0] + 2) / 3), 256](n->value.data, g->data(n->a), n->ints, (int32)sh.dims[1], (int32)sh.dims[0]);
    return;
  }
  dispatch k_join[(int32)sh.dims[0], 256](n->value.data, g->data(n->a), n->ints, (int32)sh.dims[1]);
}

fn back_join(s: GpuState*, g: Graph*, id: int32) {
  var n: Node* = g->node(id);
  if (!g->nodes[n->a].requires) { return; }
  var sh: Shape = n->value.shape;
  var rows: int64 = sh.dims[0];
  var plane: int64 = sh.dims[1] * sh.dims[2];
  var far: float32* = g->floats(rows * plane);
  var slot: GradSlot = g->grad_take(n->a);
  dispatch k_join_back[(int32)rows, 256](slot.data, far, n->grad, g->data(n->a), n->ints, (int32)sh.dims[1], if slot.fresh { 1 } else { 0 });
  var order: int32* = (int32*)n->ext;
  dispatch k_scatter[spread(s, rows * plane), 256](slot.data, far, order, order + rows, rows, plane);
}

fn fwd_rules(s: GpuState*, g: Graph*, id: int32) {
  var n: Node* = g->node(id);
  var sh: Shape = n->value.shape;
  dispatch k_rules[(int32)sh.dims[0], 256](n->value.data, g->data(n->a), g->data(n->b), g->data(n->c), (int32)(sh.dims[1] - 1));
}

fn back_rules(s: GpuState*, g: Graph*, id: int32) {
  var n: Node* = g->node(id);
  var sh: Shape = n->value.shape;
  var rows: int64 = sh.dims[0];
  var letters: int64 = sh.dims[1] - 1;
  var wants_t: bool = g->nodes[n->a].requires;
  var wants_c: bool = g->nodes[n->b].requires;
  var wants_u: bool = g->nodes[n->c].requires;
  var gt: float32* = g->floats(rows * letters * letters);
  var gc: float32* = g->floats(rows * 3);
  var fresh_t: int32 = 1;
  var fresh_c: int32 = 1;
  if (wants_t) {
    var slot: GradSlot = g->grad_take(n->a);
    gt = slot.data;
    fresh_t = if slot.fresh { 1 } else { 0 };
  }
  if (wants_c) {
    var slot: GradSlot = g->grad_take(n->b);
    gc = slot.data;
    fresh_c = if slot.fresh { 1 } else { 0 };
  }
  var gu: float32* = g->floats(rows);
  dispatch k_rules_back[(int32)rows, 256](gt, gc, gu, n->grad, g->data(n->a), g->data(n->b), g->data(n->c), (int32)letters, fresh_t, fresh_c);
  if (wants_u) { sum_into(s, g->grad_of(n->c), gu, (float32*)0, 0, rows, (float32)1.0, true); }
}

struct Solve {
  plain: int32*;
  sorts: int32*;
  order: int32*;
  starts: int32*;
  slots: int32*;
  syms: int32*;
  spread: float32*;
  batch: int32;
  time: int32;
  stride: int32;
  marks: int32;
  reach: int32;
  letters: int32;
  vocab: int32;
}

fn solve_of(p: SolvePlan*) -> Solve {
  var q: Solve = { plain: p->dplain, sorts: p->dsorts, order: p->dorder, starts: p->dorder + p->rows, slots: p->dslots, syms: p->dsyms, spread: p->dspread, batch: (int32)p->batch, time: (int32)p->time, stride: (int32)p->stride, marks: (int32)p->marks, reach: (int32)p->reach, letters: (int32)p->letters, vocab: (int32)p->vocab };
  return q;
}

kernel(block = 256) k_solve_keys(keys: float32*, bel: float32*, bid: float32*, q: Solve) {
  var g: int64 = (int64)block.x * 256 + (int64)thread.x;
  var step: int64 = (int64)grid_dim.x * 256;
  var letters: int64 = (int64)q.letters;
  var marks: int64 = (int64)q.marks;
  var reach: int64 = (int64)q.reach;
  var time: int64 = (int64)q.time;
  var total: int64 = (int64)q.batch * time * marks;
  while (g < total) {
    var m: int64 = g % marks;
    var i: int64 = g / marks;
    if (i % time < m * (int64)q.stride) {
      var row: float32* = keys + g * letters;
      var lend: float32 = bid[i];
      for a: int64 in 0..letters { row[a] = z32(); }
      for o: int64 in 0..reach {
        var a: int64 = (int64)q.plain[i * reach + o];
        if (a < letters) { row[a] = row[a] + bel[g * reach + o] * lend; }
      }
    }
    g = g + step;
  }
}

fn classed(q: Solve, x: float32*, e: int64) -> float32 {
  var letters: int64 = (int64)q.letters;
  var marks: int64 = (int64)q.marks;
  var time: int64 = (int64)q.time;
  var a: int64 = e % letters;
  var e1: int64 = e / letters;
  var m: int64 = e1 % marks;
  var e2: int64 = e1 / marks;
  var c: int64 = e2 % (letters + 1);
  var r: int64 = e2 / (letters + 1);
  var limit: int64 = m * (int64)q.stride;
  var sum: float32 = z32();
  if (c < letters) {
    var k: int32 = q.starts[r * letters + c];
    var end: int32 = q.starts[r * letters + c + 1];
    while (k < end) {
      var i: int64 = (int64)q.order[k];
      if (i - r * time < limit) { sum = sum + x[(i * marks + m) * letters + a]; }
      k = k + 1;
    }
  }
  return sum;
}

kernel(block = 256) k_solve_table(out: float32*, keys: float32*, q: Solve) {
  var e: int64 = (int64)block.x * 256 + (int64)thread.x;
  var step: int64 = (int64)grid_dim.x * 256;
  var letters: int64 = (int64)q.letters;
  var marks: int64 = (int64)q.marks;
  var time: int64 = (int64)q.time;
  var none: int32 = q.batch * q.letters;
  var total: int64 = (int64)q.batch * (letters + 1) * marks * letters;
  while (e < total) {
    var sum: float32 = classed(q, keys, e);
    var c: int64 = (e / (letters * marks)) % (letters + 1);
    if (c == letters) {
      var a: int64 = e % letters;
      var m: int64 = (e / letters) % marks;
      var r: int64 = e / (letters * marks * (letters + 1));
      for pos: int64 in 0..m * (int64)q.stride {
        var i: int64 = r * time + pos;
        if (q.sorts[i] != none) { sum = sum + keys[(i * marks + m) * letters + a]; }
      }
    }
    out[e] = sum;
    e = e + step;
  }
}

kernel(block = 256) k_solve_table_back(dbel: float32*, part: float32*, dt: float32*, bel: float32*, bid: float32*, q: Solve, wants_bel: int32, fresh_bel: int32) {
  var g: int64 = (int64)block.x * 256 + (int64)thread.x;
  var step: int64 = (int64)grid_dim.x * 256;
  var letters: int64 = (int64)q.letters;
  var marks: int64 = (int64)q.marks;
  var reach: int64 = (int64)q.reach;
  var time: int64 = (int64)q.time;
  var none: int32 = q.batch * q.letters;
  var total: int64 = (int64)q.batch * time * marks;
  while (g < total) {
    var m: int64 = g % marks;
    var i: int64 = g / marks;
    var r: int64 = i / time;
    var cls: int32 = q.sorts[i];
    var live: bool = i - r * time < m * (int64)q.stride && cls != none;
    var mine: float32* = dt + ((r * (letters + 1) + (int64)cls - r * letters) * marks + m) * letters;
    var all: float32* = dt + ((r * (letters + 1) + letters) * marks + m) * letters;
    var lend: float32 = bid[i];
    var gain: float32 = z32();
    for o: int64 in 0..reach {
      var a: int64 = (int64)q.plain[i * reach + o];
      var slope: float32 = z32();
      if (live && a < letters) { slope = mine[a] + all[a]; }
      var at: int64 = g * reach + o;
      gain = gain + bel[at] * slope;
      if (wants_bel != 0) {
        if (fresh_bel != 0) { dbel[at] = slope * lend; } else { dbel[at] = dbel[at] + slope * lend; }
      }
    }
    part[g] = gain;
    g = g + step;
  }
}

kernel(block = 256) k_fold_marks(dst: float32*, part: float32*, rows: int64, marks: int64, fresh: int32) {
  var i: int64 = (int64)block.x * 256 + (int64)thread.x;
  var step: int64 = (int64)grid_dim.x * 256;
  while (i < rows) {
    var sum: float32 = z32();
    for m: int64 in 0..marks { sum = sum + part[i * marks + m]; }
    if (fresh != 0) { dst[i] = sum; } else { dst[i] = dst[i] + sum; }
    i = i + step;
  }
}

kernel(block = 256) k_solve_proof(out: float32*, table: float32*, keys: float32*, terms: float32*, q: Solve) {
  var e: int64 = (int64)block.x * 256 + (int64)thread.x;
  var step: int64 = (int64)grid_dim.x * 256;
  var letters: int64 = (int64)q.letters;
  var marks: int64 = (int64)q.marks;
  var reach: int64 = (int64)q.reach;
  var time: int64 = (int64)q.time;
  var none: int32 = q.batch * q.letters;
  var total: int64 = (int64)q.batch * time * marks * reach;
  var unseen: float32 = terms[0];
  var doubt: float32 = terms[1];
  while (e < total) {
    var o: int64 = e % reach;
    var im: int64 = e / reach;
    var m: int64 = im % marks;
    var i: int64 = im / marks;
    var r: int64 = i / time;
    var v: float32 = z32();
    if (i - r * time < m * (int64)q.stride) {
      var a: int64 = (int64)q.plain[i * reach + o];
      var hit: float32 = z32();
      var all: float32 = z32();
      if (a < letters) {
        var own: float32 = keys[im * letters + a];
        var cls: int32 = q.sorts[i];
        if (cls != none) { hit = table[((r * (letters + 1) + (int64)cls - r * letters) * marks + m) * letters + a]; }
        hit = hit - own;
        all = table[((r * (letters + 1) + letters) * marks + m) * letters + a] - own;
      }
      if (hit < z32()) { hit = z32(); }
      if (all < z32()) { all = z32(); }
      v = logf(hit + unseen) - logf(all + doubt);
    }
    out[e] = v;
    e = e + step;
  }
}

kernel(block = 256) k_solve_proof_back(hk: float32*, fk: float32*, pu: float32*, pd: float32*, dy: float32*, table: float32*, keys: float32*, terms: float32*, q: Solve) {
  workgroup var lanes: float32[256];
  workgroup var lanes2: float32[256];
  var t: int32 = thread.x;
  var g: int64 = (int64)block.x * 256 + (int64)t;
  var step: int64 = (int64)grid_dim.x * 256;
  var letters: int64 = (int64)q.letters;
  var marks: int64 = (int64)q.marks;
  var reach: int64 = (int64)q.reach;
  var time: int64 = (int64)q.time;
  var none: int32 = q.batch * q.letters;
  var total: int64 = (int64)q.batch * time * marks;
  var unseen: float32 = terms[0];
  var doubt: float32 = terms[1];
  var acc_u: float32 = z32();
  var acc_d: float32 = z32();
  while (g < total) {
    var m: int64 = g % marks;
    var i: int64 = g / marks;
    var r: int64 = i / time;
    var hrow: float32* = hk + g * letters;
    var frow: float32* = fk + g * letters;
    for a: int64 in 0..letters {
      hrow[a] = z32();
      frow[a] = z32();
    }
    if (i - r * time < m * (int64)q.stride) {
      var cls: int32 = q.sorts[i];
      var mine: float32* = table + ((r * (letters + 1) + (int64)cls - r * letters) * marks + m) * letters;
      var whole: float32* = table + ((r * (letters + 1) + letters) * marks + m) * letters;
      for o: int64 in 0..reach {
        var a: int64 = (int64)q.plain[i * reach + o];
        var hit: float32 = z32();
        var all: float32 = z32();
        if (a < letters) {
          var own: float32 = keys[g * letters + a];
          if (cls != none) { hit = mine[a]; }
          hit = hit - own;
          all = whole[a] - own;
        }
        var d: float32 = dy[g * reach + o];
        var up: float32 = d / (unseen + (if hit > z32() { hit } else { z32() }));
        var down: float32 = d / (doubt + (if all > z32() { all } else { z32() }));
        acc_u = acc_u + up;
        acc_d = acc_d - down;
        if (hit > z32()) { hrow[a] = hrow[a] + up; }
        if (all > z32()) { frow[a] = frow[a] - down; }
      }
    }
    g = g + step;
  }
  lanes[t] = acc_u;
  lanes2[t] = acc_d;
  barrier(workgroup, acq_rel);
  var width: int32 = 128;
  while (width > 0) {
    if (t < width) {
      lanes[t] = lanes[t] + lanes[t + width];
      lanes2[t] = lanes2[t] + lanes2[t + width];
    }
    barrier(workgroup, acq_rel);
    width = width / 2;
  }
  if (t == 0) {
    pu[block.x] = lanes[0];
    pd[block.x] = lanes2[0];
  }
}

kernel(block = 256) k_solve_proof_table(dt: float32*, hk: float32*, fk: float32*, q: Solve, fresh: int32) {
  var e: int64 = (int64)block.x * 256 + (int64)thread.x;
  var step: int64 = (int64)grid_dim.x * 256;
  var letters: int64 = (int64)q.letters;
  var marks: int64 = (int64)q.marks;
  var time: int64 = (int64)q.time;
  var total: int64 = (int64)q.batch * (letters + 1) * marks * letters;
  while (e < total) {
    var sum: float32 = classed(q, hk, e);
    var c: int64 = (e / (letters * marks)) % (letters + 1);
    if (c == letters) {
      var a: int64 = e % letters;
      var m: int64 = (e / letters) % marks;
      var r: int64 = e / (letters * marks * (letters + 1));
      for pos: int64 in 0..m * (int64)q.stride { sum = sum + fk[((r * time + pos) * marks + m) * letters + a]; }
    }
    if (fresh != 0) { dt[e] = sum; } else { dt[e] = dt[e] + sum; }
    e = e + step;
  }
}

kernel(block = 256) k_solve_proof_own(dbel: float32*, part: float32*, hk: float32*, fk: float32*, bel: float32*, bid: float32*, q: Solve, wants_bel: int32, fresh_bel: int32) {
  var g: int64 = (int64)block.x * 256 + (int64)thread.x;
  var step: int64 = (int64)grid_dim.x * 256;
  var letters: int64 = (int64)q.letters;
  var marks: int64 = (int64)q.marks;
  var reach: int64 = (int64)q.reach;
  var time: int64 = (int64)q.time;
  var total: int64 = (int64)q.batch * time * marks;
  while (g < total) {
    var m: int64 = g % marks;
    var i: int64 = g / marks;
    var live: bool = i % time < m * (int64)q.stride;
    var lend: float32 = bid[i];
    var gain: float32 = z32();
    for o: int64 in 0..reach {
      var a: int64 = (int64)q.plain[i * reach + o];
      var slope: float32 = z32();
      if (live && a < letters) { slope = -(hk[g * letters + a] + fk[g * letters + a]); }
      var at: int64 = g * reach + o;
      gain = gain + bel[at] * slope;
      if (wants_bel != 0) {
        if (fresh_bel != 0) { dbel[at] = slope * lend; } else { dbel[at] = dbel[at] + slope * lend; }
      }
    }
    part[g] = gain;
    g = g + step;
  }
}

kernel(block = 256) k_solve_beliefs(out: float32*, lift: float32*, spot: float32*, q: Solve, lifted: int32) {
  var g: int64 = (int64)block.x * 256 + (int64)thread.x;
  var step: int64 = (int64)grid_dim.x * 256;
  var marks: int64 = (int64)q.marks;
  var reach: int64 = (int64)q.reach;
  var time: int64 = (int64)q.time;
  var total: int64 = (int64)q.batch * time * marks;
  while (g < total) {
    var m: int64 = g % marks;
    var i: int64 = g / marks;
    var base: int64 = g * reach;
    if (m < (i % time) / (int64)q.stride) {
      for o: int64 in 0..reach { out[base + o] = z32(); }
    } else {
      var best: float32 = (float32)-3.0e38;
      for o: int64 in 0..reach {
        var v: float32 = spot[i * reach + o];
        if (lifted != 0) { v = v + lift[base + o]; }
        if (v > best) { best = v; }
      }
      var sum: float32 = z32();
      for o: int64 in 0..reach {
        var v: float32 = spot[i * reach + o];
        if (lifted != 0) { v = v + lift[base + o]; }
        sum = sum + expf(v - best);
      }
      var inv: float32 = one32() / sum;
      for o: int64 in 0..reach {
        var v: float32 = spot[i * reach + o];
        if (lifted != 0) { v = v + lift[base + o]; }
        out[base + o] = expf(v - best) * inv;
      }
    }
    g = g + step;
  }
}

kernel(block = 256) k_solve_beliefs_back(zs: float32*, dlift: float32*, dy: float32*, y: float32*, q: Solve, wants_lift: int32, fresh_lift: int32) {
  var g: int64 = (int64)block.x * 256 + (int64)thread.x;
  var step: int64 = (int64)grid_dim.x * 256;
  var reach: int64 = (int64)q.reach;
  var total: int64 = (int64)q.batch * (int64)q.time * (int64)q.marks;
  while (g < total) {
    var base: int64 = g * reach;
    var dot: float32 = z32();
    for o: int64 in 0..reach { dot = dot + dy[base + o] * y[base + o]; }
    for o: int64 in 0..reach {
      var z: float32 = y[base + o] * (dy[base + o] - dot);
      zs[base + o] = z;
      if (wants_lift != 0) {
        if (fresh_lift != 0) { dlift[base + o] = z; } else { dlift[base + o] = dlift[base + o] + z; }
      }
    }
    g = g + step;
  }
}

kernel(block = 256) k_solve_beliefs_spot(dspot: float32*, zs: float32*, q: Solve, fresh: int32) {
  var e: int64 = (int64)block.x * 256 + (int64)thread.x;
  var step: int64 = (int64)grid_dim.x * 256;
  var marks: int64 = (int64)q.marks;
  var reach: int64 = (int64)q.reach;
  var total: int64 = (int64)q.batch * (int64)q.time * reach;
  while (e < total) {
    var o: int64 = e % reach;
    var i: int64 = e / reach;
    var sum: float32 = z32();
    for m: int64 in 0..marks { sum = sum + zs[(i * marks + m) * reach + o]; }
    if (fresh != 0) { dspot[e] = sum; } else { dspot[e] = dspot[e] + sum; }
    e = e + step;
  }
}

kernel(block = 256) k_solve_lone(keys: float32*, mine: float32*, bid: float32*, q: Solve) {
  var i: int64 = (int64)block.x * 256 + (int64)thread.x;
  var step: int64 = (int64)grid_dim.x * 256;
  var letters: int64 = (int64)q.letters;
  var reach: int64 = (int64)q.reach;
  var rows: int64 = (int64)q.batch * (int64)q.time;
  while (i < rows) {
    var row: float32* = keys + i * letters;
    var lend: float32 = bid[i];
    for a: int64 in 0..letters { row[a] = z32(); }
    for o: int64 in 0..reach {
      var a: int64 = (int64)q.plain[i * reach + o];
      if (a < letters) { row[a] = row[a] + mine[i * reach + o] * lend; }
    }
    i = i + step;
  }
}

kernel(block = 256) k_solve_tables(out: float32*, table: float32*, keys: float32*, q: Solve) {
  var e: int64 = (int64)block.x * 256 + (int64)thread.x;
  var step: int64 = (int64)grid_dim.x * 256;
  var letters: int64 = (int64)q.letters;
  var marks: int64 = (int64)q.marks;
  var time: int64 = (int64)q.time;
  var none: int32 = q.batch * q.letters;
  var total: int64 = (int64)q.batch * time * letters;
  while (e < total) {
    var a: int64 = e % letters;
    var i: int64 = e / letters;
    var r: int64 = i / time;
    var pos: int64 = i - r * time;
    var m: int64 = pos / (int64)q.stride;
    var dst: float32* = out + i * letters * letters + a;
    var src: float32* = table + (r * (letters + 1) * marks + m) * letters + a;
    for c: int64 in 0..letters { dst[c * letters] = src[c * marks * letters]; }
    for j: int64 in m * (int64)q.stride..pos {
      var row: int64 = r * time + j;
      var cls: int32 = q.sorts[row];
      if (cls != none) {
        var c: int64 = (int64)cls - r * letters;
        dst[c * letters] = dst[c * letters] + keys[row * letters + a];
      }
    }
    e = e + step;
  }
}

kernel(block = 256) k_solve_tables_table(dt: float32*, dy: float32*, q: Solve, fresh: int32) {
  var e: int64 = (int64)block.x * 256 + (int64)thread.x;
  var step: int64 = (int64)grid_dim.x * 256;
  var letters: int64 = (int64)q.letters;
  var marks: int64 = (int64)q.marks;
  var time: int64 = (int64)q.time;
  var stride: int64 = (int64)q.stride;
  var total: int64 = (int64)q.batch * (letters + 1) * marks * letters;
  while (e < total) {
    var a: int64 = e % letters;
    var e1: int64 = e / letters;
    var m: int64 = e1 % marks;
    var e2: int64 = e1 / marks;
    var c: int64 = e2 % (letters + 1);
    var r: int64 = e2 / (letters + 1);
    var sum: float32 = z32();
    if (c < letters) {
      for j: int64 in 0..stride { sum = sum + dy[((r * time + m * stride + j) * letters + c) * letters + a]; }
    }
    if (fresh != 0) { dt[e] = sum; } else { dt[e] = dt[e] + sum; }
    e = e + step;
  }
}

kernel(block = 256) k_solve_tables_mine(dmine: float32*, dbid: float32*, dy: float32*, mine: float32*, bid: float32*, q: Solve, wants_mine: int32, fresh_mine: int32, wants_bid: int32, fresh_bid: int32) {
  var i: int64 = (int64)block.x * 256 + (int64)thread.x;
  var step: int64 = (int64)grid_dim.x * 256;
  var letters: int64 = (int64)q.letters;
  var reach: int64 = (int64)q.reach;
  var time: int64 = (int64)q.time;
  var stride: int64 = (int64)q.stride;
  var none: int32 = q.batch * q.letters;
  var rows: int64 = (int64)q.batch * time;
  while (i < rows) {
    var r: int64 = i / time;
    var pos: int64 = i - r * time;
    var cls: int32 = q.sorts[i];
    var c: int64 = (int64)cls - r * letters;
    var end: int64 = (pos / stride + 1) * stride;
    var lend: float32 = bid[i];
    var gain: float32 = z32();
    for o: int64 in 0..reach {
      var a: int64 = (int64)q.plain[i * reach + o];
      var slope: float32 = z32();
      if (cls != none && a < letters) {
        for later: int64 in pos + 1..end { slope = slope + dy[((r * time + later) * letters + c) * letters + a]; }
      }
      gain = gain + mine[i * reach + o] * slope;
      if (wants_mine != 0) {
        if (fresh_mine != 0) { dmine[i * reach + o] = slope * lend; } else { dmine[i * reach + o] = dmine[i * reach + o] + slope * lend; }
      }
    }
    if (wants_bid != 0) {
      if (fresh_bid != 0) { dbid[i] = gain; } else { dbid[i] = dbid[i] + gain; }
    }
    i = i + step;
  }
}

kernel(block = 256) k_solve_guess(out: float32*, tables: float32*, mine: float32*, terms: float32*, q: Solve) {
  workgroup var sums: float32[FUSED_EDGE];
  workgroup var wm: float32[FUSED_EDGE];
  var t: int32 = thread.x;
  var i: int64 = (int64)block.x;
  var letters: int32 = q.letters;
  var reach: int32 = q.reach;
  var vocab: int32 = q.vocab;
  var r: int64 = i / (int64)q.time;
  var doubt: float32 = terms[1];
  var tab: float32* = tables + i * (int64)(letters * letters);
  var keys: int32* = q.plain + i * (int64)reach;
  var syms: int32* = q.syms + r * (int64)letters;
  if (t < letters) {
    var total: float32 = z32();
    for c in 0..letters {
      if (syms[c] >= 0) { total = total + tab[c * letters + t]; }
    }
    sums[t] = total;
  }
  barrier(workgroup, acq_rel);
  if (t < reach) {
    var a: int32 = keys[t];
    var total: float32 = z32();
    if (a < letters) { total = sums[a]; }
    wm[t] = mine[i * (int64)reach + (int64)t] / (total + doubt);
  }
  barrier(workgroup, acq_rel);
  var o1: float32* = out + i * (int64)(2 * vocab);
  var s: int32 = t;
  while (s < vocab) {
    var c: int32 = q.slots[r * (int64)vocab + (int64)s];
    var even: float32 = doubt * q.spread[r * (int64)vocab + (int64)s];
    var plainly: float32 = z32();
    var guessed: float32 = z32();
    for o in 0..reach {
      var a: int32 = keys[o];
      var v: float32 = z32();
      if (c >= 0 && a < letters) { v = tab[c * letters + a]; }
      plainly = plainly + wm[o] * v;
      guessed = guessed + wm[o] * (v + even);
    }
    o1[s] = plainly;
    o1[vocab + s] = guessed;
    s = s + 256;
  }
}

kernel(block = 256) k_solve_guess_back(dtab: float32*, dmine: float32*, dd: float32*, dy: float32*, tables: float32*, mine: float32*, terms: float32*, q: Solve, fresh_tab: int32, fresh_mine: int32) {
  workgroup var sums: float32[FUSED_EDGE];
  workgroup var ec: float32[FUSED_EDGE];
  workgroup var wm: float32[FUSED_EDGE];
  workgroup var drop: float32[FUSED_EDGE];
  workgroup var part: float32[FUSED_EDGE];
  workgroup var lanes: float32[256];
  var t: int32 = thread.x;
  var i: int64 = (int64)block.x;
  var letters: int32 = q.letters;
  var reach: int32 = q.reach;
  var vocab: int32 = q.vocab;
  var r: int64 = i / (int64)q.time;
  var doubt: float32 = terms[1];
  var tab: float32* = tables + i * (int64)(letters * letters);
  var keys: int32* = q.plain + i * (int64)reach;
  var syms: int32* = q.syms + r * (int64)letters;
  var d: float32* = dy + i * (int64)(2 * vocab);
  if (t < letters) {
    var total: float32 = z32();
    for c in 0..letters {
      if (syms[c] >= 0) { total = total + tab[c * letters + t]; }
    }
    sums[t] = total;
    var both: float32 = z32();
    if (syms[t] >= 0) { both = d[syms[t]] + d[vocab + syms[t]]; }
    ec[t] = both;
  }
  var acc: float32 = z32();
  var s: int32 = t;
  while (s < vocab) {
    acc = acc + d[vocab + s] * q.spread[r * (int64)vocab + (int64)s];
    s = s + 256;
  }
  lanes[t] = acc;
  barrier(workgroup, acq_rel);
  var width: int32 = 128;
  while (width > 0) {
    if (t < width) { lanes[t] = lanes[t] + lanes[t + width]; }
    barrier(workgroup, acq_rel);
    width = width / 2;
  }
  var even: float32 = lanes[0] * doubt;
  if (t < reach) {
    var a: int32 = keys[t];
    var total: float32 = z32();
    var pull: float32 = even;
    if (a < letters) {
      total = sums[a];
      for c in 0..letters {
        if (syms[c] >= 0) { pull = pull + ec[c] * tab[c * letters + a]; }
      }
    }
    var inv: float32 = one32() / (total + doubt);
    var held: float32 = mine[i * (int64)reach + (int64)t];
    wm[t] = held * inv;
    drop[t] = held * pull * inv * inv;
    part[t] = held * (lanes[0] * inv - pull * inv * inv);
    var at: int64 = i * (int64)reach + (int64)t;
    if (fresh_mine != 0) { dmine[at] = pull * inv; } else { dmine[at] = dmine[at] + pull * inv; }
  }
  barrier(workgroup, acq_rel);
  if (t == 0) {
    var total: float32 = z32();
    for o in 0..reach { total = total + part[o]; }
    dd[i] = total;
  }
  var gt: float32* = dtab + i * (int64)(letters * letters);
  var e: int32 = t;
  while (e < letters * letters) {
    var c: int32 = e / letters;
    var a: int32 = e - c * letters;
    var sum: float32 = z32();
    if (syms[c] >= 0) {
      for o in 0..reach {
        if (keys[o] == a) { sum = sum + wm[o] * ec[c] - drop[o]; }
      }
    }
    if (fresh_tab != 0) { gt[e] = sum; } else { gt[e] = gt[e] + sum; }
    e = e + 256;
  }
}

kernel(block = 256) k_scale_by(out: float32*, x: float32*, s: float32*, n: int64, accumulate: int32) {
  var i: int64 = (int64)block.x * 256 + (int64)thread.x;
  var step: int64 = (int64)grid_dim.x * 256;
  var by: float32 = s[0];
  while (i < n) {
    if (accumulate != 0) { out[i] = out[i] + x[i] * by; } else { out[i] = x[i] * by; }
    i = i + step;
  }
}

fn fwd_scale_by(s: GpuState*, g: Graph*, id: int32) {
  var n: Node* = g->node(id);
  var size: int64 = n->value.shape.size();
  dispatch k_scale_by[spread(s, size), 256](n->value.data, g->data(n->a), g->data(n->b), size, 0);
}

fn back_scale_by(s: GpuState*, g: Graph*, id: int32) {
  var n: Node* = g->node(id);
  var size: int64 = n->value.shape.size();
  if (g->nodes[n->a].requires) {
    var slot: GradSlot = g->grad_take(n->a);
    dispatch k_scale_by[spread(s, size), 256](slot.data, n->grad, g->data(n->b), size, if slot.fresh { 0 } else { 1 });
  }
  if (g->nodes[n->b].requires) { sum_into(s, g->grad_of(n->b), n->grad, g->data(n->a), 4, size, (float32)1.0, true); }
}

fn fwd_solve_table(s: GpuState*, g: Graph*, id: int32) {
  var n: Node* = g->node(id);
  var p: SolvePlan* = (SolvePlan*)n->ext;
  var q: Solve = solve_of(p);
  dispatch k_solve_keys[spread(s, p->rows * p->marks), 256](n->saved, g->data(n->a), g->data(n->b), q);
  dispatch k_solve_table[spread(s, n->value.shape.size()), 256](n->value.data, n->saved, q);
}

fn back_solve_table(s: GpuState*, g: Graph*, id: int32) {
  var n: Node* = g->node(id);
  var p: SolvePlan* = (SolvePlan*)n->ext;
  var wants_bel: bool = g->nodes[n->a].requires;
  var dbel: float32* = (float32*)0;
  var fresh_bel: int32 = 0;
  if (wants_bel) {
    var slot: GradSlot = g->grad_take(n->a);
    dbel = slot.data;
    fresh_bel = if slot.fresh { 1 } else { 0 };
  }
  var part: float32* = g->floats(p->rows * p->marks);
  dispatch k_solve_table_back[spread(s, p->rows * p->marks), 256](dbel, part, n->grad, g->data(n->a), g->data(n->b), solve_of(p), if wants_bel { 1 } else { 0 }, fresh_bel);
  if (g->nodes[n->b].requires) {
    var slot: GradSlot = g->grad_take(n->b);
    dispatch k_fold_marks[spread(s, p->rows), 256](slot.data, part, p->rows, p->marks, if slot.fresh { 1 } else { 0 });
  }
}

fn fwd_solve_proof(s: GpuState*, g: Graph*, id: int32) {
  var n: Node* = g->node(id);
  var p: SolvePlan* = (SolvePlan*)n->ext;
  var q: Solve = solve_of(p);
  if (n->i4 != 0) { dispatch k_solve_keys[spread(s, p->rows * p->marks), 256](n->saved, g->data(n->b), g->data(n->c), q); }
  dispatch k_solve_proof[spread(s, n->value.shape.size()), 256](n->value.data, g->data(n->a), n->saved, g->data((int32)n->i5), q);
}

fn back_solve_proof(s: GpuState*, g: Graph*, id: int32) {
  var n: Node* = g->node(id);
  var p: SolvePlan* = (SolvePlan*)n->ext;
  var q: Solve = solve_of(p);
  var groups: int64 = p->rows * p->marks;
  var terms: int32 = (int32)n->i5;
  var hk: float32* = g->floats(groups * p->letters);
  var fk: float32* = g->floats(groups * p->letters);
  var blocks: int32 = spread(s, groups);
  var pu: float32* = g->floats(blocks);
  var pd: float32* = g->floats(blocks);
  dispatch k_solve_proof_back[blocks, 256](hk, fk, pu, pd, n->grad, g->data(n->a), n->saved, g->data(terms), q);
  if (g->nodes[terms].requires) {
    var dterms: float32* = g->grad_of(terms);
    dispatch k_total[1, 256](pu, blocks, dterms, (float32)1.0, 1);
    dispatch k_total[1, 256](pd, blocks, dterms + 1, (float32)1.0, 1);
  }
  if (g->nodes[n->a].requires) {
    var slot: GradSlot = g->grad_take(n->a);
    dispatch k_solve_proof_table[spread(s, g->nodes[n->a].value.shape.size()), 256](slot.data, hk, fk, q, if slot.fresh { 1 } else { 0 });
  }
  var wants_bel: bool = g->nodes[n->b].requires;
  var wants_bid: bool = g->nodes[n->c].requires;
  if (!wants_bel && !wants_bid) { return; }
  var dbel: float32* = (float32*)0;
  var fresh_bel: int32 = 0;
  if (wants_bel) {
    var slot: GradSlot = g->grad_take(n->b);
    dbel = slot.data;
    fresh_bel = if slot.fresh { 1 } else { 0 };
  }
  var part: float32* = g->floats(groups);
  dispatch k_solve_proof_own[spread(s, groups), 256](dbel, part, hk, fk, g->data(n->b), g->data(n->c), q, if wants_bel { 1 } else { 0 }, fresh_bel);
  if (wants_bid) {
    var slot: GradSlot = g->grad_take(n->c);
    dispatch k_fold_marks[spread(s, p->rows), 256](slot.data, part, p->rows, p->marks, if slot.fresh { 1 } else { 0 });
  }
}

fn fwd_solve_beliefs(s: GpuState*, g: Graph*, id: int32) {
  var n: Node* = g->node(id);
  var p: SolvePlan* = (SolvePlan*)n->ext;
  var lift: float32* = if n->a >= 0 { g->data(n->a) } else { (float32*)0 };
  dispatch k_solve_beliefs[spread(s, p->rows * p->marks), 256](n->value.data, lift, g->data(n->b), solve_of(p), if n->a >= 0 { 1 } else { 0 });
}

fn back_solve_beliefs(s: GpuState*, g: Graph*, id: int32) {
  var n: Node* = g->node(id);
  var p: SolvePlan* = (SolvePlan*)n->ext;
  var q: Solve = solve_of(p);
  var zs: float32* = g->floats(n->value.shape.size());
  var wants_lift: bool = n->a >= 0 && g->nodes[n->a].requires;
  var dlift: float32* = (float32*)0;
  var fresh_lift: int32 = 0;
  if (wants_lift) {
    var slot: GradSlot = g->grad_take(n->a);
    dlift = slot.data;
    fresh_lift = if slot.fresh { 1 } else { 0 };
  }
  dispatch k_solve_beliefs_back[spread(s, p->rows * p->marks), 256](zs, dlift, n->grad, n->value.data, q, if wants_lift { 1 } else { 0 }, fresh_lift);
  if (g->nodes[n->b].requires) {
    var slot: GradSlot = g->grad_take(n->b);
    dispatch k_solve_beliefs_spot[spread(s, p->rows * p->reach), 256](slot.data, zs, q, if slot.fresh { 1 } else { 0 });
  }
}

fn fwd_solve_tables(s: GpuState*, g: Graph*, id: int32) {
  var n: Node* = g->node(id);
  var p: SolvePlan* = (SolvePlan*)n->ext;
  var q: Solve = solve_of(p);
  var keys: float32* = g->floats(p->rows * p->letters);
  dispatch k_solve_lone[spread(s, p->rows), 256](keys, g->data(n->b), g->data(n->c), q);
  dispatch k_solve_tables[spread(s, p->rows * p->letters), 256](n->value.data, g->data(n->a), keys, q);
}

fn back_solve_tables(s: GpuState*, g: Graph*, id: int32) {
  var n: Node* = g->node(id);
  var p: SolvePlan* = (SolvePlan*)n->ext;
  var q: Solve = solve_of(p);
  if (g->nodes[n->a].requires) {
    var slot: GradSlot = g->grad_take(n->a);
    dispatch k_solve_tables_table[spread(s, g->nodes[n->a].value.shape.size()), 256](slot.data, n->grad, q, if slot.fresh { 1 } else { 0 });
  }
  var wants_mine: bool = g->nodes[n->b].requires;
  var wants_bid: bool = g->nodes[n->c].requires;
  if (!wants_mine && !wants_bid) { return; }
  var dmine: float32* = (float32*)0;
  var dbid: float32* = (float32*)0;
  var fresh_mine: int32 = 0;
  var fresh_bid: int32 = 0;
  if (wants_mine) {
    var slot: GradSlot = g->grad_take(n->b);
    dmine = slot.data;
    fresh_mine = if slot.fresh { 1 } else { 0 };
  }
  if (wants_bid) {
    var slot: GradSlot = g->grad_take(n->c);
    dbid = slot.data;
    fresh_bid = if slot.fresh { 1 } else { 0 };
  }
  dispatch k_solve_tables_mine[spread(s, p->rows), 256](dmine, dbid, n->grad, g->data(n->b), g->data(n->c), q, if wants_mine { 1 } else { 0 }, fresh_mine, if wants_bid { 1 } else { 0 }, fresh_bid);
}

fn fwd_solve_guess(s: GpuState*, g: Graph*, id: int32) {
  var n: Node* = g->node(id);
  var p: SolvePlan* = (SolvePlan*)n->ext;
  dispatch k_solve_guess[(int32)p->rows, 256](n->value.data, g->data(n->a), g->data(n->b), g->data(n->c), solve_of(p));
}

fn back_solve_guess(s: GpuState*, g: Graph*, id: int32) {
  var n: Node* = g->node(id);
  var p: SolvePlan* = (SolvePlan*)n->ext;
  var dtab: float32* = g->floats(p->rows * p->letters * p->letters);
  var dmine: float32* = g->floats(p->rows * p->reach);
  var fresh_tab: int32 = 1;
  var fresh_mine: int32 = 1;
  if (g->nodes[n->a].requires) {
    var slot: GradSlot = g->grad_take(n->a);
    dtab = slot.data;
    fresh_tab = if slot.fresh { 1 } else { 0 };
  }
  if (g->nodes[n->b].requires) {
    var slot: GradSlot = g->grad_take(n->b);
    dmine = slot.data;
    fresh_mine = if slot.fresh { 1 } else { 0 };
  }
  var dd: float32* = g->floats(p->rows);
  dispatch k_solve_guess_back[(int32)p->rows, 256](dtab, dmine, dd, n->grad, g->data(n->a), g->data(n->b), g->data(n->c), solve_of(p), fresh_tab, fresh_mine);
  if (g->nodes[n->c].requires) { sum_into(s, g->grad_of(n->c) + 1, dd, (float32*)0, 0, p->rows, (float32)1.0, true); }
}

struct Round {
  slots: int32*;
  syms: int32*;
  nexts: int32*;
  targets: int32*;
  at: int32*;
  spread: float32*;
  batch: int32;
  time: int32;
  vocab: int32;
  side: int32;
  experts: int32;
  counted: int32;
  coach: float32;
  slack: float32;
}

fn round_of(n: Node*) -> Round {
  var p: RoundPlan* = (RoundPlan*)n->ext;
  var counted: int64 = if p->counted < 1 { 1 } else { p->counted };
  var q: Round = { slots: p->dslots, syms: p->dsyms, nexts: p->dnexts, targets: p->dtargets, at: n->ints, spread: p->dspread, batch: (int32)p->batch, time: (int32)p->time, vocab: (int32)p->vocab, side: (int32)(p->letters + 1), experts: (int32)p->experts, counted: (int32)counted, coach: (float32)p->coach, slack: (float32)p->slack };
  return q;
}

kernel(block = 256) k_round_reply(keep: float32*, vecs: float32*, q: Round) {
  var i: int64 = (int64)block.x * 256 + (int64)thread.x;
  var step: int64 = (int64)grid_dim.x * 256;
  var side: int64 = (int64)q.side;
  var letters: int64 = side - 1;
  var vocab: int64 = (int64)q.vocab;
  var rows: int64 = (int64)q.batch * (int64)q.time;
  while (i < rows) {
    var r: int64 = i / (int64)q.time;
    var vec: float32* = vecs + i * side;
    var slots: int32* = q.slots + r * vocab;
    var syms: int32* = q.syms + r * letters;
    var total: float32 = z32();
    for c: int64 in 0..letters {
      if (syms[c] >= 0) { total = total + vec[c]; }
    }
    var spare: float32 = one32() - total;
    for s: int64 in 0..vocab {
      var c: int32 = slots[s];
      var v: float32 = spare * q.spread[r * vocab + s];
      if (c >= 0) { v = v + vec[c]; }
      keep[i * vocab + s] = v;
    }
    var nx: int32 = q.nexts[i];
    var fit: float32 = z32();
    if (nx >= 0) { fit = logf(keep[i * vocab + (int64)nx] + (float32)0.02); }
    keep[rows * vocab + i] = total;
    keep[rows * vocab + rows + i] = fit;
    i = i + step;
  }
}

kernel(block = 256) k_round_mix(losses: float32*, keep: float32*, base: float32*, floor: float32*, lean: float32*, king: float32*, heed: float32*, q: Round) {
  var i: int64 = (int64)block.x * 256 + (int64)thread.x;
  var step: int64 = (int64)grid_dim.x * 256;
  var time: int64 = (int64)q.time;
  var vocab: int64 = (int64)q.vocab;
  var rest: int64 = (int64)q.experts - 1;
  var rows: int64 = (int64)q.batch * time;
  var tots: float32* = keep + rows * vocab;
  var fits: float32* = tots + rows;
  var zs: float32* = fits + rows;
  var shares: float32* = zs + rows * 2;
  var eps: float32 = (float32)1.0e-6;
  while (i < rows) {
    var r: int64 = i / time;
    var score: float32 = z32();
    for j: int64 in 0..time { score = score + king[i * time + j] * fits[r * time + j]; }
    var total: float32 = tots[i];
    var last: float32 = lean[i] + score + (logf(total + q.slack) - logf(one32() - total + q.slack)) * heed[0];
    var best: float32 = last;
    for x: int64 in 0..rest {
      if (floor[i * rest + x] > best) { best = floor[i * rest + x]; }
    }
    var denom: float32 = expf(last - best);
    for x: int64 in 0..rest { denom = denom + expf(floor[i * rest + x] - best); }
    var share: float32* = shares + i * (rest + 1);
    for x: int64 in 0..rest { share[x] = expf(floor[i * rest + x] - best) / denom; }
    share[rest] = expf(last - best) / denom;
    var goal: int64 = (int64)q.targets[i];
    var z: float32 = z32();
    var zc: float32 = z32();
    var hit: float32 = z32();
    var hitc: float32 = z32();
    for s: int64 in 0..vocab {
      var rp: float32 = keep[i * vocab + s];
      var od: float32 = share[rest] * rp;
      for x: int64 in 0..rest { od = od + share[x] * base[(i * rest + x) * vocab + s]; }
      z = z + od + eps;
      zc = zc + rp + eps;
      if (s == goal) {
        hit = od;
        hitc = rp;
      }
    }
    zs[i * 2] = z;
    zs[i * 2 + 1] = zc;
    var loss: float32 = z32();
    if (goal >= 0) { loss = logf(z) - logf(hit + eps) + q.coach * (logf(zc) - logf(hitc + eps)); }
    losses[i] = loss;
    i = i + step;
  }
}

kernel(block = 256) k_round_mix_back(dbase: float32*, dfloor: float32*, dlean: float32*, dsh: float32*, dr: float32*, dzs: float32*, dtot: float32*, dheed: float32*, dloss: float32*, keep: float32*, base: float32*, heed: float32*, q: Round, mode: int32) {
  var i: int64 = (int64)block.x * 256 + (int64)thread.x;
  var step: int64 = (int64)grid_dim.x * 256;
  var time: int64 = (int64)q.time;
  var vocab: int64 = (int64)q.vocab;
  var rest: int64 = (int64)q.experts - 1;
  var rows: int64 = (int64)q.batch * time;
  var tots: float32* = keep + rows * vocab;
  var zs: float32* = tots + rows * 2;
  var shares: float32* = zs + rows * 2;
  var eps: float32 = (float32)1.0e-6;
  var wants_base: bool = (mode & 1) != 0;
  var fresh_base: bool = (mode & 2) != 0;
  var wants_floor: bool = (mode & 4) != 0;
  var fresh_floor: bool = (mode & 8) != 0;
  var wants_lean: bool = (mode & 16) != 0;
  var fresh_lean: bool = (mode & 32) != 0;
  while (i < rows) {
    var goal: int64 = (int64)q.targets[i];
    var scale: float32 = z32();
    if (goal >= 0) { scale = dloss[0] / (float32)q.counted; }
    var share: float32* = shares + i * (rest + 1);
    var slope: float32* = dsh + i * (rest + 1);
    for x: int64 in 0..rest + 1 { slope[x] = z32(); }
    for s: int64 in 0..vocab {
      var rp: float32 = keep[i * vocab + s];
      var od: float32 = share[rest] * rp;
      for x: int64 in 0..rest { od = od + share[x] * base[(i * rest + x) * vocab + s]; }
      var dod: float32 = scale / zs[i * 2];
      var drc: float32 = scale * q.coach / zs[i * 2 + 1];
      if (s == goal) {
        dod = dod - scale / (od + eps);
        drc = drc - scale * q.coach / (rp + eps);
      }
      for x: int64 in 0..rest {
        var at: int64 = (i * rest + x) * vocab + s;
        slope[x] = slope[x] + dod * base[at];
        if (wants_base) {
          if (fresh_base) { dbase[at] = share[x] * dod; } else { dbase[at] = dbase[at] + share[x] * dod; }
        }
      }
      slope[rest] = slope[rest] + dod * rp;
      dr[i * vocab + s] = share[rest] * dod + drc;
    }
    var dot: float32 = z32();
    for x: int64 in 0..rest + 1 { dot = dot + slope[x] * share[x]; }
    if (wants_floor) {
      for x: int64 in 0..rest {
        var v: float32 = share[x] * (slope[x] - dot);
        if (fresh_floor) { dfloor[i * rest + x] = v; } else { dfloor[i * rest + x] = dfloor[i * rest + x] + v; }
      }
    }
    var dz: float32 = share[rest] * (slope[rest] - dot);
    if (wants_lean) {
      if (fresh_lean) { dlean[i] = dz; } else { dlean[i] = dlean[i] + dz; }
    }
    dzs[i] = dz;
    var total: float32 = tots[i];
    dheed[i] = dz * (logf(total + q.slack) - logf(one32() - total + q.slack));
    dtot[i] = dz * heed[0] * (one32() / (total + q.slack) + one32() / (one32() - total + q.slack));
    i = i + step;
  }
}

kernel(block = 256) k_round_king(dking: float32*, dzs: float32*, keep: float32*, q: Round, fresh: int32) {
  var e: int64 = (int64)block.x * 256 + (int64)thread.x;
  var step: int64 = (int64)grid_dim.x * 256;
  var time: int64 = (int64)q.time;
  var rows: int64 = (int64)q.batch * time;
  var fits: float32* = keep + rows * (int64)q.vocab + rows;
  while (e < rows * time) {
    var i: int64 = e / time;
    var j: int64 = e - i * time;
    var v: float32 = dzs[i] * fits[(i / time) * time + j];
    if (fresh != 0) { dking[e] = v; } else { dking[e] = dking[e] + v; }
    e = e + step;
  }
}

fn fwd_round(s: GpuState*, g: Graph*, id: int32) {
  var n: Node* = g->node(id);
  var p: RoundPlan* = (RoundPlan*)n->ext;
  var q: Round = round_of(n);
  var side: int64 = p->letters + 1;
  var vecs: float32* = g->floats(p->rows * side);
  dispatch k_round_vec[spread(s, p->rows * side), 256](vecs, g->data(n->a), g->data(n->b), q);
  dispatch k_round_reply[spread(s, p->rows), 256](n->saved, vecs, q);
  var losses: float32* = g->floats(p->rows);
  dispatch k_round_mix[spread(s, p->rows), 256](losses, n->saved, g->data(n->c), g->data((int32)n->i0), g->data((int32)n->i1), g->data((int32)n->i2), g->data((int32)n->i3), q);
  sum_into(s, n->value.data, losses, (float32*)0, 0, p->rows, (float32)(1.0 / (float64)q.counted), false);
}

fn back_round(s: GpuState*, g: Graph*, id: int32) {
  var n: Node* = g->node(id);
  var p: RoundPlan* = (RoundPlan*)n->ext;
  var q: Round = round_of(n);
  var rows: int64 = p->rows;
  var side: int64 = p->letters + 1;
  var floor: int32 = (int32)n->i0;
  var lean: int32 = (int32)n->i1;
  var king: int32 = (int32)n->i2;
  var heed: int32 = (int32)n->i3;
  var dsh: float32* = g->floats(rows * p->experts);
  var dr: float32* = g->floats(rows * p->vocab);
  var dzs: float32* = g->floats(rows);
  var dtot: float32* = g->floats(rows);
  var dheed: float32* = g->floats(rows);
  var dv: float32* = g->floats(rows * side);
  var dbase: float32* = (float32*)0;
  var dfloor: float32* = (float32*)0;
  var dlean: float32* = (float32*)0;
  var mode: int32 = 0;
  if (g->nodes[n->c].requires) {
    var slot: GradSlot = g->grad_take(n->c);
    dbase = slot.data;
    mode = mode | 1 | (if slot.fresh { 2 } else { 0 });
  }
  if (g->nodes[floor].requires) {
    var slot: GradSlot = g->grad_take(floor);
    dfloor = slot.data;
    mode = mode | 4 | (if slot.fresh { 8 } else { 0 });
  }
  if (g->nodes[lean].requires) {
    var slot: GradSlot = g->grad_take(lean);
    dlean = slot.data;
    mode = mode | 16 | (if slot.fresh { 32 } else { 0 });
  }
  dispatch k_round_mix_back[spread(s, rows), 256](dbase, dfloor, dlean, dsh, dr, dzs, dtot, dheed, n->grad, n->saved, g->data(n->c), g->data(heed), q, mode);
  if (g->nodes[king].requires) {
    var slot: GradSlot = g->grad_take(king);
    dispatch k_round_king[spread(s, rows * p->time), 256](slot.data, dzs, n->saved, q, if slot.fresh { 1 } else { 0 });
  }
  dispatch k_round_slopes[spread(s, rows), 256](dv, dr, dzs, dtot, n->saved, g->data(king), q);
  if (g->nodes[n->a].requires) {
    var slot: GradSlot = g->grad_take(n->a);
    dispatch k_round_rules_back[spread(s, rows * side * side), 256](slot.data, dv, g->data(n->b), q, if slot.fresh { 1 } else { 0 });
  }
  if (g->nodes[n->b].requires) {
    var dfar: float32* = g->floats(rows * side);
    dispatch k_round_far[spread(s, rows * side), 256](dfar, g->data(n->a), dv, q);
    var order: int32* = (int32*)n->i4;
    dispatch k_scatter[spread(s, rows * side), 256](g->grad_of(n->b), dfar, order, order + rows, rows, side);
  }
  if (g->nodes[heed].requires) { sum_into(s, g->grad_of(heed), dheed, (float32*)0, 0, rows, (float32)1.0, true); }
}

struct Anchor {
  rows: int64;
  time: int64;
  reach: int64;
  side: int64;
}

kernel(block = 256) k_anchor(out: float32*, resting: float32*, rests: float32*, looks: float32*, q: Anchor) {
  var e: int64 = (int64)block.x * 256 + (int64)thread.x;
  var step: int64 = (int64)grid_dim.x * 256;
  while (e < q.rows * q.side) {
    var i: int64 = e / q.side;
    var s: int64 = e - i * q.side;
    var pos: int64 = i % q.time;
    var sum: float32 = z32();
    for o: int64 in 0..q.reach {
      var src: int64 = if pos > o { i - o - 1 } else { i };
      sum = sum + looks[i * q.reach + o] * resting[src * q.side + s];
    }
    var held: float32 = rests[i];
    out[e] = held * resting[e] + (one32() - held) * sum;
    e = e + step;
  }
}

kernel(block = 256) k_anchor_resting(dresting: float32*, dy: float32*, rests: float32*, looks: float32*, q: Anchor, fresh: int32) {
  var e: int64 = (int64)block.x * 256 + (int64)thread.x;
  var step: int64 = (int64)grid_dim.x * 256;
  while (e < q.rows * q.side) {
    var j: int64 = e / q.side;
    var s: int64 = e - j * q.side;
    var pos: int64 = j % q.time;
    var tail: float32 = z32();
    for o: int64 in pos..q.reach { tail = tail + looks[j * q.reach + o]; }
    var held: float32 = rests[j];
    var v: float32 = dy[e] * (held + (one32() - held) * tail);
    for o: int64 in 0..q.reach {
      if (pos + o + 1 < q.time) {
        var i: int64 = j + o + 1;
        v = v + (one32() - rests[i]) * looks[i * q.reach + o] * dy[i * q.side + s];
      }
    }
    if (fresh != 0) { dresting[e] = v; } else { dresting[e] = dresting[e] + v; }
    e = e + step;
  }
}

kernel(block = 256) k_anchor_looks(dlooks: float32*, part: float32*, dy: float32*, resting: float32*, rests: float32*, looks: float32*, q: Anchor, wants: int32, fresh: int32) {
  var e: int64 = (int64)block.x * 256 + (int64)thread.x;
  var step: int64 = (int64)grid_dim.x * 256;
  while (e < q.rows * q.reach) {
    var i: int64 = e / q.reach;
    var o: int64 = e - i * q.reach;
    var src: int64 = if i % q.time > o { i - o - 1 } else { i };
    var dot: float32 = z32();
    for s: int64 in 0..q.side { dot = dot + dy[i * q.side + s] * resting[src * q.side + s]; }
    part[e] = looks[e] * dot;
    if (wants != 0) {
      var v: float32 = (one32() - rests[i]) * dot;
      if (fresh != 0) { dlooks[e] = v; } else { dlooks[e] = dlooks[e] + v; }
    }
    e = e + step;
  }
}

kernel(block = 256) k_anchor_rests(drests: float32*, part: float32*, dy: float32*, resting: float32*, q: Anchor, fresh: int32) {
  var i: int64 = (int64)block.x * 256 + (int64)thread.x;
  var step: int64 = (int64)grid_dim.x * 256;
  while (i < q.rows) {
    var v: float32 = z32();
    for s: int64 in 0..q.side { v = v + dy[i * q.side + s] * resting[i * q.side + s]; }
    for o: int64 in 0..q.reach { v = v - part[i * q.reach + o]; }
    if (fresh != 0) { drests[i] = v; } else { drests[i] = drests[i] + v; }
    i = i + step;
  }
}

fn anchor_of(g: Graph*, n: Node*) -> Anchor {
  var sh: Shape = n->value.shape;
  var q: Anchor = { rows: sh.dims[0], time: n->i0, reach: g->nodes[n->c].value.shape.size() / sh.dims[0], side: sh.dims[1] };
  return q;
}

fn fwd_anchor(s: GpuState*, g: Graph*, id: int32) {
  var n: Node* = g->node(id);
  var q: Anchor = anchor_of(g, n);
  dispatch k_anchor[spread(s, q.rows * q.side), 256](n->value.data, g->data(n->a), g->data(n->b), g->data(n->c), q);
}

fn back_anchor(s: GpuState*, g: Graph*, id: int32) {
  var n: Node* = g->node(id);
  var q: Anchor = anchor_of(g, n);
  if (g->nodes[n->a].requires) {
    var slot: GradSlot = g->grad_take(n->a);
    dispatch k_anchor_resting[spread(s, q.rows * q.side), 256](slot.data, n->grad, g->data(n->b), g->data(n->c), q, if slot.fresh { 1 } else { 0 });
  }
  var wants_rests: bool = g->nodes[n->b].requires;
  var wants_looks: bool = g->nodes[n->c].requires;
  if (!wants_rests && !wants_looks) { return; }
  var part: float32* = g->floats(q.rows * q.reach);
  var dlooks: float32* = (float32*)0;
  var fresh: int32 = 0;
  if (wants_looks) {
    var slot: GradSlot = g->grad_take(n->c);
    dlooks = slot.data;
    fresh = if slot.fresh { 1 } else { 0 };
  }
  dispatch k_anchor_looks[spread(s, q.rows * q.reach), 256](dlooks, part, n->grad, g->data(n->a), g->data(n->b), g->data(n->c), q, if wants_looks { 1 } else { 0 }, fresh);
  if (wants_rests) {
    var slot: GradSlot = g->grad_take(n->b);
    dispatch k_anchor_rests[spread(s, q.rows), 256](slot.data, part, n->grad, g->data(n->a), q, if slot.fresh { 1 } else { 0 });
  }
}

struct Tally {
  cells: int64;
  sample: int64;
  vocab: int64;
}

kernel(block = 256) k_tally(out: float32*, picks: int32*, q: Tally) {
  var c: int64 = (int64)block.x * 256 + (int64)thread.x;
  var step: int64 = (int64)grid_dim.x * 256;
  while (c < q.cells) {
    var row: float32* = out + c * q.vocab;
    for v: int64 in 0..q.vocab { row[v] = z32(); }
    var n: int64 = 0;
    for j: int64 in 0..q.sample {
      if (picks[c * q.sample + j] >= 0) { n = n + 1; }
    }
    if (n > 0) {
      var each: float32 = one32() / (float32)n;
      for j: int64 in 0..q.sample {
        var p: int64 = (int64)picks[c * q.sample + j];
        if (p >= 0) { row[p] = row[p] + each; }
      }
    }
    c = c + step;
  }
}

fn fwd_tally(s: GpuState*, g: Graph*, id: int32) {
  var n: Node* = g->node(id);
  var q: Tally = { cells: n->value.shape.rows(), sample: n->i0, vocab: n->value.shape.last() };
  dispatch k_tally[spread(s, q.cells), 256](n->value.data, n->ints, q);
}

struct Pick {
  cells: int64;
  group: int64;
  vocab: int64;
}

kernel(block = 256) k_pick(out: float32*, x: float32*, ids: int32*, q: Pick) {
  var c: int64 = (int64)block.x * 256 + (int64)thread.x;
  var step: int64 = (int64)grid_dim.x * 256;
  while (c < q.cells) {
    var id: int64 = (int64)ids[c / q.group];
    out[c] = if id >= 0 { x[c * q.vocab + id] } else { z32() };
    c = c + step;
  }
}

kernel(block = 256) k_pick_fill(dx: float32*, dy: float32*, ids: int32*, q: Pick) {
  var e: int64 = (int64)block.x * 256 + (int64)thread.x;
  var step: int64 = (int64)grid_dim.x * 256;
  while (e < q.cells * q.vocab) {
    var c: int64 = e / q.vocab;
    var id: int64 = (int64)ids[c / q.group];
    dx[e] = if e - c * q.vocab == id { dy[c] } else { z32() };
    e = e + step;
  }
}

kernel(block = 256) k_pick_add(dx: float32*, dy: float32*, ids: int32*, q: Pick) {
  var c: int64 = (int64)block.x * 256 + (int64)thread.x;
  var step: int64 = (int64)grid_dim.x * 256;
  while (c < q.cells) {
    var id: int64 = (int64)ids[c / q.group];
    if (id >= 0) { dx[c * q.vocab + id] = dx[c * q.vocab + id] + dy[c]; }
    c = c + step;
  }
}

fn pick_of(g: Graph*, n: Node*) -> Pick {
  var q: Pick = { cells: n->value.shape.size(), group: n->i0, vocab: g->nodes[n->a].value.shape.last() };
  return q;
}

fn fwd_pick(s: GpuState*, g: Graph*, id: int32) {
  var n: Node* = g->node(id);
  var q: Pick = pick_of(g, n);
  dispatch k_pick[spread(s, q.cells), 256](n->value.data, g->data(n->a), n->ints, q);
}

fn back_pick(s: GpuState*, g: Graph*, id: int32) {
  var n: Node* = g->node(id);
  if (!g->nodes[n->a].requires) { return; }
  var q: Pick = pick_of(g, n);
  var slot: GradSlot = g->grad_take(n->a);
  if (slot.fresh) {
    dispatch k_pick_fill[spread(s, q.cells * q.vocab), 256](slot.data, n->grad, n->ints, q);
  } else {
    dispatch k_pick_add[spread(s, q.cells), 256](slot.data, n->grad, n->ints, q);
  }
}

fn gpu_forward(state: rawptr, g: Graph*, id: int32) {
  var s: GpuState* = state_of(state);
  var op: int32 = g->nodes[id].op;
  if (op >= OP_ADD && op <= OP_DIV) { fwd_binary(s, g, id); return; }
  if (op >= OP_ADD_SCALAR && op <= OP_SQUARE) { fwd_unary(s, g, id); return; }
  if (op >= OP_SUM_ALL && op <= OP_MAX) { fwd_reduce(s, g, id); return; }
  if (op == OP_TRANSPOSE) { fwd_transpose(s, g, id); return; }
  if (op == OP_SLICE) { fwd_slice(s, g, id); return; }
  if (op == OP_CONCAT) { fwd_concat(s, g, id); return; }
  if (op == OP_MATMUL || op == OP_MATMUL_NT) { fwd_matmul(s, g, id); return; }
  if (op == OP_LINEAR) { fwd_linear(s, g, id); return; }
  if (op >= OP_SOFTMAX && op <= OP_CAUSAL_SOFTMAX) { fwd_softmax(s, g, id); return; }
  if (op == OP_CROSS_ENTROPY) { fwd_cross_entropy(s, g, id); return; }
  if (op == OP_MSE || op == OP_BCE_LOGITS) { fwd_pair_loss(s, g, id); return; }
  if (op == OP_LAYER_NORM || op == OP_RMS_NORM) { fwd_norm(s, g, id); return; }
  if (op == OP_DROPOUT) { fwd_dropout(s, g, id); return; }
  if (op == OP_GATHER_ROWS) { fwd_gather(s, g, id); return; }
  if (op == OP_FOLD) { fwd_fold(s, g, id); return; }
  if (op == OP_TAKE) { fwd_take(s, g, id); return; }
  if (op == OP_SPREAD) { fwd_spread(s, g, id); return; }
  if (op == OP_ATTENTION) { fwd_attention(s, g, id); return; }
  if (op == OP_CACHED_ATTENTION) { fwd_cached_attention(s, g, id); return; }
  if (op == OP_RECALL) { fwd_recall(s, g, id); return; }
  if (op == OP_RECALL_EXACT) { fwd_exact(s, g, id); return; }
  if (op == OP_MINGLE) { fwd_mingle(s, g, id); return; }
  if (op == OP_PONDER) { fwd_ponder(s, g, id); return; }
  if (op == OP_PONDER_SUM) { fwd_ponder_sum(s, g, id); return; }
  if (op == OP_FORESEE) { fwd_foresee(s, g, id); return; }
  if (op == OP_CONSULT) { fwd_consult(s, g, id); return; }
  if (op == OP_ADD_MUL) { fwd_add_mul(s, g, id); return; }
  if (op == OP_RESIDUAL) { fwd_residual(s, g, id); return; }
  if (op == OP_FEED) { fwd_feed(s, g, id); return; }
  if (op == OP_PAIR) { fwd_pair(s, g, id); return; }
  if (op == OP_MIX) { fwd_mix(s, g, id); return; }
  if (op == OP_JOIN) { fwd_join(s, g, id); return; }
  if (op == OP_RULES) { fwd_rules(s, g, id); return; }
  if (op == OP_ROUND) { fwd_round(s, g, id); return; }
  if (op == OP_SCALE_BY) { fwd_scale_by(s, g, id); return; }
  if (op == OP_ANCHOR) { fwd_anchor(s, g, id); return; }
  if (op == OP_TALLY) { fwd_tally(s, g, id); return; }
  if (op == OP_PICK) { fwd_pick(s, g, id); return; }
  if (op == OP_SOLVE_TABLE) { fwd_solve_table(s, g, id); return; }
  if (op == OP_SOLVE_PROOF) { fwd_solve_proof(s, g, id); return; }
  if (op == OP_SOLVE_BELIEFS) { fwd_solve_beliefs(s, g, id); return; }
  if (op == OP_SOLVE_TABLES) { fwd_solve_tables(s, g, id); return; }
  if (op == OP_SOLVE_GUESS) { fwd_solve_guess(s, g, id); return; }
  if (op == OP_QK_ROPE) {
    var n: Node* = g->node(id);
    var sh: Shape = n->value.shape;
    var rows: int64 = sh.rows();
    var width: int32 = (int32)(sh.dims[sh.rank - 1] / 3);
    dispatch k_rope[row_blocks(rows * 3 * n->i0), 256](n->value.data, g->data(n->a), n->saved, n->saved2, rows, n->i1, width, (int32)n->i0);
    return;
  }
  if (op == OP_CONV2D) { fwd_conv(s, g, id); return; }
  if (op == OP_MAX_POOL2D || op == OP_AVG_POOL2D) { fwd_pool(s, g, id); return; }
  if (op == OP_BATCH_NORM) { fwd_batch_norm(s, g, id); return; }
  mmll_fail("{op_name(op)} has no GPU kernel");
}

fn gpu_backward(state: rawptr, g: Graph*, id: int32) {
  var s: GpuState* = state_of(state);
  var op: int32 = g->nodes[id].op;
  if (op == OP_LEAF || op == OP_RESHAPE) { return; }
  if (op >= OP_ADD && op <= OP_DIV) { back_binary(s, g, id); return; }
  if (op >= OP_ADD_SCALAR && op <= OP_SQUARE) { back_unary(s, g, id); return; }
  if (op >= OP_SUM_ALL && op <= OP_MAX) { back_reduce(s, g, id); return; }
  if (op == OP_TRANSPOSE) { back_transpose(s, g, id); return; }
  if (op == OP_SLICE) { back_slice(s, g, id); return; }
  if (op == OP_CONCAT) { back_concat(s, g, id); return; }
  if (op == OP_MATMUL || op == OP_MATMUL_NT) { back_matmul(s, g, id); return; }
  if (op == OP_LINEAR) { back_linear(s, g, id); return; }
  if (op >= OP_SOFTMAX && op <= OP_CAUSAL_SOFTMAX) { back_softmax(s, g, id); return; }
  if (op == OP_CROSS_ENTROPY) { back_cross_entropy(s, g, id); return; }
  if (op == OP_MSE || op == OP_BCE_LOGITS) { back_pair_loss(s, g, id); return; }
  if (op == OP_LAYER_NORM || op == OP_RMS_NORM) { back_norm(s, g, id); return; }
  if (op == OP_DROPOUT) { back_dropout(s, g, id); return; }
  if (op == OP_GATHER_ROWS) { back_gather(s, g, id); return; }
  if (op == OP_FOLD) { back_fold(s, g, id); return; }
  if (op == OP_TAKE) { back_take(s, g, id); return; }
  if (op == OP_SPREAD) { back_spread(s, g, id); return; }
  if (op == OP_ATTENTION) { back_attention(s, g, id); return; }
  if (op == OP_RECALL) { back_recall(s, g, id); return; }
  if (op == OP_RECALL_EXACT) { back_exact(s, g, id); return; }
  if (op == OP_MINGLE) { back_mingle(s, g, id); return; }
  if (op == OP_PONDER) { back_ponder(s, g, id); return; }
  if (op == OP_PONDER_SUM) { back_ponder_sum(s, g, id); return; }
  if (op == OP_FORESEE) { back_foresee(s, g, id); return; }
  if (op == OP_CONSULT) { back_consult(s, g, id); return; }
  if (op == OP_ADD_MUL) { back_add_mul(s, g, id); return; }
  if (op == OP_RESIDUAL) { back_residual(s, g, id); return; }
  if (op == OP_FEED) { back_feed(s, g, id); return; }
  if (op == OP_PAIR) { back_pair(s, g, id); return; }
  if (op == OP_MIX) { back_mix(s, g, id); return; }
  if (op == OP_JOIN) { back_join(s, g, id); return; }
  if (op == OP_RULES) { back_rules(s, g, id); return; }
  if (op == OP_ROUND) { back_round(s, g, id); return; }
  if (op == OP_SCALE_BY) { back_scale_by(s, g, id); return; }
  if (op == OP_ANCHOR) { back_anchor(s, g, id); return; }
  if (op == OP_PICK) { back_pick(s, g, id); return; }
  if (op == OP_SOLVE_TABLE) { back_solve_table(s, g, id); return; }
  if (op == OP_SOLVE_PROOF) { back_solve_proof(s, g, id); return; }
  if (op == OP_SOLVE_BELIEFS) { back_solve_beliefs(s, g, id); return; }
  if (op == OP_SOLVE_TABLES) { back_solve_tables(s, g, id); return; }
  if (op == OP_SOLVE_GUESS) { back_solve_guess(s, g, id); return; }
  if (op == OP_QK_ROPE) {
    var n: Node* = g->node(id);
    if (!g->nodes[n->a].requires) { return; }
    var sh: Shape = n->value.shape;
    var rows: int64 = sh.rows();
    var width: int32 = (int32)(sh.dims[sh.rank - 1] / 3);
    var slot: GradSlot = g->grad_take(n->a);
    dispatch k_rope_back[row_blocks(rows * 3 * n->i0), 256](slot.data, n->grad, g->data(n->a), n->saved, n->saved2, rows, n->i1, width, (int32)n->i0, if slot.fresh { 1 } else { 0 });
    return;
  }
  if (op == OP_CONV2D) { back_conv(s, g, id); return; }
  if (op == OP_MAX_POOL2D || op == OP_AVG_POOL2D) { back_pool(s, g, id); return; }
  if (op == OP_BATCH_NORM) { back_batch_norm(s, g, id); return; }
  mmll_fail("{op_name(op)} has no GPU gradient");
}
