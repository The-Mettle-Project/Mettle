import "std/mem";
import "./mmll";

fn random_tensor(s: Shape, seed: uint64, lo: float64, hi: float64) -> Tensor {
  var t: Tensor = tensor_new(s);
  var r: Rng = rng_new(seed);
  tensor_uniform(t, &r, lo, hi);
  return t;
}

fn spread_out(t: Tensor, seed: uint64) {
  var n: int64 = t.shape.size();
  var r: Rng = rng_new(seed);
  var rp: Rng* = &r;
  for i: int64 in 0..n { t.data[i] = (float32)(-1.0 + 2.0 * (float64)i / (float64)n); }
  var i: int64 = n - 1;
  while (i > 0) {
    var j: int64 = rp->below(i + 1);
    var keep: float32 = t.data[i];
    t.data[i] = t.data[j];
    t.data[j] = keep;
    i = i - 1;
  }
}

fn check_spread(build: fn(Graph*, Var*) -> Var, a: Shape) -> int32 {
  var ins: Tensor* = (Tensor*)malloc(sizeof(Tensor));
  ins[0] = tensor_new(a);
  spread_out(ins[0], 5);
  var worst: float64 = gradcheck(build, ins, 1, 1.0e-3, 3.0e-3);
  tensor_free(&ins[0]);
  free((rawptr)ins);
  if (worst > 3.0e-3) { return 1; }
  return 0;
}

fn away_from_zero(t: Tensor) {
  for i: int64 in 0..t.shape.size() {
    var v: float32 = t.data[i];
    if (v > (float32)-0.05 && v < (float32)0.05) { t.data[i] = if v < (float32)0.0 { (float32)-0.2 } else { (float32)0.2 }; }
  }
}

fn check1(build: fn(Graph*, Var*) -> Var, a: Shape, lo: float64, hi: float64, eps: float64, tol: float64, kink: bool) -> int32 {
  var ins: Tensor* = (Tensor*)malloc(sizeof(Tensor));
  ins[0] = random_tensor(a, 11, lo, hi);
  if (kink) { away_from_zero(ins[0]); }
  var worst: float64 = gradcheck(build, ins, 1, eps, tol);
  tensor_free(&ins[0]);
  free((rawptr)ins);
  if (worst > tol) {
    println("gradient off by {worst}");
    return 1;
  }
  return 0;
}

fn check2(build: fn(Graph*, Var*) -> Var, a: Shape, b: Shape, lo: float64, hi: float64, tol: float64) -> int32 {
  var ins: Tensor* = (Tensor*)malloc(2 * sizeof(Tensor));
  ins[0] = random_tensor(a, 11, lo, hi);
  ins[1] = random_tensor(b, 23, lo, hi);
  var worst: float64 = gradcheck(build, ins, 2, 1.0e-2, tol);
  tensor_free(&ins[0]);
  tensor_free(&ins[1]);
  free((rawptr)ins);
  if (worst > tol) {
    println("gradient off by {worst}");
    return 1;
  }
  return 0;
}

fn check3(build: fn(Graph*, Var*) -> Var, a: Shape, b: Shape, c: Shape, tol: float64) -> int32 {
  var ins: Tensor* = (Tensor*)malloc(3 * sizeof(Tensor));
  ins[0] = random_tensor(a, 11, -1.0, 1.0);
  ins[1] = random_tensor(b, 23, -1.0, 1.0);
  ins[2] = random_tensor(c, 37, -1.0, 1.0);
  var worst: float64 = gradcheck(build, ins, 3, 1.0e-2, tol);
  for i in 0..3 { tensor_free(&ins[i]); }
  free((rawptr)ins);
  if (worst > tol) {
    println("gradient off by {worst}");
    return 1;
  }
  return 0;
}

fn f_add(g: Graph*, v: Var*) -> Var { return v[0].add(v[1]); }
fn f_sub(g: Graph*, v: Var*) -> Var { return v[0].sub(v[1]); }
fn f_mul(g: Graph*, v: Var*) -> Var { return v[0].mul(v[1]); }
fn f_div(g: Graph*, v: Var*) -> Var { return v[0].div(v[1].abs().shift(0.5)); }
fn f_add_mul(g: Graph*, v: Var*) -> Var { return add_mul(v[0], v[1], v[2]); }

@test fn grad_binary_same_shape() -> int32 {
  var s: Shape = shape(3, 4);
  if (check2(&f_add, s, s, -1.0, 1.0, 3.0e-3) != 0) { return 1; }
  if (check2(&f_sub, s, s, -1.0, 1.0, 3.0e-3) != 0) { return 2; }
  if (check2(&f_mul, s, s, -1.0, 1.0, 3.0e-3) != 0) { return 3; }
  if (check2(&f_div, s, s, -1.0, 1.0, 3.0e-3) != 0) { return 4; }
  return 0;
}

@test fn grad_add_mul() -> int32 {
  if (check3(&f_add_mul, shape(2, 3, 4), shape(2, 3, 4), shape(2, 3, 4), 1.0e-3) != 0) { return 1; }
  return 0;
}

@test fn grad_binary_broadcast() -> int32 {
  if (check2(&f_add, shape(2, 3, 4), shape(4), -1.0, 1.0, 3.0e-3) != 0) { return 1; }
  if (check2(&f_mul, shape(2, 1, 4), shape(3, 1), -1.0, 1.0, 3.0e-3) != 0) { return 2; }
  if (check2(&f_sub, shape(1, 3), shape(2, 1, 1), -1.0, 1.0, 3.0e-3) != 0) { return 3; }
  if (check2(&f_div, shape(2, 3), shape(1), -1.0, 1.0, 3.0e-3) != 0) { return 4; }
  return 0;
}

fn f_neg(g: Graph*, v: Var*) -> Var { return v[0].neg(); }
fn f_exp(g: Graph*, v: Var*) -> Var { return v[0].exp(); }
fn f_log(g: Graph*, v: Var*) -> Var { return v[0].log(); }
fn f_sqrt(g: Graph*, v: Var*) -> Var { return v[0].sqrt(); }
fn f_tanh(g: Graph*, v: Var*) -> Var { return v[0].tanh(); }
fn f_sigmoid(g: Graph*, v: Var*) -> Var { return v[0].sigmoid(); }
fn f_relu(g: Graph*, v: Var*) -> Var { return v[0].relu(); }
fn f_leaky(g: Graph*, v: Var*) -> Var { return v[0].leaky_relu(0.1); }
fn f_gelu(g: Graph*, v: Var*) -> Var { return v[0].gelu(); }
fn f_gelu_tanh(g: Graph*, v: Var*) -> Var { return v[0].gelu_tanh(); }
fn f_silu(g: Graph*, v: Var*) -> Var { return v[0].silu(); }
fn f_softplus(g: Graph*, v: Var*) -> Var { return v[0].softplus(); }
fn f_abs(g: Graph*, v: Var*) -> Var { return v[0].abs(); }
fn f_clamp(g: Graph*, v: Var*) -> Var { return v[0].clamp(-0.5, 0.6); }
fn f_square(g: Graph*, v: Var*) -> Var { return v[0].square(); }
fn f_shift(g: Graph*, v: Var*) -> Var { return v[0].shift(0.3).scale(-1.7); }
fn f_pow(g: Graph*, v: Var*) -> Var { return v[0].pow(1.5); }

@test fn grad_unary() -> int32 {
  var s: Shape = shape(2, 5);
  if (check1(&f_neg, s, -2.0, 2.0, 1.0e-2, 3.0e-3, false) != 0) { return 1; }
  if (check1(&f_exp, s, -2.0, 2.0, 1.0e-2, 3.0e-3, false) != 0) { return 2; }
  if (check1(&f_log, s, 0.5, 3.0, 1.0e-2, 3.0e-3, false) != 0) { return 3; }
  if (check1(&f_sqrt, s, 0.5, 3.0, 1.0e-2, 3.0e-3, false) != 0) { return 4; }
  if (check1(&f_tanh, s, -2.0, 2.0, 1.0e-2, 3.0e-3, false) != 0) { return 5; }
  if (check1(&f_sigmoid, s, -3.0, 3.0, 1.0e-2, 3.0e-3, false) != 0) { return 6; }
  if (check1(&f_relu, s, -2.0, 2.0, 1.0e-2, 3.0e-3, true) != 0) { return 7; }
  if (check1(&f_leaky, s, -2.0, 2.0, 1.0e-2, 3.0e-3, true) != 0) { return 8; }
  if (check1(&f_gelu, s, -3.0, 3.0, 1.0e-2, 3.0e-3, false) != 0) { return 9; }
  if (check1(&f_gelu_tanh, s, -3.0, 3.0, 1.0e-2, 3.0e-3, false) != 0) { return 10; }
  if (check1(&f_silu, s, -3.0, 3.0, 1.0e-2, 3.0e-3, false) != 0) { return 11; }
  if (check1(&f_softplus, s, -3.0, 3.0, 1.0e-2, 3.0e-3, false) != 0) { return 12; }
  if (check1(&f_abs, s, -2.0, 2.0, 1.0e-2, 3.0e-3, true) != 0) { return 13; }
  if (check1(&f_clamp, s, -0.4, 0.5, 1.0e-2, 3.0e-3, false) != 0) { return 14; }
  if (check1(&f_square, s, -2.0, 2.0, 1.0e-2, 3.0e-3, false) != 0) { return 15; }
  if (check1(&f_shift, s, -2.0, 2.0, 1.0e-2, 3.0e-3, false) != 0) { return 16; }
  if (check1(&f_pow, s, 0.5, 2.0, 1.0e-2, 3.0e-3, false) != 0) { return 17; }
  return 0;
}

fn f_sum(g: Graph*, v: Var*) -> Var { return v[0].sum(); }
fn f_mean(g: Graph*, v: Var*) -> Var { return v[0].mean(); }
fn f_sum0(g: Graph*, v: Var*) -> Var { return v[0].sum_axis(0, false); }
fn f_sum1k(g: Graph*, v: Var*) -> Var { return v[0].sum_axis(1, true); }
fn f_mean2(g: Graph*, v: Var*) -> Var { return v[0].mean_axis(-1, false); }
fn f_max1(g: Graph*, v: Var*) -> Var { return v[0].max_axis(1, false); }

@test fn grad_reductions() -> int32 {
  var s: Shape = shape(2, 3, 4);
  if (check1(&f_sum, s, -1.0, 1.0, 1.0e-2, 3.0e-3, false) != 0) { return 1; }
  if (check1(&f_mean, s, -1.0, 1.0, 1.0e-2, 3.0e-3, false) != 0) { return 2; }
  if (check1(&f_sum0, s, -1.0, 1.0, 1.0e-2, 3.0e-3, false) != 0) { return 3; }
  if (check1(&f_sum1k, s, -1.0, 1.0, 1.0e-2, 3.0e-3, false) != 0) { return 4; }
  if (check1(&f_mean2, s, -1.0, 1.0, 1.0e-2, 3.0e-3, false) != 0) { return 5; }
  if (check_spread(&f_max1, s) != 0) { return 6; }
  return 0;
}

fn f_reshape(g: Graph*, v: Var*) -> Var { return v[0].view(4, -1).mul(v[0].view(4, 6)); }
fn f_t01(g: Graph*, v: Var*) -> Var { return v[0].transpose(0, 1); }
fn f_t12(g: Graph*, v: Var*) -> Var { return v[0].transpose(1, 2); }
fn f_t02(g: Graph*, v: Var*) -> Var { return v[0].transpose(0, 2); }
fn f_slice(g: Graph*, v: Var*) -> Var { return v[0].slice(1, 1, 2); }
fn f_concat(g: Graph*, v: Var*) -> Var { return concat(v[0], v[1], 1); }

@test fn grad_shape_ops() -> int32 {
  var s: Shape = shape(2, 3, 4);
  if (check1(&f_reshape, s, -1.0, 1.0, 1.0e-2, 3.0e-3, false) != 0) { return 1; }
  if (check1(&f_t01, s, -1.0, 1.0, 1.0e-2, 3.0e-3, false) != 0) { return 2; }
  if (check1(&f_t12, s, -1.0, 1.0, 1.0e-2, 3.0e-3, false) != 0) { return 3; }
  if (check1(&f_t02, s, -1.0, 1.0, 1.0e-2, 3.0e-3, false) != 0) { return 4; }
  if (check1(&f_slice, s, -1.0, 1.0, 1.0e-2, 3.0e-3, false) != 0) { return 5; }
  if (check2(&f_concat, s, shape(2, 2, 4), -1.0, 1.0, 3.0e-3) != 0) { return 6; }
  return 0;
}

fn f_matmul(g: Graph*, v: Var*) -> Var { return v[0].matmul(v[1]); }
fn f_matmul_t(g: Graph*, v: Var*) -> Var { return v[0].matmul_t(v[1]); }
fn f_linear(g: Graph*, v: Var*) -> Var { return linear(v[0], v[1], v[2]); }

@test fn grad_matmul() -> int32 {
  if (check2(&f_matmul, shape(3, 4), shape(4, 5), -1.0, 1.0, 3.0e-3) != 0) { return 1; }
  if (check2(&f_matmul, shape(2, 3, 4), shape(4, 2), -1.0, 1.0, 3.0e-3) != 0) { return 2; }
  if (check2(&f_matmul, shape(2, 3, 4), shape(2, 4, 2), -1.0, 1.0, 3.0e-3) != 0) { return 3; }
  if (check2(&f_matmul_t, shape(3, 4), shape(5, 4), -1.0, 1.0, 3.0e-3) != 0) { return 4; }
  if (check2(&f_matmul_t, shape(2, 3, 4), shape(2, 5, 4), -1.0, 1.0, 3.0e-3) != 0) { return 5; }
  if (check3(&f_linear, shape(2, 3, 4), shape(5, 4), shape(5), 3.0e-3) != 0) { return 6; }
  return 0;
}

fn f_softmax(g: Graph*, v: Var*) -> Var { return v[0].softmax(); }
fn f_log_softmax(g: Graph*, v: Var*) -> Var { return v[0].log_softmax(); }
fn f_causal(g: Graph*, v: Var*) -> Var { return v[0].causal_softmax(); }

fn f_xent(g: Graph*, v: Var*) -> Var {
  var t: int32* = g->ints(4);
  t[0] = 2;
  t[1] = 0;
  t[2] = -1;
  t[3] = 4;
  return cross_entropy(v[0], t, 0.0);
}

fn f_xent_smooth(g: Graph*, v: Var*) -> Var {
  var t: int32* = g->ints(4);
  t[0] = 1;
  t[1] = 3;
  t[2] = 0;
  t[3] = 4;
  return cross_entropy(v[0], t, 0.1);
}

fn f_mse(g: Graph*, v: Var*) -> Var { return mse_loss(v[0], v[1]); }
fn f_bce(g: Graph*, v: Var*) -> Var { return bce_with_logits(v[0], v[1].sigmoid()); }

@test fn grad_softmax_and_losses() -> int32 {
  if (check1(&f_softmax, shape(3, 5), -2.0, 2.0, 1.0e-2, 3.0e-3, false) != 0) { return 1; }
  if (check1(&f_log_softmax, shape(3, 5), -2.0, 2.0, 1.0e-2, 3.0e-3, false) != 0) { return 2; }
  if (check1(&f_causal, shape(2, 4, 4), -2.0, 2.0, 1.0e-2, 3.0e-3, false) != 0) { return 3; }
  if (check1(&f_causal, shape(2, 3, 5), -2.0, 2.0, 1.0e-2, 3.0e-3, false) != 0) { return 4; }
  if (check1(&f_xent, shape(4, 5), -2.0, 2.0, 1.0e-2, 3.0e-3, false) != 0) { return 5; }
  if (check1(&f_xent_smooth, shape(2, 2, 5), -2.0, 2.0, 1.0e-2, 3.0e-3, false) != 0) { return 6; }
  if (check2(&f_mse, shape(3, 4), shape(3, 4), -1.0, 1.0, 3.0e-3) != 0) { return 7; }
  if (check2(&f_bce, shape(3, 4), shape(3, 4), -2.0, 2.0, 3.0e-3) != 0) { return 8; }
  return 0;
}

fn f_layer_norm(g: Graph*, v: Var*) -> Var { return layer_norm(v[0], v[1], v[2], 1.0e-5); }
fn f_layer_norm_plain(g: Graph*, v: Var*) -> Var { return layer_norm_plain(v[0], 1.0e-5); }
fn f_rms_norm(g: Graph*, v: Var*) -> Var { return rms_norm(v[0], v[1], 1.0e-6); }
fn f_rms_plain(g: Graph*, v: Var*) -> Var { return rms_norm_plain(v[0], 1.0e-6); }

@test fn grad_norms() -> int32 {
  if (check3(&f_layer_norm, shape(3, 6), shape(6), shape(6), 3.0e-3) != 0) { return 1; }
  if (check1(&f_layer_norm_plain, shape(2, 2, 5), -2.0, 2.0, 1.0e-2, 3.0e-3, false) != 0) { return 2; }
  if (check2(&f_rms_norm, shape(3, 6), shape(6), -1.0, 1.0, 3.0e-3) != 0) { return 3; }
  if (check1(&f_rms_plain, shape(4, 5), -2.0, 2.0, 1.0e-2, 3.0e-3, false) != 0) { return 4; }
  return 0;
}

fn f_gather(g: Graph*, v: Var*) -> Var {
  var ids: int32* = g->ints(5);
  ids[0] = 3;
  ids[1] = 0;
  ids[2] = 3;
  ids[3] = 1;
  ids[4] = 2;
  return embedding(v[0], ids, 5).square();
}

fn f_dropout(g: Graph*, v: Var*) -> Var { return dropout(v[0], 0.3); }

@test fn grad_embedding_and_dropout() -> int32 {
  if (check1(&f_gather, shape(4, 3), -1.0, 1.0, 1.0e-2, 3.0e-3, false) != 0) { return 1; }
  if (check1(&f_dropout, shape(4, 6), -1.0, 1.0, 1.0e-2, 3.0e-3, false) != 0) { return 2; }
  return 0;
}

fn f_conv(g: Graph*, v: Var*) -> Var { return conv2d(v[0], v[1], v[2], 1, 1); }
fn f_conv_stride(g: Graph*, v: Var*) -> Var { return conv2d(v[0], v[1], v[2], 2, 1); }
fn f_conv_dilated(g: Graph*, v: Var*) -> Var { return conv2d_dilated(v[0], v[1], v[2], 1, 2, 2); }
fn f_max_pool(g: Graph*, v: Var*) -> Var { return max_pool2d(v[0], 2, 2, 0); }
fn f_max_pool_pad(g: Graph*, v: Var*) -> Var { return max_pool2d(v[0], 3, 2, 1); }
fn f_avg_pool(g: Graph*, v: Var*) -> Var { return avg_pool2d(v[0], 2, 1, 0); }
fn f_global(g: Graph*, v: Var*) -> Var { return global_avg_pool(v[0]); }
fn f_batch_norm(g: Graph*, v: Var*) -> Var { return batch_norm(v[0], v[1], v[2], (float32*)0, (float32*)0, 0.1, 1.0e-5); }

@test fn grad_conv() -> int32 {
  return check3(&f_conv, shape(1, 2, 4, 4), shape(2, 2, 3, 3), shape(2), 3.0e-3);
}

@test fn grad_conv_stride() -> int32 {
  return check3(&f_conv_stride, shape(1, 1, 5, 5), shape(2, 1, 3, 3), shape(2), 3.0e-3);
}

@test fn grad_conv_dilated() -> int32 {
  return check3(&f_conv_dilated, shape(1, 1, 5, 5), shape(1, 1, 3, 3), shape(1), 3.0e-3);
}

@test fn grad_pool_and_batch_norm() -> int32 {
  if (check_spread(&f_max_pool, shape(2, 2, 4, 4)) != 0) { return 4; }
  if (check_spread(&f_max_pool_pad, shape(1, 2, 5, 5)) != 0) { return 5; }
  if (check1(&f_avg_pool, shape(1, 2, 3, 4), -1.0, 1.0, 1.0e-2, 3.0e-3, false) != 0) { return 6; }
  if (check1(&f_global, shape(2, 3, 2, 2), -1.0, 1.0, 1.0e-2, 3.0e-3, false) != 0) { return 7; }
  if (check3(&f_batch_norm, shape(3, 2, 2, 2), shape(2), shape(2), 3.0e-3) != 0) { return 8; }
  if (check3(&f_batch_norm, shape(4, 3), shape(3), shape(3), 3.0e-3) != 0) { return 9; }
  return 0;
}

fn f_attn_causal(g: Graph*, v: Var*) -> Var { return self_attention(v[0], 2, true, 0.0); }
fn f_attn_full(g: Graph*, v: Var*) -> Var { return self_attention(v[0], 3, false, 0.0); }
fn f_attn_drop(g: Graph*, v: Var*) -> Var { return self_attention(v[0], 2, true, 0.25); }
fn f_attn_unfused_drop(g: Graph*, v: Var*) -> Var { return attention_composed(v[0], 2, true, 0.0); }

@test fn grad_self_attention() -> int32 {
  if (check1(&f_attn_causal, shape(2, 4, 12), -1.0, 1.0, 1.0e-2, 3.0e-3, false) != 0) { return 1; }
  if (check1(&f_attn_full, shape(1, 3, 18), -1.0, 1.0, 1.0e-2, 3.0e-3, false) != 0) { return 2; }
  if (check1(&f_attn_drop, shape(1, 5, 12), -1.0, 1.0, 1.0e-2, 3.0e-3, false) != 0) { return 3; }
  return 0;
}

fn f_rope(g: Graph*, v: Var*) -> Var { return qk_norm_rope(v[0], 2, 100.0, 0).square(); }
fn f_rope_offset(g: Graph*, v: Var*) -> Var { return qk_norm_rope(v[0], 1, 10.0, 3).mul(qk_norm_rope(v[0], 1, 10.0, 3)).tanh(); }

@test fn grad_qk_norm_rope() -> int32 {
  if (check1(&f_rope, shape(2, 3, 24), -1.0, 1.0, 1.0e-2, 3.0e-3, false) != 0) { return 1; }
  if (check1(&f_rope_offset, shape(4, 12), -1.0, 1.0, 1.0e-2, 3.0e-3, false) != 0) { return 2; }
  return 0;
}

@test fn muon_orthogonalizes() -> int32 {
  var rows: int64 = 8;
  var cols: int64 = 24;
  var x: Tensor = random_tensor(shape(2, rows, cols), 5, -1.0, 1.0);
  orthogonalize_cpu(x.data, 2, rows, cols, 5);
  var worst: float64 = 0.0;
  for z: int64 in 0..2 {
    var base: float32* = x.data + z * rows * cols;
    for i: int64 in 0..rows {
      for j: int64 in 0..rows {
        var s: float64 = 0.0;
        for c: int64 in 0..cols { s = s + (float64)base[i * cols + c] * (float64)base[j * cols + c]; }
        var want: float64 = if i == j { 1.0 } else { 0.0 };
        var d: float64 = s - want;
        if (d < 0.0) { d = -d; }
        if (d > worst) { worst = d; }
      }
    }
  }
  tensor_free(&x);
  if (worst > 0.35) { return 1; }
  return 0;
}

@test fn fused_attention_equals_composed() -> int32 {
  var x: Tensor = random_tensor(shape(2, 5, 12), 3, -1.0, 1.0);
  var g: Graph* = graph_new();
  var v: Var = g->input(x);
  var a: Var = self_attention(v, 2, true, 0.0);
  var b: Var = attention_composed(v, 2, true, 0.0);
  var worst: float32 = 0.0;
  for i: int64 in 0..a.size() {
    var d: float32 = a.data()[i] - b.data()[i];
    if (d < (float32)0.0) { d = -d; }
    if (d > worst) { worst = d; }
  }
  graph_free(g);
  tensor_free(&x);
  if (worst > (float32)1.0e-6) { return 1; }
  return 0;
}

fn recall_table(g: Graph*, heads: int64, chunk: int64, chunks: int64) -> float32* {
  var keeps: float64[4] = [0.8, 1.0, 0.5, 0.95];
  var made: float32* = recall_powers((Device*)0, &keeps[0], heads, chunk, chunks);
  var count: int64 = heads * (chunk + 1 + chunks);
  var held: float32* = (float32*)g->host_alloc(count * 4);
  for i: int64 in 0..count { held[i] = made[i]; }
  free((rawptr)made);
  return held;
}

fn f_recall(g: Graph*, v: Var*) -> Var { return recall(v[0], v[1], v[2], 2, 2, recall_table(g, 2, 2, 2)); }
fn f_recall_ungated(g: Graph*, v: Var*) -> Var { return recall_ungated(v[0], v[1], 2, 3, recall_table(g, 2, 3, 1)); }

fn f_exact(g: Graph*, v: Var*) -> Var { return recall_exact(v[0], v[1], v[2], 2, 2, recall_table(g, 2, 2, 2)); }
fn f_exact_ungated(g: Graph*, v: Var*) -> Var { return recall_exact_ungated(v[0], v[1], 2, 3, recall_table(g, 2, 3, 1)); }

@test fn grad_recall_exact() -> int32 {
  if (check3(&f_exact, shape(1, 4, 8), shape(1, 4, 4), shape(1, 4, 2), 3.0e-3) != 0) { return 1; }
  if (check2(&f_exact_ungated, shape(1, 3, 8), shape(1, 3, 4), -1.0, 1.0, 3.0e-3) != 0) { return 2; }
  return 0;
}

@test fn recall_exact_overwrites() -> int32 {
  var kv: Tensor = tensor_new(shape(1, 3, 8));
  var q: Tensor = tensor_new(shape(1, 3, 4));
  var key: float32[4] = [0.5, -1.0, 2.0, 0.25];
  for t: int64 in 0..3 {
    for e: int64 in 0..4 {
      kv.data[t * 8 + e] = key[e];
      kv.data[t * 8 + 4 + e] = (float32)(t * 4 + e + 1);
      q.data[t * 4 + e] = key[e];
    }
  }
  var g: Graph* = graph_new();
  var keeps: float64[1] = [1.0];
  var table: float32* = recall_powers((Device*)0, &keeps[0], 1, 3, 1);
  var out: Var = recall_exact_ungated(g->input(kv), g->input(q), 1, 3, table);
  var worst: float32 = 0.0;
  for t: int64 in 0..3 {
    for e: int64 in 0..4 {
      var d: float32 = out.data()[t * 4 + e] - (float32)2.0 * kv.data[t * 8 + 4 + e];
      if (d < (float32)0.0) { d = -d; }
      if (d > worst) { worst = d; }
    }
  }
  graph_free(g);
  free((rawptr)table);
  tensor_free(&kv);
  tensor_free(&q);
  if (worst > (float32)1.0e-4) {
    println("a repeated key returned its old value, off by {worst}");
    return 1;
  }
  return 0;
}

fn carried_table(g: Graph*, count: int64) -> float32* {
  var held: float32* = (float32*)g->host_alloc(count * 4);
  for i: int64 in 0..count { held[i] = (float32)((i * 7) % 11) * (float32)0.1 - (float32)0.5; }
  return held;
}

fn f_carried(g: Graph*, v: Var*) -> Var { return recall_carried(v[0], v[1], v[2], 2, 2, recall_table(g, 2, 2, 2), false, carried_table(g, 8), (float32*)0); }
fn f_carried_exact(g: Graph*, v: Var*) -> Var { return recall_carried(v[0], v[1], v[2], 2, 2, recall_table(g, 2, 2, 2), true, carried_table(g, 8), (float32*)0); }

@test fn grad_recall_carried() -> int32 {
  if (check3(&f_carried, shape(1, 4, 8), shape(1, 4, 4), shape(1, 4, 2), 3.0e-3) != 0) { return 1; }
  if (check3(&f_carried_exact, shape(1, 4, 8), shape(1, 4, 4), shape(1, 4, 2), 3.0e-3) != 0) { return 2; }
  return 0;
}

fn split_gap(exact: bool) -> float32 {
  var kv: Tensor = random_tensor(shape(2, 8, 16), 3, -1.0, 1.0);
  var q: Tensor = random_tensor(shape(2, 8, 8), 4, -1.0, 1.0);
  var gate: Tensor = random_tensor(shape(2, 8, 2), 5, -1.0, 1.0);
  var g: Graph* = graph_new();
  var pair: Var = g->input(kv);
  var ask: Var = g->input(q);
  var gates: Var = g->input(gate);
  var table: float32* = recall_table(g, 2, 4, 2);
  var half: float32* = recall_table(g, 2, 4, 1);
  var between: float32* = (float32*)g->host_alloc(2 * 2 * 16 * 4);
  var whole: Var = recall_carried(pair, ask, gates, 2, 4, table, exact, (float32*)0, (float32*)0);
  var first: Var = recall_carried(pair.slice(1, 0, 4), ask.slice(1, 0, 4), gates.slice(1, 0, 4), 2, 4, half, exact, (float32*)0, between);
  var second: Var = recall_carried(pair.slice(1, 4, 4), ask.slice(1, 4, 4), gates.slice(1, 4, 4), 2, 4, half, exact, between, (float32*)0);
  var joined: Var = concat(first, second, 1);
  var worst: float32 = 0.0;
  for i: int64 in 0..whole.size() {
    var d: float32 = whole.data()[i] - joined.data()[i];
    if (d < (float32)0.0) { d = -d; }
    if (d > worst) { worst = d; }
  }
  graph_free(g);
  tensor_free(&kv);
  tensor_free(&q);
  tensor_free(&gate);
  return worst;
}

@test fn recall_carried_equals_whole() -> int32 {
  if (split_gap(false) > (float32)2.0e-6) { return 1; }
  if (split_gap(true) > (float32)2.0e-6) { return 2; }
  return 0;
}

@test fn grad_recall() -> int32 {
  if (check3(&f_recall, shape(1, 4, 8), shape(1, 4, 4), shape(1, 4, 2), 3.0e-3) != 0) { return 1; }
  if (check2(&f_recall_ungated, shape(1, 3, 8), shape(1, 3, 4), -1.0, 1.0, 3.0e-3) != 0) { return 2; }
  return 0;
}

@test fn fused_recall_equals_composed() -> int32 {
  var kv: Tensor = random_tensor(shape(2, 6, 16), 3, -1.0, 1.0);
  var q: Tensor = random_tensor(shape(2, 6, 8), 4, -1.0, 1.0);
  var gate: Tensor = random_tensor(shape(2, 6, 2), 5, -1.0, 1.0);
  var fade: Tensor = tensor_new(shape(2, 2, 6, 6));
  var keeps: float64[2] = [0.8, 1.0];
  for b: int64 in 0..2 {
    for h: int64 in 0..2 {
      for t: int64 in 0..6 {
        for from: int64 in 0..6 {
          var w: float64 = 0.0;
          if (from <= t) {
            w = 0.5;
            for p: int64 in 0..t - from { w = w * keeps[h]; }
          }
          fade.data[((b * 2 + h) * 6 + t) * 6 + from] = (float32)w;
        }
      }
    }
  }
  var g: Graph* = graph_new();
  var pair: Var = g->input(kv);
  var ask: Var = g->input(q);
  var gates: Var = g->input(gate);
  var a: Var = recall(pair, ask, gates, 2, 3, recall_table(g, 2, 3, 2));
  var key: Var = rms_norm_plain(pair.slice(2, 0, 8).view(2, 6, 2, 4), 1.0e-6).transpose(1, 2);
  var value: Var = pair.slice(2, 8, 8).view(2, 6, 2, 4).transpose(1, 2).mul(gates.sigmoid().view(2, 6, 2, 1).transpose(1, 2));
  var query: Var = rms_norm_plain(ask.view(2, 6, 2, 4), 1.0e-6).transpose(1, 2);
  var b: Var = query.matmul_t(key).mul(g->input(fade)).matmul(value).transpose(1, 2).view(2, 6, 8);
  var worst: float32 = 0.0;
  for i: int64 in 0..a.size() {
    var d: float32 = a.data()[i] - b.data()[i];
    if (d < (float32)0.0) { d = -d; }
    if (d > worst) { worst = d; }
  }
  graph_free(g);
  tensor_free(&kv);
  tensor_free(&q);
  tensor_free(&gate);
  tensor_free(&fade);
  if (worst > (float32)2.0e-6) {
    println("fused and composed differ by {worst}");
    return 1;
  }
  return 0;
}

fn f_mingle(g: Graph*, v: Var*) -> Var { return mingle(v[0], 2); }

@test fn grad_mingle() -> int32 {
  if (check1(&f_mingle, shape(1, 3, 12), -1.0, 1.0, 1.0e-2, 3.0e-3, false) != 0) { return 1; }
  return 0;
}

@test fn mingle_equals_composed() -> int32 {
  var x: Tensor = random_tensor(shape(2, 5, 24), 9, -1.0, 1.0);
  var g: Graph* = graph_new();
  var p: Var = g->input(x);
  var a: Var = mingle(p, 2);
  var key: Var = rms_norm_plain(p.slice(2, 0, 8).view(2, 5, 2, 4), 1.0e-6).scale(0.5).transpose(1, 2);
  var value: Var = p.slice(2, 8, 8).view(2, 5, 2, 4).transpose(1, 2);
  var query: Var = rms_norm_plain(p.slice(2, 16, 8).view(2, 5, 2, 4), 1.0e-6).transpose(1, 2);
  var b: Var = query.matmul_t(key).matmul(value).scale(0.2).transpose(1, 2).view(2, 5, 8);
  var worst: float32 = 0.0;
  for i: int64 in 0..a.size() {
    var d: float32 = a.data()[i] - b.data()[i];
    if (d < (float32)0.0) { d = -d; }
    if (d > worst) { worst = d; }
  }
  graph_free(g);
  tensor_free(&x);
  if (worst > (float32)2.0e-6) {
    println("fused and composed differ by {worst}");
    return 1;
  }
  return 0;
}

fn part(x: Var, at: int64*, rows: int64, cols: int64) -> Var {
  var piece: Var = x.slice(0, at[0], rows * cols).view(rows, cols);
  at[0] = at[0] + rows * cols;
  return piece;
}

fn thinking_of(x: Var, at: int64*, w: int64, hid: int64) -> Thinking {
  var k: Thinking;
  k.pack = part(x, at, 3 * w, w);
  k.proj = part(x, at, w, w);
  k.fc = part(x, at, hid, w);
  k.out = part(x, at, w, hid);
  k.gate = part(x, at, 1, w);
  k.bias = part(x, at, 1, 1);
  k.seek = no_gate(x.g);
  k.fetch = no_gate(x.g);
  return k;
}

fn ponder_of(x: Var, batch: int64, rooms: int64, w: int64, hid: int64, heads: int64) -> Var {
  var at: int64 = 0;
  var held: Var = part(x, &at, batch * rooms, w).view(batch, rooms, w);
  var seats: Var = part(x, &at, batch * rooms, w).view(batch, rooms, w);
  return ponder(held, seats, thinking_of(x, &at, w, hid), heads);
}

fn foresee_of(x: Var, spans: int64, rounds: int64, rows: int64, w: int64, hid: int64) -> Var {
  var at: int64 = spans * rounds * rows * w;
  var trace: Var = x.slice(0, 0, at).view(spans, rounds, rows, w);
  var seats: Var = part(x, &at, rows, w);
  var fore: Var = part(x, &at, hid, w);
  var tell: Var = part(x, &at, w, hid);
  return foresee(trace, seats, fore, tell, 1, 0.5);
}

fn f_ponder(g: Graph*, v: Var*) -> Var { return ponder_of(v[0], 2, 3, 8, 12, 2); }

fn heed_of(x: Var, batch: int64, rooms: int64, w: int64, hid: int64, heads: int64) -> Var {
  var at: int64 = 0;
  var held: Var = part(x, &at, batch * rooms, w).view(batch, rooms, w);
  var seats: Var = part(x, &at, batch * rooms, w).view(batch, rooms, w);
  var heed: Var = part(x, &at, batch * rooms, w).view(batch, rooms, w);
  return ponder_with(held, seats, heed, thinking_of(x, &at, w, hid), heads, no_gate(x.g), 0);
}

fn f_ponder_heed(g: Graph*, v: Var*) -> Var { return heed_of(v[0], 2, 3, 8, 12, 2); }

fn f_ponder_heed_small(g: Graph*, v: Var*) -> Var { return heed_of(v[0], 1, 2, 4, 4, 2); }

fn f_ponder_heed_composed(g: Graph*, v: Var*) -> Var {
  var at: int64 = 0;
  var held: Var = part(v[0], &at, 6, 8).view(2, 3, 8);
  var seats: Var = part(v[0], &at, 6, 8).view(2, 3, 8);
  var heed: Var = part(v[0], &at, 6, 8).view(2, 3, 8);
  var k: Thinking = thinking_of(v[0], &at, 8, 12);
  var here: Var = rms_norm_plain(held.add(seats), 1.0e-6).add(heed);
  var told: Var = linear_nobias(rms_norm_plain(mingle(linear_nobias(here, k.pack), 2), 1.0e-6), k.proj);
  var worked: Var = linear_nobias(linear_nobias(rms_norm_plain(held.add(told), 1.0e-6), k.fc).gelu_tanh(), k.out);
  var share: Var = linear(here, k.gate, k.bias.view(1)).sigmoid().matmul(g->full(shape(2, 1, 8), 1.0));
  return held.add(told.add(worked).mul(share));
}

fn f_ponder_small(g: Graph*, v: Var*) -> Var { return ponder_of(v[0], 1, 2, 4, 4, 2); }

fn f_ponder_composed(g: Graph*, v: Var*) -> Var {
  var at: int64 = 0;
  var held: Var = part(v[0], &at, 6, 8).view(2, 3, 8);
  var seats: Var = part(v[0], &at, 6, 8).view(2, 3, 8);
  var k: Thinking = thinking_of(v[0], &at, 8, 12);
  var here: Var = rms_norm_plain(held.add(seats), 1.0e-6);
  var told: Var = linear_nobias(rms_norm_plain(mingle(linear_nobias(here, k.pack), 2), 1.0e-6), k.proj);
  var worked: Var = linear_nobias(linear_nobias(rms_norm_plain(held.add(told), 1.0e-6), k.fc).gelu_tanh(), k.out);
  var share: Var = linear(here, k.gate, k.bias.view(1)).sigmoid().matmul(g->full(shape(2, 1, 8), 1.0));
  return held.add(told.add(worked).mul(share));
}

fn f_foresee(g: Graph*, v: Var*) -> Var { return foresee_of(v[0], 3, 2, 6, 8, 12); }

fn f_foresee_composed(g: Graph*, v: Var*) -> Var {
  var at: int64 = 288;
  var trace: Var = v[0].slice(0, 0, at).view(3, 2, 6, 8);
  var seats: Var = part(v[0], &at, 6, 8);
  var fore: Var = part(v[0], &at, 12, 8);
  var tell: Var = part(v[0], &at, 8, 12);
  var total: Var = g->full(shape(1), 0.0);
  for s: int64 in 0..2 {
    for r: int64 in 0..2 {
      var seen: Var = rms_norm_plain(trace.slice(0, s, 1).slice(1, r, 1).view(6, 8).add(seats), 1.0e-6);
      var goal: Var = rms_norm_plain(g->resident(trace.slice(0, s + 1, 1).slice(1, 1, 1).data(), shape(6, 8)), 1.0e-6);
      var guess: Var = linear_nobias(linear_nobias(seen, fore).gelu_tanh(), tell);
      total = total.add(mse_loss(rms_norm_plain(guess, 1.0e-6), goal).view(1));
    }
  }
  return total.scale(0.5);
}

fn f_foresee_fixed(g: Graph*, v: Var*) -> Var {
  var held: float32* = g->floats(48);
  for i: int64 in 0..48 { held[i] = (float32)((float64)((i * 37 + 11) % 17) / 8.5 - 1.0); }
  var at: int64 = 0;
  var seats: Var = part(v[0], &at, 2, 4);
  var fore: Var = part(v[0], &at, 4, 4);
  var tell: Var = part(v[0], &at, 4, 4);
  return foresee(g->resident(held, shape(3, 2, 2, 4)), seats, fore, tell, 1, 0.5);
}

fn same_as_composed(fused: fn(Graph*, Var*) -> Var, composed: fn(Graph*, Var*) -> Var, s: Shape) -> int32 {
  var x: Tensor = random_tensor(s, 21, -1.0, 1.0);
  var n: int64 = s.size();
  var kept: float32* = (float32*)calloc(n, 4);
  var first: float32* = (float32*)0;
  var worst: float32 = 0.0;
  var most: float32 = 0.0;
  var apart: float32 = 0.0;
  for pass in 0..2 {
    var g: Graph* = graph_new();
    var v: Var = g->variable(x);
    var out: Var = if pass == 0 { fused(g, &v) } else { composed(g, &v) };
    var size: int64 = out.size();
    var seed: Tensor = tensor_new(out.shape());
    for i: int64 in 0..size { seed.data[i] = (float32)(1.0 + 0.25 * (float64)(i % 7)); }
    if (pass == 0) { first = (float32*)malloc(size * 4); }
    for i: int64 in 0..size {
      if (pass == 0) {
        first[i] = out.data()[i];
      } else {
        var d: float32 = first[i] - out.data()[i];
        if (d < (float32)0.0) { d = -d; }
        if (d > apart) { apart = d; }
      }
    }
    out.backward_with(seed);
    var grad: float32* = g->nodes[v.id].grad;
    for i: int64 in 0..n {
      var slope: float32 = if grad == 0 { (float32)0.0 } else { grad[i] };
      if (pass == 0) {
        kept[i] = slope;
      } else {
        var d: float32 = kept[i] - slope;
        if (d < (float32)0.0) { d = -d; }
        if (d > worst) { worst = d; }
        var size_of: float32 = if slope < (float32)0.0 { -slope } else { slope };
        if (size_of > most) { most = size_of; }
      }
    }
    tensor_free(&seed);
    graph_free(g);
  }
  tensor_free(&x);
  free((rawptr)kept);
  free((rawptr)first);
  if (apart > (float32)2.0e-5 || worst > most * (float32)2.0e-5) {
    println("fused and composed differ by {apart} in value and {worst} in gradient, largest gradient {most}");
    return 1;
  }
  return 0;
}

fn residual_of(x: Var, rows: int64, n: int64, k: int64) -> Var {
  var at: int64 = 0;
  var base: Var = part(x, &at, rows, n);
  var h: Var = part(x, &at, rows, k);
  return residual(base, h, part(x, &at, n, k), 1.0e-6);
}

fn residual_composed(x: Var, rows: int64, n: int64, k: int64) -> Var {
  var at: int64 = 0;
  var base: Var = part(x, &at, rows, n);
  var h: Var = part(x, &at, rows, k);
  return base.add(linear_nobias(rms_norm_plain(h, 1.0e-6), part(x, &at, n, k)));
}

fn feed_of(x: Var, rows: int64, w: int64, hid: int64) -> Var {
  var at: int64 = 0;
  var base: Var = part(x, &at, rows, w);
  var fc: Var = part(x, &at, hid, w);
  return feed(base, fc, part(x, &at, w, hid), 1.0e-6);
}

fn feed_composed(x: Var, rows: int64, w: int64, hid: int64) -> Var {
  var at: int64 = 0;
  var base: Var = part(x, &at, rows, w);
  var fc: Var = part(x, &at, hid, w);
  var out: Var = part(x, &at, w, hid);
  return base.add(linear_nobias(linear_nobias(rms_norm_plain(base, 1.0e-6), fc).gelu_tanh(), out));
}

fn f_pair(g: Graph*, v: Var*) -> Var { return pair(v[0].slice(0, 0, 24).view(2, 3, 4), v[0].slice(0, 24, 8).view(2, 1, 4)); }
fn f_pair_composed(g: Graph*, v: Var*) -> Var {
  var now: Var = v[0].slice(0, 0, 24).view(2, 3, 4);
  var first: Var = v[0].slice(0, 24, 8).view(2, 1, 4);
  return concat(now, concat(first, now.slice(1, 0, 2), 1), 2);
}
fn f_residual(g: Graph*, v: Var*) -> Var { return residual_of(v[0], 5, 4, 6); }
fn f_residual_big(g: Graph*, v: Var*) -> Var { return residual_of(v[0], 13, 16, 24); }
fn f_residual_composed(g: Graph*, v: Var*) -> Var { return residual_composed(v[0], 13, 16, 24); }
fn f_feed(g: Graph*, v: Var*) -> Var { return feed_of(v[0], 5, 4, 6); }
fn f_feed_big(g: Graph*, v: Var*) -> Var { return feed_of(v[0], 13, 16, 40); }
fn f_feed_composed(g: Graph*, v: Var*) -> Var { return feed_composed(v[0], 13, 16, 40); }

@test fn pair_equals_composed() -> int32 {
  if (check1(&f_pair, shape(32), -1.0, 1.0, 1.0e-2, 1.0e-3, false) != 0) { return 1; }
  return same_as_composed(&f_pair, &f_pair_composed, shape(32));
}

