  if (check1(&f_residual, shape(74), -1.0, 1.0, 1.0e-2, 1.0e-2, false) != 0) { return 1; }
  if (check1(&f_feed, shape(68), -1.0, 1.0, 1.0e-2, 1.0e-2, false) != 0) { return 2; }
  return 0;
}

@test fn residual_and_feed_equal_composed() -> int32 {
  if (same_as_composed(&f_residual_big, &f_residual_composed, shape(904)) != 0) { return 1; }
  if (same_as_composed(&f_feed_big, &f_feed_composed, shape(1488)) != 0) { return 2; }
  return 0;
}

@test fn grad_ponder() -> int32 {
  if (check1(&f_ponder_small, shape(117), -1.0, 1.0, 1.0e-2, 1.0e-2, false) != 0) { return 1; }
  return 0;
}

@test fn ponder_equals_composed() -> int32 {
  return same_as_composed(&f_ponder, &f_ponder_composed, shape(553));
}

@test fn grad_ponder_heed() -> int32 {
  if (check1(&f_ponder_heed_small, shape(125), -1.0, 1.0, 1.0e-2, 1.0e-2, false) != 0) { return 1; }
  return 0;
