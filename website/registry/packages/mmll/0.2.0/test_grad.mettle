@test fn grad_foresee() -> int32 {
  if (check1(&f_foresee_fixed, shape(40), -1.0, 1.0, 1.0e-2, 1.0e-2, false) != 0) { return 1; }
  return 0;
}

@test fn foresee_equals_composed() -> int32 {
  return same_as_composed(&f_foresee, &f_foresee_composed, shape(528));
}

fn f_consult(g: Graph*, v: Var*) -> Var {
  var at: int64 = 0;
  var kv: Var = part(v[0], &at, 6, 8).view(1, 6, 8);
  var q: Var = part(v[0], &at, 6, 4).view(1, 6, 4);
  var gate: Var = part(v[0], &at, 6, 2).view(1, 6, 2);
  var asked: Var = part(v[0], &at, 2, 4).view(1, 2, 4);
  var grid: Var = recall_tapped(kv, q, gate, 2, 6, 2, recall_table(g, 2, 6, 1));
  return consult(grid, 2, asked).add(consult(grid, 1, asked)).add(grid.slice(1, 4, 2));
}

fn fixed(g: Graph*, rows: int64, cols: int64, salt: int64) -> Var {
  var held: float32* = g->floats(rows * cols);
  for i: int64 in 0..rows * cols { held[i] = (float32)((float64)((i * 37 + salt) % 17) / 17.0 - 0.5); }
  return g->resident(held, shape(rows, cols));
}

fn f_ponder_look(g: Graph*, v: Var*) -> Var {
  var at: int64 = 0;
  var kv: Var = part(v[0], &at, 4, 8).view(1, 4, 8);
  var q: Var = part(v[0], &at, 4, 4).view(1, 4, 4);
  var grid: Var = recall_tapped(kv, q, no_gate(g), 2, 4, 2, recall_table(g, 2, 4, 1));
  var held: Var = part(v[0], &at, 2, 4).view(1, 2, 4);
  var k: Thinking;
  k.pack = fixed(g, 12, 4, 1);
  k.proj = fixed(g, 4, 4, 2);
  k.fc = fixed(g, 4, 4, 3);
  k.out = fixed(g, 4, 4, 4);
  k.gate = fixed(g, 1, 4, 5);
  k.bias = fixed(g, 1, 1, 6);
  k.seek = part(v[0], &at, 4, 4);
  k.fetch = part(v[0], &at, 4, 4);
  return ponder_with(held, fixed(g, 2, 4, 7).view(1, 2, 4), no_gate(g), k, 2, grid, 1).add(grid.slice(1, 2, 2));
}

fn look_parts(x: Var, at: int64*, w: int64, hid: int64) -> Thinking {
  var k: Thinking = thinking_of(x, at, w, hid);
  k.seek = part(x, at, w, w);
  k.fetch = part(x, at, w, w);
  return k;
}

fn f_look_fused(g: Graph*, v: Var*) -> Var {
  var at: int64 = 0;
  var kv: Var = part(v[0], &at, 16, 16).view(2, 8, 16);
  var q: Var = part(v[0], &at, 16, 8).view(2, 8, 8);
  var gate: Var = part(v[0], &at, 16, 2).view(2, 8, 2);
  var grid: Var = recall_tapped(kv, q, gate, 2, 8, 4, recall_table(g, 2, 8, 1));
  var held: Var = part(v[0], &at, 6, 8).view(2, 3, 8);
  var seats: Var = part(v[0], &at, 6, 8).view(2, 3, 8);
  return ponder_with(held, seats, no_gate(g), look_parts(v[0], &at, 8, 12), 2, grid, 1).add(grid.slice(1, 5, 3));
}

fn f_look_composed(g: Graph*, v: Var*) -> Var {
  var at: int64 = 0;
  var kv: Var = part(v[0], &at, 16, 16).view(2, 8, 16);
  var q: Var = part(v[0], &at, 16, 8).view(2, 8, 8);
  var gate: Var = part(v[0], &at, 16, 2).view(2, 8, 2);
  var grid: Var = recall_tapped(kv, q, gate, 2, 8, 4, recall_table(g, 2, 8, 1));
  var held: Var = part(v[0], &at, 6, 8).view(2, 3, 8);
  var seats: Var = part(v[0], &at, 6, 8).view(2, 3, 8);
  var k: Thinking = look_parts(v[0], &at, 8, 12);
  var here: Var = rms_norm_plain(held.add(seats), 1.0e-6);
  var found: Var = linear_nobias(rms_norm_plain(consult(grid, 1, linear_nobias(here, k.seek)), 1.0e-6), k.fetch);
  var told: Var = linear_nobias(rms_norm_plain(mingle(linear_nobias(here, k.pack), 2), 1.0e-6), k.proj).add(found);
  var worked: Var = linear_nobias(linear_nobias(rms_norm_plain(held.add(told), 1.0e-6), k.fc).gelu_tanh(), k.out);
  var share: Var = linear(here, k.gate, k.bias.view(1)).sigmoid().matmul(g->full(shape(2, 1, 8), 1.0));
  return held.add(told.add(worked).mul(share)).add(grid.slice(1, 5, 3));
}

fn f_consult_carried(g: Graph*, v: Var*) -> Var {
  var at: int64 = 0;
  var kv: Var = part(v[0], &at, 6, 8).view(1, 6, 8);
  var q: Var = part(v[0], &at, 6, 4).view(1, 6, 4);
  var gate: Var = part(v[0], &at, 6, 2).view(1, 6, 2);
  var asked: Var = part(v[0], &at, 2, 4).view(1, 2, 4);
  var grid: Var = recall_tapped_carried(kv, q, gate, 2, 6, 2, recall_table(g, 2, 6, 1), carried_table(g, 8), g->zeros_raw(8));
  return consult(grid, 0, asked).add(consult(grid, 2, asked)).add(grid.slice(1, 4, 2));
}

fn tapped_gap() -> float32 {
  var kv: Tensor = random_tensor(shape(2, 16, 16), 3, -1.0, 1.0);
  var q: Tensor = random_tensor(shape(2, 16, 8), 4, -1.0, 1.0);
  var gate: Tensor = random_tensor(shape(2, 16, 2), 5, -1.0, 1.0);
  var ask: Tensor = random_tensor(shape(2, 3, 8), 6, -1.0, 1.0);
  var g: Graph* = graph_new();
  var pair: Var = g->input(kv);
  var asks: Var = g->input(q);
  var gates: Var = g->input(gate);
  var asked: Var = g->input(ask);
  var between: float32* = (float32*)g->host_alloc(2 * 2 * 16 * 4);
  var whole: Var = recall_tapped(pair, asks, gates, 2, 4, 2, recall_table(g, 2, 4, 4));
  var first: Var = recall_tapped_carried(pair.slice(1, 0, 8), asks.slice(1, 0, 8), gates.slice(1, 0, 8), 2, 4, 2, recall_table(g, 2, 4, 2), (float32*)0, between);
  var second: Var = recall_tapped_carried(pair.slice(1, 8, 8), asks.slice(1, 8, 8), gates.slice(1, 8, 8), 2, 4, 2, recall_table(g, 2, 4, 2), between, (float32*)0);
  var want: Var = concat(whole, consult(whole, 4, asked).add(consult(whole, 6, asked)), 1);
  var have: Var = concat(concat(first, second, 1), consult(second, 0, asked).add(consult(second, 2, asked)), 1);
  var worst: float32 = 0.0;
  for i: int64 in 0..want.size() {
    var d: float32 = want.data()[i] - have.data()[i];
    if (d < (float32)0.0) { d = -d; }
    if (d > worst) { worst = d; }
  }
  graph_free(g);
  tensor_free(&kv);
  tensor_free(&q);
  tensor_free(&gate);
  tensor_free(&ask);
  return worst;
}

@test fn recall_tapped_carried_equals_whole() -> int32 {
  if (tapped_gap() > (float32)2.0e-6) { return 1; }
  return 0;
}

@test fn grad_consult() -> int32 {
  if (check1(&f_consult, shape(92), -1.0, 1.0, 1.0e-2, 1.0e-2, false) != 0) { return 1; }
  return 0;
}

@test fn grad_consult_carried() -> int32 {
  if (check1(&f_consult_carried, shape(92), -1.0, 1.0, 1.0e-2, 1.0e-2, false) != 0) { return 1; }
  return 0;
}

@test fn grad_ponder_look() -> int32 {
  if (check1(&f_ponder_look, shape(88), -1.0, 1.0, 1.0e-2, 1.0e-2, false) != 0) { return 1; }
  return 0;
}

@test fn ponder_look_equals_composed() -> int32 {
  return same_as_composed(&f_look_fused, &f_look_composed, shape(1097));
}