name = mtls
version = 0.2.1
description = TLS 1.3 and 1.2 client and server in pure Mettle: X.509 validation, mutual TLS, ALPN, resumption, blocking, thread-shared and non-blocking (alph) I/O
license = Apache-2.0
source = https://github.com/Lex-Dellimere/mtls
compiler = 0.18.0
platforms = linux windows
require = cryptex 0.3.0
