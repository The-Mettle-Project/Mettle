// PEM: finding "-----BEGIN X-----" blocks in a buffer and decoding their
// base64 bodies. Text outside the blocks (comments, openssl -text output)
// is skipped. Line ends may be LF or CRLF and any whitespace inside a body
// is ignored, but the base64 itself is strict: right alphabet, correct
// padding, zero padding bits.

import "std/mem";
import "mtls/core/err";

export struct MtlsPemIter {
  p: uint8*;
  n: int64;
  pos: int64;
}

/// MtlsPemBlock: one block. label and body point into the scanned buffer;
/// body is the base64 text between the BEGIN and END lines.
export struct MtlsPemBlock {
  label: string;
  body: uint8*;
  bodylen: int64;
}

/// mtls_pem_iter: starts a scan of n bytes at p.
export fn mtls_pem_iter(it: MtlsPemIter*, p: uint8*, n: int64) {
  it->p = p;
  it->n = n;
  it->pos = 0;
  if (p == 0 || n < 0) {
    it->n = 0;
  }
}

// Offset of the first match of needle at or after from, or -1.
fn mtls_x_pem_find(p: uint8*, n: int64, from: int64, needle: string) -> int64 {
  var m: int64 = (int64)needle.length;
  var i: int64 = from;
  while (i + m <= n) {
    if (p[i] == needle.chars[0] && memcmp(p + i, needle.chars, m) == 0) { return i; }
    i = i + 1;
  }
  return -1;
}

/// mtls_pem_next: finds the next block. Returns 1 and fills blk, 0 when no
/// block is left, or MTLS_E_DECODE for a BEGIN line without a matching END.
/// After an error the scan is over.
export fn mtls_pem_next(it: MtlsPemIter*, blk: MtlsPemBlock*) -> int32 {
  blk->body = it->p;
  blk->bodylen = 0;
  blk->label.chars = it->p;
  blk->label.length = (uint64)0;
  var b: int64 = mtls_x_pem_find(it->p, it->n, it->pos, "-----BEGIN ");
  if (b < 0) {
    it->pos = it->n;
    return 0;
  }
  var ls: int64 = b + 11;
  var le: int64 = mtls_x_pem_find(it->p, it->n, ls, "-----");
  if (le < 0) {
    it->pos = it->n;
    return MTLS_E_DECODE;
  }
  // The label has to stay on one line.
  for i in ls..le {
    if (it->p[i] == (uint8)10 || it->p[i] == (uint8)13) {
      it->pos = it->n;
      return MTLS_E_DECODE;
    }
  }
  var bs: int64 = le + 5;
  // Find "-----END <label>-----".
  var e: int64 = bs;
  var found: int64 = -1;
  while (found < 0) {
    e = mtls_x_pem_find(it->p, it->n, e, "-----END ");
    if (e < 0) { break; }
    var ll: int64 = le - ls;
    if (e + 9 + ll + 5 <= it->n && memcmp(it->p + e + 9, it->p + ls, ll) == 0 && memcmp(it->p + e + 9 + ll, "-----".chars, 5) == 0) {
      found = e;
    } else {
      e = e + 1;
    }
  }
  if (found < 0) {
    it->pos = it->n;
    return MTLS_E_DECODE;
  }
  blk->label.chars = it->p + ls;
  blk->label.length = (uint64)(le - ls);
  blk->body = it->p + bs;
  blk->bodylen = found - bs;
  it->pos = found + 9 + (le - ls) + 5;
  return 1;
}

fn mtls_x_b64v(c: int32) -> int32 {
  if (c >= 65 && c <= 90) { return c - 65; }
  if (c >= 97 && c <= 122) { return c - 71; }
  if (c >= 48 && c <= 57) { return c + 4; }
  if (c == 43) { return 62; }
  if (c == 47) { return 63; }
  return -1;
}

/// mtls_pem_decoded_max: an upper bound for the decoded size of n base64 bytes.
export fn mtls_pem_decoded_max(n: int64) -> int64 {
  return (n / 4 + 1) * 3;
}

/// mtls_pem_b64: strict base64 decode of n bytes at src into out (cap bytes).
/// Whitespace is skipped. A ':' (a PEM header such as Proc-Type, used by
/// encrypted keys) gives MTLS_E_UNSUPPORTED, any other bad byte MTLS_E_DECODE.
export fn mtls_pem_b64(src: uint8*, n: int64, out: uint8*, cap: int64, olen: int64*) -> int32 {
  *olen = 0;
  for i in 0..n {
    if (src[i] == (uint8)58) { return MTLS_E_UNSUPPORTED; }
  }
  var acc: int32 = 0;
  var cnt: int32 = 0;
  var pad: int32 = 0;
  var done: bool = false;
  var o: int64 = 0;
  for i in 0..n {
    var c: int32 = (int32)src[i];
    if (c == 32 || c == 9 || c == 10 || c == 13) { continue; }
    if (done) { return MTLS_E_DECODE; }
    if (c == 61) {
      if (cnt < 2) { return MTLS_E_DECODE; }
      pad = pad + 1;
      acc = acc << 6;
    } else {
      if (pad > 0) { return MTLS_E_DECODE; }
      var v: int32 = mtls_x_b64v(c);
      if (v < 0) { return MTLS_E_DECODE; }
      acc = (acc << 6) | v;
    }
    cnt = cnt + 1;
    if (cnt == 4) {
      var take: int64 = (int64)(3 - pad);
      if (pad == 2 && (acc & 0xffff) != 0) { return MTLS_E_DECODE; }
      if (pad == 1 && (acc & 0xff) != 0) { return MTLS_E_DECODE; }
      if (o + take > cap) { return MTLS_E_SPACE; }
      out[o] = (uint8)((acc >> 16) & 255);
      if (take > 1) { out[o + 1] = (uint8)((acc >> 8) & 255); }
      if (take > 2) { out[o + 2] = (uint8)(acc & 255); }
      o = o + take;
      cnt = 0;
      acc = 0;
      if (pad > 0) { done = true; }
    }
  }
  if (cnt != 0) { return MTLS_E_DECODE; }
  *olen = o;
  return MTLS_OK;
}

/// mtls_pem_decode: the DER bytes of a block, into out (cap bytes). Use
/// mtls_pem_decoded_max(blk->bodylen) for cap.
export fn mtls_pem_decode(blk: MtlsPemBlock*, out: uint8*, cap: int64, olen: int64*) -> int32 {
  return mtls_pem_b64(blk->body, blk->bodylen, out, cap, olen);
}

/// mtls_pem_decode_alloc: the DER bytes of a block in a new malloc block
/// (free it with free). Empty bodies are an error.
export fn mtls_pem_decode_alloc(blk: MtlsPemBlock*, out: uint8**, olen: int64*) -> int32 {
  *out = 0;
  *olen = 0;
  var cap: int64 = mtls_pem_decoded_max(blk->bodylen);
  var buf: uint8* = malloc(cap);
  if (buf == 0) { return MTLS_E_NOMEM; }
  var n: int64 = 0;
  var rc: int32 = mtls_pem_b64(blk->body, blk->bodylen, buf, cap, &n);
  if (rc != MTLS_OK || n == 0) {
    free(buf);
    if (rc == MTLS_OK) { return MTLS_E_DECODE; }
    return rc;
  }
  *out = buf;
  *olen = n;
  return MTLS_OK;
}
