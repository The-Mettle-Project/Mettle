// raize_auth/password: password policy and storage, over crypto's Argon2id
// (cr_pwhash_*). No hashing is done in raize_auth itself.
//
// Store ra_password_text(&h) on the user record; load it back with
// ra_password_from_text. Safe on any thread (crypto is pure Mettle).

import "cryptex/cryptex";
import "status";

/// Shortest password ra_password_ok accepts, in bytes (NIST SP 800-63B).
export const RA_PASSWORD_MIN: int64 = 8;
/// Longest password ra_password_ok accepts, in bytes. Bounds the work one
/// request can cause; long enough for any passphrase or manager output.
export const RA_PASSWORD_MAX: int64 = 1024;

/// Checks a password against the length policy (no composition rules).
///
/// in:      pw       the password as typed
/// returns: true when RA_PASSWORD_MIN <= length <= RA_PASSWORD_MAX
/// owns:    nothing
/// thread:  any (pure)
/// example:
///   if (!ra_password_ok(pw)) { return RA_E_INVALID; }
export fn ra_password_ok(pw: string) -> bool {
  var n: int64 = (int64)pw.length;
  return n >= RA_PASSWORD_MIN && n <= RA_PASSWORD_MAX;
}

/// Hashes a password for storage: Argon2id, random salt, self-describing text.
///
/// in:      out      the hash to fill
///          pw       the password; must pass ra_password_ok
///          preset   CR_PW_INTERACTIVE (sign-in), CR_PW_MODERATE or CR_PW_SENSITIVE
/// returns: RA_OK; RA_E_USAGE (null out); RA_E_INVALID (pw fails the policy,
///          or a bad preset); RA_E_CRYPTO (crypto not initialised or failed)
/// owns:    writes *out; the caller wipes pw when done with it
/// thread:  any
/// example:
///   var h: CrPwHash;
///   if (ra_password_hash(&h, pw, CR_PW_INTERACTIVE) != RA_OK) { return 1; }
///   save_hash(user, ra_password_text(&h));
export fn ra_password_hash(out: CrPwHash*, pw: string, preset: int32) -> int32 {
  if (out == 0) { return RA_E_USAGE; }
  if (!ra_password_ok(pw)) { return RA_E_INVALID; }
  var rc: int32 = cr_pwhash_str(out, pw.chars, (int64)pw.length, preset);
  if (rc == CR_OK) { return RA_OK; }
  if (rc == CR_E_ARG) { return RA_E_INVALID; }
  return RA_E_CRYPTO;
}

/// Verifies a password against a stored hash, in constant time.
///
/// in:      h        a hash from ra_password_hash or ra_password_from_text
///          pw       the password as typed
/// returns: true only on a match. False for a wrong password, a password
///          outside the length policy, a null or malformed hash, or any
///          crypto failure (fails closed)
/// owns:    nothing
/// thread:  any
/// example:
///   if (!ra_password_verify(&h, pw)) { return RA_E_DENIED; }
export fn ra_password_verify(h: CrPwHash*, pw: string) -> bool {
  if (h == 0 || !ra_password_ok(pw)) { return false; }
  return cr_pwhash_verify(h, pw.chars, (int64)pw.length);
}

/// Says whether a stored hash is weaker than a preset and should be replaced
/// (call after a successful verify, then hash the password again).
///
/// in:      h        a stored hash; preset the cost you hash with now
/// returns: true when h was made with other parameters, or is not a valid
///          Argon2id hash
/// owns:    nothing
/// thread:  any
/// example:
///   if (ra_password_needs_rehash(&h, CR_PW_INTERACTIVE)) { ra_password_hash(&h, pw, CR_PW_INTERACTIVE); }
export fn ra_password_needs_rehash(h: CrPwHash*, preset: int32) -> bool {
  if (h == 0) { return true; }
  return cr_pwhash_needs_rehash(h, preset);
}

/// Views a hash as the text to store (an "$argon2id$..." string).
///
/// in:      h        a hash
/// returns: the text; "" for a null or empty hash
/// owns:    borrows h; copy it before h changes or goes out of scope
/// thread:  any
/// example:
///   db_set(user, "password_hash", ra_password_text(&h));
export fn ra_password_text(h: CrPwHash*) -> string {
  if (h == 0) { return ""; }
  return cr_pwhash_text(h);
}

/// Loads a stored hash text.
///
/// in:      out      the hash to fill; text the stored string
/// returns: RA_OK; RA_E_USAGE (null out); RA_E_INVALID (empty, too long, or
///          not an "$argon2id$" string)
/// owns:    copies text into *out
/// thread:  any
/// example:
///   var h: CrPwHash;
///   if (ra_password_from_text(&h, row_hash) != RA_OK) { return RA_E_STORE; }
export fn ra_password_from_text(out: CrPwHash*, text: string) -> int32 {
  if (out == 0) { return RA_E_USAGE; }
  if (cr_pwhash_from_text(out, text) != CR_OK) { return RA_E_INVALID; }
  return RA_OK;
}

@test fn t_ra_password_policy() -> int32 {
  if (ra_password_ok("short")) { return 1; }
  if (!ra_password_ok("12345678")) { return 2; }
  return 0;
}
