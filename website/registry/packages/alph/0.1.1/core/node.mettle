// alph/core/node: actors and the node that runs them.
//
// A node is one OS process running a set of schedulers, one thread each. An
// actor is a state block, a bounded mailbox, a signal queue and a handler:
//
//   fn handler(ctx: AlphCtx*, m: AlphMsg*) -> int64
//
// The handler runs one message to completion and returns ALPH_CONTINUE, or
// `alph_stop(ctx, reason)` to exit. That return is the only point where a
// scheduler switches actors, so a handler must not block or loop without
// bound: give it a `where cycles < N` deadline to have the compiler prove
// it. The first message every actor gets is ALPH_TAG_INIT.
//
// A crash inside a handler (a failed check, a null or wild pointer, a divide
// by zero, a stack overflow) ends only that actor, with ALPH_CRASHED, and its
// links and monitors see it as on BEAM. Programs must be built with -s for
// failed checks to be caught.
//
// Signals (link, unlink, exit, monitor, demonitor, down, timer) travel on a
// separate unbounded queue and are never dropped. Exits and downs keep their
// order with messages: each records how far the receiver's mailbox was
// filled when it was sent, and waits until those messages are handled. So a
// result sent just before an exit is seen before the exit.
//
// Function families: names that take ctx are called from a handler; names
// that start alph_node_ take the node and work from any thread. A bare name
// sends a tag and one word, _value<T> sends one T, _bytes sends raw bytes.

import "std/mem";
import "alph/sys/atomic";
import "alph/sys/clock";
import "alph/sys/recover";
import "alph/sys/thread";
import "alph/sys/linux";
import "alph/sys/fd";
import "alph/io/reactor";
import "alph/core/queue";
import "alph/core/mailbox";
import "alph/core/heap";

// ---- constants -------------------------------------------------------------

// Exit reasons, carried in m->arg of EXIT and DOWN. Your own reasons start
// at ALPH_REASON_USER.
export const ALPH_NORMAL: int64 = 0;    // a clean exit; links ignore it
export const ALPH_KILL: int64 = 1;      // send with alph_exit_signal to kill; cannot be trapped
export const ALPH_KILLED: int64 = 2;    // how an actor that was killed exits
export const ALPH_NOPROC: int64 = 3;    // the actor was already gone
export const ALPH_CRASHED: int64 = 4;   // a trap or fault inside the handler
export const ALPH_SHUTDOWN: int64 = 5;  // an orderly stop, from a supervisor
export const ALPH_NOCONNECTION: int64 = 6;  // the actor was on another node, and the connection to it is gone
export const ALPH_REASON_USER: int64 = 100;

// Tags the runtime delivers. Tags below ALPH_TAG_USER belong to the runtime;
// your own tags start at ALPH_TAG_USER.
export const ALPH_TAG_INIT: int64 = 1;     // the first message; from = parent (0 if none); arg = restarts so far under a supervisor, else 0
// The answer to a request that the server's mailbox shed for waiting too
// long (alph_mailbox_shed); ref = the request's. Treat it as "overloaded, try
// later".
export const ALPH_TAG_BUSY: int64 = 60;
export const ALPH_TAG_EXIT: int64 = 2;     // a linked actor exited; only with alph_trap_exits on. from = it, arg = reason
export const ALPH_TAG_DOWN: int64 = 3;     // a monitored actor exited. from = it, ref = the monitor, arg = reason
export const ALPH_TAG_TIMEOUT: int64 = 4;  // a request got no reply in time. ref = the request, arg = the server
export const ALPH_TAG_CRASHED: int64 = 6;  // to a medic: its patient crashed. from = it, arg = reason
export const ALPH_TAG_IO: int64 = 7;       // an armed handle is ready. ref = the handle, arg = ALPH_IO_ bits
export const ALPH_TAG_IO_GIVEN: int64 = 8; // a handle was handed to this actor. ref = the handle, from = the giver
export const ALPH_TAG_PROC_EXIT: int64 = 9; // a child process ended. ref = its handle, arg = exit code, or 128 + signal
export const ALPH_TAG_LINKED: int64 = 26;   // to a proxy: from linked to it
export const ALPH_TAG_UNLINKED: int64 = 27; // to a proxy: from unlinked from it
export const ALPH_TAG_USER: int64 = 100;

// What a handler returns.
export const ALPH_CONTINUE: int64 = 0;  // keep running
export const ALPH_STOP: int64 = 1;      // exit; return alph_stop(ctx, reason) rather than this

// What sending returns.
export const ALPH_SENT: int64 = 0;   // in the receiver's mailbox
export const ALPH_FULL: int64 = -1;  // the receiver's mailbox is full; nothing was sent
export const ALPH_GONE: int64 = -2;  // the receiver has exited; nothing was sent
export const ALPH_NOMEM: int64 = -3; // no memory for a large payload; nothing was sent
export const ALPH_BUSY: int64 = -4;  // alph_request only: the server sheds load (alph_mailbox_shed); nothing was sent

// What a handle is ready for, in alph_io_arm and in m->arg of ALPH_TAG_IO.
export const ALPH_IO_IN: int64 = 1;    // readable, or a listener has a connection waiting
export const ALPH_IO_OUT: int64 = 4;   // writable, or a connect finished (check alph_io_error)
export const ALPH_IO_ERR: int64 = 8;   // an error is pending; only reported, never armed
export const ALPH_IO_HUP: int64 = 16;  // the other end hung up; only reported, never armed

// What alph_io_read, alph_io_write and alph_tcp_accept return when they
// would have to wait: arm the handle and try again on ALPH_TAG_IO.
export const ALPH_IO_AGAIN: int64 = -11;

// Flags for alph_tcp_listen.
export const ALPH_TCP_REUSEPORT: int64 = 1;  // several listeners share the port; the kernel spreads connections

// Spawn flags; combine with |.
export const ALPH_LINK: int64 = 1;     // link the new actor to the caller
export const ALPH_MONITOR: int64 = 2;  // the caller monitors the new actor
export const ALPH_BOUND: int64 = 4;    // the new actor gets a thread of its own and may block
// The new actor stands for an actor on another node (alph/net/dist): it may
// trap ALPH_KILL, hears ALPH_TAG_LINKED and ALPH_TAG_UNLINKED, and gets
// replies whatever their ref, so it can pass them on.
export const ALPH_PROXY: int64 = 8;

// Actor status.
const ALPH_P_FREE: int64 = 0;
const ALPH_P_IDLE: int64 = 1;
const ALPH_P_QUEUED: int64 = 2;
const ALPH_P_RUNNING: int64 = 3;
const ALPH_P_DIRTY: int64 = 4;    // running, and work arrived meanwhile
const ALPH_P_EXITING: int64 = 5;
const ALPH_P_CRASHED: int64 = 6;  // crashed, held in place for its medic

// Signal kinds.
const ALPH_SIG_LINK: int64 = 1;
const ALPH_SIG_UNLINK: int64 = 2;
const ALPH_SIG_EXIT: int64 = 3;       // explicit, from alph_exit_signal
const ALPH_SIG_LINK_EXIT: int64 = 4;  // a linked actor exited
const ALPH_SIG_MONITOR: int64 = 5;
const ALPH_SIG_DEMONITOR: int64 = 6;
const ALPH_SIG_DOWN: int64 = 7;
const ALPH_SIG_TIMER: int64 = 8;
const ALPH_SIG_CRASHED: int64 = 9;    // to a medic
const ALPH_SIG_IO: int64 = 10;        // a handle became ready
const ALPH_SIG_IO_GIVEN: int64 = 11;  // a handle changed owner to this actor

// Message flags.
const ALPH_MSG_REQUEST: int64 = 1;  // ref names the reply the sender waits for
const ALPH_MSG_REPLY: int64 = 2;    // answers the request with the same ref

// Messages handled before the scheduler moves on to another actor.
const ALPH_BUDGET: int64 = 64;
// An actor's run also ends once it has taken this long (checked every 4
// messages), so a run of many medium-cost messages cannot hold its
// scheduler for a millisecond: 64 messages of 20 us did.
const ALPH_RUN_NS: int64 = 100000;
// Messages cheaper than this on average are checked against ALPH_RUN_NS
// every 4; costlier ones after each.
const ALPH_CHEAP_NS: int64 = 2000;
// alph_outq_send writes before the end of the run once this much is held.
export const ALPH_OUTQ_HOLD_BYTES: int64 = 16384;
export const ALPH_OUTQ_HOLD_SENDS: int64 = 32;
const ALPH_SHED_IDLE: int64 = 0;
const ALPH_SHED_ARMING: int64 = 1;
const ALPH_SHED_DROPPING: int64 = 2;
const ALPH_SHED_POP_NS: int64 = 100000;
// The watchdog's pause between looks: ALPH_SYSMON_NS after it acted,
// doubling while it finds nothing to do, up to ALPH_SYSMON_BUSY_NS while
// actors run (work stuck behind a long handler then waits at most about
// twice that) and ALPH_SYSMON_IDLE_NS while none do.
const ALPH_SYSMON_NS: int64 = 100000;
const ALPH_SYSMON_BUSY_NS: int64 = 5000000;
const ALPH_SYSMON_IDLE_NS: int64 = 50000000;
// A scheduler out of work spins only while at least this many of 1024 of its
// recent spins found work: below it, spinning costs more than the sleeps and
// wake-ups it saves. In the sim a spin caught work 1.5%
// of the time at 20K requests/s and 56% at 100K.
const ALPH_SPIN_HITS: int64 = 256;
const ALPH_SHARE_WAKE: int64 = 8;
const ALPH_IO_POLL_NS: int64 = 100000;  // a busy scheduler looks at its sockets at least this often
// An awake scheduler that has not looked at its sockets for this long has
// probably been paused by the OS; a spinning one looks for it.
const ALPH_RESCUE_NS: int64 = 1000000;

// Compaction. Every ALPH_BALANCE_NS the node sums how long its schedulers
// were busy and keeps just enough of them active that each is busy about
// ALPH_BUSY_PCT percent of the time. More are activated at once; fewer only
// after ALPH_SHRINK_AFTER looks in a row asked for fewer.
const ALPH_BALANCE_NS: int64 = 10000000;
const ALPH_BUSY_PCT: int64 = 50;
const ALPH_SHRINK_AFTER: int64 = 5;
// Rising fast, as BEAM's wakeup_other: a scheduler with at least
// ALPH_RISE_QLEN actors waiting and nobody idle to share with activates one
// more scheduler at once, at most once per ALPH_RISE_NS, instead of waiting
// for the next look at the load.
const ALPH_RISE_QLEN: int64 = 4;
const ALPH_RISE_NS: int64 = 100000;

const ALPH_NS_PER_MS: int64 = 1000000;

// Epoch reclamation: memory a lock-free reader may hold is retired, not
// freed, and freed once every shared scheduler has been between handlers
// (or asleep) since. Retire lists past this length are reclaimed at once.
const ALPH_RETIRE_BATCH: int64 = 1024;

// ---- public types ----------------------------------------------------------

// Registry kinds, for alph_node_reg_new.
export const ALPH_REG_UNIQUE: int64 = 0;     // a key has at most one holder
export const ALPH_REG_DUPLICATE: int64 = 1;  // a key has any number of holders

// One holder of a registry key, as alph_reg_lookup returns it.
export struct AlphRegEntry {
  pid: int64;
  value: int64;
}

// How to run a node. Fill it with alph_config, then change what you need.
//
//   schedulers    scheduler threads; default: one per CPU
//   max_actors    actors alive at once; default 65536
//   mailbox_size  messages a mailbox holds before senders get ALPH_FULL,
//                 unless the actor sets its own with alph_mailbox_limit;
//                 default 64. Memory grows with what is queued, not with this
//   stack_size    bytes of stack per scheduler, which is how deep a handler
//                 may call; default 1 MiB
//   heap_limit    bytes one actor's heap may hold, state included; past it
//                 alph_alloc returns 0 and spawning fails. 0 (default) is
//                 no limit
//   max_handles   IO handles open at once; default 65536
//   signals       OS signals the node takes over, as bits (1 << ALPH_SIGINT)
//                 and so on; default 0. See alph_node_signals
//   spin_us       how long an idle scheduler keeps checking for work before
//                 it sleeps; default 2. Work that arrives meanwhile starts
//                 without a wake-up system call. 0 sleeps at once
//   crash_reports 1 prints the runtime's full report (stack trace) for every
//                 actor crash, as a debugging aid; default 0, quiet, because
//                 a report costs about 60 us of its scheduler's time. Crashes
//                 are still counted (alph_node_stats) and reach links,
//                 monitors, medics and supervisors either way
export struct AlphConfig {
  schedulers: int64;
  max_actors: int64;
  mailbox_size: int64;
  stack_size: int64;
  heap_limit: int64;
  max_handles: int64;
  signals: int64;
  spin_us: int64;
  crash_reports: int64;
}

// Counters from alph_node_stats.
//
//   live     actors alive now
//   spawned  actors started since the node started
//   crashed  crashes that ended an actor
//   healed   crashes a medic repaired, unseen by anyone else
//   shed     messages dropped by alph_mailbox_shed for waiting too long
//   rehomed  wakes that moved an actor to its sender's scheduler, as its
//            own was asleep
//   rescued  schedulers the watchdog woke, or activated, for work stuck
//            behind a long handler
//   io_demoted  handles watched one-shot since their fd was taken with
//            alph_io_fd
//   active   schedulers taking work now (compaction leaves the rest idle)
//   refused  requests their sender refused at once with ALPH_BUSY, as the
//            server was shedding
//   yields   actor runs cut short after ALPH_RUN_NS, with mail left
//   isolated  actors cut short twice in a row and so moved to a scheduler
//            of their own, away from the work queued behind them
export struct AlphStats {
  live: int64;
  spawned: int64;
  crashed: int64;
  healed: int64;
  shed: int64;
  rehomed: int64;
  rescued: int64;
  io_demoted: int64;
  active: int64;
  refused: int64;
  yields: int64;
  isolated: int64;
}

// A node. Declare one, start it with alph_node_start, and keep it in place
// until alph_node_wait returns. Its fields are the runtime's own.
export struct AlphNode {
  procs: int64;
  capacity: int64;
  mailbox_size: int64;
  free_stack: int64;
  free_top: int64;
  free_lock: int64;
  scheds: int64;
  sched_count: int64;
  next_sched: int64;
  next_ref: int64;
  live: int64;
  spawned: int64;
  crashed: int64;
  healed: int64;
  halted: int64;
  halt_code: int64;
  heap_limit: int64;
  stack_size: int64;
  bound_list: int64;    // every bound scheduler, for alph_node_wait
  sysmon: AlphThread;   // the watchdog, alph_sysmon_main
  sysmon_handle: int64;
  sysmon_word: int64;   // futex word it sleeps on; bumped to wake it
  sysmon_idle: int64;   // 1 while it sleeps long because nothing ran: work starting wakes it
  bound_lock: int64;
  ios: int64;           // AlphIoSlot table
  io_capacity: int64;
  io_free_stack: int64;
  io_free_top: int64;
  io_lock: int64;
  names: int64;         // AlphReg: the default registry, for alph_register
  groups: int64;        // AlphTable of process groups
  names_lock: int64;    // guards groups and every group's members
  env: int64;           // the environment the process started with, for children
  env_lock: int64;
  roots: int64;         // AlphVec of top-level pids, in spawn order
  roots_lock: int64;
  shutting: int64;      // alph_node_shutdown has begun
  sigfd: int64;         // signalfd for cfg.signals, on scheduler 0, or -1
  sig_pid: int64;       // who gets OS signals, or 0 to shut down
  sig_tag: int64;
  spin_ns: int64;       // AlphConfig.spin_us, in nanoseconds
  hungry: int64;        // schedulers with hungry set
  spinners: int64;      // schedulers spinning now
  max_spinners: int64;  // at most this many spin at once
  active: int64;        // schedulers 0..active-1 take new work; the rest drain and sleep
  balance_at: int64;    // when the next look at the load is due (ns)
  balance_lock: int64;
  balanced: int64;      // when the last look was (ns)
  low_streak: int64;    // looks in a row that asked for fewer active schedulers
  low_max: int64;       //   and the most any of them asked for
  rise_at: int64;       // when a busy scheduler last activated another (ns)
  shed: int64;          // messages dropped by alph_mailbox_shed
  rehomed: int64;       // wakes that moved an actor to its sender's scheduler
  rescued: int64;       // schedulers the watchdog woke for work stuck behind a long run
  refused: int64;       // requests refused at once with ALPH_BUSY by their senders
  sysmon_looks: int64;  // times the watchdog woke to look
  io_demoted: int64;    // handles turned one-shot because their fd was taken (alph_io_fd)
  rt_offset: int64;     // CLOCK_REALTIME minus CLOCK_MONOTONIC (ns), refreshed by the watchdog
  yields: int64;        // runs cut short by ALPH_RUN_NS
  isolated: int64;      // CPU-bound actors moved off a busy scheduler after such cuts
  epoch: int64;         // bumped by every retire
  retired: AlphVec;     // pairs: block (bit 0 set: a plain block, else an AlphEntry*), epoch
  retire_lock: int64;
}

// What a handler gets besides the message. Read these fields:
//
//   self        this actor's pid
//   state       this actor's state block; cast it to your state type
//   state_size  its size in bytes
//   node        the node, for the alph_node_ functions
//
// The other fields are the runtime's own. ctx is valid until the handler
// returns; do not keep it.
export struct AlphCtx {
  self: int64;
  state: rawptr;
  state_size: int64;
  node: AlphNode*;
  proc: int64;
  sched: int64;
  stop_reason: int64;
}

// ---- internal types --------------------------------------------------------

struct AlphVec {
  data: int64;
  len: int64;
  cap: int64;
}

struct AlphSignal {
  next: int64;  // queue link, must stay first; a pending timer's deadline
  kind: int64;
  from: int64;
  to: int64;
  ref: int64;
  arg: int64;
  tag: int64;
  mark: int64;  // exits and downs: the receiver's mailbox fill when sent
  dead: int64;  // a pending timer whose ref was dropped: freed when due, never delivered
}

struct AlphProc {
  rq_next: int64;  // run-queue link, must stay first
  status: int64;
  pid: int64;      // 0 while the slot is free
  serial: int64;
  index: int64;
  sched: int64;    // home scheduler (an AlphSched*)
  inited: int64;
  parent: int64;
  state: int64;
  state_size: int64;
  trap_exit: int64;
  handled: int64;
  heap: AlphHeap;  // the state and everything alph_alloc gave out
  handler: fn(AlphCtx*, AlphMsg*) -> int64 with alloc, syscall, asm;
  mailbox: AlphMailbox;
  signals: AlphQueue;
  links: AlphVec;
  mon_refs: AlphVec;      // monitors on this actor: ref
  mon_watchers: AlphVec;  //   and who watches
  ref_ids: AlphVec;       // refs this actor waits on: monitors, requests, timers
  ref_pids: AlphVec;      //   and the actor each one watches, or 0
  ref_timers: AlphVec;    //   and its pending timer (an AlphSignal*), or 0
  sig_closed: int64;      // the actor exited: senders answer their own late signals
  shed_target: int64;     // alph_mailbox_shed: longest wait wanted (ns), 0 when off
  shed_interval: int64;   //   how long waits must stay above it before shedding (ns)
  shed_above: int64;      //   when shedding may start, if waits are above target; else 0
  shed_casts: int64;      //   1: plain sends may be shed too, not only requests
  // Published by the server for its requesters, written only when they
  // change, so the line stays clean while nothing does:
  shed_state: int64;      //   ALPH_SHED_IDLE, _ARMING (waits above target) or _DROPPING
  shed_pop_at: int64;     //   when it last took a message while not idle (ns, updated every 100 us at most)
  fresh: int64;           // spawned and INIT not yet handled: it goes before any signal
  cut_streak: int64;      // its runs in a row cut short for time: 2 or more, and it is CPU-bound
  drain_lock: int64;      // held while a late signal queue is drained, and at reuse
  deferred: AlphVec;      // exits and downs waiting for earlier messages
  io_handles: AlphVec;    // handles this actor owns, closed when it exits
  flushq: AlphVec;        // AlphOutq* with alph_outq_send bytes to write when this run ends
  names: AlphVec;         // entries of the names registered to this actor
  groups: AlphVec;        // groups this actor joined (AlphEntry*)
  medic: int64;           // pid of the medic watching this actor, or 0
  patient: int64;         // for a medic: the actor it watches
  poison_heap: int64;     // payload of the message being handled, freed after
  last_msg: AlphMsg;      // with a medic: the message being handled
  retry: int64;           // handle last_msg again when resumed
  proxy: int64;           // spawned with ALPH_PROXY
  has_on_exit: int64;     // on_exit is set and has not run
  on_exit: fn(AlphCtx*, int64) -> int64 with alloc, syscall, asm;
}

struct AlphSched {
  runq: AlphQueue;
  wake: int64;      // futex word, bumped on every push
  sleeping: int64;
  index: int64;
  node: int64;
  current: int64;   // actor being run; read back from memory after a crash
  timers: AlphVec;  // binary heap of AlphSignal, by deadline
  pool: AlphPool;   // chunks for the heaps of actors that live here
  scratch: AlphScratch;  // alph_scratch memory, reset after every handler call
  thread: AlphThread;
  handle: int64;
  bound: int64;         // runs a single ALPH_BOUND actor, and stops after it
  done: int64;          // a bound scheduler's actor has exited
  next_bound: int64;    // the node's list of bound schedulers
  exit_request: int64;  // alph_exit_now asked the current actor to exit
  exit_reason: int64;
  rx: AlphReactor;      // its handles, its wake-ups, and the timerfd for its next timer
  events: int64;        // raw epoll_event buffer, for rescuing another scheduler's handles
  rxev: int64;          // AlphRxEvent[64], for alph_rx_wait
  io_count: int64;      // handles registered here
  runs: int64;          // actor runs, to poll IO now and then while busy
  spin_hits: int64;     // how often its recent spins found work, of 1024 (an average)
  run_seq: int64;       // bumped as each actor run starts, for the watchdog
  run_at: int64;        // when the current (or last) actor run started (ns)
  run_seen: int64;      // run_seq as the watchdog last saw it
  spin_skips: int64;    // idle stretches it slept through without spinning
  qlen: int64;          // actors in runq, roughly: pushes counted after, pops after
  pop_lock: int64;      // taken to pop runq: the owner and thieves are its consumers
  polled_at: int64;     // when it last looked at its sockets, or was rescued (ns)
  hungry: int64;        // 1 while it has no work and may be handed some
  exiting: int64;       // the actor whose exit hook runs now; read back after a crash
  quiet: int64;         // node epoch seen between handlers; ALPH_QUIET_PARKED while it sleeps
  work_at: int64;       // when its current stretch of work began (ns), 0 while idle
  busy_ns: int64;       // time spent working, over finished stretches
  busy_seen: int64;     // busy time the last look at the load counted
}

// One IO handle: a file descriptor with an owner. A handle's id carries a
// serial, like a pid, so an event for a closed handle is recognized.
struct AlphIoSlot {
  fd: int64;
  handle: int64;    // 0 while free
  serial: int64;
  index: int64;
  owner: int64;
  sched: int64;     // the scheduler whose epoll set holds it
  pollable: int64;  // epoll accepted it (regular files are not)
  child: int64;     // a process handle: the child's OS pid until it is reaped
  kill_to: int64;   // what kill() targets for it: -pid (its group) or pid
  armed: int64;     // one-shot slots: events asked for and not yet delivered, to re-arm on a move
  // Edge-triggered slots (the default) are registered once for reading and
  // writing; readiness is tracked here. ready: bits 0-4 (ALPH_IO_ bits that
  // fired and were not yet delivered; ERR and HUP stay), armed: bits 8-12.
  // One CAS moves both, from the polling thread or the owner.
  state: int64;
  oneshot: int64;   // 1: level one-shot, re-armed by epoll_ctl (process handles, and
                    //    any handle whose fd was taken with alph_io_fd)
  stream: int64;    // 1: a TCP stream, where a short read means the socket is drained
  drained: int64;   // the owner's last read or accept found nothing more (owner only)
  full: int64;      // the owner's last write did not fit (owner only)
  rx_from: int64;   // alph_io_recv: what is still unread arrived no earlier than this (monotonic ns)
}

// A registered name, or a process group and its members. The name is a
// copy owned by the entry.
struct AlphEntry {
  chars: int64;
  len: int64;
  pid: int64;        // a name's holder; 0 once taken over from a holder that exited
  members: AlphVec;  // a group's members, in the order they joined
  next: int64;       // the next entry in its hash chain
  hash: int64;
  value: int64;      // a registry entry's value, set by its holder
  reg: int64;        // the AlphReg a name entry belongs to
}

// A registry: a table of keys, each held by one actor (ALPH_REG_UNIQUE) or
// by any number (ALPH_REG_DUPLICATE), with a value per entry. Writers take
// lock; readers in handlers take none (see AlphTable).
struct AlphReg {
  kind: int64;
  lock: int64;
  table: AlphTable;
}

// A hash table of entries by name, chained. Writers hold its owner's lock.
// Readers in handlers take no lock (alph_whereis): the chain heads live in
// one block (its mask first) published by one pointer, a resize makes seq
// odd while it relinks, and removed entries and old blocks are freed only
// through alph_retire, once no handler can still hold them.
struct AlphTable {
  block: int64;  // [mask][head 0][head 1]...; heads are AlphEntry*
  count: int64;
  seq: int64;    // odd while a resize relinks the chains
}

// ---- small helpers ---------------------------------------------------------

fn alph_vec_push(v: AlphVec*, x: int64) -> bool {
  if (v->len == v->cap) {
    var cap: int64 = v->cap * 2;
    if (cap < 4) {
      cap = 4;
    }
    var grown: rawptr = malloc(cap * 8);
    if (grown == 0) {
      return false;
    }
    if (v->data != 0) {
      memcpy(grown, (rawptr)v->data, v->len * 8);
      free((rawptr)v->data);
    }
    v->data = (int64)grown;
    v->cap = cap;
  }
  var at: int64* = (int64*)(v->data + v->len * 8);
  *at = x;
  v->len = v->len + 1;
  return true;
}

fn alph_vec_get(v: AlphVec*, i: int64) -> int64 {
  var at: int64* = (int64*)(v->data + i * 8);
  return *at;
}

fn alph_vec_set(v: AlphVec*, i: int64, x: int64) {
  var at: int64* = (int64*)(v->data + i * 8);
  *at = x;
}

fn alph_vec_find(v: AlphVec*, x: int64) -> int64 {
  for i: int64 in 0..v->len {
    if (alph_vec_get(v, i) == x) {
      return i;
    }
  }
  return -1;
}

// Removes entry i by moving the last entry into its place.
fn alph_vec_remove_at(v: AlphVec*, i: int64) {
  v->len = v->len - 1;
  alph_vec_set(v, i, alph_vec_get(v, v->len));
}

// Removes and returns the oldest entry, keeping the order of the rest.
fn alph_vec_shift(v: AlphVec*) -> int64 {
  var first: int64 = alph_vec_get(v, 0);
  for i: int64 in 1..v->len {
    alph_vec_set(v, i - 1, alph_vec_get(v, i));
  }
  v->len = v->len - 1;
  return first;
}

fn alph_vec_release(v: AlphVec*) {
  if (v->data != 0) {
    free((rawptr)v->data);
  }
  v->data = 0;
  v->len = 0;
  v->cap = 0;
}

fn alph_spin_lock(lock: int64*) {
  while (alph_atomic_cas(lock, 0, 1) != 0) {
    alph_cpu_relax();
  }
}

fn alph_spin_unlock(lock: int64*) {
  alph_atomic_store(lock, 0);
}

fn alph_slot(node: AlphNode*, index: int64) -> AlphProc* {
  return (AlphProc*)(node->procs + index * (int64)sizeof(AlphProc));
}

fn alph_sched_at(node: AlphNode*, index: int64) -> AlphSched* {
  return (AlphSched*)(node->scheds + index * (int64)sizeof(AlphSched));
}

fn alph_me(ctx: AlphCtx*) -> AlphProc* {
  return (AlphProc*)ctx->proc;
}

fn alph_here(ctx: AlphCtx*) -> AlphSched* {
  return (AlphSched*)ctx->sched;
}

// The live actor a pid names, or 0 when it has exited.
fn alph_resolve(node: AlphNode*, pid: int64) -> AlphProc* {
  var index: int64 = (pid & (((int64)1 << 32) - 1)) - 1;
  if (pid <= 0 || index < 0 || index >= node->capacity) {
    return (AlphProc*)0;
  }
  var p: AlphProc* = alph_slot(node, index);
  if (alph_atomic_load(&p->pid) != pid) {
    return (AlphProc*)0;
  }
  return p;
}

fn alph_new_ref(node: AlphNode*) -> int64 {
  return alph_atomic_add(&node->next_ref, 1) + 1;
}

// Records that p waits on ref, which watches pid (0 for a timer).
fn alph_hold_ref(p: AlphProc*, ref: int64, pid: int64) {
  alph_vec_push(&p->ref_ids, ref);
  alph_vec_push(&p->ref_pids, pid);
  alph_vec_push(&p->ref_timers, 0);
}

// Notes that ref's timeout or timer is sig, so dropping ref kills it.
fn alph_hold_timer(p: AlphProc*, ref: int64, sig: int64) {
  var at: int64 = alph_vec_find(&p->ref_ids, ref);
  if (at >= 0 && at < p->ref_timers.len) {
    alph_vec_set(&p->ref_timers, at, sig);
  }
}

// Forgets ref if p was waiting on it. Returns the pid it watched (0 for a
// timer), or -1 when p was not waiting on it.
fn alph_take_ref(p: AlphProc*, ref: int64) -> int64 {
  var at: int64 = alph_vec_find(&p->ref_ids, ref);
  if (at < 0) {
    return -1;
  }
  var pid: int64 = alph_vec_get(&p->ref_pids, at);
  var timer: int64 = 0;
  if (at < p->ref_timers.len) {
    timer = alph_vec_get(&p->ref_timers, at);
    alph_vec_remove_at(&p->ref_timers, at);
  }
  alph_vec_remove_at(&p->ref_ids, at);
  alph_vec_remove_at(&p->ref_pids, at);
  if (timer != 0) {
    // Still in a scheduler's timer heap, or queued to p: either way alive.
    // Its owner frees it when due without waking anyone.
    alph_atomic_store(&((AlphSignal*)timer)->dead, 1);
  }
  return pid;
}

// Frees a message's payload if it has its own allocation.
fn alph_msg_release(m: AlphMsg*) {
  if (m->heap != 0) {
    free((rawptr)m->heap);
    m->heap = 0;
  }
}

// The pool that feeds an actor's heap: its home scheduler's.
fn alph_pool_of(node: AlphNode*, p: AlphProc*) -> AlphPool* {
  return &((AlphSched*)p->sched)->pool;
}

// Frees everything an actor's heap holds, its state included.
fn alph_heap_clear(node: AlphNode*, p: AlphProc*) {
  alph_heap_release(&p->heap, alph_pool_of(node, p));
  p->state = 0;
}

// Gives an empty heap a copy of size bytes at state as the actor's state.
// Returns false when the heap limit or memory does not allow it.
fn alph_set_state(node: AlphNode*, p: AlphProc*, state: rawptr, size: int64) -> bool {
  p->state = 0;
  p->state_size = size;
  if (size > 0) {
    var block: rawptr = alph_heap_alloc(&p->heap, alph_pool_of(node, p), size);
    if (block == 0) {
      return false;
    }
    memcpy(block, state, size);
    p->state = (int64)block;
  }
  return true;
}

// ---- scheduling ------------------------------------------------------------

fn alph_sched_notify(s: AlphSched*) {
  alph_atomic_add(&s->wake, 1);
  if (alph_atomic_load(&s->sleeping) != 0) {
    var one: int64 = 1;
    alph_rx_wake(&s->rx);
  }
}

// Makes sure p runs soon after new work was pushed to it.
//
// The fence pairs with the sequentially consistent RUNNING store in
// alph_run_proc. Without both, x86 lets each side's load pass its own earlier
// store: the scheduler finds the mailbox empty while the sender still reads
// QUEUED, and the message waits forever.
fn alph_runq_push(s: AlphSched*, p: AlphProc*) {
  alph_queue_push(&s->runq, (rawptr)p);
  alph_atomic_add(&s->qlen, 1);
}

// Pops s's run queue. The queue is multi-producer, single-consumer; the pop
// lock makes the owner and stealing schedulers take turns as its consumer.
// Uncontended, it is one compare-and-swap.
fn alph_runq_pop(s: AlphSched*) -> int64 {
  while (alph_atomic_cas(&s->pop_lock, 0, 1) != 0) {
    alph_cpu_relax();
  }
  var p: int64 = alph_queue_pop(&s->runq);
  alph_atomic_store(&s->pop_lock, 0);
  if (p != 0) {
    alph_atomic_add(&s->qlen, -1);
  }
  return p;
}

// Work stealing: takes one queued actor from another scheduler that has
// work waiting, and makes s its home. Used by idle schedulers, so a thread
// the OS has paused cannot hold queued actors hostage, as on BEAM. Returns
// the actor to run, or 0.
fn alph_sched_steal(s: AlphSched*, node: AlphNode*) -> int64 {
  if (s->bound != 0) {
    return 0;
  }
  for i: int64 in 1..node->sched_count {
    var v: AlphSched* = alph_sched_at(node, (s->index + i) % node->sched_count);
    if (alph_atomic_load(&v->qlen) > 0 && alph_atomic_cas(&v->pop_lock, 0, 1) == 0) {
      var p: int64 = alph_queue_pop(&v->runq);
      alph_atomic_store(&v->pop_lock, 0);
      if (p != 0) {
        alph_atomic_add(&v->qlen, -1);
        // QUEUED and off every queue: nobody else touches its home now.
        // Its sockets stay where they are watched: with edge-triggered
        // handles any thread may arm, read and write them, the old home's
        // poller signals the owner wherever it runs, and the watchdog
        // reads them when that home stalls. Moving them cost two epoll_ctl
        // per steal. They move when their home stops being active
        // (alph_sched_give).
        ((AlphProc*)p)->sched = (int64)s;
        return p;
      }
    }
  }
  return 0;
}

// The quiet value of a sleeping scheduler: above every epoch.
fn alph_quiet_parked() -> int64 {
  return (int64)1 << 62;
}

// Marks s as between handlers: it holds nothing it read without a lock.
fn alph_sched_quiet(s: AlphSched*, node: AlphNode*) {
  alph_atomic_store_sc(&s->quiet, alph_atomic_load(&node->epoch));
}

// Frees what no handler can hold any more: everything retired before the
// oldest epoch a shared scheduler has seen between handlers.
fn alph_reclaim(node: AlphNode*) {
  var oldest: int64 = alph_quiet_parked();
  for i: int64 in 0..node->sched_count {
    var q: int64 = alph_atomic_load(&alph_sched_at(node, i)->quiet);
    if (q < oldest) {
      oldest = q;
    }
  }
  alph_spin_lock(&node->retire_lock);
  var v: AlphVec* = &node->retired;
  var keep: int64 = 0;
  var i: int64 = 0;
  while (i + 1 < v->len) {
    var block: int64 = alph_vec_get(v, i);
    var epoch: int64 = alph_vec_get(v, i + 1);
    if (epoch < oldest) {
      if ((block & 1) != 0) {
        free((rawptr)(block - 1));
      } else {
        alph_entry_free((AlphEntry*)block);
      }
    } else {
      alph_vec_set(v, keep, block);
      alph_vec_set(v, keep + 1, epoch);
      keep = keep + 2;
    }
    i = i + 2;
  }
  v->len = keep;
  alph_spin_unlock(&node->retire_lock);
}

// Hands memory that lock-free readers may still hold to reclamation: an
// AlphEntry*, or a plain block with bit 0 set. Call after unlinking it.
// If the list cannot grow, the block is kept (leaked) rather than freed
// under a reader. Thread: any.
fn alph_retire(node: AlphNode*, block: int64) {
  var epoch: int64 = alph_atomic_add(&node->epoch, 1);
  alph_spin_lock(&node->retire_lock);
  if (alph_vec_push(&node->retired, block)) {
    if (!alph_vec_push(&node->retired, epoch)) {
      node->retired.len = node->retired.len - 1;
    }
  }
  var many: bool = node->retired.len >= ALPH_RETIRE_BATCH * 2;
  alph_spin_unlock(&node->retire_lock);
  if (many) {
    alph_reclaim(node);
  }
}

// Whether s takes new work. A bound scheduler always runs its one actor.
fn alph_sched_active(node: AlphNode*, s: AlphSched*) -> bool {
  return s->bound != 0 || s->index < alph_atomic_load(&node->active);
}

// An active scheduler for p, spread by its slot.
fn alph_sched_pick(node: AlphNode*, p: AlphProc*) -> AlphSched* {
  var n: int64 = alph_atomic_load(&node->active);
  if (n < 1) {
    n = 1;
  }
  return alph_sched_at(node, p->index % n);
}

// Moves p's handles to the epoll set of to, armed as they were. The caller
// holds p (QUEUED and on no queue) on the thread of p's old home, the one
// thread that polls those handles, so no event is lost: one that fired and
// was not yet read is dropped with the old registration and, the handle
// still being ready, fires again on the new one.
fn alph_io_move(node: AlphNode*, p: AlphProc*, to: AlphSched*) {
  for i: int64 in 0..p->io_handles.len {
    var slot: AlphIoSlot* = alph_io_slot(node, alph_vec_get(&p->io_handles, i));
    if (slot != 0 && slot->pollable != 0 && slot->sched != (int64)to) {
      var old: AlphSched* = (AlphSched*)slot->sched;
      alph_rx_remove(&old->rx, slot->fd);
      alph_atomic_add(&old->io_count, -1);
      slot->sched = (int64)to;
      if (alph_io_watch(slot, to) == 0) {
        alph_atomic_add(&to->io_count, 1);
      } else {
        slot->pollable = 0;
      }
    }
  }
}

// Gives p, which s popped, to another scheduler and wakes it.
fn alph_sched_give(s: AlphSched*, node: AlphNode*, p: AlphProc*, to: AlphSched*) {
  alph_io_move(node, p, to);
  // QUEUED and off every queue: nobody else touches its home now. Set it
  // before the push makes it visible to the new home.
  p->sched = (int64)to;
  alph_runq_push(to, p);
  alph_sched_notify(to);
}

// Activates one more scheduler at once when s has a queue and no active
// scheduler is idle to take a share of it; see ALPH_RISE_QLEN.
fn alph_sched_rise(s: AlphSched*, node: AlphNode*) {
  if (s->bound != 0 || alph_atomic_load(&s->qlen) < ALPH_RISE_QLEN || alph_atomic_load(&node->hungry) != 0) {
    return;
  }
  var active: int64 = alph_atomic_load(&node->active);
  if (active >= node->sched_count) {
    return;
  }
  var t: int64 = alph_now_ns();
  var last: int64 = alph_atomic_load(&node->rise_at);
  if (t - last < ALPH_RISE_NS || alph_atomic_cas(&node->rise_at, last, t) != last) {
    return;
  }
  if (alph_atomic_cas(&node->active, active, active + 1) == active) {
    alph_atomic_store(&node->low_streak, 0);  // a rise starts the wait for a shrink again
    alph_sched_notify(alph_sched_at(node, active));  // it wakes, goes hungry and steals
  }
}

// Busy-time accounting for compaction: a stretch of work starts when a
// scheduler finds work after being idle, and ends when it runs out.
fn alph_sched_working(s: AlphSched*) {
  if (s->work_at == 0) {
    // Sequentially consistent, paired with the watchdog's store to
    // sysmon_idle and its look at work_at: one of the two sees the other.
    alph_atomic_store_sc(&s->work_at, alph_now_ns());
    var node: AlphNode* = (AlphNode*)s->node;
    if (alph_atomic_load(&node->sysmon_idle) != 0 && alph_atomic_cas(&node->sysmon_idle, 1, 0) == 1) {
      // The watchdog backed off while the node idled: it looks again now.
      alph_atomic_add(&node->sysmon_word, 1);
      alph_futex_wake(&node->sysmon_word, 1);
    }
  }
}

fn alph_sched_resting(s: AlphSched*, node: AlphNode*) {
  var w: int64 = s->work_at;
  if (w == 0) {
    return;
  }
  var t: int64 = alph_now_ns();
  // Clear work_at before adding, so a look at the load never counts the
  // stretch twice; at worst it counts it one look late.
  alph_atomic_store_sc(&s->work_at, 0);
  alph_atomic_add(&s->busy_ns, t - w);
  alph_balance(node, t);
}

// Looks at the load when one is due, and sets how many schedulers are
// active. Any scheduler may call it; one at a time does the work.
fn alph_balance(node: AlphNode*, t: int64) {
  if (t < alph_atomic_load(&node->balance_at) || alph_atomic_cas(&node->balance_lock, 0, 1) != 0) {
    return;
  }
  if (t >= node->balance_at) {
    var busy: int64 = 0;
    for i: int64 in 0..node->sched_count {
      var s: AlphSched* = alph_sched_at(node, i);
      var total: int64 = alph_atomic_load(&s->busy_ns);
      var w: int64 = alph_atomic_load(&s->work_at);
      if (w != 0 && t > w) {
        total = total + (t - w);  // the stretch under way, so far
      }
      if (total > s->busy_seen) {
        busy = busy + (total - s->busy_seen);
      }
      s->busy_seen = total;
    }
    var span: int64 = t - node->balanced;
    if (node->balanced != 0 && span > 0) {
      var target: int64 = busy * 100 / (span * ALPH_BUSY_PCT) + 1;
      if (target > node->sched_count) {
        target = node->sched_count;
      }
      var active: int64 = node->active;
      if (target > active) {
        alph_atomic_store_sc(&node->active, target);
        node->low_streak = 0;
        node->low_max = 0;
        for i: int64 in active..target {
          alph_sched_notify(alph_sched_at(node, i));  // so it looks for work to steal
        }
      } else if (target < active) {
        node->low_streak = node->low_streak + 1;
        if (target > node->low_max) {
          node->low_max = target;
        }
        if (node->low_streak >= ALPH_SHRINK_AFTER) {
          alph_atomic_store_sc(&node->active, node->low_max);
          node->low_streak = 0;
          node->low_max = 0;
        }
      } else {
        node->low_streak = 0;
        node->low_max = 0;
      }
    }
    node->balanced = t;
    alph_atomic_store(&node->balance_at, t + ALPH_BALANCE_NS);
  }
  alph_atomic_store(&node->balance_lock, 0);
  if (alph_atomic_load(&node->retired.len) > 0) {
    alph_reclaim(node);
  }
}

fn alph_wake(node: AlphNode*, p: AlphProc*) {
  alph_wake_from(node, p, 0);
}

// The scheduler the actor from is running on, when it is running: the
// thread that is sending for it. Else 0.
fn alph_sender_sched(node: AlphNode*, from: int64) -> AlphSched* {
  if (from == 0) {
    return (AlphSched*)0;
  }
  var q: AlphProc* = alph_resolve(node, from);
  if (q == 0 || alph_atomic_load(&q->status) != ALPH_P_RUNNING) {
    return (AlphSched*)0;
  }
  if (q->cut_streak > 0) {
    // A CPU-bound sender, maybe isolated on its scheduler: what it wakes
    // would queue behind it, and pull it back into sharing.
    return (AlphSched*)0;
  }
  return (AlphSched*)q->sched;
}

// As alph_wake, for work sent by the actor from (0: by no actor). When p
// owns no sockets, is not bound to a thread of its own, and its home is
// asleep, it moves to from's scheduler, if that has nothing else queued,
// instead, as Go's ready() puts a woken goroutine on the waker's P: from's
// thread is awake and runs it after from, where waking the home would cost
// an eventfd write, a context switch and a cold cache.
fn alph_wake_from(node: AlphNode*, p: AlphProc*, from: int64) {
  alph_atomic_fence();
  while (true) {
    var status: int64 = alph_atomic_load(&p->status);
    if (status == ALPH_P_IDLE) {
      if (alph_atomic_cas(&p->status, ALPH_P_IDLE, ALPH_P_QUEUED) == ALPH_P_IDLE) {
        var s: AlphSched* = (AlphSched*)p->sched;
        if (!alph_sched_active(node, s) && p->io_handles.len == 0) {
          // Its home is draining: give it an active one. It is QUEUED and
          // on no queue, so only this thread touches its home now. Socket
          // owners move on their old home's thread, with their sockets.
          s = alph_sched_pick(node, p);
          p->sched = (int64)s;
        } else if (from != 0 && s->bound == 0 && p->io_handles.len == 0 &&
                   alph_atomic_load(&s->sleeping) != 0) {
          var here: AlphSched* = alph_sender_sched(node, from);
          if (here != 0 && here != s && here->bound == 0 && alph_sched_active(node, here) &&
              alph_atomic_load(&here->qlen) == 0) {
            s = here;
            p->sched = (int64)s;
            alph_atomic_add(&node->rehomed, 1);
          }
        }
        alph_runq_push(s, p);
        alph_sched_notify(s);
        return;
      }
    } else if (status == ALPH_P_RUNNING) {
      if (alph_atomic_cas(&p->status, ALPH_P_RUNNING, ALPH_P_DIRTY) == ALPH_P_RUNNING) {
        return;
      }
    } else {
      return;  // already queued, running with work noted, exiting, or held
    }
  }
}

// ---- signals ---------------------------------------------------------------

// Exits and downs wait for messages sent before them. A kill does not wait.
fn alph_signal_ordered(kind: int64, arg: int64) -> bool {
  if (kind == ALPH_SIG_EXIT) {
    return arg != ALPH_KILL;
  }
  return kind == ALPH_SIG_LINK_EXIT || kind == ALPH_SIG_DOWN;
}

// Queues a signal for the actor `to`, if it is alive. Returns false when it
// is not, or memory ran out.
// Answers a signal sent to an actor that is gone, as if it had been gone
// when it was sent: a link or a monitor learns ALPH_NOPROC at once, and a
// handle given to it is closed. s->to is the dead pid.
fn alph_answer_gone(node: AlphNode*, s: AlphSignal*) {
  if (s->kind == ALPH_SIG_LINK) {
    alph_signal_link_exit(node, s->to, s->from, ALPH_NOPROC);
  } else if (s->kind == ALPH_SIG_MONITOR) {
    alph_signal_down(node, s->to, s->from, s->ref, ALPH_NOPROC);
  } else if (s->kind == ALPH_SIG_IO_GIVEN) {
    alph_io_drop(node, s->ref, s->to);
  }
}

// Drains the signal queue of an exited actor's slot, answering each signal
// as alph_answer_gone does. Called by alph_proc_exit after it closed the
// queue, and by any sender that finds the queue closed after its push, so a
// signal that raced the exit is never left unanswered. One drainer at a
// time, under drain_lock; each one looks again after letting go, so a push
// that finished while the lock was held is not missed. Stops when the slot
// has been reused (sig_closed back to 0): its new owner reads the queue then.
fn alph_drain_late(node: AlphNode*, p: AlphProc*) {
  while (true) {
    if (alph_atomic_cas(&p->drain_lock, 0, 1) != 0) {
      return;  // the holder looks again after letting go
    }
    if (alph_atomic_load(&p->sig_closed) == 0) {
      alph_atomic_store(&p->drain_lock, 0);
      return;
    }
    var sig: int64 = alph_queue_pop(&p->signals);
    var any: bool = sig != 0;
    while (sig != 0) {
      alph_answer_gone(node, (AlphSignal*)sig);
      free((rawptr)sig);
      sig = alph_queue_pop(&p->signals);
    }
    alph_atomic_store_sc(&p->drain_lock, 0);
    if (!any) {
      return;
    }
  }
}

fn alph_signal(node: AlphNode*, kind: int64, from: int64, to: int64, ref: int64,
               arg: int64, tag: int64) -> bool {
  var p: AlphProc* = alph_resolve(node, to);
  if (p == 0) {
    return false;
  }
  var sig: AlphSignal* = (AlphSignal*)malloc((int64)sizeof(AlphSignal));
  if (sig == 0) {
    return false;
  }
  sig->kind = kind;
  sig->from = from;
  sig->to = to;
  sig->ref = ref;
  sig->arg = arg;
  sig->tag = tag;
  sig->mark = 0;
  if (alph_signal_ordered(kind, arg)) {
    sig->mark = alph_atomic_load(&p->mailbox.enq);
  }
  alph_queue_push(&p->signals, (rawptr)sig);
  // The target may have finished its exit between our resolve and our push.
  // The full fence pairs with the sequentially consistent store of
  // sig_closed in alph_proc_exit: either it drains after our push, or we
  // see it closed and drain ourselves.
  alph_atomic_fence();
  if (alph_atomic_load(&p->sig_closed) != 0) {
    alph_drain_late(node, p);
    return true;
  }
  alph_wake_from(node, p, from);
  return true;
}

fn alph_signal_plain(node: AlphNode*, kind: int64, from: int64, to: int64, ref: int64) {
  alph_signal(node, kind, from, to, ref, 0, 0);
}

fn alph_signal_link_exit(node: AlphNode*, from: int64, to: int64, reason: int64) {
  alph_signal(node, ALPH_SIG_LINK_EXIT, from, to, 0, reason, 0);
}

fn alph_signal_down(node: AlphNode*, from: int64, to: int64, ref: int64, reason: int64) {
  alph_signal(node, ALPH_SIG_DOWN, from, to, ref, reason, 0);
}

// ---- sending ---------------------------------------------------------------

fn alph_message(m: AlphMsg*, from: int64, to: int64, tag: int64, arg: int64, size: int64) {
  m->tag = tag;
  m->from = from;
  m->to = to;
  m->ref = 0;
  m->arg = arg;
  m->flags = 0;
  m->size = size;
  m->heap = 0;
}

// Copies the payload into m and m into the receiver's mailbox.
fn alph_post(node: AlphNode*, m: AlphMsg*, payload: rawptr) -> int64 {
  return alph_post_at(node, m, payload, 0);
}

// As alph_post; sent_at (monotonic ns, 0 for now) is what a stamping mailbox
// notes as the send time.
fn alph_post_at(node: AlphNode*, m: AlphMsg*, payload: rawptr, sent_at: int64) -> int64 {
  var p: AlphProc* = alph_resolve(node, m->to);
  if (p == 0) {
    return ALPH_GONE;
  }
  m->heap = 0;
  if (m->size > ALPH_INLINE) {
    var block: rawptr = malloc(m->size);
    if (block == 0) {
      return ALPH_NOMEM;
    }
    memcpy(block, payload, m->size);
    m->heap = (int64)block;
  } else if (m->size > 0) {
    memcpy((rawptr)&m->data[0], payload, m->size);
  }
  // A reply is never refused for a full mailbox: the requester asked for it,
  // and its own outstanding requests bound how many can come. Refusing it
  // would leave the request waiting for its timeout, and under overload a
  // busy requester would stop getting any answers at all.
  var pushed: bool = false;
  if ((m->flags & ALPH_MSG_REPLY) != 0) {
    pushed = alph_mailbox_push_any(&p->mailbox, m);
  } else {
    pushed = alph_mailbox_push_at(&p->mailbox, m, sent_at);
  }
  if (!pushed) {
    alph_msg_release(m);
    return ALPH_FULL;
  }
  alph_wake_from(node, p, m->from);
  return ALPH_SENT;
}

fn alph_send_raw(node: AlphNode*, from: int64, to: int64, tag: int64, arg: int64,
                 data: rawptr, size: int64) -> int64 {
  var m: AlphMsg;
  alph_message(&m, from, to, tag, arg, size);
  return alph_post(node, &m, data);
}

// Sends a tag and one word to another actor.
//
//   to   the receiver's pid
//   tag  what the message means; your tags start at ALPH_TAG_USER
//   arg  one word of data, read as m->arg
//
// Returns ALPH_SENT, ALPH_FULL when the receiver's mailbox is full, or
// ALPH_GONE when it has exited. Nothing is sent unless it returns ALPH_SENT.
// Messages from one sender arrive in the order they were sent.
// Thread: a handler. Outside the node, use alph_node_send.
export fn alph_send(ctx: AlphCtx*, to: int64, tag: int64, arg: int64) -> int64 {
  return alph_send_raw(ctx->node, ctx->self, to, tag, arg, (rawptr)0, 0);
}

// Sends one T, copied, as the payload. The receiver reads it with
// alph_msg_value<T>. Returns as alph_send, plus ALPH_NOMEM when a payload
// over ALPH_INLINE bytes could not be allocated.
// Thread: a handler. Outside the node, use alph_node_send_value.
export fn alph_send_value<T>(ctx: AlphCtx*, to: int64, tag: int64, value: T*) -> int64 {
  return alph_send_raw(ctx->node, ctx->self, to, tag, 0, (rawptr)value, (int64)sizeof(T));
}

// Sends size bytes at data, copied, as the payload: for data whose length is
// only known at run time. The receiver reads it with alph_msg_bytes.
// Returns as alph_send_value.
// Thread: a handler. Outside the node, use alph_node_send_bytes.
export fn alph_send_bytes(ctx: AlphCtx*, to: int64, tag: int64, data: rawptr, size: int64) -> int64 {
  return alph_send_raw(ctx->node, ctx->self, to, tag, 0, data, size);
}

// Sends a tag and one word from outside the node; m->from is 0.
// Returns as alph_send. Thread: any.
export fn alph_node_send(node: AlphNode*, to: int64, tag: int64, arg: int64) -> int64 {
  return alph_send_raw(node, 0, to, tag, arg, (rawptr)0, 0);
}

// Sends one T from outside the node. Returns as alph_send_value.
// Thread: any.
export fn alph_node_send_value<T>(node: AlphNode*, to: int64, tag: int64, value: T*) -> int64 {
  return alph_send_raw(node, 0, to, tag, 0, (rawptr)value, (int64)sizeof(T));
}

// Sends size bytes from outside the node. Returns as alph_send_value.
// Thread: any.
export fn alph_node_send_bytes(node: AlphNode*, to: int64, tag: int64, data: rawptr,
                               size: int64) -> int64 {
  return alph_send_raw(node, 0, to, tag, 0, data, size);
}

// ---- requests and replies --------------------------------------------------

fn alph_request_raw(ctx: AlphCtx*, to: int64, tag: int64, arg: int64, data: rawptr,
                    size: int64, timeout_ms: int64) -> int64 {
  return alph_request_from(ctx, to, tag, arg, data, size, timeout_ms, 0);
}

fn alph_request_from(ctx: AlphCtx*, to: int64, tag: int64, arg: int64, data: rawptr,
                     size: int64, timeout_ms: int64, sent_at: int64) -> int64 {
  var server: AlphProc* = alph_resolve(ctx->node, to);
  if (server != 0 && server->shed_target > 0 && alph_shed_refuse(server)) {
    alph_atomic_add(&ctx->node->refused, 1);
    return ALPH_BUSY;
  }
  var ref: int64 = alph_monitor(ctx, to);
  var m: AlphMsg;
  alph_message(&m, ctx->self, to, tag, arg, size);
  m.ref = ref;
  m.flags = ALPH_MSG_REQUEST;
  var sent: int64 = alph_post_at(ctx->node, &m, data, sent_at);
  if (sent != ALPH_SENT && sent != ALPH_GONE) {
    alph_demonitor(ctx, ref);
    return sent;
  }
  // A gone server needs no timer: the monitor delivers DOWN with ALPH_NOPROC.
  if (timeout_ms > 0) {
    alph_hold_timer(alph_me(ctx), ref, alph_timer(ctx, timeout_ms, ctx->self, ALPH_TAG_TIMEOUT, ref, to));
  }
  return ref;
}

// How many messages wait in this actor's mailbox, not counting the one
// being handled: a handler can batch work (one write for many answers)
// while more is queued, and finish it with the last. Thread: a handler.
export fn alph_backlog(ctx: AlphCtx*) -> int64 {
  return alph_mailbox_count(&alph_me(ctx)->mailbox);
}

// Sends a request: a message whose answer comes back with the same ref.
//
//   to          the server's pid
//   tag, arg    as alph_send
//   timeout_ms  how long to wait for the reply, or 0 to wait for ever
//
// Returns the request's ref (above 0), or ALPH_FULL or ALPH_NOMEM when the
// request was not sent, or ALPH_BUSY when the server sheds load
// (alph_mailbox_shed) and refusing it here costs the server nothing:
// answer your own client at once, or try later or elsewhere. After a ref,
// exactly one of these arrives, carrying it:
//
//   the reply           tag and payload as the server sent them
//   ALPH_TAG_DOWN       the server exited first, or was already gone;
//                       arg = its exit reason
//   ALPH_TAG_TIMEOUT    no reply within timeout_ms; arg = the server
//   ALPH_TAG_BUSY       the server shed it unhandled for waiting too long
//                       (alph_mailbox_shed): overloaded, try later
//
// Anything later for that ref is dropped, so a late reply never surprises
// the requester. alph_demonitor(ctx, ref) gives up on a request: nothing
// for that ref arrives after it. The server answers with alph_reply.
// Thread: a handler.
export fn alph_request(ctx: AlphCtx*, to: int64, tag: int64, arg: int64, timeout_ms: int64) -> int64 {
  return alph_request_raw(ctx, to, tag, arg, (rawptr)0, 0, timeout_ms);
}

// As alph_request, for a request that really arrived at sent_at (monotonic
// ns, as alph_now_ns; from alph_io_recv for one read from a socket): a
// server that sheds load (alph_mailbox_shed) counts its wait from then,
// so time spent in the kernel's buffers or the caller's queue counts too.
// Thread: a handler.
export fn alph_request_at(ctx: AlphCtx*, to: int64, tag: int64, arg: int64, timeout_ms: int64,
                          sent_at: int64) -> int64 {
  return alph_request_from(ctx, to, tag, arg, (rawptr)0, 0, timeout_ms, sent_at);
}

// Sends a request carrying one T. Otherwise as alph_request.
// Thread: a handler.
export fn alph_request_value<T>(ctx: AlphCtx*, to: int64, tag: int64, value: T*,
                                timeout_ms: int64) -> int64 {
  return alph_request_raw(ctx, to, tag, 0, (rawptr)value, (int64)sizeof(T), timeout_ms);
}

// Sends a request carrying size bytes. Otherwise as alph_request.
// Thread: a handler.
export fn alph_request_bytes(ctx: AlphCtx*, to: int64, tag: int64, data: rawptr, size: int64,
                             timeout_ms: int64) -> int64 {
  return alph_request_raw(ctx, to, tag, 0, data, size, timeout_ms);
}

fn alph_reply_raw(ctx: AlphCtx*, request: AlphMsg*, tag: int64, arg: int64, data: rawptr,
                  size: int64) -> int64 {
  var m: AlphMsg;
  alph_message(&m, ctx->self, request->from, tag, arg, size);
  m.ref = request->ref;
  m.flags = ALPH_MSG_REPLY;
  return alph_post(ctx->node, &m, data);
}

// Answers a request with a tag and one word.
//
//   request  the request message as the handler received it
//
// The reply goes to the requester with the request's ref. Returns as
// alph_send, except that a full mailbox never refuses a reply: the
// requester's own outstanding requests bound how many it can get, so
// replies get through even when it is flooded with other work. A requester
// that already timed out or exited drops it. Thread: a handler.
export fn alph_reply(ctx: AlphCtx*, request: AlphMsg*, tag: int64, arg: int64) -> int64 {
  return alph_reply_raw(ctx, request, tag, arg, (rawptr)0, 0);
}

// Answers a request with one T. Otherwise as alph_reply.
// Thread: a handler.
export fn alph_reply_value<T>(ctx: AlphCtx*, request: AlphMsg*, tag: int64, value: T*) -> int64 {
  return alph_reply_raw(ctx, request, tag, 0, (rawptr)value, (int64)sizeof(T));
}

// Answers a request with size bytes. Otherwise as alph_reply.
// Thread: a handler.
export fn alph_reply_bytes(ctx: AlphCtx*, request: AlphMsg*, tag: int64, data: rawptr,
                           size: int64) -> int64 {
  return alph_reply_raw(ctx, request, tag, 0, data, size);
}

// Answers a request with a tag, one word and size bytes, for replies that
// carry both a result code and data. Otherwise as alph_reply.
// Thread: a handler.
export fn alph_reply_full(ctx: AlphCtx*, request: AlphMsg*, tag: int64, arg: int64, data: rawptr,
                          size: int64) -> int64 {
  return alph_reply_raw(ctx, request, tag, arg, data, size);
}

// Posts a message as if from actor from, with the request or reply marks
// of another node's message: flags is ALPH_MSG_FLAG_REQUEST,
// ALPH_MSG_FLAG_REPLY or 0, and ref is that message's ref. For
// alph/net/dist, which delivers messages that crossed a connection; other
// code uses alph_send and friends. Returns as alph_send_bytes.
// Thread: any.
export fn alph_node_forward(node: AlphNode*, to: int64, from: int64, tag: int64, arg: int64,
                            ref: int64, flags: int64, data: rawptr, size: int64) -> int64 {
  var m: AlphMsg;
  alph_message(&m, from, to, tag, arg, size);
  m.ref = ref;
  m.flags = flags & (ALPH_MSG_REQUEST | ALPH_MSG_REPLY);
  return alph_post(node, &m, data);
}

// The request and reply marks of a message, for m->flags and
// alph_node_forward.
export const ALPH_MSG_FLAG_REQUEST: int64 = 1;
export const ALPH_MSG_FLAG_REPLY: int64 = 2;

// ---- links, monitors, exit signals -----------------------------------------

// Links this actor with pid, both ways: when either exits with a reason
// other than ALPH_NORMAL, the other exits with the same reason, or gets an
// ALPH_TAG_EXIT message if it traps exits. Linking to a gone actor acts as
// if it had just exited with ALPH_NOPROC. Linking twice is one link.
// Thread: a handler.
export fn alph_link(ctx: AlphCtx*, pid: int64) {
  var p: AlphProc* = alph_me(ctx);
  if (pid == ctx->self || alph_vec_find(&p->links, pid) >= 0) {
    return;
  }
  alph_vec_push(&p->links, pid);
  if (alph_resolve(ctx->node, pid) == 0) {
    alph_signal_link_exit(ctx->node, pid, ctx->self, ALPH_NOPROC);
    return;
  }
  if (!alph_signal(ctx->node, ALPH_SIG_LINK, ctx->self, pid, 0, 0, 0)) {
    alph_signal_link_exit(ctx->node, pid, ctx->self, ALPH_NOPROC);  // it went in between
  }
}

// Removes the link with pid, both ways. Does nothing if there is none.
// Thread: a handler.
export fn alph_unlink(ctx: AlphCtx*, pid: int64) {
  var p: AlphProc* = alph_me(ctx);
  var at: int64 = alph_vec_find(&p->links, pid);
  if (at >= 0) {
    alph_vec_remove_at(&p->links, at);
    alph_signal_plain(ctx->node, ALPH_SIG_UNLINK, ctx->self, pid, 0);
  }
}

// Watches pid, one way. When it exits, an ALPH_TAG_DOWN message arrives with
// the returned ref and its exit reason in arg; if it is already gone, DOWN
// arrives with ALPH_NOPROC. Each call is a separate monitor.
// Returns the monitor's ref. Thread: a handler.
export fn alph_monitor(ctx: AlphCtx*, pid: int64) -> int64 {
  var ref: int64 = alph_new_ref(ctx->node);
  alph_hold_ref(alph_me(ctx), ref, pid);
  if (alph_resolve(ctx->node, pid) == 0) {
    alph_signal_down(ctx->node, pid, ctx->self, ref, ALPH_NOPROC);
  } else {
    if (!alph_signal(ctx->node, ALPH_SIG_MONITOR, ctx->self, pid, ref, 0, 0)) {
      alph_signal_down(ctx->node, pid, ctx->self, ref, ALPH_NOPROC);  // it went in between
    }
  }
  return ref;
}

// Stops a monitor. A DOWN for it that is already on its way is dropped.
//
//   ref  from alph_monitor
//
// Thread: a handler.
export fn alph_demonitor(ctx: AlphCtx*, ref: int64) {
  var pid: int64 = alph_take_ref(alph_me(ctx), ref);
  if (pid > 0) {
    alph_signal_plain(ctx->node, ALPH_SIG_DEMONITOR, ctx->self, pid, ref);
  }
}

// With on, exits of linked actors arrive as ALPH_TAG_EXIT messages (from =
// the linked actor, arg = its reason) instead of ending this actor. Kills
// still end it. Off by default. Thread: a handler.
export fn alph_trap_exits(ctx: AlphCtx*, on: bool) {
  var p: AlphProc* = alph_me(ctx);
  p->trap_exit = 0;
  if (on) {
    p->trap_exit = 1;
  }
}

// Sends an exit signal to pid, as erlang:exit/2. The target exits with
// reason unless it traps exits, in which case it gets an ALPH_TAG_EXIT
// message. ALPH_KILL cannot be trapped: the target exits with ALPH_KILLED.
// ALPH_NORMAL is ignored by an actor that does not trap exits.
// Thread: a handler. Outside the node, use alph_node_exit_signal.
export fn alph_exit_signal(ctx: AlphCtx*, pid: int64, reason: int64) {
  alph_signal(ctx->node, ALPH_SIG_EXIT, ctx->self, pid, 0, reason, 0);
}

// Sends an exit signal from outside the node, as alph_exit_signal; the
// message's from is 0. Thread: any.
export fn alph_node_exit_signal(node: AlphNode*, pid: int64, reason: int64) {
  alph_signal(node, ALPH_SIG_EXIT, 0, pid, 0, reason, 0);
}

// Ends this actor once the handler returns: `return alph_stop(ctx, reason);`
// Its links and monitors see reason. Returns ALPH_STOP. Thread: a handler.
export fn alph_stop(ctx: AlphCtx*, reason: int64) -> int64 {
  ctx->stop_reason = reason;
  return ALPH_STOP;
}

// Ends the running actor at once, from any call depth inside its handler,
// as if the handler had returned alph_stop(reason). Frames between here and
// the handler are abandoned: their defers do not run. The actor's heap is
// freed as on any exit. Use it for errors found deep in a call chain; a
// handler can just return alph_stop. Does nothing, and returns, when called
// outside a handler. Thread: a handler, at any depth.
export fn alph_exit_now(reason: int64) {
  var r: AlphRecover* = alph_recover_current();
  if (r == 0 || r->owner == 0) {
    return;
  }
  var s: AlphSched* = (AlphSched*)r->owner;
  s->exit_reason = reason;
  s->exit_request = 1;
  alph_recover_disarm(r);
  alph_recover_resume((int64)&r->regs[0]);
}

// The pid of the actor that spawned this one, or 0 when the node did.
// Thread: a handler.
export fn alph_parent(ctx: AlphCtx*) -> int64 {
  return alph_me(ctx)->parent;
}

// ---- timers ----------------------------------------------------------------

fn alph_timer_deadline(sig: int64) -> int64 {
  var s: AlphSignal* = (AlphSignal*)sig;
  return s->next;
}

fn alph_timers_swap(h: AlphVec*, a: int64, b: int64) {
  var t: int64 = alph_vec_get(h, a);
  alph_vec_set(h, a, alph_vec_get(h, b));
  alph_vec_set(h, b, t);
}

// Adds sig to the heap h. Returns false, having freed sig, when the heap
// cannot grow.
fn alph_timers_add(h: AlphVec*, sig: AlphSignal*) -> bool {
  if (!alph_vec_push(h, 0)) {
    free((rawptr)sig);
    return false;
  }
  var i: int64 = h->len - 1;
  // A typed store, so the memory analyser sees the timer kept.
  var slot: AlphSignal** = (AlphSignal**)(h->data + i * 8);
  *slot = sig;
  while (i > 0) {
    var parent: int64 = (i - 1) / 2;
    if (alph_timer_deadline(alph_vec_get(h, parent)) <= alph_timer_deadline(alph_vec_get(h, i))) {
      break;
    }
    alph_timers_swap(h, i, parent);
    i = parent;
  }
  return true;
}

fn alph_timers_pop(h: AlphVec*) -> AlphSignal* {
  var top: int64 = alph_vec_get(h, 0);
  alph_vec_remove_at(h, 0);
  var i: int64 = 0;
  while (true) {
    var left: int64 = i * 2 + 1;
    var right: int64 = left + 1;
    var least: int64 = i;
    if (left < h->len && alph_timer_deadline(alph_vec_get(h, left)) < alph_timer_deadline(alph_vec_get(h, least))) {
      least = left;
    }
    if (right < h->len && alph_timer_deadline(alph_vec_get(h, right)) < alph_timer_deadline(alph_vec_get(h, least))) {
      least = right;
    }
    if (least == i) {
      break;
    }
    alph_timers_swap(h, i, least);
    i = least;
  }
  return (AlphSignal*)top;
}

// Delivers a message with tag, ref and arg to `to` after ms milliseconds,
// from the caller's scheduler. A timer that carries a ref is dropped if the
// receiver stopped waiting on that ref.
// Returns the timer (an AlphSignal*), or 0 when out of memory.
fn alph_timer(ctx: AlphCtx*, ms: int64, to: int64, tag: int64, ref: int64, arg: int64) -> int64 {
  var sig: AlphSignal* = (AlphSignal*)malloc((int64)sizeof(AlphSignal));
  if (sig == 0) {
    return 0;
  }
  sig->dead = 0;
  sig->next = alph_now_ns() + ms * ALPH_NS_PER_MS;
  sig->kind = ALPH_SIG_TIMER;
  sig->from = ctx->self;
  sig->to = to;
  sig->ref = ref;
  sig->arg = arg;
  sig->tag = tag;
  sig->mark = 0;
  var at: int64 = (int64)sig;  // kept before the heap may take it
  if (!alph_timers_add(&alph_here(ctx)->timers, sig)) {
    return 0;
  }
  return at;
}

// Fires due timers. Returns nanoseconds until the next one, or -1 if none.
fn alph_timers_fire(node: AlphNode*, h: AlphVec*) -> int64 {
  var now: int64 = alph_now_ns();
  while (h->len > 0) {
    var wait: int64 = alph_timer_deadline(alph_vec_get(h, 0)) - now;
    if (wait > 0) {
      return wait;
    }
    var sig: AlphSignal* = alph_timers_pop(h);
    var p: AlphProc* = alph_resolve(node, sig->to);
    if (p == 0 || alph_atomic_load(&sig->dead) != 0) {
      free((rawptr)sig);
    } else {
      alph_queue_push(&p->signals, (rawptr)sig);
      alph_wake(node, p);
    }
  }
  return -1;
}

// Sets how many messages this actor's mailbox holds before senders get
// ALPH_FULL, in place of AlphConfig.mailbox_size. An actor many others talk
// to, such as one that owns a store, raises it; memory grows only with what
// is actually queued. Messages already queued stay.
//
//   limit  at least 1
//
// Thread: a handler.
export fn alph_mailbox_limit(ctx: AlphCtx*, limit: int64) {
  if (limit >= 1) {
    alph_mailbox_set_limit(&alph_me(ctx)->mailbox, limit);
  }
}

// Sets a hook the runtime calls once when this actor exits, before its
// links and monitors are told and its handles close: for state tied to the
// actor's life, such as counters, files or a lease to give back. It runs
// on every exit, crash included, except a kill (ALPH_KILL), which stays the
// hard stop. It gets a ctx like a handler's, with the actor's state, and
// the exit reason; it may send, but its own return value is ignored. A
// crash inside it ends only the hook. Not run when a medic gives up on its
// patient. Setting it again replaces it.
//
//   hook  fn(ctx, reason) -> int64
//
// Thread: a handler.
export fn alph_on_exit(ctx: AlphCtx*, hook: fn(AlphCtx*, int64) -> int64 with alloc, syscall, asm) {
  var p: AlphProc* = alph_me(ctx);
  p->on_exit = hook;
  p->has_on_exit = 1;
}

// Delivers tag and arg to this actor before any message already in its
// mailbox, as OTP's handle_continue: INIT can answer quickly and finish its
// setup next, before other work gets in. Signals (exits, timers) may still
// come first. Thread: a handler.
export fn alph_continue(ctx: AlphCtx*, tag: int64, arg: int64) {
  alph_signal(ctx->node, ALPH_SIG_TIMER, ctx->self, ctx->self, 0, arg, tag);
}

// Sheds requests by waiting time, as Facebook's adaptive CoDel does for RPC
// queues: once the requests this actor takes have waited longer than
// target_us continuously for interval_us, with the queue never emptying,
// it drops every one still above the target unhandled, so its queueing
// delay stays near target_us and its time goes to work that can still
// succeed. A dropped request is answered at once with ALPH_TAG_BUSY (ref =
// the request's, arg = how long it waited in us), and every drop counts in
// alph_node_stats' shed. While it drops, or while its waits are above the
// target and it has taken nothing for longer than that, alph_request to it
// returns ALPH_BUSY at once without sending (stats: refused), so turning
// requests away costs the overloaded actor nothing. Only requests are shed: plain sends need
// alph_mailbox_shed_casts, and replies, DOWN, TIMEOUT and EXIT messages
// never are. Senders stamp their messages with the time while this is on:
// one clock read per send. target_us 0 turns it off.
// For example alph_mailbox_shed(ctx, 5000, 100000): 5 ms, 100 ms.
// Thread: a handler.
export fn alph_mailbox_shed(ctx: AlphCtx*, target_us: int64, interval_us: int64) {
  var p: AlphProc* = alph_me(ctx);
  if (target_us <= 0) {
    p->shed_target = 0;
    p->shed_above = 0;
    p->shed_casts = 0;
    alph_atomic_store(&p->shed_state, ALPH_SHED_IDLE);
    alph_mailbox_stamp(&p->mailbox, false);
    return;
  }
  p->shed_target = target_us * 1000;
  p->shed_interval = interval_us * 1000;
  p->shed_above = 0;
  alph_mailbox_stamp(&p->mailbox, true);
}

// With on, alph_mailbox_shed also drops plain user messages (alph_send and
// friends) that waited too long, silently: a sender learns nothing, so use
// it only where losing a message is fine, such as telemetry or gossip.
// Off by default; alph_mailbox_shed(ctx, 0, 0) turns it off too.
// Thread: a handler.
export fn alph_mailbox_shed_casts(ctx: AlphCtx*, on: bool) {
  var p: AlphProc* = alph_me(ctx);
  if (on) {
    p->shed_casts = 1;
  } else {
    p->shed_casts = 0;
  }
}

// Sends a tag and one word to `to` after ms milliseconds. It cannot be
// cancelled; use alph_start_timer for that. Like every signal it is never
// dropped for a full mailbox. Thread: a handler.
export fn alph_send_after(ctx: AlphCtx*, ms: int64, to: int64, tag: int64, arg: int64) {
  alph_timer(ctx, ms, to, tag, 0, arg);  // no ref: it cannot be cancelled
}

// Starts a timer for this actor: after ms milliseconds a message with tag
// and arg arrives, its ref set to the returned value, unless
// alph_cancel_timer is called first. Returns the timer's ref.
// Thread: a handler.
export fn alph_start_timer(ctx: AlphCtx*, ms: int64, tag: int64, arg: int64) -> int64 {
  var ref: int64 = alph_new_ref(ctx->node);
  alph_hold_ref(alph_me(ctx), ref, 0);
  alph_hold_timer(alph_me(ctx), ref, alph_timer(ctx, ms, ctx->self, tag, ref, arg));
  return ref;
}

// Cancels a timer from alph_start_timer. Its message never arrives, even if
// it is already due. Cancelling twice, or after it arrived, does nothing.
// Thread: a handler.
export fn alph_cancel_timer(ctx: AlphCtx*, ref: int64) {
  alph_take_ref(alph_me(ctx), ref);
}

// ---- per-actor memory ------------------------------------------------------

// Allocates size bytes from this actor's own heap: 16-byte aligned, not
// zeroed, and only this actor's to use. No other actor shares the heap, so
// no lock is taken. Free it with alph_free, or leave it: everything is freed
// when the actor exits, even by a crash. Returns 0 when the heap limit
// (AlphConfig.heap_limit) would be passed or memory ran out.
// Thread: a handler.
export fn alph_alloc(ctx: AlphCtx*, size: int64) -> rawptr {
  return alph_heap_alloc(&alph_me(ctx)->heap, &alph_here(ctx)->pool, size);
}

// Frees memory from alph_alloc or alph_realloc on this actor's heap.
// Freeing 0 does nothing. Thread: a handler.
export fn alph_free(ctx: AlphCtx*, ptr: rawptr) {
  alph_heap_free(&alph_me(ctx)->heap, ptr);
}

// Resizes memory from alph_alloc, keeping its contents up to the smaller of
// the two sizes. ptr 0 allocates. Returns the new address, which may differ,
// or 0 when there is no room, in which case ptr is left as it was.
// Thread: a handler.
export fn alph_realloc(ctx: AlphCtx*, ptr: rawptr, size: int64) -> rawptr {
  if (ptr == 0) {
    return alph_alloc(ctx, size);
  }
  var have: int64 = alph_heap_size(ptr);
  if (size <= have) {
    return ptr;
  }
  var grown: rawptr = alph_alloc(ctx, size);
  if (grown == 0) {
    return (rawptr)0;
  }
  memcpy(grown, ptr, have);
  alph_free(ctx, ptr);
  return grown;
}

// Allocates size bytes that are valid until this handler call returns, then
// freed all at once at no cost. Use it for temporaries: parsing a request,
// building a reply. Do not keep the address. Returns 0 when memory ran out.
// Thread: a handler.
export fn alph_scratch(ctx: AlphCtx*, size: int64) -> rawptr {
  var s: AlphSched* = alph_here(ctx);
  return alph_scratch_alloc(&s->scratch, &s->pool, size);
}

// Bytes this actor's heap holds now, its state included.
// Thread: a handler.
export fn alph_heap_used(ctx: AlphCtx*) -> int64 {
  return alph_me(ctx)->heap.used;
}

// ---- spawning --------------------------------------------------------------

fn alph_slot_take(node: AlphNode*) -> int64 {
  alph_spin_lock(&node->free_lock);
  var index: int64 = -1;
  if (node->free_top > 0) {
    node->free_top = node->free_top - 1;
    var at: int64* = (int64*)(node->free_stack + node->free_top * 8);
    index = *at;
  }
  alph_spin_unlock(&node->free_lock);
  return index;
}

fn alph_slot_give(node: AlphNode*, index: int64) {
  alph_spin_lock(&node->free_lock);
  var at: int64* = (int64*)(node->free_stack + node->free_top * 8);
  *at = index;
  node->free_top = node->free_top + 1;
  alph_spin_unlock(&node->free_lock);
}

// Spawns an actor whose state starts as a copy of size bytes at state, and
// sends it INIT. parent is the spawning pid, or 0. A link to the parent and
// a monitor by it (monitor_ref non-zero) are in place before the actor can
// run, so even a crash in INIT reaches them. patient is set for a medic.
// Returns the pid, or 0 when the node is full or out of memory.
fn alph_spawn_raw(node: AlphNode*, parent: int64, flags: int64, monitor_ref: int64,
                  patient: int64, init_arg: int64, state: rawptr, size: int64,
                  handler: fn(AlphCtx*, AlphMsg*) -> int64 with alloc, syscall, asm) -> int64 {
  var index: int64 = alph_slot_take(node);
  if (index < 0) {
    return 0;
  }
  var p: AlphProc* = alph_slot(node, index);
  // Reopen the slot's signal queue; a late drainer of the previous owner
  // finishes first, and none starts after this.
  while (alph_atomic_cas(&p->drain_lock, 0, 1) != 0) {
    alph_cpu_relax();
  }
  alph_atomic_store(&p->sig_closed, 0);
  alph_atomic_store_sc(&p->drain_lock, 0);
  if (p->inited == 0) {
    if (!alph_mailbox_init(&p->mailbox, node->mailbox_size)) {
      alph_slot_give(node, index);
      return 0;
    }
    alph_queue_init(&p->signals);
    p->index = index;
    p->inited = 1;
  }
  alph_mailbox_set_limit(&p->mailbox, node->mailbox_size);
  p->shed_target = 0;
  p->shed_above = 0;
  p->shed_casts = 0;
  p->shed_state = ALPH_SHED_IDLE;
  alph_mailbox_stamp(&p->mailbox, false);
  p->has_on_exit = 0;
  // Leftovers sent to the previous owner of the slot are dropped.
  var stale: AlphMsg;
  while (alph_mailbox_pop(&p->mailbox, &stale)) {
    alph_msg_release(&stale);
  }
  var link: bool = (flags & ALPH_LINK) != 0 && parent != 0;
  if ((flags & ALPH_BOUND) != 0) {
    var own: AlphSched* = alph_sched_bound(node);
    if (own == 0) {
      alph_slot_give(node, index);
      return 0;
    }
    p->sched = (int64)own;
  } else {
    // A spawned actor starts on its parent's scheduler, as on BEAM, so
    // actors that talk to each other stay together; work sharing spreads
    // them when other schedulers go idle. Top-level actors, and children of
    // bound actors, are placed round-robin.
    var home: AlphProc* = alph_resolve(node, parent);
    if (home != 0 && ((AlphSched*)home->sched)->bound == 0) {
      p->sched = home->sched;
    } else {
      var n: int64 = alph_atomic_load(&node->active);
      if (n < 1) {
        n = 1;
      }
      var next: int64 = alph_atomic_add(&node->next_sched, 1) % n;
      p->sched = (int64)alph_sched_at(node, next);
    }
  }
  alph_heap_init(&p->heap, node->heap_limit);
  if (!alph_set_state(node, p, state, size)) {
    alph_heap_clear(node, p);
    alph_sched_finish(p);
    alph_slot_give(node, index);
    return 0;
  }
  p->serial = p->serial + 1;
  p->parent = parent;
  p->trap_exit = 0;
  p->handled = 0;
  p->handler = handler;
  p->links.len = 0;
  p->mon_refs.len = 0;
  p->mon_watchers.len = 0;
  p->ref_ids.len = 0;
  p->ref_pids.len = 0;
  p->ref_timers.len = 0;
  p->deferred.len = 0;
  p->io_handles.len = 0;
  p->flushq.len = 0;
  p->names.len = 0;
  p->groups.len = 0;
  p->medic = 0;
  p->patient = patient;
  p->poison_heap = 0;
  p->retry = 0;
  p->proxy = 0;
  if ((flags & ALPH_PROXY) != 0) {
    // A proxy traps exits from birth: a kill sent before its INIT runs
    // must still be passed on, not end it.
    p->proxy = 1;
    p->trap_exit = 1;
  }
  if (link) {
    alph_vec_push(&p->links, parent);
  }
  if (monitor_ref != 0) {
    alph_vec_push(&p->mon_refs, monitor_ref);
    alph_vec_push(&p->mon_watchers, parent);
  }
  var pid: int64 = (p->serial << 32) | (index + 1);
  alph_atomic_add(&node->live, 1);
  alph_atomic_add(&node->spawned, 1);
  alph_atomic_store(&p->status, ALPH_P_IDLE);
  p->fresh = 1;
  alph_atomic_store_sc(&p->pid, pid);
  alph_send_raw(node, parent, pid, ALPH_TAG_INIT, init_arg, (rawptr)0, 0);
  return pid;
}

fn alph_spawn_from(ctx: AlphCtx*, flags: int64, init_arg: int64, state: rawptr, size: int64,
                   handler: fn(AlphCtx*, AlphMsg*) -> int64 with alloc, syscall, asm) -> int64 {
  var link: bool = (flags & ALPH_LINK) != 0;
  var ref: int64 = 0;
  if ((flags & ALPH_MONITOR) != 0) {
    ref = alph_new_ref(ctx->node);
  }
  var pid: int64 = alph_spawn_raw(ctx->node, ctx->self, flags, ref, 0, init_arg, state, size, handler);
  if (pid == 0) {
    return 0;
  }
  var p: AlphProc* = alph_me(ctx);
  if (link) {
    alph_vec_push(&p->links, pid);
  }
  if (ref != 0) {
    alph_hold_ref(p, ref, pid);
  }
  return pid;
}

// Spawns an actor with no state.
//
//   flags    0, or any of ALPH_LINK, ALPH_MONITOR and ALPH_BOUND. A link
//            and a monitor are set up before the new actor runs, so even a
//            crash in its INIT reaches the caller; with ALPH_MONITOR its
//            DOWN arrives with from = the new pid. ALPH_BOUND gives the new
//            actor a thread of its own, so its handler may block (file IO,
//            fsync, a long computation) without holding up other actors.
//   handler  the new actor's handler; its first message is ALPH_TAG_INIT
//
// Returns the new pid, or 0 when the node is full (max_actors) or out of
// memory. Thread: a handler. Outside the node, use alph_node_spawn.
export fn alph_spawn(ctx: AlphCtx*, flags: int64,
                     handler: fn(AlphCtx*, AlphMsg*) -> int64 with alloc, syscall, asm) -> int64 {
  return alph_spawn_from(ctx, flags, 0, (rawptr)0, 0, handler);
}

// Spawns an actor whose state starts as a copy of *state. The handler reads
// it as (T*)ctx->state. Otherwise as alph_spawn. Thread: a handler.
export fn alph_spawn_value<T>(ctx: AlphCtx*, flags: int64, state: T*,
                              handler: fn(AlphCtx*, AlphMsg*) -> int64 with alloc, syscall, asm) -> int64 {
  return alph_spawn_from(ctx, flags, 0, (rawptr)state, (int64)sizeof(T), handler);
}

// Spawns an actor whose state starts as a copy of size bytes at state.
// Otherwise as alph_spawn. Thread: a handler.
export fn alph_spawn_bytes(ctx: AlphCtx*, flags: int64, state: rawptr, size: int64,
                           handler: fn(AlphCtx*, AlphMsg*) -> int64 with alloc, syscall, asm) -> int64 {
  return alph_spawn_from(ctx, flags, 0, state, size, handler);
}

// Spawns an actor whose INIT message carries arg, so it can tell how it was
// started. Supervisors pass the number of times the child was started
// before: 0 the first time, more on a restart. Otherwise as
// alph_spawn_bytes. Thread: a handler.
export fn alph_spawn_bytes_arg(ctx: AlphCtx*, flags: int64, state: rawptr, size: int64, arg: int64,
                               handler: fn(AlphCtx*, AlphMsg*) -> int64 with alloc, syscall, asm) -> int64 {
  return alph_spawn_from(ctx, flags, arg, state, size, handler);
}

// Spawns an actor with no state from outside the node. It has no parent: its
// INIT comes from 0 and nothing is linked to it.
//
//   flags  0, or ALPH_BOUND for an actor with a thread of its own
//
// Returns the new pid, or 0. Thread: any.
export fn alph_node_spawn(node: AlphNode*, flags: int64,
                          handler: fn(AlphCtx*, AlphMsg*) -> int64 with alloc, syscall, asm) -> int64 {
  return alph_root_add(node, alph_spawn_raw(node, 0, flags & ALPH_BOUND, 0, 0, 0, (rawptr)0, 0, handler));
}

// Spawns an actor whose state starts as a copy of *state, from outside the
// node. Otherwise as alph_node_spawn. Thread: any.
export fn alph_node_spawn_value<T>(node: AlphNode*, flags: int64, state: T*,
                                   handler: fn(AlphCtx*, AlphMsg*) -> int64 with alloc, syscall, asm) -> int64 {
  return alph_root_add(node, alph_spawn_raw(node, 0, flags & ALPH_BOUND, 0, 0, 0, (rawptr)state, (int64)sizeof(T), handler));
}

// Spawns an actor whose state starts as a copy of size bytes at state, from
// outside the node. Otherwise as alph_node_spawn. Thread: any.
export fn alph_node_spawn_bytes(node: AlphNode*, flags: int64, state: rawptr, size: int64,
                                handler: fn(AlphCtx*, AlphMsg*) -> int64 with alloc, syscall, asm) -> int64 {
  return alph_root_add(node, alph_spawn_raw(node, 0, flags & ALPH_BOUND, 0, 0, 0, state, size, handler));
}

// ---- exiting ---------------------------------------------------------------

// Tells everyone who cares that p exited, and frees what p owned.
// Runs p's exit hook, if it has one, on its own scheduler s before anything
// else of the exit happens. A crash, or alph_exit_now, inside the hook ends
// the hook only; the exit goes on.
fn alph_run_exit_hook(s: AlphSched*, p: AlphProc*, reason: int64) {
  p->has_on_exit = 0;  // at most once, even if it crashes
  s->exiting = (int64)p;
  var r: AlphRecover* = &s->thread.recover;
  alph_recover_arm(r);
  if (alph_recover_save(&r->regs[0]) != 0) {
    // s was set before the save and never reassigned, so the restored
    // registers still hold it.
    s->exiting = 0;
    s->exit_request = 0;
    alph_scratch_reset(&s->scratch, &s->pool);
    return;
  }
  var ctx: AlphCtx;
  ctx.self = p->pid;
  ctx.state = (rawptr)p->state;
  ctx.state_size = p->state_size;
  ctx.node = (AlphNode*)s->node;
  ctx.proc = (int64)p;
  ctx.sched = (int64)s;
  ctx.stop_reason = ALPH_NORMAL;
  p->on_exit(&ctx, reason);
  alph_recover_disarm(r);
  s->exiting = 0;
  alph_scratch_reset(&s->scratch, &s->pool);
}

fn alph_proc_exit(node: AlphNode*, p: AlphProc*, reason: int64) {
  alph_atomic_store(&p->status, ALPH_P_EXITING);
  if (p->has_on_exit != 0) {
    if (reason == ALPH_KILLED) {
      p->has_on_exit = 0;  // a kill is the hard stop: no hook
    } else {
      alph_run_exit_hook((AlphSched*)p->sched, p, reason);
    }
  }
  var pid: int64 = p->pid;
  alph_atomic_store_sc(&p->pid, 0);
  if (reason == ALPH_CRASHED) {
    alph_atomic_add(&node->crashed, 1);
  }

  // Handles close (children are killed and reaped) before anyone is told.
  for i: int64 in 0..p->io_handles.len {
    alph_io_drop(node, alph_vec_get(&p->io_handles, i), pid);
  }
  for i: int64 in 0..p->links.len {
    alph_signal_link_exit(node, pid, alph_vec_get(&p->links, i), reason);
  }
  for i: int64 in 0..p->mon_refs.len {
    alph_signal_down(node, pid, alph_vec_get(&p->mon_watchers, i), alph_vec_get(&p->mon_refs, i), reason);
  }
  // A link or monitor that arrived too late is answered as if p had been gone.
  var sig: int64 = alph_queue_pop(&p->signals);
  while (sig != 0) {
    alph_answer_gone(node, (AlphSignal*)sig);
    free((rawptr)sig);
    sig = alph_queue_pop(&p->signals);
  }
  // Close the queue: a sender that resolved pid before it was cleared and
  // pushes from now on answers its own signal (alph_signal). Then drain once
  // more for the pushes that landed in between.
  alph_atomic_store_sc(&p->sig_closed, 1);
  alph_drain_late(node, p);
  alph_names_drop(node, p, pid);
  for i: int64 in 0..p->deferred.len {
    free((rawptr)alph_vec_get(&p->deferred, i));
  }
  if (p->poison_heap != 0) {
    free((rawptr)p->poison_heap);
    p->poison_heap = 0;
  }
  // A medic that exits leaves its patient unwatched; one held after a crash
  // has nobody left to repair it, so it exits as the crash would have.
  if (p->patient != 0) {
    var patient: AlphProc* = alph_resolve(node, p->patient);
    if (patient != 0 && alph_atomic_cas(&patient->medic, pid, 0) == pid) {
      if (alph_atomic_cas(&patient->status, ALPH_P_CRASHED, ALPH_P_EXITING) == ALPH_P_CRASHED) {
        patient->has_on_exit = 0;  // its home may be another thread: no hook
        alph_proc_exit(node, patient, ALPH_CRASHED);
      }
    }
  }
  var m: AlphMsg;
  while (alph_mailbox_pop(&p->mailbox, &m)) {
    alph_msg_release(&m);
  }
  alph_heap_clear(node, p);
  alph_vec_release(&p->links);
  alph_vec_release(&p->mon_refs);
  alph_vec_release(&p->mon_watchers);
  alph_vec_release(&p->ref_ids);
  alph_vec_release(&p->ref_pids);
  alph_vec_release(&p->ref_timers);
  alph_vec_release(&p->deferred);
  alph_vec_release(&p->io_handles);
  alph_vec_release(&p->groups);
  alph_vec_release(&p->names);
  alph_sched_finish(p);
  alph_atomic_store(&p->status, ALPH_P_FREE);
  alph_slot_give(node, p->index);
  alph_atomic_add(&node->live, -1);
}

// ---- names and groups ------------------------------------------------------

fn alph_entry_is(e: AlphEntry*, name: string) -> bool {
  if (e->len != (int64)name.length) {
    return false;
  }
  return memcmp((rawptr)e->chars, (rawptr)name.chars, e->len) == 0;
}

// FNV-1a style over the name's bytes, in 64-bit arithmetic with constants
// that fit Mettle's 32-bit literals, then the high bits folded down so the
// table's low-bit mask sees them.
fn alph_name_hash(name: string) -> int64 {
  var h: int64 = (int64)1469598103;
  for i: int64 in 0..(int64)name.length {
    h = (h ^ (int64)name.chars[i]) * (int64)16777619;
  }
  return h ^ (h >> 29) ^ (h >> 47);
}

fn alph_tab_init(t: AlphTable*) -> bool {
  t->block = (int64)calloc(65, 8);
  if (t->block == 0) {
    return false;
  }
  *(int64*)t->block = 63;
  t->count = 0;
  t->seq = 0;
  return true;
}

fn alph_tab_head(t: AlphTable*, hash: int64) -> int64* {
  var block: int64 = t->block;
  return (int64*)(block + 8 + (hash & *(int64*)block) * 8);
}

// The entry called name, or 0.
fn alph_tab_find(t: AlphTable*, name: string) -> AlphEntry* {
  var h: int64 = alph_name_hash(name);
  var e: AlphEntry* = (AlphEntry*)*alph_tab_head(t, h);
  while (e != 0) {
    if (e->hash == h && alph_entry_is(e, name)) {
      return e;
    }
    e = (AlphEntry*)e->next;
  }
  return (AlphEntry*)0;
}

// Adds e, whose hash is set. Doubles the table past 3/4 full; if that
// allocation fails the chains just grow longer.
fn alph_tab_add(node: AlphNode*, t: AlphTable*, e: AlphEntry*) {
  var old: int64 = t->block;
  var mask: int64 = *(int64*)old;
  if (t->count * 4 >= (mask + 1) * 3) {
    var size: int64 = (mask + 1) * 2;
    var block: int64 = (int64)calloc(size + 1, 8);
    if (block != 0) {
      *(int64*)block = size - 1;
      alph_atomic_add(&t->seq, 1);  // odd: readers retry
      for i: int64 in 0..mask + 1 {
        var c: AlphEntry* = (AlphEntry*)*(int64*)(old + 8 + i * 8);
        while (c != 0) {
          var next: int64 = c->next;
          var at: int64* = (int64*)(block + 8 + (c->hash & (size - 1)) * 8);
          c->next = *at;
          *at = (int64)c;
          c = (AlphEntry*)next;
        }
      }
      alph_atomic_store(&t->block, block);
      alph_atomic_add(&t->seq, 1);  // even again
      alph_retire(node, old | 1);
    }
  }
  var head: int64* = alph_tab_head(t, e->hash);
  e->next = *head;
  // e is complete before it is linked: x86 keeps these stores in order.
  alph_atomic_store(head, (int64)e);
  t->count = t->count + 1;
}

// Collects the live holders of key into out, at most cap of them, and
// returns how many there are in all. With quiet true it takes no lock and
// returns -1 when a resize got in the way; the caller then locks and calls
// it again. With quiet false the caller holds the registry's lock.
fn alph_reg_collect(node: AlphNode*, r: AlphReg*, key: string, out: AlphRegEntry*, cap: int64,
                    quiet: bool) -> int64 {
  var t: AlphTable* = &r->table;
  var seq: int64 = alph_atomic_load(&t->seq);
  if (quiet && (seq & 1) != 0) {
    return -1;
  }
  var h: int64 = alph_name_hash(key);
  var e: AlphEntry* = (AlphEntry*)alph_atomic_load(alph_tab_head(t, h));
  var n: int64 = 0;
  var steps: int64 = 0;
  var limit: int64 = alph_atomic_load(&t->count) + 64;
  while (e != 0) {
    if (e->hash == h && alph_entry_is(e, key)) {
      var pid: int64 = alph_atomic_load(&e->pid);
      if (pid != 0 && alph_resolve(node, pid) != 0) {
        if (n < cap) {
          out[n].pid = pid;
          out[n].value = alph_atomic_load(&e->value);
        }
        n = n + 1;
      }
    }
    e = (AlphEntry*)alph_atomic_load(&e->next);
    steps = steps + 1;
    if (quiet && steps > limit) {
      return -1;  // a resize relinked the chains under us
    }
  }
  if (quiet && alph_atomic_load(&t->seq) != seq) {
    return -1;
  }
  return n;
}

// As alph_reg_collect, quiet when the caller may be (a handler on a shared
// scheduler), else, or after a failed quiet try, under the lock.
fn alph_reg_find(ctx: AlphCtx*, node: AlphNode*, r: AlphReg*, key: string, out: AlphRegEntry*,
                 cap: int64) -> int64 {
  if (ctx != 0 && ((AlphSched*)ctx->sched)->bound == 0) {
    var n: int64 = alph_reg_collect(node, r, key, out, cap, true);
    if (n >= 0) {
      return n;
    }
  }
  alph_spin_lock(&r->lock);
  var m: int64 = alph_reg_collect(node, r, key, out, cap, false);
  alph_spin_unlock(&r->lock);
  return m;
}

fn alph_reg_make(kind: int64) -> AlphReg* {
  var r: AlphReg* = (AlphReg*)calloc(1, (int64)sizeof(AlphReg));
  if (r == 0) {
    return r;
  }
  r->kind = kind;
  if (!alph_tab_init(&r->table)) {
    free((rawptr)r);
    return (AlphReg*)0;
  }
  return r;
}

// Unlinks e. Its next stays, so a reader standing on it walks on.
fn alph_tab_remove(t: AlphTable*, e: AlphEntry*) {
  var link: int64* = alph_tab_head(t, e->hash);
  while (*link != 0) {
    if (*link == (int64)e) {
      alph_atomic_store(link, e->next);
      t->count = t->count - 1;
      return;
    }
    link = &((AlphEntry*)*link)->next;
  }
}

// A new entry holding a copy of name, or 0 when memory runs out.
fn alph_entry_new(name: string) -> AlphEntry* {
  var e: AlphEntry* = (AlphEntry*)calloc(1, (int64)sizeof(AlphEntry));
  if (e == 0) {
    return e;
  }
  e->len = (int64)name.length;
  e->chars = (int64)malloc(e->len + 1);
  if (e->chars == 0) {
    free((rawptr)e);
    return (AlphEntry*)0;
  }
  memcpy((rawptr)e->chars, (rawptr)name.chars, e->len);
  e->hash = alph_name_hash(name);
  return e;
}

fn alph_entry_free(e: AlphEntry*) {
  free((rawptr)e->chars);
  alph_vec_release(&e->members);
  free((rawptr)e);
}

// Removes pid from group g, and g from the node once nobody is left in it.
// Called with names_lock held.
fn alph_group_remove(node: AlphNode*, g: AlphEntry*, pid: int64) {
  var at: int64 = alph_vec_find(&g->members, pid);
  if (at >= 0) {
    alph_vec_remove_at(&g->members, at);
  }
  if (g->members.len == 0) {
    alph_tab_remove((AlphTable*)node->groups, g);
    alph_entry_free(g);
  }
}

// Drops the names and group places of an exiting actor.
fn alph_names_drop(node: AlphNode*, p: AlphProc*, pid: int64) {
  if (p->names.len == 0 && p->groups.len == 0) {
    return;
  }
  for i: int64 in 0..p->names.len {
    var e: AlphEntry* = (AlphEntry*)alph_vec_get(&p->names, i);
    var r: AlphReg* = (AlphReg*)e->reg;
    alph_spin_lock(&r->lock);
    if (e->pid == pid) {
      alph_tab_remove(&r->table, e);
    }
    alph_spin_unlock(&r->lock);
    alph_retire(node, (int64)e);  // still ours, or taken over and already out of the table
  }
  p->names.len = 0;
  if (p->groups.len == 0) {
    return;
  }
  alph_spin_lock(&node->names_lock);
  for i: int64 in 0..p->groups.len {
    alph_group_remove(node, (AlphEntry*)alph_vec_get(&p->groups, i), pid);
  }
  p->groups.len = 0;
  alph_spin_unlock(&node->names_lock);
}

// ---- registries --------------------------------------------------------------

// Makes a registry: a table of keys held by actors, each holder with a
// value, like Elixir's Registry. Lookups from handlers take no lock and
// never wait for a writer; a holder's keys are dropped when it exits, crash
// included, before its links and monitors are told.
//
//   kind  ALPH_REG_UNIQUE: a key has at most one holder (names, sessions);
//         ALPH_REG_DUPLICATE: any number (subscribers, roles)
//
// Returns the registry, to pass to the alph_reg_ functions, or 0 when out
// of memory. A registry lives as long as the node. Thread: any.
export fn alph_node_reg_new(node: AlphNode*, kind: int64) -> int64 {
  return (int64)alph_reg_make(kind);
}

// Registers key for the calling actor with value, in registry reg. The key
// is copied. In a unique registry it fails when another live actor holds
// key, and succeeds without change when the caller already does; in a
// duplicate one every call adds an entry, so an actor may hold a key twice.
//
// Returns true when registered, false when taken, key is empty, or memory
// runs out. Thread: a handler.
export fn alph_reg_register(ctx: AlphCtx*, reg: int64, key: string, value: int64) -> bool {
  if (key.length == 0) {
    return false;
  }
  var node: AlphNode* = ctx->node;
  var r: AlphReg* = (AlphReg*)reg;
  var t: AlphTable* = &r->table;
  var ok: bool = true;
  alph_spin_lock(&r->lock);
  var old: AlphEntry* = (AlphEntry*)0;
  if (r->kind == ALPH_REG_UNIQUE) {
    old = alph_tab_find(t, key);
    if (old != 0 && old->pid == ctx->self) {
      alph_spin_unlock(&r->lock);
      return true;
    }
    // A holder that is exiting still has its entry for a moment; its own
    // exit frees the entry, so it is only taken out of the table here.
    if (old != 0 && alph_resolve(node, old->pid) != 0) {
      alph_spin_unlock(&r->lock);
      return false;
    }
  }
  var e: AlphEntry* = alph_entry_new(key);
  if (e == 0 || !alph_vec_push(&alph_me(ctx)->names, (int64)e)) {
    if (e != 0) {
      alph_entry_free(e);
    }
    ok = false;
  } else {
    if (old != 0) {
      alph_tab_remove(t, old);
      alph_atomic_store(&old->pid, 0);
    }
    e->pid = ctx->self;
    e->value = value;
    e->reg = reg;
    alph_tab_add(node, t, e);
  }
  alph_spin_unlock(&r->lock);
  return ok;
}

// Drops every entry the calling actor holds for key in reg; does nothing
// when it holds none. Thread: a handler.
export fn alph_reg_unregister(ctx: AlphCtx*, reg: int64, key: string) {
  var node: AlphNode* = ctx->node;
  var r: AlphReg* = (AlphReg*)reg;
  var p: AlphProc* = alph_me(ctx);
  alph_spin_lock(&r->lock);
  var i: int64 = p->names.len;
  while (i > 0) {
    i = i - 1;
    var e: AlphEntry* = (AlphEntry*)alph_vec_get(&p->names, i);
    if (e->reg == reg && e->pid == ctx->self && alph_entry_is(e, key)) {
      alph_tab_remove(&r->table, e);
      alph_vec_remove_at(&p->names, i);
      alph_retire(node, (int64)e);
    }
  }
  alph_spin_unlock(&r->lock);
}

// Sets the value of every entry the calling actor holds for key in reg.
// Returns false when it holds none. Thread: a handler.
export fn alph_reg_update(ctx: AlphCtx*, reg: int64, key: string, value: int64) -> bool {
  var p: AlphProc* = alph_me(ctx);
  var found: bool = false;
  for i: int64 in 0..p->names.len {
    var e: AlphEntry* = (AlphEntry*)alph_vec_get(&p->names, i);
    if (e->reg == reg && e->pid == ctx->self && alph_entry_is(e, key)) {
      alph_atomic_store(&e->value, value);
      found = true;
    }
  }
  return found;
}

// The holders of key in reg: copies up to cap of them into out and returns
// how many there are, which may be more than cap. Each may exit at any
// time after. Takes no lock. Thread: a handler.
export fn alph_reg_lookup(ctx: AlphCtx*, reg: int64, key: string, out: AlphRegEntry*, cap: int64) -> int64 {
  return alph_reg_find(ctx, ctx->node, (AlphReg*)reg, key, out, cap);
}

// The holder of key in reg (the first one, in a duplicate registry), or 0.
// Takes no lock. Thread: a handler.
export fn alph_reg_whereis(ctx: AlphCtx*, reg: int64, key: string) -> int64 {
  var one: AlphRegEntry;
  if (alph_reg_find(ctx, ctx->node, (AlphReg*)reg, key, &one, 1) <= 0) {
    return 0;
  }
  return one.pid;
}

// Holders of key with value & mask != 0, gathered into scratch memory.
// Returns how many, with *out set to them. mask -1 takes every holder.
fn alph_reg_gather(ctx: AlphCtx*, reg: int64, key: string, mask: int64, out: AlphRegEntry**) -> int64 {
  var cap: int64 = 32;
  while (true) {
    var buf: AlphRegEntry* = (AlphRegEntry*)alph_scratch(ctx, cap * (int64)sizeof(AlphRegEntry));
    if (buf == 0) {
      return 0;
    }
    var n: int64 = alph_reg_find(ctx, ctx->node, (AlphReg*)reg, key, buf, cap);
    if (n <= cap) {
      var kept: int64 = 0;
      for i: int64 in 0..n {
        if ((buf[i].value & mask) != 0 || mask == -1) {
          buf[kept] = buf[i];
          kept = kept + 1;
        }
      }
      *out = buf;
      return kept;
    }
    cap = n + n / 4;
  }
  return 0;
}

// Sends a tag and one word to every holder of key in reg, each as
// alph_send, with no lock held while sending. Returns how many got it, or
// ALPH_GONE when key has no holder. Thread: a handler.
export fn alph_reg_send(ctx: AlphCtx*, reg: int64, key: string, tag: int64, arg: int64) -> int64 {
  return alph_reg_dispatch(ctx, reg, key, -1, tag, arg);
}

// As alph_reg_send, but only to holders whose value has a bit of mask set,
// so a value can carry roles or interests (Elixir's dispatch). mask -1
// reaches every holder. Returns how many got it, or ALPH_GONE when none
// matched. Thread: a handler.
export fn alph_reg_dispatch(ctx: AlphCtx*, reg: int64, key: string, mask: int64, tag: int64,
                            arg: int64) -> int64 {
  var to: AlphRegEntry* = (AlphRegEntry*)0;
  var n: int64 = alph_reg_gather(ctx, reg, key, mask, &to);
  if (n == 0) {
    return ALPH_GONE;
  }
  var sent: int64 = 0;
  for i: int64 in 0..n {
    if (alph_send_raw(ctx->node, ctx->self, to[i].pid, tag, arg, (rawptr)0, 0) == ALPH_SENT) {
      sent = sent + 1;
    }
  }
  return sent;
}

// Entries in reg: one per holder per key, roughly while actors come and
// go. Thread: any.
export fn alph_node_reg_count(node: AlphNode*, reg: int64) -> int64 {
  return alph_atomic_load(&((AlphReg*)reg)->table.count);
}

// ---- the default registry: names -------------------------------------------

// Registers name for the calling actor, so others can find it with
// alph_whereis. An actor may hold several names. The name is copied; it is
// dropped when the actor exits, crash included, or by alph_unregister.
//
// Returns true when the name is now the caller's (also when it already
// was), false when another live actor holds it, name is empty, or memory
// runs out. Thread: a handler.
export fn alph_register(ctx: AlphCtx*, name: string) -> bool {
  return alph_reg_register(ctx, ctx->node->names, name, 0);
}

// Drops name if the calling actor holds it; otherwise does nothing.
// Thread: a handler.
export fn alph_unregister(ctx: AlphCtx*, name: string) {
  alph_reg_unregister(ctx, ctx->node->names, name);
}

// The pid registered as name, or 0 when there is none. The actor may exit
// at any time after, so a send to the pid can still return ALPH_GONE.
// Thread: any.
export fn alph_node_whereis(node: AlphNode*, name: string) -> int64 {
  var one: AlphRegEntry;
  if (alph_reg_find((AlphCtx*)0, node, (AlphReg*)node->names, name, &one, 1) <= 0) {
    return 0;
  }
  return one.pid;
}

// The pid registered as name, or 0; as alph_node_whereis, but from a
// handler it takes no lock. Thread: a handler.
export fn alph_whereis(ctx: AlphCtx*, name: string) -> int64 {
  return alph_reg_whereis(ctx, ctx->node->names, name);
}

// Adds the calling actor to the process group called group, creating the
// group if needed. The name is copied. The actor leaves when it exits,
// crash included, or by alph_group_leave; a group with no members is gone.
//
// Returns true when the caller is a member (also when it already was),
// false when group is empty or memory runs out. Thread: a handler.
export fn alph_group_join(ctx: AlphCtx*, group: string) -> bool {
  if (group.length == 0) {
    return false;
  }
  var node: AlphNode* = ctx->node;
  var p: AlphProc* = alph_me(ctx);
  var t: AlphTable* = (AlphTable*)node->groups;
  var ok: bool = true;
  alph_spin_lock(&node->names_lock);
  var g: AlphEntry* = alph_tab_find(t, group);
  if (g == 0) {
    g = alph_entry_new(group);
    if (g != 0) {
      alph_tab_add(node, t, g);
    }
  }
  if (g == 0) {
    ok = false;
  } else if (alph_vec_find(&p->groups, (int64)g) < 0) {
    if (!alph_vec_push(&g->members, ctx->self)) {
      ok = false;
    } else if (!alph_vec_push(&p->groups, (int64)g)) {
      alph_vec_remove_at(&g->members, g->members.len - 1);
      ok = false;
    }
    if (!ok && g->members.len == 0) {
      alph_group_remove(node, g, ctx->self);
    }
  }
  alph_spin_unlock(&node->names_lock);
  return ok;
}

// Takes the calling actor out of group; does nothing if it is not a
// member. Thread: a handler.
export fn alph_group_leave(ctx: AlphCtx*, group: string) {
  var node: AlphNode* = ctx->node;
  var p: AlphProc* = alph_me(ctx);
  alph_spin_lock(&node->names_lock);
  for i: int64 in 0..p->groups.len {
    var g: AlphEntry* = (AlphEntry*)alph_vec_get(&p->groups, i);
    if (alph_entry_is(g, group)) {
      alph_vec_remove_at(&p->groups, i);
      alph_group_remove(node, g, ctx->self);
      break;
    }
  }
  alph_spin_unlock(&node->names_lock);
}

// How many actors are in group now; 0 when there is no such group.
// Thread: any.
export fn alph_node_group_size(node: AlphNode*, group: string) -> int64 {
  var n: int64 = 0;
  alph_spin_lock(&node->names_lock);
  var g: AlphEntry* = alph_tab_find((AlphTable*)node->groups, group);
  if (g != 0) {
    n = g->members.len;
  }
  alph_spin_unlock(&node->names_lock);
  return n;
}

// Sends to every member of group, the caller too if it is one. The member
// list is copied first, so the lock is not held while sending.
// Sends to every member, from `from`. The member list is copied under the
// lock into scratch memory (a handler's) or a malloc'd block (outside).
fn alph_group_send_from(node: AlphNode*, ctx: AlphCtx*, from: int64, group: string, tag: int64,
                        arg: int64, data: rawptr, size: int64) -> int64 {
  var pids: int64* = (int64*)0;
  var n: int64 = 0;
  alph_spin_lock(&node->names_lock);
  var g: AlphEntry* = alph_tab_find((AlphTable*)node->groups, group);
  if (g != 0) {
    if (g->members.len > 0) {
      if (ctx != 0) {
        pids = (int64*)alph_scratch(ctx, g->members.len * 8);
      } else {
        pids = (int64*)malloc(g->members.len * 8);
      }
    }
    if (pids != 0) {
      n = g->members.len;
      memcpy((rawptr)pids, (rawptr)g->members.data, n * 8);
    }
  }
  alph_spin_unlock(&node->names_lock);
  var sent: int64 = 0;
  for i: int64 in 0..n {
    if (alph_send_raw(node, from, pids[i], tag, arg, data, size) == ALPH_SENT) {
      sent = sent + 1;
    }
  }
  if (ctx == 0 && pids != 0) {
    free((rawptr)pids);
  }
  return sent;
}

fn alph_group_send_raw(ctx: AlphCtx*, group: string, tag: int64, arg: int64,
                       data: rawptr, size: int64) -> int64 {
  return alph_group_send_from(ctx->node, ctx, ctx->self, group, tag, arg, data, size);
}

// Sends a tag and one word to every member of group from outside the node,
// with from = 0, each as alph_node_send. Returns how many members got it; a
// full mailbox or an exited member is skipped. Thread: any.
export fn alph_node_group_send(node: AlphNode*, group: string, tag: int64, arg: int64) -> int64 {
  return alph_group_send_from(node, (AlphCtx*)0, 0, group, tag, arg, (rawptr)0, 0);
}

// Sends a tag and one word to every member of group, the caller too if it
// is one, each as alph_send. Returns how many members got it; a full
// mailbox or an exited member is skipped. Thread: a handler.
export fn alph_group_send(ctx: AlphCtx*, group: string, tag: int64, arg: int64) -> int64 {
  return alph_group_send_raw(ctx, group, tag, arg, (rawptr)0, 0);
}

// Sends one T, copied for each member, to every member of group, as
// alph_send_value. Returns as alph_group_send. Thread: a handler.
export fn alph_group_send_value<T>(ctx: AlphCtx*, group: string, tag: int64, value: T*) -> int64 {
  return alph_group_send_raw(ctx, group, tag, 0, (rawptr)value, (int64)sizeof(T));
}

// Sends size bytes at data, copied for each member, to every member of
// group, as alph_send_bytes. Returns as alph_group_send. Thread: a handler.
export fn alph_group_send_bytes(ctx: AlphCtx*, group: string, tag: int64, data: rawptr,
                                size: int64) -> int64 {
  return alph_group_send_raw(ctx, group, tag, 0, data, size);
}

// ---- running an actor ------------------------------------------------------

// Runs the handler on one message. Returns the exit reason, or -1 to go on.
fn alph_deliver(s: AlphSched*, p: AlphProc*, m: AlphMsg*) -> int64 {
  var ctx: AlphCtx;
  ctx.self = p->pid;
  ctx.state = (rawptr)p->state;
  ctx.state_size = p->state_size;
  ctx.node = (AlphNode*)s->node;
  ctx.proc = (int64)p;
  ctx.sched = (int64)s;
  ctx.stop_reason = ALPH_NORMAL;
  p->handled = p->handled + 1;
  // Recorded so a crash in the handler can free the payload, and a medic
  // can see what was being handled.
  p->poison_heap = m->heap;
  if (alph_atomic_load(&p->medic) != 0) {
    p->last_msg = *m;
  }
  if (p->flushq.len > 0) {
    alph_outq_mark(p);
  }
  var result: int64 = p->handler(&ctx, m);
  p->poison_heap = 0;
  alph_msg_release(m);
  alph_scratch_reset(&s->scratch, &s->pool);
  if (result == ALPH_STOP) {
    return ctx.stop_reason;
  }
  return -1;
}

// Builds a message the runtime delivers itself (EXIT, DOWN, TIMEOUT, ...).
fn alph_runtime_message(m: AlphMsg*, tag: int64, from: int64, to: int64, ref: int64, arg: int64) {
  alph_message(m, from, to, tag, arg, 0);
  m->ref = ref;
}

// An exit signal or a linked actor's exit. Returns an exit reason, or -1.
fn alph_handle_exit(s: AlphSched*, p: AlphProc*, sig: AlphSignal*) -> int64 {
  var reason: int64 = sig->arg;
  if (sig->kind == ALPH_SIG_LINK_EXIT) {
    var at: int64 = alph_vec_find(&p->links, sig->from);
    if (at < 0) {
      return -1;  // unlinked meanwhile
    }
    alph_vec_remove_at(&p->links, at);
  } else if (reason == ALPH_KILL && p->proxy == 0) {
    return ALPH_KILLED;  // a proxy passes the kill on instead
  }
  if (p->trap_exit != 0) {
    var m: AlphMsg;
    alph_runtime_message(&m, ALPH_TAG_EXIT, sig->from, p->pid, 0, reason);
    return alph_deliver(s, p, &m);
  }
  if (reason == ALPH_NORMAL) {
    return -1;
  }
  return reason;
}

// Handles one signal. Returns an exit reason, or -1 to go on.
fn alph_handle_signal(s: AlphSched*, p: AlphProc*, sig: AlphSignal*) -> int64 {
  var node: AlphNode* = (AlphNode*)s->node;
  var m: AlphMsg;
  if (sig->to != p->pid) {
    // Meant for an earlier owner of this slot, which is gone.
    if (sig->kind == ALPH_SIG_LINK) {
      alph_signal_link_exit(node, sig->to, sig->from, ALPH_NOPROC);
    } else if (sig->kind == ALPH_SIG_MONITOR) {
      alph_signal_down(node, sig->to, sig->from, sig->ref, ALPH_NOPROC);
    }
    return -1;
  }
  if (sig->kind == ALPH_SIG_LINK) {
    if (alph_vec_find(&p->links, sig->from) < 0) {
      alph_vec_push(&p->links, sig->from);
      if (p->proxy != 0) {
        alph_runtime_message(&m, ALPH_TAG_LINKED, sig->from, p->pid, 0, 0);
        return alph_deliver(s, p, &m);
      }
    }
    return -1;
  }
  if (sig->kind == ALPH_SIG_UNLINK) {
    var at: int64 = alph_vec_find(&p->links, sig->from);
    if (at >= 0) {
      alph_vec_remove_at(&p->links, at);
      if (p->proxy != 0) {
        alph_runtime_message(&m, ALPH_TAG_UNLINKED, sig->from, p->pid, 0, 0);
        return alph_deliver(s, p, &m);
      }
    }
    return -1;
  }
  if (sig->kind == ALPH_SIG_MONITOR) {
    alph_vec_push(&p->mon_refs, sig->ref);
    alph_vec_push(&p->mon_watchers, sig->from);
    return -1;
  }
  if (sig->kind == ALPH_SIG_DEMONITOR) {
    var at: int64 = alph_vec_find(&p->mon_refs, sig->ref);
    if (at >= 0) {
      alph_vec_remove_at(&p->mon_refs, at);
      alph_vec_remove_at(&p->mon_watchers, at);
    }
    return -1;
  }
  if (sig->kind == ALPH_SIG_DOWN) {
    if (alph_take_ref(p, sig->ref) < 0) {
      return -1;  // demonitored, or the request already settled
    }
    alph_runtime_message(&m, ALPH_TAG_DOWN, sig->from, p->pid, sig->ref, sig->arg);
    return alph_deliver(s, p, &m);
  }
  if (sig->kind == ALPH_SIG_CRASHED) {
    alph_runtime_message(&m, ALPH_TAG_CRASHED, sig->from, p->pid, 0, sig->arg);
    return alph_deliver(s, p, &m);
  }
  if (sig->kind == ALPH_SIG_IO) {
    var slot: AlphIoSlot* = alph_io_slot(node, sig->ref);
    if (slot == 0 || slot->owner != p->pid) {
      return -1;  // closed or given away since the event
    }
    if (slot->child != 0) {
      return alph_child_ended(s, p, slot, sig->ref);
    }
    alph_runtime_message(&m, ALPH_TAG_IO, 0, p->pid, sig->ref, sig->arg);
    return alph_deliver(s, p, &m);
  }
  if (sig->kind == ALPH_SIG_IO_GIVEN) {
    alph_vec_push(&p->io_handles, sig->ref);
    alph_runtime_message(&m, ALPH_TAG_IO_GIVEN, sig->from, p->pid, sig->ref, 0);
    return alph_deliver(s, p, &m);
  }
  if (sig->kind == ALPH_SIG_TIMER) {
    if (sig->ref != 0) {
      var watched: int64 = alph_take_ref(p, sig->ref);
      if (watched < 0) {
        return -1;  // cancelled, or the request already settled
      }
      if (watched > 0) {
        // A request timed out: stop watching the server.
        alph_signal_plain(node, ALPH_SIG_DEMONITOR, p->pid, watched, sig->ref);
      }
    }
    alph_runtime_message(&m, sig->tag, sig->from, p->pid, sig->ref, sig->arg);
    return alph_deliver(s, p, &m);
  }
  return alph_handle_exit(s, p, sig);
}

fn alph_handle_and_free(s: AlphSched*, p: AlphProc*, sig: int64) -> int64 {
  var reason: int64 = alph_handle_signal(s, p, (AlphSignal*)sig);
  free((rawptr)sig);
  return reason;
}

// True when the oldest deferred exit or down has no earlier message left.
fn alph_deferred_ready(p: AlphProc*) -> bool {
  if (p->deferred.len == 0) {
    return false;
  }
  var head: AlphSignal* = (AlphSignal*)alph_vec_get(&p->deferred, 0);
  return head->mark <= p->mailbox.deq;
}

// Handles one popped message. Returns an exit reason, or -1 to go on.
fn alph_handle_message(s: AlphSched*, p: AlphProc*, m: AlphMsg*) -> int64 {
  if (m->to != p->pid) {
    alph_msg_release(m);  // meant for an earlier owner of this slot
    return -1;
  }
  if ((m->flags & ALPH_MSG_REPLY) != 0 && p->proxy == 0) {
    var server: int64 = alph_take_ref(p, m->ref);
    if (server < 0) {
      alph_msg_release(m);  // lost to a timeout or a DOWN
      return -1;
    }
    alph_signal_plain((AlphNode*)s->node, ALPH_SIG_DEMONITOR, p->pid, server, m->ref);
  }
  return alph_deliver(s, p, m);
}

// Handles signals, then up to ALPH_BUDGET messages, for up to ALPH_RUN_NS:
// the clock is read at the start and every 4 messages, and a run that took
// longer ends after the message in hand. A single long handler is never cut
// short. Returns an exit reason, -1 when the actor ran out of work, -2 when
// its message budget ran out, or -3 when its time did.
fn alph_run_some(s: AlphSched*, p: AlphProc*) -> int64 {
  var m: AlphMsg;
  var run_from: int64 = alph_now_ns();
  s->run_at = run_from;
  var stride: int64 = 3;  // look at the clock every 4 messages, or every one once they cost

  if (p->retry != 0) {
    // Resumed by a medic that asked for the crashing message again.
    p->retry = 0;
    m = p->last_msg;
    p->poison_heap = 0;
    var again: int64 = alph_deliver(s, p, &m);
    if (again >= 0) {
      return again;
    }
  }
  if (p->fresh != 0) {
    // INIT was queued before the pid got out, so it is the mailbox's first
    // message; signals sent since (a handle given, an IO event, a timer)
    // must not come before it.
    p->fresh = 0;
    var at0: int64 = 0;
    if (alph_mailbox_pop_at(&p->mailbox, &m, &at0)) {
      var first: int64 = alph_handle_message(s, p, &m);
      if (first >= 0) {
        return first;
      }
    }
  }
  for n: int64 in 0..ALPH_BUDGET {
    while (alph_deferred_ready(p)) {
      var reason: int64 = alph_handle_and_free(s, p, alph_vec_shift(&p->deferred));
      if (reason >= 0) {
        return reason;
      }
    }
    var sig: int64 = alph_queue_pop(&p->signals);
    while (sig != 0) {
      var sg: AlphSignal* = (AlphSignal*)sig;
      if (alph_signal_ordered(sg->kind, sg->arg) &&
          (p->deferred.len > 0 || sg->mark > p->mailbox.deq)) {
        alph_vec_push(&p->deferred, sig);
      } else {
        var reason: int64 = alph_handle_and_free(s, p, sig);
        if (reason >= 0) {
          return reason;
        }
      }
      sig = alph_queue_pop(&p->signals);
    }
    var sent_at: int64 = 0;
    if (!alph_mailbox_pop_at(&p->mailbox, &m, &sent_at)) {
      if (alph_deferred_ready(p)) {
        continue;
      }
      // Anything deferred waits on a message still being written; its
      // sender wakes this actor when the write lands.
      p->shed_above = 0;  // the queue emptied: no standing delay
      if (p->shed_state != ALPH_SHED_IDLE) {
        alph_atomic_store(&p->shed_state, ALPH_SHED_IDLE);
      }
      return -1;
    }
    if (p->shed_target > 0 && sent_at > 0 && alph_sheddable(p, &m)) {
      var waited: int64 = alph_shed_wait(p, sent_at);
      if (waited >= 0) {
        alph_shed(s, p, &m, waited);
        continue;
      }
    }
    var outcome: int64 = alph_handle_message(s, p, &m);
    if (outcome >= 0) {
      return outcome;
    }
    if ((n & stride) == stride) {
      var ran: int64 = alph_now_ns() - run_from;
      if (ran >= ALPH_RUN_NS) {
        return -3;
      }
      if (ran > (n + 1) * ALPH_CHEAP_NS) {
        stride = 0;  // costly messages: a slice of 4 of them could overshoot by far
      }
    }
  }
  return -2;
}

// Whether m may be shed at all: a request to this actor, or with
// shed_casts a plain user message. Replies, DOWN, TIMEOUT, EXIT and other
// runtime messages never are: dropping one would leave a request or a
// monitor unresolved. Messages for an earlier owner of the slot go on to
// alph_handle_message, which deals with them.
fn alph_sheddable(p: AlphProc*, m: AlphMsg*) -> bool {
  if (m->to != p->pid) {
    return false;
  }
  if ((m->flags & ALPH_MSG_REQUEST) != 0) {
    return true;
  }
  return p->shed_casts != 0 && m->flags == 0 && m->tag >= ALPH_TAG_USER;
}

// Maurer's adaptive CoDel ("Fail at Scale", ACM Queue 2015), as at
// Facebook: once waits have stayed above the target for a whole interval,
// every message still above it is shed. Returns how long the message sent
// at sent_at waited (ns) when it should be shed, else -1. A wait under the
// target, or an empty queue behind this message, clears the state, as
// Linux codel does when the backlog is at most one packet.
fn alph_shed_wait(p: AlphProc*, sent_at: int64) -> int64 {
  var now: int64 = alph_now_ns();
  var waited: int64 = now - sent_at;
  if (p->shed_state != ALPH_SHED_IDLE && now - p->shed_pop_at > ALPH_SHED_POP_NS) {
    alph_atomic_store(&p->shed_pop_at, now);
  }
  if (waited < p->shed_target || alph_mailbox_count(&p->mailbox) == 0) {
    p->shed_above = 0;
    alph_shed_publish(p, ALPH_SHED_IDLE, now);
    return -1;
  }
  if (p->shed_above == 0) {
    p->shed_above = now + p->shed_interval;
    alph_shed_publish(p, ALPH_SHED_ARMING, now);
    return -1;
  }
  if (now < p->shed_above) {
    return -1;
  }
  alph_shed_publish(p, ALPH_SHED_DROPPING, now);
  return waited;
}

// Tells requesters what the server's shedding is doing, by a store only
// when it changes.
fn alph_shed_publish(p: AlphProc*, state: int64, now: int64) {
  if (p->shed_state != state) {
    if (p->shed_state == ALPH_SHED_IDLE) {
      alph_atomic_store(&p->shed_pop_at, now);
    }
    alph_atomic_store(&p->shed_state, state);
  }
}

// Whether a request to p should be refused at once by its sender, so that
// refusing costs the overloaded server nothing: p is dropping requests that
// waited too long, or has waits above target and has not taken a message
// for longer than the target (one long handler, a queue that only grows).
fn alph_shed_refuse(p: AlphProc*) -> bool {
  var state: int64 = alph_atomic_load(&p->shed_state);
  if (state == ALPH_SHED_DROPPING) {
    return true;
  }
  if (state == ALPH_SHED_ARMING && alph_mailbox_count(&p->mailbox) > 0) {
    return alph_now_ns() - alph_atomic_load(&p->shed_pop_at) > p->shed_target;
  }
  return false;
}

// Drops m unhandled; a request is answered with ALPH_TAG_BUSY at once, so
// its requester need not wait for a timeout. Its arg is how long the request
// waited (us), a hint for when to try again.
fn alph_shed(s: AlphSched*, p: AlphProc*, m: AlphMsg*, waited: int64) {
  var node: AlphNode* = (AlphNode*)s->node;
  alph_atomic_add(&node->shed, 1);
  if ((m->flags & ALPH_MSG_REQUEST) != 0 && m->from != 0) {
    var r: AlphMsg;
    alph_message(&r, p->pid, m->from, ALPH_TAG_BUSY, waited / 1000, 0);
    r.ref = m->ref;
    r.flags = ALPH_MSG_REPLY;
    alph_post(node, &r, (rawptr)0);
  }
  alph_msg_release(m);
}

fn alph_run_proc(s: AlphSched*, p: AlphProc*) {
  var node: AlphNode* = (AlphNode*)s->node;
  alph_atomic_store_sc(&p->status, ALPH_P_RUNNING);  // pairs with the fence in alph_wake
  s->current = (int64)p;
  alph_atomic_store(&s->run_seq, s->run_seq + 1);
  var r: AlphRecover* = &s->thread.recover;
  alph_recover_arm(r);
  if (alph_recover_save(&r->regs[0]) != 0) {
    // The handler crashed and the hook resumed here. s was set before the
    // save and never reassigned, so the restored registers still hold it;
    // the actor is read back from memory.
    var crashed: AlphProc* = (AlphProc*)s->current;
    s->current = 0;
    if (crashed->flushq.len > 0) {
      // What it sent before the crash goes out, as a write would have.
      var cctx: AlphCtx;
      alph_ctx_for(s, crashed, &cctx);
      alph_outq_write_all(&cctx, crashed, 0, true);
    }
    alph_scratch_reset(&s->scratch, &s->pool);
    if (s->exit_request != 0) {
      // Not a crash: alph_exit_now jumped here to end the actor.
      s->exit_request = 0;
      alph_proc_exit((AlphNode*)s->node, crashed, s->exit_reason);
      return;
    }
    if (!alph_hold_for_medic((AlphNode*)s->node, crashed)) {
      alph_proc_exit((AlphNode*)s->node, crashed, ALPH_CRASHED);
    }
    return;
  }
  var outcome: int64 = alph_run_some(s, p);
  if (p->flushq.len > 0) {
    var fctx: AlphCtx;
    alph_ctx_for(s, p, &fctx);
    alph_outq_write_all(&fctx, p, 0, false);
  }
  alph_recover_disarm(r);
  s->current = 0;
  if (outcome >= 0) {
    alph_proc_exit(node, p, outcome);
    return;
  }
  if (outcome == -3) {
    // Its time ran out with mail left. A run cut short for time is a direct
    // sign of contention. Cut twice in a row, it is CPU-bound: with others
    // waiting here it moves, whole, to a sleeping scheduler (or one more
    // activated), so it runs on undisturbed and the rest stay home.
    // Otherwise it goes to the back of this run queue, and when others wait
    // too a sleeping scheduler is woken to share them, as Go's preemption
    // does with wakep.
    alph_atomic_add(&node->yields, 1);
    p->cut_streak = p->cut_streak + 1;
    alph_atomic_store(&p->status, ALPH_P_QUEUED);
    if (s->bound == 0 && p->cut_streak >= 2 && alph_atomic_load(&s->qlen) > 0) {
      var spare: AlphSched* = alph_sched_spare(node, s);
      if (spare != 0) {
        alph_atomic_add(&node->isolated, 1);
        alph_sched_give(s, node, p, spare);
        return;
      }
    }
    alph_runq_push(s, p);
    if (s->bound == 0 && alph_atomic_load(&s->qlen) > 1) {
      alph_sysmon_rescue(node, s);
    }
    return;
  }
  p->cut_streak = 0;
  if (outcome == -2 ||
      alph_atomic_cas(&p->status, ALPH_P_RUNNING, ALPH_P_IDLE) != ALPH_P_RUNNING) {
    // More work is waiting, or arrived while running.
    alph_atomic_store(&p->status, ALPH_P_QUEUED);
    alph_runq_push(s, p);
  }
}

// ---- IO ----------------------------------------------------------------------
//
// A handle is a file descriptor owned by one actor and registered with the
// epoll set of that actor's scheduler. Arming it asks for one ALPH_TAG_IO
// message the next time it is ready; reading and writing never block. The
// runtime closes every handle an actor owns when it exits, crash included.

fn alph_io_slot_at(node: AlphNode*, index: int64) -> AlphIoSlot* {
  return (AlphIoSlot*)(node->ios + index * (int64)sizeof(AlphIoSlot));
}

// The open handle h names, or 0.
fn alph_io_slot(node: AlphNode*, h: int64) -> AlphIoSlot* {
  var index: int64 = (h & (((int64)1 << 32) - 1)) - 1;
  if (h <= 0 || index < 0 || index >= node->io_capacity) {
    return (AlphIoSlot*)0;
  }
  var slot: AlphIoSlot* = alph_io_slot_at(node, index);
  if (alph_atomic_load(&slot->handle) != h) {
    return (AlphIoSlot*)0;
  }
  return slot;
}

// The handle h if the calling actor owns it, else 0.
fn alph_io_mine(ctx: AlphCtx*, h: int64) -> AlphIoSlot* {
  var slot: AlphIoSlot* = alph_io_slot(ctx->node, h);
  if (slot == 0 || slot->owner != ctx->self) {
    return (AlphIoSlot*)0;
  }
  return slot;
}

// Unregisters, closes and frees the handle, if `owner` still owns it.
fn alph_io_drop(node: AlphNode*, h: int64, owner: int64) {
  var slot: AlphIoSlot* = alph_io_slot(node, h);
  if (slot == 0 || slot->owner != owner) {
    return;
  }
  var s: AlphSched* = (AlphSched*)slot->sched;
  if (slot->pollable != 0) {
    alph_rx_remove(&s->rx, slot->fd);
    alph_atomic_add(&s->io_count, -1);
  }
  if (slot->child != 0) {
    // The owner is done with a child that still runs: end it (its process
    // group, unless it kept the node's) and reap it, so nothing is
    // orphaned or left a zombie.
    syscall(ALPH_SYS_KILL, slot->kill_to, ALPH_SIGKILL);
    alph_child_wait(slot->child, false);
    slot->child = 0;
  }
  alph_sys_close(slot->fd);
  alph_atomic_store_sc(&slot->handle, 0);
  alph_spin_lock(&node->io_lock);
  var at: int64* = (int64*)(node->io_free_stack + node->io_free_top * 8);
  *at = slot->index;
  node->io_free_top = node->io_free_top + 1;
  alph_spin_unlock(&node->io_lock);
}

// Puts fd on the scheduler s's epoll set, not yet armed.
fn alph_io_register(slot: AlphIoSlot*, s: AlphSched*) {
  slot->sched = (int64)s;
  slot->pollable = 0;
  slot->armed = 0;
  alph_atomic_store(&slot->state, 0);
  slot->drained = 1;
  slot->full = 1;
  if (alph_io_watch(slot, s) == 0) {
    slot->pollable = 1;
    alph_atomic_add(&s->io_count, 1);
  }
}

// Puts slot's fd on s's epoll set: edge-triggered for reading and writing,
// once for good, or one-shot with the events it has armed.
fn alph_io_watch(slot: AlphIoSlot*, s: AlphSched*) -> int64 {
  if (slot->oneshot != 0) {
    return alph_rx_add(&s->rx, slot->fd, slot->armed, ALPH_RX_ONESHOT, slot->handle);
  }
  return alph_rx_add(&s->rx, slot->fd, ALPH_RX_READ | ALPH_RX_WRITE, ALPH_RX_EDGE, slot->handle);
}

// Turns an edge-triggered slot into a one-shot one for good, keeping what
// it has armed: its owner may now read the fd without alph_io_read, which
// the edge bookkeeping relies on.
fn alph_io_to_oneshot(node: AlphNode*, slot: AlphIoSlot*) {
  if (slot->oneshot != 0) {
    return;
  }
  slot->oneshot = 1;
  alph_atomic_add(&node->io_demoted, 1);
  var st: int64 = alph_atomic_swap(&slot->state, 0);
  slot->armed = (st >> 8) & (ALPH_IO_IN | ALPH_IO_OUT);
  if (slot->pollable != 0) {
    var home: AlphSched* = (AlphSched*)slot->sched;
    alph_rx_modify(&home->rx, slot->fd, slot->armed, ALPH_RX_ONESHOT, slot->handle);
  }
}

// The poller (a scheduler, a rescuer or the watchdog) saw mask on slot,
// for handle h. A one-shot slot fired and is disarmed. An edge-triggered
// one delivers what is armed, and disarms every direction at once, as a
// one-shot does: the owner arms again after each ALPH_TAG_IO. What is not
// armed is kept as ready, for the next arm.
fn alph_io_event(node: AlphNode*, slot: AlphIoSlot*, h: int64, mask: int64) {
  if (slot->oneshot != 0) {
    slot->armed = 0;
    alph_signal(node, ALPH_SIG_IO, 0, slot->owner, h, mask, 0);
    return;
  }
  while (true) {
    var old: int64 = alph_atomic_load(&slot->state);
    var ready: int64 = old & 255;
    var armed: int64 = (old >> 8) & 255;
    var give: int64 = 0;
    if (armed != 0) {
      give = mask & (armed | ALPH_IO_ERR | ALPH_IO_HUP);
    }
    var next: int64 = old | mask;
    if (give != 0) {
      next = (ready | mask) & ~(give & (ALPH_IO_IN | ALPH_IO_OUT));  // ERR and HUP stay
    }
    if (alph_atomic_cas(&slot->state, old, next) == old) {
      if (give != 0) {
        alph_signal(node, ALPH_SIG_IO, 0, slot->owner, h, give, 0);
      }
      return;
    }
  }
}

// alph_io_open for a TCP stream socket: a read shorter than asked for
// means it is drained.
fn alph_io_open_stream(ctx: AlphCtx*, fd: int64) -> int64 {
  var h: int64 = alph_io_open(ctx, fd);
  if (h > 0) {
    alph_io_slot(ctx->node, h)->stream = 1;
  }
  return h;
}

// Makes the calling actor the owner of fd: it is made non-blocking, put on
// this scheduler's epoll set, and closed when the actor exits, crash
// included, unless it is closed or given away first. Any descriptor works;
// one epoll cannot watch (a regular file) is still owned and closed, but
// alph_io_arm refuses it.
//
//   fd  an open file descriptor; the handle owns it from now on
//
// Returns the handle (above 0), or a negative errno when fd is invalid, or
// ALPH_NOMEM when max_handles are open. Thread: a handler.
export fn alph_io_open(ctx: AlphCtx*, fd: int64) -> int64 {
  if (fd < 0) {
    return fd;
  }
  alph_sys_nonblock(fd);
  var node: AlphNode* = ctx->node;
  alph_spin_lock(&node->io_lock);
  var index: int64 = -1;
  if (node->io_free_top > 0) {
    node->io_free_top = node->io_free_top - 1;
    var at: int64* = (int64*)(node->io_free_stack + node->io_free_top * 8);
    index = *at;
  }
  alph_spin_unlock(&node->io_lock);
  if (index < 0) {
    return ALPH_NOMEM;
  }
  var slot: AlphIoSlot* = alph_io_slot_at(node, index);
  slot->index = index;
  slot->serial = slot->serial + 1;
  slot->fd = fd;
  slot->child = 0;
  slot->kill_to = 0;
  slot->oneshot = 0;
  slot->stream = 0;
  slot->owner = ctx->self;
  alph_atomic_store_sc(&slot->handle, (slot->serial << 32) | (index + 1));
  alph_io_register(slot, (AlphSched*)alph_me(ctx)->sched);
  alph_vec_push(&alph_me(ctx)->io_handles, slot->handle);
  return slot->handle;
}

// Asks for one ALPH_TAG_IO message the next time handle h is ready for
// events (ALPH_IO_IN, ALPH_IO_OUT, or both). The message's ref is h and its
// arg says what is ready, which may include ALPH_IO_ERR or ALPH_IO_HUP. Arm
// again after each message to hear about the next time: one message
// disarms every direction, as an epoll one-shot does.
//
// Arming costs no system call: the handle stays on its epoll set,
// edge-triggered, and what became ready while unarmed is kept and reported
// at once. After a read through alph_io_read that left data behind (or a
// write through alph_io_write that wrote everything), it is reported at
// once as well, so reading part of what is there and arming again works as
// with a level. A message may then find nothing after all: the read returns
// ALPH_IO_AGAIN, and arming again waits for more.
//
// Returns 0, or a negative errno: -9 when this actor does not own h, -1
// when h cannot be watched (a regular file). Thread: a handler.
export fn alph_io_arm(ctx: AlphCtx*, h: int64, events: int64) -> int64 {
  var slot: AlphIoSlot* = alph_io_mine(ctx, h);
  if (slot == 0) {
    return -9;
  }
  if (slot->pollable == 0) {
    return -1;
  }
  var want: int64 = events & (ALPH_IO_IN | ALPH_IO_OUT);
  if (slot->oneshot != 0) {
    var s: AlphSched* = (AlphSched*)slot->sched;
    slot->armed = want;
    return alph_rx_modify(&s->rx, slot->fd, want, ALPH_RX_ONESHOT, h);
  }
  if (want == 0) {
    return 0;
  }
  while (true) {
    var old: int64 = alph_atomic_load(&slot->state);
    var ready: int64 = old & 255;
    var hit: int64 = ready & (want | ALPH_IO_ERR | ALPH_IO_HUP);
    if (hit != 0) {
      // Ready since the last delivery: hand it over, and keep ERR and HUP.
      var next: int64 = ready & ~(hit & (ALPH_IO_IN | ALPH_IO_OUT));
      if (alph_atomic_cas(&slot->state, old, next) == old) {
        alph_signal(ctx->node, ALPH_SIG_IO, 0, ctx->self, h, hit, 0);
        return 0;
      }
      continue;
    }
    // No edge since, but the last read or write left more to do: there is
    // no edge to wait for, so report it at once, as a level would.
    var maybe: int64 = 0;
    if ((want & ALPH_IO_IN) != 0 && slot->drained == 0) {
      maybe = maybe | ALPH_IO_IN;
    }
    if ((want & ALPH_IO_OUT) != 0 && slot->full == 0) {
      maybe = maybe | ALPH_IO_OUT;
    }
    if (maybe != 0) {
      alph_signal(ctx->node, ALPH_SIG_IO, 0, ctx->self, h, maybe, 0);
      return 0;
    }
    if (alph_atomic_cas(&slot->state, old, ready | (want << 8)) == old) {
      return 0;
    }
  }
  return 0;
}

// As alph_io_arm, but adds events to what h is armed for instead of
// replacing it: a write that must wait keeps the owner's read armed too.
fn alph_io_arm_also(ctx: AlphCtx*, h: int64, events: int64) -> int64 {
  var slot: AlphIoSlot* = alph_io_mine(ctx, h);
  if (slot == 0) {
    return -9;
  }
  if (slot->oneshot != 0) {
    return alph_io_arm(ctx, h, slot->armed | events);
  }
  var armed: int64 = (alph_atomic_load(&slot->state) >> 8) & (ALPH_IO_IN | ALPH_IO_OUT);
  return alph_io_arm(ctx, h, armed | events);
}

// Reads up to size bytes from handle h into buf, without blocking.
// Returns the count, 0 at end of stream (the peer closed), ALPH_IO_AGAIN
// when nothing is there yet (arm ALPH_IO_IN and try again), or a negative
// errno (-9 when this actor does not own h). Thread: a handler.
export fn alph_io_read(ctx: AlphCtx*, h: int64, buf: rawptr, size: int64) -> int64 {
  var slot: AlphIoSlot* = alph_io_mine(ctx, h);
  if (slot == 0) {
    return -9;
  }
  var n: int64 = alph_sys_read(slot->fd, buf, size);
  // Whether an arm must wait for the next edge, or may report at once.
  if (n == ALPH_IO_AGAIN || (n > 0 && n < size && slot->stream != 0)) {
    slot->drained = 1;
  } else if (n >= 0) {
    slot->drained = 0;  // a full read, or the end of the stream, which stays readable
  }
  return n;
}

// Turns on (or off) kernel arrival stamps for handle h, a socket, for
// alph_io_recv. Turning them on for any socket makes the kernel stamp every
// packet the host receives (a clock read each): small, but host-wide, so it
// is off unless asked for. Returns 0 or a negative errno. Thread: a handler.
export fn alph_io_stamps(ctx: AlphCtx*, h: int64, on: bool) -> int64 {
  var slot: AlphIoSlot* = alph_io_mine(ctx, h);
  if (slot == 0) {
    return -9;
  }
  var flags: int64 = 0;
  if (on) {
    flags = ALPH_SOF_RX_SOFTWARE | ALPH_SOF_SOFTWARE;
  }
  slot->rx_from = alph_now_ns();
  return alph_sys_setsockopt(slot->fd, ALPH_SOL_SOCKET, ALPH_SO_TIMESTAMPING, flags);
}

// As alph_io_read, and says when what it read arrived: every byte arrived
// at or after *from_ns and at or before *to_ns (monotonic ns, as
// alph_now_ns). For a stream the kernel stamps the last packet read
// (*to_ns); bytes before it may be older, back to *from_ns: the end of the
// last read when that one emptied the socket, else the last packet it
// read. A batch of requests can be given times between the two, the oldest
// first. Without stamps (alph_io_stamps) both are the time of this call.
// Thread: a handler.
export fn alph_io_recv(ctx: AlphCtx*, h: int64, buf: rawptr, size: int64, from_ns: int64*,
                       to_ns: int64*) -> int64 {
  var slot: AlphIoSlot* = alph_io_mine(ctx, h);
  if (slot == 0) {
    return -9;
  }
  var iov: int64[2];
  iov[0] = (int64)buf;
  iov[1] = size;
  var control: int64[16];
  var msg: int64[7];
  msg[0] = 0;      // msg_name
  msg[1] = 0;      // msg_namelen
  msg[2] = (int64)&iov[0];
  msg[3] = 1;
  msg[4] = (int64)&control[0];
  msg[5] = 128;    // msg_controllen
  msg[6] = 0;      // msg_flags
  var n: int64 = syscall(ALPH_SYS_RECVMSG, slot->fd, (int64)&msg[0], 0);
  var now: int64 = alph_now_ns();
  var stamp: int64 = 0;
  if (n > 0 && msg[5] >= 64) {
    // One cmsghdr: len (8), level (4), type (4), then scm_timestamping:
    // three timespecs, the first the software stamp (CLOCK_REALTIME).
    var level: int32 = *(int32*)((int64)&control[0] + 8);
    var kind: int32 = *(int32*)((int64)&control[0] + 12);
    if ((int64)level == ALPH_SOL_SOCKET && (int64)kind == ALPH_SO_TIMESTAMPING && control[2] != 0) {
      stamp = control[2] * 1000000000 + control[3] - alph_atomic_load(&ctx->node->rt_offset);
      if (stamp > now) {
        stamp = now;
      }
    }
  }
  if (stamp == 0) {
    stamp = now;
  }
  var from: int64 = slot->rx_from;
  if (from == 0) {
    from = stamp;
  }
  if (stamp < from) {
    // TCP order: these bytes came after the last bound. A stamp converted
    // with a refreshed realtime offset may land a little before it; keep
    // the bounds in order rather than move from back.
    stamp = from;
  }
  *from_ns = from;
  *to_ns = stamp;
  if (n == ALPH_IO_AGAIN || (n > 0 && n < size && slot->stream != 0)) {
    slot->drained = 1;
    slot->rx_from = now;  // what comes next arrives after this read
  } else if (n >= 0) {
    slot->drained = 0;
    slot->rx_from = stamp;  // what is left came after the last packet read
  }
  return n;
}

// Writes up to size bytes from buf to handle h, without blocking. Returns
// the count written, which may be less than size, ALPH_IO_AGAIN when none
// fit (arm ALPH_IO_OUT and try again), or a negative errno. For whole
// messages, an AlphOutq does the bookkeeping. Thread: a handler.
export fn alph_io_write(ctx: AlphCtx*, h: int64, buf: rawptr, size: int64) -> int64 {
  var slot: AlphIoSlot* = alph_io_mine(ctx, h);
  if (slot == 0) {
    return -9;
  }
  var n: int64 = alph_sys_write(slot->fd, buf, size);
  if (n == ALPH_IO_AGAIN || (n >= 0 && n < size)) {
    slot->full = 1;
  } else if (n == size) {
    slot->full = 0;
  }
  return n;
}

// Closes handle h and its descriptor now. Does nothing when this actor does
// not own h. Thread: a handler.
export fn alph_io_close(ctx: AlphCtx*, h: int64) {
  var slot: AlphIoSlot* = alph_io_mine(ctx, h);
  if (slot == 0) {
    return;
  }
  var p: AlphProc* = alph_me(ctx);
  if (p->flushq.len > 0) {
    alph_outq_write_all(ctx, p, h, false);  // what was sent goes out before the close
  }
  var at: int64 = alph_vec_find(&p->io_handles, h);
  if (at >= 0) {
    alph_vec_remove_at(&p->io_handles, at);
  }
  alph_io_drop(ctx->node, h, ctx->self);
}

// The descriptor behind handle h, for calls alph has no wrapper for, or -9
// when this actor does not own h. Do not close it yourself; use
// alph_io_close. From then on h is watched one-shot, re-armed by a system
// call on each alph_io_arm, since reads and writes alph does not see would
// break its edge bookkeeping (alph_node_stats counts these as io_demoted).
// Thread: a handler.
export fn alph_io_fd(ctx: AlphCtx*, h: int64) -> int64 {
  var slot: AlphIoSlot* = alph_io_mine(ctx, h);
  if (slot == 0) {
    return -9;
  }
  alph_io_to_oneshot(ctx->node, slot);
  return slot->fd;
}

// Hands handle h to the actor `to`, which becomes its owner and gets an
// ALPH_TAG_IO_GIVEN message (ref = h, from = this actor). Any arming is
// dropped; the new owner arms it. If `to` exits before taking it, it is
// closed. Use it to pass an accepted connection to the actor that serves it.
//
// Returns ALPH_SENT, ALPH_GONE when `to` has exited (h stays with this
// actor), or -9 when this actor does not own h. Thread: a handler.
export fn alph_io_give(ctx: AlphCtx*, h: int64, to: int64) -> int64 {
  var slot: AlphIoSlot* = alph_io_mine(ctx, h);
  if (slot == 0) {
    return -9;
  }
  var target: AlphProc* = alph_resolve(ctx->node, to);
  if (target == 0) {
    return ALPH_GONE;
  }
  var p: AlphProc* = alph_me(ctx);
  if (p->flushq.len > 0) {
    alph_outq_write_all(ctx, p, h, false);  // what was sent goes out before the hand-off
  }
  var at: int64 = alph_vec_find(&p->io_handles, h);
  if (at >= 0) {
    alph_vec_remove_at(&p->io_handles, at);
  }
  if (slot->pollable != 0) {
    var old: AlphSched* = (AlphSched*)slot->sched;
    alph_rx_remove(&old->rx, slot->fd);
    alph_atomic_add(&old->io_count, -1);
  }
  slot->owner = to;
  alph_io_register(slot, (AlphSched*)target->sched);
  if (!alph_signal(ctx->node, ALPH_SIG_IO_GIVEN, ctx->self, to, h, 0, 0)) {
    alph_io_drop(ctx->node, h, to);  // it exited just now
  }
  return ALPH_SENT;
}

// The pending error on a socket handle, 0 when there is none: after a
// connect reports ALPH_IO_OUT, 0 means it is connected. Returns a positive
// errno, or -9 when this actor does not own h. Thread: a handler.
export fn alph_io_error(ctx: AlphCtx*, h: int64) -> int64 {
  var slot: AlphIoSlot* = alph_io_mine(ctx, h);
  if (slot == 0) {
    return -9;
  }
  var err: int32 = 0;
  var len: int32 = 4;
  syscall(ALPH_SYS_GETSOCKOPT, slot->fd, ALPH_SOL_SOCKET, ALPH_SO_ERROR, (int64)&err, (int64)&len);
  return (int64)err;
}

// An IPv4 address in host order, for the alph_tcp_ functions:
// alph_ip4(127, 0, 0, 1). Thread: any.
export fn alph_ip4(a: int64, b: int64, c: int64, d: int64) -> int64 {
  return ((a & 255) << 24) | ((b & 255) << 16) | ((c & 255) << 8) | (d & 255);
}

// Opens a TCP listener owned by the calling actor.
//
//   ip4      the address to listen on: alph_ip4(0, 0, 0, 0) for all
//   port     the port, or 0 to let the system pick (see alph_tcp_port)
//   backlog  connections the kernel queues before accept
//   flags    0, or ALPH_TCP_REUSEPORT so several actors (one per
//            scheduler) can each listen on the same port
//
// Arm it with ALPH_IO_IN; on ALPH_TAG_IO, call alph_tcp_accept until it
// returns ALPH_IO_AGAIN, then arm again. Returns the handle, or a negative
// errno (-98 when the address is in use). Thread: a handler.
export fn alph_tcp_listen(ctx: AlphCtx*, ip4: int64, port: int64, backlog: int64, flags: int64) -> int64 {
  var fd: int64 = alph_sys_tcp_socket();
  if (fd < 0) {
    return fd;
  }
  alph_sys_setsockopt(fd, ALPH_SOL_SOCKET, ALPH_SO_REUSEADDR, 1);
  if ((flags & ALPH_TCP_REUSEPORT) != 0) {
    alph_sys_setsockopt(fd, ALPH_SOL_SOCKET, ALPH_SO_REUSEPORT, 1);
  }
  var addr: uint8[16];
  alph_sys_sockaddr(&addr[0], ip4, port);
  var err: int64 = syscall(ALPH_SYS_BIND, fd, (int64)&addr[0], 16);
  if (err == 0) {
    err = syscall(ALPH_SYS_LISTEN, fd, backlog);
  }
  if (err != 0) {
    alph_sys_close(fd);
    return err;
  }
  return alph_io_open(ctx, fd);
}

// Accepts one waiting connection on a listener handle. The new connection
// is a handle owned by the calling actor; give it to another actor with
// alph_io_give. Returns the handle, ALPH_IO_AGAIN when none is waiting, or
// a negative errno. Thread: a handler.
export fn alph_tcp_accept(ctx: AlphCtx*, listener: int64) -> int64 {
  var slot: AlphIoSlot* = alph_io_mine(ctx, listener);
  if (slot == 0) {
    return -9;
  }
  var fd: int64 = syscall(ALPH_SYS_ACCEPT4, slot->fd, 0, 0, ALPH_SOCK_NONBLOCK | ALPH_SOCK_CLOEXEC);
  if (fd < 0) {
    if (fd == ALPH_IO_AGAIN) {
      slot->drained = 1;
    }
    return fd;
  }
  slot->drained = 0;  // more may be waiting
  return alph_io_open_stream(ctx, fd);
}

// Starts connecting to ip4:port. Returns the handle at once, still
// connecting: arm it with ALPH_IO_OUT, and on ALPH_TAG_IO check
// alph_io_error, which is 0 once connected. Returns a negative errno when
// it fails at once. Thread: a handler.
export fn alph_tcp_connect(ctx: AlphCtx*, ip4: int64, port: int64) -> int64 {
  var fd: int64 = alph_sys_tcp_socket();
  if (fd < 0) {
    return fd;
  }
  var addr: uint8[16];
  alph_sys_sockaddr(&addr[0], ip4, port);
  var err: int64 = syscall(ALPH_SYS_CONNECT, fd, (int64)&addr[0], 16);
  if (err != 0 && err != -ALPH_EINPROGRESS) {
    alph_sys_close(fd);
    return err;
  }
  return alph_io_open_stream(ctx, fd);
}

// The local port of a socket handle: the port a listener opened with port
// 0 got. Returns a negative errno on failure. Thread: a handler.
export fn alph_tcp_port(ctx: AlphCtx*, h: int64) -> int64 {
  var slot: AlphIoSlot* = alph_io_mine(ctx, h);
  if (slot == 0) {
    return -9;
  }
  var addr: uint8[16];
  var len: int32 = 16;
  var err: int64 = syscall(ALPH_SYS_GETSOCKNAME, slot->fd, (int64)&addr[0], (int64)&len);
  if (err != 0) {
    return err;
  }
  return ((int64)addr[2] << 8) | (int64)addr[3];
}

// Reads a socket's address with getsockname (peer false) or getpeername
// (peer true) into *ip4 (host order, as alph_ip4 builds) and *port.
fn alph_tcp_addr(ctx: AlphCtx*, h: int64, peer: bool, ip4: int64*, port: int64*) -> int64 {
  var slot: AlphIoSlot* = alph_io_mine(ctx, h);
  if (slot == 0) {
    return -9;
  }
  var addr: uint8[16];
  var len: int32 = 16;
  var call: int64 = ALPH_SYS_GETSOCKNAME;
  if (peer) {
    call = 52;  // getpeername
  }
  var err: int64 = syscall(call, slot->fd, (int64)&addr[0], (int64)&len);
  if (err != 0) {
    return err;
  }
  *ip4 = alph_ip4((int64)addr[4], (int64)addr[5], (int64)addr[6], (int64)addr[7]);
  *port = ((int64)addr[2] << 8) | (int64)addr[3];
  return 0;
}

// The address of the other end of a connected TCP handle: *ip4 in host
// order (alph_ip4(127, 0, 0, 1) for loopback) and *port. For logs and
// access rules. Returns 0, or a negative errno: -107 (ENOTCONN) when it is
// not connected, -9 when this actor does not own h. Thread: a handler.
export fn alph_tcp_peer(ctx: AlphCtx*, h: int64, ip4: int64*, port: int64*) -> int64 {
  return alph_tcp_addr(ctx, h, true, ip4, port);
}

// The local address of a TCP handle, as alph_tcp_peer: the address and port
// a connection arrived on, or a listener listens on. Returns 0 or a
// negative errno. Thread: a handler.
export fn alph_tcp_local(ctx: AlphCtx*, h: int64, ip4: int64*, port: int64*) -> int64 {
  return alph_tcp_addr(ctx, h, false, ip4, port);
}

// Turns Nagle's algorithm off (on true) for a TCP handle, so small writes
// go out at once. Returns 0 or a negative errno. Thread: a handler.
export fn alph_tcp_nodelay(ctx: AlphCtx*, h: int64, on: bool) -> int64 {
  var slot: AlphIoSlot* = alph_io_mine(ctx, h);
  if (slot == 0) {
    return -9;
  }
  var value: int64 = 0;
  if (on) {
    value = 1;
  }
  return alph_sys_setsockopt(slot->fd, ALPH_IPPROTO_TCP, ALPH_TCP_NODELAY, value);
}

// An output queue: bytes waiting to be written to a handle, kept in the
// actor's heap. It takes whole messages and writes what the socket accepts,
// so a handler never has to track partial writes. Put it in the actor's
// state and start it with alph_outq_init.
//
//   limit  bytes it may hold; past it alph_outq_push returns ALPH_FULL,
//          which is the signal that the peer reads too slowly
export struct AlphOutq {
  data: rawptr;
  len: int64;    // bytes in data
  sent: int64;   // bytes of data already written
  cap: int64;
  limit: int64;
  h: int64;      // alph_outq_send: the handle it writes to at the end of the run
  held: int64;   //   sends since the last write
  listed: int64; //   1 while on its actor's list to write at the end of the run
  mark: int64;   //   len when the current handler started: after a crash only bytes before it are trusted
}

// Starts q empty, holding at most limit bytes. Thread: any.
export fn alph_outq_init(q: AlphOutq*, limit: int64) {
  q->data = (rawptr)0;
  q->len = 0;
  q->sent = 0;
  q->cap = 0;
  q->limit = limit;
  q->h = 0;
  q->held = 0;
  q->listed = 0;
  q->mark = 0;
}

// Queues size bytes at data on q for handle h, and writes them when this
// run of the actor ends, together with everything else sent through q
// meanwhile: many answers to one connection go out in one write, as Go's
// buffered writers and the BEAM's iolists do. It writes early once
// ALPH_OUTQ_HOLD_BYTES or ALPH_OUTQ_HOLD_SENDS are held, and before h is
// closed or given away; when the actor exits, what it queued is still
// written, and when a handler crashes, what earlier handlers queued is, but
// not what the crashing one did (it may have been corrupted; a medic retry
// sends it again). Use alph_outq_push and alph_outq_flush to
// write at once instead. Returns ALPH_SENT, ALPH_FULL (nothing queued) or
// ALPH_NOMEM, or a negative errno from an early write.
// Thread: the handler of the actor whose state holds q.
export fn alph_outq_send(ctx: AlphCtx*, q: AlphOutq*, h: int64, data: rawptr, size: int64) -> int64 {
  if (q->listed == 0) {
    q->mark = q->len;  // listed during this handler: what it held before is trusted
  }
  var r: int64 = alph_outq_push(ctx, q, data, size);
  if (r != ALPH_SENT) {
    return r;
  }
  q->held = q->held + 1;
  if (q->listed == 0 || q->h != h) {
    if (q->listed != 0 && q->h != h) {
      alph_outq_write_held(ctx, q);
    }
    q->h = h;
    if (q->listed == 0) {
      q->listed = 1;
      alph_vec_push(&alph_me(ctx)->flushq, (int64)q);
    }
  }
  if (alph_outq_pending(q) >= ALPH_OUTQ_HOLD_BYTES || q->held >= ALPH_OUTQ_HOLD_SENDS) {
    var w: int64 = alph_outq_write_held(ctx, q);
    if (w < 0) {
      return w;
    }
  }
  return ALPH_SENT;
}

// A handler is about to run: what p's queues hold now came from handlers
// that returned, and stays trusted if this one crashes.
fn alph_outq_mark(p: AlphProc*) {
  for i: int64 in 0..p->flushq.len {
    var q: AlphOutq* = (AlphOutq*)alph_vec_get(&p->flushq, i);
    q->mark = q->len;
  }
}

// Writes what q holds now (staying listed); a negative errno on failure.
fn alph_outq_write_held(ctx: AlphCtx*, q: AlphOutq*) -> int64 {
  q->held = 0;
  if (q->h == 0 || alph_outq_pending(q) == 0) {
    return 0;
  }
  var w: int64 = alph_outq_flush(ctx, q, q->h);
  if (w < 0) {
    return w;
  }
  return 0;
}

// Writes what every alph_outq_send queue of p holds, at the end of a run or
// when only those for handle h (h above 0) are due: before h closes or
// moves. checked: after a crash, a queue is written only if it still looks
// whole (inside the actor's state, its counters in order).
fn alph_outq_write_all(ctx: AlphCtx*, p: AlphProc*, h: int64, checked: bool) {
  var i: int64 = 0;
  while (i < p->flushq.len) {
    var q: AlphOutq* = (AlphOutq*)alph_vec_get(&p->flushq, i);
    if (h > 0 && q->h != h) {
      i = i + 1;
      continue;
    }
    var ok: bool = true;
    if (checked) {
      // After a crash the handler that crashed may have written anywhere,
      // its own bytes and q's fields included, and sending what they point
      // at could put any memory on the wire. Only bytes queued by handlers
      // that returned go out (up to mark), and only if q still looks whole.
      var lo: int64 = (int64)p->state;
      ok = (int64)q >= lo && (int64)q + (int64)sizeof(AlphOutq) <= lo + p->state_size &&
           q->sent >= 0 && q->sent <= q->mark && q->mark <= q->len && q->len <= q->cap;
      if (ok) {
        q->len = q->mark;
      }
    }
    if (ok) {
      alph_outq_write_held(ctx, q);
      q->listed = 0;
    }
    alph_vec_remove_at(&p->flushq, i);
  }
}

// The handler context alph_deliver gives p, for runtime work done in its
// name between messages.
fn alph_ctx_for(s: AlphSched*, p: AlphProc*, ctx: AlphCtx*) {
  ctx->self = p->pid;
  ctx->state = (rawptr)p->state;
  ctx->state_size = p->state_size;
  ctx->node = (AlphNode*)s->node;
  ctx->proc = (int64)p;
  ctx->sched = (int64)s;
  ctx->stop_reason = ALPH_NORMAL;
}

// Bytes waiting in q. Thread: any.
export fn alph_outq_pending(q: AlphOutq*) -> int64 {
  return q->len - q->sent;
}

// Copies size bytes at data to the end of q. Returns ALPH_SENT, ALPH_FULL
// when that would pass the limit (nothing is queued), or ALPH_NOMEM.
// Thread: the handler of the actor whose state holds q.
export fn alph_outq_push(ctx: AlphCtx*, q: AlphOutq*, data: rawptr, size: int64) -> int64 {
  if (alph_outq_pending(q) + size > q->limit) {
    return ALPH_FULL;
  }
  if (q->sent > 0 && q->len + size > q->cap) {
    // Move what is left to the front before growing.
    var left: int64 = alph_outq_pending(q);
    memmove(q->data, (rawptr)((int64)q->data + q->sent), left);
    q->len = left;
    q->sent = 0;
  }
  if (q->len + size > q->cap) {
    var cap: int64 = q->cap * 2;
    if (cap < q->len + size) {
      cap = q->len + size;
    }
    if (cap < 256) {
      cap = 256;
    }
    var grown: rawptr = alph_realloc(ctx, q->data, cap);
    if (grown == 0) {
      return ALPH_NOMEM;
    }
    q->data = grown;
    q->cap = alph_heap_size(grown);
  }
  memcpy((rawptr)((int64)q->data + q->len), data, size);
  q->len = q->len + size;
  return ALPH_SENT;
}

// Writes as much of q to handle h as the socket accepts now. When bytes are
// left it arms h for ALPH_IO_OUT, so the next ALPH_TAG_IO with ALPH_IO_OUT
// is the time to flush again. Returns the bytes still waiting (0 when all
// went out), or a negative errno when the write failed (the connection is
// broken). Thread: the handler of the actor whose state holds q.
export fn alph_outq_flush(ctx: AlphCtx*, q: AlphOutq*, h: int64) -> int64 {
  while (alph_outq_pending(q) > 0) {
    var n: int64 = alph_io_write(ctx, h, (rawptr)((int64)q->data + q->sent), alph_outq_pending(q));
    if (n == ALPH_IO_AGAIN) {
      alph_io_arm_also(ctx, h, ALPH_IO_OUT);
      return alph_outq_pending(q);
    }
    if (n < 0) {
      return n;
    }
    q->sent = q->sent + n;
  }
  q->len = 0;
  q->sent = 0;
  return 0;
}

// Frees q's buffer; q is empty afterwards. Thread: the handler of the actor
// whose state holds q.
export fn alph_outq_free(ctx: AlphCtx*, q: AlphOutq*) {
  alph_free(ctx, q->data);
  alph_outq_init(q, q->limit);
}

// ---- child processes -------------------------------------------------------

// Flags for AlphProcSpec.flags. A stream that is not piped goes to
// AlphProcSpec.log when set, else to /dev/null with ALPH_PROC_QUIET, else it
// is inherited from the node. stdin is never sent to the log.
export const ALPH_PROC_IN: int64 = 1;     // pipe the child's stdin; write to spec.stdin_h
export const ALPH_PROC_OUT: int64 = 2;    // pipe the child's stdout; read from spec.stdout_h
export const ALPH_PROC_ERR: int64 = 4;    // pipe the child's stderr; read from spec.stderr_h
export const ALPH_PROC_MERGE: int64 = 8;  // send stderr into the stdout pipe; needs ALPH_PROC_OUT
export const ALPH_PROC_QUIET: int64 = 16; // streams that are not piped go to /dev/null
export const ALPH_PROC_KEEP_GROUP: int64 = 32; // stay in the node's process group; see alph_proc_spawn

// What to run, for alph_proc_spawn. Set the inputs; alph_proc_spawn fills
// the three handles.
//
//   argv      the program and its arguments, ending with 0. A program
//             name without a slash is looked up in PATH
//   envp      the environment, ending with 0; 0 means the environment
//             this process started with
//   cwd       the working directory; 0 means the node's
//   log       a file for stdout and stderr when they are not piped,
//             created or emptied (mode 0644); 0 means none
//   flags     ALPH_PROC_ bits
//   stdin_h   out: a handle to write the child's stdin, or 0
//   stdout_h  out: a handle to read the child's stdout, or 0
//   stderr_h  out: a handle to read the child's stderr, or 0
export struct AlphProcSpec {
  argv: cstring*;
  envp: cstring*;
  cwd: cstring;
  log: cstring;
  flags: int64;
  stdin_h: int64;
  stdout_h: int64;
  stderr_h: int64;
}

fn alph_cstr_len(at: int64) -> int64 {
  var n: int64 = 0;
  while (*(uint8*)(at + n) != 0) {
    n = n + 1;
  }
  return n;
}

// The environment this process started with, read once from
// /proc/self/environ, as a cstring array ending with 0; or 0 when it cannot
// be read.
fn alph_node_env(node: AlphNode*) -> int64 {
  if (alph_atomic_load(&node->env) != 0) {
    return node->env;
  }
  alph_spin_lock(&node->env_lock);
  if (node->env == 0) {
    var path: cstring = "/proc/self/environ";
    var fd: int64 = syscall(ALPH_SYS_OPEN, (int64)path, ALPH_O_RDONLY | ALPH_O_CLOEXEC, 0);
    var cap: int64 = 4096;
    var len: int64 = 0;
    var buf: int64 = (int64)malloc(cap + 1);
    while (fd >= 0 && buf != 0) {
      if (len == cap) {
        cap = cap * 2;
        var grown: int64 = (int64)malloc(cap + 1);
        if (grown != 0) {
          memcpy((rawptr)grown, (rawptr)buf, len);
        }
        free((rawptr)buf);
        buf = grown;
        if (buf == 0) {
          break;
        }
      }
      var got: int64 = alph_sys_read(fd, (rawptr)(buf + len), cap - len);
      if (got <= 0) {
        break;
      }
      len = len + got;
    }
    if (fd >= 0) {
      alph_sys_close(fd);
    }
    if (buf != 0) {
      *(uint8*)(buf + len) = 0;
      var count: int64 = 0;
      for i: int64 in 0..len {
        if (*(uint8*)(buf + i) == 0) {
          count = count + 1;
        }
      }
      var list: int64 = (int64)malloc((count + 1) * 8);
      if (list != 0) {
        var at: int64 = 0;
        var n: int64 = 0;
        while (at < len && n < count) {
          *(int64*)(list + n * 8) = buf + at;
          n = n + 1;
          at = at + alph_cstr_len(buf + at) + 1;
        }
        *(int64*)(list + n * 8) = 0;
        alph_atomic_store_sc(&node->env, list);
      } else {
        free((rawptr)buf);
      }
    }
  }
  alph_spin_unlock(&node->env_lock);
  return node->env;
}

// The file to execute for program name argv0, as a new block the caller
// frees: argv0 itself when it holds a slash, else the first executable
// match in the PATH of env. 0 when there is none.
fn alph_child_path(argv0: int64, env: int64) -> int64 {
  var name_len: int64 = alph_cstr_len(argv0);
  var slash: bool = false;
  for i: int64 in 0..name_len {
    if (*(uint8*)(argv0 + i) == 47) {
      slash = true;
    }
  }
  if (slash) {
    var copy: int64 = (int64)malloc(name_len + 1);
    if (copy != 0) {
      memcpy((rawptr)copy, (rawptr)argv0, name_len + 1);
    }
    return copy;
  }
  var dirs: int64 = 0;
  var at: int64 = env;
  while (at != 0 && *(int64*)at != 0) {
    var e: int64 = *(int64*)at;
    if (memcmp((rawptr)e, (rawptr)"PATH=", 5) == 0) {
      dirs = e + 5;
      break;
    }
    at = at + 8;
  }
  if (dirs == 0 || name_len == 0) {
    return 0;
  }
  var dirs_len: int64 = alph_cstr_len(dirs);
  var buf: int64 = (int64)malloc(dirs_len + name_len + 3);
  if (buf == 0) {
    return 0;
  }
  var start: int64 = 0;
  while (start <= dirs_len) {
    var end: int64 = start;
    while (end < dirs_len && *(uint8*)(dirs + end) != 58) {
      end = end + 1;
    }
    var n: int64 = end - start;
    if (n == 0) {
      *(uint8*)buf = 46;  // an empty entry means the working directory
      n = 1;
    } else {
      memcpy((rawptr)buf, (rawptr)(dirs + start), n);
    }
    *(uint8*)(buf + n) = 47;
    memcpy((rawptr)(buf + n + 1), (rawptr)argv0, name_len + 1);
    if (syscall(ALPH_SYS_ACCESS, buf, ALPH_X_OK) == 0) {
      return buf;
    }
    start = end + 1;
  }
  free((rawptr)buf);
  return 0;
}

// Runs in the new child, between clone and execve. The child of a threaded
// process may only make raw system calls here: no allocation, no checks
// that could trap. It never returns; a failure exits with 127.
fn alph_child_exec(path: int64, argv: int64, envp: int64, cwd: int64,
                   in_fd: int64, out_fd: int64, err_fd: int64, own_group: bool) {
  var none: int64 = 0;
  syscall(ALPH_SYS_RT_SIGPROCMASK, ALPH_SIG_SETMASK, (int64)&none, 0, 8);
  if (own_group) {
    syscall(ALPH_SYS_SETPGID, 0, 0);
  }
  if (cwd == 0 || syscall(ALPH_SYS_CHDIR, cwd) == 0) {
    if (in_fd >= 0) {
      syscall(ALPH_SYS_DUP2, in_fd, 0);
    }
    if (out_fd >= 0) {
      syscall(ALPH_SYS_DUP2, out_fd, 1);
    }
    if (err_fd >= 0) {
      syscall(ALPH_SYS_DUP2, err_fd, 2);
    }
    syscall(ALPH_SYS_EXECVE, path, argv, envp);
  }
  while (true) {
    syscall(ALPH_SYS_EXIT_GROUP, 127);
  }
}

// Reaps child, an OS pid this node started and has not reaped. Returns its
// exit code, or 128 + the signal that ended it; -1 when nohang is set and
// it still runs. Waits by pid, not pidfd: the pidfd is non-blocking.
fn alph_child_wait(child: int64, nohang: bool) -> int64 {
  var info: int32[32];
  for i: int64 in 0..32 {
    info[i] = 0;
  }
  var options: int64 = ALPH_WEXITED;
  if (nohang) {
    options = options | ALPH_WNOHANG;
  }
  if (syscall(ALPH_SYS_WAITID, ALPH_IDTYPE_PID, child, (int64)&info[0], options, 0) != 0 ||
      info[4] == 0) {
    return -1;
  }
  if ((int64)info[2] == ALPH_CLD_EXITED) {
    return (int64)info[6];
  }
  return 128 + (int64)info[6];
}

// A process handle became readable: its child has ended. Reaps it, closes
// the handle, and tells the owner.
fn alph_child_ended(s: AlphSched*, p: AlphProc*, slot: AlphIoSlot*, h: int64) -> int64 {
  var code: int64 = alph_child_wait(slot->child, true);
  if (code < 0) {
    var home: AlphSched* = (AlphSched*)slot->sched;
    alph_rx_modify(&home->rx, slot->fd, ALPH_RX_READ, ALPH_RX_ONESHOT, h);
    return -1;
  }
  slot->child = 0;
  var at: int64 = alph_vec_find(&p->io_handles, h);
  if (at >= 0) {
    alph_vec_remove_at(&p->io_handles, at);
  }
  alph_io_drop((AlphNode*)s->node, h, p->pid);
  var m: AlphMsg;
  alph_runtime_message(&m, ALPH_TAG_PROC_EXIT, 0, p->pid, h, code);
  return alph_deliver(s, p, &m);
}

fn alph_close_if(fd: int64) {
  if (fd >= 0) {
    alph_sys_close(fd);
  }
}

// An owned handle for the parent's end of a pipe, or 0 when the handle
// table is full (the end is closed then).
fn alph_pipe_handle(ctx: AlphCtx*, fd: int64) -> int64 {
  if (fd < 0) {
    return 0;
  }
  var h: int64 = alph_io_open(ctx, fd);
  if (h < 0) {
    alph_sys_close(fd);
    return 0;
  }
  return h;
}

// Starts a child process owned by the calling actor, in a process group of
// its own; with ALPH_PROC_KEEP_GROUP it stays in the node's group instead,
// so a terminal's Ctrl-C and foreground reads reach it (for an app run in
// the foreground), and only the child itself, not its own children, is
// signalled and killed. The child's end is reported once as ALPH_TAG_PROC_EXIT, ref =
// the returned handle, arg = its exit code or 128 + the signal that ended
// it (127 when the program could not be run); the handle is closed then.
// Piped streams are ordinary IO handles owned by the caller: arm and read
// them like sockets, and close them when done.
//
// When the owner exits before the child ends (crash included) or closes the
// handle with alph_io_close, the child's whole process group is killed and
// the child reaped. The handle can be moved with alph_io_give.
//
// Returns the process handle, or a negative errno with nothing started:
// -2 when the program is not found, -22 when argv is empty, -12 when
// memory or handles run out, or the errno of opening the log.
// Thread: a handler.
export fn alph_proc_spawn(ctx: AlphCtx*, spec: AlphProcSpec*) -> int64 {
  spec->stdin_h = 0;
  spec->stdout_h = 0;
  spec->stderr_h = 0;
  if (spec->argv == 0 || *(int64*)spec->argv == 0) {
    return -22;
  }
  var env: int64 = (int64)spec->envp;
  if (env == 0) {
    env = alph_node_env(ctx->node);
    if (env == 0) {
      return -12;
    }
  }
  var path: int64 = alph_child_path(*(int64*)spec->argv, env);
  if (path == 0) {
    return 0 - ALPH_ENOENT;
  }
  // fds[0..1] stdin, [2..3] stdout, [4..5] stderr: read end, write end.
  var fds: int32[6];
  for i: int64 in 0..6 {
    fds[i] = -1;
  }
  var err: int64 = 0;
  if ((spec->flags & ALPH_PROC_IN) != 0) {
    err = syscall(ALPH_SYS_PIPE2, (int64)&fds[0], ALPH_O_CLOEXEC);
  }
  if (err == 0 && (spec->flags & ALPH_PROC_OUT) != 0) {
    err = syscall(ALPH_SYS_PIPE2, (int64)&fds[2], ALPH_O_CLOEXEC);
  }
  if (err == 0 && (spec->flags & ALPH_PROC_ERR) != 0 && (spec->flags & ALPH_PROC_MERGE) == 0) {
    err = syscall(ALPH_SYS_PIPE2, (int64)&fds[4], ALPH_O_CLOEXEC);
  }
  var null_fd: int64 = -1;
  if (err == 0 && (spec->flags & ALPH_PROC_QUIET) != 0) {
    var dev_null: cstring = "/dev/null";
    null_fd = syscall(ALPH_SYS_OPEN, (int64)dev_null, ALPH_O_RDWR | ALPH_O_CLOEXEC, 0);
    if (null_fd < 0) {
      err = null_fd;
    }
  }
  var log_fd: int64 = -1;
  if (err == 0 && spec->log != 0) {
    log_fd = syscall(ALPH_SYS_OPEN, (int64)spec->log,
                     ALPH_O_WRONLY | ALPH_O_CREAT | ALPH_O_TRUNC | ALPH_O_CLOEXEC, 420);
    if (log_fd < 0) {
      err = log_fd;
    }
  }
  var in_fd: int64 = (int64)fds[0];
  var out_fd: int64 = (int64)fds[3];
  var err_fd: int64 = (int64)fds[5];
  if ((spec->flags & ALPH_PROC_MERGE) != 0) {
    err_fd = out_fd;
  }
  if (out_fd < 0) {
    out_fd = log_fd;
  }
  if (err_fd < 0) {
    err_fd = log_fd;
  }
  if (in_fd < 0) {
    in_fd = null_fd;
  }
  if (out_fd < 0) {
    out_fd = null_fd;
  }
  if (err_fd < 0) {
    err_fd = null_fd;
  }
  var own_group: bool = (spec->flags & ALPH_PROC_KEEP_GROUP) == 0;
  var pid: int64 = err;
  if (err == 0) {
    pid = syscall(ALPH_SYS_CLONE, ALPH_SIGCHLD, 0, 0, 0, 0);
    if (pid == 0) {
      alph_child_exec(path, (int64)spec->argv, env, (int64)spec->cwd, in_fd, out_fd, err_fd, own_group);
    }
  }
  // The child's ends belong to the child now.
  free((rawptr)path);
  alph_close_if((int64)fds[0]);
  alph_close_if((int64)fds[3]);
  alph_close_if((int64)fds[5]);
  alph_close_if(null_fd);
  alph_close_if(log_fd);
  var h: int64 = pid;
  var kill_to: int64 = pid;
  if (pid > 0 && own_group) {
    syscall(ALPH_SYS_SETPGID, pid, pid);
    kill_to = 0 - pid;
  }
  if (pid > 0) {
    var pidfd: int64 = syscall(ALPH_SYS_PIDFD_OPEN, pid, 0);
    h = pidfd;
    if (pidfd >= 0) {
      h = alph_io_open(ctx, pidfd);
      if (h < 0) {
        alph_sys_close(pidfd);
      }
    }
    if (h < 0) {
      // No way to watch it: undo the start.
      syscall(ALPH_SYS_KILL, kill_to, ALPH_SIGKILL);
      var info: int32[32];
      syscall(ALPH_SYS_WAITID, ALPH_IDTYPE_PID, pid, (int64)&info[0], ALPH_WEXITED, 0);
    } else {
      alph_io_slot(ctx->node, h)->child = pid;
      alph_io_slot(ctx->node, h)->kill_to = kill_to;
      alph_io_to_oneshot(ctx->node, alph_io_slot(ctx->node, h));
      alph_io_arm(ctx, h, ALPH_IO_IN);
    }
  }
  if (h < 0) {
    alph_close_if((int64)fds[1]);
    alph_close_if((int64)fds[2]);
    alph_close_if((int64)fds[4]);
    return h;
  }
  spec->stdin_h = alph_pipe_handle(ctx, (int64)fds[1]);
  spec->stdout_h = alph_pipe_handle(ctx, (int64)fds[2]);
  spec->stderr_h = alph_pipe_handle(ctx, (int64)fds[4]);
  return h;
}

// Sends OS signal sig (15 for SIGTERM, 9 for SIGKILL, ...) to the process
// group of the child behind process handle h, or to the child alone when it
// was started with ALPH_PROC_KEEP_GROUP. The end still arrives as
// ALPH_TAG_PROC_EXIT. A graceful stop is SIGTERM, then a timer, then
// SIGKILL.
//
// Returns 0, -9 when the caller does not own h, -3 when the child has
// already ended, or another negative errno. Thread: a handler.
export fn alph_proc_kill(ctx: AlphCtx*, h: int64, sig: int64) -> int64 {
  var slot: AlphIoSlot* = alph_io_mine(ctx, h);
  if (slot == 0) {
    return -9;
  }
  if (slot->child == 0) {
    return -3;
  }
  return syscall(ALPH_SYS_KILL, slot->kill_to, sig);
}

// The OS process id of the child behind process handle h, or 0 when the
// caller does not own h or the child has been reaped. Thread: a handler.
export fn alph_proc_os_pid(ctx: AlphCtx*, h: int64) -> int64 {
  var slot: AlphIoSlot* = alph_io_mine(ctx, h);
  if (slot == 0) {
    return 0;
  }
  return slot->child;
}

// ---- proactive healing -----------------------------------------------------
//
// An actor with a medic is not freed when it crashes. It is held in place:
// same pid, same links and monitors, its mailbox kept and still accepting,
// its state as the crash left it. The medic gets ALPH_TAG_CRASHED and
// decides: resume, retry the message, reset, or fail. Only fail makes the
// crash visible to links, monitors and supervisors. alph/heal/medic builds
// a medic on these functions; use them directly only to write your own.

// Holds a crashed actor for its medic. Returns false when it has none, and
// the crash ends the actor as usual.
fn alph_hold_for_medic(node: AlphNode*, p: AlphProc*) -> bool {
  var medic: int64 = alph_atomic_load(&p->medic);
  if (medic == 0 || alph_resolve(node, medic) == 0) {
    return false;
  }
  alph_atomic_store_sc(&p->status, ALPH_P_CRASHED);
  alph_signal(node, ALPH_SIG_CRASHED, p->pid, medic, 0, ALPH_CRASHED, 0);
  // If the medic exited meanwhile, its exit may have missed this actor.
  if (alph_resolve(node, medic) == 0 &&
      alph_atomic_cas(&p->status, ALPH_P_CRASHED, ALPH_P_EXITING) == ALPH_P_CRASHED) {
    return false;
  }
  return true;
}

// The crashed patient this medic may act on, or 0.
fn alph_held_patient(ctx: AlphCtx*, pid: int64) -> AlphProc* {
  var p: AlphProc* = alph_resolve(ctx->node, pid);
  if (p == 0 || alph_atomic_load(&p->medic) != ctx->self ||
      alph_atomic_load(&p->status) != ALPH_P_CRASHED) {
    return (AlphProc*)0;
  }
  return p;
}

fn alph_release_patient(ctx: AlphCtx*, p: AlphProc*) {
  alph_atomic_add(&ctx->node->healed, 1);
  alph_atomic_store_sc(&p->status, ALPH_P_IDLE);
  alph_wake(ctx->node, p);
}

fn alph_drop_poison(p: AlphProc*) {
  if (p->poison_heap != 0) {
    free((rawptr)p->poison_heap);
    p->poison_heap = 0;
  }
}

// Spawns a medic for the calling actor, which becomes its patient. When the
// patient crashes, the medic gets ALPH_TAG_CRASHED (from = the patient,
// arg = the reason) and must answer with one of alph_patient_resume, _reset
// or _fail. If a live medic is attached already it is kept, since a reset
// patient runs INIT again.
//
//   state, size  the medic's initial state, copied
//   handler      the medic's handler
//
// Returns the medic's pid, or 0. Thread: the patient's handler.
export fn alph_spawn_medic(ctx: AlphCtx*, state: rawptr, size: int64,
                           handler: fn(AlphCtx*, AlphMsg*) -> int64 with alloc, syscall, asm) -> int64 {
  var p: AlphProc* = alph_me(ctx);
  var current: int64 = alph_atomic_load(&p->medic);
  if (current != 0 && alph_resolve(ctx->node, current) != 0) {
    return current;
  }
  var medic: int64 = alph_spawn_raw(ctx->node, ctx->self, 0, 0, ctx->self, 0, state, size, handler);
  if (medic != 0) {
    alph_atomic_store_sc(&p->medic, medic);
  }
  return medic;
}

// For a medic: the crashed patient's state as the crash left it, which the
// medic may change. *size receives its size. Valid until the patient is
// resumed, reset or failed. Returns 0 when pid is not this medic's crashed
// patient. Thread: the medic's handler.
export fn alph_patient_state(ctx: AlphCtx*, pid: int64, size: int64*) -> rawptr {
  var p: AlphProc* = alph_held_patient(ctx, pid);
  if (p == 0) {
    *size = 0;
    return (rawptr)0;
  }
  *size = p->state_size;
  return (rawptr)p->state;
}

// For a medic: the message the patient was handling when it crashed. Valid
// until the patient is resumed, reset or failed. Returns 0 when pid is not
// this medic's crashed patient. Thread: the medic's handler.
export fn alph_patient_message(ctx: AlphCtx*, pid: int64) -> AlphMsg* {
  var p: AlphProc* = alph_held_patient(ctx, pid);
  if (p == 0) {
    return (AlphMsg*)0;
  }
  return &p->last_msg;
}

// For a medic: lets the patient go on with its state as it is now. With
// retry, the message it crashed on is handled again first; without, that
// message is dropped. Returns false when pid is not this medic's crashed
// patient. Thread: the medic's handler.
export fn alph_patient_resume(ctx: AlphCtx*, pid: int64, retry: bool) -> bool {
  var p: AlphProc* = alph_held_patient(ctx, pid);
  if (p == 0) {
    return false;
  }
  if (retry) {
    p->retry = 1;
  } else {
    alph_drop_poison(p);
  }
  alph_release_patient(ctx, p);
  return true;
}

// For a medic: starts the patient over from a copy of size bytes at state.
// Its heap is emptied, exits are no longer trapped, and it gets INIT again.
// Its pid, links, monitors and mailbox stay. If even the fresh state does
// not fit its heap limit, it exits with ALPH_CRASHED instead. Returns false
// when pid is not this medic's crashed patient. Thread: the medic's handler.
export fn alph_patient_reset(ctx: AlphCtx*, pid: int64, state: rawptr, size: int64) -> bool {
  var p: AlphProc* = alph_held_patient(ctx, pid);
  if (p == 0) {
    return false;
  }
  alph_drop_poison(p);
  alph_heap_clear(ctx->node, p);
  if (!alph_set_state(ctx->node, p, state, size)) {
    // No room even for the fresh state: give up as fail would.
    alph_atomic_store(&p->status, ALPH_P_EXITING);
    p->has_on_exit = 0;  // run by the medic, maybe on another thread: no hook
    alph_proc_exit(ctx->node, p, ALPH_CRASHED);
    return true;
  }
  p->trap_exit = 0;
  p->retry = 0;
  // INIT travels as a signal so it comes before anything already queued.
  alph_signal(ctx->node, ALPH_SIG_TIMER, p->parent, pid, 0, 0, ALPH_TAG_INIT);
  alph_release_patient(ctx, p);
  return true;
}

// For a medic: gives up. The patient exits with reason, which its links,
// monitors and supervisor see; passive healing takes over. Returns false
// when pid is not this medic's crashed patient. Thread: the medic's handler.
export fn alph_patient_fail(ctx: AlphCtx*, pid: int64, reason: int64) -> bool {
  var p: AlphProc* = alph_held_patient(ctx, pid);
  if (p == 0 || alph_atomic_cas(&p->status, ALPH_P_CRASHED, ALPH_P_EXITING) != ALPH_P_CRASHED) {
    return false;
  }
  p->has_on_exit = 0;  // run by the medic, maybe on another thread: no hook
  alph_proc_exit(ctx->node, p, reason);
  return true;
}

// ---- shutdown and OS signals -----------------------------------------------

const ALPH_TAG_SHUT_DEADLINE: int64 = 22;
const ALPH_TAG_SHUT_POLL: int64 = 23;
const ALPH_SHUT_POLL_MS: int64 = 10;
const ALPH_SHUT_POLLS: int64 = 100;  // after the kill, wait at most this many polls

// Records a top-level pid, dropping ones that have exited. Returns pid.
fn alph_root_add(node: AlphNode*, pid: int64) -> int64 {
  if (pid == 0) {
    return pid;
  }
  var roots: AlphVec* = (AlphVec*)node->roots;
  alph_spin_lock(&node->roots_lock);
  var i: int64 = roots->len;
  while (i > 0) {
    i = i - 1;
    if (alph_resolve(node, alph_vec_get(roots, i)) == 0) {
      alph_vec_remove_at(roots, i);
    }
  }
  alph_vec_push(roots, pid);
  alph_spin_unlock(&node->roots_lock);
  return pid;
}

// The state of the actor that runs a shutdown.
struct AlphShutdown {
  code: int64;
  deadline_ms: int64;
  next: int64;     // roots below this index are still to stop
  monitor: int64;  // on the root being stopped
  killing: int64;
  polls: int64;
}

// Stops the next live root, newest first. Moves to the kill once none is left.
fn alph_shutdown_next(ctx: AlphCtx*, st: AlphShutdown*) -> int64 {
  var node: AlphNode* = ctx->node;
  var roots: AlphVec* = (AlphVec*)node->roots;
  while (st->next > 0) {
    st->next = st->next - 1;
    alph_spin_lock(&node->roots_lock);
    var pid: int64 = 0;
    if (st->next < roots->len) {
      pid = alph_vec_get(roots, st->next);
    }
    alph_spin_unlock(&node->roots_lock);
    if (pid != 0 && alph_resolve(node, pid) != 0) {
      st->monitor = alph_monitor(ctx, pid);
      // From 0, as from outside the node, so a supervisor obeys it.
      alph_node_exit_signal(node, pid, ALPH_SHUTDOWN);
      return ALPH_CONTINUE;
    }
  }
  return alph_shutdown_kill(ctx, st);
}

// Kills every actor still alive, then halts once they are gone.
fn alph_shutdown_kill(ctx: AlphCtx*, st: AlphShutdown*) -> int64 {
  var node: AlphNode* = ctx->node;
  if (st->killing == 0) {
    st->killing = 1;
    for i: int64 in 0..node->capacity {
      var pid: int64 = alph_atomic_load(&alph_slot(node, i)->pid);
      if (pid != 0 && pid != ctx->self) {
        alph_node_exit_signal(node, pid, ALPH_KILL);
      }
    }
  }
  if (alph_atomic_load(&node->live) <= 1 || st->polls >= ALPH_SHUT_POLLS) {
    alph_node_halt(node, st->code);
    return alph_stop(ctx, ALPH_NORMAL);
  }
  st->polls = st->polls + 1;
  alph_start_timer(ctx, ALPH_SHUT_POLL_MS, ALPH_TAG_SHUT_POLL, 0);
  return ALPH_CONTINUE;
}

fn alph_shutdown_handle(ctx: AlphCtx*, m: AlphMsg*) -> int64 {
  var st: AlphShutdown* = (AlphShutdown*)ctx->state;
  if (m->tag == ALPH_TAG_INIT) {
    var node: AlphNode* = ctx->node;
    alph_spin_lock(&node->roots_lock);
    st->next = ((AlphVec*)node->roots)->len;
    alph_spin_unlock(&node->roots_lock);
    if (st->deadline_ms > 0) {
      alph_start_timer(ctx, st->deadline_ms, ALPH_TAG_SHUT_DEADLINE, 0);
    }
    return alph_shutdown_next(ctx, st);
  }
  if (st->killing != 0) {
    if (m->tag == ALPH_TAG_SHUT_POLL) {
      return alph_shutdown_kill(ctx, st);
    }
    return ALPH_CONTINUE;
  }
  if (m->tag == ALPH_TAG_DOWN && m->ref == st->monitor) {
    return alph_shutdown_next(ctx, st);
  }
  if (m->tag == ALPH_TAG_SHUT_DEADLINE) {
    return alph_shutdown_kill(ctx, st);
  }
  return ALPH_CONTINUE;
}

// Stops the node in order. Top-level actors (those from alph_node_spawn and
// friends) get ALPH_SHUTDOWN one at a time, newest first, each after the
// one before has exited, so a supervisor stops its children before an older
// root goes. At deadline_ms, or once the roots are gone, every actor still
// alive is killed; then the node halts and alph_node_wait returns code.
// Killed actors that own child processes kill and reap them as they exit.
// A bound actor blocked for ever in a system call cannot be killed and
// keeps alph_node_wait waiting; give blocking calls timeouts.
//
//   deadline_ms  time for the orderly part; 0 means no limit
//   code         what alph_node_wait returns
//
// Returns false when a shutdown has already begun. Thread: any.
export fn alph_node_shutdown(node: AlphNode*, deadline_ms: int64, code: int64) -> bool {
  if (alph_atomic_cas(&node->shutting, 0, 1) != 0) {
    return false;
  }
  var st: AlphShutdown;
  memset((rawptr)&st, 0, (int64)sizeof(AlphShutdown));
  st.code = code;
  st.deadline_ms = deadline_ms;
  if (alph_spawn_raw(node, 0, 0, 0, 0, 0, (rawptr)&st, (int64)sizeof(AlphShutdown),
                     &alph_shutdown_handle) == 0) {
    alph_node_halt(node, code);  // no room for the actor that would do it in order
  }
  return true;
}

// Stops the node in order, as alph_node_shutdown. Thread: a handler.
export fn alph_shutdown(ctx: AlphCtx*, deadline_ms: int64, code: int64) -> bool {
  return alph_node_shutdown(ctx->node, deadline_ms, code);
}

// Takes over the signals in mask (bits 1 << signo) for the node: resets
// each to its default action, blocks them in the calling thread, which the
// schedulers then inherit, and opens a signalfd for them. Returns false on
// failure.
fn alph_signals_take(node: AlphNode*, mask: int64) -> bool {
  if (mask == 0) {
    return true;
  }
  // An ignored signal is discarded even while blocked, so the signalfd
  // would never see it; a shell starts `cmd &` with SIGINT ignored.
  var action: int64[4];  // handler (0 = SIG_DFL), flags, restorer, mask
  for i: int64 in 0..4 {
    action[i] = 0;
  }
  for signo: int64 in 1..64 {
    if ((mask & ((int64)1 << signo)) != 0) {
      syscall(ALPH_SYS_RT_SIGACTION, signo, (int64)&action[0], 0, 8);
    }
  }
  var set: int64 = mask >> 1;  // the kernel's bit for signal n is n - 1
  if (syscall(ALPH_SYS_RT_SIGPROCMASK, ALPH_SIG_BLOCK, (int64)&set, 0, 8) != 0) {
    return false;
  }
  node->sigfd = syscall(ALPH_SYS_SIGNALFD4, -1, (int64)&set, 8, ALPH_O_NONBLOCK | ALPH_O_CLOEXEC);
  return node->sigfd >= 0;
}

// Reads every pending OS signal and passes each on. Runs on scheduler 0.
fn alph_signals_read(node: AlphNode*) {
  var info: int64[16];  // one signalfd_siginfo, 128 bytes
  while (alph_sys_read(node->sigfd, (rawptr)&info[0], 128) == 128) {
    var signo: int64 = info[0] & (((int64)1 << 32) - 1);
    var pid: int64 = alph_atomic_load(&node->sig_pid);
    if (pid != 0 && alph_signal(node, ALPH_SIG_TIMER, 0, pid, 0, signo, alph_atomic_load(&node->sig_tag))) {
      continue;
    }
    // Nobody takes them: the first starts a shutdown, a second halts.
    if (!alph_node_shutdown(node, 5000, 128 + signo)) {
      alph_node_halt(node, 128 + signo);
    }
  }
}

// Sends the OS signals the node took over (AlphConfig.signals) to actor
// pid as messages: tag, arg = the signal number (ALPH_SIGINT, ALPH_SIGTERM,
// ALPH_SIGHUP, ...). They are never dropped. pid 0, the default, or a pid
// that has exited, means the node handles them: the first starts
// alph_node_shutdown(node, 5000, 128 + signal), a second halts at once.
//
// A node that takes over signals resets each to its default action (a
// shell may start a program with SIGINT ignored) and blocks them in the
// thread that calls alph_node_start, so call that from main before
// starting other threads.
// Child processes start with every signal unblocked. Thread: any.
export fn alph_node_signals(node: AlphNode*, pid: int64, tag: int64) {
  alph_atomic_store(&node->sig_tag, tag);
  alph_atomic_store_sc(&node->sig_pid, pid);
}

// ---- schedulers and the node -----------------------------------------------

// Starts a scheduler of its own for one ALPH_BOUND actor. Returns 0 when
// memory or threads ran out.
fn alph_sched_bound(node: AlphNode*) -> AlphSched* {
  var s: AlphSched* = (AlphSched*)calloc(1, (int64)sizeof(AlphSched));
  if (s == 0) {
    return (AlphSched*)0;
  }
  alph_queue_init(&s->runq);
  s->index = -1;
  s->node = (int64)node;
  s->bound = 1;
  if (!alph_sched_init_io(s)) {
    free((rawptr)s);
    return (AlphSched*)0;
  }
  s->thread.recover.owner = (int64)s;
  s->handle = alph_thread_start(&s->thread, &alph_sched_main, (int64)s, node->stack_size);
  if (s->handle == 0) {
    free((rawptr)s);
    return (AlphSched*)0;
  }
  alph_spin_lock(&node->bound_lock);
  s->next_bound = node->bound_list;
  node->bound_list = (int64)s;
  alph_spin_unlock(&node->bound_lock);
  return s;
}

// After an actor exits: a bound scheduler stops with it.
fn alph_sched_finish(p: AlphProc*) {
  var s: AlphSched* = (AlphSched*)p->sched;
  if (s->bound != 0) {
    alph_atomic_store_sc(&s->done, 1);
    alph_sched_notify(s);
  }
}

// Turns ready handles into signals for their owners; the eventfd entry
// (data 0) only wakes the scheduler. timeout_ms 0 polls without waiting.
fn alph_sched_poll(s: AlphSched*, timeout_ns: int64) {
  var node: AlphNode* = (AlphNode*)s->node;
  alph_atomic_store(&s->polled_at, alph_now_ns());
  var ev: AlphRxEvent* = (AlphRxEvent*)s->rxev;
  var n: int64 = alph_rx_wait(&s->rx, ev, 64, timeout_ns);
  // Awake again before dispatching: the signals below wake actors at home
  // on s, and with sleeping still set every one of them would write s's
  // own eventfd, costing a write, a read and another trip through epoll.
  // The run loop pops the run queue right after this returns.
  alph_atomic_store_sc(&s->sleeping, 0);
  for i: int64 in 0..n {
    if (ev[i].kind != ALPH_RX_FD) {
      continue;  // a wake-up, or the timerfd for the next timer: just return
    }
    if (ev[i].data == 0) {
      alph_signals_read(node);  // the node's signalfd, on scheduler 0
    } else {
      var slot: AlphIoSlot* = alph_io_slot(node, ev[i].data);
      if (slot != 0) {
        var mask: int64 = ev[i].events & (ALPH_IO_IN | ALPH_IO_OUT | ALPH_IO_ERR | ALPH_IO_HUP);
        alph_io_event(node, slot, ev[i].data, mask);
      }
    }
  }
}

// Rescue, as BEAM's separate poll thread gives for free: when the OS pauses
// an awake scheduler's thread (a busy host), its sockets go unread and its
// actors wait for a whole time slice. A spinning scheduler s looks at the
// sockets of any awake scheduler that has not done so for ALPH_RESCUE_NS,
// turning ready ones into signals; the woken actors queue at their home,
// and idle schedulers steal them, sockets and all. The eventfd and
// signalfd entries are left for their owner.
fn alph_sched_rescue(s: AlphSched*, node: AlphNode*) {
  var t: int64 = alph_now_ns();
  for i: int64 in 0..node->sched_count {
    var v: AlphSched* = alph_sched_at(node, i);
    if (v == s || alph_atomic_load(&v->io_count) == 0 || alph_atomic_load(&v->sleeping) != 0) {
      continue;
    }
    var seen: int64 = alph_atomic_load(&v->polled_at);
    if (t - seen < ALPH_RESCUE_NS || alph_atomic_cas(&v->polled_at, seen, t) != seen) {
      continue;
    }
    alph_rescue_poll(node, v, s->events);
  }
}

// Reads v's ready handles for it, into buf (64 epoll_events), and turns
// them into signals: the woken owners queue at v, for idle schedulers to
// steal. The eventfd and signalfd entries are left for v. The caller has
// claimed v by moving its polled_at.
fn alph_rescue_poll(node: AlphNode*, v: AlphSched*, buf: int64) -> int64 {
  var n: int64 = alph_sys_epoll_wait(v->rx.epfd, (rawptr)buf, 64, 0);
  for k: int64 in 0..n {
    var data: int64 = alph_sys_event_data((rawptr)buf, k);
    if (data > 0) {
      var slot: AlphIoSlot* = alph_io_slot(node, data);
      if (slot != 0) {
        var mask: int64 = alph_sys_event_mask((rawptr)buf, k) &
                          (ALPH_IO_IN | ALPH_IO_OUT | ALPH_IO_ERR | ALPH_IO_HUP);
        alph_io_event(node, slot, data, mask);
      }
    }
  }
  return n;
}

// Work sharing. A scheduler with nothing to run sets hungry; a busy one with
// at least two actors waiting hands one to a hungry scheduler after each
// run. With one waiting it keeps it, so a chain of actors passing a single
// message along stays on one scheduler. Only a scheduler pops its own run
// queue, so the queues stay single-consumer: the busy one pops the actor
// it gives away. Bound schedulers neither give nor take.
fn alph_sched_hungry(s: AlphSched*, node: AlphNode*) {
  if (s->bound == 0 && alph_atomic_cas(&s->hungry, 0, 1) == 0) {
    alph_atomic_add(&node->hungry, 1);
  }
}

// s found work itself: it is no longer hungry.
fn alph_sched_fed(s: AlphSched*, node: AlphNode*) {
  if (alph_atomic_load(&s->hungry) != 0 && alph_atomic_cas(&s->hungry, 1, 0) == 1) {
    alph_atomic_add(&node->hungry, -1);
  }
}

fn alph_sched_share(s: AlphSched*, node: AlphNode*) {
  var qlen: int64 = alph_atomic_load(&s->qlen);
  if (s->bound != 0 || alph_atomic_load(&node->hungry) == 0 || qlen < 2) {
    return;
  }
  // Compaction, as BEAM does: hand work to a scheduler that is awake and
  // spinning; wake a sleeping one only when work is really piling up.
  var wake_sleepers: bool = qlen >= ALPH_SHARE_WAKE;
  for i: int64 in 0..node->sched_count {
    var h: AlphSched* = alph_sched_at(node, (s->index + 1 + i) % node->sched_count);
    if (h != s && alph_atomic_load(&h->hungry) != 0 && alph_sched_active(node, h) &&
        (wake_sleepers || alph_atomic_load(&h->sleeping) == 0) &&
        alph_atomic_cas(&h->hungry, 1, 0) == 1) {
      alph_atomic_add(&node->hungry, -1);
      var p: int64 = alph_runq_pop(s);
      if (p == 0) {
        alph_sched_hungry(h, node);  // nothing to give after all
        return;
      }
      // Socket owners take their sockets along, so events reach the new
      // home directly.
      alph_sched_give(s, node, (AlphProc*)p, h);
      return;
    }
  }
}

// Checks the run queue, and the scheduler's sockets, until work arrives or
// node->spin_ns passes, but not past the next timer (wait, in ns, or -1).
// Returns the actor to run, or 0.
// Bound schedulers do not spin: their one actor may block, and nobody else
// sends them work.
fn alph_sched_spin(s: AlphSched*, node: AlphNode*, wait: int64) -> int64 {
  var budget: int64 = node->spin_ns;
  if (s->bound != 0 || budget <= 0) {
    return 0;
  }
  if (s->spin_hits < ALPH_SPIN_HITS) {
    // Spins have mostly ended empty: work comes later than a spin lasts,
    // so one would burn its budget, and poll epoll for nothing, before
    // sleeping anyway. Every 16th idle stretch still spins, to notice when
    // the load picks up.
    s->spin_skips = s->spin_skips + 1;
    if (s->spin_skips % 16 != 0) {
      return 0;
    }
  }
  if (alph_atomic_add(&node->spinners, 1) >= node->max_spinners) {
    alph_atomic_add(&node->spinners, -1);
    return 0;  // enough schedulers spin already: sleep
  }
  var p: int64 = alph_sched_spin_for(s, node, wait, budget);
  alph_atomic_add(&node->spinners, -1);
  var hit: int64 = 0;
  if (p != 0) {
    hit = 1024;
  }
  s->spin_hits = s->spin_hits + (hit - s->spin_hits) / 8;  // weight 1/8
  return p;
}

fn alph_sched_spin_for(s: AlphSched*, node: AlphNode*, wait: int64, budget: int64) -> int64 {
  if (wait >= 0 && wait < budget) {
    budget = wait;
  }
  var until: int64 = alph_now_ns() + budget;
  var spins: int64 = 0;
  while (true) {
    var p: int64 = alph_runq_pop(s);
    if (p != 0) {
      return p;
    }
    alph_cpu_relax();
    spins = spins + 1;
    if (spins % 32 == 0) {
      p = alph_sched_steal(s, node);
      if (p != 0) {
        return p;
      }
    }
    if (spins % 128 == 0) {
      alph_sched_rescue(s, node);
    }
    // Sockets are watched through this scheduler's epoll set, so look at it
    // too, or a reply waits out the whole spin.
    if (spins % 16 == 0 && alph_atomic_load(&s->io_count) > 0) {
      alph_sched_poll(s, 0);
    }
    if (spins % 64 == 0) {
      if (alph_now_ns() >= until || alph_atomic_load(&node->halted) != 0) {
        return 0;
      }
    }
  }
  return 0;
}

// s found p to run. An active scheduler runs it; a draining one gives it
// to an active one, sockets and all. Returns whether it ran.
fn alph_sched_take(s: AlphSched*, node: AlphNode*, p: AlphProc*) -> bool {
  alph_sched_fed(s, node);
  if (!alph_sched_active(node, s)) {
    alph_sched_give(s, node, p, alph_sched_pick(node, p));
    return false;
  }
  alph_sched_working(s);
  alph_run_proc(s, p);
  return true;
}

fn alph_sched_main(arg: int64) -> int64 {
  var s: AlphSched* = (AlphSched*)arg;
  var node: AlphNode* = (AlphNode*)s->node;
  while (alph_atomic_load(&node->halted) == 0 && alph_atomic_load(&s->done) == 0) {
    alph_sched_quiet(s, node);
    var wait: int64 = alph_timers_fire(node, &s->timers);
    var p: int64 = alph_runq_pop(s);
    if (p != 0) {
      if (!alph_sched_take(s, node, (AlphProc*)p)) {
        continue;
      }
      alph_sched_share(s, node);
      alph_sched_rise(s, node);
      // A busy scheduler still looks at its handles, and at the load, now
      // and then.
      s->runs = s->runs + 1;
      if (alph_atomic_load(&s->io_count) > 0 || s->runs % 64 == 0) {
        var t: int64 = alph_now_ns();
        if (alph_atomic_load(&s->io_count) > 0 && t - s->polled_at > ALPH_IO_POLL_NS) {
          s->polled_at = t;
          alph_sched_poll(s, 0);
        }
        alph_balance(node, t);
      }
      continue;
    }
    // Out of work: offer to take some, and before sleeping keep checking
    // for a while, so work sent meanwhile is picked up with no eventfd
    // write and no epoll wake-up. A draining scheduler does neither.
    alph_sched_resting(s, node);
    if (alph_sched_active(node, s)) {
      alph_sched_hungry(s, node);
      p = alph_sched_steal(s, node);
      if (p == 0) {
        p = alph_sched_spin(s, node, wait);
      }
      if (p != 0) {
        alph_sched_take(s, node, (AlphProc*)p);
        continue;
      }
    } else {
      alph_sched_fed(s, node);
    }
    // Park in epoll. A pusher bumps wake after its push, then writes the
    // eventfd if sleeping is set; setting sleeping first and popping once
    // more closes the gap.
    alph_atomic_store_sc(&s->sleeping, 1);
    p = alph_runq_pop(s);
    if (p != 0) {
      alph_atomic_store(&s->sleeping, 0);
      alph_sched_take(s, node, (AlphProc*)p);
      continue;
    }
    if (alph_atomic_load(&node->halted) == 0 && alph_atomic_load(&s->done) == 0) {
      // The reactor's timerfd wakes it for the next timer to the
      // nanosecond, not rounded up to epoll's milliseconds.
      alph_atomic_store_sc(&s->quiet, alph_quiet_parked());
      alph_sched_poll(s, wait);
      alph_sched_quiet(s, node);
    }
    alph_atomic_store(&s->sleeping, 0);
  }
  if (s->bound != 0) {
    alph_rx_free(&s->rx);
  }
  return 0;
}

// Gives a scheduler its reactor and event buffers. Returns false on failure.
fn alph_sched_init_io(s: AlphSched*) -> bool {
  s->spin_hits = 1024;  // spin until spins prove useless
  s->events = (int64)malloc(64 * 12);
  s->rxev = (int64)malloc(64 * (int64)sizeof(AlphRxEvent));
  return s->events != 0 && s->rxev != 0 && alph_rx_init(&s->rx);
}

// Fills cfg with the defaults: one scheduler per CPU, 65536 actors, 64
// messages per mailbox, 1 MiB of stack per scheduler, no heap limit, 65536
// IO handles.
// Thread: any.
export fn alph_config(cfg: AlphConfig*) {
  cfg->schedulers = alph_cpu_count();
  cfg->max_actors = 65536;
  cfg->mailbox_size = 64;
  cfg->stack_size = 1048576;
  cfg->heap_limit = 0;
  cfg->max_handles = 65536;
  cfg->signals = 0;
  cfg->spin_us = 2;
  cfg->crash_reports = 0;
}

// Maps size bytes of zeroed memory straight from the kernel, which commits a
// page only when it is first touched: a node sized for a million actors
// costs memory for the slots it uses, not for all of them. Returns 0 on
// failure. The tables it backs live as long as the process.
fn alph_map_zeroed(size: int64) -> int64 {
  var got: int64 = syscall(ALPH_SYS_MMAP, 0, size, ALPH_PROT_READ_WRITE, ALPH_MAP_PRIVATE_ANONYMOUS, -1, 0);
  if (got < 0) {
    return 0;
  }
  return got;
}

// Starts a node: its schedulers begin running and actors can be spawned.
//
//   node  storage for the node; keep it in place until alph_node_wait returns
//   cfg   from alph_config, changed as needed; read here and not kept
//
// Returns false when cfg is out of range (no schedulers, no actors) or
// memory or threads run out.
// Thread: any, once per node.
export fn alph_node_start(node: AlphNode*, cfg: AlphConfig*) -> bool {
  if (cfg->schedulers < 1 || cfg->max_actors < 1 || cfg->max_actors > 2147483647 || cfg->mailbox_size < 1 ||
      cfg->max_handles < 1 || cfg->max_handles > 2147483647) {
    return false;
  }
  memset((rawptr)node, 0, (int64)sizeof(AlphNode));
  node->capacity = cfg->max_actors;
  node->mailbox_size = cfg->mailbox_size;
  node->heap_limit = cfg->heap_limit;
  node->stack_size = cfg->stack_size;
  node->spin_ns = cfg->spin_us * 1000;
  alph_recover_quiet(cfg->crash_reports == 0);
  // Like Go's runtime, only a few idle schedulers spin; the others sleep at
  // once, so light load stays on few threads and costs little CPU.
  node->max_spinners = cfg->schedulers / 8;
  if (node->max_spinners < 1) {
    node->max_spinners = 1;
  }
  node->procs = alph_map_zeroed(node->capacity * (int64)sizeof(AlphProc));
  node->free_stack = (int64)malloc(node->capacity * 8);
  node->scheds = (int64)calloc(cfg->schedulers, (int64)sizeof(AlphSched));
  if (node->procs == 0 || node->free_stack == 0 || node->scheds == 0) {
    return false;
  }
  for i: int64 in 0..node->capacity {
    var at: int64* = (int64*)(node->free_stack + i * 8);
    *at = node->capacity - 1 - i;
  }
  node->free_top = node->capacity;
  node->io_capacity = cfg->max_handles;
  node->ios = alph_map_zeroed(node->io_capacity * (int64)sizeof(AlphIoSlot));
  node->io_free_stack = (int64)malloc(node->io_capacity * 8);
  if (node->ios == 0 || node->io_free_stack == 0) {
    return false;
  }
  for i: int64 in 0..node->io_capacity {
    var at: int64* = (int64*)(node->io_free_stack + i * 8);
    *at = node->io_capacity - 1 - i;
  }
  node->io_free_top = node->io_capacity;
  node->roots = (int64)calloc(1, (int64)sizeof(AlphVec));
  node->sigfd = -1;
  if (node->roots == 0 || !alph_signals_take(node, cfg->signals)) {
    return false;
  }
  node->names = (int64)alph_reg_make(ALPH_REG_UNIQUE);
  node->groups = (int64)calloc(1, (int64)sizeof(AlphTable));
  if (node->names == 0 || node->groups == 0 || !alph_tab_init((AlphTable*)node->groups)) {
    return false;
  }
  node->sched_count = cfg->schedulers;
  node->active = cfg->schedulers;  // compaction trims it to the load
  for i: int64 in 0..node->sched_count {
    var s: AlphSched* = alph_sched_at(node, i);
    alph_queue_init(&s->runq);
    s->index = i;
    s->node = (int64)node;
    if (!alph_sched_init_io(s)) {
      return false;
    }
  }
  if (node->sigfd >= 0 &&
      alph_rx_add(&alph_sched_at(node, 0)->rx, node->sigfd, ALPH_RX_READ, ALPH_RX_LEVEL, 0) != 0) {
    return false;
  }
  for i: int64 in 0..node->sched_count {
    var s: AlphSched* = alph_sched_at(node, i);
    s->thread.recover.owner = (int64)s;
    s->handle = alph_thread_start(&s->thread, &alph_sched_main, (int64)s, cfg->stack_size);
    if (s->handle == 0) {
      return false;
    }
  }
  node->rt_offset = alph_realtime_ns() - alph_now_ns();
  node->sysmon_handle = alph_thread_start(&node->sysmon, &alph_sysmon_main, (int64)node, 65536);
  return node->sysmon_handle != 0;
}

// The watchdog, as Go's sysmon: actors are never preempted, so one long
// handler holds its scheduler, and whatever waits on that scheduler waits
// with it, while the node's other schedulers may sleep and never look (an
// actor woken onto its sender's scheduler, alph_wake_from, lands there by
// design). On each look it
//   - reads the sockets of an awake scheduler that has not polled them for
//     ALPH_RESCUE_NS, as spinning schedulers also do, so their owners queue;
//   - finds a scheduler still in the run it was in last time with work
//     queued behind it, and wakes a sleeping scheduler to steal that work.
// It looks every ALPH_SYSMON_NS after it had to act, doubling the pause
// after each quiet look up to ALPH_SYSMON_BUSY_NS while actors run and to
// ALPH_SYSMON_IDLE_NS while none do.
fn alph_sysmon_main(arg: int64) -> int64 {
  var node: AlphNode* = (AlphNode*)arg;
  var buf: int64 = (int64)malloc(64 * 12);
  var delay: int64 = ALPH_SYSMON_NS;
  while (alph_atomic_load(&node->halted) == 0) {
    var word: int64 = alph_atomic_load(&node->sysmon_word);
    if (delay > ALPH_SYSMON_BUSY_NS) {
      alph_atomic_store_sc(&node->sysmon_idle, 1);
      // A scheduler that started working before the flag was up missed
      // it: look at once.
      for i: int64 in 0..node->sched_count {
        if (alph_atomic_load(&alph_sched_at(node, i)->work_at) != 0) {
          delay = ALPH_SYSMON_NS;
        }
      }
      if (delay == ALPH_SYSMON_NS) {
        alph_atomic_store(&node->sysmon_idle, 0);
      }
    }
    alph_futex_wait(&node->sysmon_word, word, delay);
    alph_atomic_store(&node->sysmon_idle, 0);
    alph_atomic_add(&node->sysmon_looks, 1);
    alph_atomic_store(&node->rt_offset, alph_realtime_ns() - alph_now_ns());
    var busy: bool = false;
    var acted: bool = false;
    var t: int64 = alph_now_ns();
    for i: int64 in 0..node->sched_count {
      var s: AlphSched* = alph_sched_at(node, i);
      if (s->bound != 0) {
        continue;
      }
      var seq: int64 = alph_atomic_load(&s->run_seq);
      // Awake but not polling: in a long run, or paused by the OS.
      var seen: int64 = alph_atomic_load(&s->polled_at);
      if (buf != 0 && alph_atomic_load(&s->io_count) > 0 && alph_atomic_load(&s->sleeping) == 0 &&
          t - seen >= ALPH_RESCUE_NS && alph_atomic_cas(&s->polled_at, seen, t) == seen) {
        if (alph_rescue_poll(node, s, buf) > 0) {
          acted = true;
        }
      }
      if (alph_atomic_load(&s->current) != 0) {
        busy = true;
        if (seq == s->run_seen && alph_atomic_load(&s->qlen) > 0) {
          alph_sysmon_rescue(node, s);
          acted = true;
        }
      }
      s->run_seen = seq;
    }
    if (acted) {
      delay = ALPH_SYSMON_NS;
    } else if (busy) {
      if (delay < ALPH_SYSMON_BUSY_NS) {
        delay = delay * 2;
      } else {
        delay = ALPH_SYSMON_BUSY_NS;
      }
    } else if (delay < ALPH_SYSMON_IDLE_NS) {
      delay = delay * 2;
    }
  }
  free((rawptr)buf);
  return 0;
}

// Wakes a sleeping active scheduler other than stuck, which then steals
// from stuck's run queue. With none asleep (compaction may have left stuck
// the only active one), it activates one more, as alph_sched_rise does;
// when every scheduler is active and awake, they find the work themselves
// once their own runs end.
fn alph_sysmon_rescue(node: AlphNode*, stuck: AlphSched*) {
  var spare: AlphSched* = alph_sched_spare(node, stuck);
  if (spare != 0) {
    alph_atomic_add(&node->rescued, 1);
    alph_sched_notify(spare);  // it wakes, goes hungry and steals
  }
}

// A scheduler other than s with nothing to do: a sleeping active one, or
// one more activated now. 0 when every scheduler is active and awake.
fn alph_sched_spare(node: AlphNode*, s: AlphSched*) -> AlphSched* {
  var active: int64 = alph_atomic_load(&node->active);
  for i: int64 in 0..active {
    var v: AlphSched* = alph_sched_at(node, i);
    if (v != s && alph_atomic_load(&v->sleeping) != 0) {
      return v;
    }
  }
  if (active < node->sched_count && alph_atomic_cas(&node->active, active, active + 1) == active) {
    alph_atomic_store(&node->low_streak, 0);
    alph_atomic_store(&node->rise_at, alph_now_ns());
    return alph_sched_at(node, active);
  }
  return (AlphSched*)0;
}

// Stops the node: each scheduler finishes the actor it is running and
// exits, and alph_node_wait returns code. Actors still alive are not told.
// Thread: any. From a handler, alph_halt is the same.
export fn alph_node_halt(node: AlphNode*, code: int64) {
  node->halt_code = code;
  alph_atomic_store_sc(&node->halted, 1);
  alph_atomic_add(&node->sysmon_word, 1);
  alph_futex_wake(&node->sysmon_word, 1);
  for i: int64 in 0..node->sched_count {
    alph_sched_notify(alph_sched_at(node, i));
  }
  alph_spin_lock(&node->bound_lock);
  var bound: int64 = node->bound_list;
  while (bound != 0) {
    var s: AlphSched* = (AlphSched*)bound;
    alph_sched_notify(s);
    bound = s->next_bound;
  }
  alph_spin_unlock(&node->bound_lock);
}

// Stops the node, as alph_node_halt. The calling handler still returns
// normally. Thread: a handler.
export fn alph_halt(ctx: AlphCtx*, code: int64) {
  alph_node_halt(ctx->node, code);
}

// Waits until the node is halted and its schedulers have stopped. Returns
// the code given to alph_halt or alph_node_halt.
// Thread: any thread that is not one of the node's schedulers, typically
// main, once.
export fn alph_node_wait(node: AlphNode*) -> int64 {
  if (node->sysmon_handle != 0) {
    alph_thread_join(node->sysmon_handle, &node->sysmon);
    node->sysmon_handle = 0;
  }
  for i: int64 in 0..node->sched_count {
    var s: AlphSched* = alph_sched_at(node, i);
    alph_thread_join(s->handle, &s->thread);
  }
  var bound: int64 = node->bound_list;
  while (bound != 0) {
    var s: AlphSched* = (AlphSched*)bound;
    alph_thread_join(s->handle, &s->thread);
    bound = s->next_bound;
  }
  return node->halt_code;
}

// Copies the node's counters into *stats. Counters from different threads
// are read one by one, so they may be a moment apart. Thread: any.
export fn alph_node_stats(node: AlphNode*, stats: AlphStats*) {
  stats->live = alph_atomic_load(&node->live);
  stats->spawned = alph_atomic_load(&node->spawned);
  stats->crashed = alph_atomic_load(&node->crashed);
  stats->healed = alph_atomic_load(&node->healed);
  stats->shed = alph_atomic_load(&node->shed);
  stats->rehomed = alph_atomic_load(&node->rehomed);
  stats->rescued = alph_atomic_load(&node->rescued);
  stats->io_demoted = alph_atomic_load(&node->io_demoted);
  stats->active = alph_atomic_load(&node->active);
  stats->refused = alph_atomic_load(&node->refused);
  stats->yields = alph_atomic_load(&node->yields);
  stats->isolated = alph_atomic_load(&node->isolated);
}
