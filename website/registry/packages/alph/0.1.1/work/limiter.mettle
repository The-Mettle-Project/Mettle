// alph/work/limiter: a counting semaphore as an actor.
//
// A limiter holds a number of permits, such as the -j of a build or the
// connections a database allows. alph_acquire asks for one; the answer
// ALPH_TAG_GRANTED comes when one is free, first come first served. The
// holder gives it back with alph_release, and a holder that exits gives it
// back by its exit. alph_release on a request still waiting withdraws it.
//
//   var cpu: int64 = alph_spawn_limiter(ctx, 8);
//   var ref: int64 = alph_acquire(ctx, cpu);
//   ... ALPH_TAG_GRANTED with m->ref == ref: start the job
//   alph_release(ctx, cpu, ref);

import "std/mem";
import "alph/core/mailbox";
import "alph/core/node";

// The answer to alph_acquire: a permit is now the caller's. m->ref is the
// ref alph_acquire returned.
export const ALPH_TAG_GRANTED: int64 = 19;

const ALPH_TAG_LIMIT_ACQUIRE: int64 = 20;
const ALPH_TAG_LIMIT_RELEASE: int64 = 21;

// A request for a permit, waiting or granted.
struct AlphPermit {
  pid: int64;
  ref: int64;      // the request's ref, which names the permit
  monitor: int64;  // the limiter's monitor on pid
  granted: int64;
}

struct AlphLimiter {
  free: int64;     // permits not granted
  list: int64;     // AlphPermit array in the limiter's heap: granted and waiting, oldest first
  len: int64;
  cap: int64;
}

fn alph_limit_at(l: AlphLimiter*, i: int64) -> AlphPermit* {
  return (AlphPermit*)(l->list + i * (int64)sizeof(AlphPermit));
}

fn alph_limit_remove(l: AlphLimiter*, i: int64) {
  var size: int64 = (int64)sizeof(AlphPermit);
  if (i + 1 < l->len) {
    memmove((rawptr)(l->list + i * size), (rawptr)(l->list + (i + 1) * size), (l->len - i - 1) * size);
  }
  l->len = l->len - 1;
}

// Grants free permits to the oldest waiting requests.
fn alph_limit_grant(ctx: AlphCtx*, l: AlphLimiter*) {
  var i: int64 = 0;
  while (l->free > 0 && i < l->len) {
    var p: AlphPermit* = alph_limit_at(l, i);
    if (p->granted == 0) {
      p->granted = 1;
      l->free = l->free - 1;
      var request: AlphMsg;
      memset((rawptr)&request, 0, (int64)sizeof(AlphMsg));
      request.from = p->pid;
      request.ref = p->ref;
      // A full mailbox loses the grant, so the permit goes back at once.
      if (alph_reply(ctx, &request, ALPH_TAG_GRANTED, 0) != ALPH_SENT) {
        alph_demonitor(ctx, p->monitor);
        l->free = l->free + 1;
        alph_limit_remove(l, i);
        continue;
      }
    }
    i = i + 1;
  }
}

// Drops entry i, returning its permit if it held one.
fn alph_limit_drop(ctx: AlphCtx*, l: AlphLimiter*, i: int64) {
  if (alph_limit_at(l, i)->granted != 0) {
    l->free = l->free + 1;
  }
  alph_limit_remove(l, i);
  alph_limit_grant(ctx, l);
}

fn alph_limit_handle(ctx: AlphCtx*, m: AlphMsg*) -> int64 {
  var l: AlphLimiter* = (AlphLimiter*)ctx->state;
  if (m->tag == ALPH_TAG_LIMIT_ACQUIRE) {
    if (l->len == l->cap) {
      var cap: int64 = l->cap * 2;
      if (cap < 16) {
        cap = 16;
      }
      var grown: rawptr = alph_realloc(ctx, (rawptr)l->list, cap * (int64)sizeof(AlphPermit));
      if (grown == 0) {
        return ALPH_CONTINUE;  // the requester's timeout or DOWN covers it
      }
      l->list = (int64)grown;
      l->cap = cap;
    }
    var p: AlphPermit* = alph_limit_at(l, l->len);
    p->pid = m->from;
    p->ref = m->ref;
    p->monitor = alph_monitor(ctx, m->from);
    p->granted = 0;
    l->len = l->len + 1;
    alph_limit_grant(ctx, l);
    return ALPH_CONTINUE;
  }
  if (m->tag == ALPH_TAG_LIMIT_RELEASE) {
    for i: int64 in 0..l->len {
      var p: AlphPermit* = alph_limit_at(l, i);
      if (p->ref == m->arg && p->pid == m->from) {
        alph_demonitor(ctx, p->monitor);
        alph_limit_drop(ctx, l, i);
        break;
      }
    }
    return ALPH_CONTINUE;
  }
  if (m->tag == ALPH_TAG_DOWN) {
    // A holder or waiter exited: everything it had goes back.
    var i: int64 = 0;
    while (i < l->len) {
      if (alph_limit_at(l, i)->monitor == m->ref) {
        alph_limit_drop(ctx, l, i);
      } else {
        i = i + 1;
      }
    }
  }
  return ALPH_CONTINUE;
}

// Spawns a limiter with permits permits (at least 1), linked to the calling
// actor. Returns its pid, or 0. Thread: a handler. Outside the node, use
// alph_node_spawn_limiter.
export fn alph_spawn_limiter(ctx: AlphCtx*, permits: int64) -> int64 {
  if (permits < 1) {
    return 0;
  }
  var l: AlphLimiter;
  memset((rawptr)&l, 0, (int64)sizeof(AlphLimiter));
  l.free = permits;
  return alph_spawn_value<AlphLimiter>(ctx, ALPH_LINK, &l, &alph_limit_handle);
}

// Spawns a top-level limiter with no parent. Otherwise as
// alph_spawn_limiter. Thread: any.
export fn alph_node_spawn_limiter(node: AlphNode*, permits: int64) -> int64 {
  if (permits < 1) {
    return 0;
  }
  var l: AlphLimiter;
  memset((rawptr)&l, 0, (int64)sizeof(AlphLimiter));
  l.free = permits;
  return alph_node_spawn_value<AlphLimiter>(node, 0, &l, &alph_limit_handle);
}

// Asks limiter for one permit. ALPH_TAG_GRANTED with the returned ref comes
// when it is the caller's; ALPH_TAG_DOWN with that ref if the limiter is
// gone. There is no timeout: to give up waiting, use alph_release.
//
// Returns the ref, or ALPH_FULL or ALPH_NOMEM when the request was not
// sent. Thread: a handler.
export fn alph_acquire(ctx: AlphCtx*, limiter: int64) -> int64 {
  return alph_request(ctx, limiter, ALPH_TAG_LIMIT_ACQUIRE, 0, 0);
}

// Gives back the permit named by ref, or withdraws the request if it is
// still waiting; a GRANTED for ref already on its way is dropped. Returns
// as alph_send; on ALPH_FULL try again later, or exit, which also gives it
// back. Thread: a handler.
export fn alph_release(ctx: AlphCtx*, limiter: int64, ref: int64) -> int64 {
  alph_demonitor(ctx, ref);  // stops waiting for the GRANTED, if it has not come
  return alph_send(ctx, limiter, ALPH_TAG_LIMIT_RELEASE, ref);
}
