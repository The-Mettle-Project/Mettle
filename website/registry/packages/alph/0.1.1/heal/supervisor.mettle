// alph/heal/supervisor: passive healing, the OTP way.
//
// A supervisor is an actor that starts its children in order and restarts
// them when they exit, by strategy:
//
//   ALPH_ONE_FOR_ONE   restart only the child that exited
//   ALPH_ONE_FOR_ALL   stop every other child, then restart all of them
//   ALPH_REST_FOR_ONE  stop the children started after it, then restart it
//                      and them
//
// and by each child's restart type:
//
//   ALPH_PERMANENT  always restarted
//   ALPH_TRANSIENT  restarted unless it exited with ALPH_NORMAL or ALPH_SHUTDOWN
//   ALPH_TEMPORARY  never restarted
//
// A restarted child is a new actor with a new pid and its initial state;
// its INIT message's arg counts the starts before it (0 the first time).
// More than max_restarts restarts within period_ms and the supervisor gives
// up: it stops every child and exits with ALPH_SHUTDOWN, so its own
// supervisor sees the failure. Children stop in reverse start order: an
// ALPH_SHUTDOWN exit signal, then ALPH_KILL after the child's shutdown_ms.
//
// Unlike OTP, restarts can back off: consecutive restarts wait backoff_ms,
// doubling up to backoff_max_ms, and a quiet period_ms resets the streak.
//
//   var spec: AlphSupSpec;
//   alph_sup_init(&spec, ALPH_ONE_FOR_ONE);
//   alph_sup_add_value<Cache>(&spec, &cache, &cache_handler);
//   var db: AlphChildSpec* = alph_sup_add(&spec, &db_handler);
//   db->restart = ALPH_TRANSIENT;
//   alph_spawn_sup(ctx, &spec);

import "std/mem";
import "alph/sys/clock";
import "alph/core/mailbox";
import "alph/core/node";

// Restart strategies, for AlphSupSpec.strategy; described at the top of
// this module.
export const ALPH_ONE_FOR_ONE: int64 = 0;
export const ALPH_ONE_FOR_ALL: int64 = 1;
export const ALPH_REST_FOR_ONE: int64 = 2;

// Restart types, for AlphChildSpec.restart; described at the top of this
// module.
export const ALPH_PERMANENT: int64 = 0;
export const ALPH_TRANSIENT: int64 = 1;
export const ALPH_TEMPORARY: int64 = 2;

// Children one supervisor can hold. Nest supervisors for more, or use a
// dynamic supervisor (alph/heal/dynamic) for many alike.
export const ALPH_SUP_MAX_CHILDREN: int64 = 64;

// AlphChildSpec.shutdown_ms: wait for the child to stop, however long.
export const ALPH_SUP_WAIT: int64 = -1;

// The tag a sync_start child acknowledges with, through alph_sup_ack.
export const ALPH_TAG_ACK: int64 = 10;

const ALPH_TAG_SUP_TIMER: int64 = 11;

// The request alph_sup_which sends; both supervisor kinds answer it.
export const ALPH_TAG_SUP_WHICH: int64 = 44;

// The request alph_sup_terminate sends: arg = the child's pid.
export const ALPH_TAG_SUP_STOP: int64 = 45;

// The request alph_sup_restart sends: arg = the child's index.
export const ALPH_TAG_SUP_RESTART: int64 = 46;

// A supervisor's note to itself: a child it is stopping is past its
// shutdown_ms; arg = the child's pid.
export const ALPH_TAG_SUP_KILL: int64 = 47;

// The answer to alph_sup_which: arg = how many children, payload = that many
// AlphChildInfo.
export const ALPH_TAG_CHILDREN: int64 = 48;

// The answer to alph_sup_terminate and alph_sup_restart: arg = 1 (stopped)
// or the new pid (restarted), 0 when the supervisor could not do it.
export const ALPH_TAG_SUP_ANSWER: int64 = 49;

// One child, as alph_sup_which lists it.
//
//   pid     its pid, 0 while it is not running (stopped by
//           alph_sup_terminate, waiting to restart, or a finished temporary
//           child of a static supervisor)
//   index   its place in a static supervisor's spec; -1 in a dynamic one
//   starts  how many times it was started
export struct AlphChildInfo {
  pid: int64;
  index: int64;
  starts: int64;
}
const ALPH_SUP_RING: int64 = 64;

const ALPH_SUP_RUNNING: int64 = 0;
const ALPH_SUP_STARTING: int64 = 1;  // starting lo..hi-1; `at` may wait on an ack
const ALPH_SUP_STOPPING: int64 = 2;  // stopping from `at` down to lo
const ALPH_SUP_WAITING: int64 = 3;   // backing off before restarting lo..hi-1

// One child of a supervisor, as alph_sup_add returns it. Change these:
//
//   restart      ALPH_PERMANENT (default), ALPH_TRANSIENT or ALPH_TEMPORARY
//   shutdown_ms  how long it gets to stop before it is killed; 0 kills it at
//                once; ALPH_SUP_WAIT waits as long as it takes (the default
//                for a nested supervisor, so it stops its own children).
//                once. Default 5000
//   sync_start   when true, the next child starts only after this one calls
//                alph_sup_ack from its INIT handler. Default false
//   flags        spawn flags besides ALPH_LINK, such as ALPH_BOUND for a
//                child that may block. Default 0
//
// The other fields are set by alph_sup_add and alph_sup_add_sup.
export struct AlphChildSpec {
  restart: int64;
  shutdown_ms: int64;
  sync_start: bool;
  flags: int64;
  sup: int64;  // the AlphSupSpec of a nested supervisor, until spawned, or 0
  state: rawptr;
  state_size: int64;
  state_at: int64;
  handler: fn(AlphCtx*, AlphMsg*) -> int64 with alloc, syscall, asm;
}

// A supervisor's definition. Start it with alph_sup_init, add children with
// alph_sup_add, change these if needed, then spawn it:
//
//   strategy          ALPH_ONE_FOR_ONE, ALPH_ONE_FOR_ALL or ALPH_REST_FOR_ONE
//   max_restarts      restarts allowed within period_ms before giving up;
//                     default 1, as OTP (at most 63)
//   period_ms         default 5000; 0 means no limit, never give up
//   backoff_ms        wait before the first of consecutive restarts; 0
//                     (default) restarts at once
//   backoff_max_ms    cap on the doubling backoff; 0 means no cap
//   jitter_pct        each backoff is shortened by a random 0..jitter_pct
//                     percent, so supervisors hit by one failure do not all
//                     restart in step; 0 (default) is none, 20 is typical
//   start_timeout_ms  how long a sync_start child has to ack; default 5000
//
// count and children are filled by alph_sup_add.
export struct AlphSupSpec {
  strategy: int64;
  max_restarts: int64;
  period_ms: int64;
  backoff_ms: int64;
  backoff_max_ms: int64;
  jitter_pct: int64;
  start_timeout_ms: int64;
  count: int64;
  children: AlphChildSpec[64];
}

// The running supervisor's state. The children's initial states follow it
// in the same block.
struct AlphSup {
  spec: AlphSupSpec;
  pids: int64[64];
  reasons: int64[64];   // last exit reason, for exits handled later
  starts: int64[64];    // times each child was started, passed in INIT's arg
  held: int64;          // bit i: child i was stopped by alph_sup_terminate; not restarted
  stop_to: int64[64];   // who waits for child i's stop, and the request's ref
  stop_ref: int64[64];
  phase: int64;
  lo: int64;
  hi: int64;
  at: int64;
  then_exit: int64;     // after stopping: exit with exit_reason instead of restarting
  exit_reason: int64;
  timer: int64;         // ref of the pending ack, stop or backoff timer
  pending: int64;       // bit i: child i exited while busy, not yet handled
  removed: int64;       // bit i: temporary child i exited and is gone
  restarts: int64[64];  // times of recent restarts, a ring
  restart_count: int64;
  streak: int64;
  last_restart: int64;
  rng: int64;           // random state for jitter, seeded at INIT
}

// ---- building a spec -------------------------------------------------------

// Starts a supervisor definition with no children and OTP's defaults: at
// most 1 restart in 5000 ms, no backoff, 5000 ms for a child to ack.
// Thread: any.
export fn alph_sup_init(spec: AlphSupSpec*, strategy: int64) {
  memset((rawptr)spec, 0, (int64)sizeof(AlphSupSpec));
  spec->strategy = strategy;
  spec->max_restarts = 1;
  spec->period_ms = 5000;
  spec->start_timeout_ms = 5000;
}

// Adds a child whose state starts as a copy of size bytes at state on every
// start. The bytes are copied when the supervisor is spawned, so they need
// not outlive that call. Returns the child spec, with the defaults
// described at AlphChildSpec, or 0 when the supervisor already has
// ALPH_SUP_MAX_CHILDREN children. Children start in the order added.
// Thread: any.
export fn alph_sup_add_bytes(spec: AlphSupSpec*, state: rawptr, size: int64,
                             handler: fn(AlphCtx*, AlphMsg*) -> int64 with alloc, syscall, asm) -> AlphChildSpec* {
  if (spec->count >= ALPH_SUP_MAX_CHILDREN) {
    return (AlphChildSpec*)0;
  }
  var c: AlphChildSpec* = &spec->children[spec->count];
  c->restart = ALPH_PERMANENT;
  c->shutdown_ms = 5000;
  c->sync_start = false;
  c->flags = 0;
  c->sup = 0;
  c->state = state;
  c->state_size = size;
  c->state_at = 0;
  c->handler = handler;
  spec->count = spec->count + 1;
  return c;
}

// Adds a child whose state starts as a copy of *state. Otherwise as
// alph_sup_add_bytes. Thread: any.
export fn alph_sup_add_value<T>(spec: AlphSupSpec*, state: T*,
                                handler: fn(AlphCtx*, AlphMsg*) -> int64 with alloc, syscall, asm) -> AlphChildSpec* {
  return alph_sup_add_bytes(spec, (rawptr)state, (int64)sizeof(T), handler);
}

// Adds a child with no state. Otherwise as alph_sup_add_bytes. Thread: any.
export fn alph_sup_add(spec: AlphSupSpec*,
                       handler: fn(AlphCtx*, AlphMsg*) -> int64 with alloc, syscall, asm) -> AlphChildSpec* {
  return alph_sup_add_bytes(spec, (rawptr)0, 0, handler);
}

// Adds a supervisor as a child, so trees nest as in OTP. The child
// supervisor is built from child, which, like a child's initial state, is
// read when the parent is spawned: keep it, and the states its children
// copy, alive until then. Its shutdown_ms is ALPH_SUP_WAIT, OTP's infinity
// for supervisors. Returns the child spec, or 0 when spec is full.
// Thread: any.
export fn alph_sup_add_sup(spec: AlphSupSpec*, child: AlphSupSpec*) -> AlphChildSpec* {
  var c: AlphChildSpec* = alph_sup_add_bytes(spec, (rawptr)0, 0, &alph_sup_handle);
  if (c != 0) {
    c->sup = (int64)child;
    c->shutdown_ms = ALPH_SUP_WAIT;
  }
  return c;
}

// Tells the supervisor this child finished starting. Only for children with
// sync_start; call it from the INIT handler, passing the INIT message.
// Thread: the child's handler.
export fn alph_sup_ack(ctx: AlphCtx*, init: AlphMsg*) {
  alph_send(ctx, init->from, ALPH_TAG_ACK, 0);
}

// ---- managing a running supervisor ------------------------------------------

// Answers a request whose sender and ref were kept for later.
fn alph_sup_answer(ctx: AlphCtx*, to: int64, ref: int64, tag: int64, arg: int64) {
  var req: AlphMsg;
  memset((rawptr)&req, 0, (int64)sizeof(AlphMsg));
  req.from = to;
  req.ref = ref;
  alph_reply(ctx, &req, tag, arg);
}

// Asks child pid to stop: ALPH_SHUTDOWN, then ALPH_KILL after shutdown_ms
// (0 kills at once; ALPH_SUP_WAIT never kills).
fn alph_sup_stop_one(ctx: AlphCtx*, pid: int64, shutdown_ms: int64) {
  if (shutdown_ms == 0) {
    alph_exit_signal(ctx, pid, ALPH_KILL);
    return;
  }
  alph_exit_signal(ctx, pid, ALPH_SHUTDOWN);
  if (shutdown_ms > 0) {
    alph_send_after(ctx, shutdown_ms, ctx->self, ALPH_TAG_SUP_KILL, pid);
  }
}

// Asks supervisor sup, static or dynamic, for its children. The answer is
// ALPH_TAG_CHILDREN: arg = how many, payload = that many AlphChildInfo (read
// with alph_msg_bytes); as for any request, ALPH_TAG_DOWN or
// ALPH_TAG_TIMEOUT may come instead. Each carries the returned ref.
// Returns as alph_request. Thread: a handler.
export fn alph_sup_which(ctx: AlphCtx*, sup: int64, timeout_ms: int64) -> int64 {
  return alph_request(ctx, sup, ALPH_TAG_SUP_WHICH, 0, timeout_ms);
}

// Asks supervisor sup, static or dynamic, to stop its child pid and not
// restart it: ALPH_SHUTDOWN, then a kill after the child's shutdown_ms. The
// answer, ALPH_TAG_SUP_ANSWER, comes once the child has exited (arg 1), or
// at once with arg 0 when pid is not its child or it is busy restarting.
// A static supervisor keeps the child's spec, so alph_sup_restart can start
// it again; a dynamic one forgets the child. Returns as alph_request.
// Thread: a handler.
export fn alph_sup_terminate(ctx: AlphCtx*, sup: int64, pid: int64, timeout_ms: int64) -> int64 {
  return alph_request(ctx, sup, ALPH_TAG_SUP_STOP, pid, timeout_ms);
}

// Asks static supervisor sup to start again child index (its place in the
// spec), stopped by alph_sup_terminate. The answer is ALPH_TAG_SUP_ANSWER
// with the new pid, or 0 when that child is not stopped, the index is
// wrong, or sup is a dynamic supervisor. Returns as alph_request.
// Thread: a handler.
export fn alph_sup_restart(ctx: AlphCtx*, sup: int64, index: int64, timeout_ms: int64) -> int64 {
  return alph_request(ctx, sup, ALPH_TAG_SUP_RESTART, index, timeout_ms);
}

// ---- phases ----------------------------------------------------------------

fn alph_sup_bit(i: int64) -> int64 {
  return (int64)1 << i;
}

fn alph_sup_cancel(ctx: AlphCtx*, s: AlphSup*) {
  if (s->timer != 0) {
    alph_cancel_timer(ctx, s->timer);
    s->timer = 0;
  }
}

// The child index of pid, or -1. A stopped child's slot holds 0, which is
// also the sender of an exit signal from outside, so 0 matches nothing.
fn alph_sup_child_index(s: AlphSup*, pid: int64) -> int64 {
  if (pid == 0) {
    return -1;
  }
  for i: int64 in 0..s->spec.count {
    if (s->pids[i] == pid) {
      return i;
    }
  }
  return -1;
}

fn alph_sup_start_next(ctx: AlphCtx*, s: AlphSup*) -> int64 {
  while (s->at < s->hi) {
    var i: int64 = s->at;
    if (s->pids[i] != 0 || ((s->removed | s->held) & alph_sup_bit(i)) != 0) {
      s->at = s->at + 1;
      continue;
    }
    var c: AlphChildSpec* = &s->spec.children[i];
    var pid: int64 = alph_spawn_bytes_arg(ctx, ALPH_LINK | c->flags, c->state, c->state_size, s->starts[i],
                                          c->handler);
    if (pid == 0) {
      return alph_sup_stop_range(ctx, s, 0, s->spec.count, true, ALPH_SHUTDOWN);
    }
    s->pids[i] = pid;
    s->starts[i] = s->starts[i] + 1;
    if (c->sync_start) {
      s->timer = alph_start_timer(ctx, s->spec.start_timeout_ms, ALPH_TAG_SUP_TIMER, 0);
      return ALPH_CONTINUE;
    }
    s->at = s->at + 1;
  }
  s->phase = ALPH_SUP_RUNNING;
  return alph_sup_drain_pending(ctx, s);
}

fn alph_sup_start(ctx: AlphCtx*, s: AlphSup*, lo: int64, hi: int64) -> int64 {
  alph_sup_cancel(ctx, s);
  s->phase = ALPH_SUP_STARTING;
  s->lo = lo;
  s->hi = hi;
  s->at = lo;
  return alph_sup_start_next(ctx, s);
}

fn alph_sup_restart_later(ctx: AlphCtx*, s: AlphSup*) -> int64 {
  if (s->spec.backoff_ms <= 0) {
    return alph_sup_start(ctx, s, s->lo, s->hi);
  }
  var shift: int64 = s->streak - 1;
  if (shift > 16) {
    shift = 16;
  }
  var delay: int64 = s->spec.backoff_ms << shift;
  if (s->spec.backoff_max_ms > 0 && delay > s->spec.backoff_max_ms) {
    delay = s->spec.backoff_max_ms;
  }
  if (s->spec.jitter_pct > 0 && s->spec.jitter_pct <= 100) {
    // A 31-bit linear congruential step: plenty for spreading restarts.
    s->rng = (s->rng * (int64)1103515245 + (int64)12345) & (int64)2147483647;
    var r: int64 = s->rng;
    delay = delay - (delay * s->spec.jitter_pct / 100) * (r % 1001) / 1000;
  }
  s->phase = ALPH_SUP_WAITING;
  s->timer = alph_start_timer(ctx, delay, ALPH_TAG_SUP_TIMER, 0);
  return ALPH_CONTINUE;
}

fn alph_sup_stop_next(ctx: AlphCtx*, s: AlphSup*) -> int64 {
  while (s->at >= s->lo) {
    var pid: int64 = s->pids[s->at];
    if (pid != 0) {
      var c: AlphChildSpec* = &s->spec.children[s->at];
      if (c->shutdown_ms == 0) {
        alph_exit_signal(ctx, pid, ALPH_KILL);
      } else {
        alph_exit_signal(ctx, pid, ALPH_SHUTDOWN);
        if (c->shutdown_ms > 0) {
          s->timer = alph_start_timer(ctx, c->shutdown_ms, ALPH_TAG_SUP_TIMER, 0);
        }
      }
      return ALPH_CONTINUE;  // its EXIT continues the stop
    }
    s->at = s->at - 1;
  }
  if (s->then_exit != 0) {
    return alph_stop(ctx, s->exit_reason);
  }
  return alph_sup_restart_later(ctx, s);
}

// Stops children hi-1 down to lo, then exits (then_exit) or restarts lo..hi-1.
fn alph_sup_stop_range(ctx: AlphCtx*, s: AlphSup*, lo: int64, hi: int64, then_exit: bool,
                       reason: int64) -> int64 {
  alph_sup_cancel(ctx, s);
  s->phase = ALPH_SUP_STOPPING;
  s->lo = lo;
  s->hi = hi;
  s->at = hi - 1;
  s->then_exit = 0;
  if (then_exit) {
    s->then_exit = 1;
  }
  s->exit_reason = reason;
  return alph_sup_stop_next(ctx, s);
}

// Records a restart. Returns false when it breaks the restart intensity.
fn alph_sup_note_restart(s: AlphSup*) -> bool {
  var now: int64 = alph_now_ms();
  s->restarts[s->restart_count % ALPH_SUP_RING] = now;
  s->restart_count = s->restart_count + 1;
  var kept: int64 = s->restart_count;
  if (kept > ALPH_SUP_RING) {
    kept = ALPH_SUP_RING;
  }
  var recent: int64 = 0;
  for k: int64 in 0..kept {
    if (now - s->restarts[k] < s->spec.period_ms) {
      recent = recent + 1;
    }
  }
  if (recent > s->spec.max_restarts) {
    return false;
  }
  if (now - s->last_restart > s->spec.period_ms) {
    s->streak = 0;
  }
  s->streak = s->streak + 1;
  s->last_restart = now;
  return true;
}

fn alph_sup_child_failed(ctx: AlphCtx*, s: AlphSup*, i: int64, reason: int64) -> int64 {
  var c: AlphChildSpec* = &s->spec.children[i];
  if (c->restart == ALPH_TEMPORARY) {
    s->removed = s->removed | alph_sup_bit(i);
    return ALPH_CONTINUE;
  }
  if (c->restart == ALPH_TRANSIENT && (reason == ALPH_NORMAL || reason == ALPH_SHUTDOWN)) {
    return ALPH_CONTINUE;
  }
  if (!alph_sup_note_restart(s)) {
    return alph_sup_stop_range(ctx, s, 0, s->spec.count, true, ALPH_SHUTDOWN);
  }
  if (s->spec.strategy == ALPH_ONE_FOR_ALL) {
    return alph_sup_stop_range(ctx, s, 0, s->spec.count, false, 0);
  }
  if (s->spec.strategy == ALPH_REST_FOR_ONE) {
    return alph_sup_stop_range(ctx, s, i, s->spec.count, false, 0);
  }
  return alph_sup_stop_range(ctx, s, i, i + 1, false, 0);
}

// Handles exits that arrived while the supervisor was busy.
fn alph_sup_drain_pending(ctx: AlphCtx*, s: AlphSup*) -> int64 {
  for i: int64 in 0..s->spec.count {
    if (s->phase != ALPH_SUP_RUNNING) {
      return ALPH_CONTINUE;
    }
    var bit: int64 = alph_sup_bit(i);
    if ((s->pending & bit) != 0) {
      s->pending = s->pending & ~bit;
      if (s->pids[i] == 0 && ((s->removed | s->held) & bit) == 0) {
        var result: int64 = alph_sup_child_failed(ctx, s, i, s->reasons[i]);
        if (result != ALPH_CONTINUE) {
          return result;
        }
      }
    }
  }
  return ALPH_CONTINUE;
}

fn alph_sup_exited(ctx: AlphCtx*, s: AlphSup*, from: int64, reason: int64) -> int64 {
  var i: int64 = alph_sup_child_index(s, from);
  if (i < 0) {
    // The parent, or an exit signal from outside: shut down. Other exits
    // (an actor linked by hand) are ignored, as in OTP.
    if (from == alph_parent(ctx) || from == 0) {
      return alph_sup_stop_range(ctx, s, 0, s->spec.count, true, reason);
    }
    return ALPH_CONTINUE;
  }
  s->pids[i] = 0;
  s->reasons[i] = reason;
  if (s->stop_to[i] != 0) {
    // Stopped by alph_sup_terminate: tell whoever asked.
    alph_sup_answer(ctx, s->stop_to[i], s->stop_ref[i], ALPH_TAG_SUP_ANSWER, 1);
    s->stop_to[i] = 0;
  }
  if (s->phase == ALPH_SUP_STOPPING && i == s->at) {
    alph_sup_cancel(ctx, s);
    s->at = s->at - 1;
    return alph_sup_stop_next(ctx, s);
  }
  if (s->phase == ALPH_SUP_STARTING && i == s->at) {
    // Died before it acked: a start failure, which OTP does not retry.
    alph_sup_cancel(ctx, s);
    return alph_sup_stop_range(ctx, s, 0, s->spec.count, true, ALPH_SHUTDOWN);
  }
  if ((s->held & alph_sup_bit(i)) != 0) {
    return ALPH_CONTINUE;  // stopped on purpose: not a failure
  }
  if (s->phase != ALPH_SUP_RUNNING) {
    s->pending = s->pending | alph_sup_bit(i);
    return ALPH_CONTINUE;
  }
  return alph_sup_child_failed(ctx, s, i, reason);
}

fn alph_sup_timeout(ctx: AlphCtx*, s: AlphSup*) -> int64 {
  s->timer = 0;
  if (s->phase == ALPH_SUP_STARTING) {
    // No ack in time: stop what started, including the silent child.
    return alph_sup_stop_range(ctx, s, 0, s->spec.count, true, ALPH_SHUTDOWN);
  }
  if (s->phase == ALPH_SUP_STOPPING) {
    // It ignored the shutdown; its EXIT follows the kill.
    alph_exit_signal(ctx, s->pids[s->at], ALPH_KILL);
    return ALPH_CONTINUE;
  }
  if (s->phase == ALPH_SUP_WAITING) {
    return alph_sup_start(ctx, s, s->lo, s->hi);
  }
  return ALPH_CONTINUE;
}

// A supervisor's handler, for starting one where a handler is asked for,
// with a state from alph_sup_bytes. Thread: the runtime calls it.
export fn alph_sup_handle(ctx: AlphCtx*, m: AlphMsg*) -> int64 {
  var s: AlphSup* = (AlphSup*)ctx->state;
  if (m->tag == ALPH_TAG_INIT) {
    alph_trap_exits(ctx, true);
    s->rng = (ctx->self ^ alph_now_ns()) & (int64)2147483647;
    // The children's initial states were copied in behind the AlphSup.
    for i: int64 in 0..s->spec.count {
      var c: AlphChildSpec* = &s->spec.children[i];
      c->state = (rawptr)((int64)ctx->state + c->state_at);
    }
    return alph_sup_start(ctx, s, 0, s->spec.count);
  }
  if (m->tag == ALPH_TAG_EXIT) {
    return alph_sup_exited(ctx, s, m->from, m->arg);
  }
  if (m->tag == ALPH_TAG_ACK) {
    if (s->phase == ALPH_SUP_STARTING && s->at < s->hi && m->from == s->pids[s->at]) {
      alph_sup_cancel(ctx, s);
      s->at = s->at + 1;
      return alph_sup_start_next(ctx, s);
    }
    return ALPH_CONTINUE;
  }
  if (m->tag == ALPH_TAG_SUP_TIMER && m->ref == s->timer) {
    return alph_sup_timeout(ctx, s);
  }
  if (m->tag == ALPH_TAG_SUP_WHICH) {
    var info: AlphChildInfo* = (AlphChildInfo*)alph_scratch(ctx, s->spec.count * (int64)sizeof(AlphChildInfo) + 8);
    if (info == 0) {
      alph_reply(ctx, m, ALPH_TAG_CHILDREN, 0);
      return ALPH_CONTINUE;
    }
    for i: int64 in 0..s->spec.count {
      info[i].pid = s->pids[i];
      info[i].index = i;
      info[i].starts = s->starts[i];
    }
    alph_reply_full(ctx, m, ALPH_TAG_CHILDREN, s->spec.count, (rawptr)info,
                    s->spec.count * (int64)sizeof(AlphChildInfo));
    return ALPH_CONTINUE;
  }
  if (m->tag == ALPH_TAG_SUP_STOP) {
    var i: int64 = alph_sup_child_index(s, m->arg);
    if (i < 0 || s->phase != ALPH_SUP_RUNNING || (s->held & alph_sup_bit(i)) != 0) {
      alph_reply(ctx, m, ALPH_TAG_SUP_ANSWER, 0);
      return ALPH_CONTINUE;
    }
    var c: AlphChildSpec* = &s->spec.children[i];
    s->held = s->held | alph_sup_bit(i);
    s->stop_to[i] = m->from;
    s->stop_ref[i] = m->ref;
    alph_sup_stop_one(ctx, m->arg, c->shutdown_ms);
    return ALPH_CONTINUE;
  }
  if (m->tag == ALPH_TAG_SUP_RESTART) {
    var i: int64 = m->arg;
    if (i < 0 || i >= s->spec.count || s->phase != ALPH_SUP_RUNNING ||
        (s->held & alph_sup_bit(i)) == 0 || s->pids[i] != 0) {
      alph_reply(ctx, m, ALPH_TAG_SUP_ANSWER, 0);
      return ALPH_CONTINUE;
    }
    var c: AlphChildSpec* = &s->spec.children[i];
    var pid: int64 = alph_spawn_bytes_arg(ctx, ALPH_LINK | c->flags, c->state, c->state_size, s->starts[i],
                                          c->handler);
    if (pid != 0) {
      s->held = s->held & ~alph_sup_bit(i);
      s->pids[i] = pid;
      s->starts[i] = s->starts[i] + 1;
    }
    alph_reply(ctx, m, ALPH_TAG_SUP_ANSWER, pid);
    return ALPH_CONTINUE;
  }
  if (m->tag == ALPH_TAG_SUP_KILL) {
    var i: int64 = alph_sup_child_index(s, m->arg);
    if (i >= 0 && (s->held & alph_sup_bit(i)) != 0) {
      alph_exit_signal(ctx, m->arg, ALPH_KILL);
    }
  }
  return ALPH_CONTINUE;
}

// ---- spawning --------------------------------------------------------------

// The size of a supervisor's state: an AlphSup followed by a copy of every
// child's initial state, a nested supervisor's whole state included.
fn alph_sup_size(spec: AlphSupSpec*) -> int64 {
  var total: int64 = (int64)sizeof(AlphSup);
  for i: int64 in 0..spec->count {
    var c: AlphChildSpec* = &spec->children[i];
    if (c->sup != 0) {
      total = total + alph_sup_size((AlphSupSpec*)c->sup);
    } else {
      total = total + c->state_size;
    }
  }
  return total;
}

// Writes a supervisor's state at block, which has alph_sup_size(spec)
// bytes. Offsets are relative to block, so the state can be copied as is.
fn alph_sup_fill(spec: AlphSupSpec*, block: rawptr) {
  memset(block, 0, (int64)sizeof(AlphSup));
  var sup: AlphSup* = (AlphSup*)block;
  sup->spec = *spec;
  var at: int64 = (int64)sizeof(AlphSup);
  for i: int64 in 0..spec->count {
    var c: AlphChildSpec* = &sup->spec.children[i];
    c->state_at = at;
    if (c->sup != 0) {
      var nested: AlphSupSpec* = (AlphSupSpec*)c->sup;
      c->state_size = alph_sup_size(nested);
      alph_sup_fill(nested, (rawptr)((int64)block + at));
      c->sup = 0;  // built; the spec it came from may go
    } else if (c->state_size > 0) {
      memcpy((rawptr)((int64)block + at), c->state, c->state_size);
    }
    at = at + c->state_size;
  }
}

// Builds the supervisor's state. Returns the block (malloc'd) and its size
// in *size.
fn alph_sup_state(spec: AlphSupSpec*, size: int64*) -> rawptr {
  var total: int64 = alph_sup_size(spec);
  var block: rawptr = malloc(total);
  if (block == 0) {
    return (rawptr)0;
  }
  alph_sup_fill(spec, block);
  *size = total;
  return block;
}

// A supervisor's initial state, built from spec, for starting it where a
// state and handler are asked for, such as alph_dyn_start_with with
// alph_sup_handle. Returns a malloc'd block, its size in *size; free it
// once it has been copied. Returns 0 when out of memory. Thread: any.
export fn alph_sup_bytes(spec: AlphSupSpec*, size: int64*) -> rawptr {
  return alph_sup_state(spec, size);
}

// Spawns a supervisor linked to the calling actor, which becomes its parent:
// if the parent exits, the supervisor stops its children and exits too.
//
//   spec  the definition; copied, along with every child's initial state
//
// Returns the supervisor's pid, or 0 when the node is full or out of
// memory. Thread: a handler. Outside the node, use alph_node_spawn_sup.
export fn alph_spawn_sup(ctx: AlphCtx*, spec: AlphSupSpec*) -> int64 {
  var size: int64 = 0;
  var block: rawptr = alph_sup_state(spec, &size);
  if (block == 0) {
    return 0;
  }
  var pid: int64 = alph_spawn_bytes(ctx, ALPH_LINK, block, size, &alph_sup_handle);
  free(block);
  return pid;
}

// Spawns a top-level supervisor with no parent. Stop it with
// alph_node_exit_signal(node, pid, ALPH_SHUTDOWN). Otherwise as
// alph_spawn_sup. Thread: any.
export fn alph_node_spawn_sup(node: AlphNode*, spec: AlphSupSpec*) -> int64 {
  var size: int64 = 0;
  var block: rawptr = alph_sup_state(spec, &size);
  if (block == 0) {
    return 0;
  }
  var pid: int64 = alph_node_spawn_bytes(node, 0, block, size, &alph_sup_handle);
  free(block);
  return pid;
}
