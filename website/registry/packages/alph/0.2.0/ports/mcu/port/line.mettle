// A line of bytes to one other machine: the board's console, both ways.
// The console's interrupt hands each byte that arrives to take. This file
// has the board's external interrupt handler. Other external sources are
// handed to whatever alph_board_others was given.

import "port/port";

var g_take: fn(rawptr, int32) -> void;
var g_ctx: rawptr;
var g_other: fn(int32) -> void;

export fn alph_line_start(take: fn(rawptr, int32) -> void, ctx: rawptr) {
  g_take = take;
  g_ctx = ctx;
  mettle_board_console_irq_enable();
}

export fn alph_line_put(byte: uint8) {
  mettle_board_putc(byte);
}

// Bytes go out as they are put: nothing to do.
export fn alph_line_flush() {
}

// One hart, and nothing sends from an interrupt: no lock is needed, and
// interrupts stay on while a message goes out, so bytes arriving meanwhile
// are still taken.
export fn alph_line_lock() {
}

export fn alph_line_unlock() {
}

// A board has one line: 0.
export fn alph_line_which() -> Word {
  return 0;
}

export fn alph_line_use(line: Word) {
}

// What is called, in the interrupt, for an external interrupt that is not
// the console's: see alph/board/irq, which makes a message of it.
export fn alph_board_others(call: fn(int32) -> void) {
  g_other = call;
}

@interrupt fn mettle_trap_external() {
  var source: int32 = mettle_board_irq_claim();
  if (source == mettle_board_console_irq()) {
    var c: int32 = mettle_board_getc();
    while (c >= 0) {
      g_take(g_ctx, c);
      c = mettle_board_getc();
    }
  } else if (g_other != 0) {
    var other: fn(int32) -> void = g_other;
    other(source);
  }
  mettle_board_irq_complete(source);
}
