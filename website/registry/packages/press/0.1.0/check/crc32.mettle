// CRC-32 (the gzip, zip and PNG checksum; reflected polynomial 0xEDB88320).
//
//   var c: uint32 = press_crc32(0, p, n);       // whole buffer
//   c = press_crc32(c, more, m);                // continue with more data
//
// It reads 16 bytes per step with 16 lookup tables ("slicing by 16"). The
// tables are built by the compiler, so there is no start-up cost and no
// shared mutable state.

import "../core/buf";

const PRESS_CRC_POLY: uint32 = 0xEDB88320;

fn press_crc_make() -> uint32[4096] {
  var t: uint32[4096];
  for i in 0..256 {
    var c: uint32 = (uint32)i;
    for k in 0..8 {
      if ((c & 1) != 0) { c = PRESS_CRC_POLY ^ (c >> 1); } else { c = c >> 1; }
    }
    t[i] = c;
  }
  for s in 1..16 {
    for i in 0..256 {
      var prev: uint32 = t[(s - 1) * 256 + i];
      t[s * 256 + i] = (prev >> 8) ^ t[prev & 255];
    }
  }
  return t;
}

const PRESS_CRC_T: uint32[4096] = press_crc_make();

/// CRC-32 of n bytes at p, continuing from crc (pass 0 to start).
export fn press_crc32(crc: uint32, p: uint8*, n: int64) -> uint32 {
  var c: uint32 = ~crc;
  if (p == 0 || n <= 0) { return crc; }
  var t: uint32* = &PRESS_CRC_T[0];
  var q: uint8* = p;
  var left: int64 = n;
  while (left >= 16) {
    var a: uint32 = press_rd32(q) ^ c;
    var b: uint32 = press_rd32(q + 4);
    var d: uint32 = press_rd32(q + 8);
    var e: uint32 = press_rd32(q + 12);
    c = t[3840 + (a & 255)] ^ t[3584 + ((a >> 8) & 255)] ^ t[3328 + ((a >> 16) & 255)] ^ t[3072 + (a >> 24)]
      ^ t[2816 + (b & 255)] ^ t[2560 + ((b >> 8) & 255)] ^ t[2304 + ((b >> 16) & 255)] ^ t[2048 + (b >> 24)]
      ^ t[1792 + (d & 255)] ^ t[1536 + ((d >> 8) & 255)] ^ t[1280 + ((d >> 16) & 255)] ^ t[1024 + (d >> 24)]
      ^ t[768 + (e & 255)] ^ t[512 + ((e >> 8) & 255)] ^ t[256 + ((e >> 16) & 255)] ^ t[e >> 24];
    q = q + 16;
    left = left - 16;
  }
  for i in 0..left {
    c = t[(c ^ (uint32)q[i]) & 255] ^ (c >> 8);
  }
  return ~c;
}
