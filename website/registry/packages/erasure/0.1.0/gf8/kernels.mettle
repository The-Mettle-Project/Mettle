    db 0x62, 0xf1, 0xfe, 0x48, 0x6f, 0x4c, 0x07, 0x01  // vmovdqu64 zmm1, [rdi + rax + 64]
    db 0x62, 0xf2, 0xfd, 0x48, 0x19, 0x26  // vbroadcastsd zmm4, qword ptr [rsi + 0]
    db 0x62, 0xf3, 0xfd, 0x48, 0xce, 0xd4, 0x00  // vgf2p8affineqb zmm2, zmm0, zmm4, 0
    db 0x62, 0xf3, 0xf5, 0x48, 0xce, 0xdc, 0x00  // vgf2p8affineqb zmm3, zmm1, zmm4, 0
    db 0x62, 0x71, 0xbd, 0x48, 0xef, 0xc2  // vpxorq zmm8, zmm8, zmm2
    db 0x62, 0x71, 0x9d, 0x48, 0xef, 0xe3  // vpxorq zmm12, zmm12, zmm3
    add rsi, 8
    inc rdx
    cmp rdx, r10
    jl inner
    mov rdi, [r11 + 0]
    db 0x62, 0x71, 0xfe, 0x48, 0x7f, 0x04, 0x07  // vmovdqu64 [rdi + rax], zmm8
    db 0x62, 0x71, 0xfe, 0x48, 0x7f, 0x64, 0x07, 0x01  // vmovdqu64 [rdi + rax + 64], zmm12
    add rax, 128
    jmp outer
  done:
