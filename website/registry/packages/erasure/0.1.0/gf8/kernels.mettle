export fn erasure_k_gfni_3(tbls: uint8*, srcs: uint8**, k: int64, dsts: uint8**, off: int64, n: int64, mask: uint8*) {
  asm {
    mov r8, {tbls}
    mov r9, {srcs}
    mov r10, {k}
    mov r11, {dsts}
    mov rax, {off}
    mov rcx, {n}
    add rcx, rax
  outer:
    cmp rax, rcx
    jge done
    db 0xc4, 0x41, 0x3d, 0xef, 0xc0  // vpxor ymm8, ymm8, ymm8
    db 0xc4, 0x41, 0x35, 0xef, 0xc9  // vpxor ymm9, ymm9, ymm9
    db 0xc4, 0x41, 0x2d, 0xef, 0xd2  // vpxor ymm10, ymm10, ymm10
    mov rsi, r8
    xor rdx, rdx
  inner:
    mov rdi, [r9 + rdx*8]
    db 0xc5, 0xfe, 0x6f, 0x04, 0x07  // vmovdqu ymm0, [rdi + rax]
    db 0xc4, 0xe3, 0xfd, 0xce, 0x16, 0x00  // vgf2p8affineqb ymm2, ymm0, [rsi + 0], 0
    db 0xc5, 0x3d, 0xef, 0xc2  // vpxor ymm8, ymm8, ymm2
    db 0xc4, 0xe3, 0xfd, 0xce, 0x56, 0x20, 0x00  // vgf2p8affineqb ymm2, ymm0, [rsi + 32], 0
    db 0xc5, 0x35, 0xef, 0xca  // vpxor ymm9, ymm9, ymm2
    db 0xc4, 0xe3, 0xfd, 0xce, 0x56, 0x40, 0x00  // vgf2p8affineqb ymm2, ymm0, [rsi + 64], 0
    db 0xc5, 0x2d, 0xef, 0xd2  // vpxor ymm10, ymm10, ymm2
    add rsi, 96
    inc rdx
    cmp rdx, r10
    jl inner
    mov rdi, [r11 + 0]
    db 0xc5, 0x7e, 0x7f, 0x04, 0x07  // vmovdqu [rdi + rax], ymm8
    mov rdi, [r11 + 8]
    db 0xc5, 0x7e, 0x7f, 0x0c, 0x07  // vmovdqu [rdi + rax], ymm9
    mov rdi, [r11 + 16]
    db 0xc5, 0x7e, 0x7f, 0x14, 0x07  // vmovdqu [rdi + rax], ymm10
    add rax, 32
    jmp outer
  done:
    db 0xc5, 0xf8, 0x77  // vzeroupper
