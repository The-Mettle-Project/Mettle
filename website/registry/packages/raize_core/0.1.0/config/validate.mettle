// raize/config/validate — the startup checks, before any socket is bound.
//
// ## What is checked
//
//     port                 1..65535
//     workers              1..64          (the @parallel runtime cap)
//     max_body             1024..64 MiB   hard cap
//     max_header_bytes     1024..RZ_MAX_HEADER_BYTES (8192, the parser cap)
//     keepalive_max        >= 1
//     read_timeout_ms      >= 1
//     cache_max_age        >= 0
//     allowed_origin       non-empty
//     env                  non-empty
//
// trusted_proxy is checked when it is applied (an IPv4 address or unset).
// Validation refuses after rz_config_freeze: a post-freeze call means the
// startup ordering is wrong.
//
// Every message names the variable (RAIZE_*) and the allowed range, so an
// operator can fix it from the log line alone.

import "std/mem";
import "../str/str";
import "types";

fn rz_cfg_bad_num(e: RzConfigErrors*, label: string, code: int32, got: int64, min: int64, max: int64) {
  if (e == 0) { return; }
  var i: int32 = rz_cfg_err_new(e, label);
  rz_cfg_err_add(e, i, label);
  rz_cfg_err_add(e, i, ": must be ");
  if (max > 0) {
    rz_cfg_err_add_int(e, i, min);
    rz_cfg_err_add(e, i, "..");
    rz_cfg_err_add_int(e, i, max);
  } else {
    rz_cfg_err_add(e, i, ">= ");
    rz_cfg_err_add_int(e, i, min);
  }
  rz_cfg_err_add(e, i, ", got ");
  rz_cfg_err_add_int(e, i, got);
}

fn rz_cfg_bad_str(e: RzConfigErrors*, label: string, reason: string) {
  if (e == 0) { return; }
  var i: int32 = rz_cfg_err_new(e, label);
  rz_cfg_err_add(e, i, label);
  rz_cfg_err_add(e, i, ": ");
  rz_cfg_err_add(e, i, reason);
}

// Runs every check, records every failure, and reports the first code through
// `first`. Returns true when at least one check failed.
fn rz_cfg_checks(c: RzConfig*, e: RzConfigErrors*, first: int32*) -> bool {
  var bad: bool = false;

  if (c->port < RZ_CFG_MIN_PORT || c->port > RZ_CFG_MAX_PORT) {
    rz_cfg_bad_num(e, "RAIZE_PORT", RZ_CFG_E_PORT, (int64)c->port, (int64)RZ_CFG_MIN_PORT, (int64)RZ_CFG_MAX_PORT);
    if (*first == 0) { *first = RZ_CFG_E_PORT; }
    bad = true;
  }
  if (c->workers < RZ_CFG_MIN_WORKERS || c->workers > RZ_CFG_MAX_WORKERS) {
    rz_cfg_bad_num(e, "RAIZE_WORKERS", RZ_CFG_E_WORKERS, (int64)c->workers, (int64)RZ_CFG_MIN_WORKERS, (int64)RZ_CFG_MAX_WORKERS);
    if (*first == 0) { *first = RZ_CFG_E_WORKERS; }
    bad = true;
  }
  if (c->max_body < RZ_CFG_MIN_BODY || c->max_body > RZ_CFG_MAX_BODY) {
    rz_cfg_bad_num(e, "RAIZE_MAX_BODY_BYTES", RZ_CFG_E_MAX_BODY, c->max_body, RZ_CFG_MIN_BODY, RZ_CFG_MAX_BODY);
    if (*first == 0) { *first = RZ_CFG_E_MAX_BODY; }
    bad = true;
  }
  if (c->max_header_bytes < RZ_CFG_MIN_HEADER || c->max_header_bytes > RZ_CFG_MAX_HEADER) {
    rz_cfg_bad_num(e, "RAIZE_MAX_HEADER_BYTES", RZ_CFG_E_MAX_HEADER, c->max_header_bytes, RZ_CFG_MIN_HEADER, RZ_CFG_MAX_HEADER);
    if (*first == 0) { *first = RZ_CFG_E_MAX_HEADER; }
    bad = true;
  }
  if (c->keepalive_max < RZ_CFG_MIN_KEEPALIVE) {
    rz_cfg_bad_num(e, "RAIZE_KEEPALIVE_MAX", RZ_CFG_E_KEEPALIVE, (int64)c->keepalive_max, (int64)RZ_CFG_MIN_KEEPALIVE, 0);
    if (*first == 0) { *first = RZ_CFG_E_KEEPALIVE; }
    bad = true;
  }
  if (c->read_timeout_ms < RZ_CFG_MIN_TIMEOUT_MS) {
    rz_cfg_bad_num(e, "RAIZE_READ_TIMEOUT_MS", RZ_CFG_E_TIMEOUT, (int64)c->read_timeout_ms, (int64)RZ_CFG_MIN_TIMEOUT_MS, 0);
    if (*first == 0) { *first = RZ_CFG_E_TIMEOUT; }
    bad = true;
  }
  if (c->cache_max_age < RZ_CFG_MIN_CACHE_MAX_AGE) {
    rz_cfg_bad_num(e, "RAIZE_CACHE_MAX_AGE", RZ_CFG_E_CACHE, (int64)c->cache_max_age, (int64)RZ_CFG_MIN_CACHE_MAX_AGE, 0);
    if (*first == 0) { *first = RZ_CFG_E_CACHE; }
    bad = true;
  }
  if (rz_str_len(rz_config_allow_origin(c)) == 0) {
    rz_cfg_bad_str(e, "RAIZE_ALLOWED_ORIGIN", "must be a non-empty origin");
    if (*first == 0) { *first = RZ_CFG_E_ORIGIN; }
    bad = true;
  }
  if (rz_str_len(rz_config_env(c)) == 0) {
    rz_cfg_bad_str(e, "env", "must be a non-empty name");
    if (*first == 0) { *first = RZ_CFG_E_ENV; }
    bad = true;
  }
  return bad;
}

// Fills the error list with every failure. Returns 0 clean, -1 otherwise.
// The list is NOT reset here, so a caller can accumulate env + validation
// errors in one report.
export fn rz_config_validate(c: RzConfig*, e: RzConfigErrors*) -> int32 {
  if (c == 0) { return RZ_CFG_E_ARGS; }
  if (c->frozen) { return RZ_CFG_E_FROZEN; }
  var first: int32 = 0;
  var bad: bool = rz_cfg_checks(c, e, &first);
  if (bad) { return -1; }
  return 0;
}

// First failing code, or RZ_CFG_OK. For callers that want a code instead of a
// list. Does not record anything.
export fn rz_config_validate_code(c: RzConfig*) -> int32 {
  if (c == 0) { return RZ_CFG_E_ARGS; }
  if (c->frozen) { return RZ_CFG_E_FROZEN; }
  var first: int32 = 0;
  rz_cfg_checks(c, 0, &first);
  return first;
}
