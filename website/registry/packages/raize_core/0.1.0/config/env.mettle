// raize/config/env — the environment overlay and its strict parsing.
//
// ## Exact names, no aliases
//
// These ten variables are the whole contract. Nothing else is read, and
// there is no "close enough" matching: a program that exports RAISE_PORT (s
// instead of z) gets the default, because RAISE_PORT is not one of the ten.
// Silently honouring a misspelling is the class of bug config exists to
// prevent, so it is not done here.
//
//     RAIZE_PORT               RAIZE_WORKERS
//     RAIZE_MAX_HEADER_BYTES   RAIZE_MAX_BODY_BYTES
//     RAIZE_KEEPALIVE_MAX      RAIZE_READ_TIMEOUT_MS
//     RAIZE_CACHE_MAX_AGE      RAIZE_ALLOWED_ORIGIN
//     RAIZE_TRUSTED_PROXY      (RAIZE_ENV is not read; `env` is set by code)
//
// Static and template directories are declared in code (rz_static), not
// configured; there is no bind-address or store setting (the listener binds
// INADDR_ANY, data layers are made in the declaration function).
//
// Mettle's `getenv` has no enumeration surface, so "reject an unknown RAIZE_*
// variable" cannot mean scanning the process environment. It means the API
// path: rz_config_set(c, "RAISE_PORT", ...) returns RZ_CFG_E_UNKNOWN_KEY and
// the error names RAISE_PORT. The overlay below simply never asks for it.
//
// ## Strict parsing, never a silent default
//
// A numeric value is digits only: no sign, no spaces, no trailing junk, no
// empty string, overflow checked. A bad value records an error naming the
// variable and leaves the previous value (the default, because the overlay
// runs over defaults) untouched. The overlay keeps going through the remaining
// variables so a startup prints the whole list, not the first problem.
//
import "std/mem";
import "../str/str";
import "types";
import "../context/peer";

const RZ_ENV_PORT: string = "RAIZE_PORT";
const RZ_ENV_WORKERS: string = "RAIZE_WORKERS";
const RZ_ENV_MAX_HEADER_BYTES: string = "RAIZE_MAX_HEADER_BYTES";
const RZ_ENV_MAX_BODY_BYTES: string = "RAIZE_MAX_BODY_BYTES";
const RZ_ENV_KEEPALIVE_MAX: string = "RAIZE_KEEPALIVE_MAX";
const RZ_ENV_READ_TIMEOUT_MS: string = "RAIZE_READ_TIMEOUT_MS";
const RZ_ENV_CACHE_MAX_AGE: string = "RAIZE_CACHE_MAX_AGE";
const RZ_ENV_ALLOWED_ORIGIN: string = "RAIZE_ALLOWED_ORIGIN";
const RZ_ENV_TRUSTED_PROXY: string = "RAIZE_TRUSTED_PROXY";

extern fn getenv(name: cstring) -> cstring;
extern fn strlen(s: cstring) -> int64;

// The compile-time interpreter cannot call getenv, and it drops `string`
// arguments across an indirect call (verified: a provider function pointer
// receives an empty string in `mettle test`, while the native build receives
// the right bytes). So the test hook is a table read through normal calls, not
// a function pointer. Production never touches the table.
const RZ_CFG_ENV_TEST_MAX: int32 = 16;
var g_rz_cfg_env_test: bool = false;
var g_rz_cfg_env_names: string[16];
var g_rz_cfg_env_values: string[16];
var g_rz_cfg_env_count: int32 = 0;

export fn rz_config_env_test_begin() {
  g_rz_cfg_env_test = true;
  g_rz_cfg_env_count = 0;
}

export fn rz_config_env_test_set(name: string, value: string) {
  if (g_rz_cfg_env_count >= RZ_CFG_ENV_TEST_MAX) { return; }
  g_rz_cfg_env_names[g_rz_cfg_env_count] = name;
  g_rz_cfg_env_values[g_rz_cfg_env_count] = value;
  g_rz_cfg_env_count = g_rz_cfg_env_count + 1;
}

export fn rz_config_env_test_end() {
  g_rz_cfg_env_test = false;
}

fn rz_cfg_env_process(name: string) -> string {
  var v: cstring = getenv((cstring)name.chars);
  if (v == 0) { return ""; }
  var s: string;
  s.chars = (uint8*)v;
  s.length = (uint64)strlen(v);
  return s;
}

fn rz_cfg_env_get(name: string) -> string {
  if (g_rz_cfg_env_test) {
    var i: int32 = 0;
    while (i < g_rz_cfg_env_count) {
      if (rz_str_eq(name, g_rz_cfg_env_names[i])) { return g_rz_cfg_env_values[i]; }
      i = i + 1;
    }
    return "";
  }
  return rz_cfg_env_process(name);
}

// ---------------------------------------------------------------------------
// Error text: `VAR: not a number or out of range: "raw" (allowed min..max)`
// ---------------------------------------------------------------------------

fn rz_cfg_err_num(e: RzConfigErrors*, label: string, raw: string, min: int64, max: int64) {
  var i: int32 = rz_cfg_err_new(e, label);
  rz_cfg_err_add(e, i, label);
  rz_cfg_err_add(e, i, ": not a number or out of range: ");
  rz_cfg_err_add_quoted(e, i, raw);
  rz_cfg_err_add(e, i, " (allowed ");
  if (max > 0) {
    rz_cfg_err_add_int(e, i, min);
    rz_cfg_err_add(e, i, "..");
    rz_cfg_err_add_int(e, i, max);
  } else {
    rz_cfg_err_add(e, i, ">= ");
    rz_cfg_err_add_int(e, i, min);
  }
  rz_cfg_err_add(e, i, ")");
}

fn rz_cfg_err_str(e: RzConfigErrors*, label: string, reason: string) {
  var i: int32 = rz_cfg_err_new(e, label);
  rz_cfg_err_add(e, i, label);
  rz_cfg_err_add(e, i, ": ");
  rz_cfg_err_add(e, i, reason);
}

// ---------------------------------------------------------------------------
// One key/value pair. Shared by the env overlay and the explicit setter.
//
// Returns 0 applied, or the field's RZ_CFG_E_* code. `label` is what the error
// names (the environment variable for the overlay, the key for the setter);
// `key` is the field name. Unknown keys return RZ_CFG_E_UNKNOWN_KEY and name
// the key, so a typo is never silently ignored.
// ---------------------------------------------------------------------------

export fn rz_config_apply(c: RzConfig*, label: string, key: string, value: string, e: RzConfigErrors*) -> int32 {
  if (c == 0) { return RZ_CFG_E_ARGS; }

  var n: int64 = 0;

  if (rz_str_eq(key, "port")) {
    if (!rz_cfg_parse_digits(value, &n) || n < 1 || n > 65535) {
      rz_cfg_err_num(e, label, value, 1, 65535);
      return RZ_CFG_E_PORT;
    }
    c->port = (int32)n;
    return RZ_CFG_OK;
  }

  if (rz_str_eq(key, "workers")) {
    if (!rz_cfg_parse_digits(value, &n) || n < 1 || n > 64) {
      rz_cfg_err_num(e, label, value, 1, 64);
      return RZ_CFG_E_WORKERS;
    }
    c->workers = (int32)n;
    return RZ_CFG_OK;
  }

  if (rz_str_eq(key, "max_header_bytes")) {
    if (!rz_cfg_parse_digits(value, &n) || n < RZ_CFG_MIN_HEADER || n > RZ_CFG_MAX_HEADER) {
      rz_cfg_err_num(e, label, value, RZ_CFG_MIN_HEADER, RZ_CFG_MAX_HEADER);
      return RZ_CFG_E_MAX_HEADER;
    }
    c->max_header_bytes = n;
    return RZ_CFG_OK;
  }

  if (rz_str_eq(key, "max_body_bytes")) {
    if (!rz_cfg_parse_digits(value, &n) || n < RZ_CFG_MIN_BODY || n > RZ_CFG_MAX_BODY) {
      rz_cfg_err_num(e, label, value, RZ_CFG_MIN_BODY, RZ_CFG_MAX_BODY);
      return RZ_CFG_E_MAX_BODY;
    }
    c->max_body = n;
    return RZ_CFG_OK;
  }

  if (rz_str_eq(key, "keepalive_max")) {
    if (!rz_cfg_parse_digits(value, &n) || n < 1) {
      rz_cfg_err_num(e, label, value, 1, 0);
      return RZ_CFG_E_KEEPALIVE;
    }
    c->keepalive_max = (int32)n;
    return RZ_CFG_OK;
  }

  if (rz_str_eq(key, "read_timeout_ms")) {
    if (!rz_cfg_parse_digits(value, &n) || n < 1) {
      rz_cfg_err_num(e, label, value, 1, 0);
      return RZ_CFG_E_TIMEOUT;
    }
    c->read_timeout_ms = (int32)n;
    return RZ_CFG_OK;
  }

  if (rz_str_eq(key, "cache_max_age")) {
    if (!rz_cfg_parse_digits(value, &n) || n < 0) {
      rz_cfg_err_num(e, label, value, 0, 0);
      return RZ_CFG_E_CACHE;
    }
    c->cache_max_age = (int32)n;
    return RZ_CFG_OK;
  }

  if (rz_str_eq(key, "allowed_origin")) {
    if (rz_str_len(value) == 0) {
      rz_cfg_err_str(e, label, "must be a non-empty origin (allowed 1..255 bytes)");
      return RZ_CFG_E_ORIGIN;
    }
    if (!rz_cfg_copy(&c->allow_origin[0], RZ_CFG_ORIGIN_MAX, &c->allow_origin_len, value)) {
      rz_cfg_err_str(e, label, "too long (allowed 1..255 bytes)");
      return RZ_CFG_E_ORIGIN;
    }
    return RZ_CFG_OK;
  }

  if (rz_str_eq(key, "trusted_proxy")) {
    var ip: uint32 = 0;
    if (!rz__ipv4_parse(value, &ip) || !rz_cfg_copy(&c->trusted_proxy[0], RZ_CFG_PROXY_MAX, &c->trusted_proxy_len, value)) {
      rz_cfg_err_str(e, label, "not an IPv4 address (a.b.c.d)");
      return RZ_CFG_E_PROXY;
    }
    return RZ_CFG_OK;
  }

  if (rz_str_eq(key, "env")) {
    if (rz_str_len(value) == 0) {
      rz_cfg_err_str(e, label, "must be a non-empty name (allowed 1..31 bytes)");
      return RZ_CFG_E_ENV;
    }
    if (!rz_cfg_copy(&c->env[0], RZ_CFG_ENV_MAX, &c->env_len, value)) {
      rz_cfg_err_str(e, label, "too long (allowed 1..31 bytes)");
      return RZ_CFG_E_ENV;
    }
    return RZ_CFG_OK;
  }

  rz_cfg_err_str(e, key, "unknown config variable");
  return RZ_CFG_E_UNKNOWN_KEY;
}

// ---------------------------------------------------------------------------
// The overlay. Later wins over defaults; it does NOT validate and does NOT
// freeze. Empty/unset variables leave the current value alone.
// ---------------------------------------------------------------------------

fn rz_cfg_env_one(c: RzConfig*, e: RzConfigErrors*, name: string, key: string) -> bool {
  var v: string = rz_cfg_env_get(name);
  if (v.length == 0) { return true; }
  return rz_config_apply(c, name, key, v, e) == RZ_CFG_OK;
}

// Returns 0 when every variable present parsed and was in range, -1 when at
// least one error was recorded (and every error is in the list).
export fn rz_config_from_env(c: RzConfig*, e: RzConfigErrors*) -> int32 {
  if (c == 0) { return RZ_CFG_E_ARGS; }
  if (c->frozen) { return RZ_CFG_E_FROZEN; }
  var failed: bool = false;
  if (!rz_cfg_env_one(c, e, RZ_ENV_PORT, "port")) { failed = true; }
  if (!rz_cfg_env_one(c, e, RZ_ENV_WORKERS, "workers")) { failed = true; }
  if (!rz_cfg_env_one(c, e, RZ_ENV_MAX_HEADER_BYTES, "max_header_bytes")) { failed = true; }
  if (!rz_cfg_env_one(c, e, RZ_ENV_MAX_BODY_BYTES, "max_body_bytes")) { failed = true; }
  if (!rz_cfg_env_one(c, e, RZ_ENV_KEEPALIVE_MAX, "keepalive_max")) { failed = true; }
  if (!rz_cfg_env_one(c, e, RZ_ENV_READ_TIMEOUT_MS, "read_timeout_ms")) { failed = true; }
  if (!rz_cfg_env_one(c, e, RZ_ENV_CACHE_MAX_AGE, "cache_max_age")) { failed = true; }
  if (!rz_cfg_env_one(c, e, RZ_ENV_ALLOWED_ORIGIN, "allowed_origin")) { failed = true; }
  if (!rz_cfg_env_one(c, e, RZ_ENV_TRUSTED_PROXY, "trusted_proxy")) { failed = true; }
  if (failed) { return -1; }
  return 0;
}

// Code-only variant for a caller that does not want a list. Runs the overlay
// against a throwaway error list and returns the first code, or 0.
export fn rz_config_from_env_code(c: RzConfig*) -> int32 {
  if (c == 0) { return RZ_CFG_E_ARGS; }
  if (c->frozen) { return RZ_CFG_E_FROZEN; }
  var e: RzConfigErrors;
  rz_config_errors_reset(&e);
  if (rz_config_from_env(c, &e) == 0) { return RZ_CFG_OK; }
  if (e.count == 0) { return RZ_CFG_E_ARGS; }
  return rz_cfg_code_of(&e, 0);
}

// Maps a recorded error's field back to its code by re-parsing the field name
// against the known set. Used only by the code-only convenience above.
fn rz_cfg_code_of(e: RzConfigErrors*, i: int32) -> int32 {
  var f: string = rz_config_error_field(e, i);
  if (rz_str_eq(f, RZ_ENV_PORT)) { return RZ_CFG_E_PORT; }
  if (rz_str_eq(f, RZ_ENV_WORKERS)) { return RZ_CFG_E_WORKERS; }
  if (rz_str_eq(f, RZ_ENV_MAX_HEADER_BYTES)) { return RZ_CFG_E_MAX_HEADER; }
  if (rz_str_eq(f, RZ_ENV_MAX_BODY_BYTES)) { return RZ_CFG_E_MAX_BODY; }
  if (rz_str_eq(f, RZ_ENV_KEEPALIVE_MAX)) { return RZ_CFG_E_KEEPALIVE; }
  if (rz_str_eq(f, RZ_ENV_READ_TIMEOUT_MS)) { return RZ_CFG_E_TIMEOUT; }
  if (rz_str_eq(f, RZ_ENV_CACHE_MAX_AGE)) { return RZ_CFG_E_CACHE; }
  if (rz_str_eq(f, RZ_ENV_ALLOWED_ORIGIN)) { return RZ_CFG_E_ORIGIN; }
  if (rz_str_eq(f, RZ_ENV_TRUSTED_PROXY)) { return RZ_CFG_E_PROXY; }
  return RZ_CFG_OK;
}
