// cargo: version requirements in Cargo's syntax, with the meaning the
// semver crate gives them (https://doc.rust-lang.org/cargo/reference/specifying-dependencies.html).
//
//   1.2.3  ^1.2.3   caret (the default): >=1.2.3, <2.0.0
//   ~1.2.3          tilde: >=1.2.3, <1.3.0
//   =1.2.3 >1.2 >=1 <1.2.3 <=1.2   comparisons, partial versions allowed
//   1.*  1.2.*  *   wildcards (x and X work too)
//   >=1.2, <1.5     comma means "and"
//
// At most 32 comparators. Partial versions are kept as written and matched
// by the semver crate's rules.

import "std/core";
import "std/conv";
import "std/collections";
import "version";
import "range";

const SVG_MAX_CMPS: int64 = 32;

fn svg_is_wild(s: string, i: int64) -> bool {
  return i < (int64)s.length && (s[i] == '*' || s[i] == 'x' || s[i] == 'X');
}

fn svg_skip_spaces(s: string, i: int64) -> int64 {
  var k: int64 = i;
  while (k < (int64)s.length && s[k] == ' ') { k = k + 1; }
  return k;
}

// Parses one comparator starting at *pos, up to a ',' or the end.
fn svg_cmp(s: string, pos: int64*, out: SemverComparator*) -> string {
  var n: int64 = (int64)s.length;
  var i: int64 = *pos;
  var op: int32 = SEMVER_CARET;
  var given: bool = true;
  if (i < n && s[i] == '=') {
    op = SEMVER_EQ;
    i = i + 1;
  } else if (i < n && s[i] == '>') {
    op = SEMVER_GT;
    i = i + 1;
    if (i < n && s[i] == '=') { op = SEMVER_GE; i = i + 1; }
  } else if (i < n && s[i] == '<') {
    op = SEMVER_LT;
    i = i + 1;
    if (i < n && s[i] == '=') { op = SEMVER_LE; i = i + 1; }
  } else if (i < n && s[i] == '~') {
    op = SEMVER_TILDE;
    i = i + 1;
  } else if (i < n && s[i] == '^') {
    i = i + 1;
  } else {
    given = false;
  }
  i = svg_skip_spaces(s, i);
  var c: SemverComparator = semver_cmp_new(op, 1, 0, 0, 0, "");
  var why: string = semver_read_num(s, &i, true, &c.major);
  if (why.length > 0) { *pos = i; return why; }
  var wild: bool = false;
  if (i < n && s[i] == '.') {
    i = i + 1;
    if (svg_is_wild(s, i)) {
      wild = true;
      i = i + 1;
      if (!given) { c.op = SEMVER_WILD; }
    } else {
      why = semver_read_num(s, &i, true, &c.minor);
      if (why.length > 0) { *pos = i; return why; }
      c.parts = 2;
    }
  }
  if (i < n && s[i] == '.') {
    i = i + 1;
    if (svg_is_wild(s, i)) {
      i = i + 1;
      if (!given) { c.op = SEMVER_WILD; }
    } else if (wild) {
      *pos = i;
      return "unexpected character after wildcard";
    } else {
      why = semver_read_num(s, &i, true, &c.patch);
      if (why.length > 0) { *pos = i; return why; }
      c.parts = 3;
    }
  }
  if (c.parts == 3) {
    var v: SemverVersion = semver_new(0, 0, 0);
    why = semver_read_tail(s, &i, &v);
    if (why.length > 0) { *pos = i; return why; }
    c.pre = v.pre;
  }
  i = svg_skip_spaces(s, i);
  *pos = i;
  *out = c;
  return "";
}

// Parses a Cargo version requirement. Free the result with
// semver_range_free. The range keeps views into text, so keep text alive.
export fn semver_cargo_parse(text: string) -> Result<SemverRange, SemverError> {
  var r: SemverRange = semver_range_new(SEMVER_STYLE_CARGO, false);
  var n: int64 = (int64)text.length;
  var i: int64 = svg_skip_spaces(text, 0);
  if (svg_is_wild(text, i)) {
    var k: int64 = svg_skip_spaces(text, i + 1);
    if (k == n) {
      // "*" alone: every version except pre-releases.
      list_push<int64>(&r.ends, 0);
      return Ok(r);
    }
    semver_range_free(&r);
    if (text[k] == ',') { return semver_err<SemverRange>(i, "wildcard must be the only comparator"); }
    return semver_err<SemverRange>(k, "unexpected character after wildcard");
  }
  while (true) {
    var c: SemverComparator;
    var start: int64 = i;
    var why: string = svg_cmp(text, &i, &c);
    if (why.length > 0) {
      if (svg_is_wild(text, start)) {
        var k2: int64 = svg_skip_spaces(text, start + 1);
        if (k2 == n || text[k2] == ',') { why = "wildcard must be the only comparator"; }
      }
      semver_range_free(&r);
      return semver_err<SemverRange>(i, why);
    }
    list_push<SemverComparator>(&r.cmps, c);
    if (i >= n) { break; }
    if (text[i] != ',') {
      semver_range_free(&r);
      return semver_err<SemverRange>(i, "expected ','");
    }
    if (r.cmps.length >= SVG_MAX_CMPS) {
      semver_range_free(&r);
      return semver_err<SemverRange>(i, "too many comparators");
    }
    i = svg_skip_spaces(text, i + 1);
  }
  list_push<int64>(&r.ends, r.cmps.length);
  return Ok(r);
}

// True when the version text matches the Cargo requirement text. Text that
// does not parse never matches.
export fn semver_cargo_matches(version: string, req: string) -> bool {
  match (semver_parse(version)) {
    case Ok(v): {
      match (semver_cargo_parse(req)) {
        case Ok(r): {
          var ok: bool = semver_satisfies(&r, v);
          semver_range_free(&r);
          return ok;
        }
        case Err(e): { return false; }
      }
    }
    case Err(e2): { return false; }
  }
  return false;
}
