// raize/ws/handshake — the opening handshake (RFC 6455 §4.2).
//
// Two pure steps, no socket:
//
//   rz_ws_check_upgrade  decides whether a parsed request is a valid
//                        WebSocket upgrade, and if not, which HTTP status
//                        refuses it (400, 405 or 426).
//   rz_ws_write_101      appends the `101 Switching Protocols` head to a
//                        buffer, including Sec-WebSocket-Accept.
//
// The 101 head is written here rather than by rz_resp_serialize_head because
// that serializer owns Content-Length and Connection, and a 101 must carry
// neither a length nor `Connection: keep-alive`.
//
// A 426 must tell the client which version we speak, so its caller sets
// `Sec-WebSocket-Version: 13` on the refusal (rz_ws_refuse does it).

import "std/mem";
import "raize_core/str/str";
import "raize_core/context/header";
import "raize_core/context/request";
import "raize_core/context/response";
import "sha1";

export const RZ_WS_GUID: string = "258EAFA5-E914-47DA-95CA-C5AB0DC85B11";
export const RZ_WS_VERSION: string = "13";
export const RZ_WS_ACCEPT_LEN: int64 = 28;    // base64 of a 20-byte SHA-1
export const RZ_WS_KEY_LEN: int64 = 24;       // base64 of a 16-byte nonce

export const RZ_WS_UPGRADE_OK: int32 = 0;

fn rz_ws_b64_char(v: int32) -> uint8 {
  var abc: string = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/";
  return abc.chars[(int64)v];
}

fn rz_ws_b64_valid(c: int32) -> bool {
  if (rz_char_is_alpha(c) || rz_char_is_digit(c)) { return true; }
  return c == 43 || c == 47;    // '+' '/'
}

// Encodes n bytes as padded base64 into out. Returns the view, or empty when
// cap is too small.
fn rz_ws_b64(p: uint8*, n: int64, out: uint8*, cap: int64) -> string {
  var need: int64 = ((n + 2) / 3) * 4;
  if (out == 0 || cap < need) { return rz_str_empty(); }
  var i: int64 = 0;
  var o: int64 = 0;
  while (i < n) {
    var b0: int32 = (int32)p[i];
    var b1: int32 = 0;
    var b2: int32 = 0;
    if (i + 1 < n) { b1 = (int32)p[i + 1]; }
    if (i + 2 < n) { b2 = (int32)p[i + 2]; }
    out[o] = rz_ws_b64_char(b0 >> 2);
    out[o + 1] = rz_ws_b64_char(((b0 & 3) << 4) | (b1 >> 4));
    out[o + 2] = (uint8)61;    // '='
    out[o + 3] = (uint8)61;
    if (i + 1 < n) { out[o + 2] = rz_ws_b64_char(((b1 & 15) << 2) | (b2 >> 6)); }
    if (i + 2 < n) { out[o + 3] = rz_ws_b64_char(b2 & 63); }
    i = i + 3;
    o = o + 4;
  }
  return rz_str_view(out, need);
}

// A client key is the base64 of exactly 16 bytes: 22 alphabet characters
// followed by "==".
export fn rz_ws_key_ok(key: string) -> bool {
  if ((int64)key.length != RZ_WS_KEY_LEN) { return false; }
  var i: int64 = 0;
  while (i < 22) {
    if (!rz_ws_b64_valid((int32)key.chars[i])) { return false; }
    i = i + 1;
  }
  return key.chars[22] == (uint8)61 && key.chars[23] == (uint8)61;
}

// Sec-WebSocket-Accept for `key`: base64(sha1(key + GUID)). `out` needs
// RZ_WS_ACCEPT_LEN bytes. Returns a view into `out`, or empty on bad input.
export fn rz_ws_accept_key(key: string, out: uint8*, cap: int64) -> string {
  if (!rz_ws_key_ok(key)) { return rz_str_empty(); }
  var joined: uint8[64];     // 24-byte key + 36-byte GUID
  memcpy((rawptr)&joined[0], (rawptr)key.chars, RZ_WS_KEY_LEN);
  memcpy((rawptr)&joined[24], (rawptr)RZ_WS_GUID.chars, (int64)RZ_WS_GUID.length);
  var digest: uint8[20];
  if (rz_sha1(&joined[0], 60, &digest[0]) != 0) { return rz_str_empty(); }
  return rz_ws_b64(&digest[0], 20, out, cap);
}

// Decides an upgrade from the verb and headers. Returns RZ_WS_UPGRADE_OK, or
// the status to refuse with: 405 (not GET), 426 (wrong or missing version),
// 400 (anything else malformed).
export fn rz_ws_check_headers(verb: string, items: RzHeader*, count: int32) -> int32 {
  if (!rz_str_eq(verb, "GET")) { return 405; }
  if (!rz_header_has_token(rz_header_get(items, count, "upgrade"), "websocket")) { return 400; }
  if (!rz_header_has_token(rz_header_get(items, count, "connection"), "upgrade")) { return 400; }
  if (rz_header_count_named(items, count, "sec-websocket-key") != 1) { return 400; }
  if (!rz_ws_key_ok(rz_header_trim(rz_header_get(items, count, "sec-websocket-key")))) { return 400; }
  var version: string = rz_header_trim(rz_header_get(items, count, "sec-websocket-version"));
  if (!rz_str_eq(version, RZ_WS_VERSION)) { return 426; }
  return RZ_WS_UPGRADE_OK;
}

export fn rz_ws_check_upgrade(req: RzRequest*) -> int32 {
  if (req == 0) { return 400; }
  if (req->version_major != 1 || req->version_minor < 1) { return 400; }
  return rz_ws_check_headers(req->verb, req->headers, req->header_count);
}

// Builds the refusal for a status from rz_ws_check_upgrade into `res`.
export fn rz_ws_refuse(res: RzResponse*, status: int32) -> int32 {
  if (res == 0) { return -1; }
  if (status == 426) { rz_resp_header_set(res, "Sec-WebSocket-Version", RZ_WS_VERSION); }
  if (status == 405) { rz_resp_header_set(res, "Allow", "GET"); }
  res->close_after = true;
  return rz_resp_text(res, status, "websocket upgrade refused\n");
}

// Appends the 101 head for `key` (already checked) to `out`. `protocol`, when
// non-empty, is echoed as Sec-WebSocket-Protocol. Returns bytes appended, or
// -1 when the key is invalid.
export fn rz_ws_write_101(key: string, protocol: string, out: RzBuf*) -> int64 {
  if (out == 0) { return -1; }
  var abuf: uint8[32];
  var accept: string = rz_ws_accept_key(rz_header_trim(key), &abuf[0], 32);
  if (accept.length == 0) { return -1; }
  var start: int64 = out->len;
  rz_buf_add(out, "HTTP/1.1 101 Switching Protocols\r\n");
  rz_buf_add(out, "Upgrade: websocket\r\n");
  rz_buf_add(out, "Connection: Upgrade\r\n");
  rz_buf_add(out, "Sec-WebSocket-Accept: ");
  rz_buf_add(out, accept);
  rz_buf_add(out, "\r\n");
  if (protocol.length > 0) {
    rz_buf_add(out, "Sec-WebSocket-Protocol: ");
    rz_buf_add(out, protocol);
    rz_buf_add(out, "\r\n");
  }
  rz_buf_add(out, "Server: raize\r\n\r\n");
  return out->len - start;
}

// ---------------------------------------------------------------------------
// Tests
// ---------------------------------------------------------------------------

@test fn t_rz_ws_accept_rfc_example() -> int32 {
  var out: uint8[32];
  // RFC 6455 §1.3.
  var a: string = rz_ws_accept_key("dGhlIHNhbXBsZSBub25jZQ==", &out[0], 32);
  if (!rz_str_eq(a, "s3pPLMBiTxaQ9kYGzzhZRbK+xOo=")) { return 1; }
  if (rz_ws_accept_key("dGhlIHNhbXBsZSBub25jZQ=", &out[0], 32).length != 0) { return 2; }
  if (rz_ws_accept_key("dGhlIHNhbXBsZSBub25jZQ==", &out[0], 27).length != 0) { return 3; }
  if (rz_ws_key_ok("dGhlIHNhbXBsZSBub25jZ!==")) { return 4; }
  return 0;
}

@test fn t_rz_ws_check_headers() -> int32 {
  var h: RzHeader[4];
  h[0].name = "Upgrade";               h[0].value = "websocket";
  h[1].name = "Connection";            h[1].value = "keep-alive, Upgrade";
  h[2].name = "Sec-WebSocket-Key";     h[2].value = "dGhlIHNhbXBsZSBub25jZQ==";
  h[3].name = "Sec-WebSocket-Version"; h[3].value = "13";
  if (rz_ws_check_headers("GET", &h[0], 4) != RZ_WS_UPGRADE_OK) { return 1; }
  if (rz_ws_check_headers("POST", &h[0], 4) != 405) { return 2; }
  h[3].value = "8";
  if (rz_ws_check_headers("GET", &h[0], 4) != 426) { return 3; }
  if (rz_ws_check_headers("GET", &h[0], 3) != 426) { return 4; }
  h[3].value = "13";
  h[1].value = "keep-alive";
  if (rz_ws_check_headers("GET", &h[0], 4) != 400) { return 5; }
  h[1].value = "upgrade";
  h[0].value = "h2c";
  if (rz_ws_check_headers("GET", &h[0], 4) != 400) { return 6; }
  h[0].value = "WebSocket";
  h[2].value = "short";
  if (rz_ws_check_headers("GET", &h[0], 4) != 400) { return 7; }
  return 0;
}

@test fn t_rz_ws_write_101() -> int32 {
  var b: RzBuf* = rz_buf_new();
  var n: int64 = rz_ws_write_101("dGhlIHNhbXBsZSBub25jZQ==", "", b);
  var want: string = "HTTP/1.1 101 Switching Protocols\r\nUpgrade: websocket\r\nConnection: Upgrade\r\nSec-WebSocket-Accept: s3pPLMBiTxaQ9kYGzzhZRbK+xOo=\r\nServer: raize\r\n\r\n";
  var fail: int32 = 0;
  if (n != (int64)want.length) { fail = 1; }
  if (fail == 0 && !rz_str_eq(rz_buf_str(b), want)) { fail = 2; }
  if (fail == 0 && rz_ws_write_101("bad", "", b) != -1) { fail = 3; }
  rz_buf_free(b);
  return fail;
}
