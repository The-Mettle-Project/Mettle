// win32/api: the Windows API calls window uses (user32, gdi32, imm32, shell32 and
// kernel32 for basics), with the structure layouts from the Windows SDK
// headers (winuser.h, wingdi.h, imm.h). shcore and XInput are loaded at run
// time with GetProcAddress, so older Windows versions still start.

export struct W32Point { x: int32; y: int32; }
export struct W32Rect { left: int32; top: int32; right: int32; bottom: int32; }
export struct W32Msg { hwnd: int64; message: uint32; wparam: int64; lparam: int64; time: uint32; pt: W32Point; l_private: uint32; }
export struct W32Paint { hdc: int64; erase: int32; rc_paint: W32Rect; restore: int32; inc_update: int32; reserved: uint8[32]; }
export struct W32WndClassExW {
  cb_size: uint32; style: uint32; wnd_proc: fn(int64, uint32, int64, int64) -> int64;
  cls_extra: int32; wnd_extra: int32; instance: int64; icon: int64; cursor: int64; background: int64;
  menu_name: uint16*; class_name: uint16*; icon_sm: int64;
}
export struct W32Bmi {
  size: uint32; width: int32; height: int32; planes: uint16; bit_count: uint16; compression: uint32;
  size_image: uint32; x_ppm: int32; y_ppm: int32; clr_used: uint32; clr_important: uint32;
}
export struct W32TrackMouse { cb_size: uint32; flags: uint32; hwnd: int64; hover_time: uint32; }
export struct W32IconInfo { is_icon: int32; hot_x: uint32; hot_y: uint32; mask: int64; color: int64; }
export struct W32MonitorInfoEx { cb_size: uint32; monitor: W32Rect; work: W32Rect; flags: uint32; device: uint16[32]; }
export struct W32RawInputDevice { usage_page: uint16; usage: uint16; flags: uint32; target: int64; }
export struct W32FlashInfo { cb_size: uint32; hwnd: int64; flags: uint32; count: uint32; timeout: uint32; }
export struct W32CompositionForm { style: uint32; pos: W32Point; area: W32Rect; }
export struct W32CandidateForm { index: uint32; style: uint32; pos: W32Point; area: W32Rect; }

// kernel32
export extern fn window_w32_GetModuleHandleW(name: uint16*) -> int64 = "GetModuleHandleW";
export extern fn window_w32_LoadLibraryA(name: cstring) -> int64 = "LoadLibraryA";
export extern fn window_w32_GetProcAddress(module: int64, name: cstring) -> int64 = "GetProcAddress";
export extern fn window_w32_QueryPerformanceCounter(out: int64*) -> int32 = "QueryPerformanceCounter";
export extern fn window_w32_QueryPerformanceFrequency(out: int64*) -> int32 = "QueryPerformanceFrequency";
export extern fn window_w32_GlobalAlloc(flags: uint32, size: int64) -> int64 = "GlobalAlloc";
export extern fn window_w32_GlobalLock(mem: int64) -> rawptr = "GlobalLock";
export extern fn window_w32_GlobalUnlock(mem: int64) -> int32 = "GlobalUnlock";
export extern fn window_w32_GlobalSize(mem: int64) -> int64 = "GlobalSize";
export extern fn window_w32_GlobalFree(mem: int64) -> int64 = "GlobalFree";
export extern fn window_w32_CreateEventW(attrs: rawptr, manual: int32, initial: int32, name: uint16*) -> int64 = "CreateEventW";
export extern fn window_w32_SetEvent(ev: int64) -> int32 = "SetEvent";
export extern fn window_w32_CloseHandle(h: int64) -> int32 = "CloseHandle";
export extern fn window_w32_GetEnvironmentVariableA(name: cstring, buf: uint8*, size: uint32) -> uint32 = "GetEnvironmentVariableA";

