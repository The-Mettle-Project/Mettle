// ChaCha20 keystream on x86-64 with SSSE3 (two blocks per pass) and AVX2
// (eight or four blocks per pass), chosen at run time (crx_chacha_hw_level).
// The scalar code in chacha.mettle stays the fallback and does any tail.
//
// Eight blocks: one state word of all eight blocks per register, the
// quarter rounds done two at a time while two of the four "c" words wait on
// the stack, then a 4x4 transpose (vpunpck*) and vperm2i128 to put each
// block's bytes back in order. This is the layout of OpenSSL's ChaCha20_8x
// and libsodium's u8.h (Romain Dolbeau).
//
// Layout: one 16-byte row of the ChaCha state per register (an AVX2 register
// holds the same row of two blocks, one per 128-bit lane), the column round on
// rows as they are, then the diagonal round after rotating rows 1, 2 and 3 by
// one, two and three words with pshufd, then back. Rotations by 16 and 8 bits
// are byte shuffles (pshufb); by 12 and 7 bits two shifts and an or. This is
// the layout of RustCrypto's chacha20 crate (sse2 and avx2 backends) and of
// libsodium's chacha20 SIMD code (Romain Dolbeau); see docs/references.md.
//
// The Mettle assembler does not know pshufb, pshufd, pslld, psrld or any
// VEX (ymm) instruction, so those are db bytes from GNU as, with the
// instruction beside each line. There is no branch, address or table lookup
// that depends on the key or data, so these paths are constant time.
// Internal: the public entry points are cr_aead_* and cr_chacha20poly1305_*.

/// internal: 2 if this CPU has AVX2 and the OS saves ymm registers, 1 if it
/// has SSSE3 only, else 0.
@naked export fn crx_chacha_hw_level() -> uint32 {
  asm {
    push rbx
    mov eax, 1
    xor ecx, ecx
    cpuid
    xor r8d, r8d
    test ecx, 0x200
    jz done
    mov r8d, 1
    mov r9d, ecx
    and r9d, 0x18000000
    cmp r9d, 0x18000000
    jne done
    xor ecx, ecx
    xgetbv
    and eax, 6
    cmp eax, 6
    jne done
    mov eax, 7
    xor ecx, ecx
    cpuid
    test ebx, 0x20
    jz done
    mov r8d, 2
  done:
    mov eax, r8d
    pop rbx
    ret
  }
}

/// internal: as crx_chacha_avx2_blocks, eight blocks per pass: each
/// register holds one state word of eight blocks; four words stay on the
/// stack during the rounds and are wiped at the end. Needs
/// crx_chacha_hw_level() == 2.
/// in: nblocks >= 0 and a multiple of 8
@naked export fn crx_chacha_avx2x8_blocks(st: uint32*, src: uint8*, dst: uint8*, nblocks: int64) {
  asm {
    test rcx, rcx
    jz done
    sub rsp, 320
    mov rax, 0x0504070601000302
    mov [rsp+0], rax
    mov rax, 0x0d0c0f0e09080b0a
    mov [rsp+8], rax
    mov rax, 0x0504070601000302
    mov [rsp+16], rax
    mov rax, 0x0d0c0f0e09080b0a
    mov [rsp+24], rax
    mov rax, 0x0605040702010003
    mov [rsp+32], rax
    mov rax, 0x0e0d0c0f0a09080b
    mov [rsp+40], rax
    mov rax, 0x0605040702010003
    mov [rsp+48], rax
    mov rax, 0x0e0d0c0f0a09080b
    mov [rsp+56], rax
    mov rax, 0x0000000800000008
    mov [rsp+96], rax
    mov rax, 0x0000000800000008
    mov [rsp+104], rax
    mov rax, 0x0000000800000008
    mov [rsp+112], rax
    mov rax, 0x0000000800000008
    mov [rsp+120], rax
    mov rax, 0x0000000100000000
    mov [rsp+256], rax
    mov rax, 0x0000000300000002
    mov [rsp+264], rax
    mov rax, 0x0000000500000004
    mov [rsp+272], rax
    mov rax, 0x0000000700000006
    mov [rsp+280], rax
    db 0xc4, 0x62, 0x7d, 0x58, 0x67, 0x30   ; vpbroadcastd ymm12, [rdi+48]
    db 0xc5, 0x1d, 0xfe, 0xa4, 0x24, 0x00, 0x01, 0x00, 0x00   ; vpaddd ymm12, ymm12, [rsp+256]
    db 0xc5, 0x7e, 0x7f, 0x64, 0x24, 0x40   ; vmovdqu [rsp+64], ymm12
  next8:
    db 0xc4, 0xe2, 0x7d, 0x58, 0x07   ; vpbroadcastd ymm0, [rdi+0]
    db 0xc4, 0xe2, 0x7d, 0x58, 0x4f, 0x04   ; vpbroadcastd ymm1, [rdi+4]
    db 0xc4, 0xe2, 0x7d, 0x58, 0x57, 0x08   ; vpbroadcastd ymm2, [rdi+8]
    db 0xc4, 0xe2, 0x7d, 0x58, 0x5f, 0x0c   ; vpbroadcastd ymm3, [rdi+12]
    db 0xc4, 0xe2, 0x7d, 0x58, 0x67, 0x10   ; vpbroadcastd ymm4, [rdi+16]
    db 0xc4, 0xe2, 0x7d, 0x58, 0x6f, 0x14   ; vpbroadcastd ymm5, [rdi+20]
    db 0xc4, 0xe2, 0x7d, 0x58, 0x77, 0x18   ; vpbroadcastd ymm6, [rdi+24]
    db 0xc4, 0xe2, 0x7d, 0x58, 0x7f, 0x1c   ; vpbroadcastd ymm7, [rdi+28]
    db 0xc4, 0x62, 0x7d, 0x58, 0x47, 0x20   ; vpbroadcastd ymm8, [rdi+32]
    db 0xc4, 0x62, 0x7d, 0x58, 0x4f, 0x24   ; vpbroadcastd ymm9, [rdi+36]
    db 0xc4, 0x62, 0x7d, 0x58, 0x57, 0x28   ; vpbroadcastd ymm10, [rdi+40]
    db 0xc5, 0x7e, 0x7f, 0x94, 0x24, 0xc0, 0x00, 0x00, 0x00   ; vmovdqu [rsp+192], ymm10
    db 0xc4, 0x62, 0x7d, 0x58, 0x57, 0x2c   ; vpbroadcastd ymm10, [rdi+44]
    db 0xc5, 0x7e, 0x7f, 0x94, 0x24, 0xe0, 0x00, 0x00, 0x00   ; vmovdqu [rsp+224], ymm10
    db 0xc5, 0x7e, 0x6f, 0x64, 0x24, 0x40   ; vmovdqu ymm12, [rsp+64]
    db 0xc4, 0x62, 0x7d, 0x58, 0x6f, 0x34   ; vpbroadcastd ymm13, [rdi+52]
    db 0xc4, 0x62, 0x7d, 0x58, 0x77, 0x38   ; vpbroadcastd ymm14, [rdi+56]
    db 0xc4, 0x62, 0x7d, 0x58, 0x7f, 0x3c   ; vpbroadcastd ymm15, [rdi+60]
    mov eax, 10
  dround:
    db 0xc5, 0xfd, 0xfe, 0xc4   ; vpaddd ymm0, ymm0, ymm4
    db 0xc5, 0xf5, 0xfe, 0xcd   ; vpaddd ymm1, ymm1, ymm5
    db 0xc5, 0x1d, 0xef, 0xe0   ; vpxor ymm12, ymm12, ymm0
    db 0xc5, 0x15, 0xef, 0xe9   ; vpxor ymm13, ymm13, ymm1
    db 0xc4, 0x62, 0x1d, 0x00, 0x24, 0x24   ; vpshufb ymm12, ymm12, [rsp]
    db 0xc4, 0x62, 0x15, 0x00, 0x2c, 0x24   ; vpshufb ymm13, ymm13, [rsp]
    db 0xc4, 0x41, 0x3d, 0xfe, 0xc4   ; vpaddd ymm8, ymm8, ymm12
    db 0xc4, 0x41, 0x35, 0xfe, 0xcd   ; vpaddd ymm9, ymm9, ymm13
    db 0xc4, 0xc1, 0x5d, 0xef, 0xe0   ; vpxor ymm4, ymm4, ymm8
    db 0xc4, 0xc1, 0x55, 0xef, 0xe9   ; vpxor ymm5, ymm5, ymm9
    db 0xc5, 0xad, 0x72, 0xf4, 0x0c   ; vpslld ymm10, ymm4, 12
    db 0xc5, 0xa5, 0x72, 0xf5, 0x0c   ; vpslld ymm11, ymm5, 12
    db 0xc5, 0xdd, 0x72, 0xd4, 0x14   ; vpsrld ymm4, ymm4, 20
    db 0xc5, 0xd5, 0x72, 0xd5, 0x14   ; vpsrld ymm5, ymm5, 20
    db 0xc4, 0xc1, 0x5d, 0xeb, 0xe2   ; vpor ymm4, ymm4, ymm10
    db 0xc4, 0xc1, 0x55, 0xeb, 0xeb   ; vpor ymm5, ymm5, ymm11
    db 0xc5, 0xfd, 0xfe, 0xc4   ; vpaddd ymm0, ymm0, ymm4
    db 0xc5, 0xf5, 0xfe, 0xcd   ; vpaddd ymm1, ymm1, ymm5
    db 0xc5, 0x1d, 0xef, 0xe0   ; vpxor ymm12, ymm12, ymm0
    db 0xc5, 0x15, 0xef, 0xe9   ; vpxor ymm13, ymm13, ymm1
    db 0xc4, 0x62, 0x1d, 0x00, 0x64, 0x24, 0x20   ; vpshufb ymm12, ymm12, [rsp+32]
    db 0xc4, 0x62, 0x15, 0x00, 0x6c, 0x24, 0x20   ; vpshufb ymm13, ymm13, [rsp+32]
    db 0xc4, 0x41, 0x3d, 0xfe, 0xc4   ; vpaddd ymm8, ymm8, ymm12
    db 0xc4, 0x41, 0x35, 0xfe, 0xcd   ; vpaddd ymm9, ymm9, ymm13
    db 0xc4, 0xc1, 0x5d, 0xef, 0xe0   ; vpxor ymm4, ymm4, ymm8
    db 0xc4, 0xc1, 0x55, 0xef, 0xe9   ; vpxor ymm5, ymm5, ymm9
    db 0xc5, 0xad, 0x72, 0xf4, 0x07   ; vpslld ymm10, ymm4, 7
    db 0xc5, 0xa5, 0x72, 0xf5, 0x07   ; vpslld ymm11, ymm5, 7
    db 0xc5, 0xdd, 0x72, 0xd4, 0x19   ; vpsrld ymm4, ymm4, 25
    db 0xc5, 0xd5, 0x72, 0xd5, 0x19   ; vpsrld ymm5, ymm5, 25
    db 0xc4, 0xc1, 0x5d, 0xeb, 0xe2   ; vpor ymm4, ymm4, ymm10
    db 0xc4, 0xc1, 0x55, 0xeb, 0xeb   ; vpor ymm5, ymm5, ymm11
    db 0xc5, 0x7e, 0x7f, 0x84, 0x24, 0x80, 0x00, 0x00, 0x00   ; vmovdqu [rsp+128], ymm8
    db 0xc5, 0x7e, 0x7f, 0x8c, 0x24, 0xa0, 0x00, 0x00, 0x00   ; vmovdqu [rsp+160], ymm9
    db 0xc5, 0x7e, 0x6f, 0x84, 0x24, 0xc0, 0x00, 0x00, 0x00   ; vmovdqu ymm8, [rsp+192]
    db 0xc5, 0x7e, 0x6f, 0x8c, 0x24, 0xe0, 0x00, 0x00, 0x00   ; vmovdqu ymm9, [rsp+224]
    db 0xc5, 0xed, 0xfe, 0xd6   ; vpaddd ymm2, ymm2, ymm6
    db 0xc5, 0xe5, 0xfe, 0xdf   ; vpaddd ymm3, ymm3, ymm7
    db 0xc5, 0x0d, 0xef, 0xf2   ; vpxor ymm14, ymm14, ymm2
    db 0xc5, 0x05, 0xef, 0xfb   ; vpxor ymm15, ymm15, ymm3
    db 0xc4, 0x62, 0x0d, 0x00, 0x34, 0x24   ; vpshufb ymm14, ymm14, [rsp]
    db 0xc4, 0x62, 0x05, 0x00, 0x3c, 0x24   ; vpshufb ymm15, ymm15, [rsp]
    db 0xc4, 0x41, 0x3d, 0xfe, 0xc6   ; vpaddd ymm8, ymm8, ymm14
    db 0xc4, 0x41, 0x35, 0xfe, 0xcf   ; vpaddd ymm9, ymm9, ymm15
    db 0xc4, 0xc1, 0x4d, 0xef, 0xf0   ; vpxor ymm6, ymm6, ymm8
    db 0xc4, 0xc1, 0x45, 0xef, 0xf9   ; vpxor ymm7, ymm7, ymm9
    db 0xc5, 0xad, 0x72, 0xf6, 0x0c   ; vpslld ymm10, ymm6, 12
    db 0xc5, 0xa5, 0x72, 0xf7, 0x0c   ; vpslld ymm11, ymm7, 12
    db 0xc5, 0xcd, 0x72, 0xd6, 0x14   ; vpsrld ymm6, ymm6, 20
    db 0xc5, 0xc5, 0x72, 0xd7, 0x14   ; vpsrld ymm7, ymm7, 20
    db 0xc4, 0xc1, 0x4d, 0xeb, 0xf2   ; vpor ymm6, ymm6, ymm10
    db 0xc4, 0xc1, 0x45, 0xeb, 0xfb   ; vpor ymm7, ymm7, ymm11
    db 0xc5, 0xed, 0xfe, 0xd6   ; vpaddd ymm2, ymm2, ymm6
    db 0xc5, 0xe5, 0xfe, 0xdf   ; vpaddd ymm3, ymm3, ymm7
    db 0xc5, 0x0d, 0xef, 0xf2   ; vpxor ymm14, ymm14, ymm2
    db 0xc5, 0x05, 0xef, 0xfb   ; vpxor ymm15, ymm15, ymm3
    db 0xc4, 0x62, 0x0d, 0x00, 0x74, 0x24, 0x20   ; vpshufb ymm14, ymm14, [rsp+32]
    db 0xc4, 0x62, 0x05, 0x00, 0x7c, 0x24, 0x20   ; vpshufb ymm15, ymm15, [rsp+32]
    db 0xc4, 0x41, 0x3d, 0xfe, 0xc6   ; vpaddd ymm8, ymm8, ymm14
    db 0xc4, 0x41, 0x35, 0xfe, 0xcf   ; vpaddd ymm9, ymm9, ymm15
    db 0xc4, 0xc1, 0x4d, 0xef, 0xf0   ; vpxor ymm6, ymm6, ymm8
    db 0xc4, 0xc1, 0x45, 0xef, 0xf9   ; vpxor ymm7, ymm7, ymm9
    db 0xc5, 0xad, 0x72, 0xf6, 0x07   ; vpslld ymm10, ymm6, 7
    db 0xc5, 0xa5, 0x72, 0xf7, 0x07   ; vpslld ymm11, ymm7, 7
    db 0xc5, 0xcd, 0x72, 0xd6, 0x19   ; vpsrld ymm6, ymm6, 25
    db 0xc5, 0xc5, 0x72, 0xd7, 0x19   ; vpsrld ymm7, ymm7, 25
    db 0xc4, 0xc1, 0x4d, 0xeb, 0xf2   ; vpor ymm6, ymm6, ymm10
    db 0xc4, 0xc1, 0x45, 0xeb, 0xfb   ; vpor ymm7, ymm7, ymm11
    db 0xc5, 0xfd, 0xfe, 0xc5   ; vpaddd ymm0, ymm0, ymm5
    db 0xc5, 0xf5, 0xfe, 0xce   ; vpaddd ymm1, ymm1, ymm6
    db 0xc5, 0x05, 0xef, 0xf8   ; vpxor ymm15, ymm15, ymm0
    db 0xc5, 0x1d, 0xef, 0xe1   ; vpxor ymm12, ymm12, ymm1
    db 0xc4, 0x62, 0x05, 0x00, 0x3c, 0x24   ; vpshufb ymm15, ymm15, [rsp]
    db 0xc4, 0x62, 0x1d, 0x00, 0x24, 0x24   ; vpshufb ymm12, ymm12, [rsp]
    db 0xc4, 0x41, 0x3d, 0xfe, 0xc7   ; vpaddd ymm8, ymm8, ymm15
    db 0xc4, 0x41, 0x35, 0xfe, 0xcc   ; vpaddd ymm9, ymm9, ymm12
    db 0xc4, 0xc1, 0x55, 0xef, 0xe8   ; vpxor ymm5, ymm5, ymm8
    db 0xc4, 0xc1, 0x4d, 0xef, 0xf1   ; vpxor ymm6, ymm6, ymm9
    db 0xc5, 0xad, 0x72, 0xf5, 0x0c   ; vpslld ymm10, ymm5, 12
    db 0xc5, 0xa5, 0x72, 0xf6, 0x0c   ; vpslld ymm11, ymm6, 12
    db 0xc5, 0xd5, 0x72, 0xd5, 0x14   ; vpsrld ymm5, ymm5, 20
    db 0xc5, 0xcd, 0x72, 0xd6, 0x14   ; vpsrld ymm6, ymm6, 20
    db 0xc4, 0xc1, 0x55, 0xeb, 0xea   ; vpor ymm5, ymm5, ymm10
    db 0xc4, 0xc1, 0x4d, 0xeb, 0xf3   ; vpor ymm6, ymm6, ymm11
    db 0xc5, 0xfd, 0xfe, 0xc5   ; vpaddd ymm0, ymm0, ymm5
    db 0xc5, 0xf5, 0xfe, 0xce   ; vpaddd ymm1, ymm1, ymm6
    db 0xc5, 0x05, 0xef, 0xf8   ; vpxor ymm15, ymm15, ymm0
    db 0xc5, 0x1d, 0xef, 0xe1   ; vpxor ymm12, ymm12, ymm1
    db 0xc4, 0x62, 0x05, 0x00, 0x7c, 0x24, 0x20   ; vpshufb ymm15, ymm15, [rsp+32]
    db 0xc4, 0x62, 0x1d, 0x00, 0x64, 0x24, 0x20   ; vpshufb ymm12, ymm12, [rsp+32]
    db 0xc4, 0x41, 0x3d, 0xfe, 0xc7   ; vpaddd ymm8, ymm8, ymm15
    db 0xc4, 0x41, 0x35, 0xfe, 0xcc   ; vpaddd ymm9, ymm9, ymm12
    db 0xc4, 0xc1, 0x55, 0xef, 0xe8   ; vpxor ymm5, ymm5, ymm8
    db 0xc4, 0xc1, 0x4d, 0xef, 0xf1   ; vpxor ymm6, ymm6, ymm9
    db 0xc5, 0xad, 0x72, 0xf5, 0x07   ; vpslld ymm10, ymm5, 7
    db 0xc5, 0xa5, 0x72, 0xf6, 0x07   ; vpslld ymm11, ymm6, 7
