    db 0xc4, 0xc1, 0x45, 0xef, 0xf8   ; vpxor ymm7, ymm7, ymm8
    db 0xc4, 0xc1, 0x5d, 0xef, 0xe1   ; vpxor ymm4, ymm4, ymm9
