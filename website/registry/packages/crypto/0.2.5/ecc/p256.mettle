// NIST P-256 (secp256r1) key pairs and ECDH, in pure Mettle, constant time
// in the secret scalar: the "m31" implementation of BearSSL, with field
// elements as nine 30-bit limbs, Jacobian points, a 2-bit window for
// arbitrary points and a 4-bit window over a precomputed table for the
// generator. Standards: FIPS 186-5 (the curve and key pairs), SEC 1 v2
// (point encoding).
//
// Ported from BearSSL (ec_p256_m31.c, ec_secp256r1.c), Copyright (c) 2017
// Thomas Pornin, MIT license; see NOTICE.
//
// A public key is the uncompressed point 0x04 || X || Y (65 bytes, X and Y
// big-endian). A secret key is the scalar d, 32 bytes big-endian, with
// 1 <= d <= n-1. The ECDH result is the X coordinate of d * Q, as 32 bytes;
// it is not a key, so run it through a KDF (cr_hkdf_sha256 or
// cr_hkdf_sha384) before using it.

import "crypto/core/status";
import "crypto/core/types";
import "crypto/core/util";
import "crypto/ecc/i31";

/// Size in bytes of a P-256 public key: the uncompressed point 0x04 || X || Y.
/// in: -
/// returns: 65
/// owns: nothing
/// thread: constant
/// example: var pk: uint8[65]; cr_p256_keypair(&pk[0], CR_P256_PUBLIC_BYTES, &sk);
export const CR_P256_PUBLIC_BYTES: int64 = 65;

/// CrP256Secret: A P-256 secret key, the scalar d as 32 big-endian bytes with
/// 1 <= d <= n-1 (n is the group order).
/// in: - (zeroed when declared: `var x: CrP256Secret;`)
/// returns: -
/// owns: secret: wipe with cr_wipe(&sk.b[0], 32) when done
/// thread: any thread (no shared state)
/// example: var sk: CrP256Secret; cr_p256_keypair(&pk[0], 65, &sk);
export struct CrP256Secret {
  b: uint8[32];
}

const CRX_P256_M30: uint32 = 0x3FFFFFFF;
const CRX_P256_M30W: uint64 = 0x3FFFFFFF;

// Base field modulus p = 2^256 - 2^224 + 2^192 + 2^96 - 1, in 30-bit limbs.
var g_crx_p256_f: uint32[9] = [
  0x3FFFFFFF, 0x3FFFFFFF, 0x3FFFFFFF, 0x0000003F, 0x00000000,
  0x00000000, 0x00001000, 0x3FFFC000, 0x0000FFFF
];

// The b coefficient of the curve equation y^2 = x^3 - 3x + b, in 30-bit limbs.
var g_crx_p256_b: uint32[9] = [
  0x27D2604B, 0x2F38F0F8, 0x053B0F63, 0x0741AC33, 0x1886BC65,
  0x2EF555DA, 0x293E7B3E, 0x0D762A8E, 0x00005AC6
];

// The group order n.
var g_crx_p256_n: uint8[32] = [
  0xFF, 0xFF, 0xFF, 0xFF, 0x00, 0x00, 0x00, 0x00,
  0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF,
  0xBC, 0xE6, 0xFA, 0xAD, 0xA7, 0x17, 0x9E, 0x84,
  0xF3, 0xB9, 0xCA, 0xC2, 0xFC, 0x63, 0x25, 0x51
];

// Precomputed window: k * G for k = 1 to 15, G the generator. Each entry is
