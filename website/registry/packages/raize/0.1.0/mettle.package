name = raize
version = 0.1.0
description = Phoenix-style web framework for Mettle: SSR, Signals, Channels, Resources
license = Apache-2.0
source = https://github.com/Lex-Dellimere/RaizeWeb
compiler = 0.18.0
platforms = linux windows
require = raize_core 0.1.0
require = raize_realtime 0.1.0
require = raize_template 0.1.0
require = raize_signal 0.1.0
require = raize_resource 0.1.0
require = raize_app 0.1.0
require = raize_session 0.2.1
require = raize_auth 0.1.1
require = raize_api 0.1.0
require = raize_telemetry 0.1.0
require = cryptex 0.3.0
