// UTF-8 validation (RFC 3629): no overlong forms, no surrogates, nothing past
// U+10FFFF. ASCII runs are checked 8 bytes at a time.
import "codec/core/varint";

export fn codec_utf8_valid(p: uint8*, n: int64) -> bool {
  var i: int64 = 0;
  while (i < n) {
    // Fast path: 8 ASCII bytes at once.
    while (i + 8 <= n && (codec_get_le64(p + i) & 0x8080808080808080) == 0) {
      i = i + 8;
    }
    if (i >= n) { return true; }
    var c: int32 = (int32)p[i];
    if (c < 0x80) {
      i = i + 1;
    } else if (c < 0xc2) {
      return false;                               // continuation byte or overlong 2-byte lead
    } else if (c < 0xe0) {
      if (i + 1 >= n || ((int32)p[i + 1] & 0xc0) != 0x80) { return false; }
      i = i + 2;
    } else if (c < 0xf0) {
      if (i + 2 >= n) { return false; }
      var c1: int32 = (int32)p[i + 1];
      if ((c1 & 0xc0) != 0x80 || ((int32)p[i + 2] & 0xc0) != 0x80) { return false; }
      if (c == 0xe0 && c1 < 0xa0) { return false; }   // overlong
      if (c == 0xed && c1 >= 0xa0) { return false; }  // surrogates
      i = i + 3;
    } else if (c < 0xf5) {
      if (i + 3 >= n) { return false; }
      var d1: int32 = (int32)p[i + 1];
      if ((d1 & 0xc0) != 0x80 || ((int32)p[i + 2] & 0xc0) != 0x80 || ((int32)p[i + 3] & 0xc0) != 0x80) { return false; }
      if (c == 0xf0 && d1 < 0x90) { return false; }   // overlong
      if (c == 0xf4 && d1 >= 0x90) { return false; }  // past U+10FFFF
      i = i + 4;
    } else {
      return false;
    }
  }
  return true;
}

export fn codec_utf8_valid_string(s: string) -> bool {
  return codec_utf8_valid(s.chars, (int64)s.length);
}
