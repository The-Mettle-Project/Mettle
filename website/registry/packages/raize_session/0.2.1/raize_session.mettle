// raize_session — sessions for raize apps:  import "raize_session/raize_session";
// reference: sessions
// thread: see each module; the app's SesStore must be thread-safe.
//
// The HTTP binding of the framework-agnostic `session` library: hashed opaque
// tokens, idle and absolute expiry, rotation, CSRF and flash all come from it;
// this package carries them over the cookie and the request. Apps opt in (the raize
// umbrella does not depend on it) and supply the storage (a SesStore): raize ships
// none.
//
//   use    RzSessionConfig, rz_session_defaults, rz_use_session, rz_csrf_exempt
//   api    rz_session_get/_put/_delete/_rotate/_login/_drop/_id_present, rz_csrf_token,
//          rz_flash_put, rz_flash_take
//   conn   rz_conn_session_get (a Signal mount or channel join)
//   state  internal: the published settings and the per-request state
//
// This facade exports nothing, so importing it brings in every module below.

import "state";
import "use";
import "api";
import "conn";
