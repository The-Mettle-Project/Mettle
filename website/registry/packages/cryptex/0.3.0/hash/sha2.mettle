// SHA-256, SHA-384 and SHA-512 (FIPS 180-4) in pure Mettle: the incremental
// engines behind cr_sha256, cr_sha384, cr_sha512 and the HMAC functions. Internal module (crx_
// prefix): callers have already validated their arguments, these functions
// do not. Words are loaded and stored big-endian with explicit shifts, all
// arithmetic is on unsigned types and no index or branch depends on the
// data, so the code is constant time for secret input.
//
// SHA-384 is SHA-512 with other initial values and the output cut to 48
// bytes; it shares the SHA-512 compression.
//
// On x86-64 CPUs with SHA-NI, SHA-256 blocks go through
// sha256_hw_x86_64.mettle instead; the output is the same.
//
// The SHA-512 round constants are stored as 32-bit halves (high, low) and
// joined when used, because Mettle integer literals are 32-bit.

import "cryptex/core/status";
import "cryptex/core/util";
import "cryptex/hash/sha256_hw_x86_64" if x86_64;
import "cryptex/hash/sha256_hw_aarch64" if aarch64;

