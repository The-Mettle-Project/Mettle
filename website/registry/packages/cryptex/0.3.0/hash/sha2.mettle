/// internal: SHA-256 running state (chaining value, partial block, byte count).
export struct CrxSha256 {
  h: uint32[8];
  buf: uint8[64];
  buflen: int64;
  total: uint64;
}

/// internal: SHA-512 running state (chaining value, partial block, byte count).
export struct CrxSha512 {
  h: uint64[8];
  buf: uint8[128];
  buflen: int64;
  total: uint64;
}

/// internal: SHA-384 running state (same layout as CrxSha512, which it shares).
export struct CrxSha384 {
  h: uint64[8];
  buf: uint8[128];
  buflen: int64;
  total: uint64;
}

fn crx_rotr32(x: uint32, n: int32) -> uint32 {
  return (x >> n) | (x << (32 - n));
}

fn crx_rotr64(x: uint64, n: int32) -> uint64 {
  return (x >> n) | (x << (64 - n));
}

fn crx_load32be(p: uint8*) -> uint32 {
  return ((uint32)p[0] << 24) | ((uint32)p[1] << 16) | ((uint32)p[2] << 8) | (uint32)p[3];
}

fn crx_store32be(p: uint8*, v: uint32) {
  p[0] = (uint8)(v >> 24);
  p[1] = (uint8)(v >> 16);
  p[2] = (uint8)(v >> 8);
  p[3] = (uint8)v;
}

fn crx_load64be(p: uint8*) -> uint64 {
  return ((uint64)crx_load32be(p) << 32) | (uint64)crx_load32be(&p[4]);
}

fn crx_store64be(p: uint8*, v: uint64) {
  crx_store32be(p, (uint32)(v >> 32));
  crx_store32be(&p[4], (uint32)v);
}

// One 64-byte block.
/// internal: the portable SHA-256 compression of one 64-byte block (also
/// used by the tests to check the SHA-NI path).
export fn crx_sha256_block_sw(s: CrxSha256*, blk: uint8*) {
  var w: uint32[64];
  for i in 0..16 {
    w[i] = crx_load32be(&blk[i * 4]);
  }
  for i in 16..64 {
    var w15: uint32 = w[i - 15];
    var w2: uint32 = w[i - 2];
    var s0: uint32 = crx_rotr32(w15, 7) ^ crx_rotr32(w15, 18) ^ (w15 >> 3);
    var s1: uint32 = crx_rotr32(w2, 17) ^ crx_rotr32(w2, 19) ^ (w2 >> 10);
    w[i] = w[i - 16] + s0 + w[i - 7] + s1;
  }
  var a: uint32 = s->h[0];
  var b: uint32 = s->h[1];
  var c: uint32 = s->h[2];
  var d: uint32 = s->h[3];
  var e: uint32 = s->h[4];
  var f: uint32 = s->h[5];
  var g: uint32 = s->h[6];
  var h: uint32 = s->h[7];
  for i in 0..64 {
    var bs1: uint32 = crx_rotr32(e, 6) ^ crx_rotr32(e, 11) ^ crx_rotr32(e, 25);
    var ch: uint32 = (e & f) ^ (~e & g);
    var t1: uint32 = h + bs1 + ch + g_crx_k256[i] + w[i];
    var bs0: uint32 = crx_rotr32(a, 2) ^ crx_rotr32(a, 13) ^ crx_rotr32(a, 22);
    var maj: uint32 = (a & b) ^ (a & c) ^ (b & c);
    var t2: uint32 = bs0 + maj;
    h = g;
    g = f;
    f = e;
    e = d + t1;
    d = c;
    c = b;
    b = a;
    a = t1 + t2;
  }
  s->h[0] = s->h[0] + a;
  s->h[1] = s->h[1] + b;
  s->h[2] = s->h[2] + c;
  s->h[3] = s->h[3] + d;
  s->h[4] = s->h[4] + e;
  s->h[5] = s->h[5] + f;
  s->h[6] = s->h[6] + g;
  s->h[7] = s->h[7] + h;
  cr_wipe((uint8*)&w[0], 256);
}

// One 128-byte block.
fn crx_sha512_block(s: CrxSha512*, blk: uint8*) {
  var w: uint64[80];
  for i in 0..16 {
    w[i] = crx_load64be(&blk[i * 8]);
  }
  for i in 16..80 {
    var w15: uint64 = w[i - 15];
    var w2: uint64 = w[i - 2];
    var s0: uint64 = crx_rotr64(w15, 1) ^ crx_rotr64(w15, 8) ^ (w15 >> 7);
    var s1: uint64 = crx_rotr64(w2, 19) ^ crx_rotr64(w2, 61) ^ (w2 >> 6);
    w[i] = w[i - 16] + s0 + w[i - 7] + s1;
  }
  var a: uint64 = s->h[0];
  var b: uint64 = s->h[1];
  var c: uint64 = s->h[2];
  var d: uint64 = s->h[3];
  var e: uint64 = s->h[4];
  var f: uint64 = s->h[5];
  var g: uint64 = s->h[6];
  var h: uint64 = s->h[7];
  for i in 0..80 {
    var k: uint64 = ((uint64)g_crx_k512[i * 2] << 32) | (uint64)g_crx_k512[i * 2 + 1];
    var bs1: uint64 = crx_rotr64(e, 14) ^ crx_rotr64(e, 18) ^ crx_rotr64(e, 41);
    var ch: uint64 = (e & f) ^ (~e & g);
    var t1: uint64 = h + bs1 + ch + k + w[i];
    var bs0: uint64 = crx_rotr64(a, 28) ^ crx_rotr64(a, 34) ^ crx_rotr64(a, 39);
    var maj: uint64 = (a & b) ^ (a & c) ^ (b & c);
    var t2: uint64 = bs0 + maj;
    h = g;
    g = f;
    f = e;
    e = d + t1;
    d = c;
    c = b;
    b = a;
    a = t1 + t2;
  }
  s->h[0] = s->h[0] + a;
  s->h[1] = s->h[1] + b;
  s->h[2] = s->h[2] + c;
  s->h[3] = s->h[3] + d;
  s->h[4] = s->h[4] + e;
  s->h[5] = s->h[5] + f;
  s->h[6] = s->h[6] + g;
  s->h[7] = s->h[7] + h;
  cr_wipe((uint8*)&w[0], 640);
}

var g_crx_sha256_hw: uint32 = 0;

fn crx_sha256_blocks(s: CrxSha256*, p: uint8*, nblocks: int64) {
  var l: uint32 = g_crx_sha256_hw;
  if (l == 0) {
    l = crx_sha256_hw_available() + (uint32)1;
    g_crx_sha256_hw = l;
  }
  if (l == 2) {
    crx_sha256_hw_blocks(&s->h[0], p, nblocks, &g_crx_k256[0]);
    return;
  }
  var i: int64 = 0;
  while (i < nblocks) {
    crx_sha256_block_sw(s, &p[i * 64]);
    i = i + 1;
  }
}

/// internal: starts a SHA-256 computation.
export fn crx_sha256_init(s: CrxSha256*) {
  for i in 0..8 {
    s->h[i] = g_crx_h256[i];
  }
  for i in 0..64 {
    s->buf[i] = 0;
  }
  s->buflen = 0;
  s->total = 0;
}

/// internal: feeds n bytes into a SHA-256 computation.
export fn crx_sha256_update(s: CrxSha256*, p: uint8*, n: int64) {
  s->total = s->total + (uint64)n;
  var pos: int64 = 0;
  if (s->buflen > 0) {
    while (pos < n && s->buflen < 64) {
      s->buf[s->buflen] = p[pos];
      s->buflen = s->buflen + 1;
      pos = pos + 1;
    }
    if (s->buflen < 64) { return; }
    crx_sha256_blocks(s, &s->buf[0], 1);
    s->buflen = 0;
  }
  var nb: int64 = (n - pos) >> 6;
  if (nb > 0) {
    crx_sha256_blocks(s, &p[pos], nb);
    pos = pos + (nb << 6);
  }
  while (pos < n) {
    s->buf[s->buflen] = p[pos];
    s->buflen = s->buflen + 1;
    pos = pos + 1;
  }
}

/// internal: finishes SHA-256: writes 32 bytes to out, then wipes s.
export fn crx_sha256_final(s: CrxSha256*, out: uint8*) {
  var bits: uint64 = s->total << 3;
  var i: int64 = s->buflen;
  s->buf[i] = 128;
  i = i + 1;
  if (i > 56) {
    while (i < 64) { s->buf[i] = 0; i = i + 1; }
    crx_sha256_blocks(s, &s->buf[0], 1);
    i = 0;
  }
  while (i < 56) { s->buf[i] = 0; i = i + 1; }
  crx_store64be(&s->buf[56], bits);
  crx_sha256_blocks(s, &s->buf[0], 1);
  for j in 0..8 {
    crx_store32be(&out[j * 4], s->h[j]);
  }
  cr_wipe((uint8*)s, (int64)sizeof(CrxSha256));
}

/// internal: starts a SHA-512 computation.
export fn crx_sha512_init(s: CrxSha512*) {
  for i in 0..8 {
    s->h[i] = ((uint64)g_crx_h512[i * 2] << 32) | (uint64)g_crx_h512[i * 2 + 1];
  }
  for i in 0..128 {
    s->buf[i] = 0;
  }
  s->buflen = 0;
  s->total = 0;
}

/// internal: feeds n bytes into a SHA-512 computation.
export fn crx_sha512_update(s: CrxSha512*, p: uint8*, n: int64) {
  s->total = s->total + (uint64)n;
  var pos: int64 = 0;
  if (s->buflen > 0) {
    while (pos < n && s->buflen < 128) {
      s->buf[s->buflen] = p[pos];
      s->buflen = s->buflen + 1;
      pos = pos + 1;
    }
    if (s->buflen < 128) { return; }
    crx_sha512_block(s, &s->buf[0]);
    s->buflen = 0;
  }
  while (n - pos >= 128) {
    crx_sha512_block(s, &p[pos]);
    pos = pos + 128;
  }
  while (pos < n) {
    s->buf[s->buflen] = p[pos];
    s->buflen = s->buflen + 1;
    pos = pos + 1;
  }
}

/// internal: finishes SHA-512: writes 64 bytes to out, then wipes s.
export fn crx_sha512_final(s: CrxSha512*, out: uint8*) {
  var bits: uint64 = s->total << 3;
  var hibits: uint64 = s->total >> 61;
  var i: int64 = s->buflen;
  s->buf[i] = 128;
  i = i + 1;
  if (i > 112) {
    while (i < 128) { s->buf[i] = 0; i = i + 1; }
    crx_sha512_block(s, &s->buf[0]);
    i = 0;
  }
  while (i < 112) { s->buf[i] = 0; i = i + 1; }
  crx_store64be(&s->buf[112], hibits);
  crx_store64be(&s->buf[120], bits);
  crx_sha512_block(s, &s->buf[0]);
  for j in 0..8 {
    crx_store64be(&out[j * 8], s->h[j]);
  }
  cr_wipe((uint8*)s, (int64)sizeof(CrxSha512));
}

/// internal: starts a SHA-384 computation.
export fn crx_sha384_init(s: CrxSha384*) {
  for i in 0..8 {
    s->h[i] = ((uint64)g_crx_h384[i * 2] << 32) | (uint64)g_crx_h384[i * 2 + 1];
  }
  for i in 0..128 {
    s->buf[i] = 0;
  }
  s->buflen = 0;
  s->total = 0;
}

/// internal: feeds n bytes into a SHA-384 computation.
export fn crx_sha384_update(s: CrxSha384*, p: uint8*, n: int64) {
  crx_sha512_update((CrxSha512*)s, p, n);
}

/// internal: finishes SHA-384: writes 48 bytes to out, then wipes s.
export fn crx_sha384_final(s: CrxSha384*, out: uint8*) {
  var full: uint8[64];
  crx_sha512_final((CrxSha512*)s, &full[0]);
  for i in 0..48 {
    out[i] = full[i];
  }
  cr_wipe(&full[0], 64);
}
