// MD5 (RFC 1321) in pure Mettle. Internal module (crx_ prefix) behind the
// public cr_md5 in hash/legacy. MD5 is broken for collision resistance: it
// exists here only because standards such as RFC 9562 name-based UUIDs
// (version 3) require it. Callers have already validated their arguments,
// these functions do not. Words and the bit length are loaded and stored
// little-endian with explicit shifts, all arithmetic is on unsigned types and
// no index or branch depends on the data.
//
// The 64 constants are T[i] = floor(2^32 * abs(sin(i + 1))) from the RFC.

import "cryptex/core/status";
import "cryptex/core/util";

var g_crx_md5_t: uint32[64] = [
  (uint32)0xd76aa478, (uint32)0xe8c7b756, (uint32)0x242070db, (uint32)0xc1bdceee,
  (uint32)0xf57c0faf, (uint32)0x4787c62a, (uint32)0xa8304613, (uint32)0xfd469501,
  (uint32)0x698098d8, (uint32)0x8b44f7af, (uint32)0xffff5bb1, (uint32)0x895cd7be,
  (uint32)0x6b901122, (uint32)0xfd987193, (uint32)0xa679438e, (uint32)0x49b40821,
  (uint32)0xf61e2562, (uint32)0xc040b340, (uint32)0x265e5a51, (uint32)0xe9b6c7aa,
  (uint32)0xd62f105d, (uint32)0x02441453, (uint32)0xd8a1e681, (uint32)0xe7d3fbc8,
  (uint32)0x21e1cde6, (uint32)0xc33707d6, (uint32)0xf4d50d87, (uint32)0x455a14ed,
  (uint32)0xa9e3e905, (uint32)0xfcefa3f8, (uint32)0x676f02d9, (uint32)0x8d2a4c8a,
  (uint32)0xfffa3942, (uint32)0x8771f681, (uint32)0x6d9d6122, (uint32)0xfde5380c,
  (uint32)0xa4beea44, (uint32)0x4bdecfa9, (uint32)0xf6bb4b60, (uint32)0xbebfbc70,
  (uint32)0x289b7ec6, (uint32)0xeaa127fa, (uint32)0xd4ef3085, (uint32)0x04881d05,
  (uint32)0xd9d4d039, (uint32)0xe6db99e5, (uint32)0x1fa27cf8, (uint32)0xc4ac5665,
  (uint32)0xf4292244, (uint32)0x432aff97, (uint32)0xab9423a7, (uint32)0xfc93a039,
  (uint32)0x655b59c3, (uint32)0x8f0ccc92, (uint32)0xffeff47d, (uint32)0x85845dd1,
  (uint32)0x6fa87e4f, (uint32)0xfe2ce6e0, (uint32)0xa3014314, (uint32)0x4e0811a1,
  (uint32)0xf7537e82, (uint32)0xbd3af235, (uint32)0x2ad7d2bb, (uint32)0xeb86d391
];

/// internal: MD5 running state (chaining value, partial block, byte count).
export struct CrxMd5 {
  h: uint32[4];
  buf: uint8[64];
  buflen: int64;
  total: uint64;
}

fn crx_md5_rotl(x: uint32, n: int32) -> uint32 {
  return (x << n) | (x >> (32 - n));
}

fn crx_md5_load32le(p: uint8*) -> uint32 {
  return (uint32)p[0] | ((uint32)p[1] << 8) | ((uint32)p[2] << 16) | ((uint32)p[3] << 24);
}

fn crx_md5_store32le(p: uint8*, v: uint32) {
  p[0] = (uint8)v;
  p[1] = (uint8)(v >> 8);
  p[2] = (uint8)(v >> 16);
  p[3] = (uint8)(v >> 24);
}

fn crx_md5_store64le(p: uint8*, v: uint64) {
  crx_md5_store32le(p, (uint32)v);
  crx_md5_store32le(&p[4], (uint32)(v >> 32));
}

// One 64-byte block: the four rounds of RFC 1321 section 3.4. Round 1 uses
// F = (b & c) | (~b & d) and word i; round 2 uses G = (b & d) | (c & ~d) and
// word (5i + 1) mod 16; round 3 uses H = b ^ c ^ d and word (3i + 5) mod 16;
// round 4 uses I = c ^ (b | ~d) and word 7i mod 16. The shift amounts are
// 7, 12, 17, 22 / 5, 9, 14, 20 / 4, 11, 16, 23 / 6, 10, 15, 21.
fn crx_md5_block(s: CrxMd5*, blk: uint8*) {
  var x: uint32[16];
  for i in 0..16 {
    x[i] = crx_md5_load32le(&blk[i * 4]);
  }
  var a: uint32 = s->h[0];
  var b: uint32 = s->h[1];
  var c: uint32 = s->h[2];
  var d: uint32 = s->h[3];
  var f: uint32 = 0;
  var t: uint32 = 0;
  var sh: int32 = 0;
  for i in 0..16 {
    f = (b & c) | (~b & d);
    if ((i & 3) == 0) { sh = 7; }
    if ((i & 3) == 1) { sh = 12; }
    if ((i & 3) == 2) { sh = 17; }
    if ((i & 3) == 3) { sh = 22; }
    t = d;
    d = c;
    c = b;
    b = b + crx_md5_rotl(a + f + x[i] + g_crx_md5_t[i], sh);
    a = t;
  }
  for i in 16..32 {
    f = (b & d) | (c & ~d);
    if ((i & 3) == 0) { sh = 5; }
    if ((i & 3) == 1) { sh = 9; }
    if ((i & 3) == 2) { sh = 14; }
    if ((i & 3) == 3) { sh = 20; }
    t = d;
    d = c;
    c = b;
    b = b + crx_md5_rotl(a + f + x[(5 * i + 1) & 15] + g_crx_md5_t[i], sh);
    a = t;
  }
  for i in 32..48 {
    f = b ^ c ^ d;
    if ((i & 3) == 0) { sh = 4; }
    if ((i & 3) == 1) { sh = 11; }
    if ((i & 3) == 2) { sh = 16; }
    if ((i & 3) == 3) { sh = 23; }
    t = d;
    d = c;
    c = b;
    b = b + crx_md5_rotl(a + f + x[(3 * i + 5) & 15] + g_crx_md5_t[i], sh);
    a = t;
  }
  for i in 48..64 {
    f = c ^ (b | ~d);
    if ((i & 3) == 0) { sh = 6; }
    if ((i & 3) == 1) { sh = 10; }
    if ((i & 3) == 2) { sh = 15; }
    if ((i & 3) == 3) { sh = 21; }
    t = d;
    d = c;
    c = b;
    b = b + crx_md5_rotl(a + f + x[(7 * i) & 15] + g_crx_md5_t[i], sh);
    a = t;
  }
  s->h[0] = s->h[0] + a;
  s->h[1] = s->h[1] + b;
  s->h[2] = s->h[2] + c;
  s->h[3] = s->h[3] + d;
  cr_wipe((uint8*)&x[0], 64);
}

/// internal: starts an MD5 computation.
export fn crx_md5_init(s: CrxMd5*) {
  s->h[0] = (uint32)0x67452301;
  s->h[1] = (uint32)0xefcdab89;
  s->h[2] = (uint32)0x98badcfe;
  s->h[3] = (uint32)0x10325476;
  for i in 0..64 {
    s->buf[i] = 0;
  }
  s->buflen = 0;
  s->total = 0;
}

/// internal: feeds n bytes into an MD5 computation.
export fn crx_md5_update(s: CrxMd5*, p: uint8*, n: int64) {
  s->total = s->total + (uint64)n;
  var pos: int64 = 0;
  if (s->buflen > 0) {
    while (pos < n && s->buflen < 64) {
      s->buf[s->buflen] = p[pos];
      s->buflen = s->buflen + 1;
      pos = pos + 1;
    }
    if (s->buflen < 64) { return; }
    crx_md5_block(s, &s->buf[0]);
    s->buflen = 0;
  }
  while (n - pos >= 64) {
    crx_md5_block(s, &p[pos]);
    pos = pos + 64;
  }
  while (pos < n) {
    s->buf[s->buflen] = p[pos];
    s->buflen = s->buflen + 1;
    pos = pos + 1;
  }
}

/// internal: finishes MD5: writes 16 bytes to out, then wipes s.
export fn crx_md5_final(s: CrxMd5*, out: uint8*) {
  var bits: uint64 = s->total << 3;
  var i: int64 = s->buflen;
  s->buf[i] = 128;
  i = i + 1;
  if (i > 56) {
    while (i < 64) { s->buf[i] = 0; i = i + 1; }
    crx_md5_block(s, &s->buf[0]);
    i = 0;
  }
  while (i < 56) { s->buf[i] = 0; i = i + 1; }
  crx_md5_store64le(&s->buf[56], bits);
  crx_md5_block(s, &s->buf[0]);
  for j in 0..4 {
    crx_md5_store32le(&out[j * 4], s->h[j]);
  }
  cr_wipe((uint8*)s, (int64)sizeof(CrxMd5));
}
