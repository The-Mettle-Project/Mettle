// HKDF with HMAC-SHA256 and HMAC-SHA384 (RFC 5869): extract a pseudorandom
// key from input keying material, expand it into output keying material. Pure
// Mettle on top of the streaming HMAC in mac. Loop bounds depend only on
// public lengths.

import "cryptex/core/status";
import "cryptex/core/types";
import "cryptex/core/util";
import "cryptex/mac/mac";

/// Size of a pseudorandom key made by cr_hkdf_sha256_extract (the HMAC-SHA256
/// output size).
/// in: -
/// returns: 32
/// owns: -
/// thread: constant
/// example: var prk: uint8[CR_HKDF_SHA256_PRK_BYTES];
export const CR_HKDF_SHA256_PRK_BYTES: int64 = 32;

/// Largest output cr_hkdf_sha256_expand and cr_hkdf_sha256 can produce
/// (255 * 32 bytes, RFC 5869 section 2.3).
/// in: -
/// returns: 8160
/// owns: -
/// thread: constant
/// example: if (n > CR_HKDF_SHA256_MAX) { return CR_E_ARG; }
export const CR_HKDF_SHA256_MAX: int64 = 8160;

/// HKDF-Extract (RFC 5869 section 2.2): prk = HMAC-SHA256(salt, ikm). An
/// empty salt (0 with saltlen 0) acts as 32 zero bytes, as the RFC says.
/// in: prk, writable for 32 bytes; salt readable for saltlen bytes, saltlen
///   >= 0 (random, but not secret; may be 0 only when saltlen == 0); ikm
///   readable for ikmlen bytes, ikmlen >= 0 (may be 0 only when ikmlen == 0)
/// returns: CR_OK; CR_E_ARG (null prk, null salt with saltlen > 0, null ikm
///   with ikmlen > 0, negative length); CR_E_INIT. On error prk is wiped
/// owns: prk stays the caller's and is secret: wipe it when done; nothing
///   else is kept
/// thread: any thread (no shared state)
/// example: var prk: uint8[32]; cr_hkdf_sha256_extract(&prk[0], &salt[0], 16, &ikm[0], 32);
export fn cr_hkdf_sha256_extract(prk: uint8*, salt: uint8*, saltlen: int64, ikm: uint8*, ikmlen: int64) -> int32 {
  if (prk == 0) { return CR_E_ARG; }
  cr_wipe(prk, 32);
  if (saltlen < 0 || ikmlen < 0 || (salt == 0 && saltlen > 0) || (ikm == 0 && ikmlen > 0)) {
    return CR_E_ARG;
  }
  var t: CrHmacSha256;
  var rc: int32 = cr_hmac_sha256(&t, salt, saltlen, ikm, ikmlen);
  if (rc != CR_OK) {
    cr_wipe(&t.b[0], 32);
    return rc;
  }
  var i: int64 = 0;
  while (i < 32) {
    prk[i] = t.b[i];
    i = i + 1;
  }
  cr_wipe(&t.b[0], 32);
  return CR_OK;
}

/// HKDF-Expand (RFC 5869 section 2.3): stretches a pseudorandom key into
/// outlen bytes of output keying material, T(1) | T(2) | ... with
/// T(i) = HMAC-SHA256(prk, T(i-1) | info | i).
/// in: out, writable for outlen bytes; outlen 1..8160 (CR_HKDF_SHA256_MAX);
///   prk readable for prklen bytes, prklen >= 32 (normally the 32 bytes from
///   cr_hkdf_sha256_extract); info readable for infolen bytes, infolen >= 0
///   (context, not secret; may be 0 only when infolen == 0)
/// returns: CR_OK; CR_E_ARG (null out or prk, outlen outside 1..8160, prklen
///   < 32, null info with infolen > 0, negative infolen); CR_E_INIT. On
///   error out is wiped (when out is non-null and outlen is in range)
/// owns: out stays the caller's and is secret; the temporary blocks and
///   HMAC states are wiped
/// thread: any thread (no shared state)
/// example: var k: uint8[32]; cr_hkdf_sha256_expand(&k[0], 32, &prk[0], 32, info.chars, (int64)info.length);
export fn cr_hkdf_sha256_expand(out: uint8*, outlen: int64, prk: uint8*, prklen: int64, info: uint8*, infolen: int64) -> int32 {
  if (out == 0) { return CR_E_ARG; }
  if (outlen < 1 || outlen > CR_HKDF_SHA256_MAX) { return CR_E_ARG; }
  cr_wipe(out, outlen);
  if (prk == 0 || prklen < 32 || infolen < 0 || (info == 0 && infolen > 0)) {
    return CR_E_ARG;
  }
  var st: CrHmacSha256State;
  var t: CrHmacSha256;
  var pos: int64 = 0;
  var counter: uint8 = 1;
  var rc: int32 = CR_OK;
  while (pos < outlen) {
    rc = cr_hmac_sha256_init(&st, prk, prklen);
    if (rc == CR_OK && pos > 0) {
      rc = cr_hmac_sha256_update(&st, &t.b[0], 32);
    }
    if (rc == CR_OK) {
      rc = cr_hmac_sha256_update(&st, info, infolen);
    }
    if (rc == CR_OK) {
      rc = cr_hmac_sha256_update(&st, &counter, 1);
    }
    if (rc == CR_OK) {
      rc = cr_hmac_sha256_final(&st, &t);
    }
    if (rc != CR_OK) {
      cr_wipe(cr_hmac_sha256_state_bytes(&st), 256);
      cr_wipe(&t.b[0], 32);
      cr_wipe(out, outlen);
      return rc;
    }
    var n: int64 = outlen - pos;
    if (n > 32) { n = 32; }
    var i: int64 = 0;
    while (i < n) {
      out[pos + i] = t.b[i];
      i = i + 1;
    }
    pos = pos + n;
    counter = counter + 1;
  }
  cr_wipe(&t.b[0], 32);
  cr_wipe(cr_hmac_sha256_state_bytes(&st), 256);
  return CR_OK;
}

/// HKDF-SHA256 in one call: extract with salt and ikm, then expand with info
/// (RFC 5869). Use it to derive one or more keys from a shared secret.
/// in: out, writable for outlen bytes; outlen 1..8160; salt/saltlen and
///   ikm/ikmlen as cr_hkdf_sha256_extract; info/infolen as
///   cr_hkdf_sha256_expand
/// returns: CR_OK; CR_E_ARG (as cr_hkdf_sha256_extract and
///   cr_hkdf_sha256_expand); CR_E_INIT. On error out is wiped (when out is
///   non-null and outlen is in range)
/// owns: out stays the caller's and is secret; the intermediate PRK is wiped
/// thread: any thread (no shared state)
/// example: var k: uint8[32]; cr_hkdf_sha256(&k[0], 32, &salt[0], 16, &ikm[0], 32, info.chars, (int64)info.length);
export fn cr_hkdf_sha256(out: uint8*, outlen: int64, salt: uint8*, saltlen: int64, ikm: uint8*, ikmlen: int64, info: uint8*, infolen: int64) -> int32 {
  if (out == 0) { return CR_E_ARG; }
  if (outlen < 1 || outlen > CR_HKDF_SHA256_MAX) { return CR_E_ARG; }
  var prk: uint8[32];
  var rc: int32 = cr_hkdf_sha256_extract(&prk[0], salt, saltlen, ikm, ikmlen);
  if (rc != CR_OK) {
    cr_wipe(&prk[0], 32);
    cr_wipe(out, outlen);
    return rc;
  }
  rc = cr_hkdf_sha256_expand(out, outlen, &prk[0], 32, info, infolen);
  cr_wipe(&prk[0], 32);
  return rc;
}

/// Size of a pseudorandom key made by cr_hkdf_sha384_extract (the HMAC-SHA384
/// output size).
/// in: -
/// returns: 48
/// owns: -
/// thread: constant
/// example: var prk: uint8[CR_HKDF_SHA384_PRK_BYTES];
export const CR_HKDF_SHA384_PRK_BYTES: int64 = 48;

/// Largest output cr_hkdf_sha384_expand and cr_hkdf_sha384 can produce
/// (255 * 48 bytes, RFC 5869 section 2.3).
/// in: -
/// returns: 12240
/// owns: -
/// thread: constant
/// example: if (n > CR_HKDF_SHA384_MAX) { return CR_E_ARG; }
export const CR_HKDF_SHA384_MAX: int64 = 12240;

/// HKDF-Extract (RFC 5869 section 2.2): prk = HMAC-SHA384(salt, ikm). An
/// empty salt (0 with saltlen 0) acts as 48 zero bytes, as the RFC says.
/// in: prk, writable for 48 bytes; salt readable for saltlen bytes, saltlen
///   >= 0 (random, but not secret; may be 0 only when saltlen == 0); ikm
///   readable for ikmlen bytes, ikmlen >= 0 (may be 0 only when ikmlen == 0)
/// returns: CR_OK; CR_E_ARG (null prk, null salt with saltlen > 0, null ikm
///   with ikmlen > 0, negative length); CR_E_INIT. On error prk is wiped
/// owns: prk stays the caller's and is secret: wipe it when done; nothing
///   else is kept
/// thread: any thread (no shared state)
/// example: var prk: uint8[48]; cr_hkdf_sha384_extract(&prk[0], &salt[0], 16, &ikm[0], 48);
export fn cr_hkdf_sha384_extract(prk: uint8*, salt: uint8*, saltlen: int64, ikm: uint8*, ikmlen: int64) -> int32 {
  if (prk == 0) { return CR_E_ARG; }
  cr_wipe(prk, 48);
  if (saltlen < 0 || ikmlen < 0 || (salt == 0 && saltlen > 0) || (ikm == 0 && ikmlen > 0)) {
    return CR_E_ARG;
  }
  var t: CrHmacSha384;
  var rc: int32 = cr_hmac_sha384(&t, salt, saltlen, ikm, ikmlen);
  if (rc != CR_OK) {
    cr_wipe(&t.b[0], 48);
    return rc;
  }
  var i: int64 = 0;
  while (i < 48) {
    prk[i] = t.b[i];
    i = i + 1;
  }
  cr_wipe(&t.b[0], 48);
  return CR_OK;
}

/// HKDF-Expand (RFC 5869 section 2.3): stretches a pseudorandom key into
/// outlen bytes of output keying material, T(1) | T(2) | ... with
/// T(i) = HMAC-SHA384(prk, T(i-1) | info | i).
/// in: out, writable for outlen bytes; outlen 1..12240 (CR_HKDF_SHA384_MAX);
///   prk readable for prklen bytes, prklen >= 48 (normally the 48 bytes from
///   cr_hkdf_sha384_extract); info readable for infolen bytes, infolen >= 0
///   (context, not secret; may be 0 only when infolen == 0)
/// returns: CR_OK; CR_E_ARG (null out or prk, outlen outside 1..12240, prklen
///   < 48, null info with infolen > 0, negative infolen); CR_E_INIT. On
///   error out is wiped (when out is non-null and outlen is in range)
/// owns: out stays the caller's and is secret; the temporary blocks and
///   HMAC states are wiped
/// thread: any thread (no shared state)
/// example: var k: uint8[48]; cr_hkdf_sha384_expand(&k[0], 48, &prk[0], 48, info.chars, (int64)info.length);
export fn cr_hkdf_sha384_expand(out: uint8*, outlen: int64, prk: uint8*, prklen: int64, info: uint8*, infolen: int64) -> int32 {
  if (out == 0) { return CR_E_ARG; }
  if (outlen < 1 || outlen > CR_HKDF_SHA384_MAX) { return CR_E_ARG; }
  cr_wipe(out, outlen);
  if (prk == 0 || prklen < 48 || infolen < 0 || (info == 0 && infolen > 0)) {
    return CR_E_ARG;
  }
  var st: CrHmacSha384State;
  var t: CrHmacSha384;
  var pos: int64 = 0;
  var counter: uint8 = 1;
  var rc: int32 = CR_OK;
  while (pos < outlen) {
    rc = cr_hmac_sha384_init(&st, prk, prklen);
    if (rc == CR_OK && pos > 0) {
      rc = cr_hmac_sha384_update(&st, &t.b[0], 48);
    }
    if (rc == CR_OK) {
      rc = cr_hmac_sha384_update(&st, info, infolen);
    }
    if (rc == CR_OK) {
      rc = cr_hmac_sha384_update(&st, &counter, 1);
    }
    if (rc == CR_OK) {
      rc = cr_hmac_sha384_final(&st, &t);
    }
    if (rc != CR_OK) {
      cr_wipe(cr_hmac_sha384_state_bytes(&st), 512);
      cr_wipe(&t.b[0], 48);
      cr_wipe(out, outlen);
      return rc;
    }
    var n: int64 = outlen - pos;
    if (n > 48) { n = 48; }
    var i: int64 = 0;
    while (i < n) {
      out[pos + i] = t.b[i];
      i = i + 1;
    }
    pos = pos + n;
    counter = counter + 1;
  }
  cr_wipe(&t.b[0], 48);
  cr_wipe(cr_hmac_sha384_state_bytes(&st), 512);
  return CR_OK;
}

/// HKDF-SHA384 in one call: extract with salt and ikm, then expand with info
/// (RFC 5869). Use it to derive one or more keys from a shared secret.
/// in: out, writable for outlen bytes; outlen 1..12240; salt/saltlen and
///   ikm/ikmlen as cr_hkdf_sha384_extract; info/infolen as
///   cr_hkdf_sha384_expand
/// returns: CR_OK; CR_E_ARG (as cr_hkdf_sha384_extract and
///   cr_hkdf_sha384_expand); CR_E_INIT. On error out is wiped (when out is
///   non-null and outlen is in range)
/// owns: out stays the caller's and is secret; the intermediate PRK is wiped
/// thread: any thread (no shared state)
/// example: var k: uint8[48]; cr_hkdf_sha384(&k[0], 48, &salt[0], 16, &ikm[0], 48, info.chars, (int64)info.length);
export fn cr_hkdf_sha384(out: uint8*, outlen: int64, salt: uint8*, saltlen: int64, ikm: uint8*, ikmlen: int64, info: uint8*, infolen: int64) -> int32 {
  if (out == 0) { return CR_E_ARG; }
  if (outlen < 1 || outlen > CR_HKDF_SHA384_MAX) { return CR_E_ARG; }
  var prk: uint8[48];
  var rc: int32 = cr_hkdf_sha384_extract(&prk[0], salt, saltlen, ikm, ikmlen);
  if (rc != CR_OK) {
    cr_wipe(&prk[0], 48);
    cr_wipe(out, outlen);
    return rc;
  }
  rc = cr_hkdf_sha384_expand(out, outlen, &prk[0], 48, info, infolen);
  cr_wipe(&prk[0], 48);
  return rc;
}
