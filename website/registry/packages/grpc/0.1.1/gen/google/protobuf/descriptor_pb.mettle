    return false;
  }
  while (r->pos < r->len) {
    var start: int64 = r->pos;
    var tag: uint64 = codec_pb_read_tag(r);
    if (tag == 0) { return false; }
    switch ((int64)tag) {
      case 10: {
        var sub: CodecReader;
        if (!codec_pb_read_sub(r, &sub)) { return false; }
        var item: GrpcPbFileDescriptorProto;
        if (!codec_list_push(&m->file, item)) { codec_rd_fail(r, CODEC_ERR_NOMEM); return false; }
        var last: int64 = m->file.len - 1;
        if (!GrpcPbFileDescriptorProto_read(&m->file.data[last], &sub, depth - 1, 0)) {
          codec_rd_fail(r, sub.err);
          return false;
        }
      }
      default: {
        if ((tag & 7) == 4) {
          if ((int32)(tag >> 3) == group) { return true; }
          codec_rd_fail(r, CODEC_ERR_INVALID);
          return false;
        }
        if (!codec_pb_keep_unknown(r, tag, start, depth, &m->_unknown)) { return false; }
      }
    }
    if (r->err != CODEC_OK) { return false; }
  }
  if (group != 0) {
    codec_rd_fail(r, CODEC_ERR_TRUNCATED);
    return false;
  }
  return r->err == CODEC_OK;
}

// Merges the message in `data` into m. Strings and bytes in m point into
// `data`, so keep it alive while m is in use. Returns CODEC_OK or an error.
export fn GrpcPbFileDescriptorSet_decode(m: GrpcPbFileDescriptorSet*, data: string) -> int32 {
  var r: CodecReader;
  codec_rd_init_string(&r, data);
  if (!GrpcPbFileDescriptorSet_read(m, &r, CODEC_PB_DEPTH, 0)) {
    if (r.err == CODEC_OK) { return CODEC_ERR_INVALID; }
    return r.err;
  }
  if (!GrpcPbFileDescriptorSet_check(m)) { return CODEC_ERR_MISSING; }
  return CODEC_OK;
}

// True when every proto2 required field, here and in nested messages, is set.
export fn GrpcPbFileDescriptorSet_check(m: GrpcPbFileDescriptorSet*) -> bool {
  for i in 0..m->file.len {
    if (!GrpcPbFileDescriptorProto_check(&m->file.data[i])) { return false; }
  }
  return true;
}

// Zeroes m and sets proto2 default values (has_ flags stay false).
export fn GrpcPbFileDescriptorSet_init(m: GrpcPbFileDescriptorSet*) {
  mem_zero((cstring)m, sizeof(GrpcPbFileDescriptorSet));
}

// Frees the memory decoding allocated in m (nested messages and lists).
// Strings point into the decoded input and are not freed.
export fn GrpcPbFileDescriptorSet_free(m: GrpcPbFileDescriptorSet*) {
  for i in 0..m->file.len { GrpcPbFileDescriptorProto_free(&m->file.data[i]); }
  codec_list_free(&m->file);
  codec_list_free(&m->_unknown);
}

// google.protobuf.FileDescriptorProto
export struct GrpcPbFileDescriptorProto {
  has_name: bool;
  name: string;
  has_package: bool;
  package: string;
  dependency: CodecList<string>;
  public_dependency: CodecList<int32>;
  weak_dependency: CodecList<int32>;
  option_dependency: CodecList<string>;
  message_type: CodecList<GrpcPbDescriptorProto>;
  enum_type: CodecList<GrpcPbEnumDescriptorProto>;
  service: CodecList<GrpcPbServiceDescriptorProto>;
  extension: CodecList<GrpcPbFieldDescriptorProto>;
  options: GrpcPbFileOptions*;
  source_code_info: GrpcPbSourceCodeInfo*;
  has_syntax: bool;
  syntax: string;
  has_edition: bool;
  edition: int32;
  _unknown: CodecList<string>;   // fields this code does not know, kept as raw bytes
}
export const GrpcPbFileDescriptorProto_FIELD_name: int32 = 1;
export const GrpcPbFileDescriptorProto_FIELD_package: int32 = 2;
export const GrpcPbFileDescriptorProto_FIELD_dependency: int32 = 3;
export const GrpcPbFileDescriptorProto_FIELD_public_dependency: int32 = 10;
export const GrpcPbFileDescriptorProto_FIELD_weak_dependency: int32 = 11;
export const GrpcPbFileDescriptorProto_FIELD_option_dependency: int32 = 15;
export const GrpcPbFileDescriptorProto_FIELD_message_type: int32 = 4;
export const GrpcPbFileDescriptorProto_FIELD_enum_type: int32 = 5;
export const GrpcPbFileDescriptorProto_FIELD_service: int32 = 6;
export const GrpcPbFileDescriptorProto_FIELD_extension: int32 = 7;
export const GrpcPbFileDescriptorProto_FIELD_options: int32 = 8;
export const GrpcPbFileDescriptorProto_FIELD_source_code_info: int32 = 9;
export const GrpcPbFileDescriptorProto_FIELD_syntax: int32 = 12;
export const GrpcPbFileDescriptorProto_FIELD_edition: int32 = 14;

export fn GrpcPbFileDescriptorProto_encode(m: GrpcPbFileDescriptorProto*, w: CodecRev*) {
  codec_pb_put_unknown(w, &m->_unknown);
  if (m->option_dependency.len > 0) {
    var i: int64 = m->option_dependency.len - 1;
    while (i >= 0) {
      codec_pb_put_bytes(w, 15, m->option_dependency.data[i]);
      i = i - 1;
    }
  }
  if (m->has_edition) {
    codec_pb_put_int32(w, 14, m->edition);
  }
  if (m->has_syntax) {
    codec_pb_put_bytes(w, 12, m->syntax);
  }
  if (m->weak_dependency.len > 0) {
    var i: int64 = m->weak_dependency.len - 1;
    while (i >= 0) {
      codec_pb_put_int32(w, 11, m->weak_dependency.data[i]);
      i = i - 1;
    }
  }
  if (m->public_dependency.len > 0) {
    var i: int64 = m->public_dependency.len - 1;
    while (i >= 0) {
      codec_pb_put_int32(w, 10, m->public_dependency.data[i]);
      i = i - 1;
    }
  }
  if (m->source_code_info != 0) {
    var mk: int64 = codec_rev_len(w);
    GrpcPbSourceCodeInfo_encode(m->source_code_info, w);
    codec_pb_put_len(w, 9, mk);
  }
  if (m->options != 0) {
    var mk: int64 = codec_rev_len(w);
    GrpcPbFileOptions_encode(m->options, w);
    codec_pb_put_len(w, 8, mk);
  }
  if (m->extension.len > 0) {
    var i: int64 = m->extension.len - 1;
    while (i >= 0) {
      var mk: int64 = codec_rev_len(w);
      GrpcPbFieldDescriptorProto_encode(&m->extension.data[i], w);
      codec_pb_put_len(w, 7, mk);
      i = i - 1;
    }
  }
  if (m->service.len > 0) {
    var i: int64 = m->service.len - 1;
    while (i >= 0) {
      var mk: int64 = codec_rev_len(w);
      GrpcPbServiceDescriptorProto_encode(&m->service.data[i], w);
      codec_pb_put_len(w, 6, mk);
      i = i - 1;
    }
  }
  if (m->enum_type.len > 0) {
    var i: int64 = m->enum_type.len - 1;
    while (i >= 0) {
      var mk: int64 = codec_rev_len(w);
      GrpcPbEnumDescriptorProto_encode(&m->enum_type.data[i], w);
      codec_pb_put_len(w, 5, mk);
      i = i - 1;
    }
  }
  if (m->message_type.len > 0) {
    var i: int64 = m->message_type.len - 1;
    while (i >= 0) {
      var mk: int64 = codec_rev_len(w);
      GrpcPbDescriptorProto_encode(&m->message_type.data[i], w);
      codec_pb_put_len(w, 4, mk);
      i = i - 1;
    }
  }
  if (m->dependency.len > 0) {
    var i: int64 = m->dependency.len - 1;
    while (i >= 0) {
      codec_pb_put_bytes(w, 3, m->dependency.data[i]);
      i = i - 1;
    }
  }
  if (m->has_package) {
    codec_pb_put_bytes(w, 2, m->package);
  }
  if (m->has_name) {
    codec_pb_put_bytes(w, 1, m->name);
  }
}

// Encodes m into w (emptied first) and returns the bytes, a view into w.
export fn GrpcPbFileDescriptorProto_serialize(m: GrpcPbFileDescriptorProto*, w: CodecRev*) -> string {
  codec_rev_clear(w);
  GrpcPbFileDescriptorProto_encode(m, w);
  return codec_rev_view(w);
}

// Merges fields from r into m. `group` is the field number of the group
// being read (0 for a whole message): its end tag stops the read.
export fn GrpcPbFileDescriptorProto_read(m: GrpcPbFileDescriptorProto*, r: CodecReader*, depth: int32, group: int32) -> bool {
  if (depth <= 0) {
    codec_rd_fail(r, CODEC_ERR_DEPTH);
    return false;
  }
  while (r->pos < r->len) {
    var start: int64 = r->pos;
    var tag: uint64 = codec_pb_read_tag(r);
    if (tag == 0) { return false; }
    switch ((int64)tag) {
      case 10: {
        m->name = codec_pb_read_bytes(r);
        m->has_name = true;
      }
      case 18: {
        m->package = codec_pb_read_bytes(r);
        m->has_package = true;
      }
      case 26: {
        var x: string = codec_pb_read_bytes(r);
        if (!codec_list_push(&m->dependency, x)) { codec_rd_fail(r, CODEC_ERR_NOMEM); return false; }
      }
      case 80: {
        var x: int32 = codec_pb_read_int32(r);
        if (!codec_list_push(&m->public_dependency, x)) { codec_rd_fail(r, CODEC_ERR_NOMEM); return false; }
      }
      case 82: {
        var sub: CodecReader;
        if (!codec_pb_read_sub(r, &sub)) { return false; }
        while (sub.pos < sub.len) {
          var y: int32 = codec_pb_read_int32(&sub);
          if (!codec_list_push(&m->public_dependency, y)) { codec_rd_fail(r, CODEC_ERR_NOMEM); return false; }
        }
        if (sub.err != CODEC_OK) {
          codec_rd_fail(r, sub.err);
          return false;
        }
      }
      case 88: {
        var x: int32 = codec_pb_read_int32(r);
        if (!codec_list_push(&m->weak_dependency, x)) { codec_rd_fail(r, CODEC_ERR_NOMEM); return false; }
      }
      case 90: {
        var sub: CodecReader;
        if (!codec_pb_read_sub(r, &sub)) { return false; }
        while (sub.pos < sub.len) {
          var y: int32 = codec_pb_read_int32(&sub);
          if (!codec_list_push(&m->weak_dependency, y)) { codec_rd_fail(r, CODEC_ERR_NOMEM); return false; }
        }
        if (sub.err != CODEC_OK) {
          codec_rd_fail(r, sub.err);
          return false;
        }
      }
      case 122: {
        var x: string = codec_pb_read_bytes(r);
        if (!codec_list_push(&m->option_dependency, x)) { codec_rd_fail(r, CODEC_ERR_NOMEM); return false; }
      }
      case 34: {
        var sub: CodecReader;
        if (!codec_pb_read_sub(r, &sub)) { return false; }
        var item: GrpcPbDescriptorProto;
        if (!codec_list_push(&m->message_type, item)) { codec_rd_fail(r, CODEC_ERR_NOMEM); return false; }
        var last: int64 = m->message_type.len - 1;
        if (!GrpcPbDescriptorProto_read(&m->message_type.data[last], &sub, depth - 1, 0)) {
          codec_rd_fail(r, sub.err);
          return false;
        }
      }
      case 42: {
        var sub: CodecReader;
        if (!codec_pb_read_sub(r, &sub)) { return false; }
        var item: GrpcPbEnumDescriptorProto;
        if (!codec_list_push(&m->enum_type, item)) { codec_rd_fail(r, CODEC_ERR_NOMEM); return false; }
        var last: int64 = m->enum_type.len - 1;
        if (!GrpcPbEnumDescriptorProto_read(&m->enum_type.data[last], &sub, depth - 1, 0)) {
          codec_rd_fail(r, sub.err);
          return false;
        }
      }
      case 50: {
        var sub: CodecReader;
        if (!codec_pb_read_sub(r, &sub)) { return false; }
        var item: GrpcPbServiceDescriptorProto;
        if (!codec_list_push(&m->service, item)) { codec_rd_fail(r, CODEC_ERR_NOMEM); return false; }
        var last: int64 = m->service.len - 1;
        if (!GrpcPbServiceDescriptorProto_read(&m->service.data[last], &sub, depth - 1, 0)) {
          codec_rd_fail(r, sub.err);
          return false;
        }
      }
      case 58: {
        var sub: CodecReader;
        if (!codec_pb_read_sub(r, &sub)) { return false; }
        var item: GrpcPbFieldDescriptorProto;
        if (!codec_list_push(&m->extension, item)) { codec_rd_fail(r, CODEC_ERR_NOMEM); return false; }
        var last: int64 = m->extension.len - 1;
        if (!GrpcPbFieldDescriptorProto_read(&m->extension.data[last], &sub, depth - 1, 0)) {
          codec_rd_fail(r, sub.err);
          return false;
        }
      }
      case 66: {
        var sub: CodecReader;
        if (!codec_pb_read_sub(r, &sub)) { return false; }
        if (m->options == 0) {
          m->options = new GrpcPbFileOptions;
          if (m->options == 0) { codec_rd_fail(r, CODEC_ERR_NOMEM); return false; }
        }
        if (!GrpcPbFileOptions_read(m->options, &sub, depth - 1, 0)) {
          codec_rd_fail(r, sub.err);
          return false;
        }
      }
      case 74: {
        var sub: CodecReader;
        if (!codec_pb_read_sub(r, &sub)) { return false; }
        if (m->source_code_info == 0) {
          m->source_code_info = new GrpcPbSourceCodeInfo;
          if (m->source_code_info == 0) { codec_rd_fail(r, CODEC_ERR_NOMEM); return false; }
        }
        if (!GrpcPbSourceCodeInfo_read(m->source_code_info, &sub, depth - 1, 0)) {
          codec_rd_fail(r, sub.err);
          return false;
        }
      }
      case 98: {
        m->syntax = codec_pb_read_bytes(r);
        m->has_syntax = true;
      }
      case 112: {
        var x: int32 = codec_pb_read_int32(r);
        if (!GrpcPbEdition_valid(x)) {
          var kept: string;
          kept.chars = r->data + start;
          kept.length = (uint64)(r->pos - start);
          if (!codec_list_push(&m->_unknown, kept)) { codec_rd_fail(r, CODEC_ERR_NOMEM); return false; }
          continue;
        }
        m->edition = x;
        m->has_edition = true;
      }
      default: {
        if ((tag & 7) == 4) {
          if ((int32)(tag >> 3) == group) { return true; }
          codec_rd_fail(r, CODEC_ERR_INVALID);
          return false;
        }
        if (!codec_pb_keep_unknown(r, tag, start, depth, &m->_unknown)) { return false; }
      }
    }
    if (r->err != CODEC_OK) { return false; }
  }
  if (group != 0) {
    codec_rd_fail(r, CODEC_ERR_TRUNCATED);
    return false;
  }
  return r->err == CODEC_OK;
}

// Merges the message in `data` into m. Strings and bytes in m point into
// `data`, so keep it alive while m is in use. Returns CODEC_OK or an error.
export fn GrpcPbFileDescriptorProto_decode(m: GrpcPbFileDescriptorProto*, data: string) -> int32 {
  var r: CodecReader;
  codec_rd_init_string(&r, data);
  if (!GrpcPbFileDescriptorProto_read(m, &r, CODEC_PB_DEPTH, 0)) {
    if (r.err == CODEC_OK) { return CODEC_ERR_INVALID; }
    return r.err;
  }
  if (!GrpcPbFileDescriptorProto_check(m)) { return CODEC_ERR_MISSING; }
  return CODEC_OK;
}

// True when every proto2 required field, here and in nested messages, is set.
export fn GrpcPbFileDescriptorProto_check(m: GrpcPbFileDescriptorProto*) -> bool {
  for i in 0..m->message_type.len {
    if (!GrpcPbDescriptorProto_check(&m->message_type.data[i])) { return false; }
  }
  for i in 0..m->enum_type.len {
    if (!GrpcPbEnumDescriptorProto_check(&m->enum_type.data[i])) { return false; }
  }
  for i in 0..m->service.len {
    if (!GrpcPbServiceDescriptorProto_check(&m->service.data[i])) { return false; }
  }
  for i in 0..m->extension.len {
    if (!GrpcPbFieldDescriptorProto_check(&m->extension.data[i])) { return false; }
  }
  if (m->options != 0 && !GrpcPbFileOptions_check(m->options)) { return false; }
  return true;
}

// Zeroes m and sets proto2 default values (has_ flags stay false).
export fn GrpcPbFileDescriptorProto_init(m: GrpcPbFileDescriptorProto*) {
  mem_zero((cstring)m, sizeof(GrpcPbFileDescriptorProto));
}

// Frees the memory decoding allocated in m (nested messages and lists).
// Strings point into the decoded input and are not freed.
export fn GrpcPbFileDescriptorProto_free(m: GrpcPbFileDescriptorProto*) {
  codec_list_free(&m->dependency);
  codec_list_free(&m->public_dependency);
  codec_list_free(&m->weak_dependency);
  codec_list_free(&m->option_dependency);
  for i in 0..m->message_type.len { GrpcPbDescriptorProto_free(&m->message_type.data[i]); }
  codec_list_free(&m->message_type);
  for i in 0..m->enum_type.len { GrpcPbEnumDescriptorProto_free(&m->enum_type.data[i]); }
  codec_list_free(&m->enum_type);
  for i in 0..m->service.len { GrpcPbServiceDescriptorProto_free(&m->service.data[i]); }
  codec_list_free(&m->service);
  for i in 0..m->extension.len { GrpcPbFieldDescriptorProto_free(&m->extension.data[i]); }
  codec_list_free(&m->extension);
  if (m->options != 0) {
    GrpcPbFileOptions_free(m->options);
    free(m->options);
    m->options = (GrpcPbFileOptions*)0;
  }
  if (m->source_code_info != 0) {
    GrpcPbSourceCodeInfo_free(m->source_code_info);
    free(m->source_code_info);
    m->source_code_info = (GrpcPbSourceCodeInfo*)0;
  }
  codec_list_free(&m->_unknown);
}

// google.protobuf.DescriptorProto
export struct GrpcPbDescriptorProto {
  has_name: bool;
  name: string;
  field: CodecList<GrpcPbFieldDescriptorProto>;
  extension: CodecList<GrpcPbFieldDescriptorProto>;
  nested_type: CodecList<GrpcPbDescriptorProto>;
  enum_type: CodecList<GrpcPbEnumDescriptorProto>;
  extension_range: CodecList<GrpcPbDescriptorProto_ExtensionRange>;
  oneof_decl: CodecList<GrpcPbOneofDescriptorProto>;
  options: GrpcPbMessageOptions*;
  reserved_range: CodecList<GrpcPbDescriptorProto_ReservedRange>;
  reserved_name: CodecList<string>;
  has_visibility: bool;
  visibility: int32;
  _unknown: CodecList<string>;   // fields this code does not know, kept as raw bytes
}
export const GrpcPbDescriptorProto_FIELD_name: int32 = 1;
export const GrpcPbDescriptorProto_FIELD_field: int32 = 2;
export const GrpcPbDescriptorProto_FIELD_extension: int32 = 6;
export const GrpcPbDescriptorProto_FIELD_nested_type: int32 = 3;
export const GrpcPbDescriptorProto_FIELD_enum_type: int32 = 4;
export const GrpcPbDescriptorProto_FIELD_extension_range: int32 = 5;
export const GrpcPbDescriptorProto_FIELD_oneof_decl: int32 = 8;
export const GrpcPbDescriptorProto_FIELD_options: int32 = 7;
export const GrpcPbDescriptorProto_FIELD_reserved_range: int32 = 9;
export const GrpcPbDescriptorProto_FIELD_reserved_name: int32 = 10;
export const GrpcPbDescriptorProto_FIELD_visibility: int32 = 11;

export fn GrpcPbDescriptorProto_encode(m: GrpcPbDescriptorProto*, w: CodecRev*) {
  codec_pb_put_unknown(w, &m->_unknown);
  if (m->has_visibility) {
    codec_pb_put_int32(w, 11, m->visibility);
  }
  if (m->reserved_name.len > 0) {
    var i: int64 = m->reserved_name.len - 1;
    while (i >= 0) {
      codec_pb_put_bytes(w, 10, m->reserved_name.data[i]);
      i = i - 1;
    }
  }
  if (m->reserved_range.len > 0) {
    var i: int64 = m->reserved_range.len - 1;
    while (i >= 0) {
      var mk: int64 = codec_rev_len(w);
      GrpcPbDescriptorProto_ReservedRange_encode(&m->reserved_range.data[i], w);
      codec_pb_put_len(w, 9, mk);
      i = i - 1;
    }
  }
  if (m->oneof_decl.len > 0) {
    var i: int64 = m->oneof_decl.len - 1;
    while (i >= 0) {
      var mk: int64 = codec_rev_len(w);
      GrpcPbOneofDescriptorProto_encode(&m->oneof_decl.data[i], w);
      codec_pb_put_len(w, 8, mk);
      i = i - 1;
    }
  }
  if (m->options != 0) {
    var mk: int64 = codec_rev_len(w);
    GrpcPbMessageOptions_encode(m->options, w);
    codec_pb_put_len(w, 7, mk);
  }
  if (m->extension.len > 0) {
    var i: int64 = m->extension.len - 1;
    while (i >= 0) {
      var mk: int64 = codec_rev_len(w);
      GrpcPbFieldDescriptorProto_encode(&m->extension.data[i], w);
      codec_pb_put_len(w, 6, mk);
      i = i - 1;
    }
  }
  if (m->extension_range.len > 0) {
    var i: int64 = m->extension_range.len - 1;
    while (i >= 0) {
      var mk: int64 = codec_rev_len(w);
      GrpcPbDescriptorProto_ExtensionRange_encode(&m->extension_range.data[i], w);
      codec_pb_put_len(w, 5, mk);
      i = i - 1;
    }
  }
  if (m->enum_type.len > 0) {
    var i: int64 = m->enum_type.len - 1;
    while (i >= 0) {
      var mk: int64 = codec_rev_len(w);
      GrpcPbEnumDescriptorProto_encode(&m->enum_type.data[i], w);
      codec_pb_put_len(w, 4, mk);
      i = i - 1;
    }
  }
  if (m->nested_type.len > 0) {
    var i: int64 = m->nested_type.len - 1;
    while (i >= 0) {
      var mk: int64 = codec_rev_len(w);
      GrpcPbDescriptorProto_encode(&m->nested_type.data[i], w);
      codec_pb_put_len(w, 3, mk);
      i = i - 1;
    }
  }
  if (m->field.len > 0) {
    var i: int64 = m->field.len - 1;
    while (i >= 0) {
      var mk: int64 = codec_rev_len(w);
      GrpcPbFieldDescriptorProto_encode(&m->field.data[i], w);
      codec_pb_put_len(w, 2, mk);
      i = i - 1;
    }
  }
  if (m->has_name) {
    codec_pb_put_bytes(w, 1, m->name);
  }
}

// Encodes m into w (emptied first) and returns the bytes, a view into w.
export fn GrpcPbDescriptorProto_serialize(m: GrpcPbDescriptorProto*, w: CodecRev*) -> string {
  codec_rev_clear(w);
  GrpcPbDescriptorProto_encode(m, w);
  return codec_rev_view(w);
}

// Merges fields from r into m. `group` is the field number of the group
// being read (0 for a whole message): its end tag stops the read.
export fn GrpcPbDescriptorProto_read(m: GrpcPbDescriptorProto*, r: CodecReader*, depth: int32, group: int32) -> bool {
  if (depth <= 0) {
    codec_rd_fail(r, CODEC_ERR_DEPTH);
    return false;
  }
  while (r->pos < r->len) {
    var start: int64 = r->pos;
    var tag: uint64 = codec_pb_read_tag(r);
    if (tag == 0) { return false; }
    switch ((int64)tag) {
      case 10: {
        m->name = codec_pb_read_bytes(r);
        m->has_name = true;
      }
      case 18: {
        var sub: CodecReader;
        if (!codec_pb_read_sub(r, &sub)) { return false; }
        var item: GrpcPbFieldDescriptorProto;
        if (!codec_list_push(&m->field, item)) { codec_rd_fail(r, CODEC_ERR_NOMEM); return false; }
        var last: int64 = m->field.len - 1;
        if (!GrpcPbFieldDescriptorProto_read(&m->field.data[last], &sub, depth - 1, 0)) {
          codec_rd_fail(r, sub.err);
          return false;
        }
      }
      case 50: {
        var sub: CodecReader;
        if (!codec_pb_read_sub(r, &sub)) { return false; }
        var item: GrpcPbFieldDescriptorProto;
        if (!codec_list_push(&m->extension, item)) { codec_rd_fail(r, CODEC_ERR_NOMEM); return false; }
