// flux_orm/migration/version.mettle — up-only migrations, one transaction each.
//
// The ledger is the truth about what has run, and it lives in the same store
// as the schema it describes, so the two cannot be committed separately:
//
//   _flux_orm_migrations (version INTEGER PRIMARY KEY, name TEXT NOT NULL,
//                      applied_at INTEGER NOT NULL)
//
// A run is: create the ledger if absent, read the applied versions, refuse if
// the store is ahead of the code, then apply every missing version in ascending
// order — each one inside its own transaction, so a failure at version N leaves
// the schema at N-1 and the ledger saying N-1. That is the whole point of the
// per-migration transaction: a partially applied migration is worse than a
// failed one, because the next run would skip it.
//
// Rolling back is explicit, as in Ecto: a migration may carry a down step
// (`down_sql` or `down`), and rc_migration_down undoes every applied version
// above a target, newest first, one transaction each. There is no auto-diff
// against the store: a rollback guessed from the schema is a data-loss bug.

import "std/mem";

import "../core/status";
import "../core/value";
import "../core/meta";
import "../core/buf";
import "../adapter/adapter";
import "../adapter/stmt";
import "ddl";

export const RC_MIG_LEDGER: string = "_flux_orm_migrations";  // ledger table

// One schema change. It is SQL text for text stores, or an `up` callback for
// stores without SQL (MeoDB, which has no `exec`): `up` runs inside the
// migration's transaction, usually rc_migration_create for each table, and
// returns RC_OK or a code that rolls the migration back. When `up` is set it
// wins and `up_sql` may be empty. `down` / `down_sql` undo it the same way
// (`down` wins); a migration with neither cannot be rolled back. Strings are
// borrowed and are normally literals.
export struct RcMigration {
  version: int64;                // > 0, unique, ascending within the set
  name: string;                  // non-empty; stored in the ledger
  up_sql: string;                // SQL run by rc_adapter_exec, or ""
  up: fn(RcAdapter*) -> int32 with alloc, syscall;   // callback instead of up_sql, or 0
  down_sql: string;              // SQL that undoes it, or ""
  down: fn(RcAdapter*) -> int32 with alloc, syscall; // callback instead of down_sql, or 0
}

// A list of migrations, as passed to rc_migration_run / rc_migration_down.
export struct RcMigrationSet {
  items: RcMigration*;  // borrowed array, sorted by version
  n: int32;             // entries in items
}

// What a run or rollback did. Filled on every return, success or failure.
export struct RcMigrationReport {
  applied: int32;        // applied by this run
  up_to: int64;          // highest version applied after this run
  failed_version: int64; // 0 when no failure
  code: int32;           // failing RC_*, RC_OK on success
}

// --- clock -------------------------------------------------------------------
// applied_at is unix micros, carried as RcTime.
//
// Shipped shape: injected-only. rc_migration_set_clock(us) supplies the value
// and rc_migration_now_micros() returns it; with nothing injected it returns 0.
//
// Why not a real clock: this stdlib has no std/time, and the only available
// extern — clock_gettime, the way std/bench.linux uses it — makes the
// compile-time interpreter refuse the whole file ("test ... skipped (calls C
// function 'clock_gettime'; the interpreter cannot)"). Probed on mettle 0.17.0:
// the interpreter skipped the test, debug and release ran. A silently skipped
// interpreter gate is worse than a zero timestamp, so the clock stays an
// explicit seam: the application owns the clock and calls set_clock once per
// run. No test depends on wall time; the tests assert the injected value.
var RC_MIG_CLOCK: int64 = 0;

// Sets the applied_at value (unix micros) written to the ledger from now on;
// 0 goes back to writing 0. Process-wide; call once before rc_migration_run.
export fn rc_migration_set_clock(us: int64) { RC_MIG_CLOCK = us; }

// Returns the injected clock value in unix micros, or 0 when none was set.
export fn rc_migration_now_micros() -> int64 {
  if (RC_MIG_CLOCK != 0) { return RC_MIG_CLOCK; }
  return 0;
}

// --- set ---------------------------------------------------------------------

// Wraps an array of migrations as a set.
//   items  the migrations, sorted by ascending version; borrowed, must outlive
//          the set (a static array is usual). May be 0 when n is 0
//   n      number of migrations
// Returns the set by value. Nothing is checked here; rc_migration_run and
// rc_migration_down call rc_migration_check.
export fn rc_migration_set(items: RcMigration*, n: int32) -> RcMigrationSet {
  var s: RcMigrationSet;
  s.items = items;
  s.n = n;
  return s;
}

// Validates a set without touching the store. A migration list is
// compiled-in constants, so every failure here is a programming error.
//   s  the set
// Returns RC_OK, or RC_ERR_USAGE for any of:
//
//   - n < 0, or items is 0 with n > 0
//   - a version <= 0 (the ledger's PK would accept 0 and hide it)
//   - an empty name (the ledger row would be unreadable in a log)
//   - empty up_sql and no `up` (a migration that does nothing but record
//     itself)
//   - versions not strictly ascending, which covers both duplicates and a
//     descending pair. Order is the contract: the ledger's ORDER BY ASC and the
//     apply loop both assume the set is already sorted, and sorting a caller's
//     array in place would be a surprise.
export fn rc_migration_check(s: RcMigrationSet) -> int32 {
  if (s.n < 0) { return RC_ERR_USAGE; }
  if (s.n > 0 && s.items == 0) { return RC_ERR_USAGE; }
  var i: int32 = 0;
  while (i < s.n) {
    var m: RcMigration = s.items[i];
    if (m.version <= 0) { return RC_ERR_USAGE; }
    if (m.name.length == (uint64)0) { return RC_ERR_USAGE; }
    if (m.up_sql.length == (uint64)0 && m.up == 0) { return RC_ERR_USAGE; }
    if (i > 0) {
      if (m.version <= s.items[i - 1].version) { return RC_ERR_USAGE; }
    }
    i = i + 1;
  }
  return RC_OK;
}

// --- ledger statements -------------------------------------------------------
// Lower level: rc_migration_run and rc_migration_down build and run these
// themselves; apps do not need them. The statements are fixed text, built
// through rc_buf_ident so the quoting rule has one implementation. They are
// asserted verbatim in tests/t_migration.mettle; changing one is a schema
// change, not a refactor.
//
// The text builders append to `b` (not cleared) and return RC_OK, RC_ERR_USAGE
// when b is 0, or RC_ERR_NOMEM. The `_stmt` builders overwrite `*out` with the
// same statement as an RcStmt and return RC_OK, RC_ERR_USAGE when out is 0, or
// RC_ERR_NOMEM; unless out is 0, free *out with rc_stmt_free.

// Appends the ledger's CREATE TABLE IF NOT EXISTS.
export fn rc_migration_ledger_ddl(b: RcBuf*) -> int32 {
  if (b == 0) { return RC_ERR_USAGE; }
  var rc: int32 = rc_buf_put(b, "CREATE TABLE IF NOT EXISTS ");
  if (rc != RC_OK) { return rc; }
  rc = rc_buf_ident(b, RC_MIG_LEDGER);
  if (rc != RC_OK) { return rc; }
  rc = rc_buf_put(b, " (");
  if (rc != RC_OK) { return rc; }
  rc = rc_buf_ident(b, "version");
  if (rc != RC_OK) { return rc; }
  rc = rc_buf_put(b, " INTEGER PRIMARY KEY, ");
  if (rc != RC_OK) { return rc; }
  rc = rc_buf_ident(b, "name");
  if (rc != RC_OK) { return rc; }
  rc = rc_buf_put(b, " TEXT NOT NULL, ");
  if (rc != RC_OK) { return rc; }
  rc = rc_buf_ident(b, "applied_at");
  if (rc != RC_OK) { return rc; }
  return rc_buf_put(b, " INTEGER NOT NULL)");
}

// Appends SELECT "version" FROM the ledger ORDER BY "version" ASC.
export fn rc_migration_ledger_select(b: RcBuf*) -> int32 {
  if (b == 0) { return RC_ERR_USAGE; }
  var rc: int32 = rc_buf_put(b, "SELECT ");
  if (rc != RC_OK) { return rc; }
  rc = rc_buf_ident(b, "version");
  if (rc != RC_OK) { return rc; }
  rc = rc_buf_put(b, " FROM ");
  if (rc != RC_OK) { return rc; }
  rc = rc_buf_ident(b, RC_MIG_LEDGER);
  if (rc != RC_OK) { return rc; }
  rc = rc_buf_put(b, " ORDER BY ");
  if (rc != RC_OK) { return rc; }
  rc = rc_buf_ident(b, "version");
  if (rc != RC_OK) { return rc; }
  return rc_buf_put(b, " ASC");
}

// Appends the ledger INSERT; its 3 args are version, name, applied_at.
export fn rc_migration_ledger_insert(b: RcBuf*) -> int32 {
  if (b == 0) { return RC_ERR_USAGE; }
  var rc: int32 = rc_buf_put(b, "INSERT INTO ");
  if (rc != RC_OK) { return rc; }
  rc = rc_buf_ident(b, RC_MIG_LEDGER);
  if (rc != RC_OK) { return rc; }
  rc = rc_buf_put(b, " (");
  if (rc != RC_OK) { return rc; }
  rc = rc_buf_ident(b, "version");
  if (rc != RC_OK) { return rc; }
  rc = rc_buf_put(b, ", ");
  if (rc != RC_OK) { return rc; }
  rc = rc_buf_ident(b, "name");
  if (rc != RC_OK) { return rc; }
  rc = rc_buf_put(b, ", ");
  if (rc != RC_OK) { return rc; }
  rc = rc_buf_ident(b, "applied_at");
  if (rc != RC_OK) { return rc; }
  return rc_buf_put(b, ") VALUES (?, ?, ?)");
}

// The ledger CREATE as an RcStmt, for adapters with `query`.
export fn rc_migration_ledger_ddl_stmt(out: RcStmt*) -> int32 {
  if (out == 0) { return RC_ERR_USAGE; }
  *out = rc_stmt_new(RC_OP_CREATE, RC_MIG_LEDGER);
  out->if_not_exists = true;
  var rc: int32 = rc_stmt_col(out, "version", RC_T_I64, RC_F_PK | RC_F_NOT_NULL);
  if (rc == RC_OK) { rc = rc_stmt_col(out, "name", RC_T_TEXT, RC_F_NOT_NULL); }
  if (rc == RC_OK) { rc = rc_stmt_col(out, "applied_at", RC_T_TIME, RC_F_NOT_NULL); }
  return rc;
}

// The ledger SELECT as an RcStmt.
export fn rc_migration_ledger_select_stmt(out: RcStmt*) -> int32 {
  if (out == 0) { return RC_ERR_USAGE; }
  *out = rc_stmt_new(RC_OP_SELECT, RC_MIG_LEDGER);
  var rc: int32 = rc_stmt_col(out, "version", RC_T_I64, 0);
  if (rc == RC_OK) { rc = rc_stmt_order(out, "version", false); }
  return rc;
}

// The ledger INSERT as an RcStmt (one row; args version, name, applied_at).
export fn rc_migration_ledger_insert_stmt(out: RcStmt*) -> int32 {
  if (out == 0) { return RC_ERR_USAGE; }
  *out = rc_stmt_new(RC_OP_INSERT, RC_MIG_LEDGER);
  out->n_rows = 1;
  var rc: int32 = rc_stmt_col(out, "version", RC_T_I64, 0);
  if (rc == RC_OK) { rc = rc_stmt_col(out, "name", RC_T_TEXT, 0); }
  if (rc == RC_OK) { rc = rc_stmt_col(out, "applied_at", RC_T_TIME, 0); }
  return rc;
}

// Appends DELETE FROM the ledger WHERE "version" = ? (1 arg: the version).
export fn rc_migration_ledger_delete(b: RcBuf*) -> int32 {
  if (b == 0) { return RC_ERR_USAGE; }
  var rc: int32 = rc_buf_put(b, "DELETE FROM ");
  if (rc == RC_OK) { rc = rc_buf_ident(b, RC_MIG_LEDGER); }
  if (rc == RC_OK) { rc = rc_buf_put(b, " WHERE "); }
  if (rc == RC_OK) { rc = rc_buf_ident(b, "version"); }
  if (rc == RC_OK) { rc = rc_buf_put(b, " = ?"); }
  return rc;
}

// The ledger DELETE as an RcStmt.
export fn rc_migration_ledger_delete_stmt(out: RcStmt*) -> int32 {
  if (out == 0) { return RC_ERR_USAGE; }
  *out = rc_stmt_new(RC_OP_DELETE, RC_MIG_LEDGER);
  return rc_stmt_term(out, "version", RC_W_EQ, 0, 1);
}

// Creates m's table if it does not exist (CREATE TABLE IF NOT EXISTS), as SQL
// text or as an RcStmt, whichever the adapter takes. This is what an `up`
// callback calls.
//   a  the adapter; borrowed
//   m  the model's meta
// Returns RC_OK, or RC_ERR_USAGE (a is 0, or m malformed), RC_ERR_UNSUPPORTED
// (a field type with no column), RC_ERR_NOMEM, or the adapter's code.
// Nothing is left to free.
export fn rc_migration_create(a: RcAdapter*, m: RcMeta) -> int32 {
  if (a == 0) { return RC_ERR_USAGE; }
  var buf: RcBuf = rc_buf_new(256);
  if (buf.data == 0) { return RC_ERR_NOMEM; }
  defer rc_buf_free(&buf);
  var rc: int32 = rc_migration_create_table(m, &buf);
  if (rc != RC_OK) { return rc; }
  var st: RcStmt;
  rc = rc_migration_create_stmt(m, &st);
  defer rc_stmt_free(&st);
  if (rc != RC_OK) { return rc; }
  var res: RcResult;
  rc = rc_adapter_run(a, rc_buf_text(&buf), &st, (RcValue*)0, 0, &res);
  if (rc != RC_OK) { return rc; }
  rc_result_free(&res);
  return RC_OK;
}

// --- internals ---------------------------------------------------------------

fn rc_mig_index_of(s: RcMigrationSet, version: int64) -> int32 {
  var i: int32 = 0;
  while (i < s.n) {
    if (s.items[i].version == version) { return i; }
    i = i + 1;
  }
  return -1;
}

fn rc_mig_has(applied: int64*, n: int32, version: int64) -> bool {
  var i: int32 = 0;
  while (i < n) {
    if (applied[i] == version) { return true; }
    i = i + 1;
  }
  return false;
}

// One migration, one transaction: begin, the migration's own SQL, the ledger
// row, commit. Any failure rolls back and returns the code — the caller stops
// the run there. `buf` is the caller's scratch buffer for the INSERT text.
fn rc_mig_apply(a: RcAdapter*, m: RcMigration, at: int64, buf: RcBuf*) -> int32 {
  var rc: int32 = rc_adapter_begin(a, RC_TX_IMMEDIATE);
  if (rc != RC_OK) { return rc; }

  var res: RcResult;
  if (m.up != 0) {
    rc_result_init(&res);
    rc = m.up(a);
  } else {
    rc = rc_adapter_exec(a, m.up_sql, (RcValue*)0, 0, &res);
  }
  if (rc != RC_OK) {
    rc_result_free(&res);
    rc_adapter_rollback(a);
    return rc;
  }
  rc_result_free(&res);

  rc_buf_clear(buf);
  rc = rc_migration_ledger_insert(buf);
  if (rc != RC_OK) {
    rc_adapter_rollback(a);
    return rc;
  }
  var args: RcValue[3];
  args[0] = RcInt(m.version);
  args[1] = RcText(m.name);
  args[2] = RcTime(at);
  var st: RcStmt;
  rc = rc_migration_ledger_insert_stmt(&st);
  defer rc_stmt_free(&st);
  if (rc != RC_OK) {
    rc_adapter_rollback(a);
    return rc;
  }
  rc = rc_adapter_run(a, rc_buf_text(buf), &st, &args[0], 3, &res);
  if (rc != RC_OK) {
    rc_result_free(&res);
    rc_adapter_rollback(a);
    return rc;
  }
  rc_result_free(&res);

  rc = rc_adapter_commit(a);
  if (rc != RC_OK) {
    rc_adapter_rollback(a);
    return rc;
  }
  return RC_OK;
}

// Creates the ledger if it is absent, then reads the applied versions into a
// malloc'd array (*applied, free it) of *n entries with the highest in *max.
// The ledger DDL runs outside a transaction: creating a table is not a unit of
// work, and an adapter that refuses nesting (mem does) would reject the begin
// that follows.
fn rc_mig_read_ledger(a: RcAdapter*, buf: RcBuf*, cap_hint: int32, applied: int64**,
                      n: int32*, max: int64*) -> int32 {
  *applied = 0;
  *n = 0;
  *max = 0;
  var res: RcResult;
  rc_buf_clear(buf);
  var rc: int32 = rc_migration_ledger_ddl(buf);
  if (rc != RC_OK) { return rc; }
  var dst: RcStmt;
  rc = rc_migration_ledger_ddl_stmt(&dst);
  defer rc_stmt_free(&dst);
  if (rc != RC_OK) { return rc; }
  rc = rc_adapter_run(a, rc_buf_text(buf), &dst, (RcValue*)0, 0, &res);
  if (rc != RC_OK) { return rc; }
  rc_result_free(&res);

  // What the store already has. Zero rows is the normal first run.
  rc_buf_clear(buf);
  rc = rc_migration_ledger_select(buf);
  if (rc != RC_OK) { return rc; }
  var sst: RcStmt;
  rc = rc_migration_ledger_select_stmt(&sst);
  defer rc_stmt_free(&sst);
  if (rc != RC_OK) { return rc; }
  rc = rc_adapter_run(a, rc_buf_text(buf), &sst, (RcValue*)0, 0, &res);
  if (rc != RC_OK) { return rc; }
  // A SELECT with no rows reports no columns; only a non-empty result has to
  // be exactly the one column this reader knows how to read.
  if (res.n_rows > 0 && res.n_cols != 1) {
    rc_result_free(&res);
    return RC_ERR_ADAPTER;
  }
  var cap: int32 = cap_hint;
  if (res.n_rows > cap) { cap = res.n_rows; }
  if (cap < 1) { cap = 1; }
  var arr: int64* = malloc((int64)cap * (int64)sizeof(int64));
  if (arr == 0) {
    rc_result_free(&res);
    return RC_ERR_NOMEM;
  }
  var i: int32 = 0;
  while (i < res.n_rows) {
    var v: int64 = 0;
    rc = rc_result_i64(&res, i, 0, &v);
    if (rc != RC_OK) {
      rc_result_free(&res);
      free(arr);
      return RC_ERR_ADAPTER;
    }
    arr[i] = v;
    if (v > *max) { *max = v; }
    i = i + 1;
  }
  *n = res.n_rows;
  rc_result_free(&res);
  *applied = arr;
  return RC_OK;
}

// --- run ---------------------------------------------------------------------

// Applies every migration in `s` that the ledger does not have yet, in
// ascending order, each in its own transaction (RC_TX_IMMEDIATE).
//   a    the adapter; borrowed, already open
//   s    the set; borrowed
//   out  the report; always filled: applied = migrations applied by this run,
//        up_to = highest version applied afterwards, failed_version and code
//        say what stopped the run (0 / RC_OK on success)
// Returns RC_OK (also when nothing was missing), or:
//   RC_ERR_USAGE     out is 0 (nothing filled), a or s is 0, or the set fails
//                    rc_migration_check (no statement runs)
//   RC_ERR_CONFLICT  the ledger has a version the set does not know: the
//                    store is ahead of the code. failed_version is that one;
//                    nothing is applied
//   RC_ERR_NOMEM     an allocation failed
//   RC_ERR_ADAPTER   the ledger SELECT returned an unreadable shape
//   any code from the adapter or an `up` callback; that migration is rolled
//   back, failed_version names it, and earlier ones in this run stay applied
//
// Statement sequence, asserted by call count in the test:
//   1. ledger CREATE IF NOT EXISTS      (no transaction)
//   2. ledger SELECT                    (no transaction)
//   3. per missing migration: begin, up_sql / up, the ledger INSERT, commit
export fn rc_migration_run(a: RcAdapter*, s: RcMigrationSet*,
                           out: RcMigrationReport*) -> int32 {
  if (out == 0) { return RC_ERR_USAGE; }
  out->applied = 0;
  out->up_to = 0;
  out->failed_version = 0;
  out->code = RC_OK;
  if (a == 0 || s == 0) {
    out->code = RC_ERR_USAGE;
    return RC_ERR_USAGE;
  }

  var rc: int32 = rc_migration_check(*s);
  if (rc != RC_OK) {
    out->code = rc;
    return rc;
  }

  var buf: RcBuf = rc_buf_new(256);
  if (buf.data == 0) {
    out->code = RC_ERR_NOMEM;
    return RC_ERR_NOMEM;
  }
  defer rc_buf_free(&buf);
  var applied: int64* = 0;
  var n_applied: int32 = 0;
  var ledger_max: int64 = 0;
  rc = rc_mig_read_ledger(a, &buf, s->n, &applied, &n_applied, &ledger_max);
  if (rc != RC_OK) { out->code = rc; return rc; }
  defer free(applied);
  out->up_to = ledger_max;
  var i: int32 = 0;

  // A version in the ledger that the code does not know about means the
  // store is ahead of the binary. Running older DDL over a newer schema
  // corrupts it silently, so this is a refusal, not a warning.
  while (i < n_applied) {
    if (rc_mig_index_of(*s, applied[i]) < 0) {
      out->code = RC_ERR_CONFLICT;
      out->failed_version = applied[i];
      return RC_ERR_CONFLICT;
    }
    i = i + 1;
  }

  // Apply what is missing, ascending, one transaction each.
  i = 0;
  while (i < s->n) {
    var m: RcMigration = s->items[i];
    if (!rc_mig_has(applied, n_applied, m.version)) {
      rc = rc_mig_apply(a, m, rc_migration_now_micros(), &buf);
      if (rc != RC_OK) {
        out->code = rc;
        out->failed_version = m.version;
        return rc;
      }
      out->applied = out->applied + 1;
      if (m.version > out->up_to) { out->up_to = m.version; }
    }
    i = i + 1;
  }

  out->code = RC_OK;
  out->failed_version = 0;
  return RC_OK;
}

fn rc_mig_has_down(m: RcMigration) -> bool {
  if (m.down != 0) { return true; }
  if (m.down_sql.length > (uint64)0) { return true; }
  return false;
}

// One rollback, one transaction: begin, the down step, delete the ledger row,
// commit. Any failure rolls back and returns the code.
fn rc_mig_revert(a: RcAdapter*, m: RcMigration, buf: RcBuf*) -> int32 {
  var rc: int32 = rc_adapter_begin(a, RC_TX_IMMEDIATE);
  if (rc != RC_OK) { return rc; }
  var res: RcResult;
  if (m.down != 0) {
    rc_result_init(&res);
    rc = m.down(a);
  } else {
    rc = rc_adapter_exec(a, m.down_sql, (RcValue*)0, 0, &res);
  }
  rc_result_free(&res);
  if (rc != RC_OK) {
    rc_adapter_rollback(a);
    return rc;
  }
  rc_buf_clear(buf);
  var st: RcStmt = rc_stmt_new(RC_OP_DELETE, RC_MIG_LEDGER);
  defer rc_stmt_free(&st);
  rc = rc_migration_ledger_delete(buf);
  if (rc == RC_OK) { rc = rc_migration_ledger_delete_stmt(&st); }
  if (rc != RC_OK) {
    rc_adapter_rollback(a);
    return rc;
  }
  var args: RcValue[1];
  args[0] = RcInt(m.version);
  rc = rc_adapter_run(a, rc_buf_text(buf), &st, &args[0], 1, &res);
  rc_result_free(&res);
  if (rc != RC_OK) {
    rc_adapter_rollback(a);
    return rc;
  }
  rc = rc_adapter_commit(a);
  if (rc != RC_OK) { rc_adapter_rollback(a); }
  return rc;
}

// Rolls back every applied version above `to`, newest first, each in its own
// transaction (like `mix ecto.rollback --to`): the down step, then the ledger
// row is deleted.
//   a    the adapter; borrowed, already open
//   s    the set; borrowed
//   to   keep versions <= to; 0 rolls back everything; must be >= 0
//   out  the report; always filled: applied = versions rolled back, up_to =
//        highest version still applied on success, failed_version and code
//        say what stopped it (0 / RC_OK on success)
// Returns RC_OK (also when nothing is above `to`), or:
//   RC_ERR_USAGE        out is 0 (nothing filled), a or s is 0, to < 0, or the
//                       set fails rc_migration_check
//   RC_ERR_CONFLICT     an applied version above `to` is not in the set
//   RC_ERR_UNSUPPORTED  an applied version above `to` has no down step
//   RC_ERR_NOMEM        an allocation failed
//   RC_ERR_ADAPTER      the ledger SELECT returned an unreadable shape
//   any code from the adapter or a `down` callback; that version's
//   transaction is rolled back, failed_version names it, and versions undone
//   before it stay undone
// CONFLICT and UNSUPPORTED are checked for every version first, so either one
// means nothing was rolled back.
export fn rc_migration_down(a: RcAdapter*, s: RcMigrationSet*, to: int64,
                            out: RcMigrationReport*) -> int32 {
  if (out == 0) { return RC_ERR_USAGE; }
  out->applied = 0;
  out->up_to = 0;
  out->failed_version = 0;
  out->code = RC_OK;
  if (a == 0 || s == 0 || to < 0) {
    out->code = RC_ERR_USAGE;
    return RC_ERR_USAGE;
  }
  var rc: int32 = rc_migration_check(*s);
  if (rc != RC_OK) {
    out->code = rc;
    return rc;
  }
  var buf: RcBuf = rc_buf_new(256);
  if (buf.data == 0) {
    out->code = RC_ERR_NOMEM;
    return RC_ERR_NOMEM;
  }
  defer rc_buf_free(&buf);
  var applied: int64* = 0;
  var n_applied: int32 = 0;
  var ledger_max: int64 = 0;
  rc = rc_mig_read_ledger(a, &buf, s->n, &applied, &n_applied, &ledger_max);
  if (rc != RC_OK) { out->code = rc; return rc; }
  defer free(applied);
  out->up_to = ledger_max;

  // Checked newest first, the order the rollback would run in.
  var i: int32 = n_applied - 1;
  while (i >= 0) {
    if (applied[i] > to) {
      var at: int32 = rc_mig_index_of(*s, applied[i]);
      if (at < 0) { rc = RC_ERR_CONFLICT; }
      if (at >= 0 && !rc_mig_has_down(s->items[at])) { rc = RC_ERR_UNSUPPORTED; }
      if (rc != RC_OK) {
        out->code = rc;
        out->failed_version = applied[i];
        return rc;
      }
    }
    i = i - 1;
  }

  // The set is ascending, so walking it backwards undoes newest first.
  i = s->n - 1;
  while (i >= 0) {
    var m: RcMigration = s->items[i];
    if (m.version > to && rc_mig_has(applied, n_applied, m.version)) {
      rc = rc_mig_revert(a, m, &buf);
      if (rc != RC_OK) {
        // Everything above m was undone; m itself was rolled back intact.
        out->code = rc;
        out->failed_version = m.version;
        out->up_to = m.version;
        return rc;
      }
      out->applied = out->applied + 1;
    }
    i = i - 1;
  }
  var highest: int64 = 0;
  i = 0;
  while (i < n_applied) {
    if (applied[i] <= to && applied[i] > highest) { highest = applied[i]; }
    i = i + 1;
  }
  out->up_to = highest;
  return RC_OK;
}
