// uuid: RFC 9562 UUIDs for Mettle, in pure Mettle. Versions 3 and 5 hash
// with cryptex (package "crypto").
//
//   import "uuid/uuid";
//
// This file re-exports every module below. All exported names start with
// uuid_, Uuid or UUID_.
//
//   uuid/core    the Uuid type, nil and max, fields, byte order, compare, hash
//   uuid/text    parse and format: hyphenated, simple, URN, braced
//   uuid/gen     versions 1, 3, 4, 5, 6, 7 and 8, and reading their fields
//   uuid/ulid    ULIDs: Crockford base32, monotonic generator

import "uuid/core";
import "uuid/text";
import "uuid/gen";
import "uuid/ulid";
