// open flags that differ between the two CPUs.
export const SBX_O_DIRECTORY = 0x10000;
export const SBX_O_NOFOLLOW = 0x20000;

// seccomp: the audit arch value for this CPU, and whether x32 calls must be refused.
export const SBX_AUDIT_ARCH: uint32 = 0xc000003e;
export const SBX_HAS_X32 = 1;

