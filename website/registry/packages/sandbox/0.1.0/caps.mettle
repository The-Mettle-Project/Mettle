// Linux capabilities and no_new_privs.
//
// sandbox_caps_drop keeps only the capabilities in a mask (bit n is
// capability n) and removes the rest from the bounding, ambient, effective,
// permitted and inheritable sets, the same steps as minijail. With an empty
// bounding set even uid 0 inside a user namespace gains nothing at exec.
//
// sandbox_no_new_privs makes exec unable to grant privileges (setuid bits
// and file capabilities are ignored). Seccomp and Landlock need it.

import "sys.mettle";

export const SANDBOX_CAP_CHOWN = 0;
export const SANDBOX_CAP_DAC_OVERRIDE = 1;
export const SANDBOX_CAP_KILL = 5;
export const SANDBOX_CAP_SETGID = 6;
export const SANDBOX_CAP_SETUID = 7;
export const SANDBOX_CAP_SETPCAP = 8;
export const SANDBOX_CAP_NET_BIND_SERVICE = 10;
export const SANDBOX_CAP_NET_RAW = 13;
export const SANDBOX_CAP_SYS_CHROOT = 18;
export const SANDBOX_CAP_SYS_ADMIN = 21;

const PR_SET_PDEATHSIG = 1;
const PR_SET_DUMPABLE = 4;
const PR_CAPBSET_READ = 23;
const PR_CAPBSET_DROP = 24;
const PR_SET_NO_NEW_PRIVS = 38;
const PR_GET_NO_NEW_PRIVS = 39;
const PR_CAP_AMBIENT = 47;
const PR_CAP_AMBIENT_CLEAR_ALL = 4;
const CAP_VERSION_3 = 0x20080522;

struct SbxCapHeader { version: uint32; pid: int32; }
struct SbxCapData { effective: uint32; permitted: uint32; inheritable: uint32; }

// The highest capability number the kernel knows, found by probing the
// bounding set (works without /proc).
export fn sandbox_caps_last() -> int32 {
  var c: int32 = 0;
  while (c < 64 && syscall(SBX_NR_PRCTL, PR_CAPBSET_READ, (int64)c, 0, 0, 0) >= 0) { c = c + 1; }
  return c - 1;
}

// The effective set of the current process as a mask, or 0 on error.
export fn sandbox_caps_effective() -> uint64 {
  var h: SbxCapHeader = { version: CAP_VERSION_3, pid: 0 };
  var d: SbxCapData[2];
  if (syscall(SBX_NR_CAPGET, &h, &d[0]) < 0) { return 0; }
  return (uint64)d[0].effective | ((uint64)d[1].effective << 32);
}

// Keeps only the capabilities in keep. Returns 0 or -errno.
export fn sandbox_caps_drop(keep: uint64) -> int64 {
  var h: SbxCapHeader = { version: CAP_VERSION_3, pid: 0 };
  var d: SbxCapData[2];
  var r: int64 = syscall(SBX_NR_CAPGET, &h, &d[0]);
  if (r < 0) { return r; }
  var eff: uint64 = (uint64)d[0].effective | ((uint64)d[1].effective << 32);
  var perm: uint64 = (uint64)d[0].permitted | ((uint64)d[1].permitted << 32);
  var can_setpcap: bool = (eff & ((uint64)1 << SANDBOX_CAP_SETPCAP)) != 0;

  // Bounding set first, while CAP_SETPCAP may still be held. Without it the
  // set cannot shrink; that is safe only together with no_new_privs, which
  // sandbox_spawn always sets.
  var last: int32 = sandbox_caps_last();
  for c in 0..=last {
    if ((keep & ((uint64)1 << (uint64)c)) == 0 && syscall(SBX_NR_PRCTL, PR_CAPBSET_READ, (int64)c, 0, 0, 0) == 1) {
      r = syscall(SBX_NR_PRCTL, PR_CAPBSET_DROP, (int64)c, 0, 0, 0);
      if (r < 0 && can_setpcap) { return r; }
    }
  }
  r = syscall(SBX_NR_PRCTL, PR_CAP_AMBIENT, PR_CAP_AMBIENT_CLEAR_ALL, 0, 0, 0);
  if (r < 0 && r != -SANDBOX_EINVAL) { return r; }

  var want: uint64 = keep & perm;
  d[0].effective = (uint32)(want & 0xffffffff);
  d[0].permitted = d[0].effective;
  d[0].inheritable = d[0].effective;
  d[1].effective = (uint32)(want >> 32);
  d[1].permitted = d[1].effective;
  d[1].inheritable = d[1].effective;
  h.version = CAP_VERSION_3;
  h.pid = 0;
  return syscall(SBX_NR_CAPSET, &h, &d[0]);
}

// Sets no_new_privs on the current process; it cannot be cleared. Returns 0 or -errno.
export fn sandbox_no_new_privs() -> int64 {
  return syscall(SBX_NR_PRCTL, PR_SET_NO_NEW_PRIVS, 1, 0, 0, 0);
}

// 1 if no_new_privs is set, 0 if not, or -errno.
export fn sandbox_no_new_privs_get() -> int64 {
  return syscall(SBX_NR_PRCTL, PR_GET_NO_NEW_PRIVS, 0, 0, 0, 0);
}

// Asks the kernel to send sig to this process when its parent dies.
export fn sbx_parent_death_signal(sig: int32) -> int64 {
  return syscall(SBX_NR_PRCTL, PR_SET_PDEATHSIG, (int64)sig, 0, 0, 0);
}

// Turns core dumps and ptrace by same-uid processes off (or back on).
export fn sbx_set_dumpable(on: int32) -> int64 {
  return syscall(SBX_NR_PRCTL, PR_SET_DUMPABLE, (int64)on, 0, 0, 0);
}
