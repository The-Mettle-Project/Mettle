// ---- bits of an audio packet, least significant first ----

struct VbRd {
  p: uint8*;
  n: int64;
  pos: int64;
  acc: uint64;
  cnt: int32;
  eop: bool;     // read past the end of the packet
}

@inline fn vb_fill(r: VbRd*) {
  while (r->cnt <= 56 && r->pos < r->n) {
    r->acc = r->acc | ((uint64)r->p[r->pos] << r->cnt);
    r->pos = r->pos + 1;
    r->cnt = r->cnt + 8;
  }
}

fn vb_get(r: VbRd*, k: int32) -> int64 {
  if (k <= 0) { return 0; }
  if (r->cnt < k) {
    vb_fill(r);
    if (r->cnt < k) {
      r->eop = true;
      r->acc = 0;
      r->cnt = 0;
      return 0;
    }
  }
  var v: uint64 = r->acc & (((uint64)1 << k) - 1);
  r->acc = r->acc >> k;
  r->cnt = r->cnt - k;
  return (int64)v;
}

fn vb_decode_long(r: VbRd*, c: AudioVorbisBook*) -> int32 {
  if (c->nlong == 0) { r->eop = true; return -1; }
  var code: uint32 = audio_vorbis_rev32((uint32)(r->acc & 0xFFFFFFFF));
  var x: int32 = 0;
  var n: int32 = c->nlong;
  while (n > 1) {
    var m: int32 = x + (n >> 1);
    if (c->lcode[m] <= code) {
      x = m;
      n = n - (n >> 1);
    } else {
      n = n >> 1;
    }
  }
  var slot: int32 = c->lslot[x];
  // Always true for a good book. The check also keeps the release build
  // from reading slen[slot] before slot is loaded (a compiler bug).
  if (slot < 0 || slot >= c->used) { r->eop = true; return -1; }
  var l: int32 = (int32)c->slen[slot];
  var diff: uint64 = (uint64)(code ^ c->lcode[x]);
  if (code < c->lcode[x] || (diff >> (32 - l)) != 0 || l > r->cnt) { r->eop = true; return -1; }
  r->acc = r->acc >> l;
  r->cnt = r->cnt - l;
  return slot;
}

// Reads one codeword: its slot in the book, or -1 (and eop set).
@inline fn vb_decode(r: VbRd*, c: AudioVorbisBook*) -> int32 {
  if (r->cnt < 32) { vb_fill(r); }
  var e: int32 = c->fast[(int32)(r->acc & VB_FAST_MASK)];
  if (e >= 0) {
    var l: int32 = e & 63;
    if (l > r->cnt) { r->eop = true; return -1; }
    r->acc = r->acc >> l;
    r->cnt = r->cnt - l;
    return e >> 6;
  }
  if (c->single > 0) {
    var l1: int32 = c->single;
    if (l1 > r->cnt) { r->eop = true; return -1; }
    r->acc = r->acc >> l1;
    r->cnt = r->cnt - l1;
    return 0;
  }
  return vb_decode_long(r, c);
}

// ---- floors ----

fn vb_floor1_read(d: AudioVorbis*, r: VbRd*, f: AudioVorbisFloor*, y: int32*, step: uint8*) -> bool {
  if (vb_get(r, 1) == 0) { return false; }
  var range: int32 = 256;
  if (f->mult == 2) { range = 128; } else if (f->mult == 3) { range = 86; } else if (f->mult == 4) { range = 64; }
  var rb: int32 = audio_vorbis_ilog((int64)(range - 1));
  y[0] = (int32)vb_get(r, rb);
  y[1] = (int32)vb_get(r, rb);
  var books: AudioVorbisBook* = d->s.books;
  var off: int32 = 2;
  for j in 0..f->parts {
    var cl: int32 = f->pclass[j];
    var cb: int32 = f->csub[cl];
    var mask: int32 = (1 << cb) - 1;
    var cval: int32 = 0;
    if (cb > 0) {
      var mb: AudioVorbisBook* = &books[f->cmaster[cl]];
      var s0: int32 = vb_decode(r, mb);
      if (s0 < 0) { return false; }
      cval = mb->sym[s0];
    }
    for k in 0..f->cdim[cl] {
      var bk: int32 = f->cbooks[cl * 8 + (cval & mask)];
      cval = cval >> cb;
      if (bk >= 0) {
        var sb: AudioVorbisBook* = &books[bk];
        var s1: int32 = vb_decode(r, sb);
        if (s1 < 0) { return false; }
        y[off] = sb->sym[s1];
      } else {
        y[off] = 0;
      }
      off = off + 1;
    }
  }
  if (r->eop) { return false; }
  // turn the coded differences into values (spec 7.2.4 step 1)
  step[0] = 1;
  step[1] = 1;
  for j in 2..f->values {
    var lo: int32 = f->lo[j];
    var hi: int32 = f->hi[j];
    var x0: int32 = f->x[lo];
    var x1: int32 = f->x[hi];
    var y0: int32 = y[lo];
    var y1: int32 = y[hi];
    var dy: int32 = y1 - y0;
    var adx: int32 = x1 - x0;
    var ady: int32 = dy;
    if (ady < 0) { ady = -ady; }
    var err: int32 = ady * (f->x[j] - x0);
    var offp: int32 = err / adx;
    var pred: int32 = y0 + offp;
    if (dy < 0) { pred = y0 - offp; }
    var val: int32 = y[j];
    var highroom: int32 = range - pred;
    var lowroom: int32 = pred;
    var room: int32 = lowroom * 2;
    if (highroom < lowroom) { room = highroom * 2; }
    if (val != 0) {
      step[lo] = 1;
      step[hi] = 1;
      step[j] = 1;
      if (val >= room) {
        if (highroom > lowroom) {
          y[j] = val - lowroom + pred;
        } else {
          y[j] = pred - val + highroom - 1;
        }
      } else if ((val & 1) != 0) {
        y[j] = pred - ((val + 1) >> 1);
      } else {
        y[j] = pred + (val >> 1);
      }
    } else {
      step[j] = 0;
      y[j] = pred;
    }
  }
  return true;
}

@inline fn vb_db_index(v: int32) -> int32 {
  if (v < 0) { return 0; }
  if (v > 255) { return 255; }
  return v;
}

// The integer line of spec 9.2.6, multiplied into t.
fn vb_line(t: float32*, x0: int32, y0: int32, x1in: int32, y1: int32, n: int32) {
  var dy: int32 = y1 - y0;
  var adx: int32 = x1in - x0;
  var ady: int32 = dy;
  if (ady < 0) { ady = -ady; }
  var base: int32 = dy / adx;
  var sy: int32 = base + 1;
  if (dy < 0) { sy = base - 1; }
  var ab: int32 = base;
  if (ab < 0) { ab = -ab; }
  ady = ady - ab * adx;
  var x1: int32 = x1in;
  if (x1 > n) { x1 = n; }
  var x: int32 = x0;
  var y: int32 = y0;
  var err: int32 = 0;
  if (x < x1) {
    t[x] = t[x] * VB_DB[y];
    x = x + 1;
    while (x < x1) {
      err = err + ady;
      if (err >= adx) {
        err = err - adx;
        y = y + sy;
      } else {
        y = y + base;
      }
      t[x] = t[x] * VB_DB[y];
      x = x + 1;
    }
  }
}

fn vb_floor1_apply(f: AudioVorbisFloor*, y: int32*, step: uint8*, t: float32*, n2: int32) {
  var lx: int32 = 0;
  var ly: int32 = vb_db_index(y[0] * f->mult);
  for q in 1..f->values {
    var j: int32 = f->sorted[q];
    if (step[j] != 0) {
      var hy: int32 = vb_db_index(y[j] * f->mult);
      var hx: int32 = f->x[j];
      if (lx < hx) { vb_line(t, lx, ly, hx, hy, n2); }
      lx = hx;
      ly = hy;
    }
  }
  if (lx < n2) {
    var v: float32 = VB_DB[ly];
    for j in lx..n2 { t[j] = t[j] * v; }
  }
}

fn vb_floor0_read(d: AudioVorbis*, r: VbRd*, f: AudioVorbisFloor*, coef: float32*, amp: int64*) -> bool {
  var a: int64 = vb_get(r, f->amp_bits);
  if (a == 0 || r->eop) { return false; }
  var bn: int32 = (int32)vb_get(r, audio_vorbis_ilog((int64)f->nbooks));
  if (bn >= f->nbooks || r->eop) { return false; }
  var bk: AudioVorbisBook* = &d->s.books[f->books[bn]];
  if (bk->lookup == 0 || bk->dim < 1) { return false; }
  var dim: int32 = bk->dim;
  var i: int32 = 0;
  var last: float32 = 0.0;
  while (i < f->order) {
    var sl: int32 = vb_decode(r, bk);
    if (sl < 0) { return false; }
    var row: float32* = bk->vq + (int64)sl * (int64)dim;
    for k in 0..dim {
      if (i < f->order) {
        coef[i] = row[k] + last;
        i = i + 1;
      }
    }
    last = row[dim - 1] + last;
  }
  *amp = a;
  return true;
}

// The LSP curve of spec 6.2.3, multiplied into t.
fn vb_floor0_apply(f: AudioVorbisFloor*, coef: float32*, amp: int64, t: float32*, n2: int32, k: int32) {
  var map: int32* = f->map[k];
  var cw: float32* = f->cosw[k];
  var cc: float64[256];
  for j in 0..f->order { cc[j] = audio_cos((float64)coef[j]); }
  var denom: float64 = audio_pow(2.0, (float64)f->amp_bits) - 1.0;
  var lin: float64 = (float64)amp * (float64)f->amp_off / denom;
  var odd: bool = (f->order & 1) != 0;
  var i: int32 = 0;
  while (i < n2) {
    var w: float64 = (float64)cw[i];
    var p: float64 = 1.0;
    var q: float64 = 1.0;
    var j: int32 = 1;
    while (j < f->order) { var tp: float64 = cc[j] - w; p = p * 4.0 * tp * tp; j = j + 2; }
    j = 0;
    while (j < f->order) { var tq: float64 = cc[j] - w; q = q * 4.0 * tq * tq; j = j + 2; }
    if (odd) {
      p = p * (1.0 - w * w);
      q = q * 0.25;
    } else {
      p = p * (1.0 - w) * 0.5;
      q = q * (1.0 + w) * 0.5;
    }
    var v: float32 = (float32)audio_exp(0.11512925 * (lin / audio_sqrt(p + q) - (float64)f->amp_off));
    var cond: int32 = map[i];
    while (i < n2 && map[i] == cond) {
      t[i] = t[i] * v;
      i = i + 1;
    }
  }
}

// ---- residue ----

// One partition of VQ vectors added into t[off .. off + psize).
fn vb_vq(r: VbRd*, bk: AudioVorbisBook*, t: float32*, off: int32, psize: int32, kind: int32) -> bool {
  var dim: int32 = bk->dim;
  var vq: float32* = bk->vq;
  if (kind == 0) {
    var step: int32 = psize / dim;
    for j in 0..step {
      var s0: int32 = vb_decode(r, bk);
      if (s0 < 0) { return false; }
      var row: float32* = vq + (int64)s0 * (int64)dim;
      var at: int32 = off + j;
      for k in 0..dim {
        t[at] = t[at] + row[k];
        at = at + step;
      }
    }
    return true;
  }
  var i: int32 = 0;
  while (i < psize) {
    var s1: int32 = vb_decode(r, bk);
    if (s1 < 0) { return false; }
    var row1: float32* = vq + (int64)s1 * (int64)dim;
    var lim: int32 = psize - i;
    if (lim > dim) { lim = dim; }
    var dst: float32* = t + (int64)(off + i);
    for k in 0..lim { dst[k] = dst[k] + row1[k]; }
    i = i + lim;
  }
  return true;
}

// Residue vectors of nv channels (tgt[j] = 0: do not decode), each `size`
// long, decoded the residue 0/1 way (spec 8.6.2).
fn vb_res_decode(d: AudioVorbis*, r: VbRd*, res: AudioVorbisResidue*, tgt: float32**, nv: int32, size: int32, kind: int32) {
  var books: AudioVorbisBook* = d->s.books;
  var cb: AudioVorbisBook* = &books[res->classbook];
  var cw: int32 = cb->dim;
  var lb: int32 = res->begin;
  var le: int32 = res->end;
  if (lb > size) { lb = size; }
  if (le > size) { le = size; }
  var parts: int32 = (le - lb) / res->psize;
  if (parts <= 0) { return; }
  var mp: int32 = d->s.max_parts;
  var cls: uint8* = d->classes;
  for pass in 0..8 {
    var pc: int32 = 0;
    while (pc < parts) {
      if (pass == 0) {
        for j in 0..nv {
          if (tgt[j] != 0) {
            var s0: int32 = vb_decode(r, cb);
            if (s0 < 0) { return; }
            var row: uint8* = res->classdata + (int64)s0 * (int64)cw;
            for i in 0..cw {
              if (pc + i < parts) { cls[j * mp + pc + i] = row[i]; }
            }
          }
        }
      }
      var i2: int32 = 0;
      while (i2 < cw && pc < parts) {
        var off: int32 = lb + pc * res->psize;
        for j in 0..nv {
          if (tgt[j] != 0) {
            var bk: int32 = res->books[(int32)cls[j * mp + pc] * 8 + pass];
            if (bk >= 0) {
              var book: AudioVorbisBook* = &books[bk];
              if (book->lookup == 0 || book->dim < 1) { return; }
              if (!vb_vq(r, book, tgt[j], off, res->psize, kind)) { return; }
            }
          }
        }
        pc = pc + 1;
        i2 = i2 + 1;
      }
    }
  }
}

@inline fn vb_chan(d: AudioVorbis*, bank: int32, c: int32) -> float32* {
  return d->bank + ((int64)bank * (int64)d->s.channels + (int64)c) * (int64)d->s.bs[1];
}

fn vb_residue(d: AudioVorbis*, r: VbRd*, ri: int32, chans: int32*, nch: int32, n2: int32) {
  var res: AudioVorbisResidue* = &d->s.res[ri];
  var tgt: float32*[8];
  if (res->kind == 2) {
    var any: bool = false;
    for j in 0..nch {
      if (d->decode[chans[j]]) { any = true; }
    }
    if (!any) { return; }
    if (nch == 1) {
      tgt[0] = vb_chan(d, d->cur, chans[0]);
      vb_res_decode(d, r, res, &tgt[0], 1, n2, 1);
      return;
    }
    var size: int32 = n2 * nch;
    memset(d->big, 0, (int64)size * 4);
    tgt[0] = d->big;
    vb_res_decode(d, r, res, &tgt[0], 1, size, 1);
    // spread the interleaved vector over the channels
    for j in 0..nch {
      var t: float32* = vb_chan(d, d->cur, chans[j]);
      var at: int32 = j;
      for i in 0..n2 {
        t[i] = d->big[at];
        at = at + nch;
      }
    }
    return;
  }
  for j in 0..nch {
    tgt[j] = (float32*)0;
    if (d->decode[chans[j]]) { tgt[j] = vb_chan(d, d->cur, chans[j]); }
  }
  vb_res_decode(d, r, res, &tgt[0], nch, n2, res->kind);
}

// ---- one audio packet ----

// Decodes a packet into the current bank. Returns its block size, or -1.
fn vb_packet(d: AudioVorbis*, p: uint8*, n: int64) -> int32 {
  var s: AudioVorbisSetup* = &d->s;
  var rd: VbRd;
  rd.p = p;
  rd.n = n;
  var r: VbRd* = &rd;
  if (vb_get(r, 1) != 0) { return -1; }
  var mode: int32 = (int32)vb_get(r, s->mode_bits);
  if (r->eop || mode >= s->nmodes) { return -1; }
  var bf: int32 = s->modes[mode].blockflag;
  var bsz: int32 = s->bs[bf];
  if (bf != 0) {
    vb_get(r, 1);
    vb_get(r, 1);
  }
  if (r->eop) { return -1; }
  var map: AudioVorbisMapping* = &s->maps[s->modes[mode].mapping];
  var n2: int32 = bsz >> 1;
  var ch: int32 = s->channels;
  var mf: int32 = s->max_floor;
  // floors
  for c in 0..ch {
    var fl: AudioVorbisFloor* = &s->floors[map->floor[map->mux[c]]];
    if (fl->kind == 1) {
      d->nonzero[c] = vb_floor1_read(d, r, fl, d->fy + c * mf, d->fstep + c * mf);
    } else {
      d->nonzero[c] = vb_floor0_read(d, r, fl, d->fcoef + c * mf, &d->famp[c]);
    }
    d->decode[c] = d->nonzero[c];
  }
  for i in 0..map->steps {
    var mg: int32 = (int32)map->mag[i];
    var an: int32 = (int32)map->ang[i];
    if (d->decode[mg] || d->decode[an]) {
      d->decode[mg] = true;
      d->decode[an] = true;
    }
  }
  // residues, one submap at a time
  var chans: int32[8];
  for sub in 0..map->submaps {
    var nch: int32 = 0;
    for c in 0..ch {
      if (map->mux[c] == sub) {
        chans[nch] = c;
        nch = nch + 1;
        memset(vb_chan(d, d->cur, c), 0, (int64)n2 * 4);
      }
    }
    if (nch > 0) { vb_residue(d, r, map->residue[sub], &chans[0], nch, n2); }
  }
  // inverse coupling
  var st: int32 = map->steps - 1;
  while (st >= 0) {
    var mv: float32* = vb_chan(d, d->cur, (int32)map->mag[st]);
    var av: float32* = vb_chan(d, d->cur, (int32)map->ang[st]);
    for j in 0..n2 {
      var m: float32 = mv[j];
      var a: float32 = av[j];
      if (m > 0.0) {
        if (a > 0.0) { av[j] = m - a; } else { av[j] = m; mv[j] = m + a; }
      } else {
        if (a > 0.0) { av[j] = m + a; } else { av[j] = m; mv[j] = m - a; }
      }
    }
    st = st - 1;
  }
  // floor curves, then the transform
  for c in 0..ch {
    var t: float32* = vb_chan(d, d->cur, c);
    if (!d->nonzero[c]) {
      memset(t, 0, (int64)bsz * 4);
      continue;
    }
    var fl2: AudioVorbisFloor* = &s->floors[map->floor[map->mux[c]]];
    if (fl2->kind == 1) {
      vb_floor1_apply(fl2, d->fy + c * mf, d->fstep + c * mf, t, n2);
    } else {
      vb_floor0_apply(fl2, d->fcoef + c * mf, d->famp[c], t, n2, bf);
    }
    audio_vorbis_imdct(&d->mdct[bf], t);
  }
  return bsz;
}

// Block size of an audio packet without decoding it, or -1.
fn vb_peek(d: AudioVorbis*, p: uint8*, n: int64) -> int32 {
  if (n < 1 || (p[0] & 1) != 0) { return -1; }
  var rd: VbRd;
  rd.p = p;
  rd.n = n;
  vb_get(&rd, 1);
  var mode: int32 = (int32)vb_get(&rd, d->s.mode_bits);
  if (rd.eop || mode >= d->s.nmodes) { return -1; }
  return d->s.bs[d->s.modes[mode].blockflag];
}

// From the reader's place: reads packets up to the first one that ends a
// page and works out the granule at which the first packet ends (where
// the decoder's output starts, the first packet only priming the
// overlap). AUDIO_OK, 1 when that page ends the stream, or AUDIO_END.
fn vb_scan(d: AudioVorbis*, e1: int64*) -> int32 {
  var prev: int32 = 0;
  var sum: int64 = 0;
  var pk: AudioOggPacket;
  while (true) {
    if (audio_ogg_packet(&d->ogg, &pk) != AUDIO_OK) { return AUDIO_END; }
    var bs: int32 = vb_peek(d, pk.data, pk.len);
    if (bs < 0) { continue; }
    if (prev > 0) { sum = sum + (int64)(prev / 4 + bs / 4); }
    prev = bs;
    if (pk.granule != -1) {
      *e1 = pk.granule - sum;
      if (pk.eos) { return 1; }
      return AUDIO_OK;
    }
  }
  return AUDIO_END;
}

// The next page of our stream at or after `at` that starts before `hi`
// and has a granule.
fn vb_gpage(d: AudioVorbis*, at: int64, hi: int64, pg: AudioOggPage*) -> bool {
  var a: int64 = at;
  while (a < hi) {
    if (audio_ogg_find_page(&d->ogg, a, pg) != AUDIO_OK) { return false; }
    if (pg->off >= hi) { return false; }
    if (pg->serial == d->ogg.serial && pg->granule != -1) { return true; }
    a = pg->off + pg->size;
  }
  return false;
}

// Offset of the last page before `hi` whose granule is below tg, or -1.
fn vb_find_before(d: AudioVorbis*, hi: int64, tg: int64) -> int64 {
  var lo: int64 = d->start_off;
  var h: int64 = hi;
  var best: int64 = -1;
  var pg: AudioOggPage;
  while (h - lo > 65536) {
    var mid: int64 = lo + (h - lo) / 2;
    if (!vb_gpage(d, mid, h, &pg)) { h = mid; continue; }
    if (pg.granule < tg) {
      lo = pg.off;
      best = pg.off;
    } else {
      h = mid;
    }
  }
  var at: int64 = lo;
  while (vb_gpage(d, at, h, &pg)) {
    if (pg.granule >= tg) { break; }
    best = pg.off;
    at = pg.off + pg.size;
  }
  return best;
}

// Back to the first audio packet.
fn vb_restart(d: AudioVorbis*, skip: int64) {
  audio_ogg_seek_byte(&d->ogg, d->start_off);
  d->pos = d->g0;
  d->skip_g = skip;
  d->prev_n = 0;
  d->done = false;
}

const VB_DST3: int32[3] = [0, 2, 1];
const VB_DST5: int32[5] = [0, 2, 1, 3, 4];
const VB_DST6: int32[6] = [0, 2, 1, 4, 5, 3];
const VB_DST7: int32[7] = [0, 2, 1, 5, 6, 4, 3];
const VB_DST8: int32[8] = [0, 2, 1, 6, 7, 4, 5, 3];

fn vb_alloc_f(n: int64) -> float32* {
  var k: int64 = n;
  if (k < 1) { k = 1; }
  return (float32*)calloc(k, 4);
}

/// Reads the three headers. The data must stay alive until close.
export fn audio_vorbis_open(d: AudioVorbis*, p: uint8*, n: int64) -> int32 {
  memset(d, 0, sizeof(AudioVorbis));
  if (p == 0 || n <= 0) { return AUDIO_E_ARG; }
  audio_ogg_init(&d->ogg, p, n);
  var pk: AudioOggPacket;
  if (audio_ogg_packet(&d->ogg, &pk) != AUDIO_OK) { audio_vorbis_close(d); return AUDIO_E_FORMAT; }
  var rc: int32 = audio_vorbis_parse_id(&d->s, pk.data, pk.len);
  if (rc != AUDIO_OK) { audio_vorbis_close(d); return rc; }
  rc = audio_ogg_packet(&d->ogg, &pk);
  if (rc != AUDIO_OK) { audio_vorbis_close(d); return AUDIO_E_TRUNC; }
  if (!audio_vorbis_is_comment(pk.data, pk.len)) { audio_vorbis_close(d); return AUDIO_E_DATA; }
  rc = audio_ogg_packet(&d->ogg, &pk);
  if (rc != AUDIO_OK) { audio_vorbis_close(d); return AUDIO_E_TRUNC; }
  rc = audio_vorbis_parse_setup(&d->s, pk.data, pk.len);
  if (rc != AUDIO_OK) { audio_vorbis_close(d); return rc; }
  d->start_off = d->ogg.pg.off;

  var s: AudioVorbisSetup* = &d->s;
  var ch: int32 = s->channels;
  var bs1: int64 = (int64)s->bs[1];
  if (s->max_floor < 1) { s->max_floor = 1; }
  if (s->max_parts < 1) { s->max_parts = 1; }
  var ok: bool = audio_vorbis_mdct_init(&d->mdct[0], s->bs[0]);
  ok = audio_vorbis_mdct_init(&d->mdct[1], s->bs[1]) && ok;
  d->bank = vb_alloc_f(2 * (int64)ch * bs1);
  d->out = vb_alloc_f((int64)ch * bs1 / 2);
  d->big = vb_alloc_f((int64)ch * bs1 / 2);
  d->fy = (int32*)calloc((int64)ch * (int64)s->max_floor, 4);
  d->fstep = (uint8*)calloc((int64)ch * (int64)s->max_floor, 1);
  d->fcoef = vb_alloc_f((int64)ch * (int64)s->max_floor);
  d->classes = (uint8*)calloc((int64)ch * (int64)s->max_parts, 1);
  if (!ok || d->bank == 0 || d->out == 0 || d->big == 0 || d->fy == 0 || d->fstep == 0 || d->fcoef == 0 || d->classes == 0) {
    audio_vorbis_close(d);
    return AUDIO_E_MEM;
  }
  for k in 0..2 {
    var m: int32 = s->bs[k] / 2;
    var w: float32* = vb_alloc_f((int64)m);
    if (w == 0) { audio_vorbis_close(d); return AUDIO_E_MEM; }
    for i in 0..m {
      var x: float64 = audio_sin(((float64)i + 0.5) / (float64)m * 0.5 * VB_PI);
      w[i] = (float32)audio_sin(0.5 * VB_PI * x * x);
    }
    d->win[k] = w;
  }
  for c in 0..ch { d->dst[c] = c; }
  if (ch == 3) { for c in 0..3 { d->dst[c] = VB_DST3[c]; } }
  if (ch == 5) { for c in 0..5 { d->dst[c] = VB_DST5[c]; } }
  if (ch == 6) { for c in 0..6 { d->dst[c] = VB_DST6[c]; } }
  if (ch == 7) { for c in 0..7 { d->dst[c] = VB_DST7[c]; } }
  if (ch == 8) { for c in 0..8 { d->dst[c] = VB_DST8[c]; } }

  // where the output starts: from the first page that ends a packet
  var e1: int64 = 0;
  rc = vb_scan(d, &e1);
  d->g0 = 0;
  if (rc == AUDIO_OK) { d->g0 = e1; }
  d->base = d->g0;
  if (d->base < 0) { d->base = 0; }
  d->end_g = audio_ogg_last_granule(&d->ogg);
  d->info.channels = ch;
  d->info.rate = s->rate;
  d->info.fmt = AUDIO_F32;
  d->info.bits = 0;
  d->info.mask = 0;
  d->info.frames = -1;
  if (d->end_g >= 0) {
    d->info.frames = d->end_g - d->base;
    if (d->info.frames < 0) { d->info.frames = 0; }
  }
  vb_restart(d, d->base);
  return AUDIO_OK;
}

/// Decodes the next block into out / out_frames. AUDIO_END at the end.
export fn audio_vorbis_next(d: AudioVorbis*) -> int32 {
  d->out_frames = 0;
  if (d->s.channels == 0 || d->bank == 0) { return AUDIO_E_ARG; }
  var ch: int32 = d->s.channels;
  var pk: AudioOggPacket;
  while (true) {
    if (d->done) { return AUDIO_END; }
    var rc: int32 = audio_ogg_packet(&d->ogg, &pk);
    if (rc != AUDIO_OK) {
      if (rc == AUDIO_END) { d->done = true; return AUDIO_END; }
      return rc;
    }
    if (pk.len < 1 || (pk.data[0] & 1) != 0) { continue; }
    var n: int32 = vb_packet(d, pk.data, pk.len);
    if (n < 0) { d->prev_n = 0; continue; }
    var h: int32 = n >> 1;
    if (d->prev_n == 0) {
      // the first packet only primes the overlap
      if (pk.granule != -1 && !pk.eos) { d->pos = pk.granule; }
      d->prev_n = n;
      d->cur = 1 - d->cur;
      continue;
    }
    var p: int32 = d->prev_n >> 1;
    var len: int64 = (int64)(p / 2 + h / 2);
    var st: int64 = d->pos;
    if (pk.granule != -1 && !pk.eos) { st = pk.granule - len; }
    var en: int64 = st + len;
    d->pos = en;
    if (pk.eos && pk.granule != -1 && pk.granule < en) { en = pk.granule; }
    if (d->end_g >= 0 && en > d->end_g) { en = d->end_g; }
    if (en < st) { en = st; }
    var lo: int64 = st;
    if (d->skip_g > lo) { lo = d->skip_g; }
    if (lo > en) { lo = en; }
    var i0: int32 = (int32)(lo - st);
    var i1: int32 = (int32)(en - st);
    if (i1 > i0) {
      // overlap-add of the previous block's second half and this block's first half
      var w: int32 = p;
      if (h < w) { w = h; }
      var a: int32 = p / 2 - w / 2;
      var b: int32 = h / 2 - w / 2;
      var win: float32* = d->win[1];
      if (w == d->s.bs[0] / 2) { win = d->win[0]; }
      var pb: int32 = 1 - d->cur;
      for c in 0..ch {
        var pv: float32* = vb_chan(d, pb, c) + (int64)p;
        var cv: float32* = vb_chan(d, d->cur, c);
        var o: float32* = d->out + (int64)d->dst[c];
        var oi: int64 = 0;
        // before the overlap: the previous block alone
        var e: int32 = a;
        if (e > i1) { e = i1; }
        var i: int32 = i0;
        while (i < e) {
          o[oi] = pv[i];
          oi = oi + (int64)ch;
          i = i + 1;
        }
        e = a + w;
        if (e > i1) { e = i1; }
        while (i < e) {
          var j: int32 = i - a;
          o[oi] = pv[i] * win[w - 1 - j] + cv[b + j] * win[j];
          oi = oi + (int64)ch;
          i = i + 1;
        }
        while (i < i1) {
          o[oi] = cv[b + i - a];
          oi = oi + (int64)ch;
          i = i + 1;
        }
      }
      d->out_frames = i1 - i0;
    }
    d->prev_n = n;
    d->cur = 1 - d->cur;
    if (d->out_frames > 0) { return AUDIO_OK; }
  }
  return AUDIO_END;
}

/// Moves so that the next block starts at `frame` (sample exact).
export fn audio_vorbis_seek(d: AudioVorbis*, frame: int64) -> int32 {
  if (d->s.channels == 0 || d->bank == 0) { return AUDIO_E_ARG; }
  var f: int64 = frame;
  if (f < 0) { f = 0; }
  if (d->info.frames >= 0 && f > d->info.frames) { f = d->info.frames; }
  var tg: int64 = d->base + f;
  d->out_frames = 0;
  var hi: int64 = d->ogg.n;
  while (true) {
    var q: int64 = vb_find_before(d, hi, tg);
    if (q < 0 || q <= d->start_off) {
      vb_restart(d, tg);
      return AUDIO_OK;
    }
    audio_ogg_seek_byte(&d->ogg, q);
    var e1: int64 = 0;
    var rc: int32 = vb_scan(d, &e1);
    if (rc == AUDIO_OK && e1 <= tg) {
      audio_ogg_seek_byte(&d->ogg, q);
      d->pos = e1;
      d->skip_g = tg;
      d->prev_n = 0;
      d->done = false;
      return AUDIO_OK;
    }
    hi = q;
  }
  return AUDIO_OK;
}

/// Frees everything. Safe on a zeroed or failed decoder.
export fn audio_vorbis_close(d: AudioVorbis*) {
  audio_ogg_free(&d->ogg);
  audio_vorbis_setup_free(&d->s);
  audio_vorbis_mdct_free(&d->mdct[0]);
  audio_vorbis_mdct_free(&d->mdct[1]);
  if (d->win[0] != 0) { free(d->win[0]); }
  if (d->win[1] != 0) { free(d->win[1]); }
  if (d->bank != 0) { free(d->bank); }
  if (d->out != 0) { free(d->out); }
  if (d->big != 0) { free(d->big); }
  if (d->fy != 0) { free(d->fy); }
  if (d->fstep != 0) { free(d->fstep); }
  if (d->fcoef != 0) { free(d->fcoef); }
  if (d->classes != 0) { free(d->classes); }
  memset(d, 0, sizeof(AudioVorbis));
}
