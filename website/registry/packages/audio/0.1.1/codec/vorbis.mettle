// Ogg Vorbis decoder (Vorbis I specification).
//
//   var v: AudioVorbis;
//   if (audio_vorbis_open(&v, data, size) == AUDIO_OK) {
//     while (audio_vorbis_next(&v) == AUDIO_OK) { ... v.out[0 .. v.out_frames * channels] ... }
//   }
//   audio_vorbis_close(&v);
//
// Everything in Vorbis I: codebooks with lookup types 1 and 2, floor 0 and
// floor 1, residue 0, 1 and 2, mappings with submaps and channel coupling,
// both block sizes with the window overlap-add. 1 to 8 channels.
//
// Output length follows the granule positions as the specification says:
// the first audio page's granule gives the position of the first sample
// (a smaller granule than the decoded sample count means samples to drop
// at the start), and the last page's granule trims the end. Seeking is
// sample exact: a bisection over the Ogg pages finds a page before the
// target, the granule of the next page that ends a packet fixes the
// position, and the samples before the target are decoded and dropped.
//
// Channel order: Vorbis order (specification section 4.3.9) is turned into
// WAV order (FL FR FC LFE BL BR SL SR):
//   3: L C R            -> L R C
//   5: L C R BL BR      -> L R C BL BR
//   6: L C R BL BR LFE  -> L R C LFE BL BR
//   7: L C R SL SR BC LFE       -> L R C LFE BC SL SR
//   8: L C R SL SR BL BR LFE    -> L R C LFE BL BR SL SR
//
// Fast paths come from stb_vorbis: a one-lookup Huffman table with a
// binary search for long codes, the floor 1 line drawing deferred until
// after the residue, and its fast inverse MDCT (vorbis_imdct.mettle).

import "std/mem";
import "../core/amath";
import "../core/status";
import "../core/pcm";
import "ogg";
import "vorbis_setup";
import "vorbis_imdct";

const VB_PI: float64 = 3.14159265358979323846;
const VB_FAST_MASK: uint64 = 1023;

export struct AudioVorbis {
  info: AudioInfo;
  out: float32*;          // interleaved samples of the last block
  out_frames: int32;
  ogg: AudioOgg;
  s: AudioVorbisSetup;
  mdct: AudioVorbisMdct[2];
  win: float32*[2];       // rising window slope for each block size, bs/2 values
  bank: float32*;         // two banks of channels * bs1 samples
  cur: int32;             // the bank the next packet decodes into
  prev_n: int32;          // block size of the packet before, 0 when none
  fy: int32*;             // floor 1 values, channels * max_floor
  fstep: uint8*;          // floor 1 "used" flags
  fcoef: float32*;        // floor 0 coefficients
  famp: int64[8];         // floor 0 amplitude per channel
  nonzero: bool[8];
  decode: bool[8];
  classes: uint8*;        // residue classes, channels * max_parts
  big: float32*;          // residue 2 vector, channels * bs1 / 2
  dst: int32[8];          // output slot of each Vorbis channel
  start_off: int64;       // page where the setup header ends
  g0: int64;              // granule of the first sample the decoder gives
  base: int64;            // granule of frame 0
  end_g: int64;           // granule of the end of the stream, or -1
  pos: int64;             // granule of the next packet's first sample
  skip_g: int64;          // drop samples before this granule
  done: bool;
}

// The floor 1 dB to linear table, from the Vorbis I specification.
