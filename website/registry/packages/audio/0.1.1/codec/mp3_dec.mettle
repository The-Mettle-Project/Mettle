  -2.0, 13.0, -58.0, 161.0, 224.0, 72.0, -991.0, 2001.0, 1414.0, 2330.0, -7910.0, 9592.0, 70.0, 22929.0, -51853.0, 72169.0,
  -2.0, 11.0, -63.0, 154.0, 221.0, 36.0, -1064.0, 1962.0, 1280.0, 2006.0, -8209.0, 9750.0, -998.0, 21189.0, -53534.0, 71420.0,
  -2.0, 10.0, -68.0, 147.0, 215.0, 2.0, -1137.0, 1919.0, 1131.0, 1692.0, -8491.0, 9863.0, -2122.0, 19478.0, -55178.0, 70590.0,
  -3.0, 9.0, -73.0, 139.0, 208.0, -29.0, -1210.0, 1870.0, 970.0, 1388.0, -8755.0, 9935.0, -3300.0, 17799.0, -56778.0, 69679.0,
  -3.0, 8.0, -79.0, 132.0, 200.0, -57.0, -1283.0, 1817.0, 794.0, 1095.0, -8998.0, 9966.0, -4533.0, 16155.0, -58333.0, 68692.0,
  -4.0, 7.0, -85.0, 125.0, 189.0, -83.0, -1356.0, 1759.0, 605.0, 814.0, -9219.0, 9959.0, -5818.0, 14548.0, -59838.0, 67629.0,
  -4.0, 7.0, -91.0, 117.0, 177.0, -106.0, -1428.0, 1698.0, 402.0, 545.0, -9416.0, 9916.0, -7154.0, 12980.0, -61289.0, 66494.0,
  -5.0, 6.0, -97.0, 111.0, 163.0, -127.0, -1498.0, 1634.0, 185.0, 288.0, -9585.0, 9838.0, -8540.0, 11455.0, -62684.0, 65290.0,
];

// ---- Layers I and II ----

fn mp3_l12_alloc(h: uint8*, d: AudioMp3Dec*) -> int32 {
  var mode: int32 = ((int32)h[3] >> 6) & 3;
  var stereo_bands: int32 = 32;
  if (mode == 3) { stereo_bands = 0; }
  if (mode == 1) { stereo_bands = ((((int32)h[3] >> 4) & 3) << 2) + 4; }
  var alloc: int32 = 0;
  var nbands: int32 = 32;
  if (mp3_is_layer1(h)) {
    alloc = 0;
    nbands = 32;
  } else if (!mp3_is_mpeg1(h)) {
    alloc = 3;
    nbands = 30;
  } else {
    var sr: int32 = ((int32)h[2] >> 2) & 3;
    var kbps: int32 = audio_mp3_hdr_kbps(h);
    if (mode != 3) { kbps = kbps >> 1; }
    if (kbps == 0) { kbps = 192; }   // free format
    alloc = 12;
    nbands = 27;
    if (kbps < 56) {
      alloc = 24;
      nbands = 8;
      if (sr == 2) { nbands = 12; }
    } else if (kbps >= 96 && sr != 1) {
      nbands = 30;
    }
  }
  d->l12_total = nbands;
  if (stereo_bands > nbands) { stereo_bands = nbands; }
  d->l12_stereo = stereo_bands;
  return alloc;
}

fn mp3_l12_read_scalefactors(bs: AudioMp3Bs*, d: AudioMp3Dec*, bands: int32) {
  var k: int32 = 0;
  for i in 0..bands {
    var s: float32 = MP3_C_ZERO;
    var ba: int32 = (int32)d->l12_bitalloc[i];
    var mask: int32 = 0;
    if (ba != 0) { mask = 4 + ((19 >> (int32)d->l12_scfcod[i]) & 3); }
    var m: int32 = 4;
    while (m != 0) {
      if ((mask & m) != 0) {
        var b: int32 = (int32)mp3_bits(bs, 6);
        var idx: int32 = ba * 3 - 6 + b % 3;
        if (idx < 0 || idx >= 54) { idx = 0; }
        s = MP3_DEQ_L12[idx] * (float32)((1 << 21) >> (b / 3));
      }
      d->l12_scf[k] = s;
      k = k + 1;
      m = m >> 1;
    }
  }
}

fn mp3_l12_read_scale_info(h: uint8*, bs: AudioMp3Bs*, d: AudioMp3Dec*) {
  var ai: int32 = mp3_l12_alloc(h, d);
  var k: int32 = 0;
  var ba_bits: int32 = 0;
  var tab: int32 = 0;
  var total: int32 = d->l12_total;
  var stereo: int32 = d->l12_stereo;
  for i in 0..total {
    if (i == k) {
      k = k + (int32)MP3_ALLOC[ai + 2];
      ba_bits = (int32)MP3_ALLOC[ai + 1];
      tab = (int32)MP3_ALLOC[ai];
      ai = ai + 3;
      if (ai > 27) { ai = 27; }
    }
    var ba: uint8 = MP3_BA_CODES[tab + (int32)mp3_bits(bs, ba_bits)];
    d->l12_bitalloc[2 * i] = ba;
    if (i < stereo) { ba = MP3_BA_CODES[tab + (int32)mp3_bits(bs, ba_bits)]; }
    if (stereo != 0) { d->l12_bitalloc[2 * i + 1] = ba; } else { d->l12_bitalloc[2 * i + 1] = 0; }
  }
  for i in 0..(2 * total) {
    var c: uint8 = 6;
    if (d->l12_bitalloc[i] != 0) {
      if (mp3_is_layer1(h)) { c = 2; } else { c = (uint8)mp3_bits(bs, 2); }
    }
    d->l12_scfcod[i] = c;
  }
  mp3_l12_read_scalefactors(bs, d, total * 2);
  for i in stereo..total { d->l12_bitalloc[2 * i + 1] = 0; }
}

fn mp3_l12_dequantize(grbuf: float32*, bs: AudioMp3Bs*, d: AudioMp3Dec*, group: int32) -> int32 {
  for j in 0..4 {
    var dst: float32* = grbuf + group * j;
    var choff: int32 = 576;
    for i in 0..(2 * d->l12_total) {
      var ba: int32 = (int32)d->l12_bitalloc[i];
      if (ba != 0) {
        if (ba < 17) {
          var half: int32 = (1 << (ba - 1)) - 1;
          for k in 0..group { dst[k] = (float32)((int32)mp3_bits(bs, ba) - half); }
        } else {
          var md: int32 = (2 << (ba - 17)) + 1;    // 3, 5, 9
          var code: int32 = (int32)mp3_bits(bs, md + 2 - (md >> 3));   // 5, 7, 10 bits
          for k in 0..group {
            dst[k] = (float32)(code % md - md / 2);
            code = code / md;
          }
        }
      }
      dst = dst + choff;
      choff = 18 - choff;
    }
  }
  return group * 4;
}

fn mp3_l12_apply_scf(d: AudioMp3Dec*, igr: int32, dst0: float32*) {
  var total: int32 = d->l12_total;
  var stereo: int32 = d->l12_stereo;
  if (total > stereo) {
    memcpy(dst0 + 576 + stereo * 18, dst0 + stereo * 18, (int64)(total - stereo) * 18 * 4);
  }
  var dst: float32* = dst0;
  var s: int32 = igr;
  for i in 0..total {
    var a: float32 = d->l12_scf[s];
    var b: float32 = d->l12_scf[s + 3];
    for k in 0..12 {
      dst[k] = dst[k] * a;
      dst[k + 576] = dst[k + 576] * b;
    }
    dst = dst + 18;
    s = s + 6;
  }
}

// ---- Layer III side info and scale factors ----

fn mp3_read_side_info(bs: AudioMp3Bs*, gr0: AudioMp3Gr*, h: uint8*) -> int32 {
  var scfsi: uint32 = 0;
  var main_data_begin: int32 = 0;
  var part_23_sum: int32 = 0;
  var sr_idx: int32 = mp3_my_rate(h);
  if (sr_idx != 0) { sr_idx = sr_idx - 1; }
  var gr_count: int32 = 2;
  if (mp3_is_mono(h)) { gr_count = 1; }
  var mpeg1: bool = mp3_is_mpeg1(h);
  if (mpeg1) {
    gr_count = gr_count * 2;
    main_data_begin = (int32)mp3_bits(bs, 9);
    scfsi = mp3_bits(bs, 7 + gr_count);
  } else {
    main_data_begin = (int32)(mp3_bits(bs, 8 + gr_count) >> (uint32)gr_count);
  }
  var gr: AudioMp3Gr* = gr0;
  while (gr_count > 0) {
    if (mp3_is_mono(h)) { scfsi = scfsi << 4; }
    gr->part_23_length = (int32)mp3_bits(bs, 12);
    part_23_sum = part_23_sum + gr->part_23_length;
    gr->big_values = (int32)mp3_bits(bs, 9);
    if (gr->big_values > 288) { return -1; }
    gr->global_gain = (int32)mp3_bits(bs, 8);
    if (mpeg1) { gr->scalefac_compress = (int32)mp3_bits(bs, 4); } else { gr->scalefac_compress = (int32)mp3_bits(bs, 9); }
    gr->sfbtab = &MP3_SCF_LONG[sr_idx * 23];
    gr->n_long_sfb = 22;
    gr->n_short_sfb = 0;
    var tables: uint32 = 0;
    if (mp3_bits(bs, 1) != 0) {
      gr->block_type = (int32)mp3_bits(bs, 2);
      if (gr->block_type == 0) { return -1; }
      gr->mixed_block_flag = (int32)mp3_bits(bs, 1);
      gr->region_count[0] = 7;
      gr->region_count[1] = 255;
      gr->region_count[2] = 255;
      if (gr->block_type == 2) {
        scfsi = scfsi & 0x0F0F;
        if (gr->mixed_block_flag == 0) {
          gr->region_count[0] = 8;
          gr->sfbtab = &MP3_SCF_SHORT[sr_idx * 40];
          gr->n_long_sfb = 0;
          gr->n_short_sfb = 39;
        } else {
          gr->sfbtab = &MP3_SCF_MIXED[sr_idx * 40];
          if (mpeg1) { gr->n_long_sfb = 8; } else { gr->n_long_sfb = 6; }
          gr->n_short_sfb = 30;
        }
      }
      tables = mp3_bits(bs, 10) << 5;
      gr->subblock_gain[0] = (int32)mp3_bits(bs, 3);
      gr->subblock_gain[1] = (int32)mp3_bits(bs, 3);
      gr->subblock_gain[2] = (int32)mp3_bits(bs, 3);
    } else {
      gr->block_type = 0;
      gr->mixed_block_flag = 0;
      tables = mp3_bits(bs, 15);
      gr->region_count[0] = (int32)mp3_bits(bs, 4);
      gr->region_count[1] = (int32)mp3_bits(bs, 3);
      gr->region_count[2] = 255;
      gr->subblock_gain[0] = 0;
      gr->subblock_gain[1] = 0;
      gr->subblock_gain[2] = 0;
    }
    gr->table_select[0] = (int32)(tables >> 10);
    gr->table_select[1] = (int32)((tables >> 5) & 31);
    gr->table_select[2] = (int32)(tables & 31);
    if (mpeg1) {
      gr->preflag = (int32)mp3_bits(bs, 1);
    } else {
      gr->preflag = 0;
      if (gr->scalefac_compress >= 500) { gr->preflag = 1; }
    }
    gr->scalefac_scale = (int32)mp3_bits(bs, 1);
    gr->count1_table = (int32)mp3_bits(bs, 1);
    gr->scfsi = (int32)((scfsi >> 12) & 15);
    scfsi = scfsi << 4;
    gr = gr + 1;
    gr_count = gr_count - 1;
  }
  if (part_23_sum + bs->pos > bs->limit + main_data_begin * 8) { return -1; }
  return main_data_begin;
}

fn mp3_read_scalefactors(scf0: uint8*, ist0: uint8*, scf_size: int32*, scf_count: uint8*, bs: AudioMp3Bs*, scfsi0: int32) {
  var scf: uint8* = scf0;
  var ist: uint8* = ist0;
  var scfsi: int32 = scfsi0;
  var i: int32 = 0;
  while (i < 4 && scf_count[i] != 0) {
    var cnt: int32 = (int32)scf_count[i];
    if ((scfsi & 8) != 0) {
      memcpy(scf, ist, (int64)cnt);
    } else {
      var bits: int32 = scf_size[i];
      if (bits == 0) {
        memset(scf, 0, (int64)cnt);
        memset(ist, 0, (int64)cnt);
      } else {
        var max_scf: int32 = -1;
        if (scfsi < 0) { max_scf = (1 << bits) - 1; }
        for k in 0..cnt {
          var s: int32 = (int32)mp3_bits(bs, bits);
          if (s == max_scf) { ist[k] = 255; } else { ist[k] = (uint8)s; }
          scf[k] = (uint8)s;
        }
      }
    }
    ist = ist + cnt;
    scf = scf + cnt;
    i = i + 1;
    scfsi = scfsi * 2;
  }
  scf[0] = 0;
  scf[1] = 0;
  scf[2] = 0;
}

// y * 2^(-exp_q2 / 4)
fn mp3_ldexp_q2(y0: float32, exp0: int32) -> float32 {
  var y: float32 = y0;
  var exp_q2: int32 = exp0;
  while (true) {
    var e: int32 = exp_q2;
    if (e > 120) { e = 120; }
    if (e < 0) { e = 0; }
    y = y * (MP3_EXPFRAC[e & 3] * (float32)((1 << 30) >> (e >> 2)));
    exp_q2 = exp_q2 - e;
    if (exp_q2 <= 0) { break; }
  }
  return y;
}

fn mp3_decode_scalefactors(h: uint8*, ist_pos: uint8*, bs: AudioMp3Bs*, gr: AudioMp3Gr*, scf: float32*, ch: int32) {
  var prow: int32 = 0;
  if (gr->n_short_sfb != 0) { prow = prow + 1; }
  if (gr->n_long_sfb == 0) { prow = prow + 1; }
  var part: uint8* = &MP3_SCF_PART[prow * 28];
  var scf_size: int32[4];
  var iscf: uint8[44];
  var scf_shift: int32 = gr->scalefac_scale + 1;
  var scfsi: int32 = gr->scfsi;
  if (mp3_is_mpeg1(h)) {
    var pt: int32 = (int32)MP3_SCFC[gr->scalefac_compress & 15];
    scf_size[0] = pt >> 2;
    scf_size[1] = pt >> 2;
    scf_size[2] = pt & 3;
    scf_size[3] = pt & 3;
  } else {
    var ist: int32 = 0;
    if (mp3_is_i_stereo(h) && ch != 0) { ist = 1; }
    var sfc: int32 = gr->scalefac_compress >> ist;
    var k: int32 = ist * 12;
    var modprod: int32 = 1;
    while (sfc >= 0 && k <= 20) {
      modprod = 1;
      var i: int32 = 3;
      while (i >= 0) {
        var md: int32 = (int32)MP3_MOD[k + i];
        scf_size[i] = sfc / modprod % md;
        modprod = modprod * md;
        i = i - 1;
      }
      sfc = sfc - modprod;
      k = k + 4;
    }
    part = part + k;
    scfsi = -16;
  }
  mp3_read_scalefactors(&iscf[0], ist_pos, &scf_size[0], part, bs, scfsi);
  var nl: int32 = gr->n_long_sfb;
  var ns: int32 = gr->n_short_sfb;
  if (ns != 0) {
    var sh: int32 = 3 - scf_shift;
    var i: int32 = 0;
    while (i < ns) {
      iscf[nl + i] = (uint8)((int32)iscf[nl + i] + (gr->subblock_gain[0] << sh));
      iscf[nl + i + 1] = (uint8)((int32)iscf[nl + i + 1] + (gr->subblock_gain[1] << sh));
      iscf[nl + i + 2] = (uint8)((int32)iscf[nl + i + 2] + (gr->subblock_gain[2] << sh));
      i = i + 3;
    }
  } else if (gr->preflag != 0) {
    for i in 0..10 { iscf[11 + i] = (uint8)((int32)iscf[11 + i] + (int32)MP3_PREAMP[i]); }
  }
  var gain_exp: int32 = gr->global_gain - 4 - 210;
  if (mp3_is_ms(h)) { gain_exp = gain_exp - 2; }
  var gain: float32 = mp3_ldexp_q2((float32)2048.0, 44 - gain_exp);
  for i in 0..(nl + ns) { scf[i] = mp3_ldexp_q2(gain, (int32)iscf[i] << scf_shift); }
}

@inline fn mp3_pow43(x0: int32) -> float32 {
  var x: int32 = x0;
  if (x < 129) { return MP3_POW43[16 + x]; }
  var mult: float32 = 256.0;
  if (x < 1024) {
    mult = 16.0;
    x = x << 3;
  }
  var sign: int32 = (2 * x) & 64;
  var frac: float32 = (float32)((x & 63) - sign) / (float32)((x & (~63)) + sign);
  return MP3_POW43[16 + ((x + sign) >> 6)] * (MP3_C_ONE + frac * (MP3_C_4_3 + frac * MP3_C_2_9)) * mult;
}

// ---- Layer III Huffman decoding and requantization ----

fn mp3_huffman(dst0: float32*, bs: AudioMp3Bs*, gr: AudioMp3Gr*, scf0: float32*, limit: int32) {
  var dst: float32* = dst0;
  var scf: float32* = scf0;
  var one: float32 = MP3_C_ZERO;
  var ireg: int32 = 0;
  var big_val_cnt: int32 = gr->big_values;
  var sfb: uint8* = gr->sfbtab;
  var buf: uint8* = bs->buf;
  var nx: int64 = (int64)(bs->pos >> 3);
  var cache: uint32 = ((uint32)buf[nx] << 24) | ((uint32)buf[nx + 1] << 16) | ((uint32)buf[nx + 2] << 8) | (uint32)buf[nx + 3];
  cache = cache << (uint32)(bs->pos & 7);
  var sh: int32 = (bs->pos & 7) - 8;
  nx = nx + 4;
  var np: int32 = 0;

  while (big_val_cnt > 0) {
    if (ireg > 2) { bs->pos = limit; return; }
    var tab_num: int32 = gr->table_select[ireg];
    var sfb_cnt: int32 = gr->region_count[ireg];
    ireg = ireg + 1;
    var cb: int32 = MP3_TABINDEX[tab_num];
    var linbits: int32 = MP3_LINBITS[tab_num];
    while (true) {
      np = (int32)sfb[0] / 2;
      sfb = sfb + 1;
      if (np == 0) { bs->pos = limit; return; }
      var pairs: int32 = big_val_cnt;
      if (np < pairs) { pairs = np; }
      one = scf[0];
      scf = scf + 1;
      while (pairs > 0) {
        var w: int32 = 5;
        var leaf: int32 = (int32)MP3_HUFF[cb + (int32)(cache >> 27)];
        while (leaf < 0) {
          cache = cache << (uint32)w;
          sh = sh + w;
          w = leaf & 7;
          leaf = (int32)MP3_HUFF[cb + (int32)(cache >> (uint32)(32 - w)) - (leaf >> 3)];
        }
        var len: int32 = leaf >> 8;
        cache = cache << (uint32)len;
        sh = sh + len;
        for j in 0..2 {
          var lsb: int32 = leaf & 15;
          if (lsb == 15 && linbits != 0) {
            while (sh >= 0) { cache = cache | ((uint32)buf[nx] << (uint32)sh); nx = nx + 1; sh = sh - 8; }
            lsb = lsb + (int32)(cache >> (uint32)(32 - linbits));
            cache = cache << (uint32)linbits;
            sh = sh + linbits;
            while (sh >= 0) { cache = cache | ((uint32)buf[nx] << (uint32)sh); nx = nx + 1; sh = sh - 8; }
            var v: float32 = one * mp3_pow43(lsb);
            if ((cache >> 31) != 0) { v = 0.0 - v; }
            dst[0] = v;
          } else {
            dst[0] = MP3_POW43[16 + lsb - 16 * (int32)(cache >> 31)] * one;
          }
          if (lsb != 0) {
            cache = cache << 1;
            sh = sh + 1;
          }
          dst = dst + 1;
          leaf = leaf >> 4;
        }
        while (sh >= 0) { cache = cache | ((uint32)buf[nx] << (uint32)sh); nx = nx + 1; sh = sh - 8; }
        pairs = pairs - 1;
      }
      big_val_cnt = big_val_cnt - np;
      if (big_val_cnt <= 0) { break; }
      sfb_cnt = sfb_cnt - 1;
      if (sfb_cnt < 0) { break; }
    }
  }

  // count1: quadruples of -1, 0, 1
  np = 1 - big_val_cnt;
  var t33: bool = gr->count1_table != 0;
  while (true) {
    var leaf: int32 = 0;
    if (t33) {
      leaf = (int32)MP3_TAB33[(int32)(cache >> 28)];
    } else {
      leaf = (int32)MP3_TAB32[(int32)(cache >> 28)];
      if ((leaf & 8) == 0) {
        // (a local: an index expression computes uint32 << in 64 bits)
        var c4: uint32 = cache << 4;
        var j: int32 = (leaf >> 3) + (int32)(c4 >> (uint32)(32 - (leaf & 3)));
        leaf = (int32)MP3_TAB32[j];
      }
    }
    cache = cache << (uint32)(leaf & 7);
    sh = sh + (leaf & 7);
    if ((int32)(nx * 8) - 24 + sh > limit) { break; }
    np = np - 1;
    if (np == 0) {
      np = (int32)sfb[0] / 2;
      sfb = sfb + 1;
      if (np == 0) { break; }
      one = scf[0];
      scf = scf + 1;
    }
    if ((leaf & 128) != 0) {
      if ((cache >> 31) != 0) { dst[0] = 0.0 - one; } else { dst[0] = one; }
      cache = cache << 1;
      sh = sh + 1;
    }
    if ((leaf & 64) != 0) {
      if ((cache >> 31) != 0) { dst[1] = 0.0 - one; } else { dst[1] = one; }
      cache = cache << 1;
      sh = sh + 1;
    }
    np = np - 1;
    if (np == 0) {
      np = (int32)sfb[0] / 2;
      sfb = sfb + 1;
      if (np == 0) { break; }
      one = scf[0];
      scf = scf + 1;
    }
    if ((leaf & 32) != 0) {
      if ((cache >> 31) != 0) { dst[2] = 0.0 - one; } else { dst[2] = one; }
      cache = cache << 1;
      sh = sh + 1;
    }
    if ((leaf & 16) != 0) {
      if ((cache >> 31) != 0) { dst[3] = 0.0 - one; } else { dst[3] = one; }
      cache = cache << 1;
      sh = sh + 1;
    }
    while (sh >= 0) { cache = cache | ((uint32)buf[nx] << (uint32)sh); nx = nx + 1; sh = sh - 8; }
    dst = dst + 4;
  }
  bs->pos = limit;
}

// ---- stereo ----

fn mp3_midside(left: float32*, n: int32) {
  var right: float32* = left + 576;
  for i in 0..n {
    var a: float32 = left[i];
    var b: float32 = right[i];
    left[i] = a + b;
    right[i] = a - b;
  }
}

fn mp3_intensity_band(left: float32*, n: int32, kl: float32, kr: float32) {
  for i in 0..n {
    left[i + 576] = left[i] * kr;
    left[i] = left[i] * kl;
  }
}

fn mp3_stereo_top_band(right0: float32*, sfb: uint8*, nbands: int32, max_band: int32*) {
  max_band[0] = -1;
  max_band[1] = -1;
  max_band[2] = -1;
  var right: float32* = right0;
  for i in 0..nbands {
    var w: int32 = (int32)sfb[i];
    var k: int32 = 0;
    while (k < w) {
      if (right[k] != MP3_C_ZERO || right[k + 1] != MP3_C_ZERO) {
        max_band[i % 3] = i;
        break;
      }
      k = k + 2;
    }
    right = right + w;
  }
}

fn mp3_stereo_process(left0: float32*, ist_pos: uint8*, sfb: uint8*, h: uint8*, max_band: int32*, mpeg2_sh: int32) {
  var left: float32* = left0;
  var mpeg1: bool = mp3_is_mpeg1(h);
  var max_pos: int32 = 64;
  if (mpeg1) { max_pos = 7; }
  var ms: bool = mp3_is_ms_flag(h);
  var i: int32 = 0;
  while (sfb[i] != 0) {
    var w: int32 = (int32)sfb[i];
    var ipos: int32 = (int32)ist_pos[i];
    if (i > max_band[i % 3] && ipos < max_pos) {
      var s: float32 = MP3_C_ONE;
      if (ms) { s = MP3_C_SQRT2; }
      var kl: float32 = MP3_C_ONE;
      var kr: float32 = MP3_C_ONE;
      if (mpeg1) {
        kl = MP3_PAN[2 * ipos];
        kr = MP3_PAN[2 * ipos + 1];
      } else {
        kl = MP3_C_ONE;
        kr = mp3_ldexp_q2(MP3_C_ONE, ((ipos + 1) >> 1) << mpeg2_sh);
        if ((ipos & 1) != 0) {
          kl = kr;
          kr = MP3_C_ONE;
        }
      }
      mp3_intensity_band(left, w, kl * s, kr * s);
    } else if (ms) {
      mp3_midside(left, w);
    }
    left = left + w;
    i = i + 1;
  }
}

fn mp3_intensity_stereo(left: float32*, ist_pos: uint8*, gr: AudioMp3Gr*, h: uint8*) {
  var max_band: int32[3];
  var n_sfb: int32 = gr->n_long_sfb + gr->n_short_sfb;
  var max_blocks: int32 = 1;
  if (gr->n_short_sfb != 0) { max_blocks = 3; }
  mp3_stereo_top_band(left + 576, gr->sfbtab, n_sfb, &max_band[0]);
  if (gr->n_long_sfb != 0) {
    var m: int32 = max_band[0];
    if (max_band[1] > m) { m = max_band[1]; }
    if (max_band[2] > m) { m = max_band[2]; }
    max_band[0] = m;
    max_band[1] = m;
    max_band[2] = m;
  }
  var default_pos: uint8 = 0;
  if (mp3_is_mpeg1(h)) { default_pos = 3; }
  for i in 0..max_blocks {
    var itop: int32 = n_sfb - max_blocks + i;
    var prev: int32 = itop - max_blocks;
    if (max_band[i] >= prev) { ist_pos[itop] = default_pos; } else { ist_pos[itop] = ist_pos[prev]; }
  }
  mp3_stereo_process(left, ist_pos, gr->sfbtab, h, &max_band[0], (gr + 1)->scalefac_compress & 1);
}

// ---- reorder, alias reduction, IMDCT ----

fn mp3_reorder(grbuf: float32*, scratch: float32*, sfb0: uint8*) {
  var sfb: uint8* = sfb0;
  var src: float32* = grbuf;
  var dst: float32* = scratch;
  var n: int64 = 0;
  while (sfb[0] != 0) {
    var len: int32 = (int32)sfb[0];
    for i in 0..len {
      dst[0] = src[0];
      dst[1] = src[len];
      dst[2] = src[2 * len];
      dst = dst + 3;
      src = src + 1;
    }
    n = n + 3 * (int64)len;
    sfb = sfb + 3;
    src = src + 2 * len;
  }
  memcpy(grbuf, scratch, n * 4);
}

fn mp3_antialias(grbuf0: float32*, nbands0: int32) {
  var grbuf: float32* = grbuf0;
  var nbands: int32 = nbands0;
  while (nbands > 0) {
    for i in 0..8 {
      var u: float32 = grbuf[18 + i];
      var dd: float32 = grbuf[17 - i];
      grbuf[18 + i] = u * MP3_AA[i] - dd * MP3_AA[8 + i];
      grbuf[17 - i] = u * MP3_AA[8 + i] + dd * MP3_AA[i];
    }
    nbands = nbands - 1;
    grbuf = grbuf + 18;
  }
}

fn mp3_dct3_9(y: float32*) {
  var s0: float32 = y[0];
  var s2: float32 = y[2];
  var s4: float32 = y[4];
  var s6: float32 = y[6];
  var s8: float32 = y[8];
  var t0: float32 = s0 + s6 * MP3_C_HALF;
  s0 = s0 - s6;
  var t4: float32 = (s4 + s2) * MP3_C_D1;
  var t2: float32 = (s8 + s2) * MP3_C_D2;
  s6 = (s4 - s8) * MP3_C_D3;
  s4 = s4 + (s8 - s2);

  s2 = s0 - s4 * MP3_C_HALF;
  y[4] = s4 + s0;
  s8 = t0 - t2 + s6;
  s0 = t0 - t4 + t2;
  s4 = t0 + t4 - s6;

  var s1: float32 = y[1];
  var s3: float32 = y[3];
  var s5: float32 = y[5];
  var s7: float32 = y[7];

  s3 = s3 * MP3_C_S3;
  t0 = (s5 + s1) * MP3_C_D4;
  t4 = (s5 - s7) * MP3_C_D5;
  t2 = (s1 + s7) * MP3_C_D6;
  s1 = (s1 - s5 - s7) * MP3_C_S3;

  s5 = t0 - s3 - t2;
  s7 = t4 - s3 - t0;
  s3 = t4 + s3 - t2;

  y[0] = s4 - s7;
  y[1] = s2 + s1;
  y[2] = s0 - s3;
  y[3] = s8 + s5;
  y[5] = s8 - s5;
  y[6] = s0 + s3;
  y[7] = s2 - s1;
  y[8] = s4 + s7;
}

fn mp3_imdct36(grbuf0: float32*, overlap0: float32*, window: float32*, nbands: int32) {
  var grbuf: float32* = grbuf0;
  var overlap: float32* = overlap0;
  var co: float32[9];
  var si: float32[9];
  for j in 0..nbands {
    co[0] = 0.0 - grbuf[0];
    si[0] = grbuf[17];
    for i in 0..4 {
      si[8 - 2 * i] = grbuf[4 * i + 1] - grbuf[4 * i + 2];
      co[1 + 2 * i] = grbuf[4 * i + 1] + grbuf[4 * i + 2];
      si[7 - 2 * i] = grbuf[4 * i + 4] - grbuf[4 * i + 3];
      co[2 + 2 * i] = 0.0 - (grbuf[4 * i + 3] + grbuf[4 * i + 4]);
    }
    mp3_dct3_9(&co[0]);
    mp3_dct3_9(&si[0]);
    si[1] = 0.0 - si[1];
    si[3] = 0.0 - si[3];
    si[5] = 0.0 - si[5];
    si[7] = 0.0 - si[7];
    for i in 0..9 {
      var ovl: float32 = overlap[i];
      var sum: float32 = co[i] * MP3_TWID9[9 + i] + si[i] * MP3_TWID9[i];
      overlap[i] = co[i] * MP3_TWID9[i] - si[i] * MP3_TWID9[9 + i];
      grbuf[i] = ovl * window[i] - sum * window[9 + i];
      grbuf[17 - i] = ovl * window[9 + i] + sum * window[i];
    }
    grbuf = grbuf + 18;
    overlap = overlap + 9;
  }
}

fn mp3_idct3(x0: float32, x1: float32, x2: float32, dst: float32*) {
  var m1: float32 = x1 * MP3_C_S3;
  var a1: float32 = x0 - x2 * MP3_C_HALF;
  dst[1] = x0 + x2;
  dst[0] = a1 + m1;
  dst[2] = a1 - m1;
}

fn mp3_imdct12(x: float32*, dst: float32*, overlap: float32*) {
  var co: float32[3];
  var si: float32[3];
  mp3_idct3(0.0 - x[0], x[6] + x[3], x[12] + x[9], &co[0]);
  mp3_idct3(x[15], x[12] - x[9], x[6] - x[3], &si[0]);
  si[1] = 0.0 - si[1];
  for i in 0..3 {
    var ovl: float32 = overlap[i];
    var sum: float32 = co[i] * MP3_TWID3[3 + i] + si[i] * MP3_TWID3[i];
    overlap[i] = co[i] * MP3_TWID3[i] - si[i] * MP3_TWID3[3 + i];
    dst[i] = ovl * MP3_TWID3[2 - i] - sum * MP3_TWID3[5 - i];
    dst[5 - i] = ovl * MP3_TWID3[5 - i] + sum * MP3_TWID3[2 - i];
  }
}

fn mp3_imdct_short(grbuf0: float32*, overlap0: float32*, nbands: int32) {
  var grbuf: float32* = grbuf0;
  var overlap: float32* = overlap0;
  var tmp: float32[18];
  for b in 0..nbands {
    for i in 0..18 { tmp[i] = grbuf[i]; }
    for i in 0..6 { grbuf[i] = overlap[i]; }
    mp3_imdct12(&tmp[0], grbuf + 6, overlap + 6);
    mp3_imdct12(&tmp[1], grbuf + 12, overlap + 6);
    mp3_imdct12(&tmp[2], overlap, overlap + 6);
    overlap = overlap + 9;
    grbuf = grbuf + 18;
  }
}

fn mp3_change_sign(grbuf0: float32*) {
  var g: float32* = grbuf0 + 18;
  for b in 0..16 {
    var i: int32 = 1;
    while (i < 18) {
      g[i] = 0.0 - g[i];
      i = i + 2;
    }
    g = g + 36;
  }
}

fn mp3_imdct_gr(grbuf0: float32*, overlap0: float32*, block_type: int32, n_long: int32) {
  var grbuf: float32* = grbuf0;
  var overlap: float32* = overlap0;
  if (n_long > 0) {
    mp3_imdct36(grbuf, overlap, &MP3_MDCT_WIN[0], n_long);
    grbuf = grbuf + 18 * n_long;
    overlap = overlap + 9 * n_long;
  }
  if (block_type == 2) {
    mp3_imdct_short(grbuf, overlap, 32 - n_long);
  } else if (block_type == 3) {
    mp3_imdct36(grbuf, overlap, &MP3_MDCT_WIN[18], 32 - n_long);
  } else {
    mp3_imdct36(grbuf, overlap, &MP3_MDCT_WIN[0], 32 - n_long);
  }
}

// ---- bit reservoir ----

fn mp3_save_reservoir(d: AudioMp3Dec*) {
  var pos: int32 = (d->bs.pos + 7) / 8;
  var remains: int32 = d->bs.limit / 8 - pos;
  if (remains > MP3_MAX_RESERV) {
    pos = pos + remains - MP3_MAX_RESERV;
    remains = MP3_MAX_RESERV;
  }
  if (remains > 0 && pos >= 0) {
    memmove(&d->reserv_buf[0], &d->maindata[pos], (int64)remains);
    d->reserv = remains;
  } else {
    d->reserv = 0;
  }
}

fn mp3_restore_reservoir(d: AudioMp3Dec*, bs: AudioMp3Bs*, main_data_begin: int32) -> bool {
  var frame_bytes: int32 = (bs->limit - bs->pos) / 8;
  var have: int32 = d->reserv;
  if (main_data_begin < have) { have = main_data_begin; }
  var from: int32 = d->reserv - main_data_begin;
  if (from < 0) { from = 0; }
  if (have > 0) { memcpy(&d->maindata[0], &d->reserv_buf[from], (int64)have); }
  if (frame_bytes > 0) { memcpy(&d->maindata[have], bs->buf + (int64)(bs->pos / 8), (int64)frame_bytes); }
  mp3_bs_init(&d->bs, &d->maindata[0], have + frame_bytes);
  return d->reserv >= main_data_begin;
}

fn mp3_l3_decode(d: AudioMp3Dec*, gr_info: AudioMp3Gr*, nch: int32) {
  var h: uint8* = &d->header[0];
  for ch in 0..nch {
    var limit: int32 = d->bs.pos + (gr_info + ch)->part_23_length;
    mp3_decode_scalefactors(h, &d->ist_pos[ch * 39], &d->bs, gr_info + ch, &d->scf[0], ch);
    mp3_huffman(&d->grbuf[ch * 576], &d->bs, gr_info + ch, &d->scf[0], limit);
  }
  if (nch == 2) {
    if (mp3_is_i_stereo(h)) {
      mp3_intensity_stereo(&d->grbuf[0], &d->ist_pos[39], gr_info, h);
    } else if (mp3_is_ms(h)) {
      mp3_midside(&d->grbuf[0], 576);
    }
  }
  for ch in 0..nch {
    var gr: AudioMp3Gr* = gr_info + ch;
    var g: float32* = &d->grbuf[ch * 576];
    var aa_bands: int32 = 31;
    var n_long_bands: int32 = 0;
    if (gr->mixed_block_flag != 0) {
      n_long_bands = 2;
      if (mp3_my_rate(h) == 2) { n_long_bands = 4; }
    }
    if (gr->n_short_sfb != 0) {
      aa_bands = n_long_bands - 1;
      mp3_reorder(g + n_long_bands * 18, &d->syn[0], gr->sfbtab + gr->n_long_sfb);
    }
    mp3_antialias(g, aa_bands);
    mp3_imdct_gr(g, &d->mdct_overlap[ch * 288], gr->block_type, n_long_bands);
    mp3_change_sign(g);
  }
}

// ---- polyphase synthesis ----

fn mp3_dct2(grbuf: float32*, n: int32) {
  var t: float32[32];
  for k in 0..n {
    var y: float32* = grbuf + k;
    for i in 0..8 {
      var x0: float32 = y[i * 18];
      var x1: float32 = y[(15 - i) * 18];
      var x2: float32 = y[(16 + i) * 18];
      var x3: float32 = y[(31 - i) * 18];
      var t0: float32 = x0 + x3;
      var t1: float32 = x1 + x2;
      var t2: float32 = (x1 - x2) * MP3_SEC[3 * i];
      var t3: float32 = (x0 - x3) * MP3_SEC[3 * i + 1];
      t[i] = t0 + t1;
      t[8 + i] = (t0 - t1) * MP3_SEC[3 * i + 2];
      t[16 + i] = t3 + t2;
      t[24 + i] = (t3 - t2) * MP3_SEC[3 * i + 2];
    }
    for q in 0..4 {
      var x: float32* = &t[q * 8];
      var x0: float32 = x[0];
      var x1: float32 = x[1];
      var x2: float32 = x[2];
      var x3: float32 = x[3];
      var x4: float32 = x[4];
      var x5: float32 = x[5];
      var x6: float32 = x[6];
      var x7: float32 = x[7];
      var xt: float32 = x0 - x7;
      x0 = x0 + x7;
      x7 = x1 - x6;
      x1 = x1 + x6;
      x6 = x2 - x5;
      x2 = x2 + x5;
      x5 = x3 - x4;
      x3 = x3 + x4;
      x4 = x0 - x3;
      x0 = x0 + x3;
      x3 = x1 - x2;
      x1 = x1 + x2;
      x[0] = x0 + x1;
      x[4] = (x0 - x1) * MP3_C_R2;
      x5 = x5 + x6;
      x6 = (x6 + x7) * MP3_C_R2;
      x7 = x7 + xt;
      x3 = (x3 + x4) * MP3_C_R2;
      x5 = x5 - x7 * MP3_C_P8A;   // rotate by pi/8
      x7 = x7 + x5 * MP3_C_P8B;
      x5 = x5 - x7 * MP3_C_P8A;
      x0 = xt - x6;
      xt = xt + x6;
      x[1] = (xt + x7) * MP3_C_K1;
      x[2] = (x4 + x3) * MP3_C_K2;
      x[3] = (x0 - x5) * MP3_C_K3;
      x[5] = (x0 + x5) * MP3_C_K5;
      x[6] = (x4 - x3) * MP3_C_K6;
      x[7] = (xt - x7) * MP3_C_K7;
    }
    for i in 0..7 {
      y[0] = t[i];
      y[18] = t[16 + i] + t[24 + i] + t[24 + i + 1];
      y[36] = t[8 + i] + t[8 + i + 1];
      y[54] = t[16 + i + 1] + t[24 + i] + t[24 + i + 1];
      y = y + 72;
    }
    y[0] = t[7];
    y[18] = t[23] + t[31];
    y[36] = t[15];
    y[54] = t[31];
  }
}

fn mp3_synth_pair(pcm: float32*, nch: int32, z0: float32*) {
  var z: float32* = z0;
  var a: float32 = (z[896] - z[0]) * MP3_C_Z29;
  a = a + (z[64] + z[832]) * MP3_C_Z213;
  a = a + (z[768] - z[128]) * MP3_C_Z459;
  a = a + (z[192] + z[704]) * MP3_C_Z2037;
  a = a + (z[640] - z[256]) * MP3_C_Z5153;
  a = a + (z[320] + z[576]) * MP3_C_Z6574;
  a = a + (z[512] - z[384]) * MP3_C_Z37489;
  a = a + z[448] * MP3_C_Z75038;
  pcm[0] = a * MP3_C_SCALE;
  z = z + 2;
  a = z[896] * MP3_C_Z104;
  a = a + z[768] * MP3_C_Z1567;
  a = a + z[640] * MP3_C_Z9727;
  a = a + z[512] * MP3_C_Z64019;
  a = a + z[384] * MP3_C_Z9975;
  a = a + z[256] * MP3_C_Z45;
  a = a + z[128] * MP3_C_Z146;
  a = a + z[0] * MP3_C_Z5;
  pcm[16 * nch] = a * MP3_C_SCALE;
}

fn mp3_synth(xl: float32*, dstl: float32*, nch: int32, lins: float32*) {
  var xr: float32* = xl + 576 * (nch - 1);
  var dstr: float32* = dstl + (nch - 1);
  var zlin: float32* = lins + 960;
  var w: int32 = 0;

  zlin[60] = xl[288];
  zlin[61] = xr[288];
  zlin[62] = xl[0];
  zlin[63] = xr[0];
  zlin[124] = xl[289];
  zlin[125] = xr[289];
  zlin[126] = xl[1];
  zlin[127] = xr[1];

  mp3_synth_pair(dstr, nch, lins + 61);
  mp3_synth_pair(dstr + 32 * nch, nch, lins + 125);
  mp3_synth_pair(dstl, nch, lins + 60);
  mp3_synth_pair(dstl + 32 * nch, nch, lins + 124);

  var i: int32 = 14;
  while (i >= 0) {
    zlin[4 * i] = xl[18 * (31 - i)];
    zlin[4 * i + 1] = xr[18 * (31 - i)];
    zlin[4 * i + 2] = xl[1 + 18 * (31 - i)];
    zlin[4 * i + 3] = xr[1 + 18 * (31 - i)];
    zlin[4 * (i + 16)] = xl[1 + 18 * (1 + i)];
    zlin[4 * (i + 16) + 1] = xr[1 + 18 * (1 + i)];
    zlin[4 * (i - 16) + 2] = xl[18 * (1 + i)];
    zlin[4 * (i - 16) + 3] = xr[18 * (1 + i)];

    var a0: float32 = MP3_C_ZERO;
    var a1: float32 = MP3_C_ZERO;
    var a2: float32 = MP3_C_ZERO;
    var a3: float32 = MP3_C_ZERO;
    var b0: float32 = MP3_C_ZERO;
    var b1: float32 = MP3_C_ZERO;
    var b2: float32 = MP3_C_ZERO;
    var b3: float32 = MP3_C_ZERO;
    @unroll(8) for k in 0..8 {
      var w0: float32 = MP3_WIN[w];
      var w1: float32 = MP3_WIN[w + 1];
      w = w + 2;
      var vz: float32* = zlin + (4 * i - k * 64);
      var vy: float32* = zlin + (4 * i - (15 - k) * 64);
      b0 = b0 + (vz[0] * w1 + vy[0] * w0);
      b1 = b1 + (vz[1] * w1 + vy[1] * w0);
      b2 = b2 + (vz[2] * w1 + vy[2] * w0);
      b3 = b3 + (vz[3] * w1 + vy[3] * w0);
      if ((k & 1) == 0) {
        a0 = a0 + (vz[0] * w0 - vy[0] * w1);
        a1 = a1 + (vz[1] * w0 - vy[1] * w1);
        a2 = a2 + (vz[2] * w0 - vy[2] * w1);
        a3 = a3 + (vz[3] * w0 - vy[3] * w1);
      } else {
        a0 = a0 + (vy[0] * w1 - vz[0] * w0);
        a1 = a1 + (vy[1] * w1 - vz[1] * w0);
        a2 = a2 + (vy[2] * w1 - vz[2] * w0);
        a3 = a3 + (vy[3] * w1 - vz[3] * w0);
      }
    }
    dstr[(15 - i) * nch] = a1 * MP3_C_SCALE;
    dstr[(17 + i) * nch] = b1 * MP3_C_SCALE;
    dstl[(15 - i) * nch] = a0 * MP3_C_SCALE;
    dstl[(17 + i) * nch] = b0 * MP3_C_SCALE;
    dstr[(47 - i) * nch] = a3 * MP3_C_SCALE;
    dstr[(49 + i) * nch] = b3 * MP3_C_SCALE;
    dstl[(47 - i) * nch] = a2 * MP3_C_SCALE;
    dstl[(49 + i) * nch] = b2 * MP3_C_SCALE;
    i = i - 1;
  }
}

fn mp3_synth_granule(d: AudioMp3Dec*, nbands: int32, nch: int32, pcm: float32*) {
  var grbuf: float32* = &d->grbuf[0];
  var lins: float32* = &d->syn[0];
  for c in 0..nch { mp3_dct2(grbuf + 576 * c, nbands); }
  memcpy(lins, &d->qmf_state[0], 960 * 4);
  var i: int32 = 0;
  while (i < nbands) {
    mp3_synth(grbuf + i, pcm + 32 * nch * i, nch, lins + i * 64);
    i = i + 2;
  }
  if (nch == 1) {
    var k: int32 = 0;
    while (k < 960) {
      d->qmf_state[k] = lins[nbands * 64 + k];
      k = k + 2;
    }
  } else {
    memcpy(&d->qmf_state[0], lins + nbands * 64, 960 * 4);
  }
}

// ---- frames ----

/// Decodes one frame: `frame` holds `size` bytes starting with the
/// header. Writes samples-per-frame x channels interleaved floats to pcm
/// (room for AUDIO_MP3_MAX_SAMPLES) and returns the samples per channel,
/// or 0 when the frame gives no sound (bad data, or its bit reservoir is
/// missing after a seek). On 0, pcm may hold partial output.
export fn audio_mp3_dec_frame(d: AudioMp3Dec*, frame: uint8*, size: int32, pcm0: float32*) -> int32 {
  if (size < 4 || !audio_mp3_hdr_valid(frame)) { return 0; }
  for i in 0..4 { d->header[i] = frame[i]; }
  // mode extension means something only in joint stereo
  if ((((int32)frame[3] >> 6) & 3) != 1) { d->header[3] = (uint8)((int32)frame[3] & 0xCF); }
  var h: uint8* = &d->header[0];
  var nch: int32 = audio_mp3_hdr_channels(h);
  var layer: int32 = audio_mp3_hdr_layer(h);
  var pcm: float32* = pcm0;
  var bsf: AudioMp3Bs;
  mp3_bs_init(&bsf, frame + 4, size - 4);
  if (mp3_is_crc(h)) { mp3_bits(&bsf, 16); }

  if (layer == 3) {
    var mdb: int32 = mp3_read_side_info(&bsf, &d->gr_info[0], h);
    if (mdb < 0 || bsf.pos > bsf.limit) {
      d->reserv = 0;
      return 0;
    }
    if ((bsf.limit - bsf.pos) / 8 > AUDIO_MP3_MAX_FREE_FRAME) {
      d->reserv = 0;
      return 0;
    }
    var ok: bool = mp3_restore_reservoir(d, &bsf, mdb);
    if (ok) {
      var ngr: int32 = 1;
      if (mp3_is_mpeg1(h)) { ngr = 2; }
      for igr in 0..ngr {
        memset(&d->grbuf[0], 0, 1152 * 4);
        mp3_l3_decode(d, &d->gr_info[igr * nch], nch);
        mp3_synth_granule(d, 18, nch, pcm);
        pcm = pcm + 576 * nch;
      }
    }
    mp3_save_reservoir(d);
    if (!ok) { return 0; }
    return audio_mp3_hdr_samples(h);
  }

  // Layers I and II
  mp3_l12_read_scale_info(h, &bsf, d);
  memset(&d->grbuf[0], 0, 1152 * 4);
  var i: int32 = 0;
  for igr in 0..3 {
    i = i + mp3_l12_dequantize(&d->grbuf[i], &bsf, d, layer | 1);
    if (i == 12) {
      i = 0;
      mp3_l12_apply_scf(d, igr, &d->grbuf[0]);
      mp3_synth_granule(d, 12, nch, pcm);
      memset(&d->grbuf[0], 0, 1152 * 4);
      pcm = pcm + 384 * nch;
    }
    if (bsf.pos > bsf.limit) { return 0; }
  }
  return audio_mp3_hdr_samples(h);
}
