// MPEG audio frames: Layer III of MPEG-1 (ISO/IEC 11172-3), MPEG-2 LSF
// (ISO/IEC 13818-3) and MPEG-2.5, plus Layers I and II.
//
// This is the frame layer. It turns one frame (header included) into
// float samples; codec/mp3 finds the frames, reads the tags, trims and
// seeks. The structure and the float paths are a port of minimp3 by
// lieff (public domain, CC0): its packed Huffman tables and decoder,
// requantization with the 4/3 power table, reorder, alias reduction, the
// IMDCT-36/12 built on 9 and 3 point DCTs, and the polyphase synthesis
// with its fast 32 point DCT-II.
//
//   var d: AudioMp3Dec*  (zeroed, from calloc)
//   var n: int32 = audio_mp3_dec_frame(d, frame, size, pcm);   // 0 = no sound
//
// Samples come out interleaved (L R for stereo), float, -1.0 to 1.0.

import "std/mem";

// ---- limits ----

export const AUDIO_MP3_MAX_SAMPLES: int32 = 2304;      // 1152 frames of 2 channels
export const AUDIO_MP3_MAX_FREE_FRAME: int32 = 2304;   // biggest free-format frame
const MP3_MAX_RESERV: int32 = 511;
// main data: reservoir + one frame, plus room for the Huffman reader to
// run past the end of a broken granule without leaving the array
const MP3_MAINDATA: int32 = 4864;

export struct AudioMp3Bs {
  buf: uint8*;
  pos: int32;     // bits
  limit: int32;   // bits
}

// Side information of one granule of one channel.
export struct AudioMp3Gr {
  sfbtab: uint8*;           // band widths, 0 at the end
  part_23_length: int32;
  big_values: int32;
  scalefac_compress: int32;
  global_gain: int32;
  block_type: int32;
  mixed_block_flag: int32;
  n_long_sfb: int32;
  n_short_sfb: int32;
  table_select: int32[3];
  region_count: int32[3];
  subblock_gain: int32[3];
  preflag: int32;
  scalefac_scale: int32;
  count1_table: int32;
  scfsi: int32;
}

export struct AudioMp3Dec {
  mdct_overlap: float32[576];   // 2 channels x 288
  qmf_state: float32[960];
  reserv: int32;
  header: uint8[4];
  reserv_buf: uint8[512];
  // scratch, kept here so a frame allocates nothing
  bs: AudioMp3Bs;
  maindata: uint8[4864];
  gr_info: AudioMp3Gr[4];
  grbuf: float32[1152];         // 2 channels x 576
  scf: float32[40];
  syn: float32[2112];           // (18 + 15) x 64
  ist_pos: uint8[78];           // 2 channels x 39
  // Layers I and II
  l12_scf: float32[192];
  l12_total: int32;
  l12_stereo: int32;
  l12_bitalloc: uint8[64];
  l12_scfcod: uint8[64];
}

/// Clears the decoder state (filter memories and the bit reservoir).
export fn audio_mp3_dec_reset(d: AudioMp3Dec*) {
  memset(d, 0, sizeof(AudioMp3Dec));
}

// ---- headers ----

const MP3_HALFRATE: uint8[90] = [
  0, 4, 8, 12, 16, 20, 24, 28, 32, 40, 48, 56, 64, 72, 80,
  0, 4, 8, 12, 16, 20, 24, 28, 32, 40, 48, 56, 64, 72, 80,
  0, 16, 24, 28, 32, 40, 48, 56, 64, 72, 80, 88, 96, 112, 128,
  0, 16, 20, 24, 28, 32, 40, 48, 56, 64, 80, 96, 112, 128, 160,
  0, 16, 24, 28, 32, 40, 48, 56, 64, 80, 96, 112, 128, 160, 192,
  0, 16, 32, 48, 64, 80, 96, 112, 128, 144, 160, 176, 192, 208, 224
];
const MP3_HZ: int32[3] = [44100, 48000, 32000];

@inline fn mp3_is_mono(h: uint8*) -> bool { return ((int32)h[3] & 0xC0) == 0xC0; }
@inline fn mp3_is_ms(h: uint8*) -> bool { return ((int32)h[3] & 0xE0) == 0x60; }
@inline fn mp3_is_i_stereo(h: uint8*) -> bool { return ((int32)h[3] & 0x10) != 0; }
@inline fn mp3_is_ms_flag(h: uint8*) -> bool { return ((int32)h[3] & 0x20) != 0; }
@inline fn mp3_is_mpeg1(h: uint8*) -> bool { return ((int32)h[1] & 0x08) != 0; }
@inline fn mp3_not_mpeg25(h: uint8*) -> bool { return ((int32)h[1] & 0x10) != 0; }
@inline fn mp3_is_crc(h: uint8*) -> bool { return ((int32)h[1] & 1) == 0; }
@inline fn mp3_layer_bits(h: uint8*) -> int32 { return ((int32)h[1] >> 1) & 3; }
@inline fn mp3_is_layer1(h: uint8*) -> bool { return ((int32)h[1] & 6) == 6; }
@inline fn mp3_is_free(h: uint8*) -> bool { return ((int32)h[2] & 0xF0) == 0; }

// The sample rate index over all versions: 0..2 MPEG-2.5, 3..5 MPEG-2, 6..8 MPEG-1.
@inline fn mp3_my_rate(h: uint8*) -> int32 {
  return (((int32)h[2] >> 2) & 3) + ((((int32)h[1] >> 3) & 1) + (((int32)h[1] >> 4) & 1)) * 3;
}

/// True when the 4 bytes at h can start a frame.
export fn audio_mp3_hdr_valid(h: uint8*) -> bool {
  if (h[0] != 0xFF) { return false; }
  var b1: int32 = (int32)h[1];
  if (!((b1 & 0xF0) == 0xF0 || (b1 & 0xFE) == 0xE2)) { return false; }
  if (((b1 >> 1) & 3) == 0) { return false; }
  if (((int32)h[2] >> 4) == 15) { return false; }
  if ((((int32)h[2] >> 2) & 3) == 3) { return false; }
  return true;
}

/// True when h2 is a valid header of the same stream layout as h1
/// (version, layer, sample rate and free format all match).
export fn audio_mp3_hdr_compare(h1: uint8*, h2: uint8*) -> bool {
  if (!audio_mp3_hdr_valid(h2)) { return false; }
  if ((((int32)h1[1] ^ (int32)h2[1]) & 0xFE) != 0) { return false; }
  if ((((int32)h1[2] ^ (int32)h2[2]) & 0x0C) != 0) { return false; }
  return mp3_is_free(h1) == mp3_is_free(h2);
}

export fn audio_mp3_hdr_kbps(h: uint8*) -> int32 {
  var v: int32 = 0;
  if (mp3_is_mpeg1(h)) { v = 1; }
  var lay: int32 = mp3_layer_bits(h);
  if (lay == 0) { return 0; }
  return 2 * (int32)MP3_HALFRATE[(v * 3 + lay - 1) * 15 + ((int32)h[2] >> 4) % 15];
}

export fn audio_mp3_hdr_rate(h: uint8*) -> int32 {
  var sr: int32 = ((int32)h[2] >> 2) & 3;
  if (sr == 3) { return 0; }
  var hz: int32 = MP3_HZ[sr];
  if (!mp3_is_mpeg1(h)) { hz = hz >> 1; }
  if (!mp3_not_mpeg25(h)) { hz = hz >> 1; }
  return hz;
}

/// Samples per channel in one frame: 384, 576 or 1152.
export fn audio_mp3_hdr_samples(h: uint8*) -> int32 {
  if (mp3_is_layer1(h)) { return 384; }
  if (((int32)h[1] & 14) == 2) { return 576; }
  return 1152;
}

export fn audio_mp3_hdr_channels(h: uint8*) -> int32 {
  if (mp3_is_mono(h)) { return 1; }
  return 2;
}

/// 4 - layer bits: 1, 2 or 3.
export fn audio_mp3_hdr_layer(h: uint8*) -> int32 { return 4 - mp3_layer_bits(h); }

/// Frame size without padding; free_bytes for a free-format frame.
export fn audio_mp3_hdr_frame_bytes(h: uint8*, free_bytes: int32) -> int32 {
  var rate: int32 = audio_mp3_hdr_rate(h);
  if (rate <= 0) { return 0; }
  var fb: int32 = audio_mp3_hdr_samples(h) * audio_mp3_hdr_kbps(h) * 125 / rate;
  if (mp3_is_layer1(h)) { fb = fb & (~3); }
  if (fb == 0) { return free_bytes; }
  return fb;
}

export fn audio_mp3_hdr_padding(h: uint8*) -> int32 {
  if (((int32)h[2] & 2) == 0) { return 0; }
  if (mp3_is_layer1(h)) { return 4; }
  return 1;
}

/// Bytes of Layer III side information (and CRC) after the 4 header bytes.
export fn audio_mp3_hdr_side_bytes(h: uint8*) -> int32 {
  var s: int32 = 0;
  if (mp3_is_mpeg1(h)) {
    s = 32;
    if (mp3_is_mono(h)) { s = 17; }
  } else {
    s = 17;
    if (mp3_is_mono(h)) { s = 9; }
  }
  if (mp3_is_crc(h)) { s = s + 2; }
  return s;
}

// ---- bit reader (minimp3's: reads past the limit give 0) ----

@inline fn mp3_bs_init(bs: AudioMp3Bs*, p: uint8*, bytes: int32) {
  bs->buf = p;
  bs->pos = 0;
  bs->limit = bytes * 8;
}

fn mp3_bits(bs: AudioMp3Bs*, n: int32) -> uint32 {
  if (n <= 0) { return 0; }
  var s: int32 = bs->pos & 7;
  var shl: int32 = n + s;
  var p: uint8* = bs->buf + (int64)(bs->pos >> 3);
  bs->pos = bs->pos + n;
  if (bs->pos > bs->limit) { return 0; }
  var next: uint32 = (uint32)p[0] & ((uint32)255 >> s);
  var cache: uint32 = 0;
  var i: int64 = 1;
  shl = shl - 8;
  while (shl > 0) {
    cache = cache | (next << shl);
    next = (uint32)p[i];
    i = i + 1;
    shl = shl - 8;
  }
  return cache | (next >> (0 - shl));
}

