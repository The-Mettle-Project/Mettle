// MD5 (RFC 1321). FLAC stores the MD5 of its decoded samples, so a
// decoder can check its own output and an encoder can write it.

import "std/mem";

export struct AudioMd5 {
  h: uint32[4];
  buf: uint8[64];
  nbuf: int32;
  total: uint64;
}

const MD5_K: uint32[64] = [
  0xd76aa478, 0xe8c7b756, 0x242070db, 0xc1bdceee, 0xf57c0faf, 0x4787c62a, 0xa8304613, 0xfd469501,
  0x698098d8, 0x8b44f7af, 0xffff5bb1, 0x895cd7be, 0x6b901122, 0xfd987193, 0xa679438e, 0x49b40821,
  0xf61e2562, 0xc040b340, 0x265e5a51, 0xe9b6c7aa, 0xd62f105d, 0x02441453, 0xd8a1e681, 0xe7d3fbc8,
  0x21e1cde6, 0xc33707d6, 0xf4d50d87, 0x455a14ed, 0xa9e3e905, 0xfcefa3f8, 0x676f02d9, 0x8d2a4c8a,
  0xfffa3942, 0x8771f681, 0x6d9d6122, 0xfde5380c, 0xa4beea44, 0x4bdecfa9, 0xf6bb4b60, 0xbebfbc70,
  0x289b7ec6, 0xeaa127fa, 0xd4ef3085, 0x04881d05, 0xd9d4d039, 0xe6db99e5, 0x1fa27cf8, 0xc4ac5665,
  0xf4292244, 0x432aff97, 0xab9423a7, 0xfc93a039, 0x655b59c3, 0x8f0ccc92, 0xffeff47d, 0x85845dd1,
  0x6fa87e4f, 0xfe2ce6e0, 0xa3014314, 0x4e0811a1, 0xf7537e82, 0xbd3af235, 0x2ad7d2bb, 0xeb86d391];
const MD5_R: int32[64] = [7, 12, 17, 22, 7, 12, 17, 22, 7, 12, 17, 22, 7, 12, 17, 22,
  5, 9, 14, 20, 5, 9, 14, 20, 5, 9, 14, 20, 5, 9, 14, 20,
  4, 11, 16, 23, 4, 11, 16, 23, 4, 11, 16, 23, 4, 11, 16, 23,
  6, 10, 15, 21, 6, 10, 15, 21, 6, 10, 15, 21, 6, 10, 15, 21];

export fn audio_md5_init(m: AudioMd5*) {
  m->h[0] = 0x67452301;
  m->h[1] = 0xefcdab89;
  m->h[2] = 0x98badcfe;
  m->h[3] = 0x10325476;
  m->nbuf = 0;
  m->total = 0;
}

fn md5_block(m: AudioMd5*, q: uint8*) {
  var w: uint32[16];
  for i in 0..16 {
    w[i] = (uint32)q[i * 4] | ((uint32)q[i * 4 + 1] << 8) | ((uint32)q[i * 4 + 2] << 16) | ((uint32)q[i * 4 + 3] << 24);
  }
  var a: uint32 = m->h[0];
  var b: uint32 = m->h[1];
  var c: uint32 = m->h[2];
  var d: uint32 = m->h[3];
  // four rounds of sixteen steps, without a branch per step
  for i in 0..16 {
    var f: uint32 = (b & c) | (~b & d);
    var x: uint32 = a + f + MD5_K[i] + w[i];
    var r: int32 = MD5_R[i];
    a = d; d = c; c = b;
    b = b + ((x << r) | (x >> (32 - r)));
  }
  for i in 16..32 {
    var f: uint32 = (d & b) | (~d & c);
    var x: uint32 = a + f + MD5_K[i] + w[(5 * (int32)i + 1) & 15];
    var r: int32 = MD5_R[i];
    a = d; d = c; c = b;
    b = b + ((x << r) | (x >> (32 - r)));
  }
  for i in 32..48 {
    var f: uint32 = b ^ c ^ d;
    var x: uint32 = a + f + MD5_K[i] + w[(3 * (int32)i + 5) & 15];
    var r: int32 = MD5_R[i];
    a = d; d = c; c = b;
    b = b + ((x << r) | (x >> (32 - r)));
  }
  for i in 48..64 {
    var f: uint32 = c ^ (b | ~d);
    var x: uint32 = a + f + MD5_K[i] + w[(7 * (int32)i) & 15];
    var r: int32 = MD5_R[i];
    a = d; d = c; c = b;
    b = b + ((x << r) | (x >> (32 - r)));
  }
  m->h[0] = m->h[0] + a;
  m->h[1] = m->h[1] + b;
  m->h[2] = m->h[2] + c;
  m->h[3] = m->h[3] + d;
}

export fn audio_md5_add(m: AudioMd5*, p: uint8*, n: int64) {
  var i: int64 = 0;
  m->total = m->total + (uint64)n;
  if (m->nbuf > 0) {
    while (i < n && m->nbuf < 64) { m->buf[m->nbuf] = p[i]; m->nbuf = m->nbuf + 1; i = i + 1; }
    if (m->nbuf < 64) { return; }
    md5_block(m, &m->buf[0]);
    m->nbuf = 0;
  }
  while (n - i >= 64) { md5_block(m, p + i); i = i + 64; }
  while (i < n) { m->buf[m->nbuf] = p[i]; m->nbuf = m->nbuf + 1; i = i + 1; }
}

/// Finishes and writes the 16-byte digest.
export fn audio_md5_end(m: AudioMd5*, out: uint8*) {
  var bits: uint64 = m->total * 8;
  var pad: uint8[72];
  memset(&pad[0], 0, 72);
  pad[0] = 0x80;
  var k: int64 = (int64)(56 - m->nbuf);
  if (k <= 0) { k = k + 64; }
  audio_md5_add(m, &pad[0], k);
  var l: uint8[8];
  for i in 0..8 { l[i] = (uint8)((bits >> (8 * (uint64)i)) & 255); }
  audio_md5_add(m, &l[0], 8);
  for i in 0..4 {
    for j in 0..4 { out[i * 4 + j] = (uint8)((m->h[i] >> (8 * (uint32)j)) & 255); }
  }
}
