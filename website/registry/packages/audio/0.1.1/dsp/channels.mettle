// Channel mixing: change the number of channels of float samples.
//
// Channels are in WAV order (FL FR FC LFE BL BR SL SR, by the speaker mask
// bits). Fewer channels to more copies each speaker to the same speaker if
// the target has it, else spreads it to its neighbours; more to fewer uses
// the ITU-R BS.775 downmix gains (centre and surrounds at -3 dB, LFE left
// out of stereo). Rows are scaled so a full-scale input cannot clip.

import "../core/status";
import "../core/pcm";
import "convert";

// speaker bits
const SP_FL = 1;
const SP_FR = 2;
const SP_FC = 4;
const SP_LFE = 8;
const SP_BL = 16;
const SP_BR = 32;
const SP_FLC = 64;
const SP_FRC = 128;
const SP_BC = 256;
const SP_SL = 512;
const SP_SR = 1024;

// The speaker bit of each channel of a mask, in order.
fn speakers(ch: int32, mask: uint32, out: uint32*) {
  var m: uint32 = mask;
  if (m == 0) { m = audio_default_mask(ch); }
  var k: int32 = 0;
  for b in 0..18 {
    if (k >= ch) { break; }
    var bit: uint32 = (uint32)1 << (uint32)b;
    if ((m & bit) != 0) { out[k] = bit; k = k + 1; }
  }
  // more channels than mask bits: the rest have no position
  while (k < ch) { out[k] = 0; k = k + 1; }
}

fn has(sp: uint32*, n: int32, bit: uint32) -> int32 {
  for i in 0..n { if (sp[i] == bit) { return (int32)i; } }
  return -1;
}

/// Fills m[out_ch * in_ch] (row per output channel) with the gains that mix
/// in_ch channels to out_ch. Masks may be 0 for the usual layouts.
export fn audio_channel_matrix(in_ch: int32, in_mask: uint32, out_ch: int32, out_mask: uint32, m: float32*) -> int32 {
  if (in_ch < 1 || in_ch > AUDIO_MAX_CHANNELS || out_ch < 1 || out_ch > AUDIO_MAX_CHANNELS) { return AUDIO_E_ARG; }
  for i in 0..out_ch * in_ch { m[i] = 0.0; }
  var si: uint32[8];
  var so: uint32[8];
  speakers(in_ch, in_mask, &si[0]);
  speakers(out_ch, out_mask, &so[0]);
  var h: float32 = 0.70710678;
  if (out_ch == 1) {
    // to mono: everything but LFE, fronts at full, the rest at -3 dB
    for i in 0..in_ch {
      var g: float32 = h;
      if (si[i] == SP_FL || si[i] == SP_FR || si[i] == SP_FC || in_ch == 1) { g = 1.0; }
      if (si[i] == SP_LFE) { g = 0.0; }
      m[i] = g;
    }
  } else {
    for i in 0..in_ch {
      var sp: uint32 = si[i];
      var o: int32 = has(&so[0], out_ch, sp);
      if (in_ch == 1) {
        // mono to anything: the front pair, or the centre if there is one
        var c: int32 = has(&so[0], out_ch, SP_FC);
        if (c >= 0 && out_ch > 2) { m[c * in_ch] = 1.0; }
        else {
          var l: int32 = has(&so[0], out_ch, SP_FL);
          var r: int32 = has(&so[0], out_ch, SP_FR);
          if (l < 0) { l = 0; }
          if (r < 0) { r = 1; }
          m[l * in_ch] = h;
          m[r * in_ch] = h;
        }
        continue;
      }
      if (o >= 0) { m[o * in_ch + i] = 1.0; continue; }
      // no such speaker: spread to the nearest ones
      var l: int32 = has(&so[0], out_ch, SP_FL);
      var r: int32 = has(&so[0], out_ch, SP_FR);
      if (sp == SP_FC || sp == SP_BC) {
        if (l >= 0) { m[l * in_ch + i] = h; }
        if (r >= 0) { m[r * in_ch + i] = h; }
      } else if (sp == SP_BL || sp == SP_SL || sp == SP_FLC) {
        var t: int32 = has(&so[0], out_ch, SP_SL);
        if (sp == SP_SL) { t = has(&so[0], out_ch, SP_BL); }
        if (t >= 0) { m[t * in_ch + i] = 1.0; } else if (l >= 0) { m[l * in_ch + i] = h; }
      } else if (sp == SP_BR || sp == SP_SR || sp == SP_FRC) {
        var t: int32 = has(&so[0], out_ch, SP_SR);
        if (sp == SP_SR) { t = has(&so[0], out_ch, SP_BR); }
        if (t >= 0) { m[t * in_ch + i] = 1.0; } else if (r >= 0) { m[r * in_ch + i] = h; }
      } else if (sp == 0) {
        // a channel with no position goes to the matching index
        if (i < out_ch) { m[(int32)i * in_ch + i] = 1.0; }
      }
      // LFE with no LFE output is dropped
    }
  }
  // keep each output row's total gain at most 1
  for o in 0..out_ch {
    var t: float32 = 0.0;
    for i in 0..in_ch { t = t + m[o * in_ch + i]; }
    if (t > 1.0) {
      for i in 0..in_ch { m[o * in_ch + i] = m[o * in_ch + i] / t; }
    }
  }
  return AUDIO_OK;
}

/// Mixes frames of interleaved floats from in_ch to out_ch channels with
/// matrix m (from audio_channel_matrix). src and dst must not overlap.
export fn audio_mix_channels(src: float32*, in_ch: int32, dst: float32*, out_ch: int32, frames: int64, m: float32*) {
  if (in_ch == 1 && out_ch == 2) {
    var a: float32 = m[0];
    var b: float32 = m[1];
    for f in 0..frames {
      var v: float32 = src[f];
      dst[f * 2] = v * a;
      dst[f * 2 + 1] = v * b;
    }
    return;
  }
  if (in_ch == 2 && out_ch == 1) {
    var a: float32 = m[0];
    var b: float32 = m[1];
    for f in 0..frames { dst[f] = src[f * 2] * a + src[f * 2 + 1] * b; }
    return;
  }
  var ic: int64 = (int64)in_ch;
  var oc: int64 = (int64)out_ch;
  for f in 0..frames {
    var s: float32* = src + f * ic;
    var d: float32* = dst + f * oc;
    for o in 0..oc {
      var row: float32* = m + o * ic;
      var t: float32 = 0.0;
      for i in 0..ic { t = t + row[i] * s[i]; }
      d[o] = t;
    }
  }
}

/// Makes dst a float copy of src with out_ch channels.
export fn audio_pcm_channels(src: AudioPcm*, out_ch: int32, dst: AudioPcm*) -> int32 {
  if (src == dst || src->data == 0) { return AUDIO_E_ARG; }
  var m: float32[64];
  var rc: int32 = audio_channel_matrix(src->channels, src->mask, out_ch, 0, &m[0]);
  if (rc != AUDIO_OK) { return rc; }
  var tmp: AudioPcm;
  var f: float32* = (float32*)src->data;
  if (src->fmt != AUDIO_F32) {
    rc = audio_pcm_convert(src, AUDIO_F32, &tmp);
    if (rc != AUDIO_OK) { return rc; }
    f = (float32*)tmp.data;
  }
  rc = audio_pcm_alloc(dst, src->frames, out_ch, src->rate, AUDIO_F32);
  if (rc == AUDIO_OK) {
    audio_mix_channels(f, src->channels, (float32*)dst->data, out_ch, src->frames, &m[0]);
  }
  if (src->fmt != AUDIO_F32) { audio_pcm_free(&tmp); }
  return rc;
}
