// data/smooth_test: Steffen slopes from mp_smooth_slopes. Every cubic segment built from
// the slopes, sampled at 16 points, must stay within the y range of its two endpoints
// (no overshoot) for monotone, non-monotone, flat, spiky and unevenly spaced data.
// Degenerate input (0, 1 and 2 points, equal or non-increasing x, non-finite values) is
// rejected or handled as documented.

import "std/math";
import "std/io";
import "mistplot/test/harness";
import "mistplot/core/error";
import "mistplot/core/mem";
import "mistplot/data/smooth";

const SAMPLES: int32 = 16;

var g_rng: uint64 = 1181783497276652981;
var g_segments: int64 = 0;
var g_big: bool = true;

fn rnd() -> uint64 {
  var x: uint64 = g_rng;
  x = x ^ (x << 13);
  x = x ^ (x >> 7);
  x = x ^ (x << 17);
  g_rng = x;
  return x;
}

fn rnd_int(n: int64) -> int64 {
  return (int64)(rnd() % (uint64)n);
}

fn rnd_f() -> float64 {
  return (float64)(rnd() >> 11) / 9007199254740992.0;
}

fn rc(r: int32) -> int64 {
  return (int64)r;
}

// y of the Bezier segment i (control points at thirds of the x step) at parameter t.
fn seg_y(xs: float64*, ys: float64*, m: float64*, i: int64, t: float64) -> float64 {
  var h: float64 = xs[i + 1] - xs[i];
  var y0: float64 = ys[i];
  var y1: float64 = ys[i] + m[i] * h / 3.0;
  var y2: float64 = ys[i + 1] - m[i + 1] * h / 3.0;
  var y3: float64 = ys[i + 1];
  var u: float64 = 1.0 - t;
  return u * u * u * y0 + 3.0 * u * u * t * y1 + 3.0 * u * t * t * y2 + t * t * t * y3;
}

// Whether every segment, sampled SAMPLES times, stays within its endpoints.
fn no_overshoot(xs: float64*, ys: float64*, m: float64*, n: int64) -> bool {
  var scale: float64 = 1.0;
  var i: int64 = 0;
  while (i < n) {
    if (fabs(ys[i]) > scale) { scale = fabs(ys[i]); }
    i = i + 1;
  }
  var eps: float64 = 1.0e-9 * scale;
  i = 0;
  while (i + 1 < n) {
    var lo: float64 = ys[i];
    var hi: float64 = ys[i + 1];
    if (lo > hi) {
      lo = ys[i + 1];
      hi = ys[i];
    }
    var k: int32 = 0;
    while (k < SAMPLES) {
      var y: float64 = seg_y(xs, ys, m, i, (float64)k / (float64)(SAMPLES - 1));
      if (y < lo - eps || y > hi + eps) { return false; }
      k = k + 1;
    }
    g_segments = g_segments + 1;
    i = i + 1;
  }
  return true;
}

// The same tangents with plain central differences, for checking the oracle bites.
fn central_slopes(xs: float64*, ys: float64*, n: int64, out: float64*) {
  var i: int64 = 0;
  while (i < n) {
    var a: int64 = i - 1;
    var b: int64 = i + 1;
    if (a < 0) { a = 0; }
    if (b > n - 1) { b = n - 1; }
    out[i] = (ys[b] - ys[a]) / (xs[b] - xs[a]);
    i = i + 1;
  }
}

fn check_args() {
  var xs: float64[8];
  var ys: float64[8];
  var m: float64[8];
  xs[0] = 0.0;
  xs[1] = 1.0;
  xs[2] = 2.0;
  ys[0] = 0.0;
  ys[1] = 1.0;
  ys[2] = 0.0;
  var e: int64 = (int64)MP_ERR_ARG;
  mp_expect_i64("args: n 0 with null pointers", rc(mp_smooth_slopes(0, 0, 0, 0)),
                (int64)MP_OK);
  mp_expect_i64("args: negative n", rc(mp_smooth_slopes(&xs[0], &ys[0], -1, &m[0])), e);
  mp_expect_i64("args: xs 0", rc(mp_smooth_slopes(0, &ys[0], 3, &m[0])), e);
  mp_expect_i64("args: ys 0", rc(mp_smooth_slopes(&xs[0], 0, 3, &m[0])), e);
  mp_expect_i64("args: out 0", rc(mp_smooth_slopes(&xs[0], &ys[0], 3, 0)), e);
  mp_expect_i64("args: valid", rc(mp_smooth_slopes(&xs[0], &ys[0], 3, &m[0])),
                (int64)MP_OK);
}

fn check_known() {
  var xs: float64[8];
  var ys: float64[8];
  var m: float64[8];
  var i: int32 = 0;
  while (i < 8) {
    m[i] = -99.0;
    i = i + 1;
  }

  // one point: tangent 0
  xs[0] = 3.0;
  ys[0] = 5.0;
  mp_expect_i64("one point: ok", rc(mp_smooth_slopes(&xs[0], &ys[0], 1, &m[0])), (int64)MP_OK);
  mp_expect_near("one point: tangent", m[0], 0.0, 0.0);
  mp_expect_near("one point: nothing else written", m[1], -99.0, 0.0);

  // two points: both tangents are the secant
  xs[0] = 1.0;
  xs[1] = 5.0;
  ys[0] = 2.0;
  ys[1] = 10.0;
  mp_expect_i64("two points: ok", rc(mp_smooth_slopes(&xs[0], &ys[0], 2, &m[0])), (int64)MP_OK);
  mp_expect_near("two points: start", m[0], 2.0, 1.0e-12);
  mp_expect_near("two points: end", m[1], 2.0, 1.0e-12);
  mp_expect_near("two points: nothing else written", m[2], -99.0, 0.0);
  xs[1] = 1.0e-9 + 1.0;
  ys[1] = 2.0;
  mp_expect_i64("two points: tiny step", rc(mp_smooth_slopes(&xs[0], &ys[0], 2, &m[0])),
                (int64)MP_OK);
  mp_expect_near("two points: flat", m[0], 0.0, 0.0);
  mp_expect("two points: no overshoot", no_overshoot(&xs[0], &ys[0], &m[0], 2));

  // a straight line keeps its slope everywhere
  i = 0;
  while (i < 6) {
    xs[i] = (float64)i * 0.5;
    ys[i] = 3.0 * xs[i] - 1.0;
    i = i + 1;
  }
  mp_smooth_slopes(&xs[0], &ys[0], 6, &m[0]);
  i = 0;
  var line_ok: bool = true;
  while (i < 6) {
    if (fabs(m[i] - 3.0) > 1.0e-12) { line_ok = false; }
    i = i + 1;
  }
  mp_expect("line: slope 3 at every point", line_ok);

  // a peak: zero tangent on top, one-sided secants at the ends
  xs[0] = 0.0;
  xs[1] = 1.0;
  xs[2] = 2.0;
  ys[0] = 0.0;
  ys[1] = 4.0;
  ys[2] = 0.0;
  mp_smooth_slopes(&xs[0], &ys[0], 3, &m[0]);
  mp_expect_near("peak: start secant", m[0], 4.0, 1.0e-12);
  mp_expect_near("peak: top is flat", m[1], 0.0, 0.0);
  mp_expect_near("peak: end secant", m[2], -4.0, 1.0e-12);

  // a step: the flat parts stay flat on both sides of the jump
  xs[0] = 0.0;
  xs[1] = 1.0;
  xs[2] = 2.0;
  xs[3] = 3.0;
  ys[0] = 0.0;
  ys[1] = 0.0;
  ys[2] = 1.0;
  ys[3] = 1.0;
  mp_smooth_slopes(&xs[0], &ys[0], 4, &m[0]);
  mp_expect_near("step: flat before the jump", m[1], 0.0, 0.0);
  mp_expect_near("step: flat after the jump", m[2], 0.0, 0.0);
  mp_expect("step: no overshoot", no_overshoot(&xs[0], &ys[0], &m[0], 4));
  var cm: float64[8];
  central_slopes(&xs[0], &ys[0], 4, &cm[0]);
  mp_expect("step: central differences do overshoot, so the oracle can fail",
            !no_overshoot(&xs[0], &ys[0], &cm[0], 4));

  // hand-computed interior tangent: s0 = 1, s1 = 3, p = 2, min(1, 3, 1) * 2 = 2
  xs[0] = 0.0;
  xs[1] = 1.0;
  xs[2] = 2.0;
  ys[0] = 0.0;
  ys[1] = 1.0;
  ys[2] = 4.0;
  mp_smooth_slopes(&xs[0], &ys[0], 3, &m[0]);
  mp_expect_near("monotone: start", m[0], 1.0, 1.0e-12);
  mp_expect_near("monotone: interior", m[1], 2.0, 1.0e-12);
  mp_expect_near("monotone: end", m[2], 3.0, 1.0e-12);

  // uneven spacing: the tangent leans toward the nearer secant's side
  xs[0] = 0.0;
  xs[1] = 1.0;
  xs[2] = 11.0;
  ys[0] = 0.0;
  ys[1] = 1.0;
  ys[2] = 2.0;
  mp_smooth_slopes(&xs[0], &ys[0], 3, &m[0]);
  mp_expect("uneven: tangent between the secants", m[1] > 0.1 && m[1] < 1.0);
  mp_expect("uneven: no overshoot", no_overshoot(&xs[0], &ys[0], &m[0], 3));
}

fn check_degenerate() {
  var xs: float64[8];
  var ys: float64[8];
  var m: float64[8];
  var i: int32 = 0;
  while (i < 8) {
    xs[i] = (float64)i;
    ys[i] = (float64)(i * i);
    m[i] = -99.0;
    i = i + 1;
  }
  var e: int64 = (int64)MP_ERR_ARG;

  // equal x (h = 0) is refused, not divided by
  xs[3] = xs[2];
  mp_expect_i64("equal x", rc(mp_smooth_slopes(&xs[0], &ys[0], 6, &m[0])), e);
  mp_expect("equal x: out untouched", m[0] == -99.0 && m[5] == -99.0);
  xs[1] = xs[0];
  mp_expect_i64("equal x at the start", rc(mp_smooth_slopes(&xs[0], &ys[0], 6, &m[0])), e);
  mp_expect_i64("equal x, two points", rc(mp_smooth_slopes(&xs[0], &ys[0], 2, &m[0])), e);
  mp_expect_i64("equal x outside the n points", rc(mp_smooth_slopes(&xs[0], &ys[0], 1, &m[0])),
                (int64)MP_OK);

  // the caller splits at the repeat; each run is fine
  mp_expect_i64("split run a", rc(mp_smooth_slopes(&xs[1], &ys[1], 2, &m[0])), (int64)MP_OK);
  mp_expect_i64("split run b", rc(mp_smooth_slopes(&xs[3], &ys[3], 3, &m[0])), (int64)MP_OK);

  // decreasing x, NaN and infinity
  i = 0;
  while (i < 8) {
    xs[i] = (float64)i;
    i = i + 1;
  }
  xs[4] = 1.5;
  mp_expect_i64("decreasing x", rc(mp_smooth_slopes(&xs[0], &ys[0], 6, &m[0])), e);
  xs[4] = 4.0;
  xs[2] = NAN();
  mp_expect_i64("NaN x", rc(mp_smooth_slopes(&xs[0], &ys[0], 6, &m[0])), e);
  xs[2] = 2.0;
  xs[5] = INF();
  mp_expect_i64("infinite x", rc(mp_smooth_slopes(&xs[0], &ys[0], 6, &m[0])), e);
  xs[5] = 5.0;
  ys[3] = NAN();
  mp_expect_i64("NaN y", rc(mp_smooth_slopes(&xs[0], &ys[0], 6, &m[0])), e);
  ys[3] = -INF();
  mp_expect_i64("infinite y", rc(mp_smooth_slopes(&xs[0], &ys[0], 6, &m[0])), e);
  ys[3] = 9.0;
  mp_expect_i64("clean again", rc(mp_smooth_slopes(&xs[0], &ys[0], 6, &m[0])), (int64)MP_OK);

  // badly scaled input stays finite and bounded
  xs[0] = 1.0e15;
  xs[1] = 1.0e15 + 1.0;
  xs[2] = 1.0e15 + 2.0;
  ys[0] = 0.0;
  ys[1] = 1.0e-3;
  ys[2] = 0.0;
  mp_expect_i64("large offsets", rc(mp_smooth_slopes(&xs[0], &ys[0], 3, &m[0])), (int64)MP_OK);
  mp_expect("large offsets: finite", is_finite(m[0]) != 0 && is_finite(m[1]) != 0
            && is_finite(m[2]) != 0);
  mp_expect("large offsets: no overshoot", no_overshoot(&xs[0], &ys[0], &m[0], 3));
}

// Fills n points of the given shape; x is strictly increasing.
fn fill(kind: int64, n: int64, xs: float64*, ys: float64*) {
  var x: float64 = (rnd_f() - 0.5) * 100.0;
  var y: float64 = 0.0;
  var wide: bool = rnd_int(3) == 0;
  var i: int64 = 0;
  while (i < n) {
    var h: float64 = 0.5 + rnd_f();
    if (wide) { h = pow(10.0, rnd_f() * 6.0 - 3.0); }
    x = x + h;
    xs[i] = x;
    if (kind == 0) {
      y = y + rnd_f() * 5.0;                    // strictly increasing
    } else if (kind == 1) {
      y = y - rnd_f() * 5.0;                    // strictly decreasing
    } else if (kind == 2) {
      y = (rnd_f() - 0.5) * 20.0;               // noise
    } else if (kind == 3) {
      y = y + (rnd_f() - 0.5) * 10.0;           // random walk
    } else if (kind == 4) {
      if (rnd_int(4) == 0) { y = (rnd_f() - 0.5) * 8.0; }   // plateaus
    } else if (kind == 5) {
      y = 0.0;                                  // spikes on a flat line
      if (rnd_int(5) == 0) { y = 100.0 * (rnd_f() - 0.3); }
    } else if (kind == 6) {
      y = sin(x * 0.7) * 3.0;                   // a smooth wave
    } else {
      y = (float64)rnd_int(3);                  // few distinct values
    }
    ys[i] = y;
    i = i + 1;
  }
}

fn check_fuzz() {
  var xs: float64* = (float64*)mp_alloc(80 * 8);
  var ys: float64* = (float64*)mp_alloc(80 * 8);
  var m: float64* = (float64*)mp_alloc(80 * 8);
  var bad: int64 = 0;
  var sign_bad: int64 = 0;
  var secant_bad: int64 = 0;
  var rounds: int32 = 0;
  var total: int32 = 800;
  if (!g_big) { total = 40; }
  while (rounds < total) {
    var n: int64 = 2 + rnd_int(70);
    var kind: int64 = rnd_int(8);
    fill(kind, n, xs, ys);
    if (mp_smooth_slopes(xs, ys, n, m) != MP_OK) {
      bad = bad + 1;
    } else {
      if (!no_overshoot(xs, ys, m, n)) { bad = bad + 1; }
      var i: int64 = 0;
      while (i < n) {
        if (is_finite(m[i]) == 0) { bad = bad + 1; }
        i = i + 1;
      }
      // interior tangents: zero at a turning point or flat side, otherwise the sign
      // of both neighbouring secants, and no steeper than twice the smaller one
      i = 1;
      while (i + 1 < n) {
        var s0: float64 = (ys[i] - ys[i - 1]) / (xs[i] - xs[i - 1]);
        var s1: float64 = (ys[i + 1] - ys[i]) / (xs[i + 1] - xs[i]);
        if (s0 * s1 <= 0.0 && m[i] != 0.0) { sign_bad = sign_bad + 1; }
        if (s0 * s1 > 0.0 && m[i] * s0 <= 0.0) { sign_bad = sign_bad + 1; }
        var lim: float64 = 2.0 * fmin(fabs(s0), fabs(s1)) * (1.0 + 1.0e-12);
        if (fabs(m[i]) > lim) { sign_bad = sign_bad + 1; }
        i = i + 1;
      }
      var first: float64 = (ys[1] - ys[0]) / (xs[1] - xs[0]);
      var last: float64 = (ys[n - 1] - ys[n - 2]) / (xs[n - 1] - xs[n - 2]);
      if (m[0] != first || m[n - 1] != last) { secant_bad = secant_bad + 1; }
    }
    rounds = rounds + 1;
  }
  mp_expect_i64("fuzz: no overshoot and finite", bad, 0);
  mp_expect_i64("fuzz: tangent signs and bounds", sign_bad, 0);
  mp_expect_i64("fuzz: ends use the one-sided secant", secant_bad, 0);
  mp_free((rawptr)xs);
  mp_free((rawptr)ys);
  mp_free((rawptr)m);
}

fn run_all(big: bool) {
  g_big = big;
  var live0: int64 = mp_alloc_live();
  check_args();
  check_known();
  check_degenerate();
  check_fuzz();
  mp_expect_i64("everything freed", mp_alloc_live(), live0);
}

export fn main() -> int32 {
  run_all(true);
  println("{g_segments} segments sampled");
  return mp_summary();
}

@test fn t_smooth() -> int32 {
  run_all(false);
  if (mp_fails != 0) { return 1; }
  return 0;
}
