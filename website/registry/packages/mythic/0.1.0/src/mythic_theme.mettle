// DESIGN-SYSTEM §3.3 / §4 / §6.2 values shared by both themes.
fn theme_common() -> MythicTheme {
  var t: MythicTheme;
  // Regular roles are Geist Serif, medium and semibold roles Geist Sans; all at tracking 0.
  t.type.caption = ts(MYTHIC_FONT_REGULAR, 12.0, 16.0, 0.0);
  t.type.caption_strong = ts(MYTHIC_FONT_MEDIUM, 12.0, 16.0, 0.0);
  t.type.body = ts(MYTHIC_FONT_REGULAR, 14.0, 20.0, 0.0);
  t.type.body_strong = ts(MYTHIC_FONT_SEMIBOLD, 14.0, 20.0, 0.0);
  t.type.label = ts(MYTHIC_FONT_MEDIUM, 14.0, 20.0, 0.0);
  t.type.label_sm = ts(MYTHIC_FONT_MEDIUM, 13.0, 16.0, 0.0);
  t.type.title = ts(MYTHIC_FONT_SEMIBOLD, 16.0, 24.0, 0.0);
  t.type.heading = ts(MYTHIC_FONT_SEMIBOLD, 20.0, 28.0, 0.0);
  t.type.display = ts(MYTHIC_FONT_SEMIBOLD, 28.0, 36.0, 0.0);
  t.type.mono = ts(MYTHIC_FONT_MONO, 13.0, 20.0, 0.0);      // or MYTHIC_FONT_MONO_ALT (IBM Plex Mono)
  t.radius.xs = 2.0; t.radius.sm = 4.0; t.radius.md = 6.0; t.radius.lg = 8.0; t.radius.xl = 12.0;
  var m: MythicMotion* = &t.motion;
  m->hover_in_tau = 25.0; m->hover_out_tau = 50.0; m->press_in_tau = 15.0; m->press_out_tau = 40.0;
  m->focus_tau = 30.0;
  m->check_ms = 180.0; m->check_fill_ms = 100.0; m->check_draw_start_ms = 40.0; m->uncheck_ms = 120.0;
  m->press_scale = 0.92;
  m->radio_ms = 160.0; m->switch_ms = 200.0; m->switch_press_tau = 40.0;
  m->slider_halo_tau = 40.0; m->slider_key_ms = 120.0;
  m->progress_ms = 280.0; m->progress_loop_ms = 1500.0;
  m->tab_ms = 240.0;
  m->tooltip_in_ms = 120.0; m->tooltip_out_ms = 80.0; m->tooltip_delay_ms = 500.0; m->tooltip_warm_ms = 400.0;
  m->tooltip_shift = 4.0;
  m->scrollbar_show_ms = 100.0; m->scrollbar_hide_delay_ms = 800.0; m->scrollbar_fade_ms = 300.0;
  m->scrollbar_width_tau = 40.0; m->scroll_tau = 50.0;
  m->caret_solid_ms = 500.0; m->caret_on_ms = 530.0; m->caret_fade_ms = 100.0; m->caret_idle_ms = 10000.0;
  m->reduced_color_cap_ms = 80.0;
  t.ctrl.sm = ctl(28.0, 10.0, 8.0, 14.0, 6.0, t.type.label_sm);
  t.ctrl.md = ctl(32.0, 12.0, 10.0, 16.0, 6.0, t.type.label);
  t.ctrl.lg = ctl(40.0, 16.0, 12.0, 16.0, 8.0, t.type.label);
  t.space = 4.0;
  return t;
}

/// The built-in light theme (DESIGN-SYSTEM §2.1, §5).
export fn mythic_theme_light() -> MythicTheme {
  var t: MythicTheme = theme_common();
  t.colors = colors_light();
  var c: uint32 = 0x101828;
  t.elevation.e1 = lvl1(sh(1.0, 2.0, 0.0, c | 0x0F000000));
  t.elevation.e2 = lvl2(sh(1.0, 3.0, 0.0, c | 0x1A000000), sh(1.0, 2.0, -1.0, c | 0x0F000000));
  t.elevation.e3 = lvl2(sh(4.0, 8.0, -2.0, c | 0x1A000000), sh(2.0, 4.0, -2.0, c | 0x0F000000));
  t.elevation.e4 = lvl2(sh(12.0, 24.0, -4.0, c | 0x24000000), sh(4.0, 8.0, -2.0, c | 0x0F000000));
  t.disabled_alpha = 0.45;
  t.dark = false;
  return t;
}

/// The built-in dark theme (DESIGN-SYSTEM §2.2, §5).
export fn mythic_theme_dark() -> MythicTheme {
  var t: MythicTheme = theme_common();
  t.colors = colors_dark();
  t.elevation.e1 = lvl1(sh(1.0, 2.0, 0.0, 0x4D000000));
  t.elevation.e2 = lvl2(sh(1.0, 3.0, 0.0, 0x66000000), sh(1.0, 2.0, -1.0, 0x4D000000));
  t.elevation.e3 = lvl2(sh(4.0, 8.0, -2.0, 0x73000000), sh(2.0, 4.0, -2.0, 0x4D000000));
  t.elevation.e4 = lvl2(sh(12.0, 24.0, -4.0, 0x8C000000), sh(4.0, 8.0, -2.0, 0x59000000));
  t.disabled_alpha = 0.40;
  t.dark = true;
  return t;
}
