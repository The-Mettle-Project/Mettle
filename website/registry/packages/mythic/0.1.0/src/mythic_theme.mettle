// mythic_theme: theme data mirroring DESIGN-SYSTEM tokens one to one (DECISIONS §9).
// Field rule: token name with '.' and '-' replaced by '_'. Values transcribed from DESIGN-SYSTEM.
// The ui-taking accessors (mythic_set_theme, mythic_theme, mythic_theme_push/pop, mythic_sp) live in
// mythic_ctx, because MythicUi embeds a MythicTheme and imports this file.
import "mythic_types";

export struct MythicColors {
  // §2 tokens
  bg_window: uint32; bg_surface: uint32; bg_surface_raised: uint32; bg_surface_sunken: uint32;
  bg_input: uint32; bg_tooltip: uint32; bg_hover: uint32; bg_pressed: uint32;
  control_track: uint32;
  border_subtle: uint32; border_default: uint32; border_strong: uint32;
  border_control: uint32; border_control_hover: uint32;
  text_primary: uint32; text_secondary: uint32; text_tertiary: uint32; text_disabled: uint32;
  text_on_accent: uint32; text_tooltip: uint32;
  accent: uint32; accent_hover: uint32; accent_pressed: uint32; accent_subtle: uint32;
  accent_subtle_hover: uint32; accent_text: uint32; accent_subtle_text: uint32;
  focus_ring: uint32; focus_glow: uint32;
  success: uint32; success_subtle: uint32;
  warning: uint32; warning_solid: uint32; warning_subtle: uint32;
  danger: uint32; danger_hover: uint32; danger_pressed: uint32; danger_text: uint32;
  danger_subtle: uint32; danger_glow: uint32;
  selection: uint32; selection_inactive: uint32;
  scrollbar_thumb: uint32; scrollbar_thumb_hover: uint32; scrollbar_thumb_active: uint32; scrollbar_track: uint32;
  shadow_color: uint32;
  // §5 / §7 literals promoted to named fields (0 = not drawn)
  highlight_accent: uint32;                 // top highlight over accent/danger fills
  highlight_secondary: uint32;              // top highlight over secondary buttons (dark only)
  elevated_border: uint32;                  // 1px border on e2+ surfaces (dark only)
  btn_secondary_bg: uint32; btn_secondary_bg_hover: uint32; btn_secondary_bg_pressed: uint32;
  btn_secondary_border: uint32; btn_secondary_border_hover: uint32; btn_secondary_border_pressed: uint32;
  radio_dot: uint32;
  switch_track_off_hover: uint32; switch_knob_off: uint32; switch_knob_on: uint32;
  slider_thumb: uint32; slider_thumb_border: uint32; slider_halo_hover: uint32; slider_halo_pressed: uint32;
  input_border_focus: uint32; caret: uint32;
  tooltip_border: uint32; tooltip_shortcut: uint32;
}

export struct MythicTypeScale {
  caption: MythicTextStyle; caption_strong: MythicTextStyle; body: MythicTextStyle; body_strong: MythicTextStyle;
  label: MythicTextStyle; label_sm: MythicTextStyle; title: MythicTextStyle; heading: MythicTextStyle;
  display: MythicTextStyle; mono: MythicTextStyle;
}

export struct MythicRadii { xs: float32; sm: float32; md: float32; lg: float32; xl: float32; }   // full = height/2

export struct MythicElevLevel { count: int32; s: MythicShadow[2]; }
export struct MythicElevation { e0: MythicElevLevel; e1: MythicElevLevel; e2: MythicElevLevel; e3: MythicElevLevel; e4: MythicElevLevel; }

// τ values and durations, ms (DESIGN-SYSTEM §6.2)
export struct MythicMotion {
  hover_in_tau: float32; hover_out_tau: float32; press_in_tau: float32; press_out_tau: float32;
  focus_tau: float32;
  check_ms: float32; check_fill_ms: float32; check_draw_start_ms: float32; uncheck_ms: float32;
  press_scale: float32;
  radio_ms: float32; switch_ms: float32; switch_press_tau: float32;
  slider_halo_tau: float32; slider_key_ms: float32;
  progress_ms: float32; progress_loop_ms: float32;
  tab_ms: float32;
  tooltip_in_ms: float32; tooltip_out_ms: float32; tooltip_delay_ms: float32; tooltip_warm_ms: float32;
  tooltip_shift: float32;
  scrollbar_show_ms: float32; scrollbar_hide_delay_ms: float32; scrollbar_fade_ms: float32;
  scrollbar_width_tau: float32; scroll_tau: float32;
  caret_solid_ms: float32; caret_on_ms: float32; caret_fade_ms: float32; caret_idle_ms: float32;
  reduced_color_cap_ms: float32;
}

export struct MythicControlSize { height: float32; pad_x_button: float32; pad_x_input: float32; icon: float32;
                                radius: float32; text: MythicTextStyle; }
export struct MythicControlSizes { sm: MythicControlSize; md: MythicControlSize; lg: MythicControlSize; }

export struct MythicTheme {
  colors: MythicColors;
  type: MythicTypeScale;
  radius: MythicRadii;
  elevation: MythicElevation;
  motion: MythicMotion;
  ctrl: MythicControlSizes;
  space: float32;              // spacing grid unit (4); mythic_sp(ui, n) = n * space
  reduced_motion: bool;
  disabled_alpha: float32;
  dark: bool;
}

fn ts(font: int32, size: float32, lh: float32, tr: float32) -> MythicTextStyle {
  var s: MythicTextStyle = { font: font, size: size, line_height: lh, tracking: tr };
  return s;
}
fn sh(dy: float32, blur: float32, spread: float32, color: uint32) -> MythicShadow {
  var s: MythicShadow = { dx: 0.0, dy: dy, blur: blur, spread: spread, color: color };
  return s;
}
fn lvl1(a: MythicShadow) -> MythicElevLevel { var l: MythicElevLevel; l.count = 1; l.s[0] = a; return l; }
fn lvl2(a: MythicShadow, b: MythicShadow) -> MythicElevLevel { var l: MythicElevLevel; l.count = 2; l.s[0] = a; l.s[1] = b; return l; }
fn ctl(h: float32, pxb: float32, pxi: float32, icon: float32, r: float32, t: MythicTextStyle) -> MythicControlSize {
  var c: MythicControlSize = { height: h, pad_x_button: pxb, pad_x_input: pxi, icon: icon, radius: r };
  c.text = t;
  return c;
}

