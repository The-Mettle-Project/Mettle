fn x11_ks_lookup(ks: int64) -> uint32 {
  var lo: int64 = 0;
  var hi: int64 = X_KS_N - 1;
  while (lo <= hi) {
    var mid: int64 = (lo + hi) / 2;
    var e: int64 = (int64)X_KS_TABLE[mid];
    var k: int64 = (e >> 16) & 0xFFFF;
    if (k == ks) { return (uint32)(e & 0xFFFF); }
    if (k < ks) { lo = mid + 1; } else { hi = mid - 1; }
  }
  return (uint32)0;
}

/// Maps an unshifted (column 0) keysym to a MYTHIC_KEY_* code; 0 when the key has no code
/// (modifiers, unknown keys). Letters map to ASCII uppercase, other printable ASCII to itself.
export fn mythic_x11_keysym_to_key(keysym: uint32) -> int32 {
  var ks: int64 = (int64)keysym;
  if (ks >= 97 && ks <= 122) { return (int32)(ks - 32); }
  if (ks >= 32 && ks <= 126) { return (int32)ks; }
  if (ks >= 0xFFBE && ks <= 0xFFC9) { return MYTHIC_KEY_F1 + (int32)(ks - 0xFFBE); }
  if (ks >= 0xFFB0 && ks <= 0xFFB9) { return (int32)(48 + ks - 0xFFB0); }   // KP_0..KP_9
  switch (ks) {
    case 0xFF09: { return MYTHIC_KEY_TAB; }
    case 0xFE20: { return MYTHIC_KEY_TAB; }         // ISO_Left_Tab (Shift+Tab)
    case 0xFF80: { return MYTHIC_KEY_SPACE; }       // KP_Space
    case 0xFF0D: { return MYTHIC_KEY_ENTER; }
    case 0xFF8D: { return MYTHIC_KEY_ENTER; }       // KP_Enter
    case 0xFF1B: { return MYTHIC_KEY_ESCAPE; }
    case 0xFF08: { return MYTHIC_KEY_BACKSPACE; }
    case 0xFFFF: { return MYTHIC_KEY_DELETE; }
    case 0xFF9F: { return MYTHIC_KEY_DELETE; }      // KP_Delete
    case 0xFF51: { return MYTHIC_KEY_LEFT; }
    case 0xFF96: { return MYTHIC_KEY_LEFT; }
    case 0xFF53: { return MYTHIC_KEY_RIGHT; }
    case 0xFF98: { return MYTHIC_KEY_RIGHT; }
    case 0xFF52: { return MYTHIC_KEY_UP; }
    case 0xFF97: { return MYTHIC_KEY_UP; }
    case 0xFF54: { return MYTHIC_KEY_DOWN; }
    case 0xFF99: { return MYTHIC_KEY_DOWN; }
    case 0xFF50: { return MYTHIC_KEY_HOME; }
    case 0xFF95: { return MYTHIC_KEY_HOME; }
    case 0xFF57: { return MYTHIC_KEY_END; }
    case 0xFF9C: { return MYTHIC_KEY_END; }
    case 0xFF55: { return MYTHIC_KEY_PAGE_UP; }
    case 0xFF9A: { return MYTHIC_KEY_PAGE_UP; }
    case 0xFF56: { return MYTHIC_KEY_PAGE_DOWN; }
    case 0xFF9B: { return MYTHIC_KEY_PAGE_DOWN; }
    case 0xFF63: { return MYTHIC_KEY_INSERT; }
    case 0xFF9E: { return MYTHIC_KEY_INSERT; }
    default: { return 0; }
  }
  return 0;
}

/// Maps a keysym to a Unicode code point; 0 when the keysym produces no text.
export fn mythic_x11_keysym_to_ucs(keysym: uint32) -> uint32 {
  var ks: int64 = (int64)keysym;
  if ((ks >= 32 && ks <= 126) || (ks >= 160 && ks <= 255)) { return (uint32)ks; }
  if ((ks >> 24) == 1) { return (uint32)(ks & 0x00FFFFFF); }
  if (ks >= 0xFFB0 && ks <= 0xFFB9) { return (uint32)(48 + ks - 0xFFB0); }
  if (ks >= 0x100 && ks <= 0x20FF) { return x11_ks_lookup(ks); }
  switch (ks) {
    case 0xFF80: { return (uint32)32; }   // KP_Space
    case 0xFFAA: { return (uint32)42; }   // KP_Multiply
    case 0xFFAB: { return (uint32)43; }   // KP_Add
    case 0xFFAD: { return (uint32)45; }   // KP_Subtract
    case 0xFFAE: { return (uint32)46; }   // KP_Decimal
    case 0xFFAF: { return (uint32)47; }   // KP_Divide
    case 0xFFBD: { return (uint32)61; }   // KP_Equal
    default: { return (uint32)0; }
  }
  return (uint32)0;
}
