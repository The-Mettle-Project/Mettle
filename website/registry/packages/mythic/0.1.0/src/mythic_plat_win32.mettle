// mythic_plat_win32: user32/gdi32/kernel32 backend (DECISIONS §8, Appendix B).
// Compiled only on windows (guarded import in mythic_plat). Externs are never exported and use aliases.
import "std/mem";
import "std/io";
import "mythic_types";
import "mythic_utf8";

struct W32Point { x: int32; y: int32; }
struct W32Rect { left: int32; top: int32; right: int32; bottom: int32; }
struct W32Msg { hwnd: int64; message: uint32; wparam: int64; lparam: int64; time: uint32; pt: W32Point; l_private: uint32; }
struct W32Paint { hdc: int64; erase: int32; rc_paint: W32Rect; restore: int32; inc_update: int32; reserved: uint8[32]; }
struct W32WndClassExW {
  cb_size: uint32; style: uint32; wnd_proc: fn(int64, uint32, int64, int64) -> int64;
  cls_extra: int32; wnd_extra: int32; instance: int64; icon: int64; cursor: int64; background: int64;
  menu_name: uint16*; class_name: uint16*; icon_sm: int64;
}
struct W32Bmi {
  size: uint32; width: int32; height: int32; planes: uint16; bit_count: uint16; compression: uint32;
  size_image: uint32; x_ppm: int32; y_ppm: int32; clr_used: uint32; clr_important: uint32;
}
struct W32TrackMouse { cb_size: uint32; flags: uint32; hwnd: int64; hover_time: uint32; }

