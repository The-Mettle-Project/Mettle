// log/unix on systems without the Linux socket calls: the syslog and
// journald sinks report failure and drop records.

export fn log__unix_open() -> int64 { return -38; }

export fn log__unix_send(fd: int64, path: string, buf: uint8*, n: int64) -> int64 { return -38; }

export fn log__unix_close(fd: int64) { }

export fn log__pid() -> int64 { return 0; }
