// BMP (Windows bitmap). Decodes 1, 2, 4, 8, 16, 24 and 32 bits a pixel,
// palettes, bit fields, RLE4 and RLE8, OS/2 and V1 to V5 headers, bottom-up
// and top-down rows. Encodes 24-bit RGB and 32-bit RGBA.

import "std/mem";
import "../core/status";
import "../core/image";
import "../core/buf";
import "common";

/// True when the bytes start like a BMP file.
export fn etch_bmp_is(p: uint8*, n: int64) -> bool {
  return n >= 26 && p[0] == 'B' && p[1] == 'M';
}

struct Mask {
  shift: int32;
  bits: int32;
  m: uint32;
}

fn mask_make(m: uint32) -> Mask {
  var r: Mask;
  r.m = m;
  if (m == 0) { return r; }
  var s: int32 = 0;
  var v: uint32 = m;
  while ((v & 1) == 0) { v = v >> 1; s = s + 1; }
  var b: int32 = 0;
  while ((v & 1) == 1) { v = v >> 1; b = b + 1; }
  r.shift = s;
  r.bits = b;
  return r;
}

// Pulls one channel out of a pixel and widens it to 8 bits by repeating its
// bits (so 5-bit 31 becomes 255), as ImageMagick and libpng do.
fn mask_get(k: Mask*, px: uint32) -> int32 {
  if (k->m == 0 || k->bits == 0) { return 0; }
  var v: uint32 = (px & k->m) >> (uint32)k->shift;
  if (k->bits >= 8) { return (int32)(v >> (uint32)(k->bits - 8)); }
  var x: uint32 = v << (uint32)(8 - k->bits);
  var s: int32 = k->bits;
  while (s < 8) { x = x | (x >> (uint32)s); s = s * 2; }
  return (int32)(x & 255);
}

/// Decodes a BMP file into RGB8, or RGBA8 when it has alpha.
export fn etch_bmp_decode(p: uint8*, n: int64, out: EtchImage*, o: EtchOpts*) -> int32 {
  if (p == 0 || out == 0 || n < 0) { return ETCH_E_ARG; }
  if (!etch_bmp_is(p, n)) { return ETCH_E_DATA; }
  var r: EtchRd;
  etch_rd_init(&r, p, n);
  etch_rd_skip(&r, 10);
  var offset: int64 = etch_rd_u32le(&r);
  var hsize: int64 = etch_rd_u32le(&r);
  var w: int64 = 0;
  var h: int64 = 0;
  var bpp: int32 = 0;
  var comp: int64 = 0;
  var ncolors: int64 = 0;
  var palsize: int64 = 4;
  if (hsize == 12) {
    w = (int64)etch_rd_u16le(&r);
    h = (int64)(int16)etch_rd_u16le(&r);
    etch_rd_u16le(&r);
    bpp = etch_rd_u16le(&r);
    palsize = 3;
  } else if (hsize >= 16 && hsize <= 124) {
    w = (int64)(int32)etch_rd_u32le(&r);
    h = (int64)(int32)etch_rd_u32le(&r);
    etch_rd_u16le(&r);
    bpp = etch_rd_u16le(&r);
    if (hsize >= 20) { comp = etch_rd_u32le(&r); }
    if (hsize >= 36) {
      etch_rd_skip(&r, 12);
      ncolors = etch_rd_u32le(&r);
    }
  } else {
    return ETCH_E_UNSUPPORTED;
  }
  if (r.bad) { return ETCH_E_TRUNC; }
  // OS/2 v2 headers (16 or 64 bytes) reuse value 3 for Huffman 1D.
  if ((hsize == 16 || hsize == 64) && comp == 3) { return ETCH_E_UNSUPPORTED; }
  var top_down: bool = h < 0;
  if (top_down) { h = -h; }
  if (w <= 0 || h <= 0) { return ETCH_E_DATA; }
  if (comp != 0 && comp != 1 && comp != 2 && comp != 3 && comp != 6) { return ETCH_E_UNSUPPORTED; }
  if (bpp != 1 && bpp != 2 && bpp != 4 && bpp != 8 && bpp != 16 && bpp != 24 && bpp != 32) { return ETCH_E_DATA; }
  if (comp == 1 && bpp != 8) { return ETCH_E_DATA; }
  if (comp == 2 && bpp != 4) { return ETCH_E_DATA; }
  if (top_down && (comp == 1 || comp == 2)) { return ETCH_E_DATA; }
  // Color masks.
  var rm: uint32 = 0;
  var gm: uint32 = 0;
  var bm: uint32 = 0;
  var am: uint32 = 0;
  if (bpp == 16) { rm = 0x7c00; gm = 0x03e0; bm = 0x001f; }
  if (bpp == 32) { rm = 0x00ff0000; gm = 0x0000ff00; bm = 0x000000ff; am = 0xff000000; }
  var pos_after: int64 = 14 + hsize;
  if (comp == 3 || comp == 6) {
    if (bpp != 16 && bpp != 32) { return ETCH_E_DATA; }
    var mr: EtchRd;
    if (hsize >= 52) {
      etch_rd_init(&mr, p + 54, n - 54);
    } else {
      etch_rd_init(&mr, p, n);
      etch_rd_skip(&mr, pos_after);
      pos_after = pos_after + 12;
      if (comp == 6) { pos_after = pos_after + 4; }
    }
    rm = (uint32)etch_rd_u32le(&mr);
    gm = (uint32)etch_rd_u32le(&mr);
    bm = (uint32)etch_rd_u32le(&mr);
    am = 0;
    if (hsize >= 56 || comp == 6) { am = (uint32)etch_rd_u32le(&mr); }
    if (mr.bad) { return ETCH_E_TRUNC; }
    if (rm == 0 && gm == 0 && bm == 0) { return ETCH_E_DATA; }
  }
  // Palette.
  var pal: uint8[1024];
  for i in 0..1024 { pal[i] = 0; }
  if (bpp <= 8) {
    var maxc: int64 = (int64)1 << (int64)bpp;
    if (ncolors == 0 || ncolors > maxc) { ncolors = maxc; }
    var pr: EtchRd;
    etch_rd_init(&pr, p, n);
    etch_rd_skip(&pr, 14 + hsize);
    for i in 0..ncolors {
      var bb: int32 = etch_rd_u8(&pr);
      var gg: int32 = etch_rd_u8(&pr);
      var rr: int32 = etch_rd_u8(&pr);
      if (palsize == 4) { etch_rd_u8(&pr); }
      pal[i * 4] = (uint8)rr; pal[i * 4 + 1] = (uint8)gg; pal[i * 4 + 2] = (uint8)bb;
    }
    if (pr.bad) { return ETCH_E_TRUNC; }
  }
  var alpha: bool = am != 0;
  var fmt: int32 = ETCH_RGB8;
  if (alpha) { fmt = ETCH_RGBA8; }
  var img: EtchImage;
  var rc: int32 = etch_alloc_checked(&img, w, h, fmt, o);
  if (rc != ETCH_OK) { return rc; }
  if (offset < 14 || offset > n) { etch_image_free(&img); return ETCH_E_DATA; }
  var data: uint8* = p + offset;
  var dn: int64 = n - offset;
  var ch: int64 = (int64)(fmt & 7);
  if (comp == 1 || comp == 2) {
    memset(img.data, 0, img.stride * h);
    var x: int64 = 0;
    var y: int64 = 0;          // counted from the bottom
    var i: int64 = 0;
    var fin: bool = false;
    while (!fin) {
      if (i + 2 > dn) { break; }
      var c0: int64 = (int64)data[i];
      var c1: int64 = (int64)data[i + 1];
      i = i + 2;
      if (c0 > 0) {
        for k in 0..c0 {
          if (x >= w) { break; }
          var idx: int64 = c1;
          if (comp == 2) {
            if ((k & 1) == 0) { idx = c1 >> 4; } else { idx = c1 & 15; }
          }
          if (y < h) {
            var d: uint8* = img.data + (h - 1 - y) * img.stride + x * ch;
            d[0] = pal[idx * 4]; d[1] = pal[idx * 4 + 1]; d[2] = pal[idx * 4 + 2];
          }
          x = x + 1;
        }
      } else if (c1 == 0) {
        x = 0; y = y + 1;
      } else if (c1 == 1) {
        fin = true;
      } else if (c1 == 2) {
        if (i + 2 > dn) { break; }
        x = x + (int64)data[i];
        y = y + (int64)data[i + 1];
        i = i + 2;
      } else {
        var cnt: int64 = c1;
        var nbytes: int64 = cnt;
        if (comp == 2) { nbytes = (cnt + 1) / 2; }
        if (i + nbytes > dn) { break; }
        for k in 0..cnt {
          var idx: int64 = 0;
          if (comp == 1) { idx = (int64)data[i + k]; }
          else {
            var bt: int64 = (int64)data[i + k / 2];
            if ((k & 1) == 0) { idx = bt >> 4; } else { idx = bt & 15; }
          }
          if (x < w && y < h) {
            var d: uint8* = img.data + (h - 1 - y) * img.stride + x * ch;
            d[0] = pal[idx * 4]; d[1] = pal[idx * 4 + 1]; d[2] = pal[idx * 4 + 2];
          }
          x = x + 1;
        }
        i = i + nbytes;
        if ((nbytes & 1) == 1) { i = i + 1; }
      }
      if (y >= h) { fin = true; }
    }
    *out = img;
    return etch_finish(out, o);
  }
  var rowbytes: int64 = ((w * (int64)bpp + 31) / 32) * 4;
  // The last row need not carry its padding.
  var lastrow: int64 = (w * (int64)bpp + 7) / 8;
  if (rowbytes * (h - 1) + lastrow > dn) { etch_image_free(&img); return ETCH_E_TRUNC; }
  var mr2: Mask = mask_make(rm);
  var mg2: Mask = mask_make(gm);
  var mb2: Mask = mask_make(bm);
  var ma2: Mask = mask_make(am);
  var std32: bool = bpp == 32 && rm == 0x00ff0000 && gm == 0x0000ff00 && bm == 0x000000ff;
  var any_alpha: int32 = 0;
  for y in 0..h {
    var s: uint8* = data + y * rowbytes;
    var dy: int64 = h - 1 - y;
    if (top_down) { dy = y; }
    var d: uint8* = img.data + dy * img.stride;
    if (bpp == 24) {
      for x in 0..w {
        d[x * 3] = s[x * 3 + 2]; d[x * 3 + 1] = s[x * 3 + 1]; d[x * 3 + 2] = s[x * 3];
      }
    } else if (bpp <= 8) {
      var per: int64 = (int64)(8 / bpp);
      var bmask: int64 = ((int64)1 << (int64)bpp) - 1;
      for x in 0..w {
        var bt: int64 = (int64)s[x / per];
        var sh: int64 = (per - 1 - (x % per)) * (int64)bpp;
        var idx: int64 = (bt >> sh) & bmask;
        var q: uint8* = d + x * ch;
        q[0] = pal[idx * 4]; q[1] = pal[idx * 4 + 1]; q[2] = pal[idx * 4 + 2];
      }
    } else if (std32) {
      for x in 0..w {
        var q: uint8* = d + x * ch;
        q[0] = s[x * 4 + 2]; q[1] = s[x * 4 + 1]; q[2] = s[x * 4];
        if (alpha) { q[3] = s[x * 4 + 3]; any_alpha = any_alpha | (int32)s[x * 4 + 3]; }
      }
    } else {
      for x in 0..w {
        var v: uint32 = 0;
        if (bpp == 16) { v = (uint32)s[x * 2] | ((uint32)s[x * 2 + 1] << 8); }
        else { v = (uint32)s[x * 4] | ((uint32)s[x * 4 + 1] << 8) | ((uint32)s[x * 4 + 2] << 16) | ((uint32)s[x * 4 + 3] << 24); }
        var q: uint8* = d + x * ch;
        q[0] = (uint8)mask_get(&mr2, v);
        q[1] = (uint8)mask_get(&mg2, v);
        q[2] = (uint8)mask_get(&mb2, v);
        if (alpha) {
          var av: int32 = mask_get(&ma2, v);
          q[3] = (uint8)av;
          any_alpha = any_alpha | av;
        }
      }
    }
  }
  // Many 32-bit files leave the alpha byte at zero: treat them as opaque.
  if (alpha && any_alpha == 0) {
    for y in 0..h {
      var d: uint8* = img.data + y * img.stride;
      for x in 0..w { d[x * 4 + 3] = 255; }
    }
  }
  *out = img;
  return etch_finish(out, o);
}

/// Encodes an image as BMP: 32-bit with an alpha mask when it has alpha,
/// else 24-bit. Other formats are converted to 8-bit first.
export fn etch_bmp_encode(src: EtchImage*, out: EtchBuf*) -> int32 {
  if (src == 0 || out == 0 || src->data == 0) { return ETCH_E_ARG; }
  var img: EtchImage;
  var conv: bool = false;
  var rc: int32 = etch_as_rgb8(src, &img, &conv);
  if (rc != ETCH_OK) { return rc; }
  var alpha: bool = img.format == ETCH_RGBA8;
  var w: int64 = (int64)img.width;
  var h: int64 = (int64)img.height;
  var bpp: int64 = 24;
  var hsize: int64 = 40;
  if (alpha) { bpp = 32; hsize = 108; }
  var rowbytes: int64 = ((w * bpp + 31) / 32) * 4;
  var off: int64 = 14 + hsize;
  var total: int64 = off + rowbytes * h;
  rc = etch_buf_reserve(out, total);
  if (rc != ETCH_OK) { if (conv) { etch_image_free(&img); } return rc; }
  etch_buf_push(out, 'B');
  etch_buf_push(out, 'M');
  etch_buf_u32le(out, total);
  etch_buf_u32le(out, 0);
  etch_buf_u32le(out, off);
  etch_buf_u32le(out, hsize);
  etch_buf_u32le(out, w);
  etch_buf_u32le(out, h);
  etch_buf_u16le(out, 1);
  etch_buf_u16le(out, bpp);
  if (alpha) { etch_buf_u32le(out, 3); } else { etch_buf_u32le(out, 0); }
  etch_buf_u32le(out, rowbytes * h);
  etch_buf_u32le(out, 2835);   // 72 dpi
  etch_buf_u32le(out, 2835);
  etch_buf_u32le(out, 0);
  etch_buf_u32le(out, 0);
  if (alpha) {
    etch_buf_u32le(out, 0x00ff0000);
    etch_buf_u32le(out, 0x0000ff00);
    etch_buf_u32le(out, 0x000000ff);
    etch_buf_u32le(out, 0xff000000);
    etch_buf_u32le(out, 0x73524742);   // 'sRGB'
    for i in 0..12 { etch_buf_u32le(out, 0); }
  }
  for y in 0..h {
    var s: uint8* = img.data + (h - 1 - y) * img.stride;
    var d: uint8* = out->data + out->len;
    if (alpha) {
      for x in 0..w {
        d[x * 4] = s[x * 4 + 2]; d[x * 4 + 1] = s[x * 4 + 1]; d[x * 4 + 2] = s[x * 4]; d[x * 4 + 3] = s[x * 4 + 3];
      }
    } else {
      for x in 0..w {
        d[x * 3] = s[x * 3 + 2]; d[x * 3 + 1] = s[x * 3 + 1]; d[x * 3 + 2] = s[x * 3];
      }
    }
    for k in (w * bpp / 8)..rowbytes { d[k] = 0; }
    out->len = out->len + rowbytes;
  }
  if (conv) { etch_image_free(&img); }
  return ETCH_OK;
}
