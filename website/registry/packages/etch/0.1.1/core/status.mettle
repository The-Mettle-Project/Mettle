// Status codes. Every Etch function that can fail returns one of these.
// ETCH_OK is zero and every error is negative, so `rc < 0` means failure.

export const ETCH_OK: int32 = 0;
export const ETCH_E_ARG: int32 = -1;          // a bad argument (null pointer, bad size, bad format)
export const ETCH_E_DATA: int32 = -2;         // the input is not a valid file of this format
export const ETCH_E_TRUNC: int32 = -3;        // the input ended early
export const ETCH_E_CHECK: int32 = -4;        // a checksum in the file does not match
export const ETCH_E_LIMIT: int32 = -5;        // the image is bigger than the limits allow
export const ETCH_E_MEM: int32 = -6;          // out of memory
export const ETCH_E_UNSUPPORTED: int32 = -7;  // valid data that uses a feature Etch lacks
export const ETCH_E_IO: int32 = -8;           // a file could not be opened, read or written
export const ETCH_E_FORMAT: int32 = -9;       // the data is not in any format Etch knows

/// A short English message for a status code.
export fn etch_error_text(rc: int32) -> string {
  switch (rc) {
    case 0: { return "ok"; }
    case -1: { return "bad argument"; }
    case -2: { return "invalid data"; }
    case -3: { return "input ended early"; }
    case -4: { return "checksum mismatch"; }
    case -5: { return "image too large for the limits"; }
    case -6: { return "out of memory"; }
    case -7: { return "unsupported feature"; }
    case -8: { return "file error"; }
    case -9: { return "unknown image format"; }
    default: { }
  }
  return "unknown error";
}
