// Converting between pixel formats.
//
//   var rgba: EtchImage;
//   etch_convert(&img, ETCH_RGBA8, &rgba);   // new image
//
// Rules: gray from color uses the Rec. 601 weights (0.299, 0.587, 0.114).
// A missing alpha channel becomes fully opaque, and an alpha channel the
// target lacks is dropped (no blending). 8 to 16 bits multiplies by 257,
// 16 to 8 bits rounds. Float channels are 0..1 and are clamped when they go
// to integers. No sRGB or gamma change happens here: see ops/color.

import "std/mem";
import "../core/status";
import "../core/image";

// ---- 8-bit RGBA rows ----

fn u8_unpack(s: uint8*, c: int32, w: int64, d: uint8*) {
  if (c == 4) { memcpy(d, s, w * 4); return; }
  if (c == 3) {
    for x in 0..w {
      d[x * 4] = s[x * 3];
      d[x * 4 + 1] = s[x * 3 + 1];
      d[x * 4 + 2] = s[x * 3 + 2];
      d[x * 4 + 3] = 255;
    }
    return;
  }
  if (c == 2) {
    for x in 0..w {
      var g: uint8 = s[x * 2];
      d[x * 4] = g;
      d[x * 4 + 1] = g;
      d[x * 4 + 2] = g;
      d[x * 4 + 3] = s[x * 2 + 1];
    }
    return;
  }
  for x in 0..w {
    var g: uint8 = s[x];
    d[x * 4] = g;
    d[x * 4 + 1] = g;
    d[x * 4 + 2] = g;
    d[x * 4 + 3] = 255;
  }
}

fn u8_pack(s: uint8*, c: int32, w: int64, d: uint8*) {
  if (c == 4) { memcpy(d, s, w * 4); return; }
  if (c == 3) {
    for x in 0..w {
      d[x * 3] = s[x * 4];
      d[x * 3 + 1] = s[x * 4 + 1];
      d[x * 3 + 2] = s[x * 4 + 2];
    }
    return;
  }
  for x in 0..w {
    var y: int32 = ((int32)s[x * 4] * 77 + (int32)s[x * 4 + 1] * 150 + (int32)s[x * 4 + 2] * 29 + 128) >> 8;
    if (c == 2) {
      d[x * 2] = (uint8)y;
      d[x * 2 + 1] = s[x * 4 + 3];
    } else {
      d[x] = (uint8)y;
    }
  }
}

// ---- 16-bit RGBA rows (covers u8 and u16 on either side) ----

fn u16_unpack(s: uint8*, fmt: int32, w: int64, d: uint16*) {
  var c: int64 = (int64)(fmt & 7);
  var wide: bool = (fmt >> 4) == 1;
  var s16: uint16* = (uint16*)s;
  for x in 0..w {
    var v: uint16[4];
    for k in 0..c {
      if (wide) { v[k] = s16[x * c + k]; } else { v[k] = (uint16)((int32)s[x * c + k] * 257); }
    }
    var o: uint16* = d + x * 4;
    if (c >= 3) {
      o[0] = v[0]; o[1] = v[1]; o[2] = v[2];
      if (c == 4) { o[3] = v[3]; } else { o[3] = 65535; }
    } else {
      o[0] = v[0]; o[1] = v[0]; o[2] = v[0];
      if (c == 2) { o[3] = v[1]; } else { o[3] = 65535; }
    }
  }
}

fn u16_pack(s: uint16*, fmt: int32, w: int64, d: uint8*) {
  var c: int64 = (int64)(fmt & 7);
  var wide: bool = (fmt >> 4) == 1;
  var d16: uint16* = (uint16*)d;
  for x in 0..w {
    var i: uint16* = s + x * 4;
    var v: int64[4];
    if (c >= 3) {
      v[0] = (int64)i[0]; v[1] = (int64)i[1]; v[2] = (int64)i[2]; v[3] = (int64)i[3];
    } else {
      v[0] = ((int64)i[0] * 19595 + (int64)i[1] * 38470 + (int64)i[2] * 7471 + 32768) >> 16;
      v[1] = (int64)i[3];
    }
    for k in 0..c {
      if (wide) { d16[x * c + k] = (uint16)v[k]; }
      else { d[x * c + k] = (uint8)((v[k] * 255 + 32767) / 65535); }
    }
  }
}

// ---- float RGBA rows (any format) ----

/// Reads one row of any format as float RGBA (0..1 for integer formats).
export fn etch_row_to_f32(s: uint8*, fmt: int32, w: int64, d: float32*) {
  var c: int64 = (int64)(fmt & 7);
  var kind: int32 = fmt >> 4;
  var s16: uint16* = (uint16*)s;
  var sf: float32* = (float32*)s;
  var k8: float32 = 1.0 / 255.0;
  var k16: float32 = 1.0 / 65535.0;
  for x in 0..w {
    var v: float32[4];
    for k in 0..c {
      if (kind == 0) { v[k] = (float32)s[x * c + k] * k8; }
      else if (kind == 1) { v[k] = (float32)s16[x * c + k] * k16; }
      else { v[k] = sf[x * c + k]; }
    }
    var o: float32* = d + x * 4;
    if (c >= 3) {
      o[0] = v[0]; o[1] = v[1]; o[2] = v[2];
      if (c == 4) { o[3] = v[3]; } else { o[3] = 1.0; }
    } else {
      o[0] = v[0]; o[1] = v[0]; o[2] = v[0];
      if (c == 2) { o[3] = v[1]; } else { o[3] = 1.0; }
    }
  }
}

fn clamp01(v: float32) -> float32 {
  if (v > 1.0) { return 1.0; }
  if (v >= 0.0) { return v; }
  return 0.0;   // also NaN
}

/// Writes one row of float RGBA into any format.
export fn etch_row_from_f32(s: float32*, fmt: int32, w: int64, d: uint8*) {
  var c: int64 = (int64)(fmt & 7);
  var kind: int32 = fmt >> 4;
  var d16: uint16* = (uint16*)d;
  var df: float32* = (float32*)d;
  for x in 0..w {
    var i: float32* = s + x * 4;
    var v: float32[4];
    if (c >= 3) {
      v[0] = i[0]; v[1] = i[1]; v[2] = i[2]; v[3] = i[3];
    } else {
      v[0] = i[0] * 0.299 + i[1] * 0.587 + i[2] * 0.114;
      v[1] = i[3];
    }
    for k in 0..c {
      if (kind == 0) { d[x * c + k] = (uint8)(int32)(clamp01(v[k]) * 255.0 + 0.5); }
      else if (kind == 1) { d16[x * c + k] = (uint16)(int32)(clamp01(v[k]) * 65535.0 + 0.5); }
      else { df[x * c + k] = v[k]; }
    }
  }
}

/// Converts src into dst, which must already have the same size. Any
/// formats work; src and dst must not overlap.
export fn etch_convert_into(src: EtchImage*, dst: EtchImage*) -> int32 {
  if (src == 0 || dst == 0 || src->data == 0 || dst->data == 0) { return ETCH_E_ARG; }
  if (src->width != dst->width || src->height != dst->height) { return ETCH_E_ARG; }
  if (!etch_format_ok(src->format) || !etch_format_ok(dst->format)) { return ETCH_E_ARG; }
  var w: int64 = (int64)src->width;
  var sf: int32 = src->format;
  var df: int32 = dst->format;
  if (sf == df) {
    var rb: int64 = etch_image_row_bytes(src);
    for y in 0..src->height {
      memcpy(dst->data + (int64)y * dst->stride, src->data + (int64)y * src->stride, rb);
    }
    return ETCH_OK;
  }
  var sk: int32 = sf >> 4;
  var dk: int32 = df >> 4;
  var path: int32 = 2;                  // float
  if (sk == 0 && dk == 0) { path = 0; } // 8-bit
  else if (sk != 2 && dk != 2) { path = 1; }
  var tmp: uint8* = (uint8*)malloc(w * 16);
  if (tmp == 0) { return ETCH_E_MEM; }
  for y in 0..src->height {
    var s: uint8* = src->data + (int64)y * src->stride;
    var d: uint8* = dst->data + (int64)y * dst->stride;
    if (path == 0) {
      u8_unpack(s, sf & 7, w, tmp);
      u8_pack(tmp, df & 7, w, d);
    } else if (path == 1) {
      u16_unpack(s, sf, w, (uint16*)tmp);
      u16_pack((uint16*)tmp, df, w, d);
    } else {
      etch_row_to_f32(s, sf, w, (float32*)tmp);
      etch_row_from_f32((float32*)tmp, df, w, d);
    }
  }
  free(tmp);
  return ETCH_OK;
}

/// Makes a new image holding src converted to fmt.
export fn etch_convert(src: EtchImage*, fmt: int32, out: EtchImage*) -> int32 {
  if (src == 0 || out == 0 || src->data == 0 || !etch_format_ok(fmt)) { return ETCH_E_ARG; }
  var tmp: EtchImage;
  var rc: int32 = etch_image_alloc(&tmp, src->width, src->height, fmt);
  if (rc != ETCH_OK) { return rc; }
  rc = etch_convert_into(src, &tmp);
  if (rc != ETCH_OK) { etch_image_free(&tmp); return rc; }
  *out = tmp;
  return ETCH_OK;
}

/// Converts an image to fmt in place: the old pixels are freed and replaced.
/// Does nothing when it is already in fmt.
export fn etch_convert_self(img: EtchImage*, fmt: int32) -> int32 {
  if (img == 0) { return ETCH_E_ARG; }
  if (img->format == fmt) { return ETCH_OK; }
  var tmp: EtchImage;
  var rc: int32 = etch_convert(img, fmt, &tmp);
  if (rc != ETCH_OK) { return rc; }
  etch_image_free(img);
  *img = tmp;
  return ETCH_OK;
}
