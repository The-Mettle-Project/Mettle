export extern fn malloc(size: int64) -> rawptr = "malloc";
export extern fn calloc(count: int64, size: int64) -> rawptr = "calloc";
export extern fn realloc(ptr: rawptr, size: int64) -> rawptr = "realloc";
export extern fn free(ptr: rawptr) = "free";
export extern fn malloc_trim(pad: int64) -> int32 = "malloc_trim";
export extern fn memset(ptr: rawptr, value: int32, size: int64) -> rawptr = "memset";
export extern fn memcpy(dest: rawptr, src: rawptr, size: int64) -> rawptr = "memcpy";
export extern fn memmove(dest: rawptr, src: rawptr, size: int64) -> rawptr = "memmove";
export extern fn memcmp(a: rawptr, b: rawptr, size: int64) -> int32 = "memcmp";

export extern fn memory_region(ptr: rawptr, size: int64) = "mettle_safety_region_begin";
export extern fn memory_region_end(ptr: rawptr) = "mettle_safety_region_end";

export fn mem_zero(p: cstring, n: int64) -> cstring {
  if (n <= (int64)0) { return p; }
  var d: int64 = (int64)p;
  var i: int64 = (int64)0;
  var words: int64 = n & ~(int64)7;
  while (i < words) {
    *((int64*)(d + i)) = (int64)0;
    i = i + (int64)8;
  }
  while (i < n) {
    *((int8*)(d + i)) = (int8)0;
    i = i + (int64)1;
  }
  return p;
}

export fn mem_fill(p: cstring, value: int32, n: int64) -> cstring {
  if (n <= (int64)0) { return p; }
  var b: int64 = (int64)value & (int64)0xFF;
  var word: int64 = b | (b << (int64)8) | (b << (int64)16) | (b << (int64)24) | (b << (int64)32) | (b << (int64)40) | (b << (int64)48) | (b << (int64)56);
  var d: int64 = (int64)p;
  var i: int64 = (int64)0;
  var words: int64 = n & ~(int64)7;
  while (i < words) {
    *((int64*)(d + i)) = word;
    i = i + (int64)8;
  }
  while (i < n) {
    *((int8*)(d + i)) = (int8)b;
    i = i + (int64)1;
  }
  return p;
}

export fn mem_copy(dst: cstring, src: cstring, n: int64) -> cstring {
  if (n <= (int64)0 || dst == src) { return dst; }
  var d: int64 = (int64)dst;
  var s: int64 = (int64)src;
  var i: int64 = (int64)0;
  var words: int64 = n & ~(int64)7;
  while (i < words) {
    *((int64*)(d + i)) = *((int64*)(s + i));
    i = i + (int64)8;
  }
  while (i < n) {
    *((int8*)(d + i)) = *((int8*)(s + i));
    i = i + (int64)1;
  }
  return dst;
}

export fn mem_move(dst: cstring, src: cstring, n: int64) -> cstring {
  if (n <= (int64)0 || dst == src) { return dst; }
  var d: int64 = (int64)dst;
  var s: int64 = (int64)src;
  if (d < s) {
    return mem_copy(dst, src, n);
  }
  var i: int64 = n;
  while (i >= (int64)8) {
    i = i - (int64)8;
    *((int64*)(d + i)) = *((int64*)(s + i));
  }
  while (i > (int64)0) {
    i = i - (int64)1;
    *((int8*)(d + i)) = *((int8*)(s + i));
  }
  return dst;
}

export fn mem_equal(a: cstring, b: cstring, n: int64) -> int32 {
  if (n <= (int64)0 || a == b) { return 1; }
  var pa: int64 = (int64)a;
  var pb: int64 = (int64)b;
  var i: int64 = (int64)0;
  var words: int64 = n & ~(int64)7;
  while (i < words) {
    if (*((int64*)(pa + i)) != *((int64*)(pb + i))) { return 0; }
    i = i + (int64)8;
  }
  while (i < n) {
    if (*((int8*)(pa + i)) != *((int8*)(pb + i))) { return 0; }
    i = i + (int64)1;
  }
  return 1;
}

export fn mem_compare(a: cstring, b: cstring, n: int64) -> int32 {
  if (n <= (int64)0 || a == b) { return 0; }
  var pa: int64 = (int64)a;
  var pb: int64 = (int64)b;
  var i: int64 = (int64)0;
  var words: int64 = n & ~(int64)7;
  while (i < words) {
    if (*((int64*)(pa + i)) != *((int64*)(pb + i))) {
      var end: int64 = i + (int64)8;
      while (i < end) {
        var wa: int32 = (int32)(*((int8*)(pa + i))) & 0xFF;
        var wb: int32 = (int32)(*((int8*)(pb + i))) & 0xFF;
        if (wa != wb) {
          return wa - wb;
        }
        i = i + (int64)1;
      }
    }
    i = i + (int64)8;
  }
  while (i < n) {
    var ca: int32 = (int32)(*((int8*)(pa + i))) & 0xFF;
    var cb: int32 = (int32)(*((int8*)(pb + i))) & 0xFF;
    if (ca != cb) {
      return ca - cb;
    }
    i = i + (int64)1;
  }
  return 0;
}

export fn mem_find_byte(p: cstring, value: int32, n: int64) -> int64 {
  if (n <= (int64)0) { return (int64)-1; }
  var target: int32 = value & 0xFF;
  var base: int64 = (int64)p;
  var i: int64 = (int64)0;
  while (i < n) {
    if (((int32)(*((int8*)(base + i))) & 0xFF) == target) {
      return i;
    }
    i = i + (int64)1;
  }
  return (int64)-1;
}

export fn alloc_zeroed(n: int64) -> rawptr {
  return calloc(1, n);
}

export fn buf_dup(src: rawptr, len: int64) -> rawptr {
  if (len <= 0) { return 0; }
  var dst: cstring = malloc(len);
  if (dst == 0) { return 0; }
  memcpy(dst, src, len);
  return dst;
}

export fn mem_take<T>(place: T*) -> T {
  var out: T;
  mem_copy((cstring)&out, (cstring)place, sizeof(T));
  mem_zero((cstring)place, sizeof(T));
  return out;
}

export fn mem_replace<T>(place: T*, value: T) -> T {
  var out: T;
  mem_copy((cstring)&out, (cstring)place, sizeof(T));
  mem_copy((cstring)place, (cstring)&value, sizeof(T));
  forget(value);
  return out;
}
