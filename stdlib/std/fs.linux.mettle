// Linux filesystem calls for std/fs, through raw system calls (x86-64 or
// AArch64, numbers and struct stat offsets from std/linux_sys): file
// information, directory listing, and creating, removing and finding paths.
// Every call returns 0, a length, or a negative error code (-errno). Paths are
// strings copied into a NUL-terminated 4096-byte buffer, so a longer path
// fails with -FS_ENAMETOOLONG. Names are relative to the current directory
// unless they start with a slash.
//
// Things to know:
//   - fs_stat follows symbolic links, fs_lstat does not.
//   - fs_dir_next gives a view of the entry name that is valid until the
//     next call. Nothing is allocated.
//   - fs_remove_all never follows a symbolic link. A link is removed, never
//     the thing it points to.
//   - fs_realpath asks the kernel through /proc/self/fd, so it needs /proc.

import "std/linux_sys";
import "std/conv";

export const FS_FILE = 1;      // a regular file
export const FS_DIR = 2;       // a directory
export const FS_SYMLINK = 3;   // a symbolic link (only from fs_lstat or a listing)
export const FS_OTHER = 4;     // a device, pipe, socket or anything else

export const FS_ENOENT = 2;
export const FS_EACCES = 13;
export const FS_EEXIST = 17;
export const FS_ENOTDIR = 20;
export const FS_EINVAL = 22;
export const FS_ERANGE = 34;         // the buffer is too small
export const FS_ENAMETOOLONG = 36;
export const FS_ENOTEMPTY = 39;
export const FS_ELOOP = 40;

// What fs_stat finds. mode holds the permission bits (the low 12, including
// setuid, setgid and sticky). Times are nanoseconds since 1970-01-01 UTC.
export struct FsStat {
  kind: int32;       // FS_FILE, FS_DIR, FS_SYMLINK or FS_OTHER
  mode: int32;
  size: int64;
  mtime_ns: int64;   // last change of the contents
  atime_ns: int64;   // last access
  ctime_ns: int64;   // last change of the file's metadata
}

// An open directory. Make one with fs_dir_open, read it with fs_dir_next and
// finish with fs_dir_close. It holds its own read buffer, so it is about 4 KB.
export struct FsDir {
  fd: int64;
  pos: int32;          // read position in buf
  len: int32;          // bytes of buf in use
  buf: int64[512];     // getdents64 records (an int64 array keeps them aligned)
}

// One entry of a directory.
export struct FsDirEntry {
  name: string;   // a view into the FsDir; valid until the next fs_dir_next
  kind: int32;    // FS_FILE, FS_DIR, FS_SYMLINK or FS_OTHER
}

const FS_AT_FDCWD = -100;
const FS_AT_SYMLINK_NOFOLLOW = 0x100;
const FS_AT_REMOVEDIR = 0x200;
const FS_O_NONBLOCK = 0x800;
const FS_O_CLOEXEC = 0x80000;
const FS_O_PATH = 0x200000;
const FS_MAX_DEPTH = 256;   // how deep fs_remove_all goes

// Copies a path into buf with a NUL. Returns false if it does not fit.
fn fs_cpath(path: string, buf: uint8*) -> bool {
  if (path.length >= (uint64)4096) { return false; }
  for i in 0..path.length {
    if ((int32)path[i] == 0) { return false; }
    buf[i] = (uint8)path[i];
  }
  buf[(int64)path.length] = (uint8)0;
  return true;
}

// Seconds and nanoseconds as nanoseconds.
fn fs_ns(sec: int64, nsec: int64) -> int64 {
  return sec * (int64)1000000000 + nsec;
}

// The FS_ kind for the file type bits of a mode.
fn fs_kind_of_mode(mode: int32) -> int32 {
  var t: int32 = mode & 0xF000;
  if (t == 0x8000) { return FS_FILE; }
  if (t == 0x4000) { return FS_DIR; }
  if (t == 0xA000) { return FS_SYMLINK; }
  return FS_OTHER;
}

// Reads the mode out of a struct stat.
fn fs_st_mode(st: uint8*) -> int32 {
  return (int32)*(uint32*)(st + LINUX_STAT_MODE_AT);
}

// Fills an FsStat from a struct stat.
fn fs_fill(st: uint8*, out: FsStat*) {
  var mode: int32 = fs_st_mode(st);
  out->kind = fs_kind_of_mode(mode);
  out->mode = mode & 0xFFF;
  out->size = *(int64*)(st + LINUX_STAT_SIZE_AT);
  out->atime_ns = fs_ns(*(int64*)(st + LINUX_STAT_ATIME_AT), *(int64*)(st + LINUX_STAT_ATIME_AT + 8));
  out->mtime_ns = fs_ns(*(int64*)(st + LINUX_STAT_MTIME_AT), *(int64*)(st + LINUX_STAT_MTIME_AT + 8));
  out->ctime_ns = fs_ns(*(int64*)(st + LINUX_STAT_CTIME_AT), *(int64*)(st + LINUX_STAT_CTIME_AT + 8));
}

fn fs_stat_flags(path: string, out: FsStat*, flags: int64) -> int64 {
  var cp: uint8[4096];
  if (!fs_cpath(path, &cp[0])) { return -(int64)FS_ENAMETOOLONG; }
  var st: int64[18];   // struct stat is at most 144 bytes
  var r: int64 = syscall(LINUX_SYS_NEWFSTATAT, FS_AT_FDCWD, &cp[0], &st[0], flags);
  if (r < 0) { return r; }
  fs_fill((uint8*)&st[0], out);
  return 0;
}

// Describes path, following symbolic links. Returns 0 or -errno; a link to
// nothing gives -FS_ENOENT.
export fn fs_stat(path: string, out: FsStat*) -> int64 {
  return fs_stat_flags(path, out, 0);
}

// Like fs_stat, but describes a symbolic link itself.
export fn fs_lstat(path: string, out: FsStat*) -> int64 {
  return fs_stat_flags(path, out, FS_AT_SYMLINK_NOFOLLOW);
}

// True if path exists, following links, so a dangling link is false.
export fn fs_exists(path: string) -> bool {
  var st: FsStat;
  return fs_stat(path, &st) == 0;
}

export fn fs_is_dir(path: string) -> bool {
  var st: FsStat;
  return fs_stat(path, &st) == 0 && st.kind == FS_DIR;
}

export fn fs_is_file(path: string) -> bool {
  var st: FsStat;
  return fs_stat(path, &st) == 0 && st.kind == FS_FILE;
}

// Opens a directory for reading. Returns 0 or -errno; -FS_ENOTDIR if path is
// not a directory.
export fn fs_dir_open(path: string, d: FsDir*) -> int64 {
  var cp: uint8[4096];
  if (!fs_cpath(path, &cp[0])) { return -(int64)FS_ENAMETOOLONG; }
  // O_NONBLOCK so that opening a FIFO by mistake does not wait for a writer.
  var fd: int64 = syscall(LINUX_SYS_OPENAT, FS_AT_FDCWD, &cp[0], FS_O_CLOEXEC | FS_O_NONBLOCK, 0);
  if (fd < 0) { return fd; }
  var st: int64[18];
  var r: int64 = syscall(LINUX_SYS_FSTAT, fd, &st[0]);
  if (r < 0) {
    syscall(LINUX_SYS_CLOSE, fd);
    return r;
  }
  if (fs_kind_of_mode(fs_st_mode((uint8*)&st[0])) != FS_DIR) {
    syscall(LINUX_SYS_CLOSE, fd);
    return -(int64)FS_ENOTDIR;
  }
  d->fd = fd;
  d->pos = 0;
  d->len = 0;
  return 0;
}

// Reads the next entry, skipping "." and "..". Returns 1 and fills e, 0 at
// the end of the directory, or -errno. The order is the file system's. If
// the file system does not say what an entry is, it is looked up with an
// lstat. e->name stays valid until the next call on d.
export fn fs_dir_next(d: FsDir*, e: FsDirEntry*) -> int64 {
  var base: uint8* = (uint8*)&d->buf[0];
  while (true) {
    if (d->pos >= d->len) {
      var got: int64 = syscall(LINUX_SYS_GETDENTS64, d->fd, base, 4096);
      if (got == -4) { continue; }   // EINTR
      if (got < 0) { return got; }
      if (got == 0) { return 0; }
      d->len = (int32)got;
      d->pos = 0;
    }
    // struct linux_dirent64: ino u64, off i64, reclen u16, type u8, name.
    var rec: uint8* = base + d->pos;
    var reclen: int32 = (int32)*(uint16*)(rec + 16);
    var dtype: int32 = (int32)rec[18];
    var name: uint8* = rec + 19;
    if (reclen <= 19) { return -(int64)FS_EINVAL; }
    d->pos = d->pos + reclen;
    var n: int64 = 0;
    while (name[n] != (uint8)0) { n = n + 1; }
    if (name[0] == (uint8)46 && (n == 1 || (n == 2 && name[1] == (uint8)46))) { continue; }
    var kind: int32 = FS_OTHER;
    if (dtype == 8) {
      kind = FS_FILE;
    } else if (dtype == 4) {
      kind = FS_DIR;
    } else if (dtype == 10) {
      kind = FS_SYMLINK;
    } else if (dtype == 0) {
      // DT_UNKNOWN: ask the file system.
      var st: int64[18];
      var r: int64 = syscall(LINUX_SYS_NEWFSTATAT, d->fd, name, &st[0], FS_AT_SYMLINK_NOFOLLOW);
      if (r == -(int64)FS_ENOENT) { continue; }   // removed since it was listed
      if (r == 0) { kind = fs_kind_of_mode(fs_st_mode((uint8*)&st[0])); }
    }
    e->name = str_from_bytes((cstring)name, n);
    e->kind = kind;
    return 1;
  }
  return 0;
}

// Closes a directory opened by fs_dir_open.
export fn fs_dir_close(d: FsDir*) -> int64 {
  var r: int64 = syscall(LINUX_SYS_CLOSE, d->fd);
  d->fd = -1;
  d->pos = 0;
  d->len = 0;
  return r;
}

// Makes one directory. mode is the permission bits, such as 0755, which is 493 (Mettle has no octal literals); the
// process umask is applied. Fails with -FS_EEXIST if path exists.
export fn fs_mkdir(path: string, mode: int32) -> int64 {
  var cp: uint8[4096];
  if (!fs_cpath(path, &cp[0])) { return -(int64)FS_ENAMETOOLONG; }
  return syscall(LINUX_SYS_MKDIRAT, FS_AT_FDCWD, &cp[0], mode);
}

// Makes path and any missing parents, like mkdir -p. It is fine if path is
// already a directory; if it is something else, the result is
// -FS_ENOTDIR. mode applies to every directory it makes.
export fn fs_mkdir_all(path: string, mode: int32) -> int64 {
  var cp: uint8[4096];
  if (!fs_cpath(path, &cp[0])) { return -(int64)FS_ENAMETOOLONG; }
  var n: int64 = (int64)path.length;
  var i: int64 = 1;
  while (i < n) {
    // Each prefix that ends before a slash, skipping runs of slashes.
    if (cp[i] == (uint8)47 && cp[i - 1] != (uint8)47) {
      cp[i] = (uint8)0;
      var pr: int64 = syscall(LINUX_SYS_MKDIRAT, FS_AT_FDCWD, &cp[0], mode);
      cp[i] = (uint8)47;
      if (pr < 0 && pr != -(int64)FS_EEXIST) { return pr; }
    }
    i = i + 1;
  }
  var r: int64 = syscall(LINUX_SYS_MKDIRAT, FS_AT_FDCWD, &cp[0], mode);
  if (r == -(int64)FS_EEXIST) {
    if (fs_is_dir(path)) { return 0; }
    return -(int64)FS_ENOTDIR;
  }
  return r;
}

// Removes an empty directory.
export fn fs_rmdir(path: string) -> int64 {
  var cp: uint8[4096];
  if (!fs_cpath(path, &cp[0])) { return -(int64)FS_ENAMETOOLONG; }
  return syscall(LINUX_SYS_UNLINKAT, FS_AT_FDCWD, &cp[0], FS_AT_REMOVEDIR);
}

// Removes a file or a symbolic link (the link, not its target). A directory
// gives an error; use fs_rmdir or fs_remove_all.
export fn fs_remove(path: string) -> int64 {
  var cp: uint8[4096];
  if (!fs_cpath(path, &cp[0])) { return -(int64)FS_ENAMETOOLONG; }
  return syscall(LINUX_SYS_UNLINKAT, FS_AT_FDCWD, &cp[0], 0);
}

// Removes the entry called name inside the directory dirfd, and everything
// below it. Symbolic links are unlinked, never followed. Works by descriptor,
// so path length does not matter. depth counts the levels below the first.
fn fs_rm_at(dirfd: int64, name: uint8*, depth: int32) -> int64 {
  var st: int64[18];
  var r: int64 = syscall(LINUX_SYS_NEWFSTATAT, dirfd, name, &st[0], FS_AT_SYMLINK_NOFOLLOW);
  if (r == -(int64)FS_ENOENT) { return 0; }
  if (r < 0) { return r; }
  if (fs_kind_of_mode(fs_st_mode((uint8*)&st[0])) != FS_DIR) {
    r = syscall(LINUX_SYS_UNLINKAT, dirfd, name, 0);
    if (r == -(int64)FS_ENOENT) { return 0; }
    return r;
  }
  if (depth >= FS_MAX_DEPTH) { return -(int64)FS_ELOOP; }
  // st_dev and st_ino are the first two words of struct stat on both CPUs.
  var dev: int64 = st[0];
  var ino: int64 = st[1];
  // A directory can lose entries while we read it, and some file systems then
  // skip entries. So read, remove, and try the rmdir; if it says the
  // directory is not empty, go round again.
  for _pass in 0..4 {
    var fd: int64 = syscall(LINUX_SYS_OPENAT, dirfd, name, FS_O_CLOEXEC | FS_O_NONBLOCK, 0);
    if (fd == -(int64)FS_ENOENT) { return 0; }
    if (fd < 0) { return fd; }
    // Make sure we opened the directory we looked at, and not something that
    // was swapped in (a link) between the lstat and the open.
    var st2: int64[18];
    r = syscall(LINUX_SYS_FSTAT, fd, &st2[0]);
    if (r < 0) {
      syscall(LINUX_SYS_CLOSE, fd);
      return r;
    }
    if (fs_kind_of_mode(fs_st_mode((uint8*)&st2[0])) != FS_DIR || st2[0] != dev || st2[1] != ino) {
      syscall(LINUX_SYS_CLOSE, fd);
      return -(int64)FS_ELOOP;
    }
    var sub: FsDir;
    sub.fd = fd;
    sub.pos = 0;
    sub.len = 0;
    var ent: FsDirEntry;
    while (true) {
      var more: int64 = fs_dir_next(&sub, &ent);
      if (more < 0) {
        syscall(LINUX_SYS_CLOSE, fd);
        return more;
      }
      if (more == 0) { break; }
      if (ent.kind == FS_DIR) {
        r = fs_rm_at(fd, ent.name.chars, depth + 1);
      } else {
        r = syscall(LINUX_SYS_UNLINKAT, fd, ent.name.chars, 0);
        if (r == -(int64)FS_ENOENT) { r = 0; }
      }
      if (r < 0) {
        syscall(LINUX_SYS_CLOSE, fd);
        return r;
      }
    }
    syscall(LINUX_SYS_CLOSE, fd);
    r = syscall(LINUX_SYS_UNLINKAT, dirfd, name, FS_AT_REMOVEDIR);
    if (r == 0 || r == -(int64)FS_ENOENT) { return 0; }
    if (r != -(int64)FS_ENOTEMPTY && r != -(int64)FS_EEXIST) { return r; }
  }
  return -(int64)FS_ENOTEMPTY;
}

// Removes path and everything below it, like rm -rf. A path that does not
// exist is fine (the result is 0).
//
// It never follows a symbolic link. If path itself is a link, the link is
// removed and its target is left alone; links inside a directory are removed
// the same way, so the tree it deletes is only what lies under path. A
// trailing slash is ignored, so "link/" is the link, not its target.
//
// It refuses "", "/", ".", ".." and anything ending in "/." or "/..", with
// -FS_EINVAL. A tree more than 256 levels deep fails with -FS_ELOOP. It stops
// at the first error, and what it already removed stays removed.
export fn fs_remove_all(path: string) -> int64 {
  var cp: uint8[4096];
  if (!fs_cpath(path, &cp[0])) { return -(int64)FS_ENAMETOOLONG; }
  var n: int64 = (int64)path.length;
  while (n > 1 && cp[n - 1] == (uint8)47) { n = n - 1; }
  cp[n] = (uint8)0;
  // The last element must be a real name.
  var s: int64 = n;
  while (s > 0 && cp[s - 1] != (uint8)47) { s = s - 1; }
  var last: int64 = n - s;
  if (last == 0) { return -(int64)FS_EINVAL; }
  if (last == 1 && cp[s] == (uint8)46) { return -(int64)FS_EINVAL; }
  if (last == 2 && cp[s] == (uint8)46 && cp[s + 1] == (uint8)46) { return -(int64)FS_EINVAL; }
  return fs_rm_at(FS_AT_FDCWD, &cp[0], 0);
}

// Makes a symbolic link at link that holds target. The target is stored as
// given and need not exist.
export fn fs_symlink(target: string, link: string) -> int64 {
  var a: uint8[4096];
  var b: uint8[4096];
  if (!fs_cpath(target, &a[0]) || !fs_cpath(link, &b[0])) { return -(int64)FS_ENAMETOOLONG; }
  return syscall(LINUX_SYS_SYMLINKAT, &a[0], FS_AT_FDCWD, &b[0]);
}

// Writes the target of the symbolic link at path into buf, with a NUL after
// it, and returns its length. -FS_ERANGE if buf (cap bytes) cannot hold the
// target and the NUL; -FS_EINVAL if path is not a link.
export fn fs_readlink(path: string, buf: uint8*, cap: int64) -> int64 {
  var cp: uint8[4096];
  if (!fs_cpath(path, &cp[0])) { return -(int64)FS_ENAMETOOLONG; }
  if (cap < 1) { return -(int64)FS_ERANGE; }
  var r: int64 = syscall(LINUX_SYS_READLINKAT, FS_AT_FDCWD, &cp[0], buf, cap);
  if (r < 0) { return r; }
  // The kernel cuts the text off without saying so. A full buffer might have
  // been cut, and has no room for the NUL anyway.
  if (r >= cap) { return -(int64)FS_ERANGE; }
  buf[r] = (uint8)0;
  return r;
}

// Writes the absolute path of path into buf with every symbolic link
// resolved, and returns its length. The path must exist. It opens the path
// with O_PATH and reads where /proc/self/fd/N points, so it needs /proc.
// -FS_ERANGE if buf does not have room for the result and a NUL.
export fn fs_realpath(path: string, buf: uint8*, cap: int64) -> int64 {
  var cp: uint8[4096];
  if (!fs_cpath(path, &cp[0])) { return -(int64)FS_ENAMETOOLONG; }
  if (cap < 1) { return -(int64)FS_ERANGE; }
  var fd: int64 = syscall(LINUX_SYS_OPENAT, FS_AT_FDCWD, &cp[0], FS_O_PATH | FS_O_CLOEXEC, 0);
  if (fd < 0) { return fd; }
  // "/proc/self/fd/" and the descriptor number.
  var link: uint8[48];
  var prefix: string = "/proc/self/fd/";
  var p: int64 = 0;
  while (p < (int64)prefix.length) {
    link[p] = (uint8)prefix[p];
    p = p + 1;
  }
  var digits: uint8[24];
  var nd: int64 = 0;
  var v: int64 = fd;
  if (v == 0) {
    digits[0] = (uint8)48;
    nd = 1;
  }
  while (v > 0) {
    digits[nd] = (uint8)(48 + v % 10);
    nd = nd + 1;
    v = v / 10;
  }
  while (nd > 0) {
    nd = nd - 1;
    link[p] = digits[nd];
    p = p + 1;
  }
  link[p] = (uint8)0;
  var r: int64 = syscall(LINUX_SYS_READLINKAT, FS_AT_FDCWD, &link[0], buf, cap);
  syscall(LINUX_SYS_CLOSE, fd);
  if (r < 0) { return r; }
  if (r >= cap) { return -(int64)FS_ERANGE; }
  buf[r] = (uint8)0;
  return r;
}

// Writes the current directory into buf with a NUL and returns its length.
// -FS_ERANGE if it does not fit.
export fn fs_getcwd(buf: uint8*, cap: int64) -> int64 {
  if (cap < 1) { return -(int64)FS_ERANGE; }
  var r: int64 = syscall(LINUX_SYS_GETCWD, buf, cap);
  if (r < 0) { return r; }
  return r - 1;   // the kernel counts the NUL
}

// Changes the current directory of the whole process.
export fn fs_chdir(path: string) -> int64 {
  var cp: uint8[4096];
  if (!fs_cpath(path, &cp[0])) { return -(int64)FS_ENAMETOOLONG; }
  return syscall(LINUX_SYS_CHDIR, &cp[0]);
}

extern fn fs_c_getenv(name: cstring) -> cstring = "getenv";

// Writes the directory for temporary files into buf with a NUL and returns
// its length: $TMPDIR if it is set and not empty, else /tmp. It does not
// check that the directory exists.
export fn fs_temp_dir(buf: uint8*, cap: int64) -> int64 {
  var t: string = "/tmp";
  var env: cstring = fs_c_getenv("TMPDIR");
  if (env != 0) {
    var e: string = str_from_cstr(env);
    if (e.length > (uint64)0) { t = e; }
  }
  var n: int64 = (int64)t.length;
  if (n + 1 > cap) { return -(int64)FS_ERANGE; }
  for i in 0..n { buf[i] = t.chars[i]; }
  buf[n] = (uint8)0;
  return n;
}
