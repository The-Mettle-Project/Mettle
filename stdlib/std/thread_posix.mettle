export extern fn pthread_create(thread: int64*, attr: cstring, start_routine: fn(cstring) -> cstring, arg: cstring) -> int32 = "pthread_create";

export extern fn pthread_join(thread: int64, retval: cstring) -> int32 = "pthread_join";

export extern fn pthread_detach(thread: int64) -> int32 = "pthread_detach";

export extern fn pthread_self() -> int64 = "pthread_self";

export extern fn pthread_exit(retval: cstring) = "pthread_exit";

export extern fn pthread_mutex_init(mutex: cstring, attr: cstring) -> int32 = "pthread_mutex_init";

export extern fn pthread_mutex_destroy(mutex: cstring) -> int32 = "pthread_mutex_destroy";

export extern fn pthread_mutex_lock(mutex: cstring) -> int32 = "pthread_mutex_lock";

export extern fn pthread_mutex_trylock(mutex: cstring) -> int32 = "pthread_mutex_trylock";

export extern fn pthread_mutex_unlock(mutex: cstring) -> int32 = "pthread_mutex_unlock";

export extern fn pthread_cond_init(cond: cstring, attr: cstring) -> int32 = "pthread_cond_init";

export extern fn pthread_cond_destroy(cond: cstring) -> int32 = "pthread_cond_destroy";

export extern fn pthread_cond_wait(cond: cstring, mutex: cstring) -> int32 = "pthread_cond_wait";

export extern fn pthread_cond_signal(cond: cstring) -> int32 = "pthread_cond_signal";

export extern fn pthread_cond_broadcast(cond: cstring) -> int32 = "pthread_cond_broadcast";

export extern fn usleep(usec: uint32) -> int32 = "usleep";

export extern fn nanosleep(req: cstring, rem: cstring) -> int32 = "nanosleep";

import "std/posix_spin";

export extern fn posix_atomic_add_i32(ptr: int32*, val: int32) -> int32 = "posix_atomic_add_i32";

import "std/mem";

export fn mutex_create_posix() -> cstring {
  var m: cstring = malloc(64);
  if (m == 0) {
    return 0;
  }
  memset(m, 0, 64);
  pthread_mutex_init(m, 0);
  return m;
}

export fn mutex_lock_posix(mutex: cstring) -> int32 {
  return pthread_mutex_lock(mutex);
}

export fn mutex_trylock_posix(mutex: cstring) -> int32 {
  return pthread_mutex_trylock(mutex);
}

export fn mutex_unlock_posix(mutex: cstring) -> int32 {
  return pthread_mutex_unlock(mutex);
}

export fn mutex_destroy_posix(mutex: cstring) -> int32 {
  return pthread_mutex_destroy(mutex);
}

export fn thread_sleep_ms_posix(milliseconds: uint32) {
  usleep(milliseconds * 1000);
}

export fn thread_join_posix(thread: int64) -> int32 {
  return pthread_join(thread, 0);
}

export fn thread_detach_posix(thread: int64) -> int32 {
  return pthread_detach(thread);
}
