// Mettle standard library: I/O (native ELF / Linux)
//
// Linux counterpart to std/io. Mettle's runtime owns the stream objects and
// implements each file and console call with Linux system calls. The import
// resolver picks this file over io.mettle on the native ELF target.

// ─── Console output ─────────────────────────────────────────────────────────
export extern fn puts(msg: cstring) -> int32;
export extern fn putchar(c: int32) -> int32;
export extern fn getchar() -> int32 = "getchar";

// Write a string exactly as-is (no trailing newline).
//
// A `string` is a pointer and a length with no terminator, so this writes
// `length` bytes and never scans for a NUL.
export fn print(msg: string) {
  if (msg.length > (uint64)0) {
    fwrite(msg.chars, 1, (int64)msg.length, get_stdout());
  }
}

// Write a string followed by a newline.
export fn println(msg: string) {
  print(msg);
  putchar(10);
}

// The boundary forms, for a pointer that arrived from C or from a byte buffer
// the program NUL-terminated itself.
export fn print_cstr(s: cstring) {
  fputs(s, get_stdout());
}

export fn println_cstr(s: cstring) {
  puts(s);
}

// Print a newline
export fn newline() {
  putchar(10);
}

// Print an integer to stdout (base 10, handles negatives)
export fn print_int(n: int64) {
  var buf: uint8[22];
  var pos: int32 = 21;
  var neg: int32 = 0;
  buf[21] = 0;
  if (n < 0) {
    neg = 1;
    n = 0 - n;
  }
  if (n == 0) {
    buf[0] = 48;
    buf[1] = 0;
    fputs(&buf[0], get_stdout());
    return;
  }
  while (n > 0) {
    pos = pos - 1;
    buf[pos] = (uint8)(48 + n - (n / 10) * 10);
    n = n / 10;
  }
  if (neg != 0) {
    pos = pos - 1;
    buf[pos] = 45;
  }
  fputs(&buf[pos], get_stdout());
}

// Print an integer followed by a newline
export fn println_int(n: int64) {
  print_int(n);
  putchar(10);
}

// ─── File I/O ───────────────────────────────────────────────────────────────
// FILE* is represented as cstring (opaque pointer)
export extern fn fopen(filename: cstring, mode: cstring) -> cstring = "fopen";
export extern fn fclose(fp: cstring) -> int32 = "fclose";
export extern fn fread(buf: cstring, size: int64, count: int64, fp: cstring) -> int64 = "fread";
export extern fn fwrite(buf: cstring, size: int64, count: int64, fp: cstring) -> int64 = "fwrite";
export extern fn fputs(s: cstring, fp: cstring) -> int32 = "fputs";
export extern fn fgets(buf: cstring, size: int32, fp: cstring) -> cstring = "fgets";
export extern fn fflush(fp: cstring) -> int32 = "fflush";

// ─── Standard streams ─────────────────────────────────────────────────────────
// The owned runtime exports its stdin, stdout, and stderr stream handles.
extern var runtime_stdin: cstring = "stdin";
extern var runtime_stdout: cstring = "stdout";
extern var runtime_stderr: cstring = "stderr";

export fn get_stdin() -> cstring  { return runtime_stdin; }
export fn get_stdout() -> cstring { return runtime_stdout; }
export fn get_stderr() -> cstring { return runtime_stderr; }

// Write message to stderr (no newline)
export fn print_err(msg: string) {
  if (msg.length > (uint64)0) {
    fwrite(msg.chars, 1, (int64)msg.length, get_stderr());
  }
}

// Write message to stderr followed by newline
export fn println_err(msg: string) {
  print_err(msg);
  fwrite("\n".chars, 1, 1, get_stderr());
}

// ─── FFI string marshalling ─────────────────────────────────────────────────
//
// See std/io: `cstr` produces the NUL-terminated copy a C function needs, and
// takes the allocator it comes from so the copy is in the signature. A string
// LITERAL needs none of it -- it is already terminated in rodata.
export fn cstr(s: string, alloc: fn(int64) -> rawptr) -> cstring {
  var n: int64 = (int64)s.length;
  var out: cstring = alloc(n + 1);
  if (out == 0) {
    return 0;
  }
  var src: cstring = s.chars;
  var i: int64 = 0;
  while (i < n) {
    out[i] = src[i];
    i = i + 1;
  }
  out[n] = 0;
  return out;
}
