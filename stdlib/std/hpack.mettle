// ---- Byte helpers -------------------------------------------------------------

fn hpack_view(p: uint8*, n: int64) -> string {
  var s: string;
  s.chars = p;
  s.length = (uint64)n;
  return s;
}

// Forward copy; safe for overlapping ranges when dst is below src.
fn hpack_copy(dst: uint8*, src: uint8*, n: int64) {
  for i in 0..n {
    dst[i] = src[i];
  }
}

// ---- Prefix integers (RFC 7541 section 5.1) -----------------------------------

// Writes `value` with an N-bit prefix. `flags` holds the pattern bits above the
// prefix (for example 0x80 for an indexed field). Returns the bytes written, or
// -1 if the value is negative, the prefix is not 1..8 bits, or it does not fit.
export fn hpack_int_encode(value: int64, prefix_bits: int32, flags: int32, out: uint8*, cap: int64) -> int64 {
  if (value < 0 || prefix_bits < 1 || prefix_bits > 8 || cap < 1) { return -1; }
  var max: int64 = ((int64)1 << prefix_bits) - 1;
  if (value < max) {
    out[0] = (uint8)(flags | (int32)value);
    return 1;
  }
  out[0] = (uint8)(flags | (int32)max);
  var rest: int64 = value - max;
  var n: int64 = 1;
  while (rest >= 128) {
    if (n >= cap) { return -1; }
    out[n] = (uint8)((int32)(rest & 127) | 128);
    rest = rest >> 7;
    n = n + 1;
  }
  if (n >= cap) { return -1; }
  out[n] = (uint8)rest;
  return n + 1;
}

// Reads an integer with an N-bit prefix. Returns the bytes used and stores the
// value, or a negative HPACK_ERR_*. Values above HPACK_INT_MAX are refused.
export fn hpack_int_decode(src: uint8*, n: int64, prefix_bits: int32, value: int64*) -> int64 {
  if (n < 1) { return HPACK_ERR_TRUNCATED; }
  if (prefix_bits < 1 || prefix_bits > 8) { return HPACK_ERR_INTEGER; }
  var max: int64 = ((int64)1 << prefix_bits) - 1;
  var v: int64 = (int64)src[0] & max;
  if (v < max) {
    *value = v;
    return 1;
  }
  var shift: int32 = 0;
  var i: int64 = 1;
  while (true) {
    if (i >= n) { return HPACK_ERR_TRUNCATED; }
    if (shift > 28) { return HPACK_ERR_INTEGER; }
    var b: int64 = (int64)src[i];
    i = i + 1;
    v = v + ((b & 127) << shift);
    if (v > HPACK_INT_MAX) { return HPACK_ERR_INTEGER; }
    if ((b & 128) == 0) { break; }
    shift = shift + 7;
  }
  *value = v;
  return i;
}

// ---- Huffman code (RFC 7541 appendix B) ---------------------------------------
//
// The code is canonical: sorted by (length, symbol), the codes count up. So the
// decoder needs only the number of codes of each length and the symbols in that
// order. EOS is symbol 256.

// Bytes the Huffman form of src[0..n) takes.
export fn hpack_huffman_encoded_len(src: uint8*, n: int64) -> int64 {
  var bits: int64 = 0;
  for i in 0..n {
    bits = bits + (int64)HPACK_HUFF_LEN[(int32)src[i]];
  }
  return (bits + 7) / 8;
}

// Huffman-encodes src[0..n) into dst, padding the last byte with ones. Returns
// the bytes written, or -1 if dst is too small.
export fn hpack_huffman_encode(src: uint8*, n: int64, dst: uint8*, cap: int64) -> int64 {
  var acc: uint64 = (uint64)0;
  var nbits: int32 = 0;
  var o: int64 = 0;
  for i in 0..n {
    var sym: int32 = (int32)src[i];
    var len: int32 = (int32)HPACK_HUFF_LEN[sym];
    acc = (acc << len) | (uint64)HPACK_HUFF_CODE[sym];
    nbits = nbits + len;
    while (nbits >= 8) {
      nbits = nbits - 8;
      if (o >= cap) { return -1; }
      dst[o] = (uint8)((acc >> nbits) & (uint64)255);
      o = o + 1;
    }
  }
  if (nbits > 0) {
    if (o >= cap) { return -1; }
    var pad: int32 = 8 - nbits;
    var last: uint64 = (acc << pad) | (((uint64)1 << pad) - (uint64)1);
    dst[o] = (uint8)(last & (uint64)255);
    o = o + 1;
  }
  return o;
}

// Decodes Huffman data. Returns the decoded length, or a negative error: the
// data holds EOS, ends with more than 7 padding bits, or the padding is not all
// ones (HPACK_ERR_HUFFMAN). With dst null it only validates and counts. A dst
// that is too small gives HPACK_ERR_NOSPACE.
export fn hpack_huffman_decode(src: uint8*, n: int64, dst: uint8*, cap: int64) -> int64 {
  var code: int32 = 0;     // bits of the current symbol so far
  var first: int32 = 0;    // first canonical code of the current length
  var index: int32 = 0;    // position in the symbol list of that first code
  var len: int32 = 0;      // bits read for the current symbol
  var ones: bool = true;   // all bits since the last symbol were ones
  var o: int64 = 0;
  for i in 0..n {
    var byte: int32 = (int32)src[i];
    for k in 0..8 {
      var bit: int32 = (byte >> (7 - k)) & 1;
      code = code | bit;
      len = len + 1;
      if (bit == 0) { ones = false; }
      var count: int32 = (int32)HPACK_HUFF_COUNT[len];
      if (code - count < first) {
        var sym: int32 = (int32)HPACK_HUFF_SYMS[index + (code - first)];
        if (sym == 256) { return HPACK_ERR_HUFFMAN; }
        if (dst != (uint8*)0) {
          if (o >= cap) { return HPACK_ERR_NOSPACE; }
          dst[o] = (uint8)sym;
        }
        o = o + 1;
        code = 0;
        first = 0;
        index = 0;
        len = 0;
        ones = true;
      } else {
        if (len >= 30) { return HPACK_ERR_HUFFMAN; }
        index = index + count;
        first = (first + count) << 1;
        code = code << 1;
      }
    }
  }
  if (len > 7 || !ones) { return HPACK_ERR_HUFFMAN; }
  return o;
}

// ---- String literals (RFC 7541 section 5.2) -----------------------------------

// Writes a length-prefixed string, Huffman-coded when `huffman` is set. Returns
// the bytes written, or -1 if it does not fit.
export fn hpack_string_encode(s: string, huffman: bool, out: uint8*, cap: int64) -> int64 {
  var n: int64 = (int64)s.length;
  if (huffman) {
    var hl: int64 = hpack_huffman_encoded_len(s.chars, n);
    var used: int64 = hpack_int_encode(hl, 7, 128, out, cap);
    if (used < 0 || used + hl > cap) { return -1; }
    if (hpack_huffman_encode(s.chars, n, out + used, cap - used) != hl) { return -1; }
    return used + hl;
  }
  var used2: int64 = hpack_int_encode(n, 7, 0, out, cap);
  if (used2 < 0 || used2 + n > cap) { return -1; }
  hpack_copy(out + used2, s.chars, n);
  return used2 + n;
}

// Reads the length prefix of a string literal. Returns the bytes used by the
// prefix, and stores the Huffman flag and the byte length of the data that
// follows. The data must lie wholly inside src[0..n).
export fn hpack_string_header(src: uint8*, n: int64, huffman: int32*, length: int64*) -> int64 {
  if (n < 1) { return HPACK_ERR_TRUNCATED; }
  var flag: int32 = ((int32)src[0] >> 7) & 1;
  var len: int64 = 0;
  var used: int64 = hpack_int_decode(src, n, 7, &len);
  if (used < 0) { return used; }
  if (len > n - used) { return HPACK_ERR_TRUNCATED; }
  *huffman = flag;
  *length = len;
  return used;
}

// Reads a string literal into dst. Returns the bytes consumed from src, and
// stores the decoded length in *out_len.
export fn hpack_string_decode(src: uint8*, n: int64, dst: uint8*, cap: int64, out_len: int64*) -> int64 {
  var huffman: int32 = 0;
  var len: int64 = 0;
  var used: int64 = hpack_string_header(src, n, &huffman, &len);
  if (used < 0) { return used; }
  if (huffman != 0) {
    var r: int64 = hpack_huffman_decode(src + used, len, dst, cap);
    if (r < 0) { return r; }
    *out_len = r;
  } else {
    if (len > cap) { return HPACK_ERR_NOSPACE; }
    hpack_copy(dst, src + used, len);
    *out_len = len;
  }
  return used + len;
}

// ---- Tables (RFC 7541 section 2.3) ---------------------------------------------

// A header field as the tables hand it out. For a dynamic entry the strings
// point into the table, and stay valid only until the next add or resize.
export struct HpackField {
  name: string;
  value: string;
}

export struct HpackEntry {
  off: int64;       // where the name starts in the table's data; the value follows
  name_len: int64;
  value_len: int64;
}

// The dynamic table. Entries sit in a ring, oldest first, and their bytes sit
// in `data` in the same order, so evicting the oldest frees the lowest bytes.
// When an add would run past the end of `data`, the live bytes slide to the
// front first.
export struct HpackTable {
  entries: HpackEntry*;
  entry_cap: int64;
  head: int64;          // ring slot of the oldest entry
  count: int64;
  data: uint8*;
  data_cap: int64;
  data_start: int64;
  data_end: int64;
  size: int64;          // sum of name + value + 32 over all entries
  max_size: int64;      // the current limit, moved by size updates
  capacity: int64;      // storage allocated; max_size never goes above it
}

// Allocates the table storage from `arena`. `capacity` is the most the table can
// ever hold (the SETTINGS_HEADER_TABLE_SIZE you accept). The table starts with
// a limit of min(capacity, 4096), the HTTP/2 default. Returns false if the
// arena is out of memory.
export fn hpack_table_init(t: HpackTable*, arena: Arena*, capacity: int64) -> bool {
  t->head = 0;
  t->count = 0;
  t->data_start = 0;
  t->data_end = 0;
  t->size = 0;
  t->capacity = capacity;
  if (capacity < 0 || arena == (Arena*)0) { return false; }
  t->entry_cap = capacity / 32 + 1;
  t->data_cap = capacity;
  t->entries = (HpackEntry*)arena_alloc(arena, t->entry_cap * (int64)sizeof(HpackEntry));
  t->data = (uint8*)arena_alloc(arena, capacity + 1);
  if (t->entries == (HpackEntry*)0 || t->data == (uint8*)0) { return false; }
  t->max_size = capacity;
  if (t->max_size > HPACK_DEFAULT_TABLE_SIZE) { t->max_size = HPACK_DEFAULT_TABLE_SIZE; }
  return true;
}

// Number of dynamic entries.
export fn hpack_table_len(t: HpackTable*) -> int64 {
  return t->count;
}

fn hpack_table_entry(t: HpackTable*, k: int64) -> HpackEntry* {
  // k = 0 is the newest entry.
  var slot: int64 = (t->head + t->count - 1 - k) % t->entry_cap;
  return &t->entries[slot];
}

fn hpack_table_evict_oldest(t: HpackTable*) {
  var e: HpackEntry* = &t->entries[t->head];
  t->size = t->size - (e->name_len + e->value_len + 32);
  t->head = (t->head + 1) % t->entry_cap;
  t->count = t->count - 1;
  if (t->count == 0) {
    t->head = 0;
    t->data_start = 0;
    t->data_end = 0;
  } else {
    t->data_start = t->entries[t->head].off;
  }
}

// Looks up an HPACK index: 1..61 is the static table, 62 and up the dynamic
// table, newest first. Returns false for 0 or an index past the end.
export fn hpack_table_get(t: HpackTable*, index: int64, out: HpackField*) -> bool {
  if (index < 1) { return false; }
  if (index <= 61) {
    out->name = HPACK_STATIC_NAME[index];
    out->value = HPACK_STATIC_VALUE[index];
    return true;
  }
  var k: int64 = index - 62;
  if (k >= t->count) { return false; }
  var e: HpackEntry* = hpack_table_entry(t, k);
  out->name = hpack_view(t->data + e->off, e->name_len);
  out->value = hpack_view(t->data + e->off + e->name_len, e->value_len);
  return true;
}

// Adds an entry as the newest, evicting the oldest ones to make room. The
// strings are copied, and must not point into the table. An entry bigger than
// the whole limit empties the table and is not added (RFC 7541 section 4.4);
// that returns false.
export fn hpack_table_add(t: HpackTable*, name: string, value: string) -> bool {
  var nl: int64 = (int64)name.length;
  var vl: int64 = (int64)value.length;
  var need: int64 = nl + vl + 32;
  if (need > t->max_size) {
    while (t->count > 0) { hpack_table_evict_oldest(t); }
    return false;
  }
  while (t->size + need > t->max_size) { hpack_table_evict_oldest(t); }
  if (t->data_end + nl + vl > t->data_cap) {
    var shift: int64 = t->data_start;
    hpack_copy(t->data, t->data + shift, t->data_end - shift);
    for k in 0..t->count {
      t->entries[(t->head + k) % t->entry_cap].off = t->entries[(t->head + k) % t->entry_cap].off - shift;
    }
    t->data_end = t->data_end - shift;
    t->data_start = 0;
  }
  var slot: int64 = (t->head + t->count) % t->entry_cap;
  t->entries[slot].off = t->data_end;
  t->entries[slot].name_len = nl;
  t->entries[slot].value_len = vl;
  hpack_copy(t->data + t->data_end, name.chars, nl);
  hpack_copy(t->data + t->data_end + nl, value.chars, vl);
  if (t->count == 0) { t->data_start = t->data_end; }
  t->data_end = t->data_end + nl + vl;
  t->count = t->count + 1;
  t->size = t->size + need;
  return true;
}

// Sets the table's current limit (a size update), clamped to 0..capacity, and
// evicts entries until it fits.
export fn hpack_table_set_max(t: HpackTable*, size: int64) {
  var s: int64 = size;
  if (s < 0) { s = 0; }
  if (s > t->capacity) { s = t->capacity; }
  t->max_size = s;
  while (t->size > t->max_size) { hpack_table_evict_oldest(t); }
}

// ---- Decoder -------------------------------------------------------------------

// One decoded field. The strings live in the arena of the HpackHeaders it was
// decoded into. `never_index` is set for the "never indexed" literal form;
// a proxy passing the field on must keep it set.
export struct HpackHeader {
  name: string;
  value: string;
  never_index: bool;
}

// The output of a decode: a growing array of fields, and the arena that holds
// both the array and every string. list_size adds up name + value + 32 per
// field, which is how SETTINGS_MAX_HEADER_LIST_SIZE counts.
export struct HpackHeaders {
  items: HpackHeader*;
  count: int64;
  cap: int64;
  list_size: int64;
  arena: Arena*;
}

export fn hpack_headers_init(h: HpackHeaders*, arena: Arena*) {
  h->items = (HpackHeader*)0;
  h->count = 0;
  h->cap = 0;
  h->list_size = 0;
  h->arena = arena;
}

// Forgets the fields so the struct can take the next block. The arena memory
// stays used until the caller resets or frees the arena.
export fn hpack_headers_clear(h: HpackHeaders*) {
  h->items = (HpackHeader*)0;
  h->count = 0;
  h->cap = 0;
  h->list_size = 0;
}

fn hpack_headers_push(h: HpackHeaders*, name: string, value: string, never: bool) -> int32 {
  if (h->count >= h->cap) {
    var cap: int64 = h->cap * 2;
    if (cap < 16) { cap = 16; }
    var bigger: HpackHeader* = (HpackHeader*)arena_alloc(h->arena, cap * (int64)sizeof(HpackHeader));
    if (bigger == (HpackHeader*)0) { return HPACK_ERR_NOSPACE; }
    for i in 0..h->count {
      bigger[i] = h->items[i];
    }
    h->items = bigger;
    h->cap = cap;
  }
  h->items[h->count].name = name;
  h->items[h->count].value = value;
  h->items[h->count].never_index = never;
  h->count = h->count + 1;
  h->list_size = h->list_size + (int64)name.length + (int64)value.length + 32;
  return HPACK_OK;
}

export struct HpackDecoder {
  table: HpackTable;
  limit: int64;           // the largest size update the peer may send
  max_list_size: int64;   // cap on name + value + 32 summed over a block
}

// Starts a decoder. `table_capacity` is the most dynamic table it will ever
// hold, and the first limit for size updates; HTTP/2 passes the
// SETTINGS_HEADER_TABLE_SIZE it advertises. `max_list_size` caps one decoded
// header list (0 picks HPACK_DEFAULT_MAX_LIST_SIZE). Returns false if the arena
// is out of memory.
export fn hpack_decoder_init(d: HpackDecoder*, arena: Arena*, table_capacity: int64, max_list_size: int64) -> bool {
  d->limit = table_capacity;
  d->max_list_size = max_list_size;
  if (max_list_size <= 0) { d->max_list_size = HPACK_DEFAULT_MAX_LIST_SIZE; }
  return hpack_table_init(&d->table, arena, table_capacity);
}

// Changes the largest size update the peer may send, when a new
// SETTINGS_HEADER_TABLE_SIZE takes effect. Clamped to the capacity given at init.
// The table keeps its current size until the peer sends an update.
export fn hpack_decoder_set_limit(d: HpackDecoder*, limit: int64) {
  var l: int64 = limit;
  if (l < 0) { l = 0; }
  if (l > d->table.capacity) { l = d->table.capacity; }
  d->limit = l;
}

// Copies n bytes into the arena, with a trailing zero byte.
fn hpack_arena_string(arena: Arena*, p: uint8*, n: int64, out: string*) -> int32 {
  var q: uint8* = (uint8*)arena_alloc(arena, n + 1);
  if (q == (uint8*)0) { return HPACK_ERR_NOSPACE; }
  hpack_copy(q, p, n);
  q[n] = (uint8)0;
  out->chars = q;
  out->length = (uint64)n;
  return HPACK_OK;
}

// Decodes one string literal into the arena. `budget` is how many bytes the
// header list may still take; a string past it is refused before any copy.
// Returns the bytes consumed from src, or a negative error.
fn hpack_dec_string(arena: Arena*, src: uint8*, n: int64, budget: int64, out: string*) -> int64 {
  var huffman: int32 = 0;
  var len: int64 = 0;
  var used: int64 = hpack_string_header(src, n, &huffman, &len);
  if (used < 0) { return used; }
  if (huffman == 0) {
    if (len > budget) { return HPACK_ERR_TOO_LARGE; }
    var r: int32 = hpack_arena_string(arena, src + used, len, out);
    if (r < 0) { return r; }
    return used + len;
  }
  var dl: int64 = hpack_huffman_decode(src + used, len, (uint8*)0, 0);
  if (dl < 0) { return dl; }
  if (dl > budget) { return HPACK_ERR_TOO_LARGE; }
  var q: uint8* = (uint8*)arena_alloc(arena, dl + 1);
  if (q == (uint8*)0) { return HPACK_ERR_NOSPACE; }
  hpack_huffman_decode(src + used, len, q, dl);
  q[dl] = (uint8)0;
  out->chars = q;
  out->length = (uint64)dl;
  return used + len;
}

// Resolves an index for the decoder. Static strings are used as they are; a
// dynamic entry is copied into the arena, because later adds in the same block
// can evict it. With want_value false only the name is filled in.
fn hpack_dec_indexed(d: HpackDecoder*, out: HpackHeaders*, index: int64, want_value: bool, name: string*, value: string*) -> int32 {
  if (index < 1) { return HPACK_ERR_INDEX; }
  var f: HpackField;
  if (!hpack_table_get(&d->table, index, &f)) { return HPACK_ERR_INDEX; }
  var need: int64 = (int64)f.name.length + 32;
  if (want_value) { need = need + (int64)f.value.length; }
  if (need > d->max_list_size - out->list_size) { return HPACK_ERR_TOO_LARGE; }
  if (index <= 61) {
    *name = f.name;
    if (want_value) { *value = f.value; }
    return HPACK_OK;
  }
  var r: int32 = hpack_arena_string(out->arena, f.name.chars, (int64)f.name.length, name);
  if (r < 0) { return r; }
  if (want_value) {
    r = hpack_arena_string(out->arena, f.value.chars, (int64)f.value.length, value);
    if (r < 0) { return r; }
  }
  return HPACK_OK;
}

// Decodes one complete header block (a HEADERS or PUSH_PROMISE block with all
// its CONTINUATIONs joined) and appends the fields to `out`. Strings and the
// array are allocated from out->arena. The decoder's dynamic table is updated as
// the block is read. Returns HPACK_OK or a negative error; after an error the
// connection must be closed. Size updates are accepted only before the first
// field, and only up to the limit.
export fn hpack_decode(d: HpackDecoder*, block: uint8*, n: int64, out: HpackHeaders*) -> int32 {
  var i: int64 = 0;
  var fields: bool = false;
  while (i < n) {
    var b: int32 = (int32)block[i];
    var name: string;
    var value: string;
    if ((b & 128) != 0) {
      // Indexed field.
      var idx: int64 = 0;
      var used: int64 = hpack_int_decode(block + i, n - i, 7, &idx);
      if (used < 0) { return (int32)used; }
      i = i + used;
      var r: int32 = hpack_dec_indexed(d, out, idx, true, &name, &value);
      if (r < 0) { return r; }
      r = hpack_headers_push(out, name, value, false);
      if (r < 0) { return r; }
      fields = true;
    } else if ((b & 224) == 32) {
      // Dynamic table size update.
      if (fields) { return HPACK_ERR_SIZE_UPDATE; }
      var size: int64 = 0;
      var used2: int64 = hpack_int_decode(block + i, n - i, 5, &size);
      if (used2 < 0) { return (int32)used2; }
      i = i + used2;
      if (size > d->limit) { return HPACK_ERR_SIZE_UPDATE; }
      hpack_table_set_max(&d->table, size);
    } else {
      // Literal field: incremental (01), without (0000) or never (0001) indexing.
      var incremental: bool = (b & 192) == 64;
      var never: bool = (b & 240) == 16;
      var prefix: int32 = 4;
      if (incremental) { prefix = 6; }
      var idx2: int64 = 0;
      var used3: int64 = hpack_int_decode(block + i, n - i, prefix, &idx2);
      if (used3 < 0) { return (int32)used3; }
      i = i + used3;
      var left: int64 = d->max_list_size - out->list_size - 32;
      if (idx2 == 0) {
        var m: int64 = hpack_dec_string(out->arena, block + i, n - i, left, &name);
        if (m < 0) { return (int32)m; }
        i = i + m;
      } else {
        var r2: int32 = hpack_dec_indexed(d, out, idx2, false, &name, &value);
        if (r2 < 0) { return r2; }
      }
      var m2: int64 = hpack_dec_string(out->arena, block + i, n - i, left - (int64)name.length, &value);
      if (m2 < 0) { return (int32)m2; }
      i = i + m2;
      var r3: int32 = hpack_headers_push(out, name, value, never);
      if (r3 < 0) { return r3; }
      if (incremental) { hpack_table_add(&d->table, name, value); }
      fields = true;
    }
  }
  return HPACK_OK;
}

// ---- Encoder -------------------------------------------------------------------

// A fixed output buffer. The encoder writes into it and never past `cap`.
export struct HpackOut {
  data: uint8*;
  cap: int64;
  len: int64;
}

export fn hpack_out_init(o: HpackOut*, data: uint8*, cap: int64) {
  o->data = data;
  o->cap = cap;
  o->len = 0;
}

export struct HpackEncoder {
  table: HpackTable;
  huffman: bool;          // Huffman-code a string when that is no longer than raw
  pending: bool;          // a size update is waiting for the next block
  pending_min: int64;     // the smallest size asked for since the last block
  pending_last: int64;    // the size asked for last
}

// Starts an encoder. `table_capacity` is the most dynamic table it will hold;
// the table starts at min(capacity, 4096). When the peer's
// SETTINGS_HEADER_TABLE_SIZE arrives, call hpack_encoder_set_table_size.
// Returns false if the arena is out of memory.
export fn hpack_encoder_init(e: HpackEncoder*, arena: Arena*, table_capacity: int64, huffman: bool) -> bool {
  e->huffman = huffman;
  e->pending = false;
  e->pending_min = 0;
  e->pending_last = 0;
  return hpack_table_init(&e->table, arena, table_capacity);
}

// Moves the table's limit, clamped to the capacity, and queues the size update
// that hpack_encode_begin writes at the start of the next block. Call it with
// the peer's SETTINGS_HEADER_TABLE_SIZE, or lower to use less memory.
export fn hpack_encoder_set_table_size(e: HpackEncoder*, size: int64) {
  var s: int64 = size;
  if (s < 0) { s = 0; }
  if (s > e->table.capacity) { s = e->table.capacity; }
  if (!e->pending) {
    if (s == e->table.max_size) { return; }
    e->pending = true;
    e->pending_min = s;
  } else if (s < e->pending_min) {
    e->pending_min = s;
  }
  e->pending_last = s;
  hpack_table_set_max(&e->table, s);
}

// Call once at the start of every header block. It writes the queued size
// updates: the smallest size first when the limit dipped and came back up
// (RFC 7541 section 4.2), then the last one. Returns HPACK_OK, or
// HPACK_ERR_NOSPACE with nothing written.
export fn hpack_encode_begin(e: HpackEncoder*, o: HpackOut*) -> int32 {
  if (!e->pending) { return HPACK_OK; }
  var start: int64 = o->len;
  if (e->pending_min < e->pending_last) {
    var a: int64 = hpack_int_encode(e->pending_min, 5, 32, o->data + o->len, o->cap - o->len);
    if (a < 0) { return HPACK_ERR_NOSPACE; }
    o->len = o->len + a;
  }
  var b: int64 = hpack_int_encode(e->pending_last, 5, 32, o->data + o->len, o->cap - o->len);
  if (b < 0) {
    o->len = start;
    return HPACK_ERR_NOSPACE;
  }
  o->len = o->len + b;
  e->pending = false;
  return HPACK_OK;
}

// Writes a string literal, Huffman-coded if that is allowed and not longer.
fn hpack_enc_string(e: HpackEncoder*, o: HpackOut*, s: string) -> bool {
  var huff: bool = false;
  if (e->huffman) {
    huff = hpack_huffman_encoded_len(s.chars, (int64)s.length) <= (int64)s.length;
  }
  var w: int64 = hpack_string_encode(s, huff, o->data + o->len, o->cap - o->len);
  if (w < 0) { return false; }
  o->len = o->len + w;
  return true;
}

// Finds the table index of a field. Sets *name_index to the first entry with the
// same name (0 if none), and returns the index of an entry that matches both
// name and value (0 if none). Static entries are searched before dynamic ones.
fn hpack_find(t: HpackTable*, name: string, value: string, name_index: int64*) -> int64 {
  var by_name: int64 = 0;
  for i in 1..62 {
    if (HPACK_STATIC_NAME[i] == name) {
      if (by_name == 0) { by_name = (int64)i; }
      if (HPACK_STATIC_VALUE[i] == value) {
        *name_index = by_name;
        return (int64)i;
      }
    }
  }
  for k in 0..t->count {
    var en: HpackEntry* = hpack_table_entry(t, k);
    if (hpack_view(t->data + en->off, en->name_len) == name) {
      if (by_name == 0) { by_name = 62 + k; }
      if (hpack_view(t->data + en->off + en->name_len, en->value_len) == value) {
        *name_index = by_name;
        return 62 + k;
      }
    }
  }
  *name_index = by_name;
  return 0;
}

// Writes one field. `mode` is HPACK_ENC_INDEX, HPACK_ENC_NO_INDEX or
// HPACK_ENC_NEVER. A field that matches a table entry exactly is written as an
// index, unless mode is HPACK_ENC_NEVER. Otherwise it is a literal: added to the
// table in INDEX mode (unless it is bigger than the whole table), and not added
// in the other two. The table changes only if the bytes fit. Returns HPACK_OK or
// HPACK_ERR_NOSPACE, which writes nothing.
export fn hpack_encode_field(e: HpackEncoder*, o: HpackOut*, name: string, value: string, mode: int32) -> int32 {
  var start: int64 = o->len;
  var name_index: int64 = 0;
  var exact: int64 = hpack_find(&e->table, name, value, &name_index);
  if (exact > 0 && mode != HPACK_ENC_NEVER) {
    var w: int64 = hpack_int_encode(exact, 7, 128, o->data + o->len, o->cap - o->len);
    if (w < 0) { return HPACK_ERR_NOSPACE; }
    o->len = o->len + w;
    return HPACK_OK;
  }
  var add: bool = mode == HPACK_ENC_INDEX;
  if (add && (int64)name.length + (int64)value.length + 32 > e->table.max_size) { add = false; }
  var prefix: int32 = 4;
  var flags: int32 = 0;
  if (add) {
    prefix = 6;
    flags = 64;
  } else if (mode == HPACK_ENC_NEVER) {
    flags = 16;
  }
  var w2: int64 = hpack_int_encode(name_index, prefix, flags, o->data + o->len, o->cap - o->len);
  if (w2 < 0) { return HPACK_ERR_NOSPACE; }
  o->len = o->len + w2;
  var ok: bool = true;
  if (name_index == 0) { ok = hpack_enc_string(e, o, name); }
  if (ok) { ok = hpack_enc_string(e, o, value); }
  if (!ok) {
    o->len = start;
    return HPACK_ERR_NOSPACE;
  }
  if (add) { hpack_table_add(&e->table, name, value); }
  return HPACK_OK;
}

// Writes a whole block: the queued size updates, then every field in `list`,
// indexed as HPACK_ENC_INDEX, or HPACK_ENC_NEVER for those with never_index set.
// On HPACK_ERR_NOSPACE the encoder's table has already moved, so give it a
// buffer that is big enough, or drop the connection.
export fn hpack_encode_block(e: HpackEncoder*, o: HpackOut*, list: HpackHeader*, count: int64) -> int32 {
  var r: int32 = hpack_encode_begin(e, o);
  if (r < 0) { return r; }
  for i in 0..count {
    var mode: int32 = HPACK_ENC_INDEX;
    if (list[i].never_index) { mode = HPACK_ENC_NEVER; }
    r = hpack_encode_field(e, o, list[i].name, list[i].value, mode);
    if (r < 0) { return r; }
  }
  return HPACK_OK;
}

