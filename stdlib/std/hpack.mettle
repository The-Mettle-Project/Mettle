// HPACK (RFC 7541): header compression for HTTP/2. No sockets and no OS
// calls, and it runs in the compile-time interpreter.
//
// Pieces, from the bottom up: prefix integers, string literals, the Huffman
// code, the static and dynamic tables, a decoder that turns a whole header
// block into name/value pairs, and an encoder that writes a field at a time.
//
// Memory: a table, a decoder and an encoder take an Arena once, at init, for
// the table storage. The decoder also takes the Arena inside HpackHeaders for
// every string and for the list itself, so reset or free that arena between
// blocks to bound memory. Nothing here frees anything.
//
// Errors are negative int32 codes (HPACK_ERR_*). A failed decode leaves the
// dynamic table in an unknown state, so the caller must close the connection
// (COMPRESSION_ERROR in HTTP/2), as RFC 9113 requires.

import "std/arena";

export const HPACK_OK = 0;
export const HPACK_ERR_TRUNCATED = -1;     // the block ends inside a field
export const HPACK_ERR_INTEGER = -2;       // an integer is too large
export const HPACK_ERR_HUFFMAN = -3;       // bad Huffman data (EOS, bad padding)
export const HPACK_ERR_INDEX = -4;         // index 0, or past the table
export const HPACK_ERR_SIZE_UPDATE = -5;   // late, or above the limit
export const HPACK_ERR_TOO_LARGE = -6;     // the header list is over its cap
export const HPACK_ERR_NOSPACE = -7;       // output buffer full, or arena out of memory

export const HPACK_STATIC_COUNT = 61;
export const HPACK_DEFAULT_TABLE_SIZE = 4096;   // the HTTP/2 default for SETTINGS_HEADER_TABLE_SIZE
export const HPACK_ENTRY_OVERHEAD = 32;         // bytes added to every entry's size
export const HPACK_INT_MAX: int64 = 4294967295; // largest integer the decoder accepts
export const HPACK_DEFAULT_MAX_LIST_SIZE = 65536;

// How the encoder may index a field.
export const HPACK_ENC_INDEX = 0;       // indexed if it matches, else added to the table
export const HPACK_ENC_NO_INDEX = 1;    // never added to the table
export const HPACK_ENC_NEVER = 2;       // never added, and proxies must not add it either

export fn hpack_error_name(code: int32) -> string {
  switch (code) {
    case 0: { return "ok"; }
    case -1: { return "truncated header block"; }
    case -2: { return "integer too large"; }
    case -3: { return "bad Huffman data"; }
    case -4: { return "bad table index"; }
    case -5: { return "bad table size update"; }
    case -6: { return "header list too large"; }
    case -7: { return "out of space"; }
    default: { return "unknown error"; }
  }
}

// ---- Tables of constants (RFC 7541 appendices A and B) ----

