export extern fn posix_cas_i32(ptr: int32*, expected: int32, desired: int32) -> int32 = "posix_cas_i32";
export extern fn posix_yield() = "posix_yield";
export extern fn posix_atomic_exchange_i32(ptr: int32*, val: int32) -> int32 = "posix_atomic_exchange_i32";

export fn posix_spin_try_lock(lock_var: int32*) -> int32 {
  if (posix_cas_i32(lock_var, 0, 1) == 0) {
    return 1;
  }
  return 0;
}

export fn posix_spin_lock(lock_var: int32*) {
  while (posix_spin_try_lock(lock_var) == 0) {
    posix_yield();
  }
}

export fn posix_spin_unlock(lock_var: int32*) {
  posix_atomic_exchange_i32(lock_var, 0);
}
