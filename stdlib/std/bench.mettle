// High-resolution timing for benchmarks (QueryPerformanceCounter on Windows).

var g_bench_qpc_freq: int64 = 0;

extern fn QueryPerformanceCounter(counter: int64*) -> int32 = "QueryPerformanceCounter";
extern fn QueryPerformanceFrequency(frequency: int64*) -> int32 = "QueryPerformanceFrequency";

export fn bench_time_us() -> int64 {
  if (g_bench_qpc_freq == 0) {
    QueryPerformanceFrequency(&g_bench_qpc_freq);
  }
  var counter: int64 = 0;
  QueryPerformanceCounter(&counter);
  if (g_bench_qpc_freq == 0) {
    return 0;
  }
  return (counter * 1000000) / g_bench_qpc_freq;
}
