import "std/arena";
import "std/conv";
import "std/mem";

export struct StrBuf {
  arena: Arena*;
  data: cstring;
  len: int64;
  cap: int64;
}

fn strbuf_default_cap() -> int64 {
  return (int64)64;
}

fn strbuf_bytes() -> int64 {
  return (int64)32;
}

fn strbuf_grow(b: StrBuf*, needed: int64) -> int32 {
  if (b == 0 || b->arena == 0) { return 0; }
  if (needed < (int64)0) { return 0; }
  if (needed <= b->cap) { return 1; }

  var new_cap: int64 = b->cap;
  if (new_cap <= (int64)0) { new_cap = strbuf_default_cap(); }
  while (new_cap < needed) {
    if (new_cap > (int64)2305843009213693951) { return 0; }
    new_cap = new_cap * (int64)2;
  }

  var new_block: cstring = arena_alloc(b->arena, new_cap + (int64)1);
  if (new_block == 0) { return 0; }

  if (b->data != 0 && b->len > (int64)0) {
    memcpy(new_block, b->data, b->len);
  }
  b->data = new_block;
  b->cap = new_cap;
  return 1;
}

export fn strbuf_new(arena: Arena*, initial_cap: int64) -> StrBuf* {
  if (arena == 0) { return 0; }
  var raw: cstring = arena_alloc(arena, strbuf_bytes());
  if (raw == 0) { return 0; }
  var b: StrBuf* = (StrBuf*)raw;
  b->arena = arena;
  b->data = 0;
  b->len = (int64)0;
  b->cap = (int64)0;
  var cap: int64 = initial_cap;
  if (cap <= (int64)0) { cap = strbuf_default_cap(); }
  if (strbuf_grow(b, cap) == 0) { return 0; }
  return b;
}

export fn strbuf_len(b: StrBuf*) -> int64 {
  if (b == 0) { return (int64)0; }
  return b->len;
}

export fn strbuf_append_byte(b: StrBuf*, c: uint8) -> int32 {
  if (b == 0) { return 0; }
  if (strbuf_grow(b, b->len + (int64)1) == 0) { return 0; }
  b->data[b->len] = c;
  b->len = b->len + (int64)1;
  return 1;
}

export fn strbuf_append_bytes(b: StrBuf*, src: cstring, n: int64) -> int32 {
  if (b == 0) { return 0; }
  if (n <= (int64)0 || src == 0) { return 1; }
  if (strbuf_grow(b, b->len + n) == 0) { return 0; }
  memcpy((cstring)((int64)b->data + b->len), src, n);
  b->len = b->len + n;
  return 1;
}

export fn strbuf_append_cstr(b: StrBuf*, s: cstring) -> int32 {
  if (b == 0 || s == 0) { return 0; }
  var n: int64 = (int64)0;
  while (s[n] != (uint8)0) {
    n = n + (int64)1;
  }
  return strbuf_append_bytes(b, s, n);
}

export fn strbuf_append_string(b: StrBuf*, s: string) -> int32 {
  if (b == 0) { return 0; }
  return strbuf_append_bytes(b, s.chars, (int64)s.length);
}

export fn strbuf_append_int(b: StrBuf*, n: int64) -> int32 {
  if (b == 0) { return 0; }
  if (n == (int64)0) {
    return strbuf_append_byte(b, (uint8)48);
  }

  var tmp: uint8[24];
  var i: int32 = 0;

  var negative: int32 = 0;
  var v: int64 = n;
  if (v < (int64)0) {
    negative = 1;
    var last_digit: int64 = -(v % (int64)10);
    if (last_digit < (int64)0) { last_digit = -last_digit; }
    tmp[i] = (uint8)((int32)last_digit + 48);
    i = i + 1;
    v = -(v / (int64)10);
  }

  while (v > (int64)0) {
    var d: int64 = v % (int64)10;
    tmp[i] = (uint8)((int32)d + 48);
    i = i + 1;
    v = v / (int64)10;
  }

  if (negative != 0) {
    if (strbuf_append_byte(b, (uint8)45) == 0) { return 0; }
  }
  while (i > 0) {
    i = i - 1;
    if (strbuf_append_byte(b, tmp[i]) == 0) { return 0; }
  }
  return 1;
}

export fn strbuf_append_uint(b: StrBuf*, n: uint64) -> int32 {
  if (b == 0) { return 0; }
  if (n == (uint64)0) {
    return strbuf_append_byte(b, (uint8)48);
  }
  var tmp: uint8[24];
  var i: int32 = 0;
  var v: uint64 = n;
  while (v > (uint64)0) {
    var d: uint64 = v % (uint64)10;
    tmp[i] = (uint8)((int32)d + 48);
    i = i + 1;
    v = v / (uint64)10;
  }
  while (i > 0) {
    i = i - 1;
    if (strbuf_append_byte(b, tmp[i]) == 0) { return 0; }
  }
  return 1;
}

export fn strbuf_append_hex(b: StrBuf*, n: uint64) -> int32 {
  if (b == 0) { return 0; }
  if (n == (uint64)0) {
    return strbuf_append_byte(b, (uint8)48);
  }
  var tmp: uint8[16];
  var i: int32 = 0;
  var v: uint64 = n;
  while (v > (uint64)0) {
    var d: uint64 = v & (uint64)15;
    var c: uint8;
    if (d < (uint64)10) {
      c = (uint8)((int32)d + 48);
    } else {
      c = (uint8)((int32)d + 87);
    }
    tmp[i] = c;
    i = i + 1;
    v = v >> (uint64)4;
  }
  while (i > 0) {
    i = i - 1;
    if (strbuf_append_byte(b, tmp[i]) == 0) { return 0; }
  }
  return 1;
}

export fn strbuf_finish_string(b: StrBuf*) -> string {
  if (b == 0) { return str_from_bytes(0, 0); }
  return str_from_bytes(b->data, b->len);
}

export fn strbuf_finish_cstr(b: StrBuf*) -> cstring {
  if (b == 0) { return 0; }
  if (b->data == 0) {
    var z: cstring = arena_alloc(b->arena, (int64)1);
    if (z == 0) { return 0; }
    z[0] = (uint8)0;
    return z;
  }
  b->data[b->len] = (uint8)0;
  return b->data;
}
