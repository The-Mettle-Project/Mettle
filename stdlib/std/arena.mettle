import "std/mem";

fn arena_default_chunk_size() -> int64 {
  return (int64)65536;
}

fn arena_first_default_chunk() -> int64 {
  return (int64)4048;
}

fn arena_default_alignment() -> int64 {
  return (int64)8;
}

export struct ArenaChunk {
  next: ArenaChunk*;
  base: cstring;
  used: int64;
  cap: int64;
  id: int64;
}

export struct Arena {
  head: ArenaChunk*;
  free_list: ArenaChunk*;
  chunk_size: int64;
  next_chunk_cap: int64;
  next_chunk_id: int64;
  total_used: int64;
  total_cap: int64;
}

export struct ArenaSave {
  chunk_id: int64;
  used: int64;
}

export struct ArenaStats {
  total_used: int64;
  total_cap: int64;
  chunk_count: int32;
  free_chunk_count: int32;
}

fn arena_chunk_header() -> int64 {
  return (int64)48;
}

fn arena_chunk_new(a: Arena*, cap: int64) -> ArenaChunk* {
  if (cap <= (int64)0) {
    return 0;
  }
  var raw: cstring = malloc(arena_chunk_header() + cap);
  if (raw == 0) {
    return 0;
  }
  var ch: ArenaChunk* = (ArenaChunk*)raw;
  ch->base = raw + arena_chunk_header();
  ch->next = 0;
  ch->used = (int64)0;
  ch->cap = cap;
  ch->id = a->next_chunk_id;
  a->next_chunk_id = a->next_chunk_id + (int64)1;
  a->total_cap = a->total_cap + cap;
  return ch;
}

fn arena_pop_free_chunk(a: Arena*, min_cap: int64) -> ArenaChunk* {
  if (a == 0 || a->free_list == 0) {
    return 0;
  }
  var prev: ArenaChunk* = 0;
  var cur: ArenaChunk* = a->free_list;
  while (cur != 0) {
    if (cur->cap >= min_cap) {
      if (prev == 0) {
        a->free_list = cur->next;
      } else {
        prev->next = cur->next;
      }
      cur->next = 0;
      cur->used = (int64)0;
      return cur;
    }
    prev = cur;
    cur = cur->next;
  }
  return 0;
}

fn arena_push_free_chunk(a: Arena*, ch: ArenaChunk*) {
  if (a == 0 || ch == 0) {
    return;
  }
  ch->used = (int64)0;
  ch->next = a->free_list;
  a->free_list = ch;
}

export fn arena_init(default_chunk_size: int64) -> Arena* {
  var a: Arena* = (Arena*)malloc(sizeof(Arena));
  if (a == 0) {
    return 0;
  }
  a->head = 0;
  a->free_list = 0;
  if (default_chunk_size <= (int64)0) {
    a->chunk_size = arena_default_chunk_size();
    a->next_chunk_cap = arena_first_default_chunk();
  } else {
    a->chunk_size = default_chunk_size;
    a->next_chunk_cap = default_chunk_size;
  }
  a->next_chunk_id = (int64)1;
  a->total_used = (int64)0;
  a->total_cap = (int64)0;
  return a;
}

fn arena_align_up(value: int64, align: int64) -> int64 {
  if (align <= (int64)1) {
    return value;
  }
  return (value + (align - (int64)1)) & ~(align - (int64)1);
}

fn arena_next_chunk(a: Arena*, need: int64) -> ArenaChunk* {
  var ch: ArenaChunk* = arena_pop_free_chunk(a, need);
  if (ch != 0) {
    return ch;
  }
  var cap: int64 = a->next_chunk_cap;
  if (cap < need) {
    cap = need;
  }
  ch = arena_chunk_new(a, cap);
  if (ch != 0 && a->next_chunk_cap < a->chunk_size) {
    a->next_chunk_cap = a->next_chunk_cap * (int64)2;
    if (a->next_chunk_cap > a->chunk_size) {
      a->next_chunk_cap = a->chunk_size;
    }
  }
  return ch;
}

export fn arena_alloc_aligned(a: Arena*, n: int64, align: int64) -> rawptr {
  if (a == 0 || n < (int64)0) {
    return 0;
  }

  var effective_align: int64 = align;
  if (effective_align <= (int64)1) {
    effective_align = arena_default_alignment();
  }

  if (a->head != 0) {
    var base_addr: int64 = (int64)a->head->base;
    var raw_pos: int64 = base_addr + a->head->used;
    var aligned_pos: int64 = arena_align_up(raw_pos, effective_align);
    var new_used: int64 = (aligned_pos - base_addr) + n;
    if (new_used <= a->head->cap) {
      a->total_used = a->total_used + (new_used - a->head->used);
      a->head->used = new_used;
      return a->head->base + (aligned_pos - base_addr);
    }
  }

  var ch: ArenaChunk* = arena_next_chunk(a, n + effective_align);
  if (ch == 0) {
    return 0;
  }
  ch->next = a->head;
  a->head = ch;

  var base2: int64 = (int64)ch->base;
  var aligned2: int64 = arena_align_up(base2, effective_align);
  ch->used = (aligned2 - base2) + n;
  a->total_used = a->total_used + ch->used;
  return ch->base + (aligned2 - base2);
}

export fn arena_alloc(a: Arena*, n: int64) -> rawptr {
  return arena_alloc_aligned(a, n, arena_default_alignment());
}

export fn arena_alloc_zeroed(a: Arena*, n: int64) -> rawptr {
  var p: cstring = arena_alloc(a, n);
  if (p == 0 || n <= (int64)0) {
    return p;
  }
  mem_zero(p, n);
  return p;
}

export fn arena_save(a: Arena*) -> ArenaSave {
  var s: ArenaSave;
  s.chunk_id = (int64)0;
  s.used = (int64)0;
  if (a != 0 && a->head != 0) {
    s.chunk_id = a->head->id;
    s.used = a->head->used;
  }
  return s;
}

export fn arena_restore(a: Arena*, save: ArenaSave) {
  if (a == 0) {
    return;
  }

  while (a->head != 0 && a->head->id != save.chunk_id) {
    var doomed: ArenaChunk* = a->head;
    a->head = doomed->next;
    a->total_used = a->total_used - doomed->used;
    arena_push_free_chunk(a, doomed);
  }

  if (a->head != 0 && a->head->id == save.chunk_id) {
    var current_used: int64 = a->head->used;
    if (save.used < current_used) {
      a->total_used = a->total_used - (current_used - save.used);
      a->head->used = save.used;
    }
  }
}

export fn arena_reset(a: Arena*) {
  if (a == 0) {
    return;
  }
  while (a->head != 0) {
    var doomed: ArenaChunk* = a->head;
    a->head = doomed->next;
    arena_push_free_chunk(a, doomed);
  }
  a->total_used = (int64)0;
}

export fn arena_free(a: Arena*) {
  if (a == 0) {
    return;
  }
  while (a->head != 0) {
    var next_active: ArenaChunk* = a->head->next;
    free(a->head);
    a->head = next_active;
  }
  while (a->free_list != 0) {
    var next_free: ArenaChunk* = a->free_list->next;
    free(a->free_list);
    a->free_list = next_free;
  }
  free(a);
}

export fn arena_stats(a: Arena*) -> ArenaStats {
  var s: ArenaStats;
  s.total_used = (int64)0;
  s.total_cap = (int64)0;
  s.chunk_count = 0;
  s.free_chunk_count = 0;
  if (a == 0) {
    return s;
  }
  s.total_used = a->total_used;
  s.total_cap = a->total_cap;
  var cur: ArenaChunk* = a->head;
  while (cur != 0) {
    s.chunk_count = s.chunk_count + 1;
    cur = cur->next;
  }
  var f: ArenaChunk* = a->free_list;
  while (f != 0) {
    s.free_chunk_count = s.free_chunk_count + 1;
    f = f->next;
  }
  return s;
}
