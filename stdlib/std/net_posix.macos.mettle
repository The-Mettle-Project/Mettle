import "std/core";
import "std/mem";

export var posix_net_ref_count: int32 = 0;
export var posix_net_ref_lock: int32 = 0;

export fn AF_INET_POSIX() -> int32     { return 2; }
export fn SOCK_STREAM_POSIX() -> int32 { return 1; }
export fn SOCK_DGRAM_POSIX() -> int32  { return 2; }
export fn IPPROTO_TCP_POSIX() -> int32 { return 6; }
export fn IPPROTO_UDP_POSIX() -> int32 { return 17; }

export fn SOL_SOCKET_POSIX() -> int32  { return 65535; }
export fn SO_REUSEADDR_POSIX() -> int32 { return 4; }

export fn SHUT_RD_POSIX() -> int32  { return 0; }
export fn SHUT_WR_POSIX() -> int32  { return 1; }
export fn SHUT_RDWR_POSIX() -> int32 { return 2; }

export fn INADDR_ANY_POSIX() -> int32 { return 0; }

export extern fn socket(af: int32, sock_type: int32, protocol: int32) -> int32 = "socket";

export extern fn close_fd(fd: int64) -> int32 = "close";

export extern fn posix_shutdown(fd: int64, how: int32) -> int32 = "shutdown";

export extern fn posix_connect(fd: int64, addr: cstring, addrlen: int32) -> int32 = "connect";

export extern fn posix_bind(fd: int64, addr: cstring, addrlen: int32) -> int32 = "bind";

export extern fn posix_listen(fd: int64, backlog: int32) -> int32 = "listen";

export extern fn posix_accept(fd: int64, addr: cstring, addrlen: cstring) -> int32 = "accept";

export extern fn posix_setsockopt(fd: int64, level: int32, optname: int32, optval: cstring, optlen: int32) -> int32 = "setsockopt";

export extern fn posix_send(fd: int64, buf: cstring, len: int64, flags: int32) -> int64 = "send";
export extern fn posix_recv(fd: int64, buf: cstring, len: int64, flags: int32) -> int64 = "recv";

export extern fn htons(hostshort: int32) -> int32 = "htons";
export extern fn htonl(hostlong: int32) -> int32 = "htonl";
export extern fn ntohs(netshort: int32) -> int32 = "ntohs";
export extern fn ntohl(netlong: int32) -> int32 = "ntohl";
export extern fn inet_addr(cp: cstring) -> int32 = "inet_addr";

export extern fn posix_get_errno() -> int32 = "posix_get_errno";

export fn net_posix_last_error() -> int32 {
  return posix_get_errno();
}

import "std/posix_spin";

export fn net_posix_init() -> Result<int32, int32> {
  posix_spin_lock(&posix_net_ref_lock);
  posix_net_ref_count = posix_net_ref_count + 1;
  posix_spin_unlock(&posix_net_ref_lock);
  return Ok(0);
}

export fn net_posix_cleanup() -> int32 {
  posix_spin_lock(&posix_net_ref_lock);
  if (posix_net_ref_count > 0) {
    posix_net_ref_count = posix_net_ref_count - 1;
  }
  posix_spin_unlock(&posix_net_ref_lock);
  return 0;
}

export fn net_posix_is_initialized() -> int32 {
  var ready: int32 = 0;
  posix_spin_lock(&posix_net_ref_lock);
  if (posix_net_ref_count > 0) {
    ready = 1;
  }
  posix_spin_unlock(&posix_net_ref_lock);
  return ready;
}

export fn socket_tcp_posix() -> Result<int64, int32> {
  var s: int64 = socket(AF_INET_POSIX(), SOCK_STREAM_POSIX(), IPPROTO_TCP_POSIX());
  if (s < 0) { return Err(net_posix_last_error()); }
  return Ok(s);
}

export fn socket_udp_posix() -> Result<int64, int32> {
  var s: int64 = socket(AF_INET_POSIX(), SOCK_DGRAM_POSIX(), IPPROTO_UDP_POSIX());
  if (s < 0) { return Err(net_posix_last_error()); }
  return Ok(s);
}

export fn sockaddr_in_posix(ip: cstring, port: int32) -> Result<cstring, int32> {
  var buf: cstring = malloc(16);
  if (buf == 0) {
    return Err(0);
  }
  memset(buf, 0, 16);

  buf[0] = 16;
  buf[1] = 2;

  var net_port: int32 = htons(port);
  buf[2] = (uint8)net_port;
  buf[3] = (uint8)(net_port / 256);

  var addr: int32 = inet_addr(ip);
  buf[4] = (uint8)addr;
  buf[5] = (uint8)(addr / 256);
  buf[6] = (uint8)(addr / 65536);
  buf[7] = (uint8)(addr / 16777216);

  return Ok(buf);
}

export fn sockaddr_in_any_posix(port: int32) -> Result<cstring, int32> {
  var buf: cstring = malloc(16);
  if (buf == 0) {
    return Err(0);
  }

  memset(buf, 0, 16);
  buf[0] = 16;
  buf[1] = 2;

  var net_port: int32 = htons(port);
  buf[2] = (uint8)net_port;
  buf[3] = (uint8)(net_port / 256);

  return Ok(buf);
}

export fn set_reuseaddr_posix(sock: int64, enabled: int32) -> int32 {
  var opt: uint8[4];
  if (enabled != 0) {
    opt[0] = 1;
  } else {
    opt[0] = 0;
  }
  opt[1] = 0;
  opt[2] = 0;
  opt[3] = 0;
  return posix_setsockopt(sock, SOL_SOCKET_POSIX(), SO_REUSEADDR_POSIX(), &opt[0], 4);
}

export fn send_all_posix(sock: int64, buf: cstring, len: int64) -> Result<int64, int32> {
  var total: int64 = 0;
  while (total < len) {
    var sent: int64 = posix_send(sock, &buf[total], len - total, 0);
    if (sent <= 0) {
      return Err(net_posix_last_error());
    }
    total = total + sent;
  }
  return Ok(total);
}
