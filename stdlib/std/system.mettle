// Mettle standard library: System
//
// Process spawning through Mettle's owned process layer.
// Use for running shell commands (Mettle, nasm, gcc, git, curl, etc.).
//
// On Windows: invokes cmd.exe /c <cmd> with CreateProcess.
// On Linux: invokes sh -c <cmd> with fork and execve system calls.
//
// Returns the command's exit status, or -1 on error.

export extern fn system(cmd: cstring) -> int32 = "system";
