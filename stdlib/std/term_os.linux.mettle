// Linux terminals for std/term: the TCGETS and TCSETS ioctls, which take the
// kernel's struct termios (4 flag words, then the line and control chars).

import "std/linux_sys";

const TCGETS = 0x5401;
const TCSETS = 0x5402;
const LFLAG_AT = 3;   // c_lflag is the 4th 32-bit word
const ECHO = 8;
const ISIG = 1;
const ICANON = 2;

export fn term_is_tty(fd: int64) -> bool {
  var t: uint32[16];
  return syscall(LINUX_SYS_IOCTL, fd, TCGETS, &t[0]) == 0;
}

// Turns echo on or off. Returns 1 or 0 for whether echo was on before, or a
// negative error code (-25, ENOTTY, when fd is not a terminal).
export fn term_set_echo(fd: int64, on: bool) -> int64 {
  var t: uint32[16];
  var r: int64 = syscall(LINUX_SYS_IOCTL, fd, TCGETS, &t[0]);
  if (r < 0) { return r; }
  var was: int64 = 0;
  if ((t[LFLAG_AT] & (uint32)ECHO) != (uint32)0) { was = 1; }
  if (on) {
    t[LFLAG_AT] = t[LFLAG_AT] | (uint32)ECHO;
  } else {
    t[LFLAG_AT] = t[LFLAG_AT] & ~(uint32)ECHO;
  }
  r = syscall(LINUX_SYS_IOCTL, fd, TCSETS, &t[0]);
  if (r < 0) { return r; }
  return was;
}

export fn term_os_read(fd: int64, buf: uint8*, n: int64) -> int64 {
  return syscall(LINUX_SYS_READ, fd, buf, n);
}

export fn term_os_write(fd: int64, buf: uint8*, n: int64) -> int64 {
  return syscall(LINUX_SYS_WRITE, fd, buf, n);
}

// For a secret prompt: echo off, the line editor off (so Ctrl-C arrives at
// once), and Ctrl-C / Ctrl-\ delivered as bytes instead of signals, so the
// caller can put the terminal back before acting on them. The whole termios
// is saved for term_os_secret_end. Returns 0, or a negative code when fd is
// not a terminal.
var g_term_saved: uint32[16];

export fn term_os_secret_begin(fd: int64) -> int64 {
  var r: int64 = syscall(LINUX_SYS_IOCTL, fd, TCGETS, &g_term_saved[0]);
  if (r < 0) { return r; }
  var t: uint32[16];
  for i in 0..16 { t[i] = g_term_saved[i]; }
  t[LFLAG_AT] = t[LFLAG_AT] & ~((uint32)ECHO | (uint32)ISIG | (uint32)ICANON);
  // c_cc starts at byte 17: VTIME is c_cc[5] and VMIN c_cc[6]. Wait for one
  // byte, with no timer.
  var cc: uint8* = (uint8*)&t[0];
  cc[17 + 5] = (uint8)0;
  cc[17 + 6] = (uint8)1;
  return syscall(LINUX_SYS_IOCTL, fd, TCSETS, &t[0]);
}

export fn term_os_secret_end(fd: int64) {
  syscall(LINUX_SYS_IOCTL, fd, TCSETS, &g_term_saved[0]);
}

// Sends sig to this process, as the terminal would have.
export fn term_os_raise(sig: int32) {
  syscall(LINUX_SYS_KILL, syscall(LINUX_SYS_GETPID), (int64)sig);
}

export const TERM_SIGINT = 2;
export const TERM_SIGQUIT = 3;
