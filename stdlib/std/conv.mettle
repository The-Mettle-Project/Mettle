import "std/core";

export extern fn atoi(s: cstring) -> int32 = "atoi";
export extern fn atol(s: cstring) -> int64 = "atol";

export fn digit_to_char(d: int32) -> char {
  return (char)(d + 48);
}

export fn char_to_digit(c: char) -> int32 {
  return c - '0';
}

export fn is_digit(c: char) -> bool {
  return c >= '0' && c <= '9';
}

export fn is_upper(c: char) -> bool {
  return c >= 'A' && c <= 'Z';
}

export fn is_lower(c: char) -> bool {
  return c >= 'a' && c <= 'z';
}

export fn is_alpha(c: char) -> bool {
  return is_upper(c) || is_lower(c);
}

export fn is_alnum(c: char) -> bool {
  return is_alpha(c) || is_digit(c);
}

export fn is_space(c: char) -> bool {
  return (c == ' ' || c == '\t' || c == '\n' || c == '\r' ||
          c == (char)12 || c == (char)11);
}

export fn to_lower(c: char) -> char {
  if (is_upper(c)) { return (char)(c + 32); }
  return c;
}

export fn to_upper(c: char) -> char {
  if (is_lower(c)) { return (char)(c - 32); }
  return c;
}

export fn str_from_bytes(p: cstring, n: int64) -> string {
  var out: string;
  out.chars = p;
  out.length = (uint64)n;
  if (p == 0 || n < 0) {
    out.length = (uint64)0;
  }
  return out;
}

export fn str_from_cstr(s: cstring) -> string {
  if (s == 0) {
    return str_from_bytes(s, 0);
  }
  return str_from_bytes(s, cstr_len(s));
}

export fn str_slice(s: string, start: int64, len: int64) -> string {
  var out: string;
  var n: int64 = (int64)s.length;
  var from: int64 = start;
  var take: int64 = len;

  if (from < 0) { from = 0; }
  if (from > n) { from = n; }
  if (take < 0) { take = 0; }
  if (from + take > n) { take = n - from; }

  out.chars = s.chars + from;
  out.length = (uint64)take;
  return out;
}

export fn str_eq_at(s: string, offset: int64, needle: string) -> int32 {
  var n: int64 = (int64)s.length;
  var m: int64 = (int64)needle.length;

  if (offset < 0) { return 0; }
  if (offset + m > n) { return 0; }

  var i: int64 = 0;
  while (i < m) {
    if (s.chars[offset + i] != needle.chars[i]) { return 0; }
    i = i + 1;
  }
  return 1;
}

export fn str_starts_with(s: string, prefix: string) -> int32 {
  return str_eq_at(s, 0, prefix);
}

export fn str_ends_with(s: string, suffix: string) -> int32 {
  return str_eq_at(s, (int64)s.length - (int64)suffix.length, suffix);
}

export fn str_find(s: string, needle: string) -> Option<int64> {
  var n: int64 = (int64)s.length;
  var m: int64 = (int64)needle.length;

  if (m > n) { return None; }

  var i: int64 = 0;
  while (i + m <= n) {
    if (str_eq_at(s, i, needle) == 1) { return Some(i); }
    i = i + 1;
  }
  return None;
}

export fn str_contains(s: string, needle: string) -> int32 {
  match (str_find(s, needle)) {
    case Some(at): { return 1; }
    case None: { return 0; }
  }
}

export fn str_compare(a: string, b: string) -> int32 {
  var common: int64 = (int64)a.length;
  if ((int64)b.length < common) { common = (int64)b.length; }
  var i: int64 = 0;
  while (i < common) {
    var ac: int32 = (int32)(uint8)a.chars[i];
    var bc: int32 = (int32)(uint8)b.chars[i];
    if (ac < bc) { return -1; }
    if (ac > bc) { return 1; }
    i = i + 1;
  }
  if (a.length < b.length) { return -1; }
  if (a.length > b.length) { return 1; }
  return 0;
}

export fn str_count(s: string, needle: string) -> int64 {
  var m: int64 = (int64)needle.length;
  if (m == 0) { return (int64)s.length + 1; }
  var count: int64 = 0;
  var offset: int64 = 0;
  while (offset + m <= (int64)s.length) {
    if (str_eq_at(s, offset, needle) == 1) {
      count = count + 1;
      offset = offset + m;
    } else {
      offset = offset + 1;
    }
  }
  return count;
}

export fn str_find_byte(s: string, c: int32) -> Option<int64> {
  var n: int64 = (int64)s.length;
  var i: int64 = 0;
  while (i < n) {
    if ((int32)s.chars[i] == c) { return Some(i); }
    i = i + 1;
  }
  return None;
}

export fn str_trim_start(s: string) -> string {
  var n: int64 = (int64)s.length;
  var i: int64 = 0;
  while (i < n) {
    if (!is_space(s[i])) { break; }
    i = i + 1;
  }
  return str_slice(s, i, n - i);
}

export fn str_trim_end(s: string) -> string {
  var n: int64 = (int64)s.length;
  while (n > 0) {
    if (!is_space(s[n - 1])) { break; }
    n = n - 1;
  }
  return str_slice(s, 0, n);
}

export fn str_trim(s: string) -> string {
  return str_trim_start(str_trim_end(s));
}

export struct StrSplit {
  head: string;
  tail: string;
}

export fn str_split_once(s: string, sep: string) -> Option<StrSplit> {
  var at: int64 = 0;
  match (str_find(s, sep)) {
    case Some(found): { at = found; }
    case None: { return None; }
  }
  var after: int64 = at + (int64)sep.length;
  var out: StrSplit;
  out.head = str_slice(s, 0, at);
  out.tail = str_slice(s, after, (int64)s.length - after);
  return Some(out);
}

export fn str_to_i64(s: string) -> Result<int64, string> {
  var n: int64 = (int64)s.length;
  if (n == 0) { return Err("empty"); }

  var i: int64 = 0;
  var negative: int32 = 0;
  if (s[0] == '-') {
    negative = 1;
    i = 1;
  } else if (s[0] == '+') {
    i = 1;
  }
  if (i >= n) { return Err("sign with no digits"); }

  var limit: uint64 = 9223372036854775807;
  if (negative == 1) { limit = 9223372036854775808; }

  var value: uint64 = 0;
  while (i < n) {
    var c: char = s[i];
    if (!is_digit(c)) { return Err("not a decimal digit"); }
    var digit: uint64 = (uint64)char_to_digit(c);
    if (value > (limit - digit) / 10) {
      return Err("out of range for int64");
    }
    value = value * 10 + digit;
    i = i + 1;
  }

  if (negative == 1) {
    if (value == 9223372036854775808) { return Ok(-9223372036854775808); }
    return Ok(0 - (int64)value);
  }
  return Ok((int64)value);
}

export fn str_to_i64_or(s: string, fallback: int64) -> int64 {
  match (str_to_i64(s)) {
    case Ok(v): { return v; }
    case Err(why): { return fallback; }
  }
}

export fn i64_to_str(n: int64, buf: uint8*, buf_len: int64) -> string {
  var out: string;
  out.chars = buf;
  out.length = (uint64)0;
  if (buf_len < 21) { return out; }

  var written: int32 = int_to_dec(buf, n);
  out.length = (uint64)written;
  return out;
}

export fn cstr_len(s: cstring) -> int64 {
  var i: int64 = 0;
  while (s[i] != 0) {
    i = i + 1;
  }
  return i;
}

export fn int_to_dec(buf: uint8*, n: int64) -> int32 {
  var tmp: int32[32];
  var value: int64 = n;
  var digits: int32 = 0;
  var pos: int32 = 0;

  if (value == 0) {
    buf[0] = 48;
    buf[1] = 0;
    return 1;
  }

  if (value < 0) {
    buf[0] = 45;
    pos = 1;
  }

  while (value <= -10 || value >= 10) {
    var digit: int32 = (int32)(value % 10);
    if (digit < 0) {
      digit = 0 - digit;
    }
    tmp[digits] = digit;
    digits = digits + 1;
    value = value / 10;
  }

  var final_digit: int32 = (int32)value;
  if (final_digit < 0) {
    final_digit = 0 - final_digit;
  }
  tmp[digits] = final_digit;
  digits = digits + 1;

  var i: int32 = digits - 1;
  while (i >= 0) {
    buf[pos] = (uint8)digit_to_char(tmp[i]);
    pos = pos + 1;
    i = i - 1;
  }

  buf[pos] = 0;
  return pos;
}

export fn format_i64(buf: uint8*, buf_len: int32, pattern: string, value: int64) -> int32 {
  var num_buf: uint8[32];
  var num_len: int32 = int_to_dec(&num_buf[0], value);
  var src: int32 = 0;
  var dst: int32 = 0;

  if (buf_len <= 0) {
    return -1;
  }

  while (src < pattern.length) {
    if (pattern.chars[src] == 37) {
      if (src + 1 < pattern.length) {
        if (pattern.chars[src + 1] == 100) {
          if (dst + num_len >= buf_len) {
            return -1;
          }
          var j: int32 = 0;
          while (j < num_len) {
            buf[dst] = num_buf[j];
            dst = dst + 1;
            j = j + 1;
          }
          src = src + 2;
          continue;
        }
        if (pattern.chars[src + 1] == 37) {
          if (dst + 1 >= buf_len) {
            return -1;
          }
          buf[dst] = 37;
          dst = dst + 1;
          src = src + 2;
          continue;
        }
      }
    }

    if (dst + 1 >= buf_len) {
      return -1;
    }
    buf[dst] = pattern.chars[src];
    dst = dst + 1;
    src = src + 1;
  }

  buf[dst] = 0;
  return dst;
}

export fn streq(a: cstring, b: cstring) -> int32 {
  var i: int64 = 0;
  while (a[i] != 0) {
    if (a[i] != b[i]) { return 0; }
    i = i + 1;
  }
  if (b[i] != 0) { return 0; }
  return 1;
}

export fn cstr_ncmp(buf: uint8*, offset: int32, needle: string, buf_len: int32) -> int32 {
  if (offset < 0) { return -1; }
  if (buf_len < 0) { return -1; }
  if (offset > buf_len) { return -1; }

  var i: int32 = 0;
  while (i < needle.length) {
    if (offset + i >= buf_len) { return -1; }
    if (buf[offset + i] != needle.chars[i]) {
      return buf[offset + i] - needle.chars[i];
    }
    i = i + 1;
  }

  return 0;
}
