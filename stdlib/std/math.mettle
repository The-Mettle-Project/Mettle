export fn f64_bits(x: float64) -> int64 {
  var v: float64 = x;
  var pf: float64* = &v;
  var pi: int64* = (int64*)pf;
  return *pi;
}

export fn f64_from_bits(b: int64) -> float64 {
  var v: int64 = b;
  var pi: int64* = &v;
  var pf: float64* = (float64*)pi;
  return *pf;
}

fn EXP_MASK() -> int64 { return 0x7FF; }
fn FRAC_MASK() -> int64 { return 0x000FFFFFFFFFFFFF; }

export fn f64_raw_exponent(x: float64) -> int32 {
  return (int32)((f64_bits(x) >> 52) & EXP_MASK());
}

export fn INF() -> float64 { return f64_from_bits(0x7FF0000000000000); }
export fn NAN() -> float64 { return f64_from_bits(0x7FF8000000000000); }

export fn PI() -> float64 { return 3.141592653589793; }
export fn TAU() -> float64 { return 6.283185307179586; }
export fn HALF_PI() -> float64 { return 1.5707963267948966; }
export fn QUARTER_PI() -> float64 { return 0.7853981633974483; }
export fn E() -> float64 { return 2.718281828459045; }
export fn SQRT2() -> float64 { return 1.4142135623730951; }
export fn SQRT1_2() -> float64 { return 0.7071067811865476; }
export fn LN2() -> float64 { return 0.6931471805599453; }
export fn LN10() -> float64 { return 2.302585092994046; }
export fn LOG2E() -> float64 { return 1.4426950408889634; }
export fn LOG10E() -> float64 { return 0.4342944819032518; }
export fn LOG10_2() -> float64 { return 0.30102999566398120; }

export fn EPSILON() -> float64 { return 2.220446049250313e-16; }
export fn F32_EPSILON() -> float64 { return 1.1920928955078125e-07; }
export fn MAX_FINITE() -> float64 { return 1.7976931348623157e308; }
export fn MIN_POSITIVE() -> float64 { return 2.2250738585072014e-308; }

export fn DEG_PER_RAD() -> float64 { return 57.29577951308232; }
export fn RAD_PER_DEG() -> float64 { return 0.017453292519943295; }

fn LN2_HI() -> float64 { return 6.93147180369123816490e-01; }
fn LN2_LO() -> float64 { return 1.90821492927058770002e-10; }
fn PIO2_HI() -> float64 { return 1.57079632673412561417e+00; }
fn PIO2_LO() -> float64 { return 6.07710050650619224932e-11; }

export fn is_nan(x: float64) -> int32 {
  if (x != x) { return 1; }
  return 0;
}

export fn is_inf(x: float64) -> int32 {
  if (f64_raw_exponent(x) != 2047) { return 0; }
  if ((f64_bits(x) & FRAC_MASK()) != 0) { return 0; }
  return 1;
}

export fn is_finite(x: float64) -> int32 {
  if (f64_raw_exponent(x) == 2047) { return 0; }
  return 1;
}

export fn signbit(x: float64) -> int32 {
  if (f64_bits(x) < 0) { return 1; }
  return 0;
}

export fn fabs(x: float64) -> float64 {
  if (x < 0.0) { return -x; }
  if (x == 0.0) { return 0.0; }
  return x;
}

export fn copysign(magnitude: float64, sign: float64) -> float64 {
  var m: float64 = fabs(magnitude);
  if (signbit(sign) != 0) { return -m; }
  return m;
}

export fn fsign(x: float64) -> float64 {
  if (x > 0.0) { return 1.0; }
  if (x < 0.0) { return -1.0; }
  return 0.0;
}

export fn fmin(a: float64, b: float64) -> float64 {
  if (is_nan(a) != 0) { return b; }
  if (is_nan(b) != 0) { return a; }
  if (a < b) { return a; }
  return b;
}

export fn fmax(a: float64, b: float64) -> float64 {
  if (is_nan(a) != 0) { return b; }
  if (is_nan(b) != 0) { return a; }
  if (a > b) { return a; }
  return b;
}

export fn fclamp(value: float64, lo: float64, hi: float64) -> float64 {
  if (value < lo) { return lo; }
  if (value > hi) { return hi; }
  return value;
}

export fn saturate(value: float64) -> float64 {
  return fclamp(value, 0.0, 1.0);
}

export fn ldexp(x: float64, n: int32) -> float64 {
  if (x == 0.0) { return x; }
  if (is_finite(x) == 0) { return x; }

  var r: float64 = x;
  var e: int32 = n;
  while (e > 1000) {
    r = r * f64_from_bits((int64)(1023 + 1000) << 52);
    e = e - 1000;
    if (is_finite(r) == 0) { return r; }
  }
  while (e < -1000) {
    r = r * f64_from_bits((int64)(1023 - 1000) << 52);
    e = e + 1000;
    if (r == 0.0) { return r; }
  }
  return r * f64_from_bits((int64)(1023 + e) << 52);
}

export fn frexp(x: float64, exponent_out: int32*) -> float64 {
  *exponent_out = 0;
  if (x == 0.0) { return x; }
  if (is_finite(x) == 0) { return x; }

  var v: float64 = x;
  var extra: int32 = 0;
  if (f64_raw_exponent(v) == 0) {
    v = v * 18014398509481984.0;
    extra = -54;
  }

  var b: int64 = f64_bits(v);
  var e: int32 = (int32)((b >> 52) & EXP_MASK());
  *exponent_out = e - 1022 + extra;

  var m: float64 = f64_from_bits((b & FRAC_MASK()) | ((int64)1022 << 52));
  if (v < 0.0) { return -m; }
  return m;
}

fn TWO_52() -> float64 { return 4503599627370496.0; }

export fn trunc(x: float64) -> float64 {
  if (is_finite(x) == 0) { return x; }
  if (fabs(x) >= TWO_52()) { return x; }
  var t: float64 = (float64)(int64)x;
  if (t == 0.0) { return copysign(0.0, x); }
  return t;
}

export fn floor(x: float64) -> float64 {
  var t: float64 = trunc(x);
  if (is_finite(x) == 0) { return x; }
  if (x < 0.0 && t != x) { return t - 1.0; }
  return t;
}

export fn ceil(x: float64) -> float64 {
  var t: float64 = trunc(x);
  if (is_finite(x) == 0) { return x; }
  if (x > 0.0 && t != x) { return t + 1.0; }
  return t;
}

export fn round(x: float64) -> float64 {
  if (is_finite(x) == 0) { return x; }
  if (fabs(x) >= TWO_52()) { return x; }
  var t: float64 = trunc(x);
  var d: float64 = x - t;
  if (d >= 0.5) { return t + 1.0; }
  if (d <= -0.5) { return t - 1.0; }
  return t;
}

export fn fract(x: float64) -> float64 {
  return x - floor(x);
}

@inline export fn floor_i64(x: float64) -> int64 {
  var t: int64 = (int64)x;
  if ((float64)t > x) { return t - 1; }
  return t;
}

@inline export fn floor_i32(x: float64) -> int32 {
  var t: int32 = (int32)x;
  if ((float64)t > x) { return t - 1; }
  return t;
}

@inline export fn ceil_i64(x: float64) -> int64 {
  var t: int64 = (int64)x;
  if ((float64)t < x) { return t + 1; }
  return t;
}

@inline export fn ceil_i32(x: float64) -> int32 {
  var t: int32 = (int32)x;
  if ((float64)t < x) { return t + 1; }
  return t;
}

@inline export fn trunc_i64(x: float64) -> int64 {
  return (int64)x;
}

@inline export fn trunc_i32(x: float64) -> int32 {
  return (int32)x;
}

@inline export fn round_i64(x: float64) -> int64 {
  return (int64)round(x);
}

@inline export fn round_i32(x: float64) -> int32 {
  return (int32)round(x);
}

export fn fmod(x: float64, y: float64) -> float64 {
  if (is_nan(x) != 0 || is_nan(y) != 0) { return NAN(); }
  if (is_inf(x) != 0 || y == 0.0) { return NAN(); }
  if (is_inf(y) != 0) { return x; }

  var a: float64 = fabs(x);
  var b: float64 = fabs(y);
  if (a < b) { return x; }

  var ea: int32 = 0;
  var eb: int32 = 0;
  frexp(a, &ea);
  frexp(b, &eb);

  var k: int32 = ea - eb;
  while (k >= 0) {
    var t: float64 = ldexp(b, k);
    if (t <= a) { a = a - t; }
    k = k - 1;
  }
  return copysign(a, x);
}

fn sqrt_square(a: uint64, hi: uint64*, lo: uint64*) {
  var a1: uint64 = a >> (uint64)32;
  var a0: uint64 = a & (uint64)4294967295;
  var cross: uint64 = a1 * a0;
  var low: uint64 = a0 * a0;
  var mid: uint64 = cross << (uint64)33;
  var sum: uint64 = low + mid;
  var carry: uint64 = 0;
  if (sum < low) { carry = 1; }
  *hi = a1 * a1 + (cross >> (uint64)31) + carry;
  *lo = sum;
}

fn sqrt_below(ahi: uint64, alo: uint64, bhi: uint64, blo: uint64) -> bool {
  return ahi < bhi || (ahi == bhi && alo < blo);
}

fn sqrt_estimate(x: float64) -> float64 {
  var e: int32 = 0;
  var m: float64 = frexp(x, &e);
  if ((e & 1) != 0) {
    m = m * 2.0;
    e = e - 1;
  }
  var y: float64 = 0.41731 + 0.59016 * m;
  y = 0.5 * (y + m / y);
  y = 0.5 * (y + m / y);
  y = 0.5 * (y + m / y);
  y = 0.5 * (y + m / y);
  return ldexp(y, e / 2);
}

export fn sqrt(x: float64) -> float64 {
  if (is_nan(x) != 0) { return x; }
  if (x < 0.0) { return NAN(); }
  if (x == 0.0) { return x; }
  if (is_inf(x) != 0) { return x; }

  var bits: int64 = f64_bits(x);
  var exponent: int64 = (bits >> 52) & 2047;
  var mant: uint64 = (uint64)(bits & 4503599627370495);
  if (exponent == 0) {
    exponent = 1;
    while ((mant & (uint64)4503599627370496) == (uint64)0) {
      mant = mant << (uint64)1;
      exponent = exponent - 1;
    }
  } else {
    mant = mant | (uint64)4503599627370496;
  }
  var e2: int64 = exponent - 1075;
  if ((e2 & 1) != 0) {
    mant = mant << (uint64)1;
    e2 = e2 - 1;
  }
  var half: int32 = (int32)((e2 - 52) / 2);
  var y: uint64 = (uint64)(int64)ldexp(sqrt_estimate(x), -half);
  var four_hi: uint64 = mant >> (uint64)10;
  var four_lo: uint64 = mant << (uint64)54;
  var hi: uint64 = 0;
  var lo: uint64 = 0;
  for _attempt in 0..4 {
    sqrt_square(y * (uint64)2 + (uint64)1, &hi, &lo);
    if (!sqrt_below(four_hi, four_lo, hi, lo)) {
      y = y + (uint64)1;
      continue;
    }
    sqrt_square(y * (uint64)2 - (uint64)1, &hi, &lo);
    if (sqrt_below(four_hi, four_lo, hi, lo)) {
      y = y - (uint64)1;
      continue;
    }
    break;
  }
  return ldexp((float64)y, half);
}

export fn rsqrt(x: float64) -> float64 {
  return 1.0 / sqrt(x);
}

export fn hypot(x: float64, y: float64) -> float64 {
  var a: float64 = fabs(x);
  var b: float64 = fabs(y);
  if (is_inf(a) != 0 || is_inf(b) != 0) { return INF(); }
  if (a < b) {
    var t: float64 = a;
    a = b;
    b = t;
  }
  if (a == 0.0) { return 0.0; }
  var r: float64 = b / a;
  return a * sqrt(1.0 + r * r);
}

fn exp_kernel(r: float64) -> float64 {
  var p: float64 = 4.779477332387385e-14;
  p = p * r + 7.647163731819816e-13;
  p = p * r + 1.1470745597729725e-11;
  p = p * r + 1.6059043836821613e-10;
  p = p * r + 2.08767569878681e-09;
  p = p * r + 2.505210838544172e-08;
  p = p * r + 2.755731922398589e-07;
  p = p * r + 2.7557319223985893e-06;
  p = p * r + 2.48015873015873e-05;
  p = p * r + 1.984126984126984e-04;
  p = p * r + 1.388888888888889e-03;
  p = p * r + 8.333333333333333e-03;
  p = p * r + 4.1666666666666664e-02;
  p = p * r + 1.6666666666666666e-01;
  p = p * r + 5.0e-01;
  p = p * r + 1.0;
  p = p * r + 1.0;
  return p;
}

export fn exp(x: float64) -> float64 {
  if (is_nan(x) != 0) { return x; }
  if (x > 709.782712893384) { return INF(); }
  if (x < -745.1332191019411) { return 0.0; }

  var n: int32 = 0;
  var em_lo: float64 = 0.0;
  var em: float64 = exp_reduced(x, &n, &em_lo);
  var one: float64 = 1.0 + em;
  var one_lo: float64 = (em - (one - 1.0)) + em_lo;
  return ldexp(one + one_lo, n);
}

export fn exp2(x: float64) -> float64 {
  if (is_nan(x) != 0) { return x; }
  if (x > 1024.0) { return INF(); }
  if (x < -1075.0) { return 0.0; }
  var k: float64 = round(x);
  var r: float64 = x - k;
  return ldexp(exp_kernel(r * LN2()), (int32)k);
}

fn exp_reduced(x: float64, n_out: int32*, lo: float64*) -> float64 {
  var k: float64 = round(x * LOG2E());
  var head: float64 = x - k * LN2_HI();
  var r: float64 = head - k * LN2_LO();
  var r_lo: float64 = (head - r) - k * LN2_LO();
  var p: float64 = 1.1470745597729725e-11;
  p = p * r + 1.6059043836821613e-10;
  p = p * r + 2.08767569878681e-09;
  p = p * r + 2.505210838544172e-08;
  p = p * r + 2.755731922398589e-07;
  p = p * r + 2.7557319223985893e-06;
  p = p * r + 2.48015873015873e-05;
  p = p * r + 1.984126984126984e-04;
  p = p * r + 1.388888888888889e-03;
  p = p * r + 8.333333333333333e-03;
  p = p * r + 4.1666666666666664e-02;
  p = p * r + 1.6666666666666666e-01;
  p = p * r + 5.0e-01;
  var sq_lo: float64 = 0.0;
  var sq: float64 = dd_two_prod(r, r, &sq_lo);
  var tail: float64 = (sq * p + sq_lo * 0.5) + r_lo * (1.0 + r);
  var em: float64 = r + tail;
  *lo = tail - (em - r);
  *n_out = (int32)k;
  return em;
}

fn exp_half_huge(a: float64) -> float64 {
  var n: int32 = 0;
  var em_lo: float64 = 0.0;
  var em: float64 = exp_reduced(a, &n, &em_lo);
  var one: float64 = 1.0 + em;
  var one_lo: float64 = (em - (one - 1.0)) + em_lo;
  return ldexp(one + one_lo, n - 1);
}

fn expm1_dd(x: float64, lo: float64*) -> float64 {
  *lo = 0.0;
  if (fabs(x) < 5.551115123125783e-17) { return x; }
  var n: int32 = 0;
  var em_lo: float64 = 0.0;
  var em: float64 = exp_reduced(x, &n, &em_lo);
  if (n == 0) {
    *lo = em_lo;
    return em;
  }
  if (n <= -57) {
    *lo = 0.0;
    return -1.0 + ldexp(1.0 + em, n);
  }
  if (n >= 57) {
    var one: float64 = 1.0 + em;
    var one_lo: float64 = (em - (one - 1.0)) + em_lo;
    *lo = ldexp(one_lo, n);
    return ldexp(one, n);
  }
  var scale: float64 = ldexp(1.0, n);
  var b: float64 = em * scale;
  var s1: float64 = scale - 1.0;
  var e1: float64 = (scale - s1) - 1.0;
  var s2: float64 = s1 + b;
  var bb: float64 = s2 - s1;
  var e2: float64 = (s1 - (s2 - bb)) + (b - bb);
  var rest: float64 = e1 + e2 + em_lo * scale;
  var hi: float64 = s2 + rest;
  *lo = rest - (hi - s2);
  return hi;
}

export fn expm1(x: float64) -> float64 {
  if (is_nan(x) != 0) { return x; }
  if (x > 709.782712893384) { return INF(); }
  if (x < -40.0) { return -1.0; }
  if (fabs(x) < 5.551115123125783e-17) { return x; }
  var lo: float64 = 0.0;
  var hi: float64 = expm1_dd(x, &lo);
  return hi + lo;
}

fn log_kernel(m: float64) -> float64 {
  var s: float64 = (m - 1.0) / (m + 1.0);
  var z: float64 = s * s;

  var p: float64 = 4.3478260869565216e-02;
  p = p * z + 4.7619047619047616e-02;
  p = p * z + 5.2631578947368418e-02;
  p = p * z + 5.8823529411764705e-02;
  p = p * z + 6.6666666666666666e-02;
  p = p * z + 7.6923076923076927e-02;
  p = p * z + 9.0909090909090912e-02;
  p = p * z + 1.1111111111111111e-01;
  p = p * z + 1.4285714285714285e-01;
  p = p * z + 2.0e-01;
  p = p * z + 3.3333333333333331e-01;
  p = p * z + 1.0;
  return 2.0 * s * p;
}

export fn log(x: float64) -> float64 {
  if (is_nan(x) != 0) { return x; }
  if (x < 0.0) { return NAN(); }
  if (x == 0.0) { return -INF(); }
  if (is_inf(x) != 0) { return x; }

  var lo: float64 = 0.0;
  var hi: float64 = pow_log_dd(x, &lo);
  return hi + lo;
}

export fn log2(x: float64) -> float64 {
  if (is_nan(x) != 0) { return x; }
  if (x < 0.0) { return NAN(); }
  if (x == 0.0) { return -INF(); }
  if (is_inf(x) != 0) { return x; }

  var e: int32 = 0;
  var m: float64 = frexp(x, &e);
  if (m < SQRT1_2()) {
    m = m * 2.0;
    e = e - 1;
  }
  return (float64)e + log_kernel(m) * LOG2E();
}

export fn log10(x: float64) -> float64 {
  if (is_nan(x) != 0) { return x; }
  if (x < 0.0) { return NAN(); }
  if (x == 0.0) { return -INF(); }
  if (is_inf(x) != 0) { return x; }

  var log_lo: float64 = 0.0;
  var log_hi: float64 = pow_log_dd(x, &log_lo);
  var lo: float64 = 0.0;
  var hi: float64 = dd_mul(log_hi, log_lo, 0.4342944819032518,
                           1.098319650216765e-17, &lo);
  return hi + lo;
}

fn log1p_dd(x: float64, x_lo: float64, lo: float64*) -> float64 {
  *lo = 0.0;
  if (fabs(x) < 5.551115123125783e-17) {
    *lo = x_lo;
    return x;
  }
  var u: float64 = 1.0 + x;
  var bb: float64 = u - 1.0;
  var err: float64 = ((1.0 - (u - bb)) + (x - bb)) + x_lo;
  var l_lo: float64 = 0.0;
  var l_hi: float64 = pow_log_dd(u, &l_lo);
  var rest: float64 = l_lo + err / u;
  var hi: float64 = l_hi + rest;
  var part: float64 = hi - l_hi;
  *lo = (l_hi - (hi - part)) + (rest - part);
  return hi;
}

export fn log1p(x: float64) -> float64 {
  if (is_nan(x) != 0) { return x; }
  if (x < -1.0) { return NAN(); }
  if (x == -1.0) { return -INF(); }
  if (is_inf(x) != 0) { return x; }
  if (fabs(x) < 5.551115123125783e-17) { return x; }
  var lo: float64 = 0.0;
  var hi: float64 = log1p_dd(x, 0.0, &lo);
  return hi + lo;
}

export fn cbrt(x: float64) -> float64 {
  if (is_nan(x) != 0) { return x; }
  if (x == 0.0) { return x; }
  if (is_inf(x) != 0) { return x; }

  var a: float64 = fabs(x);
  var y: float64 = exp(log(a) * 0.3333333333333333);
  y = (2.0 * y + a / (y * y)) * 0.3333333333333333;
  y = (2.0 * y + a / (y * y)) * 0.3333333333333333;
  var sq_lo: float64 = 0.0;
  var sq: float64 = dd_two_prod(y, y, &sq_lo);
  var cube_lo: float64 = 0.0;
  var cube: float64 = dd_mul(sq, sq_lo, y, 0.0, &cube_lo);
  var residual: float64 = (a - cube) - cube_lo;
  y = y + residual / (3.0 * sq);
  return copysign(y, x);
}

fn dd_two_prod(a: float64, b: float64, err: float64*) -> float64 {
  var p: float64 = a * b;
  var ca: float64 = 134217729.0 * a;
  var ah: float64 = ca - (ca - a);
  var al: float64 = a - ah;
  var cb: float64 = 134217729.0 * b;
  var bh: float64 = cb - (cb - b);
  var bl: float64 = b - bh;
  *err = ((ah * bh - p) + ah * bl + al * bh) + al * bl;
  return p;
}

fn dd_mul(ah: float64, al: float64, bh: float64, bl: float64,
          lo: float64*) -> float64 {
  var e: float64 = 0.0;
  var p: float64 = dd_two_prod(ah, bh, &e);
  e = e + (ah * bl + al * bh);
  var s: float64 = p + e;
  *lo = e - (s - p);
  return s;
}

fn pow_log_dd(x: float64, lo: float64*) -> float64 {
  var k: int32 = 0;
  var m: float64 = frexp(x, &k);
  if (m < 0.70710678118654752) {
    m = m * 2.0;
    k = k - 1;
  }
  var f: float64 = m - 1.0;
  var s_hi: float64 = 2.0 + f;
  var s_lo: float64 = f - (s_hi - 2.0);
  var t_hi: float64 = f / s_hi;
  var pe: float64 = 0.0;
  var p: float64 = dd_two_prod(t_hi, s_hi, &pe);
  var t_lo: float64 = (((f - p) - pe) - t_hi * s_lo) / s_hi;
  var z: float64 = t_hi * t_hi;
  var q: float64 = 1.0 / 23.0;
  q = q * z + 1.0 / 21.0;
  q = q * z + 1.0 / 19.0;
  q = q * z + 1.0 / 17.0;
  q = q * z + 1.0 / 15.0;
  q = q * z + 1.0 / 13.0;
  q = q * z + 1.0 / 11.0;
  q = q * z + 1.0 / 9.0;
  q = q * z + 1.0 / 7.0;
  q = q * z + 1.0 / 5.0;
  var sq_lo: float64 = 0.0;
  var sq: float64 = dd_two_prod(t_hi, t_hi, &sq_lo);
  sq_lo = sq_lo + 2.0 * t_hi * t_lo;
  var cube_lo: float64 = 0.0;
  var cube: float64 = dd_mul(sq, sq_lo, t_hi, t_lo, &cube_lo);
  var third_lo: float64 = 0.0;
  var third: float64 = dd_mul(cube, cube_lo, 0.6666666666666666, 3.700743415417188e-17, &third_lo);
  var higher: float64 = 2.0 * t_hi * z * z * q;
  var two_t: float64 = 2.0 * t_hi;
  var mh: float64 = two_t + third;
  var ml: float64 = (two_t - mh) + third + ((third_lo + higher) + 2.0 * t_lo);
  var kh: float64 = (float64)k * 6.93147180369123816490e-01;
  var kl: float64 = (float64)k * 1.90821492927058770002e-10;
  var sum: float64 = kh + mh;
  var bb: float64 = sum - kh;
  var err: float64 = (kh - (sum - bb)) + (mh - bb);
  var rest: float64 = err + ml + kl;
  var hi: float64 = sum + rest;
  *lo = rest - (hi - sum);
  return hi;
}

fn pow_int_dd(base: float64, n: int64, lo: float64*) -> float64 {
  var acc_h: float64 = 1.0;
  var acc_l: float64 = 0.0;
  var b_h: float64 = base;
  var b_l: float64 = 0.0;
  var left: int64 = n;
  while (left > 0) {
    if ((left & 1) != 0) {
      acc_h = dd_mul(acc_h, acc_l, b_h, b_l, &acc_l);
    }
    left = left >> 1;
    if (left > 0) {
      b_h = dd_mul(b_h, b_l, b_h, b_l, &b_l);
    }
  }
  *lo = acc_l;
  return acc_h;
}

fn pow_positive(base: float64, exponent: float64) -> float64 {
  var magnitude: float64 = exponent * log2(base);
  if (magnitude > 1100.0) { return INF(); }
  if (magnitude < -1200.0) { return 0.0; }
  if (exponent == trunc(exponent) && fabs(exponent) <= 64.0 &&
      fabs(magnitude) < 1000.0) {
    var acc_l: float64 = 0.0;
    var acc_h: float64 = pow_int_dd(base, (int64)fabs(exponent), &acc_l);
    if (exponent > 0.0) { return acc_h + acc_l; }
    var q: float64 = 1.0 / acc_h;
    var qe: float64 = 0.0;
    var qp: float64 = dd_two_prod(q, acc_h, &qe);
    var correction: float64 = ((1.0 - qp) - qe) - q * acc_l;
    return q + q * correction;
  }
  var log_lo: float64 = 0.0;
  var log_hi: float64 = pow_log_dd(base, &log_lo);
  var p_lo: float64 = 0.0;
  var p_hi: float64 = dd_mul(exponent, 0.0, log_hi, log_lo, &p_lo);
  if (p_hi > 709.8) { return INF(); }
  if (p_hi < -745.2) { return 0.0; }
  var n: int32 = 0;
  var em_lo: float64 = 0.0;
  var em: float64 = exp_reduced(p_hi, &n, &em_lo);
  var one: float64 = 1.0 + em;
  var one_lo: float64 = ((em - (one - 1.0)) + em_lo) + p_lo * one;
  return ldexp(one + one_lo, n);
}

export fn pow(base: float64, exponent: float64) -> float64 {
  if (exponent == 0.0) { return 1.0; }
  if (is_nan(base) != 0) { return base; }
  if (is_nan(exponent) != 0) { return exponent; }
  if (base == 1.0) { return 1.0; }

  if (is_finite(base) == 0 || is_finite(exponent) == 0 || base == 0.0 ||
      fabs(exponent) > 1.0e300) {
    if (exponent == trunc(exponent) && fabs(exponent) <= 1024.0) {
      var n: int64 = (int64)fabs(exponent);
      var acc: float64 = 1.0;
      var b: float64 = base;
      while (n > 0) {
        if ((n & 1) != 0) { acc = acc * b; }
        b = b * b;
        n = n >> 1;
      }
      if (exponent < 0.0) { return 1.0 / acc; }
      return acc;
    }
    if (base < 0.0) { return NAN(); }
    if (base == 0.0) {
      if (exponent < 0.0) { return INF(); }
      return 0.0;
    }
    return exp2(exponent * log2(base));
  }

  if (base < 0.0) {
    if (exponent != trunc(exponent)) { return NAN(); }
    var odd: bool = fabs(exponent) < 9007199254740992.0 &&
                    ((int64)fabs(exponent) & 1) != 0;
    var r: float64 = pow_positive(-base, exponent);
    if (odd) { return -r; }
    return r;
  }
  return pow_positive(base, exponent);
}

fn sin_kernel(x: float64, y: float64, lo: float64*) -> float64 {
  var z: float64 = x * x;
  var v: float64 = z * x;
  var r: float64 = 8.33333333332248946124e-03 + z * (-1.98412698298579493134e-04 + z * (2.75573137070700676789e-06 + z * (-2.50507602534068634195e-08 + z * 1.58969099521155010221e-10)));
  var tail: float64 = -((z * (0.5 * y - v * r) - y) - v * -1.66666666666666324348e-01);
  var hi: float64 = x + tail;
  *lo = tail - (hi - x);
  return hi;
}

fn cos_kernel(x: float64, y: float64, lo: float64*) -> float64 {
  var z: float64 = x * x;
  var w: float64 = z * z;
  var r: float64 = z * (4.16666666666666019037e-02 + z * (-1.38888888888741095749e-03 + z * 2.48015872894767294178e-05)) + w * w * (-2.75573143513906633035e-07 + z * (2.08757232129817482790e-09 + z * -1.13596475577881948265e-11));
  var hz: float64 = 0.5 * z;
  var head: float64 = 1.0 - hz;
  var rest: float64 = ((1.0 - head) - hz) + (z * r - x * y);
  var hi: float64 = head + rest;
  *lo = rest - (hi - head);
  return hi;
}

fn pio2_bits64(limbs: uint64*, pos: int32) -> uint64 {
  var w: int32 = pos / 32;
  var sh: int32 = pos % 32;
  var v: uint64 = limbs[w] | (limbs[w + 1] << 32);
  if (sh == 0) { return v; }
  return (v >> (uint64)sh) | (limbs[w + 2] << (uint64)(64 - sh));
}

fn reduce_pio2_large(x: float64, lo_out: float64*, quadrant_out: int32*) -> float64 {
  var table: uint64[40] = [0xA2F9836E, 0x4E441529, 0xFC2757D1, 0xF534DDC0, 0xDB629599, 0x3C439041, 0xFE5163AB, 0xDEBBC561, 0xB7246E3A, 0x424DD2E0, 0x06492EEA, 0x09D1921C, 0xFE1DEB1C, 0xB129A73E, 0xE88235F5, 0x2EBB4484, 0xE99C7026, 0xB45F7E41, 0x3991D639, 0x835339F4, 0x9C845F8B, 0xBDF9283B, 0x1FF897FF, 0xDE05980F, 0xEF2F118B, 0x5A0A6D1F, 0x6D367ECF, 0x27CB09B7, 0x4F463F66, 0x9E5FEA2D, 0x7527BAC7, 0xEBE5F17B, 0x3D0739F7, 0x8A5292EA, 0x6BFB5FB1, 0x1F8D5D08, 0x56033046, 0xFC7B6BAB, 0xF0CFBC20, 0x9AF4361D];
  var limbs: uint64[11];
  for k in 0..11 { limbs[k] = 0; }
  var bits: int64 = f64_bits(x);
  var m: uint64 = (uint64)((bits & FRAC_MASK()) | 0x0010000000000000);
  var e: int32 = (int32)((bits >> 52) & EXP_MASK()) - 1075;
  var i0: int32 = 0;
  if (e >= 2) { i0 = (e - 2) / 32; }
  for j in 0..7 {
    var c: uint64 = table[i0 + (int32)j];
    var k: int32 = 6 - (int32)j;
    var p_lo: uint64 = (m & 0xFFFFFFFF) * c;
    var p_hi: uint64 = (m >> 32) * c;
    limbs[k] = limbs[k] + (p_lo & 0xFFFFFFFF);
    limbs[k + 1] = limbs[k + 1] + (p_lo >> 32) + (p_hi & 0xFFFFFFFF);
    limbs[k + 2] = limbs[k + 2] + (p_hi >> 32);
  }
  for k in 0..10 {
    limbs[k + 1] = limbs[k + 1] + (limbs[k] >> 32);
    limbs[k] = limbs[k] & 0xFFFFFFFF;
  }
  var s: int32 = 32 * (i0 + 7) - e;
  var q: int32 = (int32)(pio2_bits64(&limbs[0], s) & 3);
  var hi: uint64 = pio2_bits64(&limbs[0], s - 64);
  var lo: uint64 = pio2_bits64(&limbs[0], s - 128);
  var negative: bool = (hi >> 63) != 0;
  if (negative) {
    q = q + 1;
    lo = ~lo + 1;
    hi = ~hi;
    if (lo == 0) { hi = hi + 1; }
  }
  var a: float64 = (float64)(hi >> 11) * 1.1102230246251565e-16;
  var b: float64 = (float64)(((hi & 0x7FF) << 42) | (lo >> 22)) * 1.2325951644078310e-32;
  var c3: float64 = (float64)(lo & 0x3FFFFF) * 2.9387358770557188e-39;
  var f_hi: float64 = a + b;
  var f_lo: float64 = (b - (f_hi - a)) + c3;
  var r_lo: float64 = 0.0;
  var r_hi: float64 = dd_mul(f_hi, f_lo, 1.5707963267948966, 6.123233995736766e-17, &r_lo);
  if (negative) {
    r_hi = -r_hi;
    r_lo = -r_lo;
  }
  *lo_out = r_lo;
  *quadrant_out = q & 3;
  return r_hi;
}

fn reduce_pio2(x: float64, lo_out: float64*, quadrant_out: int32*) -> float64 {
  var a: float64 = fabs(x);
  if (a <= 0.78539816339744828) {
    *lo_out = 0.0;
    *quadrant_out = 0;
    return x;
  }
  var r_hi: float64 = 0.0;
  var r_lo: float64 = 0.0;
  var q: int32 = 0;
  if (a < 1647099.0) {
    var n: float64 = round(a * 0.63661977236758134);
    var t1: float64 = a - n * 1.57079632673412561417e+00;
    var w2: float64 = n * 6.07710050630396597660e-11;
    var t2: float64 = t1 - w2;
    var e2: float64 = (t1 - t2) - w2;
    var w3: float64 = n * 2.02226624871116645580e-21;
    var t3: float64 = t2 - w3;
    var e3: float64 = (t2 - t3) - w3;
    var tail: float64 = (e2 + e3) - n * 8.47842766036889956997e-32;
    r_hi = t3 + tail;
    r_lo = tail - (r_hi - t3);
    q = (int32)((int64)n & 3);
  } else {
    r_hi = reduce_pio2_large(a, &r_lo, &q);
  }
  if (x < 0.0) {
    r_hi = -r_hi;
    r_lo = -r_lo;
    q = (4 - q) & 3;
  }
  *lo_out = r_lo;
  *quadrant_out = q;
  return r_hi;
}

export fn sin(x: float64) -> float64 {
  if (is_finite(x) == 0) { return NAN(); }
  var q: int32 = 0;
  var y: float64 = 0.0;
  var r: float64 = reduce_pio2(x, &y, &q);
  var lo: float64 = 0.0;
  if (q == 0) { return sin_kernel(r, y, &lo); }
  if (q == 1) { return cos_kernel(r, y, &lo); }
  if (q == 2) { return -sin_kernel(r, y, &lo); }
  return -cos_kernel(r, y, &lo);
}

export fn cos(x: float64) -> float64 {
  if (is_finite(x) == 0) { return NAN(); }
  var q: int32 = 0;
  var y: float64 = 0.0;
  var r: float64 = reduce_pio2(x, &y, &q);
  var lo: float64 = 0.0;
  if (q == 0) { return cos_kernel(r, y, &lo); }
  if (q == 1) { return -sin_kernel(r, y, &lo); }
  if (q == 2) { return -cos_kernel(r, y, &lo); }
  return sin_kernel(r, y, &lo);
}

export fn tan(x: float64) -> float64 {
  if (is_finite(x) == 0) { return NAN(); }
  var q: int32 = 0;
  var y: float64 = 0.0;
  var r: float64 = reduce_pio2(x, &y, &q);
  if (r == 0.0) { return x; }
  var s_lo: float64 = 0.0;
  var c_lo: float64 = 0.0;
  var s_hi: float64 = sin_kernel(r, y, &s_lo);
  var c_hi: float64 = cos_kernel(r, y, &c_lo);
  var n_hi: float64 = s_hi;
  var n_lo: float64 = s_lo;
  var d_hi: float64 = c_hi;
  var d_lo: float64 = c_lo;
  if ((q & 1) != 0) {
    n_hi = -c_hi;
    n_lo = -c_lo;
    d_hi = s_hi;
    d_lo = s_lo;
  }
  var t: float64 = n_hi / d_hi;
  var pe: float64 = 0.0;
  var p: float64 = dd_two_prod(t, d_hi, &pe);
  var rem: float64 = (((n_hi - p) - pe) + n_lo) - t * d_lo;
  return t + rem / d_hi;
}

fn atan_positive(a: float64, a_lo: float64, lo: float64*) -> float64 {
  *lo = 0.0;
  if (a >= 7.378697629483821e+19) {
    *lo = 6.123233995736766e-17;
    return 1.5707963267948966;
  }
  if (a < 3.725290298461914e-09) { return a + a_lo; }
  var t: float64 = a;
  var head: float64 = 0.0;
  var head_lo: float64 = 0.0;
  var id: int32 = -1;
  if (a >= 0.4375) {
    if (a < 0.6875) {
      id = 0;
      t = (2.0 * a - 1.0) / (2.0 + a);
      head = 4.63647609000806093515e-01;
      head_lo = 2.26987774529616870924e-17;
    } else if (a < 1.1875) {
      id = 1;
      t = (a - 1.0) / (a + 1.0);
      head = 7.85398163397448278999e-01;
      head_lo = 3.06161699786838301793e-17;
    } else if (a < 2.4375) {
      id = 2;
      t = (a - 1.5) / (1.0 + 1.5 * a);
      head = 9.82793723247329054082e-01;
      head_lo = 1.39033110312309984516e-17;
    } else {
      id = 3;
      t = -1.0 / a;
      head = 1.57079632679489655800e+00;
      head_lo = 6.12323399573676603587e-17;
    }
  }
  var correction: float64 = a_lo / (1.0 + a * a);
  var z: float64 = t * t;
  var w: float64 = z * z;
  var s1: float64 = z * (3.33333333333329318027e-01 + w * (1.42857142725034663711e-01 + w * (9.09088713343650656196e-02 + w * (6.66107313738753120669e-02 + w * (4.97687799461593236017e-02 + w * 1.62858201153657823623e-02)))));
  var s2: float64 = w * (-1.99999999998764832476e-01 + w * (-1.11111104054623557880e-01 + w * (-7.69187620504482999495e-02 + w * (-5.83357013379057348645e-02 + w * -3.65315727442169155270e-02))));
  if (id < 0) {
    var small_tail: float64 = t * (s1 + s2) - correction;
    var small: float64 = t - small_tail;
    *lo = (t - small) - small_tail;
    return small;
  }
  var tail: float64 = ((t * (s1 + s2) - head_lo) - correction) - t;
  var hi: float64 = head - tail;
  *lo = (head - hi) - tail;
  return hi;
}

export fn atan(x: float64) -> float64 {
  if (is_nan(x) != 0) { return x; }
  var lo: float64 = 0.0;
  return copysign(atan_positive(fabs(x), 0.0, &lo), x);
}

export fn atan2(y: float64, x: float64) -> float64 {
  if (is_nan(x) != 0) { return x; }
  if (is_nan(y) != 0) { return y; }

  var west: bool = x < 0.0 || (x == 0.0 && signbit(x) != 0);
  if (y == 0.0) {
    if (west) { return copysign(PI(), y); }
    return y;
  }
  if (x == 0.0) { return copysign(HALF_PI(), y); }
  if (is_inf(x) != 0) {
    if (is_inf(y) != 0) {
      if (west) { return copysign(2.356194490192345, y); }
      return copysign(QUARTER_PI(), y);
    }
    if (west) { return copysign(PI(), y); }
    return copysign(0.0, y);
  }
  if (is_inf(y) != 0) { return copysign(HALF_PI(), y); }
  var q_lo: float64 = 0.0;
  var q: float64 = dd_quotient(fabs(y), 0.0, fabs(x), 0.0, &q_lo);
  if (is_finite(q_lo) == 0) { q_lo = 0.0; }
  var r_lo: float64 = 0.0;
  var r: float64 = atan_positive(q, q_lo, &r_lo);
  if (west) {
    var s: float64 = 3.141592653589793 - r;
    var err: float64 = (3.141592653589793 - s) - r;
    r = s + ((err + 1.2246467991473532e-16) - r_lo);
  }
  return copysign(r, y);
}

fn dd_sqrt(q: float64, q_lo: float64, lo: float64*) -> float64 {
  var s: float64 = sqrt(q);
  var pe: float64 = 0.0;
  var p: float64 = dd_two_prod(s, s, &pe);
  *lo = (((q - p) - pe) + q_lo) / (2.0 * s);
  return s;
}

fn dd_quotient(n_hi: float64, n_lo: float64, d_hi: float64, d_lo: float64, lo: float64*) -> float64 {
  var t: float64 = n_hi / d_hi;
  var pe: float64 = 0.0;
  var p: float64 = dd_two_prod(t, d_hi, &pe);
  *lo = ((((n_hi - p) - pe) + n_lo) - t * d_lo) / d_hi;
  return t;
}

export fn asin(x: float64) -> float64 {
  if (is_nan(x) != 0) { return x; }
  if (x > 1.0 || x < -1.0) { return NAN(); }
  var a: float64 = fabs(x);
  if (a == 1.0) { return copysign(HALF_PI(), x); }
  if (a < 3.725290298461914e-09) { return x; }
  var pe: float64 = 0.0;
  var p: float64 = dd_two_prod(a, a, &pe);
  var q: float64 = 1.0 - p;
  var q_lo: float64 = ((1.0 - q) - p) - pe;
  var s_lo: float64 = 0.0;
  var s: float64 = dd_sqrt(q, q_lo, &s_lo);
  var y_lo: float64 = 0.0;
  var y: float64 = dd_quotient(a, 0.0, s, s_lo, &y_lo);
  var lo: float64 = 0.0;
  return copysign(atan_positive(y, y_lo, &lo), x);
}

export fn acos(x: float64) -> float64 {
  if (is_nan(x) != 0) { return x; }
  if (x > 1.0 || x < -1.0) { return NAN(); }
  if (x == 1.0) { return 0.0; }
  if (x == -1.0) { return PI(); }
  var u: float64 = 1.0 - x;
  var u_lo: float64 = (1.0 - u) - x;
  var v: float64 = 1.0 + x;
  var v_lo: float64 = (1.0 - v) + x;
  var r_lo: float64 = 0.0;
  var r: float64 = dd_quotient(u, u_lo, v, v_lo, &r_lo);
  var s_lo: float64 = 0.0;
  var s: float64 = dd_sqrt(r, r_lo, &s_lo);
  var lo: float64 = 0.0;
  return 2.0 * atan_positive(s, s_lo, &lo);
}

fn dd_div(n_hi: float64, n_lo: float64, d_hi: float64, d_lo: float64) -> float64 {
  var t: float64 = n_hi / d_hi;
  var pe: float64 = 0.0;
  var p: float64 = dd_two_prod(t, d_hi, &pe);
  var rem: float64 = (((n_hi - p) - pe) + n_lo) - t * d_lo;
  return t + rem / d_hi;
}

export fn sinh(x: float64) -> float64 {
  if (is_finite(x) == 0) { return x; }
  var a: float64 = fabs(x);
  if (a < 3.725290298461914e-09) { return x; }
  if (a > 709.0) { return copysign(exp_half_huge(a), x); }
  var e_lo: float64 = 0.0;
  var e: float64 = expm1_dd(a, &e_lo);
  var d: float64 = e + 1.0;
  var d_lo: float64 = ((1.0 - d) + e) + e_lo;
  if (e > 1.0) { d_lo = ((e - d) + 1.0) + e_lo; }
  var q: float64 = dd_div(e, e_lo, d, d_lo);
  var s: float64 = e + q;
  var sb: float64 = s - e;
  var s_lo: float64 = ((e - (s - sb)) + (q - sb)) + e_lo;
  return copysign(0.5 * (s + s_lo), x);
}

export fn cosh(x: float64) -> float64 {
  if (is_nan(x) != 0) { return x; }
  if (is_inf(x) != 0) { return INF(); }
  var a: float64 = fabs(x);
  if (a > 709.0) { return exp_half_huge(a); }
  var e_lo: float64 = 0.0;
  var e: float64 = expm1_dd(a, &e_lo);
  var d: float64 = e + 1.0;
  var d_lo: float64 = ((1.0 - d) + e) + e_lo;
  if (e > 1.0) { d_lo = ((e - d) + 1.0) + e_lo; }
  var inv: float64 = dd_div(1.0, 0.0, d, d_lo);
  var s: float64 = d + inv;
  var sb: float64 = s - d;
  var s_lo: float64 = ((d - (s - sb)) + (inv - sb)) + d_lo;
  return 0.5 * (s + s_lo);
}

export fn tanh(x: float64) -> float64 {
  if (is_nan(x) != 0) { return x; }
  var a: float64 = fabs(x);
  if (a > 22.0) { return copysign(1.0, x); }
  if (a < 3.725290298461914e-09) { return x; }
  var e_lo: float64 = 0.0;
  var e: float64 = expm1_dd(2.0 * a, &e_lo);
  var d: float64 = e + 2.0;
  var d_lo: float64 = ((2.0 - d) + e) + e_lo;
  if (e > 2.0) { d_lo = ((e - d) + 2.0) + e_lo; }
  return copysign(dd_div(e, e_lo, d, d_lo), x);
}

export fn asinh(x: float64) -> float64 {
  if (is_finite(x) == 0) { return x; }
  var a: float64 = fabs(x);
  if (a >= 268435456.0) {
    var l_lo: float64 = 0.0;
    var l_hi: float64 = pow_log_dd(a, &l_lo);
    return copysign(l_hi + (6.931471805599453e-01 + (l_lo + 2.3190468138462996e-17)), x);
  }
  var r: float64 = log1p(a + a * a / (1.0 + sqrt(a * a + 1.0)));
  return copysign(r, x);
}

export fn acosh(x: float64) -> float64 {
  if (is_nan(x) != 0) { return x; }
  if (x < 1.0) { return NAN(); }
  if (is_inf(x) != 0) { return x; }
  if (x >= 268435456.0) {
    var l_lo: float64 = 0.0;
    var l_hi: float64 = pow_log_dd(x, &l_lo);
    return l_hi + (6.931471805599453e-01 + (l_lo + 2.3190468138462996e-17));
  }
  var t: float64 = x - 1.0;
  if (t == 0.0) { return 0.0; }
  var t2: float64 = t + 2.0;
  var t2_lo: float64 = (2.0 - t2) + t;
  if (t > 2.0) { t2_lo = (t - t2) + 2.0; }
  var q_lo: float64 = 0.0;
  var q: float64 = dd_mul(t, 0.0, t2, t2_lo, &q_lo);
  var s: float64 = sqrt(q);
  var pe: float64 = 0.0;
  var p: float64 = dd_two_prod(s, s, &pe);
  var s_lo: float64 = (((q - p) - pe) + q_lo) / (2.0 * s);
  var y: float64 = t + s;
  var yb: float64 = y - t;
  var y_lo: float64 = ((t - (y - yb)) + (s - yb)) + s_lo;
  var lo: float64 = 0.0;
  var hi: float64 = log1p_dd(y, y_lo, &lo);
  return hi + lo;
}

export fn atanh(x: float64) -> float64 {
  if (is_nan(x) != 0) { return x; }
  var a: float64 = fabs(x);
  if (a > 1.0) { return NAN(); }
  if (a == 1.0) { return copysign(INF(), x); }
  if (a < 3.725290298461914e-09) { return x; }
  var p_lo: float64 = 0.0;
  var p: float64 = log1p_dd(a, 0.0, &p_lo);
  var m_lo: float64 = 0.0;
  var m: float64 = log1p_dd(-a, 0.0, &m_lo);
  var d: float64 = p - m;
  var db: float64 = d - p;
  var d_lo: float64 = ((p - (d - db)) + (-m - db)) + (p_lo - m_lo);
  return copysign(0.5 * (d + d_lo), x);
}

export fn degrees(radians_in: float64) -> float64 {
  return radians_in * DEG_PER_RAD();
}

export fn radians(degrees_in: float64) -> float64 {
  return degrees_in * RAD_PER_DEG();
}

export fn wrap(value: float64, lo: float64, hi: float64) -> float64 {
  var span: float64 = hi - lo;
  if (span <= 0.0) { return lo; }
  var t: float64 = fmod(value - lo, span);
  if (t < 0.0) { t = t + span; }
  return lo + t;
}

export fn wrap_angle(a: float64) -> float64 {
  return wrap(a, -PI(), PI());
}

export fn angle_diff(from: float64, to: float64) -> float64 {
  return wrap_angle(to - from);
}

export fn lerp(a: float64, b: float64, t: float64) -> float64 {
  return a + (b - a) * t;
}

export fn inv_lerp(a: float64, b: float64, value: float64) -> float64 {
  if (b == a) { return 0.0; }
  return (value - a) / (b - a);
}

export fn remap(value: float64, in_lo: float64, in_hi: float64, out_lo: float64, out_hi: float64) -> float64 {
  return lerp(out_lo, out_hi, inv_lerp(in_lo, in_hi, value));
}

export fn smoothstep(edge0: float64, edge1: float64, x: float64) -> float64 {
  var t: float64 = saturate(inv_lerp(edge0, edge1, x));
  return t * t * (3.0 - 2.0 * t);
}

export fn smootherstep(edge0: float64, edge1: float64, x: float64) -> float64 {
  var t: float64 = saturate(inv_lerp(edge0, edge1, x));
  return t * t * t * (t * (t * 6.0 - 15.0) + 10.0);
}

export fn approx_eq(a: float64, b: float64, tolerance: float64) -> int32 {
  if (a == b) { return 1; }
  var d: float64 = fabs(a - b);
  if (d <= tolerance) { return 1; }
  var scale: float64 = fmax(fabs(a), fabs(b));
  if (d <= tolerance * scale) { return 1; }
  return 0;
}

export fn approx_zero(x: float64, tolerance: float64) -> int32 {
  if (fabs(x) <= tolerance) { return 1; }
  return 0;
}

export fn abs(x: int32) -> int32 {
  if (x < 0) { return -x; }
  return x;
}

export fn labs(x: int64) -> int64 {
  if (x < 0) { return -x; }
  return x;
}

export fn min(a: int64, b: int64) -> int64 {
  if (a < b) { return a; }
  return b;
}

export fn max(a: int64, b: int64) -> int64 {
  if (a > b) { return a; }
  return b;
}

export fn clamp(value: int64, lo: int64, hi: int64) -> int64 {
  if (value < lo) { return lo; }
  if (value > hi) { return hi; }
  return value;
}

export fn isign(x: int64) -> int64 {
  if (x > 0) { return 1; }
  if (x < 0) { return -1; }
  return 0;
}

export fn ipow(base: int64, exponent: int32) -> int64 {
  if (exponent < 0) {
    if (base == 1) { return 1; }
    if (base == -1 && (exponent & 1) != 0) { return -1; }
    if (base == -1) { return 1; }
    return 0;
  }
  var result: int64 = 1;
  var b: int64 = base;
  var e: int32 = exponent;
  while (e > 0) {
    if ((e & 1) != 0) { result = result * b; }
    e = e >> 1;
    if (e > 0) { b = b * b; }
  }
  return result;
}

export fn isqrt(n: int64) -> int64 {
  if (n <= 0) { return 0; }
  if (n < 4) { return 1; }
  var x: int64 = (int64)sqrt((float64)n);
  while (x > n / x) { x = x - 1; }
  while (x + 1 <= n / (x + 1)) { x = x + 1; }
  return x;
}

export fn gcd(a: int64, b: int64) -> int64 {
  var x: int64 = labs(a);
  var y: int64 = labs(b);
  while (y != 0) {
    var t: int64 = y;
    y = x % y;
    x = t;
  }
  return x;
}

export fn lcm(a: int64, b: int64) -> int64 {
  if (a == 0 || b == 0) { return 0; }
  return labs((a / gcd(a, b)) * b);
}

export fn is_pow2(n: int64) -> int32 {
  if (n <= 0) { return 0; }
  if ((n & (n - 1)) == 0) { return 1; }
  return 0;
}

export fn next_pow2(n: int64) -> int64 {
  if (n <= 1) { return 1; }
  var v: int64 = n - 1;
  v = v | (v >> 1);
  v = v | (v >> 2);
  v = v | (v >> 4);
  v = v | (v >> 8);
  v = v | (v >> 16);
  v = v | (v >> 32);
  return v + 1;
}

export fn ilog2(n: int64) -> int32 {
  if (n <= 0) { return -1; }
  var v: int64 = n;
  var r: int32 = 0;
  while (v > 1) {
    v = v >> 1;
    r = r + 1;
  }
  return r;
}

export fn idiv_floor(a: int64, b: int64) -> int64 {
  if (b == 0) { return 0; }
  var q: int64 = a / b;
  if (a % b != 0) {
    if ((a < 0) != (b < 0)) { q = q - 1; }
  }
  return q;
}

export fn imod_floor(a: int64, b: int64) -> int64 {
  if (b == 0) { return 0; }
  return a - idiv_floor(a, b) * b;
}

export fn f32_abs(x: float32) -> float32 {
  if (x < 0.0) { return -x; }
  if (x == 0.0) { return 0.0; }
  return x;
}

export fn f32_min(a: float32, b: float32) -> float32 {
  if (a < b) { return a; }
  return b;
}

export fn f32_max(a: float32, b: float32) -> float32 {
  if (a > b) { return a; }
  return b;
}

export fn f32_clamp(value: float32, lo: float32, hi: float32) -> float32 {
  if (value < lo) { return lo; }
  if (value > hi) { return hi; }
  return value;
}

export fn f32_lerp(a: float32, b: float32, t: float32) -> float32 {
  return a + (b - a) * t;
}

export fn f32_sqrt(x: float32) -> float32 {
  return (float32)sqrt((float64)x);
}
