// Mettle standard library: I/O
//
// Console output, file operations, and formatted printing.
//
// File I/O pattern with defer for automatic cleanup:
//   var file: cstring = fopen("data.txt", "r");
//   if (file != 0) {
//     defer fclose(file);
//     ... read/write operations ...
//   }
//
// Multiple resources with LIFO cleanup:
//   var src: cstring = fopen("input.txt", "r");
//   if (src == 0) { return err(); }
//   defer fclose(src);
//   
//   var dst: cstring = fopen("output.txt", "w");
//   if (dst == 0) { return err(); }
//   defer fclose(dst);  // Runs first (LIFO)
//   

// ─── Console output ─────────────────────────────────────────────────────────
export extern fn puts(msg: cstring) -> int32;
export extern fn putchar(c: int32) -> int32;
export extern fn getchar() -> int32 = "getchar";

// Write a string exactly as-is (no trailing newline).
//
// A `string` is a pointer and a length with no terminator, so this writes
// `length` bytes and never scans for a NUL. Nothing here depends on a C string:
// the write path is Mettle's own.
export fn print(msg: string) {
  if (msg.length > (uint64)0) {
    fwrite(msg.chars, 1, (int64)msg.length, get_stdout());
  }
}

// Write a string followed by a newline.
export fn println(msg: string) {
  print(msg);
  putchar(10);
}

// The boundary forms, for a pointer that arrived from C or from a byte buffer
// the program NUL-terminated itself. The length is discovered by scanning for
// the terminator, which is exactly the cost `print` does not pay.
export fn print_cstr(s: cstring) {
  fputs(s, get_stdout());
}

export fn println_cstr(s: cstring) {
  puts(s);
}

// Print a newline
export fn newline() {
  putchar(10);
}

// Print an integer to stdout (base 10, handles negatives)
// Builds digit string in buffer, single fputs instead of N putchar syscalls.
export fn print_int(n: int64) {
  var buf: uint8[22];
  var pos: int32 = 21;
  var neg: int32 = 0;
  buf[21] = 0;
  if (n < 0) {
    neg = 1;
    n = 0 - n;
  }
  if (n == 0) {
    buf[0] = 48;
    buf[1] = 0;
    fputs(&buf[0], get_stdout());
    return;
  }
  while (n > 0) {
    pos = pos - 1;
    buf[pos] = (uint8)(48 + n - (n / 10) * 10);
    n = n / 10;
  }
  if (neg != 0) {
    pos = pos - 1;
    buf[pos] = 45;
  }
  fputs(&buf[pos], get_stdout());
}

// Print an integer followed by a newline
export fn println_int(n: int64) {
  print_int(n);
  putchar(10);
}

// ─── File I/O ───────────────────────────────────────────────────────────────
// FILE* is represented as cstring (opaque pointer)
export extern fn fopen(filename: cstring, mode: cstring) -> cstring = "fopen";
export extern fn fclose(fp: cstring) -> int32 = "fclose";
export extern fn fread(buf: cstring, size: int64, count: int64, fp: cstring) -> int64 = "fread";
export extern fn fwrite(buf: cstring, size: int64, count: int64, fp: cstring) -> int64 = "fwrite";
export extern fn fputs(s: cstring, fp: cstring) -> int32 = "fputs";
export extern fn fgets(buf: cstring, size: int32, fp: cstring) -> cstring = "fgets";
export extern fn fflush(fp: cstring) -> int32 = "fflush";

// ─── Standard streams (accessed via C helpers) ──────────────────────────────
// On Windows, stdin/stdout/stderr are macros expanding to __acrt_iob_func(n).
// The owned Windows runtime exposes them through its _iob ABI adapter.
export extern fn __acrt_iob_func(index: int32) -> cstring = "__acrt_iob_func";

export fn get_stdin() -> cstring  { return __acrt_iob_func(0); }
export fn get_stdout() -> cstring { return __acrt_iob_func(1); }
export fn get_stderr() -> cstring { return __acrt_iob_func(2); }

// Write message to stderr (no newline)
export fn print_err(msg: string) {
  if (msg.length > (uint64)0) {
    fwrite(msg.chars, 1, (int64)msg.length, get_stderr());
  }
}

// Write message to stderr followed by newline
export fn println_err(msg: string) {
  print_err(msg);
  fwrite("\n".chars, 1, 1, get_stderr());
}

// ─── FFI string marshalling ─────────────────────────────────────────────────
//
// A Mettle `string` is a borrowed view: a pointer, a length, and no terminator.
// A C function reads until a NUL, so handing one a `string` means producing a
// terminated copy. `cstr` is where that copy happens, and it takes the
// allocator it comes from so the cost is in the signature rather than in the
// punctuation at every call site:
//
//     var path: cstring = cstr(name, &malloc);
//     defer free(path);
//     var fp: cstring = fopen(path, "rb");
//
// A string LITERAL needs none of this. It already sits in rodata with a
// terminator the compiler emitted, so it flows straight into a `cstring`
// parameter -- `fopen("data.txt", "rb")` allocates nothing.
//
// Returns 0 when the allocator does.
export fn cstr(s: string, alloc: fn(int64) -> rawptr) -> cstring {
  var n: int64 = (int64)s.length;
  var out: cstring = alloc(n + 1);
  if (out == 0) {
    return 0;
  }
  var src: cstring = s.chars;
  var i: int64 = 0;
  while (i < n) {
    out[i] = src[i];
    i = i + 1;
  }
  out[n] = 0;
  return out;
}
