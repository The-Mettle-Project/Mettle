// Clocks, durations and dates.
//
// A duration is an int64 count of nanoseconds; multiply by the TIME_* units
// to build one (`(int64)5 * TIME_SECOND`). Wall-clock times are unix
// nanoseconds. Dates use the proleptic Gregorian calendar.

import "std/time_os";
import "std/strbuf";

export const TIME_NANOSECOND: int64 = 1;
export const TIME_MICROSECOND: int64 = 1000;
export const TIME_MILLISECOND: int64 = 1000000;
export const TIME_SECOND: int64 = 1000000000;
export const TIME_MINUTE: int64 = 60000000000;
export const TIME_HOUR: int64 = 3600000000000;
export const TIME_DAY: int64 = 86400000000000;

// Enough room for any string the time_format_* functions write.
export const TIME_FORMAT_MAX: int64 = 48;

// A calendar date and clock time. offset_min is the zone's offset from UTC
// in minutes (0 for UTC); the other fields are local to that offset.
export struct DateTime {
  year: int32;      // 0..9999 can be formatted
  month: int32;     // 1..12
  day: int32;       // 1..31
  hour: int32;      // 0..23
  minute: int32;    // 0..59
  second: int32;    // 0..59
  nanos: int32;     // 0..999999999
  weekday: int32;   // 0 = Sunday
  yearday: int32;   // 1..366
  offset_min: int32;
}

// ---- Clocks -----------------------------------------------------------------

export fn time_unix() -> int64 { return time_floor_div(time_unix_ns(), TIME_SECOND); }
export fn time_unix_ms() -> int64 { return time_floor_div(time_unix_ns(), TIME_MILLISECOND); }
export fn time_unix_us() -> int64 { return time_floor_div(time_unix_ns(), TIME_MICROSECOND); }

export fn time_mono_us() -> int64 { return time_mono_ns() / TIME_MICROSECOND; }
export fn time_mono_ms() -> int64 { return time_mono_ns() / TIME_MILLISECOND; }

// Nanoseconds elapsed since a time_mono_ns() reading.
export fn time_since_ns(start: int64) -> int64 { return time_mono_ns() - start; }

export fn time_sleep_us(us: int64) { time_sleep_ns(us * TIME_MICROSECOND); }
export fn time_sleep_ms(ms: int64) { time_sleep_ns(ms * TIME_MILLISECOND); }

// ---- Calendar ---------------------------------------------------------------

// Division and remainder that round toward negative infinity, so times
// before 1970 land on the right day.
export fn time_floor_div(a: int64, b: int64) -> int64 {
  var q: int64 = a / b;
  if ((a % b != (int64)0) && ((a < (int64)0) != (b < (int64)0))) { q = q - (int64)1; }
  return q;
}

export fn time_floor_mod(a: int64, b: int64) -> int64 {
  return a - time_floor_div(a, b) * b;
}

export fn time_is_leap_year(year: int64) -> bool {
  if (year % (int64)4 != (int64)0) { return false; }
  if (year % (int64)100 != (int64)0) { return true; }
  return year % (int64)400 == (int64)0;
}

export fn time_days_in_month(year: int64, month: int32) -> int32 {
  switch (month) {
    case 2: {
      if (time_is_leap_year(year)) { return 29; }
      return 28;
    }
    case 4: { return 30; }
    case 6: { return 30; }
    case 9: { return 30; }
    case 11: { return 30; }
    default: { }
  }
  if (month < 1 || month > 12) { return 0; }
  return 31;
}

// Days since 1970-01-01 for a date. Howard Hinnant's days_from_civil.
export fn time_days_from_civil(year: int64, month: int32, day: int32) -> int64 {
  var y: int64 = year;
  if (month <= 2) { y = y - (int64)1; }
  var era: int64 = time_floor_div(y, (int64)400);
  var yoe: int64 = y - era * (int64)400;
  var mp: int64 = (int64)month - (int64)3;
  if (month <= 2) { mp = (int64)month + (int64)9; }
  var doy: int64 = ((int64)153 * mp + (int64)2) / (int64)5 + (int64)day - (int64)1;
  var doe: int64 = yoe * (int64)365 + yoe / (int64)4 - yoe / (int64)100 + doy;
  return era * (int64)146097 + doe - (int64)719468;
}

// 0 = Sunday, for a day count from time_days_from_civil.
export fn time_weekday_of_days(days: int64) -> int32 {
  return (int32)time_floor_mod(days + (int64)4, (int64)7);
}

fn time_fill_date(dt: DateTime*, days: int64) {
  var z: int64 = days + (int64)719468;
  var era: int64 = time_floor_div(z, (int64)146097);
  var doe: int64 = z - era * (int64)146097;
  var yoe: int64 = (doe - doe / (int64)1460 + doe / (int64)36524 - doe / (int64)146096) / (int64)365;
  var y: int64 = yoe + era * (int64)400;
  var doy: int64 = doe - ((int64)365 * yoe + yoe / (int64)4 - yoe / (int64)100);
  var mp: int64 = ((int64)5 * doy + (int64)2) / (int64)153;
  var d: int64 = doy - ((int64)153 * mp + (int64)2) / (int64)5 + (int64)1;
  var m: int64 = mp + (int64)3;
  if (mp >= (int64)10) { m = mp - (int64)9; }
  if (m <= (int64)2) { y = y + (int64)1; }
  dt->year = (int32)y;
  dt->month = (int32)m;
  dt->day = (int32)d;
  dt->weekday = time_weekday_of_days(days);
  dt->yearday = (int32)(days - time_days_from_civil(y, 1, 1)) + 1;
}

// Breaks unix nanoseconds into a date and time at offset_min minutes from UTC.
export fn time_at_offset(unix_ns: int64, offset_min: int32) -> DateTime {
  var dt: DateTime;
  var local: int64 = unix_ns + (int64)offset_min * TIME_MINUTE;
  var days: int64 = time_floor_div(local, TIME_DAY);
  var rest: int64 = local - days * TIME_DAY;
  time_fill_date(&dt, days);
  var secs: int64 = rest / TIME_SECOND;
  dt.hour = (int32)(secs / (int64)3600);
  dt.minute = (int32)((secs / (int64)60) % (int64)60);
  dt.second = (int32)(secs % (int64)60);
  dt.nanos = (int32)(rest % TIME_SECOND);
  dt.offset_min = offset_min;
  return dt;
}

// Breaks unix nanoseconds into a UTC date and time.
export fn time_utc(unix_ns: int64) -> DateTime {
  return time_at_offset(unix_ns, 0);
}

// The current UTC date and time.
export fn time_now_utc() -> DateTime {
  return time_at_offset(time_unix_ns(), 0);
}

// Unix seconds for a DateTime. weekday and yearday are ignored.
export fn time_to_unix(dt: DateTime) -> int64 {
  var days: int64 = time_days_from_civil((int64)dt.year, dt.month, dt.day);
  var secs: int64 = days * (int64)86400 + (int64)dt.hour * (int64)3600
    + (int64)dt.minute * (int64)60 + (int64)dt.second;
  return secs - (int64)dt.offset_min * (int64)60;
}

export fn time_to_unix_ns(dt: DateTime) -> int64 {
  return time_to_unix(dt) * TIME_SECOND + (int64)dt.nanos;
}

// Builds a UTC DateTime from its parts. Out-of-range parts roll over
// (month 13 is January of the next year), the way time_to_unix counts them.
export fn time_date(year: int32, month: int32, day: int32, hour: int32, minute: int32, second: int32) -> DateTime {
  var y: int64 = (int64)year + time_floor_div((int64)month - (int64)1, (int64)12);
  var m: int32 = (int32)time_floor_mod((int64)month - (int64)1, (int64)12) + 1;
  var days: int64 = time_days_from_civil(y, m, 1) + (int64)day - (int64)1;
  var secs: int64 = days * (int64)86400 + (int64)hour * (int64)3600
    + (int64)minute * (int64)60 + (int64)second;
  return time_utc(secs * TIME_SECOND);
}

// ---- Formatting -------------------------------------------------------------
//
// Each time_format_* writes into buf (at least TIME_FORMAT_MAX bytes is
// always enough), adds a NUL after the text, and returns the text length,
// or -1 if the year is outside 0..9999 or buf is too small.

const TIME_DAY_NAMES: string = "SunMonTueWedThuFriSat";
const TIME_MONTH_NAMES: string = "JanFebMarAprMayJunJulAugSepOctNovDec";

fn time_put_num(buf: uint8*, at: int64, n: int64, width: int32) {
  var v: int64 = n;
  var i: int32 = width - 1;
  while (i >= 0) {
    buf[at + (int64)i] = (uint8)((int64)48 + v % (int64)10);
    v = v / (int64)10;
    i = i - 1;
  }
}

fn time_put_name(buf: uint8*, at: int64, names: string, index: int32) {
  for k in 0..3 {
    buf[at + (int64)k] = (uint8)names[(int64)index * (int64)3 + (int64)k];
  }
}

// YYYY-MM-DD
export fn time_format_date(dt: DateTime, buf: uint8*, cap: int64) -> int64 {
  if (dt.year < 0 || dt.year > 9999 || cap < (int64)11) { return (int64)-1; }
  time_put_num(buf, (int64)0, (int64)dt.year, 4);
  buf[4] = (uint8)45;
  time_put_num(buf, (int64)5, (int64)dt.month, 2);
  buf[7] = (uint8)45;
  time_put_num(buf, (int64)8, (int64)dt.day, 2);
  buf[10] = (uint8)0;
  return (int64)10;
}

// RFC 3339 / ISO 8601: 2026-11-05T09:30:00Z, or +01:00 for a non-zero
// offset. frac_digits (0..9) picks how many digits of the second to keep.
export fn time_format_iso8601(dt: DateTime, frac_digits: int32, buf: uint8*, cap: int64) -> int64 {
  var digits: int32 = frac_digits;
  if (digits < 0) { digits = 0; }
  if (digits > 9) { digits = 9; }
  var need: int64 = (int64)20 + (int64)digits;
  if (digits > 0) { need = need + (int64)1; }
  if (dt.offset_min != 0) { need = need + (int64)5; }
  if (cap < need + (int64)1) { return (int64)-1; }
  if (time_format_date(dt, buf, cap) < (int64)0) { return (int64)-1; }
  buf[10] = (uint8)84;
  time_put_num(buf, (int64)11, (int64)dt.hour, 2);
  buf[13] = (uint8)58;
  time_put_num(buf, (int64)14, (int64)dt.minute, 2);
  buf[16] = (uint8)58;
  time_put_num(buf, (int64)17, (int64)dt.second, 2);
  var at: int64 = (int64)19;
  if (digits > 0) {
    buf[at] = (uint8)46;
    var frac: int64 = (int64)dt.nanos;
    for k in 0..(9 - digits) { frac = frac / (int64)10; }
    time_put_num(buf, at + (int64)1, frac, digits);
    at = at + (int64)1 + (int64)digits;
  }
  if (dt.offset_min == 0) {
    buf[at] = (uint8)90;
    at = at + (int64)1;
  } else {
    var off: int32 = dt.offset_min;
    buf[at] = (uint8)43;
    if (off < 0) {
      buf[at] = (uint8)45;
      off = 0 - off;
    }
    time_put_num(buf, at + (int64)1, (int64)(off / 60), 2);
    buf[at + (int64)3] = (uint8)58;
    time_put_num(buf, at + (int64)4, (int64)(off % 60), 2);
    at = at + (int64)6;
  }
  buf[at] = (uint8)0;
  return at;
}

// The HTTP date (RFC 9110 IMF-fixdate), always in GMT:
// Thu, 05 Nov 2026 09:30:00 GMT
export fn time_format_http(unix_ns: int64, buf: uint8*, cap: int64) -> int64 {
  var dt: DateTime = time_utc(unix_ns);
  if (dt.year < 0 || dt.year > 9999 || cap < (int64)30) { return (int64)-1; }
  time_put_name(buf, (int64)0, TIME_DAY_NAMES, dt.weekday);
  buf[3] = (uint8)44;
  buf[4] = (uint8)32;
  time_put_num(buf, (int64)5, (int64)dt.day, 2);
  buf[7] = (uint8)32;
  time_put_name(buf, (int64)8, TIME_MONTH_NAMES, dt.month - 1);
  buf[11] = (uint8)32;
  time_put_num(buf, (int64)12, (int64)dt.year, 4);
  buf[16] = (uint8)32;
  time_put_num(buf, (int64)17, (int64)dt.hour, 2);
  buf[19] = (uint8)58;
  time_put_num(buf, (int64)20, (int64)dt.minute, 2);
  buf[22] = (uint8)58;
  time_put_num(buf, (int64)23, (int64)dt.second, 2);
  buf[25] = (uint8)32;
  buf[26] = (uint8)71;
  buf[27] = (uint8)77;
  buf[28] = (uint8)84;
  buf[29] = (uint8)0;
  return (int64)29;
}

fn time_put_unit(buf: uint8*, at: int64, cap: int64, whole: int64, part: int64, part_digits: int32, unit: string) -> int64 {
  var tmp: uint8[24];
  var n: int32 = 0;
  var v: int64 = whole;
  if (v == (int64)0) {
    tmp[0] = (uint8)48;
    n = 1;
  }
  while (v > (int64)0) {
    tmp[n] = (uint8)((int64)48 + v % (int64)10);
    v = v / (int64)10;
    n = n + 1;
  }
  // Trim trailing zeros from the fraction.
  var digits: int32 = part_digits;
  var p: int64 = part;
  while (digits > 0 && p % (int64)10 == (int64)0) {
    p = p / (int64)10;
    digits = digits - 1;
  }
  var need: int64 = (int64)n + (int64)unit.length;
  if (digits > 0) { need = need + (int64)1 + (int64)digits; }
  if (at + need + (int64)1 > cap) { return (int64)-1; }
  var o: int64 = at;
  while (n > 0) {
    n = n - 1;
    buf[o] = tmp[n];
    o = o + (int64)1;
  }
  if (digits > 0) {
    buf[o] = (uint8)46;
    time_put_num(buf, o + (int64)1, p, digits);
    o = o + (int64)1 + (int64)digits;
  }
  for k in 0..unit.length {
    buf[o] = (uint8)unit[k];
    o = o + (int64)1;
  }
  buf[o] = (uint8)0;
  return o;
}

// A duration in the largest fitting unit: 1h2m3.5s, 2m0s, 1.5ms, 250us, 0s.
export fn time_format_duration(ns: int64, buf: uint8*, cap: int64) -> int64 {
  if (cap < (int64)2) { return (int64)-1; }
  var at: int64 = (int64)0;
  var v: int64 = ns;
  if (v < (int64)0) {
    buf[0] = (uint8)45;
    at = (int64)1;
    v = (int64)0 - v;   // the most negative int64 stays negative; treat as 0
    if (v < (int64)0) { v = (int64)0; }
  }
  if (v < TIME_MICROSECOND) {
    if (v == (int64)0) { return time_put_unit(buf, at, cap, (int64)0, (int64)0, 0, "s"); }
    return time_put_unit(buf, at, cap, v, (int64)0, 0, "ns");
  }
  if (v < TIME_MILLISECOND) {
    return time_put_unit(buf, at, cap, v / TIME_MICROSECOND, v % TIME_MICROSECOND, 3, "us");
  }
  if (v < TIME_SECOND) {
    return time_put_unit(buf, at, cap, v / TIME_MILLISECOND, v % TIME_MILLISECOND, 6, "ms");
  }
  var secs: int64 = v / TIME_SECOND;
  var frac: int64 = v % TIME_SECOND;
  if (secs >= (int64)3600) {
    at = time_put_unit(buf, at, cap, secs / (int64)3600, (int64)0, 0, "h");
    if (at < (int64)0) { return at; }
  }
  if (secs >= (int64)60) {
    at = time_put_unit(buf, at, cap, (secs / (int64)60) % (int64)60, (int64)0, 0, "m");
    if (at < (int64)0) { return at; }
  }
  return time_put_unit(buf, at, cap, secs % (int64)60, frac, 9, "s");
}

// StrBuf forms of the formatters. They return 1 on success and 0 on failure.

fn time_append(b: StrBuf*, buf: uint8*, n: int64) -> int32 {
  if (n < (int64)0) { return 0; }
  return strbuf_append_bytes(b, (cstring)buf, n);
}

export fn time_append_iso8601(b: StrBuf*, dt: DateTime, frac_digits: int32) -> int32 {
  var buf: uint8[48];
  return time_append(b, &buf[0], time_format_iso8601(dt, frac_digits, &buf[0], (int64)48));
}

export fn time_append_http(b: StrBuf*, unix_ns: int64) -> int32 {
  var buf: uint8[48];
  return time_append(b, &buf[0], time_format_http(unix_ns, &buf[0], (int64)48));
}

export fn time_append_duration(b: StrBuf*, ns: int64) -> int32 {
  var buf: uint8[48];
  return time_append(b, &buf[0], time_format_duration(ns, &buf[0], (int64)48));
}

// ---- Parsing ----------------------------------------------------------------

fn time_digits(s: string, at: int64, n: int32) -> int64 {
  if (at + (int64)n > (int64)s.length) { return (int64)-1; }
  var v: int64 = (int64)0;
  for k in 0..n {
    var c: int32 = (int32)s[at + (int64)k];
    if (c < 48 || c > 57) { return (int64)-1; }
    v = v * (int64)10 + (int64)(c - 48);
  }
  return v;
}

fn time_byte_is(s: string, at: int64, c: int32) -> bool {
  if (at >= (int64)s.length) { return false; }
  return (int32)s[at] == c;
}

fn time_check(dt: DateTime*) -> bool {
  if (dt->month < 1 || dt->month > 12) { return false; }
  if (dt->day < 1 || dt->day > time_days_in_month((int64)dt->year, dt->month)) { return false; }
  // Second 60 is a leap second; it is accepted and read as :59.
  if (dt->hour > 23 || dt->minute > 59 || dt->second > 60) { return false; }
  if (dt->second == 60) { dt->second = 59; }
  return true;
}

// Fills weekday and yearday from the other fields.
fn time_finish(dt: DateTime) -> DateTime {
  var out: DateTime = dt;
  var days: int64 = time_days_from_civil((int64)dt.year, dt.month, dt.day);
  out.weekday = time_weekday_of_days(days);
  out.yearday = (int32)(days - time_days_from_civil((int64)dt.year, 1, 1)) + 1;
  return out;
}

// Reads an RFC 3339 / ISO 8601 date or date-time:
//   2026-11-05
//   2026-11-05T09:30:00         (no zone means UTC)
//   2026-11-05 09:30:00.125Z    (a space may stand in for the T)
//   2026-11-05T09:30:00+01:00   (also +0100 and +01)
// The fields come back local to the parsed offset; time_to_unix_ns gives
// the instant.
export fn time_parse_iso8601(s: string) -> Result<DateTime, string> {
  var dt: DateTime;
  var y: int64 = time_digits(s, (int64)0, 4);
  var mo: int64 = time_digits(s, (int64)5, 2);
  var d: int64 = time_digits(s, (int64)8, 2);
  if (y < (int64)0 || mo < (int64)0 || d < (int64)0 || !time_byte_is(s, (int64)4, 45) || !time_byte_is(s, (int64)7, 45)) {
    return Err("expected YYYY-MM-DD");
  }
  dt.year = (int32)y;
  dt.month = (int32)mo;
  dt.day = (int32)d;
  var at: int64 = (int64)10;
  if (at < (int64)s.length) {
    var sep: int32 = (int32)s[at];
    if (sep != 84 && sep != 116 && sep != 32) { return Err("expected T after the date"); }
    var h: int64 = time_digits(s, at + (int64)1, 2);
    var mi: int64 = time_digits(s, at + (int64)4, 2);
    if (h < (int64)0 || mi < (int64)0 || !time_byte_is(s, at + (int64)3, 58)) { return Err("expected HH:MM"); }
    dt.hour = (int32)h;
    dt.minute = (int32)mi;
    at = at + (int64)6;
    if (time_byte_is(s, at, 58)) {
      var sec: int64 = time_digits(s, at + (int64)1, 2);
      if (sec < (int64)0) { return Err("expected seconds"); }
      dt.second = (int32)sec;
      at = at + (int64)3;
      if (time_byte_is(s, at, 46) || time_byte_is(s, at, 44)) {
        at = at + (int64)1;
        var nanos: int64 = (int64)0;
        var n: int32 = 0;
        while (at < (int64)s.length && (int32)s[at] >= 48 && (int32)s[at] <= 57) {
          if (n < 9) {
            nanos = nanos * (int64)10 + (int64)((int32)s[at] - 48);
            n = n + 1;
          }
          at = at + (int64)1;
        }
        if (n == 0) { return Err("expected digits after the decimal point"); }
        while (n < 9) {
          nanos = nanos * (int64)10;
          n = n + 1;
        }
        dt.nanos = (int32)nanos;
      }
    }
    if (at < (int64)s.length) {
      var z: int32 = (int32)s[at];
      if (z == 90 || z == 122) {
        at = at + (int64)1;
      } else if (z == 43 || z == 45) {
        var oh: int64 = time_digits(s, at + (int64)1, 2);
        if (oh < (int64)0) { return Err("expected a zone offset"); }
        var om: int64 = (int64)0;
        at = at + (int64)3;
        if (time_byte_is(s, at, 58)) { at = at + (int64)1; }
        if (at < (int64)s.length) {
          om = time_digits(s, at, 2);
          if (om < (int64)0) { return Err("expected offset minutes"); }
          at = at + (int64)2;
        }
        if (oh > (int64)23 || om > (int64)59) { return Err("zone offset out of range"); }
        var off: int32 = (int32)(oh * (int64)60 + om);
        if (z == 45) { off = 0 - off; }
        dt.offset_min = off;
      } else {
        return Err("unexpected text after the time");
      }
    }
    if (at != (int64)s.length) { return Err("unexpected text after the time"); }
  }
  if (!time_check(&dt)) { return Err("date or time out of range"); }
  return Ok(time_finish(dt));
}

fn time_name_index(s: string, at: int64, names: string, count: int32) -> int32 {
  if (at + (int64)3 > (int64)s.length) { return -1; }
  for i in 0..count {
    var hit: bool = true;
    for k in 0..3 {
      if (s[at + (int64)k] != names[(int64)i * (int64)3 + (int64)k]) { hit = false; }
    }
    if (hit) { return i; }
  }
  return -1;
}

// Reads an HTTP date in IMF-fixdate form (Thu, 05 Nov 2026 09:30:00 GMT)
// and returns unix nanoseconds.
export fn time_parse_http(s: string) -> Result<int64, string> {
  if (s.length != (uint64)29) { return Err("expected an IMF-fixdate"); }
  if (time_name_index(s, (int64)0, TIME_DAY_NAMES, 7) < 0) { return Err("bad day name"); }
  var mon: int32 = time_name_index(s, (int64)8, TIME_MONTH_NAMES, 12);
  if (mon < 0) { return Err("bad month name"); }
  var dt: DateTime;
  var d: int64 = time_digits(s, (int64)5, 2);
  var y: int64 = time_digits(s, (int64)12, 4);
  var h: int64 = time_digits(s, (int64)17, 2);
  var mi: int64 = time_digits(s, (int64)20, 2);
  var sec: int64 = time_digits(s, (int64)23, 2);
  if (d < (int64)0 || y < (int64)0 || h < (int64)0 || mi < (int64)0 || sec < (int64)0) { return Err("bad number"); }
  if (!time_byte_is(s, (int64)3, 44) || !time_byte_is(s, (int64)19, 58) || !time_byte_is(s, (int64)22, 58)) { return Err("bad separator"); }
  if (!time_byte_is(s, (int64)26, 71) || !time_byte_is(s, (int64)27, 77) || !time_byte_is(s, (int64)28, 84)) { return Err("expected GMT"); }
  dt.year = (int32)y;
  dt.month = mon + 1;
  dt.day = (int32)d;
  dt.hour = (int32)h;
  dt.minute = (int32)mi;
  dt.second = (int32)sec;
  if (!time_check(&dt)) { return Err("date or time out of range"); }
  return Ok(time_to_unix(dt) * TIME_SECOND);
}
