                                      stream, params, nargs);
}

export fn mtlc_gpu_launch_indirect_checked(f: int64, counts: int64,
                                           bx: int32, by: int32, bz: int32,
                                           shared_bytes: int32, stream: int64,
                                           params: int64*, nargs: int32) {
  __mtlc_metal_launch_indirect_checked(f, counts, bx, by, bz, shared_bytes,
                                       stream, params, nargs);
}

@inline export fn gpu_launch_on(f: int64, grid: int32, block: int32,
                        stream: int64, params: int64*, nargs: int32) -> int32 {
  return gpu_launch_3d(f, grid, 1, 1, block, 1, 1, 0, stream, params, nargs);
}

@inline export fn gpu_graph_capture_begin(stream: int64) -> int32 {
  return __mtlc_metal_capture_begin();
}
export fn gpu_graph_capture_end(stream: int64) -> int64 {
  return __mtlc_metal_capture_end();
}
@inline export fn gpu_graph_launch(exec: int64, stream: int64) -> int32 {
  return __mtlc_metal_graph_launch(exec);
}
@inline export fn gpu_graph_destroy(exec: int64) -> int32 {
  return __mtlc_metal_graph_destroy(exec);
}

var g_gpu_kernel_path: uint8[1024];

export fn gpu_open_kernels(stem: cstring) -> int32 {
  var n: int64 = 0;
  while (n < 1000 && stem[n] != 0) {
    g_gpu_kernel_path[n] = (uint8)stem[n];
    n = n + 1;
  }
  var extension: cstring = __mtlc_metal_cstr(".metal");
  var k: int64 = 0;
  while (extension[k] != 0) {
    g_gpu_kernel_path[n + k] = (uint8)extension[k];
    k = k + 1;
  }
  g_gpu_kernel_path[n + k] = 0;
  return gpu_open((cstring)&g_gpu_kernel_path[0]);
}

export fn gpu_provider_name() -> cstring { return __mtlc_metal_cstr("Metal"); }

var g_gpu_bound_module: int64 = 0;

export fn gpu_module_bind(mod: int64) -> int64 {
  var previous: int64 = g_gpu_bound_module;
  g_gpu_bound_module = mod;
  return previous;
}

@inline export fn gpu_module_bound() -> int64 { return g_gpu_bound_module; }

export fn mtlc_gpu_kernel_handle(name: cstring) -> int64 {
  if (g_gpu_bound_module == 0) {
    __mtlc_metal_fail(__mtlc_metal_cstr("mettle: dispatch of kernel '"), name,
                      __mtlc_metal_cstr("' before any GPU module was loaded"));
  }
  var handle: int64 = __mtlc_metal_kernel(name);
  if (handle == 0) {
    __mtlc_metal_note(__mtlc_metal_cstr("mettle: the loaded Metal library cannot run kernel '"));
    __mtlc_metal_note(name);
    __mtlc_metal_note(__mtlc_metal_cstr("'\n  Metal: "));
    __mtlc_metal_fail(__mtlc_metal_error(), __mtlc_metal_cstr(""),
                      __mtlc_metal_cstr(""));
  }
  return handle;
}

export fn gpu_launch_sync(f: int64, grid: int32, block: int32,
                                params: int64*, nargs: int32) -> int32 {
  var rc: int32 = gpu_launch(f, grid, block, params, nargs);
  if (rc != 0) { return rc; }
  return __mtlc_metal_sync();
}
