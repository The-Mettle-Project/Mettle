// Typed wrappers for common Linux system calls, on x86-64 and AArch64. The
// numbers come from std/linux_sys, so a program names the call, not the
// number. Each wrapper returns the kernel's raw result: a count or value, or
// -errno. Linux only; a Windows or macOS build must not import this.

import "std/linux_sys";

export const LINUX_AT_FDCWD = -100;

export const LINUX_O_RDONLY = 0;
export const LINUX_O_WRONLY = 1;
export const LINUX_O_RDWR = 2;
export const LINUX_O_CREAT = 64;
export const LINUX_O_EXCL = 128;
export const LINUX_O_TRUNC = 512;
export const LINUX_O_APPEND = 1024;
export const LINUX_O_CLOEXEC = 524288;

export const LINUX_PROT_NONE = 0;
export const LINUX_PROT_READ = 1;
export const LINUX_PROT_WRITE = 2;
export const LINUX_PROT_EXEC = 4;
export const LINUX_MAP_SHARED = 1;
export const LINUX_MAP_PRIVATE = 2;
export const LINUX_MAP_ANONYMOUS = 32;

export const LINUX_CLOCK_REALTIME = 0;
export const LINUX_CLOCK_MONOTONIC = 1;

export const LINUX_POLLIN = 1;
export const LINUX_POLLOUT = 4;
export const LINUX_POLLERR = 8;
export const LINUX_POLLHUP = 16;
export const LINUX_POLLNVAL = 32;

export const LINUX_SIG_BLOCK = 0;
export const LINUX_SIG_UNBLOCK = 1;
export const LINUX_SIG_SETMASK = 2;
export const LINUX_SFD_NONBLOCK = 2048;
export const LINUX_SFD_CLOEXEC = 524288;

export const LINUX_EINTR = 4;
export const LINUX_EAGAIN = 11;
export const LINUX_ETIMEDOUT = 110;

// One entry for linux_ppoll: the descriptor, what to wait for, what happened.
export struct LinuxPollFd {
  fd: int32
  events: int16
  revents: int16
}

// Reads up to n bytes. Returns the count, 0 at end of file, or -errno.
export fn linux_read(fd: int64, buf: uint8*, n: int64) -> int64 {
  return syscall(LINUX_SYS_READ, fd, buf, n);
}

// Writes up to n bytes. Returns the count or -errno.
export fn linux_write(fd: int64, buf: uint8*, n: int64) -> int64 {
  return syscall(LINUX_SYS_WRITE, fd, buf, n);
}

export fn linux_close(fd: int64) -> int64 {
  return syscall(LINUX_SYS_CLOSE, fd);
}

// path is nul-terminated. Returns the new descriptor or -errno.
export fn linux_openat(dirfd: int64, path: uint8*, flags: int64, mode: int64) -> int64 {
  return syscall(LINUX_SYS_OPENAT, dirfd, path, flags, mode);
}

export fn linux_lseek(fd: int64, offset: int64, whence: int64) -> int64 {
  return syscall(LINUX_SYS_LSEEK, fd, offset, whence);
}

export fn linux_getpid() -> int64 {
  return syscall(LINUX_SYS_GETPID);
}

export fn linux_gettid() -> int64 {
  return syscall(LINUX_SYS_GETTID);
}

export fn linux_kill(pid: int64, sig: int64) -> int64 {
  return syscall(LINUX_SYS_KILL, pid, sig);
}

export fn linux_ioctl(fd: int64, req: int64, arg: rawptr) -> int64 {
  return syscall(LINUX_SYS_IOCTL, fd, req, arg);
}

// how is LINUX_SIG_BLOCK, LINUX_SIG_UNBLOCK or LINUX_SIG_SETMASK. Signal n
// is bit n-1 of the mask. set and old may be 0.
export fn linux_rt_sigprocmask(how: int64, set: uint64*, old: uint64*) -> int64 {
  return syscall(LINUX_SYS_RT_SIGPROCMASK, how, set, old, 8);
}

// fd is -1 for a new descriptor. flags takes LINUX_SFD_NONBLOCK and
// LINUX_SFD_CLOEXEC. Each read gives 128-byte records; the signal number is
// the first 32-bit word.
export fn linux_signalfd(fd: int64, mask: uint64*, flags: int64) -> int64 {
  return syscall(LINUX_SYS_SIGNALFD4, fd, mask, 8, flags);
}

export fn linux_sched_yield() -> int64 {
  return syscall(LINUX_SYS_SCHED_YIELD);
}

// Sleeps while *word equals expected. timeout is a relative {seconds,
// nanoseconds} pair, or 0 to wait for good. Returns 0 on a wake, -EAGAIN if
// the word had already changed, -ETIMEDOUT, or -EINTR. Process-private.
export fn linux_futex_wait(word: int32*, expected: int32, timeout: int64*) -> int64 {
  return syscall(LINUX_SYS_FUTEX, word, 128, expected, timeout, 0, 0);
}

// Wakes up to count waiters on word. Returns how many woke.
export fn linux_futex_wake(word: int32*, count: int32) -> int64 {
  return syscall(LINUX_SYS_FUTEX, word, 129, count, 0, 0, 0);
}

// Fills buf with n random bytes. flags is 0, or GRND_NONBLOCK (1).
export fn linux_getrandom(buf: uint8*, n: int64, flags: int64) -> int64 {
  return syscall(LINUX_SYS_GETRANDOM, buf, n, flags);
}

// out is two int64s: seconds, then nanoseconds. Returns 0 or -errno.
export fn linux_clock_gettime(clock: int64, out: int64*) -> int64 {
  return syscall(LINUX_SYS_CLOCK_GETTIME, clock, out);
}

// req and rem are {seconds, nanoseconds} pairs; rem may be 0.
export fn linux_nanosleep(req: int64*, rem: int64*) -> int64 {
  return syscall(LINUX_SYS_NANOSLEEP, req, rem);
}

// Maps length bytes. Returns the address or -errno (a value in -4095..-1).
export fn linux_mmap(addr: int64, length: int64, prot: int64, flags: int64, fd: int64, offset: int64) -> int64 {
  return syscall(LINUX_SYS_MMAP, addr, length, prot, flags, fd, offset);
}

export fn linux_munmap(addr: int64, length: int64) -> int64 {
  return syscall(LINUX_SYS_MUNMAP, addr, length);
}

// Waits for nfds descriptors. timeout is a {seconds, nanoseconds} pair, or 0
// to wait for good. Returns how many have events, 0 on timeout, or -errno.
export fn linux_ppoll(fds: LinuxPollFd*, nfds: int64, timeout: int64*) -> int64 {
  return syscall(LINUX_SYS_PPOLL, fds, nfds, timeout, 0, 8);
}

// Ends the whole process, every thread, with code. Does not return.
export fn linux_exit_group(code: int64) {
  syscall(LINUX_SYS_EXIT_GROUP, code);
}
