// Environment variables and program arguments.
//
// The runtime keeps the environment on every platform: on Linux, where no
// libc is linked, it reads the block the kernel passed in and keeps changes
// in a table of its own.

import "std/core";
import "std/env_os";

extern fn env_c_getenv(name: uint8*) -> uint8* = "getenv";
extern fn env_c_putenv(setting: uint8*) -> int32 = "putenv";
extern fn env_c_list(buf: uint8*, size: uint64, prefix: uint8*) -> uint64 = "mettle_environment_write";
extern fn env_c_alloc(n: uint64) -> uint8* = "malloc";

fn env_cname(name: string, buf: uint8*) -> bool {
  if (name.length == (uint64)0 || name.length >= (uint64)255) { return false; }
  for i in 0..name.length {
    var c: int32 = (int32)name[i];
    if (c == 61 || c == 0) { return false; }   // no '=' or NUL in a name
    buf[i] = (uint8)c;
  }
  buf[(int64)name.length] = (uint8)0;
  return true;
}

// The value of an environment variable, or None. The view stays valid until
// the variable is set again.
export fn env_get(name: string) -> Option<string> {
  var cn: uint8[256];
  if (!env_cname(name, &cn[0])) { return None; }
  var v: uint8* = env_c_getenv(&cn[0]);
  if (v == 0) { return None; }
  var n: int64 = 0;
  while (v[n] != (uint8)0) { n = n + 1; }
  var s: string;
  s.chars = v;
  s.length = (uint64)n;
  return Some(s);
}

export fn env_get_or(name: string, fallback: string) -> string {
  match (env_get(name)) {
    case Some(v): { return v; }
    case None: { return fallback; }
  }
}

export fn env_has(name: string) -> bool {
  match (env_get(name)) {
    case Some(v): { return true; }
    case None: { return false; }
  }
}

// Sets a variable for this process and, on macOS and Windows, for programs
// it starts. Returns 0, or -22 (EINVAL) for a bad name. The NAME=value text
// is copied to the heap and kept for good, as putenv requires.
export fn env_set(name: string, value: string) -> int64 {
  var cn: uint8[256];
  if (!env_cname(name, &cn[0])) { return -22; }
  for i in 0..value.length {
    if ((int32)value[i] == 0) { return -22; }
  }
  var n: int64 = (int64)name.length + 1 + (int64)value.length;
  var p: uint8* = env_c_alloc((uint64)(n + 1));
  if (p == 0) { return -12; }
  for i in 0..name.length { p[i] = (uint8)name[i]; }
  p[(int64)name.length] = (uint8)61;
  for i in 0..value.length { p[(int64)name.length + 1 + i] = (uint8)value[i]; }
  p[n] = (uint8)0;
  if (env_c_putenv(p) != 0) { return -22; }
  return 0;
}

// Writes every variable as NAME=value lines (each ending in \n) into buf,
// adds a NUL, and returns the length. Entries that do not fit are left out.
// With a non-empty prefix, only names starting with it are written.
export fn env_list(buf: uint8*, cap: int64, prefix: string) -> int64 {
  var cp: uint8[256];
  var pp: uint8* = (uint8*)0;
  if (prefix.length > (uint64)0) {
    if (prefix.length >= (uint64)255) { return 0; }
    for i in 0..prefix.length { cp[i] = (uint8)prefix[i]; }
    cp[(int64)prefix.length] = (uint8)0;
    pp = &cp[0];
  }
  if (cap <= 0) { return 0; }
  return (int64)env_c_list(buf, (uint64)cap, pp);
}

// The program's arguments, argv[0] first: writes up to max views into out
// and returns how many there are in all. The views stay valid for the run.
export fn env_args(out: string*, max: int32) -> int32 {
  return env_os_args(out, max);
}
