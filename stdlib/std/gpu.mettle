extern fn __mtlc_gpu_cas(target: int32*, exchange: int32, comparand: int32) -> int32 with none = "mettle_atomic_compare_exchange_i32";

var g_cu: rawptr[51];
var g_cu_state: int32 = 0;
var g_cu_lock: SyncMutex;
var g_cu_library: rawptr = (rawptr)0;

fn __mtlc_cu_bind(index: int32, name: string) {
  g_cu[index] = dl_sym(g_cu_library, name);
}

fn __mtlc_cu_open() -> int32 {
  g_cu_library = dl_open(GPU_DRIVER_LIBRARY);
  if (g_cu_library == 0) { return -1; }
  __mtlc_cu_bind(CU_INIT, "cuInit");
  __mtlc_cu_bind(CU_DEVICE_GET, "cuDeviceGet");
  __mtlc_cu_bind(CU_DEVICE_GET_ATTRIBUTE, "cuDeviceGetAttribute");
  __mtlc_cu_bind(CU_CTX_CREATE, "cuCtxCreate_v2");
  __mtlc_cu_bind(CU_MODULE_LOAD_DATA, "cuModuleLoadData");
  __mtlc_cu_bind(CU_MODULE_LOAD_DATA_EX, "cuModuleLoadDataEx");
  __mtlc_cu_bind(CU_MODULE_UNLOAD, "cuModuleUnload");
  __mtlc_cu_bind(CU_GET_ERROR_NAME, "cuGetErrorName");
  __mtlc_cu_bind(CU_GET_ERROR_STRING, "cuGetErrorString");
  __mtlc_cu_bind(CU_DRIVER_GET_VERSION, "cuDriverGetVersion");
  __mtlc_cu_bind(CU_DEVICE_GET_COUNT, "cuDeviceGetCount");
  __mtlc_cu_bind(CU_DEVICE_GET_NAME, "cuDeviceGetName");
  __mtlc_cu_bind(CU_DEVICE_TOTAL_MEM, "cuDeviceTotalMem_v2");
  __mtlc_cu_bind(CU_MODULE_GET_FUNCTION, "cuModuleGetFunction");
  __mtlc_cu_bind(CU_MEM_ALLOC, "cuMemAlloc_v2");
  __mtlc_cu_bind(CU_MEM_ALLOC_MANAGED, "cuMemAllocManaged");
  __mtlc_cu_bind(CU_MEM_ALLOC_ASYNC, "cuMemAllocAsync");
  __mtlc_cu_bind(CU_MEM_FREE, "cuMemFree_v2");
  __mtlc_cu_bind(CU_MEM_FREE_ASYNC, "cuMemFreeAsync");
  __mtlc_cu_bind(CU_MEM_HOST_ALLOC, "cuMemHostAlloc");
  __mtlc_cu_bind(CU_MEM_FREE_HOST, "cuMemFreeHost");
  __mtlc_cu_bind(CU_MEM_HOST_GET_DEVICE_POINTER, "cuMemHostGetDevicePointer_v2");
  __mtlc_cu_bind(CU_MEMCPY_HTOD, "cuMemcpyHtoD_v2");
  __mtlc_cu_bind(CU_MEMCPY_DTOH, "cuMemcpyDtoH_v2");
  __mtlc_cu_bind(CU_MEMCPY_HTOD_ASYNC, "cuMemcpyHtoDAsync_v2");
  __mtlc_cu_bind(CU_MEMCPY_DTOH_ASYNC, "cuMemcpyDtoHAsync_v2");
  __mtlc_cu_bind(CU_MEMSET_D8, "cuMemsetD8_v2");
  __mtlc_cu_bind(CU_MEMSET_D16, "cuMemsetD16_v2");
  __mtlc_cu_bind(CU_MEMSET_D32, "cuMemsetD32_v2");
  __mtlc_cu_bind(CU_MEMSET_D8_ASYNC, "cuMemsetD8Async");
  __mtlc_cu_bind(CU_MEMSET_D16_ASYNC, "cuMemsetD16Async");
  __mtlc_cu_bind(CU_MEMSET_D32_ASYNC, "cuMemsetD32Async");
  __mtlc_cu_bind(CU_STREAM_CREATE, "cuStreamCreate");
  __mtlc_cu_bind(CU_STREAM_DESTROY, "cuStreamDestroy_v2");
  __mtlc_cu_bind(CU_STREAM_SYNCHRONIZE, "cuStreamSynchronize");
  __mtlc_cu_bind(CU_STREAM_WAIT_EVENT, "cuStreamWaitEvent");
  __mtlc_cu_bind(CU_EVENT_CREATE, "cuEventCreate");
  __mtlc_cu_bind(CU_EVENT_DESTROY, "cuEventDestroy_v2");
  __mtlc_cu_bind(CU_EVENT_RECORD, "cuEventRecord");
  __mtlc_cu_bind(CU_EVENT_QUERY, "cuEventQuery");
  __mtlc_cu_bind(CU_STREAM_QUERY, "cuStreamQuery");
  __mtlc_cu_bind(CU_EVENT_SYNCHRONIZE, "cuEventSynchronize");
  __mtlc_cu_bind(CU_EVENT_ELAPSED_TIME, "cuEventElapsedTime");
  __mtlc_cu_bind(CU_LAUNCH_KERNEL, "cuLaunchKernel");
  __mtlc_cu_bind(CU_CTX_SYNCHRONIZE, "cuCtxSynchronize");
  __mtlc_cu_bind(CU_STREAM_BEGIN_CAPTURE, "cuStreamBeginCapture_v2");
  __mtlc_cu_bind(CU_STREAM_END_CAPTURE, "cuStreamEndCapture");
  __mtlc_cu_bind(CU_GRAPH_INSTANTIATE, "cuGraphInstantiateWithFlags");
  __mtlc_cu_bind(CU_GRAPH_LAUNCH, "cuGraphLaunch");
  __mtlc_cu_bind(CU_GRAPH_EXEC_DESTROY, "cuGraphExecDestroy");
  __mtlc_cu_bind(CU_GRAPH_DESTROY, "cuGraphDestroy");
  if (g_cu[CU_INIT] == 0) { return -1; }
  return 1;
}

fn __mtlc_cu(index: int32) -> rawptr {
  if (__mtlc_gpu_cas(&g_cu_state, 0, 0) == 0) {
    sync_mutex_lock(&g_cu_lock);
    if (g_cu_state == 0) {
      __mtlc_gpu_cas(&g_cu_state, __mtlc_cu_open(), 0);
    }
    sync_mutex_unlock(&g_cu_lock);
  }
  if (g_cu_state < 0) { return (rawptr)0; }
  return g_cu[index];
}

fn __mtlc_cu_missing() -> int32 {
  if (g_cu_state < 0) { return CUDA_ERROR_NO_DEVICE; }
  return CUDA_ERROR_NOT_FOUND;
}

export fn gpu_driver_loaded() -> bool {
  return __mtlc_cu(CU_INIT) != 0;
}

