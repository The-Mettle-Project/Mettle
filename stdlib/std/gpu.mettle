export fn gpu_host_mapped_malloc(bytes: int64, dev_ptr_out: int64*) -> uint8* {
  dev_ptr_out[0] = 0;
  var hp: int64 = 0;
  if (cuMemHostAlloc(&hp, bytes, 2) != 0) { return (uint8*)0; }
  var dp: int64 = 0;
  if (cuMemHostGetDevicePointer_v2(&dp, hp, 0) != 0) {
    cuMemFreeHost(hp);
    return (uint8*)0;
  }
  dev_ptr_out[0] = dp;
  return (uint8*)hp;
}
