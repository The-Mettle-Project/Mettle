@inline fn __mtlc_gpu_cstr(s: string) -> cstring { return s.chars; }

fn __mtlc_gpu_note(text: string) {
  __mtlc_gpu_fputs(text.chars, get_stderr());
}

fn __mtlc_gpu_fail(part1: cstring, part2: cstring, part3: cstring) {
  var err: cstring = get_stderr();
  __mtlc_gpu_fputs(part1, err);
  __mtlc_gpu_fputs(part2, err);
  __mtlc_gpu_fputs(part3, err);
  __mtlc_gpu_fputs(__mtlc_gpu_cstr("\n"), err);
  __mtlc_gpu_process_exit(1);
}

export fn gpu_error_name(status: int32) -> cstring {
  var text: cstring = 0;
  if (cuGetErrorName(status, &text) != 0 || text == 0) {
    return __mtlc_gpu_cstr("CUDA_ERROR_UNKNOWN");
  }
  return text;
}

export fn gpu_error_text(status: int32) -> cstring {
  var text: cstring = 0;
  if (cuGetErrorString(status, &text) != 0 || text == 0) {
    return __mtlc_gpu_cstr("unrecognized CUDA status");
  }
  return text;
}

fn __mtlc_gpu_report(what: string, status: int32) {
  var err: cstring = get_stderr();
  __mtlc_gpu_fputs(what.chars, err);
  __mtlc_gpu_fputs(__mtlc_gpu_cstr(": "), err);
  __mtlc_gpu_fputs(gpu_error_name(status), err);
  __mtlc_gpu_fputs(__mtlc_gpu_cstr(" ("), err);
  __mtlc_gpu_fputs(gpu_error_text(status), err);
  __mtlc_gpu_fputs(__mtlc_gpu_cstr(")\n"), err);
}

export fn gpu_init() -> int64 { return gpu_init_on(0); }

export fn gpu_init_on(ordinal: int32) -> int64 {
  if (!gpu_driver_loaded()) {
    __mtlc_gpu_note("mettle: no CUDA driver: {GPU_DRIVER_LIBRARY} would not load ({dl_error()})\n");
    return 0;
  }
  var status: int32 = cuInit(0);
  if (status != 0) {
    __mtlc_gpu_report("mettle: no usable CUDA driver", status);
    return 0;
  }
  var count: int32 = 0;
  if (cuDeviceGetCount(&count) == 0 && ordinal >= count) {
    __mtlc_gpu_note("mettle: GPU {ordinal} was asked for, but this machine has {count}\n");
    return 0;
  }
  var dev: int32 = 0;
  status = cuDeviceGet(&dev, ordinal);
  if (status != 0) {
    __mtlc_gpu_report("mettle: no such GPU", status);
    return 0;
  }
  var ctx: int64 = 0;
  status = cuCtxCreate_v2(&ctx, 8, dev);
  if (status != 0) {
    __mtlc_gpu_report("mettle: could not create a GPU context", status);
    return 0;
  }
  return ctx;
}

export fn gpu_device_count() -> int32 {
  var count: int32 = 0;
  // The driver answers nothing before cuInit, which is safe to call again.
  if (cuInit(0) != 0) { return 0; }
  if (cuDeviceGetCount(&count) != 0) { return 0; }
  return count;
}

fn __mtlc_gpu_attribute(ordinal: int32, attribute: int32) -> int32 {
  var dev: int32 = 0;
  if (cuDeviceGet(&dev, ordinal) != 0) { return 0; }
  var value: int32 = 0;
  if (cuDeviceGetAttribute(&value, attribute, dev) != 0) { return 0; }
  return value;
}

export fn gpu_sm_count(ordinal: int32) -> int32 {
  return __mtlc_gpu_attribute(ordinal, 16);
}
export fn gpu_warp_size(ordinal: int32) -> int32 {
  return __mtlc_gpu_attribute(ordinal, 10);
}
export fn gpu_max_threads_per_block(ordinal: int32) -> int32 {
  return __mtlc_gpu_attribute(ordinal, 1);
}
export fn gpu_max_shared_memory_per_block(ordinal: int32) -> int32 {
  return __mtlc_gpu_attribute(ordinal, 8);
}
export fn gpu_is_integrated(ordinal: int32) -> int32 {
  return __mtlc_gpu_attribute(ordinal, 18);
}
export fn gpu_compute_capability(ordinal: int32) -> int32 {
  var major: int32 = __mtlc_gpu_attribute(ordinal, 75);
  return major * 10 + __mtlc_gpu_attribute(ordinal, 76);
}
export fn gpu_total_memory(ordinal: int32) -> int64 {
  var dev: int32 = 0;
  if (cuDeviceGet(&dev, ordinal) != 0) { return 0; }
  var bytes: int64 = 0;
  if (cuDeviceTotalMem_v2(&bytes, dev) != 0) { return 0; }
  return bytes;
}
export fn gpu_driver_version() -> int32 {
  var version: int32 = 0;
  if (cuDriverGetVersion(&version) != 0) { return 0; }
  return version;
}
export fn gpu_device_name(ordinal: int32, buffer: uint8*, capacity: int32) -> string {
  var name: string;
  name.chars = (cstring)buffer;
  name.length = (uint64)0;
  if (buffer == (uint8*)0 || capacity <= 1) { return name; }
  buffer[0] = 0;
  var dev: int32 = 0;
  if (cuDeviceGet(&dev, ordinal) != 0) { return name; }
  if (cuDeviceGetName((cstring)buffer, capacity, dev) != 0) { return name; }
  var n: int64 = 0;
  while (n < (int64)capacity && buffer[n] != 0) { n = n + 1; }
  name.length = (uint64)n;
  return name;
}

export fn gpu_open(ptx_path: cstring) -> int32 {
  return gpu_open_on(0, ptx_path);
}

var g_gpu_kernel_path: uint8[1024];

export fn gpu_open_kernels(stem: cstring) -> int32 {
  var n: int64 = 0;
  while (n < 1000 && stem[n] != 0) {
    g_gpu_kernel_path[n] = (uint8)stem[n];
    n = n + 1;
  }
  var extension: cstring = __mtlc_gpu_cstr(".ptx");
  var k: int64 = 0;
  while (extension[k] != 0) {
    g_gpu_kernel_path[n + k] = (uint8)extension[k];
    k = k + 1;
  }
  g_gpu_kernel_path[n + k] = 0;
  return gpu_open((cstring)&g_gpu_kernel_path[0]);
}

export fn gpu_provider_name() -> cstring { return __mtlc_gpu_cstr("CUDA"); }

export fn gpu_open_on(ordinal: int32, ptx_path: cstring) -> int32 {
  if (gpu_init_on(ordinal) == 0) { return 0; }
  if (gpu_module_file(ptx_path) == 0) { return 0; }
  return 1;
}

var g_gpu_jit_log: uint8[8192];

export fn gpu_module(ptx_image: uint8*) -> int64 {
  var status: int32 = 0;
  var mod: int64 = gpu_module_ex(ptx_image, &status);
  if (mod == 0) {
    __mtlc_gpu_report("mettle: the GPU module would not load", status);
    if (g_gpu_jit_log[0] != 0) {
      __mtlc_gpu_note("--- CUDA PTX JIT log ---\n");
      __mtlc_gpu_fputs((cstring)&g_gpu_jit_log[0], get_stderr());
      __mtlc_gpu_note("\n------------------------\n");
    }
    return 0;
  }
  return mod;
}

fn __mtlc_gpu_load_image(ptx_image: uint8*, status_out: int32*) -> int64 {
  var options: int32[2];
  var values: int64[2];
  options[0] = 5;
  values[0] = (int64)&g_gpu_jit_log[0];
  options[1] = 6;
  values[1] = 8192;
  g_gpu_jit_log[0] = 0;
  var mod: int64 = 0;
  var status: int32 = cuModuleLoadDataEx(&mod, ptx_image, 2, &options[0],
                                         &values[0]);
  status_out[0] = status;
  if (status != 0) { return 0; }
  return mod;
}

export fn gpu_module_ex(ptx_image: uint8*, status_out: int32*) -> int64 {
  var mod: int64 = __mtlc_gpu_load_image(ptx_image, status_out);
  if (mod != 0) { gpu_module_bind(mod); }
  return mod;
}

@inline export fn gpu_jit_log() -> cstring { return (cstring)&g_gpu_jit_log[0]; }

export fn gpu_module_file(path: cstring) -> int64 {
  var fp: cstring = __mtlc_gpu_fopen(path, __mtlc_gpu_cstr("rb"));
  if (fp == 0) {
    __mtlc_gpu_note("mettle: cannot open the GPU module '");
    __mtlc_gpu_fputs(path, get_stderr());
    __mtlc_gpu_note("'; emit it first with `mettle --emit-ptx`\n");
    return 0;
  }
  __mtlc_gpu_fseek(fp, 0, 2);
  var size: int64 = __mtlc_gpu_ftell(fp);
  __mtlc_gpu_fseek(fp, 0, 0);
  if (size <= 0) {
    __mtlc_gpu_fclose(fp);
    __mtlc_gpu_note("mettle: the GPU module '");
    __mtlc_gpu_fputs(path, get_stderr());
    __mtlc_gpu_note("' is empty\n");
    return 0;
  }
  var image: uint8* = __mtlc_gpu_malloc(size + 1);
  if (image == (uint8*)0) {
    __mtlc_gpu_fclose(fp);
    __mtlc_gpu_note("mettle: out of memory reading the GPU module\n");
    return 0;
  }
  var read: int64 = __mtlc_gpu_fread(image, 1, size, fp);
  __mtlc_gpu_fclose(fp);
  image[read] = 0;
  var mod: int64 = gpu_module(image);
  __mtlc_gpu_release(image);
  return mod;
}

export fn gpu_func(mod: int64, name: cstring) -> int64 {
  var kf: int64 = 0;
  if (cuModuleGetFunction(&kf, mod, name) != 0) { return 0; }
  return kf;
}

