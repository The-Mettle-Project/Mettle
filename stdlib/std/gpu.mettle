// Checks without waiting. 1 if everything before the event (or on the
// stream) has finished, 0 if work is still running, or the negative CUDA
// error. CUDA_ERROR_NOT_READY (600) is the "still running" answer.
export fn gpu_event_done(event: int64) -> int32 {
  var r: int32 = cuEventQuery(event);
  if (r == 0) { return 1; }
  if (r == 600) { return 0; }
  return -r;
}

export fn gpu_stream_done(stream: int64) -> int32 {
  var r: int32 = cuStreamQuery(stream);
  if (r == 0) { return 1; }
  if (r == 600) { return 0; }
  return -r;
}
@inline export fn gpu_stream_wait_event(stream: int64, event: int64) -> int32 {
  return cuStreamWaitEvent(stream, event, 0);
}
