extern fn __mtlc_gpu_process_exit(code: int32) = "exit";
extern fn __mtlc_gpu_fputs(text: cstring, stream: cstring) -> int32 = "fputs";
extern fn __mtlc_gpu_fopen(path: cstring, mode: cstring) -> cstring = "fopen";
extern fn __mtlc_gpu_fclose(fp: cstring) -> int32 = "fclose";
