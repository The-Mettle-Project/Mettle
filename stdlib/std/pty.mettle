// Pseudo-terminals, for terminal emulators and programs that drive other
// programs as if a person were typing. Linux only for now.
//
// A pty is a pair. The program runs on the slave as its terminal; you hold
// the master, writing what the "keyboard" types and reading what the program
// prints. To start a program on one, set use_pty and pty_fd in ProcOptions:
//
//   var t: Pty;
//   if (pty_open(&t) < 0) { ... }
//   pty_set_size(&t, 80, 24);
//   var opts: ProcOptions;
//   proc_options_init(&opts, argv);
//   opts.use_pty = 1;
//   opts.pty_fd = t.slave;
//   proc_spawn(&opts, &p);        // the child gets a new session on the pty
//   pty_close_slave(&t);          // the parent keeps only the master
//   pty_write(&t, buf, n);  pty_read(&t, buf, cap);
import "std/linux";

const PTY_O_NOCTTY = 0x100;
const PTY_TIOCSPTLCK = 0x40045431;
const PTY_TIOCGPTN: int64 = (int64)0x40045430 + (int64)0x40000000;   // 0x80045430, kept positive in 64 bits
const PTY_TIOCGWINSZ = 0x5413;
const PTY_TIOCSWINSZ = 0x5414;

export struct Pty {
  master: int64;    // read program output here, write keystrokes here
  slave: int64;     // the program's terminal, or -1 once closed
  number: int32;    // N in /dev/pts/N
}

fn pty_cpath(s: string, buf: uint8*) -> uint8* {
  for i in 0..s.length { buf[i] = (uint8)s[i]; }
  buf[(int64)s.length] = (uint8)0;
  return buf;
}

// Opens a new pty pair. Returns 0 and fills t, or -errno. Both ends are
// close-on-exec; proc_spawn hands the slave to the child as fds 0, 1 and 2.
export fn pty_open(t: Pty*) -> int64 {
  t->master = -1;
  t->slave = -1;
  t->number = -1;
  var path: uint8[32];
  var m: int64 = linux_openat(LINUX_AT_FDCWD, pty_cpath("/dev/ptmx", &path[0]), LINUX_O_RDWR | PTY_O_NOCTTY | LINUX_O_CLOEXEC, 0);
  if (m < 0) { return m; }
  var unlock: int32 = 0;
  var r: int64 = linux_ioctl(m, PTY_TIOCSPTLCK, &unlock);
  var n: int32 = 0;
  if (r >= 0) { r = linux_ioctl(m, PTY_TIOCGPTN, &n); }
  if (r < 0) {
    linux_close(m);
    return r;
  }
  var s: int64 = linux_openat(LINUX_AT_FDCWD, pty_cpath("/dev/pts/{n}", &path[0]), LINUX_O_RDWR | PTY_O_NOCTTY | LINUX_O_CLOEXEC, 0);
  if (s < 0) {
    linux_close(m);
    return s;
  }
  t->master = m;
  t->slave = s;
  t->number = n;
  return 0;
}

// Sets the window size the program sees (it gets SIGWINCH). Returns 0 or -errno.
export fn pty_set_size(t: Pty*, cols: int32, rows: int32) -> int64 {
  var ws: uint16[4];
  ws[0] = (uint16)rows;
  ws[1] = (uint16)cols;
  ws[2] = (uint16)0;
  ws[3] = (uint16)0;
  return linux_ioctl(t->master, PTY_TIOCSWINSZ, &ws[0]);
}

// Reads the window size into cols and rows. Returns 0 or -errno.
export fn pty_get_size(t: Pty*, cols: int32*, rows: int32*) -> int64 {
  var ws: uint16[4];
  var r: int64 = linux_ioctl(t->master, PTY_TIOCGWINSZ, &ws[0]);
  if (r < 0) { return r; }
  *rows = (int32)ws[0];
  *cols = (int32)ws[1];
  return 0;
}

// Reads what the program printed. Returns the byte count, 0, or -errno
// (-5, EIO, once every slave descriptor is closed and the program is gone).
export fn pty_read(t: Pty*, buf: uint8*, cap: int64) -> int64 {
  return linux_read(t->master, buf, cap);
}

// Sends bytes to the program as if typed. Returns the byte count or -errno.
export fn pty_write(t: Pty*, buf: uint8*, n: int64) -> int64 {
  return linux_write(t->master, buf, n);
}

// Closes the parent's copy of the slave, after the child has been started.
export fn pty_close_slave(t: Pty*) {
  if (t->slave >= 0) {
    linux_close(t->slave);
    t->slave = -1;
  }
}

// Closes both ends.
export fn pty_close(t: Pty*) {
  pty_close_slave(t);
  if (t->master >= 0) {
    linux_close(t->master);
    t->master = -1;
  }
}
