// Text to float and float to text, both exact.
//
// f64_parse is correctly rounded for every input: a fast path when the digits
// and exponent allow it, exact big-integer arithmetic otherwise. The
// formatters read the double's exact decimal value and round that, so
// f64_format always reads back to the same bits.
//
// The parser came from the registry's json 1.0.0 package.

const LIMBS = 320;
const MAX_DIGITS = 800;

struct Big {
  limb: uint32[320];
  used: int32;
}

struct Decimal {
  negative: bool;
  significant: uint64;
  digit_count: int32;
  exponent: int64;
  fast: bool;
}

fn big_set_small(value: Big*, small: uint32) {
  value->used = 0;
  if (small != 0) {
    value->limb[0] = small;
    value->used = 1;
  }
}

fn big_mul_add(value: Big*, factor: uint32, addend: uint32) {
  var carry: uint64 = (uint64)addend;
  for i in 0..value->used {
    var product: uint64 = (uint64)value->limb[i] * (uint64)factor + carry;
    value->limb[i] = (uint32)(product & 0xFFFFFFFF);
    carry = product >> 32;
  }
  if (carry != 0) {
    value->limb[value->used] = (uint32)carry;
    value->used = value->used + 1;
  }
}

fn big_mul_pow10(value: Big*, power: int64) {
  var left: int64 = power;
  while (left >= 9) {
    big_mul_add(value, 1000000000, 0);
    left = left - 9;
  }
  var factor: uint32 = 1;
  for i in 0..left {
    factor = factor * 10;
  }
  if (factor > 1) {
    big_mul_add(value, factor, 0);
  }
}

fn big_bits(value: Big*) -> int64 {
  if (value->used == 0) {
    return 0;
  }
  var top: uint32 = value->limb[value->used - 1];
  var bits: int64 = (int64)(value->used - 1) * 32;
  while (top != 0) {
    bits = bits + 1;
    top = top >> 1;
  }
  return bits;
}

fn big_shift_left(value: Big*, bits: int64) {
  if (value->used == 0 || bits == 0) {
    return;
  }
  var limbs: int32 = (int32)(bits / 32);
  var rest: uint32 = (uint32)(bits % 32);
  var i: int32 = value->used - 1;
  var top: int32 = value->used + limbs;
  value->limb[top] = 0;
  while (i >= 0) {
    var word: uint32 = value->limb[i];
    if (rest != 0) {
      value->limb[i + limbs + 1] = value->limb[i + limbs + 1] | (word >> (32 - rest));
      value->limb[i + limbs] = word << rest;
    } else {
      value->limb[i + limbs] = word;
    }
    i = i - 1;
  }
  for k in 0..limbs {
    value->limb[k] = 0;
  }
  value->used = top + 1;
  while (value->used > 0 && value->limb[value->used - 1] == 0) {
    value->used = value->used - 1;
  }
}

fn big_shift_right_one(value: Big*) {
  var carry: uint32 = 0;
  var i: int32 = value->used - 1;
  while (i >= 0) {
    var word: uint32 = value->limb[i];
    value->limb[i] = (word >> 1) | carry;
    carry = (word & 1) << 31;
    i = i - 1;
  }
  while (value->used > 0 && value->limb[value->used - 1] == 0) {
    value->used = value->used - 1;
  }
}

fn big_compare(left: Big*, right: Big*) -> int32 {
  if (left->used != right->used) {
    if (left->used < right->used) {
      return -1;
    }
    return 1;
  }
  var i: int32 = left->used - 1;
  while (i >= 0) {
    if (left->limb[i] != right->limb[i]) {
      if (left->limb[i] < right->limb[i]) {
        return -1;
      }
      return 1;
    }
    i = i - 1;
  }
  return 0;
}

fn big_subtract(left: Big*, right: Big*) {
  var borrow: uint64 = 0;
  for i in 0..left->used {
    var take: uint64 = borrow;
    if (i < right->used) {
      take = take + (uint64)right->limb[i];
    }
    var word: uint64 = (uint64)left->limb[i];
    if (word >= take) {
      left->limb[i] = (uint32)(word - take);
      borrow = 0;
    } else {
      left->limb[i] = (uint32)((word + 0x100000000) - take);
      borrow = 1;
    }
  }
  while (left->used > 0 && left->limb[left->used - 1] == 0) {
    left->used = left->used - 1;
  }
}

fn float_from_bits(bits: uint64, negative: bool) -> float64 {
  var word: uint64 = bits;
  if (negative) {
    word = word | (uint64)0x8000000000000000;
  }
  var out: float64 = *(float64*)&word;
  return out;
}

fn round_to_float(quotient: uint64, sticky: bool, shift: int64, negative: bool) -> float64 {
  var width: int64 = 0;
  var probe: uint64 = quotient;
  while (probe != 0) {
    width = width + 1;
    probe = probe >> 1;
  }
  var power: int64 = width - 1 - shift;
  var drop: int64 = width - 53;
  if (power < -1022) {
    drop = drop + (-1022 - power);
  }
  if (drop > 64) {
    return float_from_bits(0, negative);
  }
  var kept: uint64 = 0;
  var removed: uint64 = quotient;
  if (drop < 64) {
    kept = quotient >> drop;
    removed = quotient & (((uint64)1 << drop) - 1);
  }
  var half: uint64 = (uint64)1 << (drop - 1);
  if (removed > half || (removed == half && (sticky || (kept & 1) != 0))) {
    kept = kept + 1;
  }
  if (power < -1022) {
    return float_from_bits(kept, negative);
  }
  if (kept == ((uint64)1 << 53)) {
    kept = kept >> 1;
    power = power + 1;
  }
  if (power > 1023) {
    return float_from_bits((uint64)0x7FF0000000000000, negative);
  }
  var field: uint64 = (uint64)(power + 1023);
  return float_from_bits((field << 52) | (kept & (((uint64)1 << 52) - 1)), negative);
}

fn divide_to_float(top: Big*, bottom: Big*, negative: bool) -> float64 {
  var shift: int64 = 63 - (big_bits(top) - big_bits(bottom));
  if (shift > 0) {
    big_shift_left(top, shift);
  } else if (shift < 0) {
    big_shift_left(bottom, -shift);
  }
  big_shift_left(bottom, 63);
  var quotient: uint64 = 0;
  var bit: int32 = 63;
  while (bit >= 0) {
    if (big_compare(top, bottom) >= 0) {
      big_subtract(top, bottom);
      quotient = quotient | ((uint64)1 << bit);
    }
    big_shift_right_one(bottom);
    bit = bit - 1;
  }
  return round_to_float(quotient, top->used != 0, shift, negative);
}

fn read_exponent(text: uint8*, at: int64, length: int64) -> int64 {
  var i: int64 = at;
  var minus: bool = false;
  if (i < length && (text[i] == 43 || text[i] == 45)) {
    minus = text[i] == 45;
    i = i + 1;
  }
  var value: int64 = 0;
  while (i < length) {
    if (value < 1000000) {
      value = value * 10 + (int64)(text[i] - 48);
    }
    i = i + 1;
  }
  if (minus) {
    return -value;
  }
  return value;
}

fn add_digit(top: Big*, decimal: Decimal*, digit: uint32) {
  if (decimal->digit_count == 0 && digit == 0) {
    return;
  }
  if (decimal->digit_count < MAX_DIGITS) {
    big_mul_add(top, 10, digit);
    if (decimal->digit_count < 19) {
      decimal->significant = decimal->significant * 10 + (uint64)digit;
    }
    decimal->digit_count = decimal->digit_count + 1;
    return;
  }
  decimal->exponent = decimal->exponent + 1;
  if (digit != 0) {
    decimal->fast = false;
    top->limb[0] = top->limb[0] | 1;
  }
}

fn read_decimal(text: uint8*, length: int64, top: Big*, decimal: Decimal*) {
  var i: int64 = 0;
  var after_point: bool = false;
  decimal->negative = false;
  decimal->significant = 0;
  decimal->digit_count = 0;
  decimal->exponent = 0;
  decimal->fast = true;
  big_set_small(top, 0);
  if (i < length && text[i] == 45) {
    decimal->negative = true;
    i = i + 1;
  }
  while (i < length && text[i] != 101 && text[i] != 69) {
    if (text[i] == 46) {
      after_point = true;
    } else {
      if (after_point) {
        decimal->exponent = decimal->exponent - 1;
      }
      add_digit(top, decimal, (uint32)text[i] - 48);
    }
    i = i + 1;
  }
  if (i < length) {
    decimal->exponent = decimal->exponent + read_exponent(text, i + 1, length);
  }
}

fn pow10_exact(power: int64) -> float64 {
  var out: float64 = 1.0;
  for i in 0..power {
    out = out * 10.0;
  }
  return out;
}

// Reads a decimal number (JSON grammar: -?digits[.digits][e[+-]digits])
// and returns the nearest float64. It does not check the grammar.
export fn f64_parse(text: uint8*, length: int64) -> float64 {
  var top: Big;
  var bottom: Big;
  var decimal: Decimal;
  read_decimal(text, length, &top, &decimal);
  if (decimal.digit_count == 0) {
    return float_from_bits(0, decimal.negative);
  }
  if (decimal.exponent + (int64)decimal.digit_count > 310) {
    return float_from_bits((uint64)0x7FF0000000000000, decimal.negative);
  }
  if (decimal.exponent + (int64)decimal.digit_count < -330) {
    return float_from_bits(0, decimal.negative);
  }
  if (decimal.fast && decimal.digit_count <= 15 && decimal.exponent >= -22 && decimal.exponent <= 22) {
    var value: float64 = (float64)(int64)decimal.significant;
    if (decimal.exponent < 0) {
      value = value / pow10_exact(-decimal.exponent);
    } else {
      value = value * pow10_exact(decimal.exponent);
    }
    if (decimal.negative) {
      return -value;
    }
    return value;
  }
  big_set_small(&bottom, 1);
  if (decimal.exponent >= 0) {
    big_mul_pow10(&top, decimal.exponent);
  } else {
    big_mul_pow10(&bottom, -decimal.exponent);
  }
  return divide_to_float(&top, &bottom, decimal.negative);
}

// Reads an integer with no fraction or exponent. Returns false if the text
// is not one or the value does not fit in int64.
export fn i64_parse(text: uint8*, length: int64, out: int64*) -> bool {
  var i: int64 = 0;
  var negative: bool = false;
  if (length > 0 && text[0] == 45) {
    negative = true;
    i = 1;
  }
  if (i == length) {
    return false;
  }
  var value: uint64 = 0;
  var limit: uint64 = (uint64)0x7FFFFFFFFFFFFFFF;
  if (negative) {
    limit = limit + 1;
  }
  while (i < length) {
    if (text[i] < 48 || text[i] > 57) {
      return false;
    }
    var digit: uint64 = (uint64)(text[i] - 48);
    if (value > (limit - digit) / 10) {
      return false;
    }
    value = value * 10 + digit;
    i = i + 1;
  }
  if (negative) {
    *out = (int64)(0 - value);
  } else {
    *out = (int64)value;
  }
  return true;
}


// ---- Formatting -------------------------------------------------------------

// Enough room for any f64_format result.
export const F64_FORMAT_MAX: int64 = 32;

// The exact decimal value of a finite double: value = 0.d1d2d3... * 10^point.
struct F64Digits {
  digit: uint8[800];
  count: int32;
  point: int32;
  negative: bool;
}

// Divides by a small number, returns the remainder.
fn big_div_small(value: Big*, divisor: uint32) -> uint32 {
  var rem: uint64 = 0;
  var i: int32 = value->used - 1;
  while (i >= 0) {
    var cur: uint64 = (rem << 32) | (uint64)value->limb[i];
    value->limb[i] = (uint32)(cur / (uint64)divisor);
    rem = cur % (uint64)divisor;
    i = i - 1;
  }
  while (value->used > 0 && value->limb[value->used - 1] == 0) {
    value->used = value->used - 1;
  }
  return (uint32)rem;
}

fn f64_exact_digits(v: float64, out: F64Digits*) {
  var bits: uint64 = *(uint64*)&v;
  out->negative = (bits >> 63) != 0;
  var raw_exp: int64 = (int64)((bits >> 52) & (uint64)0x7FF);
  var mant: uint64 = bits & (uint64)0xFFFFFFFFFFFFF;
  var e2: int64 = raw_exp - 1075;
  if (raw_exp == 0) {
    e2 = -1074;
  } else {
    mant = mant | ((uint64)1 << 52);
  }
  out->count = 0;
  out->point = 0;
  if (mant == 0) { return; }
  // Drop trailing zero bits so the big number stays small.
  while ((mant & (uint64)1) == 0) {
    mant = mant >> 1;
    e2 = e2 + 1;
  }
  var b: Big;
  b.used = 0;
  b.limb[0] = (uint32)(mant & (uint64)0xFFFFFFFF);
  b.limb[1] = (uint32)(mant >> 32);
  b.used = 1;
  if (b.limb[1] != 0) { b.used = 2; }
  var d10: int64 = 0;
  if (e2 >= 0) {
    big_shift_left(&b, e2);
  } else {
    // m * 2^-k = m * 5^k / 10^k
    var k: int64 = -e2;
    while (k >= 13) {
      big_mul_add(&b, (uint32)1220703125, 0);
      k = k - 13;
    }
    var p5: uint32 = 1;
    for i in 0..k { p5 = p5 * 5; }
    if (p5 != 1) { big_mul_add(&b, p5, 0); }
    d10 = e2;
  }
  // Peel nine digits at a time, lowest first, then reverse.
  var tmp: uint8[800];
  var n: int32 = 0;
  while (b.used > 0) {
    var chunk: uint32 = big_div_small(&b, (uint32)1000000000);
    for j in 0..9 {
      if (b.used == 0 && chunk == 0) { break; }
      tmp[n] = (uint8)(chunk % 10);
      chunk = chunk / 10;
      n = n + 1;
    }
  }
  for j in 0..n { out->digit[j] = tmp[n - 1 - j]; }
  out->count = n;
  out->point = n + (int32)d10;
  // Trailing zeros carry no information.
  while (out->count > 0 && out->digit[out->count - 1] == 0) { out->count = out->count - 1; }
}

// Rounds to keep digits before index keep (half to even). keep may be <= 0.
fn f64_round_at(d: F64Digits*, keep: int32) {
  if (keep >= d->count) { return; }
  if (keep < 0) {
    d->count = 0;
    return;
  }
  var up: bool = false;
  var first: int32 = (int32)d->digit[keep];
  if (first > 5) { up = true; }
  if (first == 5) {
    var rest: bool = false;
    for i in (keep + 1)..d->count {
      if (d->digit[i] != 0) { rest = true; }
    }
    if (rest) {
      up = true;
    } else if (keep > 0 && (d->digit[keep - 1] % 2) == 1) {
      up = true;
    } else if (keep == 0) {
      up = false;
    }
  }
  d->count = keep;
  if (up) {
    var i: int32 = keep - 1;
    while (i >= 0 && d->digit[i] == 9) {
      d->digit[i] = 0;
      i = i - 1;
    }
    if (i < 0) {
      // 999 -> 1000: one digit, one place higher.
      d->digit[0] = 1;
      d->count = 1;
      d->point = d->point + 1;
      return;
    }
    d->digit[i] = d->digit[i] + 1;
  } else if (keep == 0) {
    d->count = 0;
  }
  while (d->count > 0 && d->digit[d->count - 1] == 0) { d->count = d->count - 1; }
}

// Writes digits as d.ddde<exp> into tmp and parses it back.
fn f64_digits_value(d: F64Digits*) -> float64 {
  var tmp: uint8[48];
  var n: int64 = 0;
  for i in 0..d->count {
    tmp[n] = (uint8)(48 + (int32)d->digit[i]);
    n = n + 1;
  }
  tmp[n] = (uint8)101;
  n = n + 1;
  var e: int64 = (int64)d->point - (int64)d->count;
  if (e < 0) {
    tmp[n] = (uint8)45;
    n = n + 1;
    e = -e;
  }
  var ebuf: uint8[8];
  var en: int32 = 0;
  if (e == 0) {
    ebuf[0] = (uint8)48;
    en = 1;
  }
  while (e > 0) {
    ebuf[en] = (uint8)(48 + e % 10);
    e = e / 10;
    en = en + 1;
  }
  while (en > 0) {
    en = en - 1;
    tmp[n] = ebuf[en];
    n = n + 1;
  }
  return f64_parse(&tmp[0], n);
}

// Shortest digits that read back to v (at most 17).
fn f64_shortest_digits(v: float64, out: F64Digits*) {
  f64_exact_digits(v, out);
  if (out->count <= 1) { return; }
  var want: float64 = v;
  if (out->negative) { want = -v; }
  var trial: F64Digits;
  for p in 1..18 {
    trial = *out;
    f64_round_at(&trial, (int32)p);
    if (trial.count > 0 && f64_digits_value(&trial) == want) {
      *out = trial;
      return;
    }
  }
  f64_round_at(out, 17);
}

// Writes s[0..n) into buf at *at. Returns false when it does not fit.
fn f64_put(buf: uint8*, cap: int64, at: int64*, c: int32) -> bool {
  if (*at + 1 >= cap) { return false; }
  buf[*at] = (uint8)c;
  *at = *at + 1;
  return true;
}

fn f64_special(v: float64, buf: uint8*, cap: int64) -> int64 {
  var bits: uint64 = *(uint64*)&v;
  var at: int64 = 0;
  var text: string = "NaN";
  if ((bits & (uint64)0xFFFFFFFFFFFFF) == 0) {
    text = "inf";
    if ((bits >> 63) != 0) { text = "-inf"; }
  }
  for i in 0..text.length {
    if (!f64_put(buf, cap, &at, (int32)text[i])) { return -1; }
  }
  buf[at] = (uint8)0;
  return at;
}

fn f64_is_special(v: float64) -> bool {
  var bits: uint64 = *(uint64*)&v;
  return ((bits >> 52) & (uint64)0x7FF) == (uint64)0x7FF;
}

// Positional form of d: 1234.5, 0.00123, 1200. min_frac pads the fraction
// with zeros to that many places.
fn f64_write_plain(d: F64Digits*, min_frac: int32, buf: uint8*, cap: int64) -> int64 {
  var at: int64 = 0;
  // -0 and values that round to zero print without a sign.
  if (d->negative && d->count > 0) {
    if (!f64_put(buf, cap, &at, 45)) { return -1; }
  }
  if (d->point <= 0) {
    if (!f64_put(buf, cap, &at, 48)) { return -1; }
  } else {
    for i in 0..d->point {
      var c: int32 = 48;
      if (i < d->count) { c = 48 + (int32)d->digit[i]; }
      if (!f64_put(buf, cap, &at, c)) { return -1; }
    }
  }
  var frac: int32 = d->count - d->point;
  if (frac < 0) { frac = 0; }
  if (frac < min_frac) { frac = min_frac; }
  if (frac > 0) {
    if (!f64_put(buf, cap, &at, 46)) { return -1; }
    for k in 0..frac {
      var i: int32 = d->point + k;
      var c: int32 = 48;
      if (i >= 0 && i < d->count) { c = 48 + (int32)d->digit[i]; }
      if (!f64_put(buf, cap, &at, c)) { return -1; }
    }
  }
  buf[at] = (uint8)0;
  return at;
}

// Exponent form: 1.2345e-7, 1e21.
fn f64_write_exp(d: F64Digits*, buf: uint8*, cap: int64) -> int64 {
  var at: int64 = 0;
  if (d->negative) {
    if (!f64_put(buf, cap, &at, 45)) { return -1; }
  }
  for i in 0..d->count {
    if (!f64_put(buf, cap, &at, 48 + (int32)d->digit[i])) { return -1; }
    if (i == 0 && d->count > 1) {
      if (!f64_put(buf, cap, &at, 46)) { return -1; }
    }
  }
  if (!f64_put(buf, cap, &at, 101)) { return -1; }
  var e: int32 = d->point - 1;
  if (e < 0) {
    if (!f64_put(buf, cap, &at, 45)) { return -1; }
    e = -e;
  }
  var tmp: uint8[8];
  var n: int32 = 0;
  if (e == 0) {
    tmp[0] = (uint8)48;
    n = 1;
  }
  while (e > 0) {
    tmp[n] = (uint8)(48 + e % 10);
    e = e / 10;
    n = n + 1;
  }
  while (n > 0) {
    n = n - 1;
    if (!f64_put(buf, cap, &at, (int32)tmp[n])) { return -1; }
  }
  buf[at] = (uint8)0;
  return at;
}

// Each formatter writes into buf, adds a NUL, and returns the text length,
// or -1 if buf is too small. NaN, inf and -inf are spelled out. -0 prints
// as 0. None of them allocate.

// The shortest text that reads back to v: 0.1, 1.5, 100, 1e21, 1.5e-7.
// Uses an exponent only below 1e-6 or from 1e21 up, the way JSON and
// JavaScript do. F64_FORMAT_MAX bytes is always enough.
export fn f64_format(v: float64, buf: uint8*, cap: int64) -> int64 {
  if (f64_is_special(v)) { return f64_special(v, buf, cap); }
  var d: F64Digits;
  f64_shortest_digits(v, &d);
  if (d.count == 0) { return f64_write_plain(&d, 0, buf, cap); }
  if (d.point - 1 < -6 || d.point - 1 >= 21) { return f64_write_exp(&d, buf, cap); }
  return f64_write_plain(&d, 0, buf, cap);
}

// Like f64_format, but never uses an exponent. 1e300 is 301 digits long.
export fn f64_format_plain(v: float64, buf: uint8*, cap: int64) -> int64 {
  if (f64_is_special(v)) { return f64_special(v, buf, cap); }
  var d: F64Digits;
  f64_shortest_digits(v, &d);
  return f64_write_plain(&d, 0, buf, cap);
}

// v rounded to decimals places (0..340), half to even on the exact value:
// f64_format_fixed(2.5, 0, ...) is 2, (1.005, 2) is 1 because 1.005 is
// really 1.00499.... With trim, trailing zeros after the point are dropped,
// and the point too when nothing is left after it.
export fn f64_format_fixed(v: float64, decimals: int32, trim: bool, buf: uint8*, cap: int64) -> int64 {
  if (f64_is_special(v)) { return f64_special(v, buf, cap); }
  var places: int32 = decimals;
  if (places < 0) { places = 0; }
  if (places > 340) { places = 340; }
  var d: F64Digits;
  f64_exact_digits(v, &d);
  f64_round_at(&d, d.point + places);
  var pad: int32 = places;
  if (trim) { pad = 0; }
  return f64_write_plain(&d, pad, buf, cap);
}
