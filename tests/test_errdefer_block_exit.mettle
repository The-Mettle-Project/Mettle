import "std/io";

fn block_err() { puts("BLOCK_ERR\n"); }
fn block_ok() { puts("BLOCK_OK\n"); }
fn outer_err() { puts("OUTER_ERR\n"); }
fn outer_ok() { puts("OUTER_OK\n"); }

fn main() -> int32 {
  errdefer outer_err();
  defer outer_ok();

  {
    errdefer block_err();
    defer block_ok();
  }

  return 0;
}
