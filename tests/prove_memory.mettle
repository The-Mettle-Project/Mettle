fn set_and_read(a: int32*, i: int64) -> int32 {
    a[i] = 7;
    prove(a[i] == 7);
    return a[i];
}

fn little_endian(p: uint8*) -> int64 {
    p[0] = 0x34;
    p[1] = 0x12;
    var w: uint16* = (uint16*)p;
    prove(*w == 0x1234);
    return (int64)*w;
}

fn sign_of_byte(p: int8*) -> int64 {
    *p = -1;
    var v: int64 = (int64)*p;
    var u: uint8* = (uint8*)p;
    prove(v == -1 && *u == 255);
    return v;
}

fn apart(p: int64*, q: int64*) -> int64 {
    var gap: int64 = (int64)q - (int64)p;
    if (gap < 8 && gap > -8) { return 1; }
    *p = 1;
    *q = 2;
    prove(*p == 1);
    return *p;
}

fn first(p: int64*) -> int64 { return *p; }

fn read_through_call(p: int64*, q: int64*) -> int64 {
    *p = 1;
    var x: int64 = first(q);
    prove(*p == 1);
    return x;
}

fn sum_keeps_head(a: int64*, n: int64) -> int64 {
    a[0] = 5;
    var s: int64 = 0;
    var i: int64 = 0;
    while (i < n) {
        s = s + a[i];
        i = i + 1;
    }
    prove(a[0] == 5);
    return s;
}

fn clear_tail(a: int64*, n: int64) -> int64 {
    if (n > 1000) { return 0; }
    a[0] = 5;
    var i: int64 = 1;
    while (i < n) {
        invariant(a[0] == 5 && i >= 1 && i <= 1000);
        a[i] = 0;
        i = i + 1;
    }
    prove(a[0] == 5);
    return a[0];
}

fn store_to(p: int64*, v: int64) -> int64 {
    *p = v;
    return 0;
}

fn locals_apart(a: int64) -> int64 {
    var x: int64 = a;
    var y: int64 = 0;
    store_to(&y, 5);
    var cells: int32[4];
    cells[0] = 1;
    cells[3] = 4;
    var px: int64* = &x;
    *px = *px + 1;
    prove(x == a + 1 && cells[0] + cells[3] == 5);
    return x + y;
}

fn doubled_in_place(n: int64) -> int64 {
    var q: int64* = &n;
    *q = *q * 2;
    prove(n % 2 == 0);
    return n;
}

struct Pair32 {
    a: int32;
    b: int32;
}

struct Triple {
    a: int64;
    b: int64;
    c: int64;
}

fn copies_are_values(dst: Pair32*) -> int64 {
    var s: Pair32;
    s.a = 1;
    s.b = 2;
    var t: Pair32 = s;
    t.a = 5;
    *dst = t;
    var g: Triple;
    g.a = 1;
    g.b = 2;
    g.c = 3;
    var h: Triple = g;
    g.c = 9;
    prove(s.a == 1 && dst.a == 5 && dst.b == 2 && h.c == 3 && g.c == 9);
    return h.c;
}

fn main() -> int32 {
    var out: Pair32;
    if (copies_are_values(&out) != 3 || out.a != 5) { return 10; }
    if (locals_apart(1) != 7) { return 8; }
    if (doubled_in_place(5) != 10) { return 9; }
    var ints: int32[4];
    if (set_and_read(&ints[0], 2) != 7) { return 1; }
    var bytes: uint8[2];
    if (little_endian(&bytes[0]) != 0x1234) { return 2; }
    var b: int8 = 0;
    if (sign_of_byte(&b) != -1) { return 3; }
    var words: int64[4];
    if (apart(&words[0], &words[2]) != 1) { return 4; }
    words[1] = 9;
    if (read_through_call(&words[0], &words[1]) != 9) { return 5; }
    if (sum_keeps_head(&words[0], 1) != 5) { return 6; }
    if (clear_tail(&words[0], 4) != 5 || words[3] != 0) { return 7; }
    return 0;
}
