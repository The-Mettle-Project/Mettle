import "std/io";

fn then_err() { puts("THEN_ERR\n"); }
fn then_ok() { puts("THEN_OK\n"); }
fn else_err() { puts("ELSE_ERR\n"); }
fn else_ok() { puts("ELSE_OK\n"); }
fn outer_err() { puts("OUTER_ERR\n"); }
fn outer_ok() { puts("OUTER_OK\n"); }

fn main() -> int32 {
  errdefer outer_err();
  defer outer_ok();

  if (0) {
    errdefer then_err();
    defer then_ok();
    return 2;
  } else {
    errdefer else_err();
    defer else_ok();
    return 3;
  }
}
