import "std/io";
import "std/regalloc";

@regalloc fn colored_in_mettle(g: AllocGraph) -> Assignment {
  return chaitin_briggs(g);
}

@noinline fn pressure(a: int64, b: int64, c: int64, d: int64) -> int64 {
  var e: int64 = a + b;
  var f: int64 = b * c;
  var h: int64 = c - d;
  var i: int64 = d ^ a;
  var j: int64 = e + f;
  var k: int64 = f - h;
  var l: int64 = h * i;
  var m: int64 = i + e;
  var n: int64 = j ^ k;
  var o: int64 = k + l;
  var p: int64 = l - m;
  var q: int64 = m * n;
  var r: int64 = n + o;
  var s: int64 = o ^ p;
  var t: int64 = p + q;
  var u: int64 = q - r;
  return a + b + c + d + e + f + h + i + j + k + l + m + n + o + p + q + r + s + t + u;
}

@noinline fn floats(x: float64, y: float64) -> float64 {
  var a: float64 = x * y;
  var b: float64 = x + y;
  var c: float64 = a - b;
  var d: float64 = a / (b + 1.0);
  var e: float64 = c * d;
  return a + b + c + d + e;
}

@noinline fn across_calls(n: int64) -> int64 {
  var total: int64 = 0;
  for i in 0..n {
    var left: int64 = pressure(i, i + 1, i + 2, i + 3);
    var right: int64 = pressure(i * 2, i, 1, 2);
    total = total + left - right;
  }
  return total;
}

fn main() -> int32 {
  var bad: int32 = 0;
  if (pressure(1, 2, 3, 4) != 353) { println("{pressure(1, 2, 3, 4)}"); bad = bad + 1; }
  var f: float64 = floats(2.0, 3.0);
  if (f != 6.0 + 5.0 + 1.0 + 1.0 + 1.0) { println("{f}"); bad = bad + 2; }
  if (across_calls(10) != across_calls(10)) { bad = bad + 4; }
  if (bad == 0) { println("ok"); }
  return bad;
}
