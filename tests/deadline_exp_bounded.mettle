import "std/io"
import "std/math"

fn decay(x: float64) -> float64 forbids alloc where cycles < 2000 {
  return exp(-x) + ldexp(x, 3);
}

fn main() -> int32 {
  var r: float64 = decay(1.0);
  if (r < 8.36 || r > 8.37) {
    println("decay(1) = {r}");
    return 1;
  }
  if (ldexp(1.0, 2147483647) != INF() || ldexp(1.0, -2147483647) != 0.0) {
    println("ldexp lost its saturation");
    return 1;
  }
  if (ldexp(4.9e-324, 2000) != ldexp(1.0, 926) || ldexp(1.7976931348623157e308, -2000) != ldexp(1.0, -977) * 1.9999999999999998) {
    println("ldexp lost a step across the 1000 boundary");
    return 1;
  }
  return 0;
}
