fn count(n: int64) -> int64 {
    var s: int64 = 0;
    var i: int64 = 0;
    while (i < n) {
        s = s + 3 * 1;
        i = i + 1;
    }
    return s;
}
fn scan(a: int64*, n: int64) -> int64 {
    var best: int64 = 0;
    var i: int64 = 0;
    while (i < n) {
        var v: int64 = a[i] * 1;
        if (v > best) { best = v; }
        i = i + 1;
    }
    return best;
}
fn fill(a: int64*, n: int64) -> int64 {
    var i: int64 = 0;
    while (i < n) {
        a[i] = i * 2 + 0;
        i = i + 1;
    }
    return 0;
}
fn main() -> int32 {
    var buf: int64[4];
    fill(&buf[0], 4);
    return (int32)(count(5) + scan(&buf[0], 4)) - 21;
}
