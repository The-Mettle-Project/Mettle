import "std/io";
import "std/process";

type Percent = int32 where value >= 0 && value <= 100;
type Digit = int32 where value >= 0 && value < 10;

var g_level: int32 = 5;

fn is_percent(n: int32) -> bool { return n >= 0 && n <= 100; }
fn one_digit(n: int32) -> bool { return n >= 0 && n <= 9; }
fn must_be_digit(n: int32) { if (n < 0 || n > 9) { exit(3); } }
fn touch() { g_level = 500; }
fn bump(p: int32*) { *p = *p + 500; }
fn sneaky(n: int32) -> bool { n = n - 1000; return n >= 0 && n <= 100; }
fn loose(n: int32) -> bool { if (n == 777) { return true; } return n >= 0 && n <= 100; }
fn maybe_check(n: int32, strict: bool) { if (strict) { if (n < 0 || n > 9) { exit(3); } } }
fn first_ok(a: int32, b: int32) -> bool { return a >= 0 && a <= 100; }
fn fill(n: int32, out: int32*) { if (n < 0 || n > 9) { exit(3); } *out = 99; }
fn bump_checked(n: int32) -> int32 { if (n < 0 || n > 9) { exit(3); } return n + 1000; }
fn always(n: int32) -> bool { return true; }
fn inverted(n: int32) -> bool { return !(n >= 0 && n <= 100); }

type Half = int32 where value >= 0 && value <= 50;
type Unit = float64 where value >= 0.0 && value <= 1.0;

fn half(n: int32) -> int32 { return n / 2; }
fn clamp(x: int32, lo: int32, hi: int32) -> int32 { if (x < lo) { return lo; } if (x > hi) { return hi; } return x; }
fn moved_half(n: int32) -> int32 { n = n + 1000; return n / 2; }
fn plus_level(n: int32) -> int32 { return n + g_level; }
fn through_local(n: int32) -> int32 { var m: int32 = n + 1000; return m; }
fn next(k: int32) -> int32 { return k + 1; }
fn leaky_clamp(x: int32, lo: int32, hi: int32) -> int32 { if (x < lo) { return lo; } if (x > hi) { return hi; } if (x == 7) { return 7000; } return x; }
fn in_unit(x: float64) -> bool { return x >= 0.0 && x <= 1.0; }
fn first_in_unit(a: float64, b: float64) -> bool { return a >= 0.0 && a <= 1.0; }
fn must_be_unit(x: float64) { if (!(x >= 0.0 && x <= 1.0)) { exit(4); } }
fn must_not_be_outside(x: float64) { if (x < 0.0 || x > 1.0) { exit(4); } }
fn make_clearer(p: Node*) -> Clearer { var c: Clearer = { target: p }; return c; }
fn moved_unit(x: float64) -> bool { x = x - 10.0; return x >= 0.0 && x <= 1.0; }

type High = uint8 where value >= 200;

fn raised(a: uint8) -> uint8 { return a + 200; }

struct Node { len: int32; next: Node*; }
struct Span { lo: int32; hi: int32; }

type Live = Node* where value != 0;
type Long = Node* where value != 0 && value->len > 4;
type Ordered = Span where value.lo <= value.hi;
type Index = int64 where value >= 0 && value < buf.length;

fn is_live(p: Node*) -> bool { return p != 0; }
fn must_live(p: Node*) { if (p == 0) { exit(5); } }
fn is_long(p: Node*) -> bool { return p != 0 && p->len > 4; }
fn is_ordered(s: Span) -> bool { return s.lo <= s.hi; }
fn in_bounds(buf: int32[], i: int64) -> bool { if (i < 0) { return false; } return i < buf.length; }
fn shrink(p: Node*) { p->len = 0; }
fn first_live(a: Node*, b: Node*) -> bool { return a != 0; }
fn clears_then_agrees(p: Node*) -> bool { if (p == 0) { return false; } if (p->len <= 4) { return false; } p->len = 0; return true; }
fn moves_pointer(p: Node*) -> bool { p = p->next; return p != 0; }
fn loose_live(p: Node*, force: bool) -> bool { if (force) { return true; } return p != 0; }
fn first_ordered(a: Span, b: Span) -> bool { return a.lo <= a.hi; }
fn rewrites_then_agrees(s: Span) -> bool { s.lo = 0; s.hi = 1; return s.lo <= s.hi; }
fn defers_a_clear(p: Node*) -> bool { if (p == 0) { return false; } defer shrink(p); return p->len > 4; }

struct Clearer {
  target: Node*;
  method drop() { this.target->len = 0; }
}

fn drops_a_clear(p: Node*) -> bool { if (p == 0) { return false; } var c: Clearer = { target: p }; return p->len > 4; }
fn between(n: int32, lo: int32, hi: int32) -> bool { return n >= lo && n <= hi; }
fn Span_ordered(s: Span) -> bool { return s.lo <= s.hi; }

fn reassign_after_verdict(n: int32) -> int32 {
  if (is_percent(n)) { n = n + 500; var p: Percent = n; return p; } return 0; }

fn callee_moves_param(n: int32) -> int32 {
  if (sneaky(n)) { var p: Percent = n; return p; } return 0; }

fn two_true_paths(n: int32) -> int32 {
  if (loose(n)) { var p: Percent = n; return p; } return 0; }

fn check_on_one_path(n: int32) -> int32 {
  maybe_check(n, false); var d: Digit = n; return d; }

fn global_then_call() -> int32 {
  if (g_level >= 0 && g_level <= 100) { touch(); var p: Percent = g_level; return p; } return 0; }

fn store_through_pointer(n: int32) -> int32 {
  var at: int32* = &n; if (n >= 0 && n <= 100) { *at = 500; var p: Percent = n; return p; } return 0; }

fn write_later_in_loop(n: int32) -> int32 {
  var t: int32 = 0; if (n >= 0 && n <= 100) { var i: int32 = 0; while (i < 3) { var p: Percent = n; t = t + p; n = n + 60; i = i + 1; } } return t; }

fn other_argument(x: int32, y: int32) -> int32 {
  if (first_ok(x, y)) { var p: Percent = y; return p; } return 0; }

fn address_in_same_call(n: int32) -> int32 {
  fill(n, &n); var d: Digit = n; return d; }

fn write_in_loop_before_use(n: int32) -> int32 {
  var k: int32 = n; var t: int32 = 0; while (one_digit(k)) { k = k + 4; var d: Digit = k; t = t + d; } return t; }

fn reassign_after_demand(n: int32) -> int32 {
  must_be_digit(n); n = n * 3; var d: Digit = n; return d; }

fn assigned_from_the_call(n: int32) -> int32 {
  n = bump_checked(n); var d: Digit = n; return d; }

fn pointer_argument(n: int32) -> int32 {
  if (n >= 0 && n <= 100) { bump(&n); var p: Percent = n; return p; } return 0; }

fn verdict_says_nothing(n: int32) -> int32 {
  if (always(n)) { var p: Percent = n; return p; } return 0; }

fn wrong_branch(n: int32) -> int32 {
  if (inverted(n)) { var p: Percent = n; return p; } return 0; }

fn negated_wrong_branch(n: int32) -> int32 {
  if (!is_percent(n)) { var p: Percent = n; return p; } return 0; }

fn plain_reassign(n: int32) -> int32 {
  if (n >= 0 && n <= 100) { n = n + 500; var p: Percent = n; return p; } return 0; }

fn falling_counter(n: int32) -> int32 {
  var t: int32 = 0; if (n >= 0 && n <= 100) { var i: int32 = 0; while (i < 3) { var p: Percent = n; t = t + p; n = n - 60; i = i + 1; } } return t; }

fn verdict_on_global() -> int32 {
  if (is_percent(g_level)) { touch(); var p: Percent = g_level; return p; } return 0; }

fn demand_on_global() -> int32 {
  must_be_digit(g_level); touch(); var d: Digit = g_level; return d; }

fn call_range_unbounded_argument(n: int32) -> int32 {
  var h: Half = half(n); return h; }

fn call_range_wide_bounds(n: int32) -> int32 {
  var p: Percent = clamp(n, 0, 200); return p; }

fn call_range_callee_moves_param(p: Percent) -> int32 {
  var h: Half = moved_half(p); return h; }

fn call_range_reads_global(p: Percent) -> int32 {
  var q: Percent = plus_level(p) - plus_level(p); return q; }

fn call_range_through_local(p: Percent) -> int32 {
  var q: Percent = through_local(p); return q; }

fn call_range_same_name_in_caller(big: Percent) -> int32 {
  var k: Digit = (Digit)3; var x: Digit = next(big); return x + k; }

fn call_range_extra_path(n: int32) -> int32 {
  var p: Percent = leaky_clamp(n, 0, 100); return p; }

fn call_range_swapped_bounds(n: int32) -> int32 {
  var d: Digit = clamp(n, 2, 70); return d; }

fn float_reassign_after_verdict(x: float64) -> float64 {
  if (in_unit(x)) { x = x + 5.0; var u: Unit = (Unit)x; return (float64)u; } return 0.0; }

fn float_other_argument(x: float64, y: float64) -> float64 {
  if (first_in_unit(x, y)) { var u: Unit = (Unit)y; return (float64)u; } return 0.0; }

fn float_wrong_branch(x: float64) -> float64 {
  if (!in_unit(x)) { var u: Unit = (Unit)x; return (float64)u; } return 0.0; }

fn float_callee_moves_param(x: float64) -> float64 {
  if (moved_unit(x)) { var u: Unit = (Unit)x; return (float64)u; } return 0.0; }

fn float_reassign_after_demand(x: float64) -> float64 {
  must_be_unit(x); x = x * 3.0; var u: Unit = (Unit)x; return (float64)u; }

fn float_no_test(x: float64) -> float64 {
  var u: Unit = (Unit)x; return (float64)u; }

fn narrowing_store_wraps(x: uint8) -> int32 {
  var h: High = x + 200; return (int32)h; }

fn narrowing_return_wraps(x: uint8) -> int32 {
  var h: High = raised(x); return (int32)h; }

fn pointer_reassigned(p: Node*, q: Node*) -> int32 {
  if (is_live(p)) { p = q; var x: Live = (Live)p; return x->len; } return 0; }

fn pointer_other_argument(p: Node*, q: Node*) -> int32 {
  if (first_live(p, q)) { var x: Live = (Live)q; return x->len; } return 0; }

fn pointer_wrong_branch(p: Node*) -> int32 {
  if (!is_live(p)) { var x: Live = (Live)p; return x->len; } return 0; }

fn pointer_callee_moves_param(p: Node*) -> int32 {
  if (moves_pointer(p)) { var x: Live = (Live)p; return x->len; } return 0; }

fn pointer_two_true_paths(p: Node*) -> int32 {
  if (loose_live(p, true)) { var x: Live = (Live)p; return x->len; } return 0; }

fn pointer_reassigned_after_demand(p: Node*, q: Node*) -> int32 {
  must_live(p); p = q; var x: Live = (Live)p; return x->len; }

fn memory_fact_after_store(p: Node*) -> int32 {
  if (is_long(p)) { p->len = 0; var x: Long = (Long)p; return x->len; } return 0; }

fn memory_fact_after_call(p: Node*) -> int32 {
  if (is_long(p)) { shrink(p); var x: Long = (Long)p; return x->len; } return 0; }

fn memory_fact_cleared_in_callee(p: Node*) -> int32 {
  if (clears_then_agrees(p)) { var x: Long = (Long)p; return x->len; } return 0; }

fn struct_field_written(s: Span) -> int32 {
  if (is_ordered(s)) { s.hi = s.lo - 5; var o: Ordered = (Ordered)s; return o.hi; } return 0; }

fn struct_other_argument(a: Span, b: Span) -> int32 {
  if (first_ordered(a, b)) { var o: Ordered = (Ordered)b; return o.hi; } return 0; }

fn slice_other_argument(buf: int32[], other: int32[], i: int64) -> int32 {
  if (in_bounds(other, i)) { var at: Index = (Index)i; return buf[(int64)at]; } return 0; }

fn slice_index_moved(buf: int32[], i: int64) -> int32 {
  if (in_bounds(buf, i)) { i = i + 100; var at: Index = (Index)i; return buf[(int64)at]; } return 0; }

fn struct_field_written_in_callee(s: Span) -> int32 {
  if (rewrites_then_agrees(s)) { var o: Ordered = (Ordered)s; return o.hi; } return 0; }

fn memory_fact_cleared_by_defer(p: Node*) -> int32 {
  if (defers_a_clear(p)) { var x: Long = (Long)p; return x->len; } return 0; }

fn memory_fact_cleared_by_drop(p: Node*) -> int32 {
  if (drops_a_clear(p)) { var x: Long = (Long)p; return x->len; } return 0; }

fn between_unbounded_limit(k: int32, top: int32) -> int32 {
  if (between(k, 0, top)) { var p: Percent = k; return p; } return 0; }

fn between_limit_lowered(k: int32) -> int32 {
  var hi: int32 = 100; if (between(k, 0, hi)) { hi = 5; var d: Digit = k; return d + hi; } return 0; }

fn between_arguments_swapped(k: int32) -> int32 {
  if (between(0, k, 9)) { var d: Digit = k; return d; } return 0; }

fn switch_arm_reached_by_fallthrough(n: int32) -> int32 {
  switch (n) { case 500: { fallthrough; } case 4: { var d: Digit = n; return d; } default: { return 0; } } }

fn switch_arm_below_an_empty_arm(n: int32) -> int32 {
  switch (n) { case 500: case 4: { var d: Digit = n; return d; } default: { return 0; } } }

fn switch_arm_writes_the_value(n: int32) -> int32 {
  switch (n) { case 4: { n = n + 50; var d: Digit = n; return d; } default: { return 0; } } }

fn switch_default_arm(n: int32) -> int32 {
  switch (n) { case 4: { return 4; } default: { var d: Digit = n; return d; } } }

fn expression_argument_differs(a: int32, b: int32) -> int32 {
  if (is_percent(a + b)) { var p: Percent = a - b; return p; } return 0; }

fn expression_argument_written(a: int32, b: int32) -> int32 {
  if (is_percent(a + b)) { a = a + 500; var p: Percent = a + b; return p; } return 0; }

fn method_on_another_object(s: Span, t: Span) -> int32 {
  if (s.ordered()) { var o: Ordered = (Ordered)t; return o.hi; } return 0; }

fn float_nan_passes_an_early_exit(x: float64) -> float64 {
  if (x < 0.0 || x > 1.0) { return 0.0; } var u: Unit = (Unit)x; return (float64)u; }

fn float_nan_passes_negated_tests(x: float64) -> float64 {
  if (!(x < 0.0)) { if (!(x > 1.0)) { var u: Unit = (Unit)x; return (float64)u; } } return 0.0; }

fn float_nan_passes_a_demand(x: float64) -> float64 {
  must_not_be_outside(x); var u: Unit = (Unit)x; return (float64)u; }

fn destructor_at_the_end_of_a_scope(p: Node*) -> int32 {
  if (is_long(p)) { { var c: Clearer = { target: p }; } var x: Long = (Long)p; return x->len; } return 0; }

fn destructor_on_reassignment(p: Node*, q: Node*) -> int32 {
  var c: Clearer = { target: p }; if (is_long(p)) { c = make_clearer(q); var x: Long = (Long)p; return x->len; } return 0; }

fn narrowing_under_a_repeated_test(x: uint8) -> int32 {
  if (x + 200 >= 200) { var h: High = x + 200; return (int32)h; } return 0; }

fn main() -> int32 { return 0; }
