// Anti-rot for the fill recognizer, which claims a store-only loop. See
// test_safe_vec_dot.mettle for what this class of test is guarding against.
import "std/io";
import "std/mem";

fn fill(data: int32*, n: int64, value: int32) {
  var i: int64 = 0;
  while (i < n) {
    data[i] = value;
    i = i + 1;
  }
}

fn main() -> int32 {
  var n: int64 = 64;
  var data: int32* = malloc(n * 4);

  fill(data, n + 64, 7);
  println("{(int64)data[0]}");
  return (int32)data[0];
}
