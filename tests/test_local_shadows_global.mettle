import "std/io";
import "std/math";
import "test_local_shadows_global_mod";

fn main() -> int32 {
  var a: float32 = no_branch(0x3FC0);
  var b: float32 = single_exit(0x3FC0);
  var c: float32 = with_early_return(0x3FC0);
  var d: float64 = with_early_return_f64(0x3FC0);
  if (a < 1.49 || a > 1.51) { println("shadow_global no_branch WRONG"); return 1; }
  if (b < 1.49 || b > 1.51) { println("shadow_global single_exit WRONG"); return 2; }
  if (c < 1.49 || c > 1.51) { println("shadow_global early_return WRONG"); return 3; }
  if (d < 1.49 || d > 1.51) { println("shadow_global early_return_f64 WRONG"); return 4; }

  var v: float32 = shadows_a_global_var(0x3FC0);
  if (v < 1.49 || v > 1.51) { println("shadow_global shadowing WRONG"); return 5; }
  if (gcounter != 7) {
    print("shadow_global CLOBBERED gcounter=");
    print_int(gcounter);
    newline();
    fflush(get_stdout());
    return 6;
  }

  bump(5);
  bump(6);
  if (gcounter != 18) {
    print("shadow_global promotion BROKEN gcounter=");
    print_int(gcounter);
    newline();
    fflush(get_stdout());
    return 7;
  }

  println("local_shadows_global OK");
  fflush(get_stdout());
  return 0;
}
