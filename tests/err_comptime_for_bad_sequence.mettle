// `.fields` and `.rows` are the compile-time sequences, and the message names
// them rather than reporting that something unspecified went wrong.

struct Point {
  x: int32;
  y: int32;
}

fn main() -> int32 {
  comptime for f in typeof(Point).members {
    static_assert(f.type.size > 0);
  }
  return 0;
}
