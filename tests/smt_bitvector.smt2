(set-logic QF_ABV)
(declare-const x (_ BitVec 32))
(declare-const y (_ BitVec 32))
(echo "strength reduction")
(push 1)
(assert (not (= (bvmul x #x00000008) (bvshl x #x00000003))))
(check-sat)
(pop 1)
(echo "magic division without the fixup")
(push 1)
(assert (not (= (bvudiv x #x00000007) ((_ extract 31 0) (bvlshr (bvmul ((_ zero_extend 32) x) #x0000000024924925) #x0000000000000020)))))
(check-sat)
(get-value (x))
(pop 1)
(echo "read over write")
(declare-const m (Array (_ BitVec 32) (_ BitVec 8)))
(push 1)
(assert (not (= (select (store m x #x2a) x) #x2a)))
(check-sat)
(pop 1)
(echo "uninterpreted function congruence")
(declare-fun f ((_ BitVec 32)) (_ BitVec 32))
(push 1)
(assert (= x y))
(assert (not (= (f x) (f y))))
(check-sat)
(pop 1)
(echo "a satisfiable store")
(push 1)
(assert (= (select (store m x #x01) y) #x02))
(check-sat)
(pop 1)
