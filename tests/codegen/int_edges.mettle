@noinline fn sdiv(a: int32, b: int32) -> int32 { return a / b; }
@noinline fn smod(a: int32, b: int32) -> int32 { return a % b; }
@noinline fn shl(a: int32, n: int32) -> int32 { return a << n; }
@noinline fn shr(a: int32, n: int32) -> int32 { return a >> n; }
@noinline fn ushr(a: uint32, n: int32) -> uint32 { return a >> n; }
@noinline fn udiv(a: uint32, b: uint32) -> uint32 { return a / b; }
@noinline fn umod(a: uint32, b: uint32) -> uint32 { return a % b; }
@noinline fn u64div(a: uint64, b: uint64) -> uint64 { return a / b; }
@noinline fn ucmp(a: uint32, b: uint32) -> int32 { if (a > b) { return 1; } return 0; }
@noinline fn u64cmp(a: uint64, b: uint64) -> int32 { if (a > b) { return 1; } return 0; }
@noinline fn i64(v: int64) -> int64 { return v; }
const I64MIN: int64 = -9223372036854775808;
var G_I64MIN: int64 = -9223372036854775808;
fn main() -> int32 {
  if (sdiv(-7, 2) != -3) { return 1; }
  if (smod(-7, 2) != -1) { return 2; }
  if (sdiv(7, -2) != -3) { return 3; }
  if (smod(7, -2) != 1) { return 4; }
  if (shl(1, 31) != -2147483647 - 1) { return 5; }
  if (shr(-8, 2) != -2) { return 6; }
  if (ushr(4294967288, 2) != 1073741822) { return 7; }
  if (udiv(4294967295, 3) != 1431655765) { return 8; }
  if (umod(4294967295, 7) != 3) { return 9; }
  if (u64div(9223372036854775807, 3) != 3074457345618258602) { return 10; }
  if (ucmp(4294967295, 1) != 1) { return 11; }
  if (u64cmp(9223372036854775807, 1) != 1) { return 12; }
  if (sdiv(-2147483647 - 1, 1) != -2147483647 - 1) { return 13; }
  // int64's minimum is writable. A literal is never negative in source, so
  // 9223372036854775808 alone is past LLONG_MAX and types uint64; under a
  // unary minus that number is an int64 and the minus belongs to it.
  var lo: int64 = -9223372036854775808;
  if (lo != I64MIN) { return 14; }
  if (lo != G_I64MIN) { return 15; }
  if (i64(-9223372036854775808) != lo) { return 16; }
  if (lo + 1 != -9223372036854775807) { return 17; }
  if (lo - 1 != 9223372036854775807) { return 18; }
  var un: uint64 = 9223372036854775808;
  if (un != 9223372036854775808) { return 19; }
  if (un / 2 != 4611686018427387904) { return 20; }
  return 0;
}
