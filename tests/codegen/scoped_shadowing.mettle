/* A `var` that shadows an outer one of the same name and type is a second
 * variable. Lowering used to hand it the outer binding's slot, so the inner
 * write landed on the outer variable. */

@noinline fn opaque(x: int32) -> int32 { return x; }

@noinline fn block_shadow() -> int32 {
  var x: int32 = 1;
  {
    var x: int32 = 5;
    if (x != 5) { return 0 - 1; }
  }
  return x;
}

@noinline fn loop_shadow() -> int32 {
  var x: int32 = 1;
  var i: int32 = 0;
  while (i < 3) {
    var x: int32 = opaque(i) * 10;
    if (x != i * 10) { return 0 - 1; }
    i = i + 1;
  }
  return x;
}

@noinline fn for_shadow() -> int32 {
  var x: int32 = 7;
  for i in 0..4 {
    var x: int32 = opaque(i) + 100;
    if (x != i + 100) { return 0 - 1; }
  }
  return x;
}

/* Sibling blocks never overlap, so they may share a slot; each still has to
 * read back what it wrote. */
@noinline fn siblings() -> int32 {
  var total: int32 = 0;
  {
    var y: int32 = 3;
    total = total + y;
  }
  {
    var y: int32 = 4;
    total = total + y;
  }
  return total;
}

/* Three deep, and the middle one written after the innermost scope ends. */
@noinline fn nested() -> int32 {
  var v: int32 = 1;
  {
    var v: int32 = 2;
    {
      var v: int32 = 3;
      if (v != 3) { return 0 - 1; }
    }
    if (v != 2) { return 0 - 2; }
    v = v + 20;
    if (v != 22) { return 0 - 3; }
  }
  return v;
}

/* A different type already took a name of its own; keep that working. */
@noinline fn retyped() -> int64 {
  var n: int32 = 5;
  var total: int64 = (int64)n;
  {
    var n: int64 = 9;
    total = total + n;
  }
  return total + (int64)n;
}

fn main() -> int32 {
  if (block_shadow() != 1) { return 1; }
  if (loop_shadow() != 1) { return 2; }
  if (for_shadow() != 7) { return 3; }
  if (siblings() != 7) { return 4; }
  if (nested() != 1) { return 5; }
  if (retyped() != 19) { return 6; }
  return 0;
}
