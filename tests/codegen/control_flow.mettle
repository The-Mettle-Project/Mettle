@noinline fn sw(x: int32) -> int32 {
  switch (x) {
    case 0: return 10;
    case 1: return 20;
    case 100: return 30;
    default: return 40;
  }
}
@noinline fn loops(n: int32) -> int32 {
  var t: int32 = 0;
  var i: int32 = 0;
  while (i < n) {
    if (i == 3) { i = i + 1; continue; }
    if (i == 7) { break; }
    t = t + i;
    i = i + 1;
  }
  for j in 0..n { t = t + 1; }
  return t;
}
@noinline fn nested(n: int32) -> int32 {
  var t: int32 = 0;
  for i in 0..n { for j in 0..n { t = t + 1; } }
  return t;
}
fn main() -> int32 {
  if (sw(0) != 10) { return 1; }
  if (sw(1) != 20) { return 2; }
  if (sw(100) != 30) { return 3; }
  if (sw(55) != 40) { return 4; }
  if (loops(10) != 0+1+2+4+5+6 + 10) { return 5; }
  if (nested(5) != 25) { return 6; }
  return 0;
}
