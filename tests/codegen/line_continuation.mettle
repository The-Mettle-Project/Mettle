struct Cell<T> { v: T; }

@noinline fn opaque(v: int32) -> int32 { return v; }

@noinline fn scale(a: int32, b: float64) ->
    float64 {
  return (float64)a *
         b +
         1.0;
}

fn main() -> int32 {
  var total: int64 =
      1 +
      2 *
      3;
  if (total != 7) { return 1; }

  total = total *
          2 -
          4;
  if (total != 10) { return 2; }

  var p: int32*
  var one: int32 = opaque(4)
  p = &one
  if (*p != 4) { return 3; }

  var c: Cell<int64>
  c.v = 9
  if (c.v != 9) { return 4; }

  var flag: bool = total >
                   5 &&
                   total <
                   100 ||
                   false;
  if (!flag) { return 5; }

  var text: string = "a" +
                     "b" +
                     "c";
  if (text != "abc") { return 6; }

  if (scale(3, 2.0) !=
      7.0) { return 7; }

  var acc: int32 = 0;
  for i in 0..
             4 {
    acc = acc +
          i;
  }
  if (acc != 6) { return 8; }

  var name: string = "pea";
  var joined: string = "{name + "-" + name}";
  if (joined != "pea-pea") { return 9; }

  var braced: string = "{name + "}" + name}";
  if (braced != "pea}pea") { return 10; }

  var mixed: string = "{{ {opaque(3)} }}";
  if (mixed != "{{ 3 }}") { return 11; }

  var quoted: string = "say \"{name}\"";
  if (quoted != "say \"pea\"") { return 12; }

  /* The operator opening the line, the mirror of the trailing form above. */
  var lead: int64 = 1
      + 2
      - 3
      + opaque(10)
      / 2;
  if (lead != 5) { return 13; }

  var chained: bool = lead > 1
      && lead < 100
      || false;
  if (!chained) { return 14; }

  var bits: int64 = 1
      | 2
      | 4
      & 6
      ^ 1;
  if (bits != 7) { return 15; }

  /* Blank lines inside a split expression, and a chain written down the page
   * through both member operators. */
  var spread: int64 = 10

      + 5;
  if (spread != 15) { return 16; }

  var cell: Cell<int64>
  cell.v = 41;
  var pcell: Cell<int64>* = &cell;
  var read: int64 = cell
      .v
      + pcell
      ->v;
  if (read != 82) { return 17; }

  /* A line opening with `*` is a dereference-assignment statement, not a
   * continuation of the one above it. That is why `*` splits on the trailing
   * form and is the one operator the leading form leaves alone. */
  var target: int32 = 0;
  var into: int32* = &target;
  var untouched: int32 = opaque(6)
  *into = 5;
  if (untouched != 6) { return 18; }
  if (target != 5) { return 19; }

  return 0;
}
