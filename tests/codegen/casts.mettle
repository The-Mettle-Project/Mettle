@noinline fn id64(x: int64) -> int64 { return x; }
@noinline fn idf(x: float64) -> float64 { return x; }
@noinline fn opaque(x: int64) -> int64 { return x; }

// A cast used as a VALUE has to land in the target type's canonical home, not
// only when it is stored into a declared-narrow local. Widening a signed narrow
// source into a narrower-than-64 unsigned type takes both halves: the source's
// sign gives the bits their value, the destination's width is where that value
// lives zero-extended. `(uint32)int16_minus_one` is 4294967295.
fn narrow_to_unsigned() -> int32 {
  var i8v: int8 = (int8)opaque(0 - 1);
  var i16v: int16 = (int16)opaque(0 - 1);
  var i32v: int32 = (int32)opaque(0 - 1);
  if ((int64)(uint16)i8v != 65535) { return 1; }
  if ((int64)(uint32)i8v != 4294967295) { return 2; }
  if ((uint64)i8v != 18446744073709551615) { return 3; }
  if ((int64)(uint32)i16v != 4294967295) { return 4; }
  if ((uint64)i16v != 18446744073709551615) { return 5; }
  if ((uint64)i32v != 18446744073709551615) { return 6; }
  if ((int64)(int16)i8v != 0 - 1) { return 7; }
  if ((int64)(int32)i16v != 0 - 1) { return 8; }
  var u8v: uint8 = (uint8)opaque(255);
  var u16v: uint16 = (uint16)opaque(65535);
  if ((int64)(int16)u8v != 255) { return 9; }
  if ((int64)(uint32)u8v != 255) { return 10; }
  if ((int64)(uint32)u16v != 65535) { return 11; }
  if ((int64)(int32)u16v != 65535) { return 12; }
  if (((uint32)i16v) >> 16 != 65535) { return 13; }
  return 0;
}

fn main() -> int32 {
  var big: int64 = 4294967296;
  if ((int32)big != 0) { return 1; }
  var neg: int32 = -1;
  if ((int64)neg != -1) { return 2; }
  if ((int64)(uint32)neg != 4294967295) { return 3; }
  var f: float64 = -3.7;
  if ((int32)f != -3) { return 4; }
  var i: int32 = -3;
  if ((float64)i != -3.0) { return 5; }
  var u: uint8 = 200;
  if ((int32)u != 200) { return 6; }
  var s8: int8 = -56;
  if ((int32)s8 != -56) { return 7; }
  if ((int32)(int8)200 != -56) { return 8; }
  if (id64((int64)(float32)1.5) != 1) { return 9; }
  if (idf((float64)(int64)7) != 7.0) { return 10; }
  var narrow: int32 = narrow_to_unsigned();
  if (narrow != 0) { return 20 + narrow; }
  return 0;
}
