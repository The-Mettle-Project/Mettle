import "std/mem";

struct Tab {
  data: int32*;
  other: int32*;
  count: int64;
}

struct Slotted {
  data: int32*;
  unused: int64;
}

struct Scaled {
  scale: float64;
  unused: int64;
}

struct ReadTwice {
  small: int32;
  other: float64*;
}

@noinline fn opaque(n: int32) -> int32 { return n; }

@noinline fn short_loop(t: Tab*, n: int32) -> int64 {
  var total: int64 = 0;
  var i: int32 = 0;
  while (i < n) {
    total = total + (int64)t->data[i];
    t->other[i] = t->data[i] + 1;
    i += 1;
  }
  return total;
}

@noinline fn second_test_reads(t: Tab*, n: int32) -> int64 {
  var total: int64 = 0;
  var i: int32 = 0;
  while (i < n && t->data[i] != 0) {
    total = total + (int64)t->data[i];
    t->other[i] = 1;
    i += 1;
  }
  return total;
}

@noinline fn down_to_zero(t: Tab*, n: int32) -> int64 {
  var total: int64 = 0;
  var i: int32 = n;
  while (i >= 0) {
    total = total + (int64)t->data[i];
    t->other[i] = 2;
    i -= 1;
  }
  return total;
}

@noinline fn not_equal_test(t: Tab*, from: int32, to: int32) -> int64 {
  var total: int64 = 0;
  var i: int32 = from;
  while (i != to) {
    total = total + (int64)t->data[i];
    t->other[i] = 3;
    i += 1;
  }
  return total;
}

@noinline fn repeats_with_continue(t: Tab*, n: int32) -> int64 {
  var total: int64 = 0;
  var i: int32 = 0;
  while (i < n) {
    var first: int32 = t->data[0];
    i += 1;
    t->other[i - 1] = first;
    if ((i & 1) == 0) {
      continue;
    }
    total = total + (int64)first;
  }
  return total;
}

@noinline fn arm_only(t: Tab*, n: int32) -> int64 {
  var total: int64 = 0;
  var i: int32 = 0;
  while (i < 8) {
    if (i > n) {
      total = total + t->count;
    }
    total = total + 1;
    i += 1;
  }
  return total;
}

@noinline fn big_arm_only(t: Tab*, values: int32*, n: int32) -> int64 {
  var total: int64 = 0;
  var i: int32 = 0;
  while (i < 8) {
    var a: int32 = values[i] * 3 + 1;
    var b: int32 = values[i] * 5 + 2;
    var c: int32 = values[i] * 7 + 3;
    var d: int32 = values[i] * 9 + 4;
    var e: int32 = (a ^ b) + (c ^ d);
    var f: int32 = (a & b) + (c | d);
    var g: int32 = (a - b) * (c - d);
    var h: int32 = (e + f) ^ (g + a);
    var j: int32 = (e - f) ^ (g - b);
    var k: int32 = (h + j) * (h - j);
    var l: int32 = (k ^ a) + (k ^ b);
    var m: int32 = (l ^ c) + (l ^ d);
    var o: int32 = (m + e) * (m + f);
    var p: int32 = (o ^ g) + (o ^ h);
    var q: int32 = (p + j) ^ (p + k);
    var r: int32 = (q + l) ^ (q + m);
    if (i > n) {
      total = total + t->count;
    }
    values[i] = (r ^ o) & 15;
    total = total + (int64)(r & 1);
    i += 1;
  }
  return total;
}

@noinline fn big_few_loads(t: Tab*, values: int32*) -> int64 {
  var total: int64 = 0;
  var i: int32 = 0;
  while (i < 8) {
    var a: int32 = values[i] * 3 + (int32)t->count;
    var b: int32 = values[i] * 5 + 2;
    var c: int32 = values[i] * 7 + 3;
    var d: int32 = values[i] * 9 + 4;
    var e: int32 = (a ^ b) + (c ^ d);
    var f: int32 = (a & b) + (c | d);
    var g: int32 = (a - b) * (c - d);
    var h: int32 = (e + f) ^ (g + a);
    var j: int32 = (e - f) ^ (g - b);
    var k: int32 = (h + j) * (h - j);
    var l: int32 = (k ^ a) + (k ^ b);
    var m: int32 = (l ^ c) + (l ^ d);
    var o: int32 = (m + e) * (m + f);
    var p: int32 = (o ^ g) + (o ^ h);
    var q: int32 = (p + j) ^ (p + k);
    var r: int32 = (q + l) ^ (q + m);
    values[i] = (r ^ o) & 15;
    total = total + (int64)(r & 1);
    i += 1;
  }
  return total;
}

@noinline fn big_constant_loop(t: Tab*) -> int64 {
  var total: int64 = 0;
  var i: int32 = 0;
  while (i < 32) {
    t->data[i] = t->data[i] + 1;
    t->other[i] = t->other[i] + t->data[i];
    t->data[i] = t->data[i] + t->other[i];
    t->other[i] = t->other[i] ^ t->data[i];
    t->data[i] = t->data[i] - t->other[i];
    t->other[i] = t->other[i] + t->data[i] * 2;
    t->data[i] = t->data[i] + t->other[i] * 3;
    t->other[i] = t->other[i] - t->data[i] * 5;
    t->data[i] = t->data[i] ^ t->other[i];
    t->other[i] = t->other[i] + (t->data[i] & 7);
    t->data[i] = t->data[i] + (t->other[i] & 3);
    t->other[i] = t->other[i] - (t->data[i] | 1);
    total = total + (int64)t->data[i] + (int64)t->other[i];
    i += 1;
  }
  return total;
}

fn big_constant_expected(data: int32*, other: int32*) -> int64 {
  var total: int64 = 0;
  var i: int32 = 0;
  while (i < 32) {
    var d: int32 = data[i];
    var o: int32 = other[i];
    d = d + 1;
    o = o + d;
    d = d + o;
    o = o ^ d;
    d = d - o;
    o = o + d * 2;
    d = d + o * 3;
    o = o - d * 5;
    d = d ^ o;
    o = o + (d & 7);
    d = d + (o & 3);
    o = o - (d | 1);
    total = total + (int64)d + (int64)o;
    i += 1;
  }
  return total;
}

@noinline fn nested_loads(t: Tab*, lens: int32*) -> int64 {
  var total: int64 = 0;
  var i: int32 = 0;
  while (i < 8) {
    total = total + (int64)t->data[i];
    var k: int32 = 0;
    while (k < lens[i]) {
      total = total + (int64)t->data[k] * 2;
      t->other[k] = t->other[k] + 1;
      k += 1;
    }
    i += 1;
  }
  return total;
}

@noinline fn swaps_midway(t: Tab*, n: int32) -> int64 {
  var total: int64 = 0;
  var i: int32 = 0;
  while (i < 8) {
    total = total + (int64)t->data[i];
    if (i == n) {
      t->data = t->other;
    }
    i += 1;
  }
  return total;
}

@noinline fn swaps_through_slot(t: Slotted*, slot: int32**, next: int32*) -> int64 {
  var total: int64 = 0;
  var i: int32 = 0;
  while (i < 8) {
    total = total + (int64)t->data[i];
    if (i == 3) {
      *slot = next;
    }
    i += 1;
  }
  return total;
}

@noinline fn scale_moves(t: Scaled*, out: float64*) -> float64 {
  var total: float64 = 0.0;
  var i: int32 = 0;
  while (i < 4) {
    total = total + t->scale;
    out[0] = t->scale + 1.0;
    i += 1;
  }
  return total;
}

@noinline fn two_readings(t: ReadTwice*) -> int64 {
  var total: int64 = 0;
  var i: int32 = 0;
  var unsigned_view: uint32* = (uint32*)t;
  while (i < 4) {
    var signed: int64 = (int64)t->small;
    var plain: int64 = (int64)*unsigned_view;
    t->other[i] = (float64)(plain - signed);
    total = total + (plain - signed);
    i += 1;
  }
  return total;
}

@noinline fn read_after_loop(t: Tab*, n: int32) -> int64 {
  var last: int64 = -1;
  var i: int32 = 0;
  while (i < n) {
    var first: int64 = t->count;
    var again: int64 = t->count;
    last = first + again;
    t->other[i] = 7;
    i += 1;
  }
  return last;
}

fn main() -> int32 {
  var data: int32* = (int32*)malloc(64 * 4);
  var other: int32* = (int32*)malloc(64 * 4);
  var keep: int32* = (int32*)malloc(64 * 4);
  var lens: int32* = (int32*)malloc(8 * 4);
  var values: int32* = (int32*)malloc(8 * 4);
  if (data == 0 || other == 0 || keep == 0 || lens == 0 || values == 0) { return 1; }
  var i: int32 = 0;
  while (i < 64) {
    data[i] = i + 1;
    other[i] = (i + 1) * 100;
    keep[i] = (i + 1) * 100;
    i += 1;
  }
  var tab: Tab;
  tab.data = data;
  tab.other = other;
  tab.count = 5;
  var none: Tab* = 0;

  if (short_loop(none, opaque(0)) != 0) { return 2; }
  if (short_loop(none, opaque(-3)) != 0) { return 3; }
  if (short_loop(&tab, opaque(4)) != 10) { return 4; }
  if (other[3] != 5) { return 5; }

  if (second_test_reads(none, opaque(0)) != 0) { return 6; }
  if (second_test_reads(&tab, opaque(3)) != 6) { return 7; }
  if (other[2] != 1) { return 8; }

  if (down_to_zero(none, opaque(-1)) != 0) { return 9; }
  if (down_to_zero(&tab, opaque(2)) != 6) { return 10; }

  if (not_equal_test(none, opaque(5), opaque(5)) != 0) { return 11; }
  if (not_equal_test(&tab, opaque(1), opaque(3)) != 5) { return 12; }

  if (repeats_with_continue(none, opaque(0)) != 0) { return 13; }
  if (repeats_with_continue(&tab, opaque(5)) != 3) { return 14; }

  if (arm_only(none, opaque(100)) != 8) { return 15; }
  if (arm_only(&tab, opaque(5)) != 18) { return 16; }

  i = 0;
  while (i < 8) { values[i] = i; i += 1; }
  var big_arm: int64 = big_arm_only(none, values, opaque(100));
  if (big_arm < 0 || big_arm > 8) { return 17; }
  var big_few: int64 = big_few_loads(&tab, values);
  if (big_few < 0 || big_few > 8) { return 30; }

  i = 0;
  while (i < 64) {
    data[i] = i + 1;
    other[i] = (i + 1) * 100;
    i += 1;
  }
  var want_big: int64 = big_constant_expected(data, other);
  if (big_constant_loop(&tab) != want_big) { return 18; }

  i = 0;
  while (i < 64) {
    data[i] = i + 1;
    other[i] = (i + 1) * 100;
    i += 1;
  }
  i = 0;
  while (i < 8) { lens[i] = i & 1; i += 1; }
  if (nested_loads(&tab, lens) != 36 + 8) { return 19; }
  if (other[0] != 104) { return 20; }

  tab.data = data;
  tab.other = keep;
  if (swaps_midway(&tab, opaque(3)) != 10 + 500 + 600 + 700 + 800) { return 21; }
  if (tab.data != keep) { return 22; }

  var slotted: Slotted;
  slotted.data = data;
  if (swaps_through_slot(&slotted, (int32**)&slotted, keep) != 10 + 500 + 600 + 700 + 800) { return 23; }
  if (slotted.data != keep) { return 24; }

  var scaled: Scaled;
  scaled.scale = 1.0;
  if (scale_moves(&scaled, (float64*)&scaled) != 10.0) { return 25; }
  if (scaled.scale != 5.0) { return 26; }

  var read_twice: ReadTwice;
  read_twice.other = (float64*)malloc(8 * 8);
  if (read_twice.other == 0) { return 31; }
  read_twice.small = -1;
  if (two_readings(&read_twice) != 4 * 4294967296) { return 27; }
  if (read_twice.other[3] != 4294967296.0) { return 32; }
  free(read_twice.other);

  tab.other = other;
  if (read_after_loop(&tab, opaque(0)) != -1) { return 28; }
  if (read_after_loop(&tab, opaque(2)) != 10) { return 29; }

  free(data);
  free(other);
  free(keep);
  free(lens);
  free(values);
  return 0;
}
