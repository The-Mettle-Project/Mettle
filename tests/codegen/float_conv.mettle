@noinline fn f32_to_i32(x: float32) -> int32 { return (int32)x; }
@noinline fn f64_to_i64(x: float64) -> int64 { return (int64)x; }
@noinline fn i64_to_f64(x: int64) -> float64 { return (float64)x; }
@noinline fn u32_to_f64(x: uint32) -> float64 { return (float64)x; }
@noinline fn f64_to_f32(x: float64) -> float32 { return (float32)x; }
@noinline fn f32_to_f64(x: float32) -> float64 { return (float64)x; }
@noinline fn u64_to_f64(x: uint64) -> float64 { return (float64)x; }
fn main() -> int32 {
  if (f32_to_i32(3.9) != 3) { return 1; }
  if (f32_to_i32(-3.9) != -3) { return 2; }
  if (f64_to_i64(1e15) != 1000000000000000) { return 3; }
  if (i64_to_f64(1000000000000000) != 1e15) { return 4; }
  if (u32_to_f64(4294967295) != 4294967295.0) { return 5; }
  if (f64_to_f32(0.5) != 0.5) { return 6; }
  if (f32_to_f64(0.25) != 0.25) { return 7; }
  if (u64_to_f64(9007199254740992) != 9007199254740992.0) { return 8; }
  if (f64_to_i64(-1.5) != -1) { return 9; }
  return 0;
}
