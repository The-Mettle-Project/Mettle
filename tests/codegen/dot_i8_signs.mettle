// The byte dot kernel widened every element zero-extended, whatever the array
// said, so an int8 dot product read each negative element as its unsigned
// value: a kernel over -1 and 3 answered 765 per element instead of -3. The
// widening follows the source's loads now, so both the signed and the unsigned
// dot survive vectorization. Lengths straddle the 32-byte vector body so the
// scalar tail is exercised too.
@noinline fn opaque(v: int64) -> int64 { return v; }

@noinline fn dot_i8(a: int8*, b: int8*, n: int64) -> int64 {
  var t: int32 = 0;
  var i: int64 = 0;
  while (i < n) {
    t = t + (int32)a[i] * (int32)b[i];
    i = i + 1;
  }
  return (int64)t;
}

@noinline fn dot_u8(a: uint8*, b: uint8*, n: int64) -> int64 {
  var t: int32 = 0;
  var i: int64 = 0;
  while (i < n) {
    t = t + (int32)a[i] * (int32)b[i];
    i = i + 1;
  }
  return (int64)t;
}

@noinline fn reference_i8(a: int8*, b: int8*, n: int64) -> int64 {
  var t: int64 = 0;
  var i: int64 = 0;
  while (i < n) {
    var x: int64 = (int64)a[i];
    var y: int64 = (int64)b[i];
    t = t + x * y;
    i = i + 1;
  }
  return t;
}

@noinline fn reference_u8(a: uint8*, b: uint8*, n: int64) -> int64 {
  var t: int64 = 0;
  var i: int64 = 0;
  while (i < n) {
    var x: int64 = (int64)a[i];
    var y: int64 = (int64)b[i];
    t = t + x * y;
    i = i + 1;
  }
  return t;
}

fn main() -> int32 {
  var sa: int8[70];
  var sb: int8[70];
  var ua: uint8[70];
  var ub: uint8[70];
  for i in 0..70 {
    sa[i] = (int8)(0 - 100 + (i % 37));
    sb[i] = (int8)(120 - (i % 11) * 20);
    ua[i] = (uint8)(200 + (i % 55));
    ub[i] = (uint8)(250 - (i % 7));
  }

  for n in 0..70 {
    var len: int64 = opaque((int64)n);
    if (dot_i8(&sa[0], &sb[0], len) != reference_i8(&sa[0], &sb[0], len)) {
      return 1;
    }
    if (dot_u8(&ua[0], &ub[0], len) != reference_u8(&ua[0], &ub[0], len)) {
      return 2;
    }
  }

  // All-negative on both sides: the products are positive, which is what hid
  // the fault in the fixture that already existed.
  for i in 0..70 { sa[i] = (int8)(0 - 128); sb[i] = (int8)(0 - 128); }
  if (dot_i8(&sa[0], &sb[0], opaque(40)) != 655360) { return 3; }

  // One side negative: the sum is negative and every element must carry it.
  for i in 0..70 { sa[i] = (int8)127; sb[i] = (int8)(0 - 1); }
  if (dot_i8(&sa[0], &sb[0], opaque(40)) != 0 - 5080) { return 4; }

  return 0;
}
