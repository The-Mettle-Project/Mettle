// A function can call one declared below it, and a type gets the same
// courtesy, and so does a global. Registration used to walk the file top to
// bottom, so an enum whose payload named a struct written later was "payload of
// unknown type", a struct field naming a later struct was "Unknown type in
// struct field", and a function reading a global written later was "Undefined
// variable". Order here is deliberately the reverse of the dependency order
// throughout.
import "std/io";

enum Shape { Wide(Span), Deep(Nest), Nothing }

struct Nest { inner: Leaf; n: int64; }

fn use_later(v: Later) -> int64 { return v.z; }

struct Span { lo: int64; hi: int64; }

struct Later { z: int64; }

struct Leaf { v: int64; }

struct Ring { next: Ring*; v: int64; }

struct Holder { shape: Shape; tag: Leaf; }

// Every one of these reads a global declared below it.
@noinline fn read_scalar() -> int64 { return LATER_SCALAR; }
@noinline fn read_array(i: int64) -> int64 { return LATER_ARRAY[i]; }
@noinline fn read_record() -> int64 { return LATER_RECORD.z + (int64)LATER_RECORD.tag; }
@noinline fn read_string() -> int64 { return (int64)LATER_STRING.length; }
@noinline fn bump() -> int64 { LATER_MUTABLE = LATER_MUTABLE + 1; return LATER_MUTABLE; }

var LATER_SCALAR: int64 = 42;
var LATER_ARRAY: int64[4] = [10, 20, 30, 40];
var LATER_RECORD: Later2;
var LATER_STRING: string = "twelve chars";
var LATER_MUTABLE: int64;
const LATER_CONST: int64 = 7;

struct Later2 { z: int64; tag: int32; }

@noinline fn read_const() -> int64 { return LATER_CONST; }

@noinline fn opaque(v: int64) -> int64 { return v; }

@noinline fn score(s: Shape) -> int64 {
  match (s) {
    case Wide(w): { return w.lo * 10 + w.hi; }
    case Deep(d): { return d.inner.v + d.n; }
    case Nothing: { return 0 - 1; }
  }
  return 0 - 2;
}

fn main() -> int32 {
  var span: Span;
  span.lo = opaque(3);
  span.hi = opaque(4);
  if (score(Wide(span)) != 34) { return 1; }

  var nest: Nest;
  nest.inner.v = opaque(5);
  nest.n = opaque(6);
  if (score(Deep(nest)) != 11) { return 2; }

  if (score(Nothing()) != 0 - 1) { return 3; }

  var later: Later;
  later.z = opaque(8);
  if (use_later(later) != 8) { return 4; }

  var ring: Ring;
  ring.v = opaque(9);
  ring.next = &ring;
  if (ring.next->v != 9) { return 5; }

  var held: Holder;
  held.shape = Wide(span);
  held.tag.v = opaque(7);
  if (score(held.shape) != 34 || held.tag.v != 7) { return 6; }

  if (read_scalar() != 42) { return 7; }
  if (read_array(opaque(2)) != 30) { return 8; }
  LATER_RECORD.z = opaque(5);
  LATER_RECORD.tag = (int32)opaque(6);
  if (read_record() != 11) { return 9; }
  if (read_string() != 12) { return 10; }
  if (bump() != 1 || bump() != 2 || LATER_MUTABLE != 2) { return 11; }
  if (read_const() != 7) { return 12; }

  return 0;
}
