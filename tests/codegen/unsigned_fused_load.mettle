// A uint32 read through a computed index lives in its register zero-extended.
// The fused scaled-address load in the fallback emitter left the is_unsigned
// tag off its sign-extension guard, which its two sibling fused forms already
// carry, so `(uint64)s->p[i + j]` answered 18446744071562067989 where the value
// was 2147483669. Only an index the address fold claimed went wrong, so the
// same array read as `s->p[i]` was right and the pair together looked like
// memory corruption. A bignum's carry chain is where it showed.
import "std/mem";

struct Slab { p: uint32*; n: int32; }

@noinline fn opaque(v: int64) -> int64 { return v; }

@noinline fn one_index(s: Slab*, i: int32) -> uint64 { return (uint64)s->p[i]; }
@noinline fn sum_index(s: Slab*, i: int32, j: int32) -> uint64 {
  return (uint64)s->p[i + j];
}
@noinline fn sum_index_u16(p: uint16*, i: int32, j: int32) -> uint64 {
  return (uint64)p[i + j];
}
@noinline fn sum_index_u8(p: uint8*, i: int32, j: int32) -> uint64 {
  return (uint64)p[i + j];
}
@noinline fn sum_index_i32(p: int32*, i: int32, j: int32) -> int64 {
  return (int64)p[i + j];
}

// The shape it was found in: a schoolbook multiply whose carry depends on every
// limb widening unsigned.
@noinline fn mul(dst: Slab*, x: Slab*, y: Slab*) {
  var i: int32 = 0;
  while (i < x->n) {
    var carry: uint64 = 0;
    var xi: uint64 = (uint64)x->p[i];
    var j: int32 = 0;
    while (j < y->n) {
      var cur: uint64 = xi * (uint64)y->p[j] + (uint64)dst->p[i + j] + carry;
      dst->p[i + j] = (uint32)(cur & 4294967295);
      carry = cur >> 32;
      j += 1;
    }
    var k: int32 = i + j;
    while (carry != 0 && k < dst->n) {
      var tail: uint64 = (uint64)dst->p[k] + carry;
      dst->p[k] = (uint32)(tail & 4294967295);
      carry = tail >> 32;
      k += 1;
    }
    i += 1;
  }
}

fn main() -> int32 {
  var pool: uint32* = malloc(4 * 48);
  if (pool == 0) { return 1; }
  var i: int64 = 0;
  while (i < 48) { pool[i] = 0; i = i + 1; }

  var s: Slab;
  s.p = pool;
  s.n = 8;
  i = 0;
  while (i < 8) { pool[i] = (uint32)(2147483648 + i * 7); i = i + 1; }

  if (one_index(&s, (int32)opaque(3)) != 2147483669) { return 2; }
  if (sum_index(&s, (int32)opaque(1), (int32)opaque(2)) != 2147483669) {
    return 3;
  }
  if (sum_index(&s, (int32)opaque(0), (int32)opaque(0)) != 2147483648) {
    return 4;
  }

  var halves: uint16* = (uint16*)pool;
  halves[0] = (uint16)opaque(40000);
  if (sum_index_u16(halves, (int32)opaque(0), (int32)opaque(0)) != 40000) {
    return 5;
  }
  var bytes: uint8* = (uint8*)pool;
  bytes[0] = (uint8)opaque(200);
  if (sum_index_u8(bytes, (int32)opaque(0), (int32)opaque(0)) != 200) {
    return 6;
  }
  var signed_words: int32* = (int32*)pool;
  signed_words[3] = (int32)opaque(0 - 7);
  if (sum_index_i32(signed_words, (int32)opaque(1), (int32)opaque(2)) != 0 - 7) {
    return 7;
  }

  // 0xFFFFFFFF * 0xFFFFFFFF = 0xFFFFFFFE00000001, so both limbs of the product
  // depend on the high-bit limbs widening unsigned.
  var a: Slab;
  var b: Slab;
  var d: Slab;
  a.p = pool; b.p = pool + 16; d.p = pool + 32;
  a.n = 2; b.n = 2; d.n = 4;
  i = 0;
  while (i < 48) { pool[i] = 0; i = i + 1; }
  a.p[0] = (uint32)opaque(4294967295);
  a.p[1] = (uint32)opaque(4294967295);
  b.p[0] = (uint32)opaque(4294967295);
  b.p[1] = (uint32)opaque(4294967295);
  mul(&d, &a, &b);
  // (2^64 - 1)^2 = 2^128 - 2^65 + 1 -> limbs 1, 0, 0xFFFFFFFE, 0xFFFFFFFF
  if (d.p[0] != 1) { return 8; }
  if (d.p[1] != 0) { return 9; }
  if (d.p[2] != 4294967294) { return 10; }
  if (d.p[3] != 4294967295) { return 11; }

  free(pool);
  return 0;
}
