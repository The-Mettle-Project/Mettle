// `for i in 0..n { arr[i] = i * 4 + 1; }` compiles the index scaling and the
// stored value into two identical `i << 2` shifts. The pointer-induction pass
// replaces the address one with a walking pointer and deletes it -- and it used
// to delete EVERY iv-fed shift in the body, whoever read it. The value's shift
// went with it, a later hoist then read the orphaned temp as loop-invariant,
// and every element got the same number.
//
// Only reachable with the runtime checks on (plain `-O`): their branches are
// what split the body so the two shifts stopped being one common subexpression.
// Both are checked here so a build in either mode covers it.
import "std/mem";

@noinline fn opaque(v: int64) -> int64 { return v; }

@noinline fn fill_scaled(arr: int32*, n: int64) -> void {
  for i in 0..n { arr[i] = (int32)(i * 4 + 1); }
}

@noinline fn fill_two_reads(arr: int64*, out: int64*, n: int64) -> void {
  for i in 0..n {
    arr[i] = i * 8;
    out[i] = arr[i] + i * 2;
  }
}

@noinline fn lower_bound(arr: int32*, n: int64, key: int32) -> int32 {
  var lo: int64 = 0;
  var hi: int64 = n;
  while (lo < hi) {
    var mid: int64 = lo + ((hi - lo) / 2);
    if (arr[mid] < key) { lo = mid + 1; } else { hi = mid; }
  }
  if (lo < n) { return arr[lo]; }
  return -1;
}

fn main() -> int32 {
  var n: int64 = opaque(64);

  var arr: int32* = malloc(n * 4);
  if (arr == 0) { return 1; }
  fill_scaled(arr, n);
  for i in 0..n {
    if (arr[i] != (int32)(i * 4 + 1)) { return 2; }
  }

  // The array the fill produced is sorted, so a search over it answers the
  // element it found. A wrong fill reads as a wrong search.
  for k in 0..8 {
    var key: int32 = (int32)(k * 4 + 1);
    if (lower_bound(arr, n, key) != key) { return 3; }
  }
  if (lower_bound(arr, n, 2) != 5) { return 4; }
  if (lower_bound(arr, n, 999999) != -1) { return 5; }
  free(arr);

  var wide: int64* = malloc(n * 8);
  var out: int64* = malloc(n * 8);
  if (wide == 0 || out == 0) { return 6; }
  fill_two_reads(wide, out, n);
  for i in 0..n {
    if (wide[i] != i * 8) { return 7; }
    if (out[i] != i * 10) { return 8; }
  }
  free(wide);
  free(out);

  return 0;
}
