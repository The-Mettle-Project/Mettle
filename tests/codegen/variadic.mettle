// A parameter written `T[..]` gathers whatever a call passes after the fixed
// ones. Inside the function it is an ordinary `T[]`, so the length is there to
// read and the elements are there to index; at the call the arguments become
// an array of them, which is the same conversion any array makes.

struct Point { x: int32; y: int32; }

fn sum(xs: int32[..]) -> int32 {
  var total: int32 = 0;
  for x in xs { total = total + x; }
  return total;
}

fn count_of(xs: int32[..]) -> int64 { return xs.length; }

fn tagged(base: int32, xs: int32[..]) -> int32 {
  var total: int32 = base;
  for i in 0..xs.length { total = total + xs[i]; }
  return total;
}

fn widest(points: Point[..]) -> int32 {
  var best: int32 = 0;
  for i in 0..points.length {
    if (points[i].x > best) { best = points[i].x; }
  }
  return best;
}

fn forward(xs: int32[..]) -> int32 { return sum(xs); }

fn joined(sep: string, parts: string[..]) -> int64 {
  var total: int64 = 0;
  for p in parts { total = total + (int64)p.length + (int64)sep.length; }
  return total;
}

fn main() -> int32 {
  if (sum() != 0) { return 1; }
  if (sum(5) != 5) { return 2; }
  if (sum(1, 2, 3) != 6) { return 3; }
  if (count_of() != 0) { return 4; }
  if (count_of(1, 2) != 2) { return 5; }

  var k: int32 = 4;
  if (sum(k, k + 1) != 9) { return 6; }
  if (tagged(10) != 10) { return 7; }
  if (tagged(10, 1, 2) != 13) { return 8; }

  var a: Point;
  a.x = 3;
  var b: Point;
  b.x = 7;
  if (widest(a, b) != 7) { return 9; }
  if (widest() != 0) { return 10; }

  // A slice where the gather goes is the gather: one variadic call forwards
  // what it was handed rather than wrapping it again.
  if (forward(1, 2, 3, 4) != 10) { return 11; }

  var fixed: int32[3];
  fixed[0] = 2;
  fixed[1] = 3;
  fixed[2] = 4;
  if (sum(fixed) != 9) { return 12; }

  if (joined("-", "ab", "cde") != 7) { return 13; }
  return 0;
}
