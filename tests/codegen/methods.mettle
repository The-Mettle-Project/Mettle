struct Vec { x: int32; y: int32; }
fn Vec_sum(v: Vec) -> int32 { return v.x + v.y; }
fn Vec_scale(v: Vec, k: int32) -> int32 { return (v.x + v.y) * k; }
struct Big { a: int64; b: int64; c: int64; }
fn Big_total(b: Big) -> int64 { return b.a + b.b + b.c; }
fn main() -> int32 {
  var v: Vec = { x: 3, y: 4 };
  if (v.sum() != 7) { return 1; }
  if (v.scale(2) != 14) { return 2; }
  var p: Vec* = &v;
  if (p->sum() != 7) { return 3; }
  var b: Big = { a: 1, b: 2, c: 3 };
  if (b.total() != 6) { return 4; }
  return 0;
}
