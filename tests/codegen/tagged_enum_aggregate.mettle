/* A tagged enum is a discriminant beside the widest payload, so it copies
 * whole like a struct or a string. The whole-copy paths listed struct, array
 * and string only, so storing one into an array element moved the tag and left
 * the payload behind, and reading one back loaded a single word. */

struct Pt { x: int64; y: int64; }

enum Val {
  I(int64),
  F(float64),
  S(string),
  P(Pt),
  Nothing
}

struct Holder { tag: int32; v: Val; other: int32; }

@noinline fn built_float(x: float64) -> Val { return F(x); }

@noinline fn scaled_float(x: float64) -> Val { return F(x * 2.0); }

@noinline fn from_int(n: int64) -> Val { return F((float64)n); }

@noinline fn float_of(v: Val) -> float64 {
  match (v) {
    case F(f): { return f; }
    default: { return 0.0 - 1.0; }
  }
}

/* A tagged enum at global scope: the aggregate path in the global emitter
 * listed struct and array only, so this was refused outright. */
var stored: Val;
var stored_list: Val[2];

@noinline fn as_int(v: Val) -> int64 {
  match (v) {
    case I(n): { return n; }
    case F(f): { return (int64)f; }
    case S(s): { return 100; }
    case P(p): { return p.x * p.y; }
    case Nothing: { return 0 - 1; }
  }
  return 0 - 2;
}

@noinline fn opaque(x: int64) -> int64 { return x; }

fn main() -> int32 {
  var pt: Pt;
  pt.x = 3; pt.y = 4;

  /* Each variant through an array element. */
  var vs: Val[5];
  vs[0] = I(21);
  vs[1] = F(2.75);
  vs[2] = S("named");
  vs[3] = P(pt);
  vs[4] = Nothing();

  if (as_int(vs[0]) != 21) { return 1; }
  if (as_int(vs[1]) != 2) { return 2; }
  if (as_int(vs[2]) != 100) { return 3; }
  if (as_int(vs[3]) != 12) { return 4; }
  if (as_int(vs[4]) != 0 - 1) { return 5; }

  /* Read one back into a local, then match it there. */
  var pulled: Val = vs[0];
  match (pulled) {
    case I(n): { if (n != 21) { return 6; } }
    case F(f): { return 7; }
    case S(s): { return 8; }
    case P(p): { return 9; }
    case Nothing: { return 10; }
  }

  /* A dynamic index, so nothing folds it away. */
  var idx: int64 = opaque(3);
  if (as_int(vs[idx]) != 12) { return 11; }

  /* Element-to-element copy keeps the payload. */
  vs[4] = vs[0];
  if (as_int(vs[4]) != 21) { return 12; }

  /* As a struct field, and as a field of an array element. */
  var h: Holder;
  h.tag = 1;
  h.v = I(99);
  h.other = 2;
  if (as_int(h.v) != 99) { return 13; }
  if (h.tag != 1 || h.other != 2) { return 14; }

  var copy: Val = h.v;
  if (as_int(copy) != 99) { return 15; }

  var hs: Holder[2];
  hs[0].v = I(7);
  hs[1].v = P(pt);
  if (as_int(hs[0].v) != 7) { return 16; }
  if (as_int(hs[1].v) != 12) { return 17; }
  stored = I(55);
  if (as_int(stored) != 55) { return 18; }
  stored = P(pt);
  if (as_int(stored) != 12) { return 19; }
  stored_list[1] = S("g");
  if (as_int(stored_list[1]) != 100) { return 20; }
  if (as_int(stored_list[0]) != 0) { return 21; }

  if (float_of(built_float(3.25)) != 3.25) { return 22; }
  if (float_of(built_float(0.0 - 2.5)) != 0.0 - 2.5) { return 23; }
  if (float_of(scaled_float(1.5)) != 3.0) { return 24; }
  if (float_of(from_int(7)) != 7.0) { return 25; }
  if (float_of(F(4.75)) != 4.75) { return 26; }

  var running: float64 = 0.0;
  var k: int64 = 0;
  while (k < 6) {
    running = running + float_of(built_float((float64)k * 0.5));
    k = k + 1;
  }
  if (running != 7.5) { return 27; }

  return 0;
}
