@noinline fn sum_bytes(a: uint8*, n: int32) -> int64 {
  var t: int64 = 0;
  for i in 0..n { t = t + (int64)a[i]; }
  return t;
}
@noinline fn dot_i32(a: int32*, b: int32*, n: int32) -> int64 {
  var t: int64 = 0;
  for i in 0..n { t = t + (int64)(a[i] * b[i]); }
  return t;
}
@noinline fn saxpy(a: float32*, b: float32*, k: float32, n: int32) -> float32 {
  for i in 0..n { a[i] = a[i] + k * b[i]; }
  var t: float32 = 0.0;
  for i in 0..n { t = t + a[i]; }
  return t;
}
@noinline fn maxi(a: int32*, n: int32) -> int32 {
  var m: int32 = a[0];
  for i in 0..n { if (a[i] > m) { m = a[i]; } }
  return m;
}
@noinline fn scale(a: int32*, n: int32, k: int32) {
  for i in 0..n { a[i] = a[i] * k; }
}
fn main() -> int32 {
  var bytes: uint8[40];
  for i in 0..40 { bytes[i] = (uint8)(i + 1); }
  if (sum_bytes(&bytes[0], 40) != 820) { return 1; }
  var x: int32[33]; var y: int32[33];
  for i in 0..33 { x[i] = i; y[i] = 2; }
  if (dot_i32(&x[0], &y[0], 33) != 1056) { return 2; }
  var f: float32[16]; var g: float32[16];
  for i in 0..16 { f[i] = 1.0; g[i] = 2.0; }
  if (saxpy(&f[0], &g[0], 0.5, 16) != 32.0) { return 3; }
  var m: int32[17];
  for i in 0..17 { m[i] = i * 3 - 20; }
  if (maxi(&m[0], 17) != 28) { return 4; }
  var s: int32[9];
  for i in 0..9 { s[i] = i; }
  scale(&s[0], 9, 3);
  var t: int32 = 0;
  for i in 0..9 { t = t + s[i]; }
  if (t != 108) { return 5; }
  return 0;
}
