// Anti-rot for the horizontal-sum recognizer. See test_safe_vec_dot.mettle for
// what this class of test is guarding against.
import "std/io";
import "std/mem";

fn total(data: int32*, n: int64) -> int64 {
  var sum: int64 = 0;
  var i: int64 = 0;
  while (i < n) {
    sum = sum + (int64)data[i];
    i = i + 1;
  }
  return sum;
}

fn main() -> int32 {
  var n: int64 = 64;
  var data: int32* = malloc(n * 4);
  var i: int64 = 0;
  while (i < n) {
    data[i] = 1;
    i = i + 1;
  }

  var s: int64 = total(data, n + 64);
  println_int(s);
  return (int32)(s % 128);
}
