// Function pointers: a function's address becomes a value (a movz/movk quartet
// patched once the label lands), passes as an argument, and is called with blr.
// 7 + 12 + 30 + 200 = 249
fn add(a: int64, b: int64) -> int64 { return a + b; }
fn mul(a: int64, b: int64) -> int64 { return a * b; }
fn apply(f: fn(int64, int64) -> int64, a: int64, b: int64) -> int64 {
  return f(a, b);
}
fn main() -> int64 {
  var op: fn(int64, int64) -> int64 = &add;
  var total: int64 = op(3, 4);
  op = &mul;
  total = total + op(3, 4);
  total = total + apply(&add, 10, 20);
  total = total + apply(&mul, 10, 20);
  return total;
}
