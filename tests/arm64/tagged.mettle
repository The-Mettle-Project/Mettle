// A tagged enum is a record: a tag word and a payload beside it. The AArch64
// encoder left it out of its aggregate predicate, so a value of one travelled
// as its first eight bytes and a callee read the right tag with a zeroed
// payload. Separately, the predicates that read a declared type as TEXT
// searched it for "float"/"uint"/"32", and a monomorphized name carries its
// type argument: `Pair__float64` was classified as a scalar float and passed in
// a vector register, which segfaulted on the first use.
// 1 + 2 + 4 + 8 + 16 + 32 + 64 = 127
struct Span { lo: int64; hi: int64; }
enum Shape { Num(int64), Wide(Span), Nothing }
struct Pair<T> {
  a: T;
  b: T;

  method total() -> T { return this.a + this.b; }
}

@noinline fn opaque(v: int64) -> int64 { return v; }
@noinline fn payload(s: Shape) -> int64 {
  match (s) {
    case Num(n): { return n; }
    case Wide(w): { return w.lo * 100 + w.hi; }
    case Nothing: { return 0 - 1; }
  }
  return 0 - 2;
}
@noinline fn make(v: int64) -> Shape { return Num(v * 3); }

fn main() -> int64 {
  var r: int64 = 0;

  var s: Shape = Num(opaque(5));
  if (payload(s) == 5) { r = r + 1; }
  if (payload(make(opaque(4))) == 12) { r = r + 2; }

  var span: Span;
  span.lo = opaque(2);
  span.hi = opaque(7);
  s = Wide(span);
  if (payload(s) == 207) { r = r + 4; }

  s = Nothing();
  if (payload(s) == 0 - 1) { r = r + 8; }

  var pi: Pair<int64>;
  pi.a = opaque(3);
  pi.b = opaque(4);
  if (pi.total() == 7) { r = r + 16; }

  var pf: Pair<float64>;
  pf.a = 1.5;
  pf.b = 2.5;
  if ((int64)pf.total() == 4) { r = r + 32; }

  var pu: Pair<uint32>;
  pu.a = (uint32)opaque(70000);
  pu.b = (uint32)opaque(5);
  if ((int64)pu.total() == 70005) { r = r + 64; }

  return r;
}
