import "std/io";
// A `string` local is a { chars, length } record, and the IR names it bare where
// it means the record's ADDRESS: `*@msg [8]` reads the chars field out of it.
// Treating the local as one 8-byte chars pointer made that load read the first
// eight characters and then branch through them as an address.
fn main() -> int32 {
  println("Hello from println!");
  print("Hello from ");
  print("print!\n");
  return 0;
}
