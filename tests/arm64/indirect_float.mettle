fn half(x: float64, n: int32) -> float64 { return x / 2.0 + (float64)n; }
fn mixed(n: int32, x: float64, m: int64, y: float32) -> float64 {
  return (float64)n + x * 10.0 + (float64)m * 10.0 + (float64)y * 10.0;
}
fn narrow(x: float32) -> float32 { return x + (float32)1.0; }
fn main() -> int64 {
  var op: fn(float64, int32) -> float64 = &half;
  var a: float64 = op(8.0, 3);
  var q: fn(int32, float64, int64, float32) -> float64 = &mixed;
  var b: float64 = q(1, 2.0, 3, (float32)4.0);
  var r: fn(float32) -> float32 = &narrow;
  var c: float32 = r((float32)1.5);
  var d: float64 = (float64)c * 2.0;
  return (int64)a + (int64)b + (int64)d;
}
