import "std/io";

struct Pair { a: int64; b: int32; }

fn zero<T>() -> T { return (T)0; }

fn twice<T>(v: T) -> T { return v + v; }

fn main() -> int32 {
  var p: Pair = { a: twice<int64>(21), b: zero<int32>() };
  var xs: int32[2] = [ twice<int32>(4), zero<int32>() ];
  println("generic_literal: {p.a} {p.b} {xs[0]} {xs[1]}");
  return 0;
}
