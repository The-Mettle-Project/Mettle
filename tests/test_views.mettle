// A view is the ranked sibling of a slice: `T[,]` is a data pointer, one extent
// per dimension, and one leading dimension per outer dimension, with the
// innermost dimension always contiguous. `v[i]` drops a rank, so `v[i][j]`
// reads the way `grid[i][j]` reads on a fixed array, and a nested array decays
// into a view the way `T[N]` decays into `T[]`.

extern fn free(ptr: rawptr) = "free";

@noinline fn row_total(r: int32[]) -> int32 {
  var t: int32 = 0;
  for x in r { t = t + x; }
  return t;
}

@noinline fn view_total(v: int32[,]) -> int32 {
  var t: int32 = 0;
  for row in v { t = t + row_total(row); }
  return t;
}

@noinline fn fill(v: int32[,], base: int32) {
  for i in 0..v.dims[0] {
    for j in 0..v.dims[1] {
      v[i][j] = base + (int32)i * 100 + (int32)j;
    }
  }
}

@noinline fn make(rows: int64, cols: int64) -> float32[,] {
  var v: float32[,] = new float32[rows, cols];
  for i in 0..rows { for j in 0..cols { v[i][j] = (float32)(i * 10 + j); } }
  return v;
}

@noinline fn scale_rows(v: float32[,], k: float32) {
  for i in 0..v.dims[0] {
    var row: float32[] = v[i];
    for j in 0..row.length { row[j] = row[j] * k; }
  }
}

fn checks() -> int32 {
  if (sizeof(float32[,]) != 32) { return 1; }
  if (sizeof(int32[,,]) != 48) { return 2; }

  var m: int32[3][4];
  for i in 0..3 { for j in 0..4 { m[i][j] = i * 10 + j; } }
  var v: int32[,] = m;
  if (v.dims[0] != 3) { return 3; }
  if (v.dims[1] != 4) { return 4; }
  if (v.lead[0] != 4) { return 5; }
  if (v.length != 3) { return 6; }
  if (v[0][0] != 0) { return 7; }
  if (v[2][3] != 23) { return 8; }
  if (v[1][2] != 12) { return 9; }

  var row: int32[] = v[1];
  if (row.length != 4) { return 10; }
  if (row[0] != 10) { return 11; }
  if (row_total(row) != 46) { return 12; }
  if (view_total(v) != 138) { return 13; }

  v[2][1] = 77;
  if (m[2][1] != 77) { return 14; }
  fill(v, 1000);
  if (m[0][0] != 1000) { return 15; }
  if (m[2][3] != 1203) { return 16; }

  var f: float32[,] = make(5, 7);
  if (f.dims[0] != 5) { return 17; }
  if (f.dims[1] != 7) { return 18; }
  if (f.lead[0] != 7) { return 19; }
  if (f[4][6] != 46.0) { return 20; }
  scale_rows(f, 2.0);
  if (f[4][6] != 92.0) { return 21; }
  if (f[0][1] != 2.0) { return 22; }
  var flat: float32* = f.data;
  if (flat[4 * 7 + 6] != 92.0) { return 23; }
  free(f.data);

  var c: int32[2][3][4];
  for b in 0..2 { for i in 0..3 { for j in 0..4 { c[b][i][j] = b * 100 + i * 10 + j; } } }
  var w: int32[,,] = c;
  if (w.dims[0] != 2) { return 24; }
  if (w.dims[1] != 3) { return 25; }
  if (w.dims[2] != 4) { return 26; }
  if (w.lead[0] != 12) { return 27; }
  if (w.lead[1] != 4) { return 28; }
  var page: int32[,] = w[1];
  if (page.dims[0] != 3) { return 29; }
  if (page.dims[1] != 4) { return 30; }
  if (page.lead[0] != 4) { return 31; }
  if (page[2][3] != 123) { return 32; }
  if (w[1][2][3] != 123) { return 33; }
  if (w[0][1][2] != 12) { return 34; }
  w[0][1][2] = 5;
  if (c[0][1][2] != 5) { return 35; }
  if (view_total(page) != 3 * 100 * 4 + (0 + 10 + 20) * 4 + (0 + 1 + 2 + 3) * 3) { return 36; }

  var backing: int32[4][8];
  for i in 0..4 { for j in 0..8 { backing[i][j] = i * 8 + j; } }
  var padded: int32[,] = { data: &backing[1][2], dims: [2, 3], lead: [8] };
  if (padded[0][0] != 10) { return 37; }
  if (padded[0][2] != 12) { return 38; }
  if (padded[1][0] != 18) { return 39; }
  if (padded[1][2] != 20) { return 40; }
  if (view_total(padded) != 10 + 11 + 12 + 18 + 19 + 20) { return 41; }

  var g: int32[,] = new int32[3, 3];
  if (view_total(g) != 0) { return 42; }
  fill(g, 1);
  if (g[2][2] != 203) { return 43; }
  free(g.data);
  return 0;
}

@test fn test_views_match_native() -> int64 {
  assert_eq(checks(), 0);
  return 0;
}

fn main() -> int32 {
  return checks();
}
