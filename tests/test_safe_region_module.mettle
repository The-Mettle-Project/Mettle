import "std/io";
import "import_fixtures/safe_region_register";

// A region registered in another module still covers the pointer here.
fn main() -> int32 {
  var base: int64 = syscall(9, 0, 4096, 3, 0x22, -1, 0);
  var raw: uint8* = (uint8*)base;
  region_register(raw, 4096);
  var mem: uint64* = (uint64*)raw;
  mem[3] = 7;
  mem[511] = 5;
  var total: int32 = (int32)mem[3] + (int32)mem[511];
  region_release(raw);
  println("region wrong={total - 12}");
  return total - 12;
}
