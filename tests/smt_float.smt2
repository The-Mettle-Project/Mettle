(set-logic QF_FP)
(declare-const x Float64)
(declare-const a Float32)
(declare-const b Float32)
(declare-const c Float32)
(echo "doubling by multiply and by add")
(push 1)
(assert (not (= (fp.mul RNE x ((_ to_fp 11 53) RNE #x0000000000000002)) (fp.add RNE x x))))
(check-sat)
(pop 1)
(echo "addition is not associative")
(push 1)
(assert (not (= (fp.add RNE (fp.add RNE a b) c) (fp.add RNE a (fp.add RNE b c)))))
(check-sat)
(pop 1)
(echo "a square root is never below zero")
(push 1)
(assert (fp.lt (fp.sqrt RNE a) (_ +zero 8 24)))
(check-sat)
(pop 1)
(echo "NaN absorbs addition")
(push 1)
(assert (= x (_ NaN 11 53)))
(assert (not (fp.isNaN (fp.add RNE x (_ +zero 11 53)))))
(check-sat)
(pop 1)
(echo "zero plus its negation is positive")
(push 1)
(assert (fp.isZero x))
(assert (fp.isNegative (fp.add RNE x (fp.neg x))))
(check-sat)
(pop 1)
