import "std/io";
import "std/mem";
import "std/gpu";

fn scaled(x: float32, k: float32) -> float32 {
  return x * k;
}

fn device_only_offset(i: int32) -> float32 {
  return (float32)(i % 7);
}

kernel(block = 64) saxpy_offset(a: float32*, b: float32*, out: float32*,
                                k: float32, n: int32) {
  var i: int32 = block.x * block_dim.x + thread.x;
  if (i < n) {
    out[i] = scaled(a[i], k) + b[i] + device_only_offset(i);
  }
}

@test fn kernels_in_the_host_file_run_on_the_cpu_grid() -> int32 {
  var a: float32[100];
  var b: float32[100];
  var out: float32[100];
  for i: int32 in 0..100 {
    a[i] = (float32)i;
    b[i] = 1.0;
    out[i] = 0.0;
  }
  dispatch saxpy_offset[work: 100]((float32 global*)&a[0], (float32 global*)&b[0],
                                   (float32 global*)&out[0], -2.0, 100);
  for i: int32 in 0..100 {
    if (out[i] != (float32)i * -2.0 + 1.0 + (float32)(i % 7)) { return 1; }
  }
  return 0;
}

fn main() -> int32 {
  println("host scale {scaled(3.0, 2.0)}");
  if (gpu_init() == 0) { return 0; }
  var n: int32 = 4099;
  var bytes: int64 = (int64)n * 4;
  var ha: float32* = (float32*)malloc(bytes);
  var hb: float32* = (float32*)malloc(bytes);
  var ho: float32* = (float32*)malloc(bytes);
  for i: int32 in 0..n {
    ha[i] = (float32)(i % 101);
    hb[i] = (float32)(i % 5);
  }
  var da: int64 = gpu_malloc(bytes);
  var db: int64 = gpu_malloc(bytes);
  var dout: int64 = gpu_malloc(bytes);
  gpu_to_device(da, (uint8*)ha, bytes);
  gpu_to_device(db, (uint8*)hb, bytes);
  gpu_memset_u32(dout, (uint32)0x7FC00000, (int64)n);
  dispatch saxpy_offset[work: n](da, db, dout, -2.0, n);
  gpu_to_host((uint8*)ho, dout, bytes);
  var bad: int32 = 0;
  for i: int32 in 0..n {
    if (ho[i] != ha[i] * -2.0 + hb[i] + (float32)(i % 7)) { bad = bad + 1; }
  }
  gpu_free(da);
  gpu_free(db);
  gpu_free(dout);
  free((rawptr)ha);
  free((rawptr)hb);
  free((rawptr)ho);
  println("bad {bad}");
  return bad;
}
