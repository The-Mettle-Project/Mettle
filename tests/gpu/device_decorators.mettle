// Function decorators have to mean the same thing on the device as on the
// host. A device helper left out of line is a PTX `.func` reached by
// `call.uni`, which costs the call ABI's parameter space and a register
// allocation that stops at the call boundary -- paid once per work item, so
// `@inline` is worth more here than it is on the CPU. And `@inline!` claims to
// fail the build at a surviving call site; it cannot claim that on one target
// and shrug on another.

// Absorbed into every kernel that calls it: no `.func`, no `call.uni`.
@inline fn inline_helper(alpha: float32, x: float32) -> float32 {
  return alpha * x + (float32)1.0;
}

// The contract form. If the inliner ever stops reaching device code, this file
// stops compiling rather than quietly emitting a call.
@inline! fn contract_helper(alpha: float32, x: float32) -> float32 {
  return alpha * x - (float32)1.0;
}

// Held out of line on purpose, which is what proves the decorators are read
// rather than the inliner simply eating everything small.
@noinline fn kept_helper(alpha: float32, x: float32) -> float32 {
  return alpha * x * (float32)2.0;
}

kernel(block = 256) decorated(x: float32*, out: float32*, alpha: float32,
                              n: int32) {
  var i: int32 = block.x * block_dim.x + thread.x;
  if (i < n) {
    var v: float32 = inline_helper(alpha, x[i]);
    v = contract_helper(alpha, v);
    out[i] = kept_helper(alpha, v);
  }
}
