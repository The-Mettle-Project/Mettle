import "std/io";

fn a() { puts("A\n"); }
fn b() { puts("B\n"); }
fn c() { puts("C\n"); }
fn d() { puts("D\n"); }
fn e() { puts("E\n"); }
fn f() { puts("F\n"); }

fn main() -> int32 {
  defer a();
  defer b();
  {
    defer c();
    {
      defer d();
      defer e();
    }
    defer f();
  }
  return 0;
}
