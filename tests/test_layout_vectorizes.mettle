import "std/layout";

@soa struct Rec {
  a: int32;
  b: int32;
  c: int32;
}

fn sum_a(pool: Rec[], count: int32) -> int64 {
  var total: int64 = 0;
  var i: int32 = 0;
  while (i < count) {
    total = total + (int64)pool[i].a;
    i = i + 1;
  }
  return total;
}

fn sum_c(pool: Rec[], count: int32) -> int64 {
  var total: int64 = 0;
  var i: int32 = 0;
  while (i < count) {
    total = total + (int64)pool[i].c;
    i = i + 1;
  }
  return total;
}

fn main() -> int32 {
  var pool: Rec[] = new Rec[8];
  return (int32)(sum_a(pool, 8) + sum_c(pool, 8));
}
