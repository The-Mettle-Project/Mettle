// The find kernel only moves the loop counter forward to where the scalar loop
// would have arrived, so with nothing to scan it has to leave the counter where
// it started. The interpreter's model answered the length unconditionally,
// which is right for the not-found case and wrong for an empty range: a
// negative length made the model hand back that negative number, the scalar
// loop exited on its first test with it, and validation read a kernel that
// agrees with the source as a divergence. It quarantined simd_find on every
// counted search under --verify.
//
// Validation generates -1 as a length on its own, so this only has to be a
// program those searches are recognized in.
import "std/io";

fn scan_ne(a: int32*, n: int32, k: int32) -> int32 {
  var i: int32 = 0;
  while (i < n && a[i] != k) { i = i + 1; }
  return i;
}

fn strlen_b(s: uint8*, n: int32) -> int32 {
  var i: int32 = 0;
  while (i < n && s[i] != 0) { i = i + 1; }
  return i;
}

fn find_eq(a: int32*, n: int32, k: int32) -> int32 {
  var i: int32 = 0;
  while (i < n) {
    if (a[i] == k) { return i; }
    i = i + 1;
  }
  return -1;
}

fn main() -> int32 {
  var values: int32[16];
  var bytes: uint8[16];
  for i in 0..16 {
    values[i] = (int32)(i + 1);
    bytes[i] = (uint8)(i + 1);
  }

  // An empty range leaves the counter alone, whichever way it is empty.
  if (scan_ne(&values[0], 0 - 1, 0) != 0) { return 1; }
  if (scan_ne(&values[0], 0, 0) != 0) { return 2; }
  if (strlen_b(&bytes[0], 0 - 4) != 0) { return 3; }
  if (find_eq(&values[0], 0 - 1, 3) != 0 - 1) { return 4; }

  // A real search still answers the first hit, and a miss still runs to the end.
  if (scan_ne(&values[0], 16, 5) != 4) { return 5; }
  if (scan_ne(&values[0], 16, 999) != 16) { return 6; }
  if (find_eq(&values[0], 16, 12) != 11) { return 7; }
  if (find_eq(&values[0], 16, 999) != 0 - 1) { return 8; }
  bytes[9] = 0;
  if (strlen_b(&bytes[0], 16) != 9) { return 9; }

  return 0;
}
