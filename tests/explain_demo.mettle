// Demo for --explain: a mix of loops and calls the optimizer treats differently.

function scale(x: float32) -> float32 {
    return x * 2.5;
}

@noinline function opaque(x: int32) -> int32 {
    return x + 1;
}

function saxpy(a: float32, x: float32*, y: float32*, n: int32) {
    for i in 0..n {
        y[i] = a * x[i] + y[i];
    }
}

function with_call(out: float32*, n: int32) {
    var i: int32 = 0;
    while (i < n) {
        out[i] = scale(out[i]);
        i = i + 1;
    }
}

function sum_bytes(data: uint8*, n: int32) -> int32 {
    var total: int32 = 0;
    for i in 0..n {
        total = total + (int32)data[i];
    }
    return total;
}

// Row-times-vector: the inner dot product vectorizes, the outer row loop
// stays scalar and drives it.
function matvec(m: float32*, x: float32*, y: float32*, rows: int32, cols: int32) {
    for r in 0..rows {
        var acc: float32 = 0.0;
        for c in 0..cols {
            acc = acc + m[r * cols + c] * x[c];
        }
        y[r] = acc;
    }
}

function tiny_fixed() -> int32 {
    var s: int32 = 0;
    for i in 0..8 {
        s = s + i * i;
    }
    return s;
}

function main() -> int32 {
    var xs: float32[64];
    var ys: float32[64];
    var bs: uint8[64];
    var mm: float32[256];
    var i: int32 = 0;
    while (i < 64) {
        xs[i] = (float32)i;
        ys[i] = 1.0;
        bs[i] = (uint8)i;
        i = i + 1;
    }
    i = 0;
    while (i < 256) {
        mm[i] = 0.5;
        i = i + 1;
    }
    saxpy(2.0, &xs[0], &ys[0], 64);
    with_call(&ys[0], 64);
    matvec(&mm[0], &xs[0], &ys[0], 4, 64);
    var t: int32 = sum_bytes(&bs[0], 64);
    var u: int32 = opaque(t + tiny_fixed());
    return u - u;
}
