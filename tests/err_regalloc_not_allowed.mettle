import "std/regalloc";

@regalloc fn wants_the_stack_pointer(g: AllocGraph) -> Assignment {
  var out: Assignment;
  out.registers = new int64[g.vregs.length];
  for i in 0..g.vregs.length {
    out.registers[i] = 4;
  }
  return out;
}

@noinline fn add1(a: int64) -> int64 {
  return a + 1;
}

fn main() -> int32 {
  return (int32)add1(1);
}
