// Concurrent crash recovery. Eight threads crash at the same moment, round
// after round, alternating a trapped divide by zero (the runtime's trap path)
// and a write through a wild pointer (its signal path). Each crash resumes at
// the thread's own recovery point through mettle_crash_set_live_recovery.
// The crash handler used to keep one process-wide "in handler" flag, so a
// second crash during the first one's report ended the process. Now one
// report is written at a time and every crash is recovered.
// Build with -s. Prints CONCURRENT CRASH OK / FAIL.

import "std/io";
import "std/thread";

extern fn mettle_crash_set_live_recovery(point: int64, wait: int64, jump: int64) with none;

const THREADS: int64 = 8;
const ROUNDS: int64 = 40;
const SPAN: int64 = 262144;  // stack below the recovery point that counts as the thread's

// One thread's recovery point. regs follows the layout the runtime
// restores: rbx, rbp, (unused), (unused), r12, r13, r14, r15, rsp, rip.
struct Slot {
  regs: int64[10];
  lo: int64;
  hi: int64;
  round: int64;
}

var g_slots: Slot[8];
var g_arrived: int32 = 0;
var g_recovered: int32 = 0;
var g_zero: int64 = 0;
var g_wild: int64 = 16;
var g_sink: int64 = 0;

@naked fn save_point(regs: int64*) -> int64 {
  asm {
    mov [rdi], rbx
    mov [rdi + 8], rbp
    mov [rdi + 32], r12
    mov [rdi + 40], r13
    mov [rdi + 48], r14
    mov [rdi + 56], r15
    lea r10, [rsp + 8]
    mov [rdi + 64], r10
    mov r10, [rsp]
    mov [rdi + 72], r10
    xor eax, eax
    ret
  }
}

@naked fn resume_point(regs: int64) {
  asm {
    mov rax, rdi
    mov rbx, [rax]
    mov rbp, [rax + 8]
    mov r12, [rax + 32]
    mov r13, [rax + 40]
    mov r14, [rax + 48]
    mov r15, [rax + 56]
    mov rsp, [rax + 64]
    mov r10, [rax + 72]
    mov rax, 1
    jmp r10
  }
}

// The runtime asks which recovery point covers a faulting stack.
fn hook_point(stack: int64) -> int64 {
  for i: int64 in 0..THREADS {
    if (stack >= g_slots[i].lo && stack < g_slots[i].hi) {
      return (int64)&g_slots[i].regs[0];
    }
  }
  return 0;
}

fn hook_wait(slot: int64) -> int64 {
  return 1;
}

fn hook_jump(slot: int64) {
  resume_point(slot);
}

// Every thread waits here until all have arrived for this round.
fn wait_for_all(round: int64) {
  InterlockedIncrement(&g_arrived);
  // A compare-exchange that changes nothing is an atomic read.
  while ((int64)InterlockedCompareExchange(&g_arrived, -1, -1) < THREADS * (round + 1)) {
  }
}

fn crash(round: int64) {
  if (round % 2 == 0) {
    g_sink = 100 / g_zero;
  } else {
    *(int64*)g_wild = 1;
  }
}

fn worker(arg: cstring) -> uint32 {
  var s: Slot* = &g_slots[(int64)arg];
  var here: int64 = 0;
  s->hi = (int64)&here + 4096;
  s->lo = (int64)&here - SPAN;
  // State lives in s, not in locals: after a resume only memory is current.
  while (s->round < ROUNDS) {
    if (save_point(&s->regs[0]) == 0) {
      wait_for_all(s->round);
      crash(s->round);
    } else {
      InterlockedIncrement(&g_recovered);
    }
    s->round = s->round + 1;
  }
  return 0;
}

fn main() -> int32 {
  mettle_crash_set_live_recovery((int64)&hook_point, (int64)&hook_wait, (int64)&hook_jump);
  var handles: int64[8];
  var tid: uint32 = 0;
  for i: int64 in 0..THREADS {
    handles[i] = CreateThread(0, (uint64)1048576, &worker, (cstring)i, (uint32)0, &tid);
    if (handles[i] == 0) {
      println("CONCURRENT CRASH FAIL: spawn");
      return 1;
    }
  }
  for i: int64 in 0..THREADS {
    thread_join_infinite(handles[i]);
  }
  if ((int64)g_recovered != THREADS * ROUNDS) {
    println("CONCURRENT CRASH FAIL: recovered {g_recovered}");
    return 1;
  }
  println("CONCURRENT CRASH OK");
  return 0;
}
