import "std/gpu";

struct HostParams { count: int32; alpha: float32; beta: float32; }

extern kernel(block = 64) host_vadd(a: float32*, b: float32*, c: float32*, n: int32);
extern kernel host_mixed(out: int64*, i8: int8, u16: uint16, x: float32, wide: int64,
                         p: HostParams, flag: bool, last: int32);
extern kernel host_scale_rows(data: float32*, p: HostParams);
extern kernel host_block_sum(x: int32*, out: int32*, n: int32);
extern kernel host_plan(counts: uint32*, want: int32*);
extern kernel host_tile_ids(out: int32*);
extern kernel(block = 32) host_scale_resident(p: uint16*, v: uint16*,
                                              alpha: float32*, d: float32*);

extern fn malloc(bytes: int64) -> uint8* = "malloc";
extern fn getenv(name: cstring) -> cstring = "getenv";

fn check_vadd() -> int32 {
  var n: int32 = 1000;
  var bytes: int64 = (int64)n * 4;
  var ha: float32* = (float32*)malloc(bytes);
  var hb: float32* = (float32*)malloc(bytes);
  var hc: float32* = (float32*)malloc(bytes);
  var i: int32 = 0;
  while (i < n) {
    ha[i] = (float32)i;
    hb[i] = (float32)(3 * i + 1);
    hc[i] = (float32)-7;
    i = i + 1;
  }
  var da: int64 = gpu_malloc(bytes);
  var db: int64 = gpu_malloc(bytes);
  var dc: int64 = gpu_malloc(bytes);
  if (da == 0 || db == 0 || dc == 0) { return 11; }
  if (gpu_to_device(da, (uint8*)ha, bytes) != 0) { return 12; }
  if (gpu_to_device(db, (uint8*)hb, bytes) != 0) { return 12; }
  dispatch host_vadd[work: n](da, db, dc, n);
  if (gpu_to_host((uint8*)hc, dc, bytes) != 0) { return 13; }
  i = 0;
  while (i < n) {
    if (hc[i] != (float32)(4 * i + 1)) { return 14; }
    i = i + 1;
  }
  gpu_free(da);
  gpu_free(db);
  gpu_free(dc);
  return 0;
}

fn check_mixed() -> int32 {
  var dout: int64 = gpu_malloc(64);
  if (dout == 0) { return 21; }
  var p: HostParams;
  p.count = 7;
  p.alpha = (float32)1.5;
  p.beta = (float32)-0.25;
  var wide: int64 = 0x123456789A;
  dispatch host_mixed[1, 32](dout, (int8)-5, (uint16)65000, (float32)2.25, wide,
                             p, true, 424242);
  var out: int64[8];
  if (gpu_to_host((uint8*)&out[0], dout, 64) != 0) { return 22; }
  if (out[0] != (int64)-5) { return 23; }
  if (out[1] != (int64)65000) { return 24; }
  if (out[2] != (int64)9) { return 25; }
  if (out[3] != wide) { return 26; }
  if (out[4] != (int64)7) { return 27; }
  if (out[5] != (int64)12) { return 28; }
  if (out[6] != (int64)-2) { return 29; }
  if (out[7] != (int64)424242) { return 30; }
  gpu_free(dout);
  return 0;
}

fn check_rows() -> int32 {
  var cols: int32 = 100;
  var rows: int32 = 3;
  var bytes: int64 = (int64)(cols * rows) * 4;
  var host: float32* = (float32*)malloc(bytes);
  var r: int32 = 0;
  while (r < rows) {
    var c: int32 = 0;
    while (c < cols) {
      host[r * cols + c] = (float32)(r * 1000 + c);
      c = c + 1;
    }
    r = r + 1;
  }
  var dd: int64 = gpu_malloc(bytes);
  if (dd == 0) { return 31; }
  if (gpu_to_device(dd, (uint8*)host, bytes) != 0) { return 32; }
  var p: HostParams;
  p.count = cols;
  p.alpha = (float32)1.5;
  p.beta = (float32)-0.25;
  dispatch host_scale_rows[grid: ((cols + 31) / 32, rows, 1),
                           block: (32, 1, 1)](dd, p);
  if (gpu_to_host((uint8*)host, dd, bytes) != 0) { return 33; }
  r = 0;
  while (r < rows) {
    var c: int32 = 0;
    while (c < cols) {
      var want: float32 = (float32)(r * 1000 + c) * (float32)1.5 - (float32)0.25;
      if (host[r * cols + c] != want) { return 34; }
      c = c + 1;
    }
    r = r + 1;
  }
  gpu_free(dd);
  return 0;
}

fn check_block_sum() -> int32 {
  var n: int32 = 300;
  var blocks: int32 = (n + 63) / 64;
  var hx: int32* = (int32*)malloc((int64)n * 4);
  var i: int32 = 0;
  while (i < n) {
    hx[i] = i * 7 - 100;
    i = i + 1;
  }
  var dx: int64 = gpu_malloc((int64)n * 4);
  var dsum: int64 = gpu_malloc((int64)blocks * 4);
  if (dx == 0 || dsum == 0) { return 41; }
  if (gpu_to_device(dx, (uint8*)hx, (int64)n * 4) != 0) { return 42; }
  dispatch host_block_sum[grid: (blocks, 1, 1), block: (64, 1, 1),
                          shared: 256](dx, dsum, n);
  var sums: int32[8];
  if (gpu_to_host((uint8*)&sums[0], dsum, (int64)blocks * 4) != 0) { return 43; }
  var b: int32 = 0;
  while (b < blocks) {
    var want: int32 = 0;
    var k: int32 = b * 64;
    while (k < n && k < b * 64 + 64) {
      want = want + hx[k];
      k = k + 1;
    }
    if (sums[b] != want) { return 44; }
    b = b + 1;
  }
  return 0;
}

fn check_graph() -> int32 {
  var n: int32 = 200;
  var bytes: int64 = (int64)n * 4;
  var ha: float32* = (float32*)malloc(bytes);
  var hc: float32* = (float32*)malloc(bytes);
  var i: int32 = 0;
  while (i < n) {
    ha[i] = (float32)i;
    i = i + 1;
  }
  var da: int64 = gpu_malloc(bytes);
  var dc: int64 = gpu_malloc(bytes);
  if (da == 0 || dc == 0) { return 51; }
  if (gpu_to_device(da, (uint8*)ha, bytes) != 0) { return 52; }
  var stream: int64 = gpu_stream_create();
  if (gpu_graph_capture_begin(stream) != 0) { return 53; }
  dispatch host_vadd[work: n](da, da, dc, n) on stream;
  dispatch host_vadd[work: n](dc, da, da, n) on stream;
  var graph: int64 = gpu_graph_capture_end(stream);
  if (graph == 0) { return 54; }
  if (gpu_to_host((uint8*)hc, da, bytes) != 0) { return 55; }
  if (hc[7] != (float32)7) { return 56; }
  var start: int64 = gpu_event_create();
  var finish: int64 = gpu_event_create();
  gpu_event_record(start, stream);
  if (gpu_graph_launch(graph, stream) != 0) { return 57; }
  if (gpu_graph_launch(graph, stream) != 0) { return 57; }
  gpu_event_record(finish, stream);
  gpu_event_sync(finish);
  var elapsed: float32 = (float32)-1;
  if (gpu_event_elapsed_ms(start, finish, &elapsed) != 0 || elapsed < (float32)0) {
    return 58;
  }
  if (gpu_to_host((uint8*)hc, da, bytes) != 0) { return 59; }
  i = 0;
  while (i < n) {
    if (hc[i] != (float32)(9 * i)) { return 60; }
    i = i + 1;
  }
  gpu_graph_destroy(graph);
  if (gpu_graph_launch(graph, stream) == 0) { return 61; }
  gpu_free(da);
  gpu_free(dc);
  return 0;
}

fn reset_tiles(host: int32*, dout: int64) -> int32 {
  var i: int32 = 0;
  while (i < 8 * 4 * 32) {
    host[i] = -1;
    i = i + 1;
  }
  return gpu_to_device(dout, (uint8*)host, (int64)(8 * 4 * 32) * 4);
}

fn tiles_match(host: int32*, dout: int64, gx: int32, gy: int32) -> int32 {
  if (gpu_to_host((uint8*)host, dout, (int64)(8 * 4 * 32) * 4) != 0) { return 0; }
  var y: int32 = 0;
  while (y < 4) {
    var x: int32 = 0;
    while (x < 8) {
      var want: int32 = -1;
      if (x < gx && y < gy) { want = y * 100 + x; }
      var t: int32 = 0;
      while (t < 32) {
        if (host[(y * 8 + x) * 32 + t] != want) { return 0; }
        t = t + 1;
      }
      x = x + 1;
    }
    y = y + 1;
  }
  return 1;
}

fn plan_tiles(dwant: int64, gx: int32, gy: int32) -> int32 {
  var want: int32[2];
  want[0] = gx;
  want[1] = gy;
  return gpu_to_device(dwant, (uint8*)&want[0], 8);
}

fn check_indirect() -> int32 {
  var host: int32* = (int32*)malloc((int64)(8 * 4 * 32) * 4);
  var dcounts: int64 = gpu_malloc(16);
  var dwant: int64 = gpu_malloc(8);
  var dout: int64 = gpu_malloc((int64)(8 * 4 * 32) * 4);
  if (dcounts == 0 || dwant == 0 || dout == 0) { return 71; }
  if (reset_tiles(host, dout) != 0 || plan_tiles(dwant, 5, 3) != 0) { return 72; }
  dispatch host_plan[1, 32](dcounts, dwant);
  dispatch host_tile_ids[grid_indirect: dcounts, block: (32, 1, 1)](dout);
  if (tiles_match(host, dout, 5, 3) == 0) { return 73; }
  if (reset_tiles(host, dout) != 0 || plan_tiles(dwant, 0, 2) != 0) { return 74; }
  dispatch host_plan[1, 32](dcounts, dwant);
  dispatch host_tile_ids[grid_indirect: dcounts, block: (32, 1, 1)](dout);
  if (tiles_match(host, dout, 0, 0) == 0) { return 75; }
  var stream: int64 = gpu_stream_create();
  if (gpu_graph_capture_begin(stream) != 0) { return 76; }
  dispatch host_plan[1, 32](dcounts, dwant) on stream;
  dispatch host_tile_ids[grid_indirect: dcounts, block: (32, 1, 1),
                         stream: stream](dout);
  var graph: int64 = gpu_graph_capture_end(stream);
  if (graph == 0) { return 77; }
  if (reset_tiles(host, dout) != 0 || plan_tiles(dwant, 2, 4) != 0) { return 78; }
  if (gpu_graph_launch(graph, stream) != 0) { return 79; }
  if (tiles_match(host, dout, 2, 4) == 0) { return 80; }
  if (reset_tiles(host, dout) != 0 || plan_tiles(dwant, 8, 1) != 0) { return 81; }
  if (gpu_graph_launch(graph, stream) != 0) { return 82; }
  if (tiles_match(host, dout, 8, 1) == 0) { return 83; }
  gpu_graph_destroy(graph);
  gpu_free(dcounts);
  gpu_free(dwant);
  gpu_free(dout);
  return 0;
}

fn group_chain(da: int64, db: int64, dc: int64, d1: int64, d2: int64,
               de: int64, n: int32) {
  dispatch host_vadd[work: n](da, db, dc, n);
  gpu_barrier_off();
  dispatch host_vadd[work: n](dc, da, d1, n);
  dispatch host_vadd[work: n](dc, db, d2, n);
  gpu_barrier_on();
  gpu_flush();
  dispatch host_vadd[work: n](d1, d2, de, n);
}

fn check_flush_groups() -> int32 {
  var n: int32 = 300;
  var bytes: int64 = (int64)n * 4;
  var ha: float32* = (float32*)malloc(bytes);
  var hb: float32* = (float32*)malloc(bytes);
  var he: float32* = (float32*)malloc(bytes);
  var i: int32 = 0;
  while (i < n) {
    ha[i] = (float32)i;
    hb[i] = (float32)(2 * i + 1);
    i = i + 1;
  }
  var da: int64 = gpu_malloc(bytes);
  var db: int64 = gpu_malloc(bytes);
  var dc: int64 = gpu_malloc(bytes);
  var d1: int64 = gpu_malloc(bytes);
  var d2: int64 = gpu_malloc(bytes);
  var de: int64 = gpu_malloc(bytes);
  if (da == 0 || db == 0 || dc == 0 || d1 == 0 || d2 == 0 || de == 0) { return 101; }
  if (gpu_to_device(da, (uint8*)ha, bytes) != 0) { return 102; }
  if (gpu_to_device(db, (uint8*)hb, bytes) != 0) { return 102; }
  group_chain(da, db, dc, d1, d2, de, n);
  if (gpu_sync() != 0) { return 103; }
  if (gpu_to_host((uint8*)he, de, bytes) != 0) { return 104; }
  i = 0;
  while (i < n) {
    if (he[i] != (float32)(3 * i + 3 * (2 * i + 1))) { return 105; }
    he[i] = (float32)-1;
    i = i + 1;
  }
  if (gpu_to_device(de, (uint8*)he, bytes) != 0) { return 106; }
  var stream: int64 = gpu_stream_create();
  if (gpu_graph_capture_begin(stream) != 0) { return 107; }
  group_chain(da, db, dc, d1, d2, de, n);
  var graph: int64 = gpu_graph_capture_end(stream);
  if (graph == 0 || gpu_graph_launch(graph, stream) != 0) { return 108; }
  if (gpu_to_host((uint8*)he, de, bytes) != 0) { return 109; }
  i = 0;
  while (i < n) {
    if (he[i] != (float32)(3 * i + 3 * (2 * i + 1))) { return 110; }
    i = i + 1;
  }
  gpu_graph_destroy(graph);
  gpu_free(da);
  gpu_free(db);
  gpu_free(dc);
  gpu_free(d1);
  gpu_free(d2);
  gpu_free(de);
  return 0;
}

fn half_bits(x: int32) -> uint16 {
  if (x == 0) { return (uint16)0; }
  var sign: int32 = 0;
  var m: int32 = x;
  if (m < 0) {
    sign = 0x8000;
    m = -m;
  }
  var e: int32 = 0;
  while ((1 << (e + 1)) <= m) { e = e + 1; }
  return (uint16)(sign | ((e + 15) << 10) | ((m << (10 - e)) & 0x3FF));
}

fn p_value(r: int32, k: int32) -> int32 { return (3 * r + k) % 7 - 3; }
fn v_value(k: int32, c: int32) -> int32 { return (c + 2 * k) % 5 - 2; }
fn alpha_value(chunk: int32, r: int32) -> float32 {
  if (chunk == 1) { return (float32)(r + 1) * 0.5; }
  return (float32)(r % 4) - 1.5;
}

fn scaled_sum(r: int32, c: int32) -> float32 {
  var acc: float32 = 0.0;
  var chunk: int32 = 0;
  while (chunk < 3) {
    if (chunk > 0) { acc = acc * alpha_value(chunk, r); }
    var k: int32 = chunk * 16;
    while (k < chunk * 16 + 16) {
      acc = acc + (float32)(p_value(r, k) * v_value(k, c));
      k = k + 1;
    }
    chunk = chunk + 1;
  }
  return acc;
}

fn check_scale_rows() -> int32 {
  var hp: uint16* = (uint16*)malloc(768 * 2);
  var hv: uint16* = (uint16*)malloc(768 * 2);
  var ha: float32* = (float32*)malloc(32 * 4);
  var hd: float32* = (float32*)malloc(256 * 4);
  var r: int32 = 0;
  while (r < 16) {
    var k: int32 = 0;
    while (k < 48) {
      hp[r * 48 + k] = half_bits(p_value(r, k));
      hv[r * 48 + k] = half_bits(v_value(k, r));
      k = k + 1;
    }
    ha[r] = alpha_value(1, r);
    ha[16 + r] = alpha_value(2, r);
    r = r + 1;
  }
  var dp: int64 = gpu_malloc(768 * 2);
  var dv: int64 = gpu_malloc(768 * 2);
  var da: int64 = gpu_malloc(32 * 4);
  var dd: int64 = gpu_malloc(256 * 4);
  if (dp == 0 || dv == 0 || da == 0 || dd == 0) { return 121; }
  if (gpu_to_device(dp, (uint8*)hp, 768 * 2) != 0) { return 122; }
  if (gpu_to_device(dv, (uint8*)hv, 768 * 2) != 0) { return 122; }
  if (gpu_to_device(da, (uint8*)ha, 32 * 4) != 0) { return 122; }
  dispatch host_scale_resident[grid: (1, 1, 1), block: (32, 1, 1)](dp, dv, da, dd);
  if (gpu_to_host((uint8*)hd, dd, 256 * 4) != 0) { return 123; }
  r = 0;
  while (r < 16) {
    var c: int32 = 0;
    while (c < 16) {
      if (hd[r * 16 + c] != scaled_sum(r, c)) { return 124; }
      c = c + 1;
    }
    r = r + 1;
  }
  gpu_free(dp);
  gpu_free(dv);
  gpu_free(da);
  gpu_free(dd);
  return 0;
}

fn main() -> int32 {
  var path: cstring = getenv("METTLE_METAL_HOST_LIBRARY");
  if (path == 0) {
    if (gpu_open_kernels("metal_host_kernels") == 0) { return 91; }
  } else {
    if (gpu_open(path) == 0) { return 91; }
  }
  var status: int32 = check_vadd();
  if (status != 0) { return status; }
  status = check_mixed();
  if (status != 0) { return status; }
  status = check_rows();
  if (status != 0) { return status; }
  status = check_block_sum();
  if (status != 0) { return status; }
  status = check_graph();
  if (status != 0) { return status; }
  status = check_indirect();
  if (status != 0) { return status; }
  status = check_flush_groups();
  if (status != 0) { return status; }
  return check_scale_rows();
}
