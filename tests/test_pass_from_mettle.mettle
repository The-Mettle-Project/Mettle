import "std/io";
import "std/pass";

@pass(cleanup) fn double_add_of_itself(f: PassFunction) -> PassFunction {
  for i in 0..f.code.length {
    if (f.code[i].op == "binary" && f.code[i].text == "+" && !f.code[i].is_float &&
        f.code[i].lhs.kind == OPERAND_SYMBOL && f.code[i].rhs.kind == OPERAND_SYMBOL &&
        f.code[i].lhs.name == f.code[i].rhs.name) {
      f.code[i].text = "<<";
      f.code[i].rhs = operand_int(1);
    }
  }
  return f;
}

@pass(after_redundancy_elim) fn insert_a_copy(f: PassFunction) -> PassFunction {
  if (f.name != "marked") { return f; }
  var out: PassOp[] = new PassOp[f.code.length + 2];
  var w: int64 = 0;
  for i in 0..f.code.length {
    var op: PassOp = f.code[i];
    if (op.op == "return" && op.lhs.kind == OPERAND_SYMBOL) {
      var keep: PassOp = new_op("assign", i);
      keep.dest = operand_temp("__copy_of_result");
      keep.lhs = op.lhs;
      out[w] = keep;
      w = w + 1;
      op.lhs = operand_temp("__copy_of_result");
    }
    out[w] = op;
    w = w + 1;
  }
  var trimmed: PassOp[] = new PassOp[w];
  for i in 0..w { trimmed[i] = out[i]; }
  f.code = trimmed;
  return f;
}

@noinline fn twice(x: int64) -> int64 {
  return x + x;
}

@noinline fn marked(x: int64) -> int64 {
  var y: int64 = x * 3;
  if (y > 10) { y = y - 1; }
  return y;
}

fn main() -> int32 {
  var bad: int32 = 0;
  if (twice(21) != 42) { bad = bad + 1; }
  if (twice(-3) != -6) { bad = bad + 2; }
  if (marked(5) != 14) { bad = bad + 4; }
  if (marked(1) != 3) { bad = bad + 8; }
  if (bad == 0) { println("ok"); }
  return bad;
}
