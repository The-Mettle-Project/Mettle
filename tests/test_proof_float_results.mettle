import "std/io";
type Unit = float64 where value >= 0.0 && value <= 1.0;
type Small = float64 where value >= 0.0 && value <= 0.5;

fn halve(x: float64) -> float64 { return x * 0.5; }

fn clamp_unit(x: float64) -> float64 {
  if (!(x >= 0.0)) { return 0.0; }
  if (!(x <= 1.0)) { return 1.0; }
  return x;
}

fn blend(a: Unit, b: Unit) -> float64 { return (float64)a * (float64)b; }

fn half_of(u: Unit) -> float64 {
  var s: Small = (Small)halve((float64)u);
  return (float64)s;
}

fn clamped(x: float64) -> float64 {
  var u: Unit = (Unit)clamp_unit(x);
  return (float64)u;
}

fn blended(a: Unit, b: Unit) -> float64 {
  var u: Unit = (Unit)blend(a, b);
  return (float64)u;
}

fn main() -> int32 {
  var zero: float64 = 0.0;
  println("{half_of((Unit)0.75)} {clamped(7.5)} {clamped(-3.0)} {clamped(zero / zero)} {blended((Unit)0.5, (Unit)0.5)}");
  return 0;
}
