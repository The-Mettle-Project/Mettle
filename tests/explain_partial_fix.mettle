import "std/io";

// A loop with two independent obstacles stacked on one another. The int16
// elements are the one the diagnosis names, and retyping them is a real fix --
// but the loop still will not vectorize afterwards, so advice that stops there
// costs the reader an edit and a rebuild to learn nothing. The report has to
// simulate the fix, find that the loop is still scalar, and say what blocks it
// next before the reader touches the file.

fn row_energy(pixels: int16*, width: int32, row: int32) -> int32 {
    var energy: int32 = 0;

    for x in 0..width {
        energy = energy + (int32)pixels[row * width + x];
    }

    return energy;
}

fn main() -> int32 {
    var buf: int16[256];
    var p: int16* = &buf[0];

    for i in 0..256 {
        p[i] = (int16)i;
    }

    print_int(row_energy(p, 32, 3));
    newline();
    return 0;
}
