// The string-native half of std/conv. These take and return `string`, which is
// a borrowed view, so every returned value points into the input: nothing here
// allocates, and nothing outlives the bytes it was cut from.
//
// Each check returns its own code so a failure names the function that broke.

import "std/core";
import "std/conv"

// The checks below want a plain number to compare, so these unwrap once here
// and every assertion stays one line.
fn at(o: Option<int64>, missing: int64) -> int64 {
    match (o) {
        case Some(i): { return i; }
        case None: { return missing; }
    }
}

fn main() -> int32 {
    var s: string = "hello world";

    // Slicing, with the clamping that keeps a bad index from producing a wild
    // pointer.
    if (str_slice(s, 0, 5) != "hello") { return 1; }
    if (str_slice(s, 6, 5) != "world") { return 2; }
    if (str_slice(s, 6, 999) != "world") { return 3; }   // length clamped
    if (str_slice(s, 99, 5) != "") { return 4; }         // start past the end
    if (str_slice(s, 0 - 3, 5) != "hello") { return 5; } // negative start

    // Prefix, suffix, and position.
    if (str_starts_with(s, "hello") != 1) { return 6; }
    if (str_starts_with(s, "world") != 0) { return 7; }
    if (str_ends_with(s, "world") != 1) { return 8; }
    if (str_ends_with(s, "hello") != 0) { return 9; }
    if (at(str_find(s, "o"), 0 - 1) != 4) { return 10; }
    if (at(str_find(s, "world"), 0 - 1) != 6) { return 11; }
    if (at(str_find(s, "zebra"), 0 - 1) != 0 - 1) { return 12; }
    if (at(str_find_byte(s, 32), 0 - 1) != 5) { return 13; }  // the space
    if (str_contains(s, "lo w") != 1) { return 14; }
    if (str_contains(s, "lo  w") != 0) { return 15; }

    // A needle longer than the haystack cannot match, and must not read past.
    if (at(str_find("ab", "abc"), 0 - 1) != 0 - 1) { return 16; }
    // An empty needle matches at the start, agreeing with starts_with.
    if (at(str_find(s, ""), 0 - 1) != 0) { return 17; }
    if (str_starts_with(s, "") != 1) { return 18; }

    // Trimming, including strings that are all space or empty.
    if (str_trim("  padded  ") != "padded") { return 19; }
    if (str_trim_start("  x") != "x") { return 20; }
    if (str_trim_end("x  ") != "x") { return 21; }
    if (str_trim("     ") != "") { return 22; }
    if (str_trim("") != "") { return 23; }
    if (str_trim("none") != "none") { return 24; }

    // Splitting. The head and tail together cover every byte before and after
    // the separator; a separator that is absent answers None.
    var head: string = "";
    var tail: string = "";
    match (str_split_once("key=value", "=")) {
        case Some(kv): { head = kv.head; tail = kv.tail; }
        case None: { return 25; }
    }
    if (head != "key") { return 26; }
    if (tail != "value") { return 27; }

    match (str_split_once("novalue", "=")) {
        case Some(kv): { return 28; }
        case None: { }
    }

    // Parsing, with no terminator anywhere in sight. A failure is unreachable
    // through Ok, so the sentinel below can only come from the Err arm.
    var value: int64 = 0;
    if (str_to_i64_or("1234", 0 - 1) != 1234) { return 31; }
    if (str_to_i64_or("-42", 0 - 1) != 0 - 42) { return 32; }
    if (str_to_i64_or("+7", 0 - 1) != 7) { return 33; }
    if (str_to_i64_or("12a", 0 - 1) != 0 - 1) { return 34; }  // partial fails
    if (str_to_i64_or("", 0 - 1) != 0 - 1) { return 35; }
    if (str_to_i64_or("-", 0 - 1) != 0 - 1) { return 36; }

    // The error arm says what was wrong.
    match (str_to_i64("12a")) {
        case Ok(v): { return 43; }
        case Err(why): { if (why != "not a decimal digit") { return 44; } }
    }
    match (str_to_i64("")) {
        case Ok(v): { return 45; }
        case Err(why): { if (why != "empty") { return 46; } }
    }

    // Parsing a field sliced straight out of a larger buffer.
    var record: string = "id=907;";
    match (str_split_once(record, "=")) {
        case Some(kv): { tail = kv.tail; }
        case None: { return 37; }
    }
    value = str_to_i64_or(str_slice(tail, 0, (int64)tail.length - 1), 0 - 1);
    if (value != 907) { return 37; }

    // Formatting into a caller-owned buffer, returned as a view of it.
    var buf: uint8[32];
    if (i64_to_str(4096, &buf[0], 32) != "4096") { return 38; }
    if (i64_to_str(0 - 5, &buf[0], 32) != "-5") { return 39; }
    if (i64_to_str(0, &buf[0], 32) != "0") { return 40; }
    // Too small a buffer yields nothing rather than a truncated number.
    if (i64_to_str(4096, &buf[0], 4) != "") { return 41; }

    // Round trip.
    if (str_to_i64_or(i64_to_str(0 - 987654, &buf[0], 32), 0) != 0 - 987654) {
        return 42;
    }

    return 88;
}
