// A global's storage is laid out in the object file, so an aggregate one needs
// an aggregate literal: a call has no image to lay out. Previously this reached
// the backend and surfaced as an internal compiler error with no source line.
struct P {
  x: int32;
  y: int32;
}

fn make() -> P {
  var p: P;
  p.x = 7;
  return p;
}

var g_origin: P = make();

fn main() -> int32 { return g_origin.x; }
