// Narrow values on the 16-bit target, all three ways they used to go wrong.
//
// A narrow local lives in a whole-word slot, so the store never truncates and
// the cast is the only place a width is applied. The cast was emitted as a
// plain move, and nothing here ever wrapped: (uint8)321 answered 321.
//
// A global holds exactly its declared size, so a uint8 one is a single byte
// with the next global right after it. Every access spelled it `word ptr`,
// which read and wrote that neighbour.
//
// A byte read through a pointer used movzx/movsx, which are 386 instructions.
// A 16-bit image that used them ran on nothing the target names.
//
// Each check prints Y when the value came back right and N when it did not.
@naked fn _start() {
    asm {
        bits 16
        cli
        xor ax, ax
        mov ds, ax
        mov es, ax
        mov ss, ax
        mov sp, 0x7c00
        sti
        call main
        cli
    halt:
        hlt
        jmp halt
    }
}

struct Bytes { a: uint8; b: int8; n: int16; }

var BYTE_A: uint8 = 1
var BYTE_B: uint8 = 2
var SIGNED_G: int8 = 0

fn putchar(c: int16) -> int16 {
    asm {
        mov ax, {c}
        mov ah, 0x0e
        mov bx, 7
        int 0x10
    }
    return c
}

@noinline fn opaque(v: int16) -> int16 { return v }

fn check(ok: int16) -> int16 {
    if (ok != 0) { putchar(89) } else { putchar(78) }
    return ok
}

fn main() -> int16 {
    // The cast converts, wherever its value is used.
    check((uint8)opaque(321) == 65)
    check((int8)opaque(200) == 0 - 56)
    check((uint8)opaque(0 - 1) == 255)
    var wrapped: uint8 = (uint8)opaque(300)
    check(wrapped == 44)
    var narrow: int8 = (int8)opaque(200)
    check(narrow == 0 - 56)

    // A byte global is a byte, and its neighbour keeps its own value.
    BYTE_A = (uint8)opaque(200)
    check(BYTE_B == 2)
    check(BYTE_A == 200)
    SIGNED_G = (int8)opaque(0 - 5)
    check(SIGNED_G == 0 - 5)
    check(BYTE_A == 200)

    // A byte read through a pointer, unsigned and signed.
    var record: Bytes
    record.a = (uint8)opaque(200)
    record.b = (int8)opaque(0 - 3)
    record.n = opaque(1000)
    check(record.a == 200)
    check(record.b == 0 - 3)
    check(record.n == 1000)

    var buffer: uint8[4]
    buffer[0] = (uint8)opaque(250)
    buffer[3] = (uint8)opaque(7)
    check(buffer[0] == 250)
    check(buffer[3] == 7)

    putchar(13)
    putchar(10)
    return 0
}
