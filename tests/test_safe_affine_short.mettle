// The same shapes, each walked one element past the end.
//
// A whole-loop check replaces every per-access check in the loop, so if its
// range comes out one element too narrow the overrun runs unexamined and the
// mode is silently missing from exactly the loops it was written for. Each
// case below is the smallest overrun there is, and the argument picks which.
//
// Traps whichever is asked for, so the runner can name the shape that failed.
import "std/io";
import "std/mem";

var DIM: int32 = 8;

fn from_one(a: int32*, n: int32) -> int32 {
  var total: int32 = 0;
  var i: int32 = 1;
  while (i < n) {
    total = total + a[i];
    i = i + 1;
  }
  return total;
}

fn displaced(m: int32*, base: int32, n: int32) -> int32 {
  var total: int32 = 0;
  var j: int32 = 0;
  while (j < n) {
    total = total + m[base + j];
    j = j + 1;
  }
  return total;
}

fn reversed(a: int32*, n: int32) -> int32 {
  var total: int32 = 0;
  var i: int32 = 0;
  while (i < n) {
    total = total + a[n - 1 - i];
    i = i + 1;
  }
  return total;
}

fn column(m: int32*, col: int32, rows: int32) -> int32 {
  var total: int32 = 0;
  var r: int32 = 0;
  while (r < rows) {
    total = total + m[r * DIM + col];
    r = r + 1;
  }
  return total;
}

fn from_runtime(m: int32*, row_base: int32, n: int32) -> int32 {
  var total: int32 = 0;
  var idx: int32 = row_base;
  var k: int32 = 0;
  while (k < n) {
    total = total + m[idx];
    idx = idx + 1;
    k = k + 1;
  }
  return total;
}

fn main(argc: int32, argv: cstring*) -> int32 {
  var cells: int32 = DIM * DIM;
  var m: int32* = (int32*)malloc((int64)cells * 4);
  var i: int32 = 0;
  while (i < cells) {
    m[i] = 1;
    i = i + 1;
  }

  var got: int32 = 0;
  if (argc < 2) {
    got = from_one(&m[0], cells + 1);
  } else {
    var pick: int32 = (int32)argv[1][0];
    if (pick == 50) {
      got = displaced(&m[0], cells - DIM, DIM + 1);
    } else if (pick == 51) {
      got = reversed(&m[0], cells + 1);
    } else if (pick == 52) {
      got = column(&m[0], DIM - 1, DIM + 1);
    } else {
      got = from_runtime(&m[0], cells - DIM, DIM + 1);
    }
  }

  print(cstr("unreached="));
  println_int((int64)got);
  free((cstring)m);
  return 0;
}
