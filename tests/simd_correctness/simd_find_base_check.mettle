// Correctness harness for the mismatch-scan kernel (IR_OP_SIMD_FIND).
//
// The kernel is installed in place of the counter's zero-init, so every base
// it reads has to hold its loop-entry value at that point. `run = 0; a = ...;
// while (run < n && a[run] == b[run])` writes the bases AFTER the init, and a
// kernel planted there scanned the previous call's buffers. Both orders are
// checked here against a reference the recognizers cannot claim, and the
// pre-init order must still vectorize (IrMustMatch on simd_find).

import "std/io";
import "std/mem";

var g_fail: int32 = 0;

fn fail(tag: cstring, n: int32) -> void {
  g_fail = g_fail + 1;
  print("FIND FAIL ");
  print_cstr(tag);
  print(" n=");
  println("{n}");
}

// Bases bound BEFORE the counter's init: the shape the kernel is meant for.
fn match_before(src: uint8*, i: int32, j: int32, limit: int32) -> int32 {
  var a: uint8* = src + i;
  var b: uint8* = src + j;
  var run: int32 = 0;
  while (run < limit && a[run] == b[run]) {
    run = run + 1;
  }
  return run;
}

// Bases bound AFTER it: same meaning, and the kernel must decline.
fn match_after(src: uint8*, i: int32, j: int32, limit: int32) -> int32 {
  var run: int32 = 0;
  var a: uint8* = src + i;
  var b: uint8* = src + j;
  while (run < limit && a[run] == b[run]) {
    run = run + 1;
  }
  return run;
}

// Reference: a second exit flag in the body keeps every recognizer off it.
fn match_ref(src: uint8*, i: int32, j: int32, limit: int32) -> int32 {
  var run: int32 = 0;
  var stop: int32 = 0;
  while (run < limit && stop == 0) {
    var x: int32 = (int32)src[i + run];
    var y: int32 = (int32)src[j + run];
    if (x != y) {
      stop = 1;
    } else {
      run = run + 1;
    }
  }
  return run;
}

@noinline fn ident_scan(src: uint8*, start: int32, limit: int32) -> int32 {
  var i: int32 = start;
  while (i < limit) {
    var c: int32 = (int32)src[i];
    if ((c >= 97 && c <= 122) || (c >= 65 && c <= 90) ||
        (c >= 48 && c <= 57) || c == 95) {
      i = i + 1;
    } else {
      break;
    }
  }
  return i;
}

// The extra stop state keeps this reference outside every find recognizer.
@noinline fn ident_ref(src: uint8*, start: int32, limit: int32) -> int32 {
  var i: int32 = start;
  var stop: int32 = 0;
  while (i < limit && stop == 0) {
    var c: int32 = (int32)src[i];
    if ((c >= 97 && c <= 122) || (c >= 65 && c <= 90) ||
        (c >= 48 && c <= 57) || c == 95) {
      i = i + 1;
    } else {
      stop = 1;
    }
  }
  return i;
}

fn main() -> int32 {
  var n: int32 = 4096;
  var buf: uint8* = malloc((int64)n);
  var seed: int64 = 2246822519;

  var k: int32 = 0;
  while (k < n) {
    seed = (seed * 1103515245 + 12345) & 0x7FFFFFFF;
    buf[k] = (uint8)((seed >> 7) % 5);
    k = k + 1;
  }

  // Lengths straddle the 32-byte vector width and its tail.
  var limit: int32 = 1;
  while (limit <= 70) {
    var i: int32 = 0;
    while (i < 512) {
      var j: int32 = i + 1 + (i % 37);
      var want: int32 = match_ref(buf, i, j, limit);
      if (match_before(buf, i, j, limit) != want) { fail("before", limit); }
      if (match_after(buf, i, j, limit) != want) { fail("after", limit); }
      i = i + 7;
    }
    limit = limit + 1;
  }

  // Every byte value checks the SSE range table, including NUL and bytes with
  // the high bit set. The stop point is beyond one 16-byte block.
  k = 0;
  while (k < 160) {
    buf[k] = (uint8)(97 + (k % 26));
    k = k + 1;
  }
  var byte_value: int32 = 0;
  while (byte_value < 256) {
    buf[53] = (uint8)byte_value;
    var got: int32 = ident_scan(buf, 3, 100);
    var want_class: int32 = ident_ref(buf, 3, 100);
    if (got != want_class) { fail("ident-byte", byte_value); }
    buf[53] = 97;
    byte_value = byte_value + 1;
  }

  // Vary both the address and the hit lane. This covers the first byte, both
  // sides of the 16-byte boundary, several blocks, and the no-hit tail.
  var start: int32 = 0;
  while (start < 48) {
    var hit: int32 = 0;
    while (hit < 72) {
      buf[start + hit] = 33;
      if (ident_scan(buf, start, start + 80) !=
          ident_ref(buf, start, start + 80)) {
        fail("ident-hit", start * 100 + hit);
      }
      buf[start + hit] = (uint8)(65 + (hit % 26));
      hit = hit + 1;
    }
    if (ident_scan(buf, start, start + 80) !=
        ident_ref(buf, start, start + 80)) {
      fail("ident-tail", start);
    }
    start = start + 1;
  }
  if (ident_scan(buf, 20, 20) != 20) { fail("ident-empty", 20); }

  // Signed negative indices are valid when the pointer is biased into the
  // allocation. They also exercise the full signed start range of the kernel.
  var biased: uint8* = buf + 96;
  k = -48;
  while (k < 48) { biased[k] = 97; k = k + 1; }
  biased[17] = 33;
  if (ident_scan(biased, -37, 40) != ident_ref(biased, -37, 40)) {
    fail("ident-negative", 37);
  }

  // Start eight bytes before a page edge. The kernel must hand this case back
  // to the scalar loop instead of issuing a 16-byte read across the edge.
  var edge_storage: uint8* = malloc(8256);
  var edge_offset: int32 =
      4096 - (int32)((int64)edge_storage & (int64)4095);
  var edge: uint8* = edge_storage + edge_offset - 8;
  k = 0;
  while (k < 64) { edge[k] = 97; k = k + 1; }
  edge[25] = 33;
  if (ident_scan(edge, 0, 64) != ident_ref(edge, 0, 64)) {
    fail("ident-page", edge_offset);
  }
  free(edge_storage);

  free(buf);
  if (g_fail == 0) { println("FIND SIMD: ALL OK"); return 0; }
  print("FIND SIMD FAILURES: ");
  println("{g_fail}");
  return 1;
}
