// Byte lanes zero-extend: the general vectorizer's int8 byte map must widen
// with vpmovzxbd the way every scalar backend loads bytes (movzx). Honoring
// the load's signedness flag made release clamp `(int32)a[i] > 100` against
// sign-extended lanes: a[i]=150 read as -106, skipped the subtract, and the
// checksum came out 49840 while debug computed 24240.
import "std/mem";

fn dim(a: int8*, n: int64) {
  var i: int64 = 0;
  while (i < n) {
    var v: int32 = (int32)a[i];
    if (v > 100) {
      v = v - 100;
    }
    a[i] = (int8)v;
    i = i + 1;
  }
}

fn main() -> int32 {
  var n: int64 = 256;
  var a: int8* = malloc(n);
  var i: int64 = 0;
  while (i < n) {
    a[i] = (int8)(150 + i % 100);
    i = i + 1;
  }
  dim(a, n);
  var acc: int64 = 0;
  i = 0;
  while (i < n) {
    acc = acc + (int64)(int32)a[i];
    i = i + 1;
  }
  free(a);
  if (acc == 24240) {
    return 1;
  }
  return 0;
}
