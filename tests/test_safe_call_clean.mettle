// Loops around a helper, which is the shape refusing every call gave up on.
//
// Each of these bodies calls out and none of the callees can take memory away,
// so each loop's checks fold into one covering the range it walks. The buffers
// are sized to exactly that range, so a range worked out one element too wide
// would trap here rather than pass quietly.
//
// The three callees are the three answers the question has: a Mettle function
// that computes, one that reaches another such function, and a C library
// entry point with no body in this program at all.
//
// Exits 0.
import "std/io";
import "std/mem";

fn weigh(v: int32) -> int32 {
  return v * 2;
}

fn weigh_twice(v: int32) -> int32 {
  return weigh(v) + weigh(v);
}

fn direct(a: int32*, n: int32) -> int32 {
  var total: int32 = 0;
  var i: int32 = 0;
  while (i < n) {
    total = total + weigh(a[i]);
    i = i + 1;
  }
  return total;
}

fn transitive(a: int32*, n: int32) -> int32 {
  var total: int32 = 0;
  var i: int32 = 0;
  while (i < n) {
    total = total + weigh_twice(a[i]);
    i = i + 1;
  }
  return total;
}

// memcmp has no body here; its contract says it cannot free anything.
fn against_library(a: cstring, b: cstring, n: int64) -> int64 {
  var hits: int64 = 0;
  var i: int64 = 0;
  while (i < n) {
    if (memcmp(a + i, b + i, 1) == 0) {
      hits = hits + 1;
    }
    i = i + 1;
  }
  return hits;
}

fn main() -> int32 {
  var n: int32 = 16;
  var a: int32* = (int32*)malloc((int64)n * 4);
  var i: int32 = 0;
  while (i < n) {
    a[i] = 1;
    i = i + 1;
  }

  var bytes: int64 = 16;
  var p: cstring = malloc(bytes);
  var q: cstring = malloc(bytes);
  var j: int64 = 0;
  while (j < bytes) {
    p[j] = 65;
    q[j] = 65;
    j = j + 1;
  }

  var got: int64 = 0;
  got = got + (int64)direct(a, n);         // 32
  got = got + (int64)transitive(a, n);     // 64
  got = got + against_library(p, q, bytes); // 16

  print(cstr("calls="));
  println_int(got);
  free((cstring)a);
  free(p);
  free(q);
  return 0;
}
