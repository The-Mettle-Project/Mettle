// Every `fix:` line --explain prints, applied literally.
//
// Each pair is one suggestion: `*_before` is the loop that draws the advice,
// and `*_after` is that same loop with the advice carried out exactly as
// written. The suite asserts the before half reports its diagnosis and the
// after half vectorizes, so a suggestion that stops working fails the build.
//
// Regression: several of these used to be hand-written guesses that had never
// been run. The unbounded-shift advice offered the loop it was refusing as its
// example of a loop that works; the predicated-count advice told the reader to
// spell a guard the way they had already spelled it; the extremum advice named
// the accumulator when the element width is what the kernel reads.

// ---- byte-sum-narrow-acc: declare the accumulator as int64 ----------------
fn bytesum_before(a: uint8*, n: int64) -> int32 {
  var s: int32 = 0;
  var i: int64 = 0;
  while (i < n) { s = s + (int32)a[i]; i = i + 1; }
  return s;
}
fn bytesum_after(a: uint8*, n: int64) -> int64 {
  var s: int64 = 0;
  var i: int64 = 0;
  while (i < n) { s = s + (int64)a[i]; i = i + 1; }
  return s;
}

// ---- int16-elements: use int32 elements and an int64 accumulator ----------
fn i16_before(a: int16*, n: int64) -> int32 {
  var s: int32 = 0;
  var i: int64 = 0;
  while (i < n) { s = s + (int32)a[i]; i = i + 1; }
  return s;
}
fn i16_after(a: int32*, n: int64) -> int64 {
  var s: int64 = 0;
  var i: int64 = 0;
  while (i < n) { s = s + (int64)a[i]; i = i + 1; }
  return s;
}

// ---- int64-elements: use int32 arrays if the values fit -------------------
fn i64_before(a: int64*, n: int64) -> int64 {
  var s: int64 = 0;
  var i: int64 = 0;
  while (i < n) { s = s + a[i]; i = i + 1; }
  return s;
}
fn i64_after(a: int32*, n: int64) -> int64 {
  var s: int64 = 0;
  var i: int64 = 0;
  while (i < n) { s = s + (int64)a[i]; i = i + 1; }
  return s;
}

// ---- dot-shape-address: hoist the index math into a pointer ---------------
fn dot_before(m: float32*, v: float32*, r: int64, cols: int64) -> float32 {
  var s: float32 = 0.0;
  var c: int64 = 0;
  while (c < cols) { s = s + m[r * cols + c] * v[c]; c = c + 1; }
  return s;
}
fn dot_after(m: float32*, v: float32*, r: int64, cols: int64) -> float32 {
  var s: float32 = 0.0;
  var c: int64 = 0;
  var row: float32* = &m[r * cols];
  while (c < cols) { s = s + row[c] * v[c]; c = c + 1; }
  return s;
}

// ---- extremum-shape: widen the ARRAY, not the accumulator -----------------
fn extremum_before(a: uint8*, n: int64) -> uint8 {
  var m: uint8 = 0;
  var i: int64 = 0;
  while (i < n) { if (a[i] > m) { m = a[i]; } i = i + 1; }
  return m;
}
fn extremum_after(a: int32*, n: int64) -> int32 {
  var m: int32 = 0;
  var i: int64 = 0;
  while (i < n) { if (a[i] > m) { m = a[i]; } i = i + 1; }
  return m;
}

// ---- predicated-count: add the comparison, do not branch on it ------------
fn count_before(a: int32*, n: int64) -> int32 {
  var c: int32 = 0;
  var i: int64 = 0;
  while (i < n) { if ((a[i] & 6) != 0) { c = c + 1; } i = i + 1; }
  return c;
}
fn count_after(a: int32*, n: int64) -> int32 {
  var c: int32 = 0;
  var i: int64 = 0;
  while (i < n) { c = c + ((a[i] & 6) != 0); i = i + 1; }
  return c;
}

// ---- unbounded-shift: mask the value down to the bits the shift needs -----
fn shift_before(a: int32*, b: int32*, n: int64) -> int32 {
  var i: int64 = 0;
  while (i < n) { b[i] = (a[i] * 77) >> 8; i = i + 1; }
  return 0;
}
fn shift_after(a: int32*, b: int32*, n: int64) -> int32 {
  var i: int64 = 0;
  while (i < n) { b[i] = ((a[i] * 77) & 65535) >> 8; i = i + 1; }
  return 0;
}

// ---- store-only-fill: one loop per destination ----------------------------
fn fill_before(p: int32*, q: int32*, n: int64) -> int32 {
  var i: int64 = 0;
  while (i < n) { p[i] = 1; q[i] = 2; i = i + 1; }
  return 0;
}
fn fill_after(p: int32*, q: int32*, n: int64) -> int32 {
  var i: int64 = 0;
  while (i < n) { p[i] = 1; i = i + 1; }
  var j: int64 = 0;
  while (j < n) { q[j] = 2; j = j + 1; }
  return 0;
}

// ---- early-exit: split the per-iteration work out of the search -----------
fn search_before(a: int32*, n: int64, key: int32) -> int64 {
  var t: int32 = 0;
  var i: int64 = 0;
  while (i < n) { t = t + a[i]; if (a[i] == key) { return i; } i = i + 1; }
  return -1;
}
fn search_after(a: int32*, n: int64, key: int32) -> int64 {
  var i: int64 = 0;
  while (i < n) { if (a[i] == key) { return i; } i = i + 1; }
  return -1;
}

// ---- the worked examples `mettle explain` prints --------------------------
// Same rule as above: an example that claims a loop vectorizes has to.
// Regression: `mettle explain unbounded-shift` offered the refused loop as
// its example of one that works, and prescribed a masking rewrite it wrote
// with a uint8 destination, which cannot vectorize whatever the shift does.
fn explainshift_before(r: int32*, g: int32*, b: int32*, dst: int32*, n: int64) -> int32 {
  var i: int64 = 0;
  while (i < n) { dst[i] = (r[i]*77 + g[i]*150 + b[i]*29) >> 8; i = i + 1; }
  return 0;
}
fn explainshift_after(r: int32*, g: int32*, b: int32*, dst: int32*, n: int64) -> int32 {
  var i: int64 = 0;
  while (i < n) { dst[i] = ((r[i]*77 + g[i]*150 + b[i]*29) & 65535) >> 8; i = i + 1; }
  return 0;
}

// `mettle explain variable-shift`: a constant distance vectorizes.
fn explainvshift_before(a: int32*, b: int32*, n: int64, k: int32) -> int32 {
  var i: int64 = 0;
  while (i < n) { b[i] = a[i] >> k; i = i + 1; }
  return 0;
}
fn explainvshift_after(a: int32*, b: int32*, n: int64) -> int32 {
  var i: int64 = 0;
  while (i < n) { b[i] = a[i] >> 8; i = i + 1; }
  return 0;
}

// ---- call-in-body: remove the @noinline that blocks the callee -----------
// Regression: the simulation proved this fix and the result was thrown away.
// The success guard tested for a surviving label carrying a loop's name, and
// `while` leaves `ir_while_end_N` behind after it collapses, so every proven
// fix here read as disproven and the reader was told inlining was not the
// blocker.
@noinline fn scale_before(x: int32) -> int32 { return x * 3; }
fn noinline_before(a: int32*, n: int64) -> int32 {
  var s: int32 = 0;
  var i: int64 = 0;
  while (i < n) { s = s + scale_before(a[i]); i = i + 1; }
  return s;
}
fn scale_after(x: int32) -> int32 { return x * 3; }
fn noinline_after(a: int32*, n: int64) -> int32 {
  var s: int32 = 0;
  var i: int64 = 0;
  while (i < n) { s = s + scale_after(a[i]); i = i + 1; }
  return s;
}

fn main() -> int32 { return 0; }
