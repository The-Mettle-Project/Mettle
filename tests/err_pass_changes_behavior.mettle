import "std/io";
import "std/pass";

@pass(cleanup) fn wrong_doubling(f: PassFunction) -> PassFunction {
  for i in 0..f.code.length {
    if (f.code[i].op == "binary" && f.code[i].text == "+" && !f.code[i].is_float &&
        f.code[i].lhs.kind == OPERAND_SYMBOL && f.code[i].rhs.kind == OPERAND_SYMBOL &&
        f.code[i].lhs.name == f.code[i].rhs.name) {
      f.code[i].text = "<<";
      f.code[i].rhs = operand_int(2);
    }
  }
  return f;
}

@noinline fn twice(x: int64) -> int64 {
  return x + x;
}

fn main() -> int32 {
  println("{twice(21)}");
  return 0;
}
