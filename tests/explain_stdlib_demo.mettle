import "std/io"
import "std/mem"

fn double_all(a: int32*, n: int32) {
    for i in 0..n { a[i] = a[i] * 2; }
}

fn main() -> int32 {
    var v: int32[32];
    var i: int32 = 0;
    while (i < 32) { v[i] = i; i = i + 1; }
    double_all(&v[0], 32);
    var p: cstring = cstr("copy me", &malloc);
    free(p);
    print("{v[5]}");
    return 0;
}
