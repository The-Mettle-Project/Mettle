// GetCurrentThreadId is the same on every call in a thread, differs between
// threads, and is cheap (the runtime keeps it after the first call).
import "std/thread";

extern fn tc_clock_gettime(id: int32, ts: int64*) -> int32 = "clock_gettime";

fn now_ns() -> int64 {
  var ts: int64[2];
  tc_clock_gettime(1, &ts[0]);
  return ts[0] * 1000000000 + ts[1];
}

var g_other: uint32 = 0;

fn other(arg: cstring) -> uint32 {
  var a: uint32 = GetCurrentThreadId();
  if (GetCurrentThreadId() != a) { a = (uint32)0; }
  g_other = a;
  return (uint32)0;
}

fn main() -> int32 {
  var me: uint32 = GetCurrentThreadId();
  if (me == (uint32)0) { return 1; }
  var tid: uint32 = 0;
  var t: int64 = CreateThread((cstring)0, (uint64)0, &other, (cstring)0, (uint32)0, &tid);
  thread_join_infinite(t);
  if (g_other == (uint32)0 || g_other == me) { return 2; }
  var t0: int64 = now_ns();
  var sum: uint64 = 0;
  for i in 0..1000000 { sum = sum + (uint64)GetCurrentThreadId(); }
  var per_call: int64 = (now_ns() - t0) / 1000000;
  if (sum != (uint64)me * (uint64)1000000) { return 3; }
  // A system call takes about 100 ns or more; a cached read a few ns.
  if (per_call > 40) { return 4; }
  return 0;
}
