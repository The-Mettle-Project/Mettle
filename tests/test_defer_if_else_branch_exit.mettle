import "std/io";

fn then_defer() { puts("THEN_DEFER\n"); }
fn else_defer() { puts("ELSE_DEFER\n"); }
fn then_body() { puts("THEN_BODY\n"); }
fn else_body() { puts("ELSE_BODY\n"); }
fn after_if() { puts("AFTER_IF\n"); }

fn main() -> int32 {
  if (1) {
    defer then_defer();
    then_body();
  } else {
    defer else_defer();
    else_body();
  }

  after_if();
  return 0;
}
