import "std/io";
import "std/layout";

@soa struct Particle {
  x: float32;
  id: int64;
  alive: bool;
  y: float32;
}

@hot_cold(x, flags) struct Entity {
  name: int64[4];
  x: int32;
  flags: uint8;
  history: int64[8];
}

@compact struct Loose {
  a: uint8;
  b: int64;
  c: uint8;
  d: int32;
}

struct Holder {
  before: int32;
  ps: Particle[3];
  after: int32;
}

fn check(name: string, got: int64, want: int64) -> int32 {
  if (got != want) {
    println("{name}: got {got}, want {want}");
    return 1;
  }
  return 0;
}

fn fill(ps: Particle[]) {
  for i in 0..ps.length {
    ps[i].x = (float32)i * 2.0;
    ps[i].y = (float32)i * 3.0;
    ps[i].id = i * 100;
    ps[i].alive = i % 2 == 0;
  }
}

fn total_ids(ps: Particle[]) -> int64 {
  var sum: int64 = 0;
  for i in 0..ps.length {
    sum = sum + ps[i].id;
    if (ps[i].alive) { sum = sum + 1; }
    sum = sum + (int64)ps[i].y;
  }
  return sum;
}

fn by_value(p: Particle) -> int64 {
  return p.id + (int64)p.x;
}

fn main() -> int32 {
  var bad: int32 = 0;

  bad = bad + check("sizeof lone", sizeof(Particle), 24);
  bad = bad + check("sizeof array", sizeof(Particle[5]), 5 * 8 + 5 * 4 + 5 * 4 + 5 + 3);
  bad = bad + check("sizeof compact", sizeof(Loose), 16);

  var fixed: Particle[5];
  fill(fixed);
  bad = bad + check("slice over array", total_ids(fixed),
                    0 + 100 + 200 + 300 + 400 + 3 + 0 + 3 + 6 + 9 + 12);

  var heap: Particle[] = new Particle[7];
  fill(heap);
  bad = bad + check("new slice", heap[6].id, 600);
  bad = bad + check("new slice last column", heap[6].alive == true, 1);
  bad = bad + check("new slice y", (int64)heap[5].y, 15);

  var lone: Particle = fixed[2];
  bad = bad + check("load whole", lone.id, 200);
  bad = bad + check("load whole y", (int64)lone.y, 6);
  bad = bad + check("by value", by_value(fixed[3]), 306);

  lone.id = 999;
  fixed[0] = lone;
  bad = bad + check("store whole", fixed[0].id, 999);
  bad = bad + check("store whole keeps neighbour", fixed[1].id, 100);
  fixed[4] = fixed[0];
  bad = bad + check("element to element", fixed[4].id, 999);

  var column: int64* = &fixed[3].id;
  *column = 77;
  bad = bad + check("pointer into a column", fixed[3].id, 77);

  var p: Particle* = &lone;
  p.id = 5;
  bad = bad + check("through a thin pointer", lone.id, 5);

  var h: Holder;
  h.before = 11;
  h.after = 22;
  h.ps[2].id = 33;
  h.ps[0].id = 44;
  bad = bad + check("in a struct", h.ps[2].id, 33);
  bad = bad + check("struct field before", (int64)h.before, 11);
  bad = bad + check("struct field after", (int64)h.after, 22);
  bad = bad + check("sizeof holder fits", sizeof(Holder) >= sizeof(Particle[3]) + 8, 1);

  var es: Entity[4];
  es[3].x = 9;
  es[3].flags = 200;
  es[3].history[7] = 1234;
  es[3].name[1] = 55;
  bad = bad + check("hot", (int64)es[3].x, 9);
  bad = bad + check("hot flags", (int64)es[3].flags, 200);
  bad = bad + check("cold", es[3].history[7], 1234);
  bad = bad + check("cold name", es[3].name[1], 55);

  var l: Loose;
  l.a = 1;
  l.b = 2;
  l.c = 3;
  l.d = 4;
  var other: Loose = l;
  bad = bad + check("compact", other.b + (int64)other.d + (int64)other.a + (int64)other.c, 10);

  var literal: Loose = { a: 7, b: 8, c: 9, d: 10 };
  bad = bad + check("compact literal", literal.b + (int64)literal.d, 18);

  if (bad == 0) { println("ok"); }
  return bad;
}
