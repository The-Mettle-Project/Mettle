// Every in-place SIMD kernel at every length from 1 to 40.
//
// The vectorized SiLU and exp both handled a non-multiple-of-8 count by
// clamping the pointer back so the final vector OVERLAPPED elements already
// processed, which applies the kernel twice to an in-place map. The existing
// vectorizer tests all use round lengths, so nothing exercised the tail. This
// checks the whole family one dimension off, and also that nothing past the
// count is touched.

extern fn expf(x: float32) -> float32;

fn vscale_i32(a: int32*, n: int32) { @simd for i in 0..n { a[i] = a[i] * 3; } }
fn vshift_i32(a: int32*, n: int32) { @simd for i in 0..n { a[i] = a[i] << 1; } }
fn vadd_i32(a: int32*, n: int32) { @simd for i in 0..n { a[i] = a[i] + 7; } }
fn vscale_f64(a: float64*, n: int32) { @simd for i in 0..n { a[i] = a[i] * 3.0; } }
fn vaffine_f64(a: float64*, n: int32) { @simd for i in 0..n { a[i] = a[i] * 2.0 + 1.0; } }
fn vaffine_f32(a: float32*, n: int32) { @simd for i in 0..n { a[i] = a[i] * 2.0 + 1.0; } }
fn vscale_u8(a: uint8*, n: int32) { @simd for i in 0..n { a[i] = (uint8)(a[i] + (uint8)1); } }
fn vfill_i32(a: int32*, n: int32, v: int32) { @simd for i in 0..n { a[i] = v; } }

fn main() -> int32 {
  var guard: int32 = 64;

  for n in 1..41 {
    // int32 scale: each element must be multiplied exactly once.
    var a: int32[64];
    for i in 0..guard { a[i] = 5; }
    vscale_i32(&a[0], n);
    for i in 0..n { if (a[i] != 15) { return 1; } }
    for i in n..guard { if (a[i] != 5) { return 2; } }

    for i in 0..guard { a[i] = 5; }
    vshift_i32(&a[0], n);
    for i in 0..n { if (a[i] != 10) { return 3; } }
    for i in n..guard { if (a[i] != 5) { return 4; } }

    for i in 0..guard { a[i] = 5; }
    vadd_i32(&a[0], n);
    for i in 0..n { if (a[i] != 12) { return 5; } }
    for i in n..guard { if (a[i] != 5) { return 6; } }

    for i in 0..guard { a[i] = 0; }
    vfill_i32(&a[0], n, 9);
    for i in 0..n { if (a[i] != 9) { return 7; } }
    for i in n..guard { if (a[i] != 0) { return 8; } }

    // float64 scale and affine map.
    var f: float64[64];
    for i in 0..guard { f[i] = 2.0; }
    vscale_f64(&f[0], n);
    for i in 0..n { if (f[i] != 6.0) { return 9; } }
    for i in n..guard { if (f[i] != 2.0) { return 10; } }

    for i in 0..guard { f[i] = 2.0; }
    vaffine_f64(&f[0], n);
    for i in 0..n { if (f[i] != 5.0) { return 11; } }
    for i in n..guard { if (f[i] != 2.0) { return 12; } }

    var g: float32[64];
    for i in 0..guard { g[i] = (float32)2.0; }
    vaffine_f32(&g[0], n);
    for i in 0..n { if (g[i] != (float32)5.0) { return 13; } }
    for i in n..guard { if (g[i] != (float32)2.0) { return 14; } }

    // Byte width, where a lane is 32 wide rather than 8.
    var b: uint8[64];
    for i in 0..guard { b[i] = (uint8)10; }
    vscale_u8(&b[0], n);
    for i in 0..n { if (b[i] != (uint8)11) { return 15; } }
    for i in n..guard { if (b[i] != (uint8)10) { return 16; } }
  }

  return 0;
}
