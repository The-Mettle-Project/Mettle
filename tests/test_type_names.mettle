// `.name` is module-qualified for a user-declared type, because a bare name
// cannot tell two modules' `Point` apart and there are no compile-time string
// operations to recover the module from one. A type declared in the root
// program is qualified by its file stem.
//
// Builtins answer their own spelling, which is already unambiguous.

import "std/io";

struct Point {
  x: int32;
  y: int32;
}

fn main() -> int32 {
  var declared: string = typeof(Point).name;
  var builtin: string = typeof(int32).name;
  var field: string = typeof(Point).fields[1].name;

  // "test_type_names.Point"
  if (declared.length != 21) {
    println(cstr("declared name length wrong"));
    return 1;
  }
  // "int32"
  if (builtin.length != 5) {
    println(cstr("builtin name length wrong"));
    return 2;
  }
  // A field name is bare: it is already unique inside its type, and the
  // module belongs on the owning type's name.
  if (field.length != 1) {
    println(cstr("field name length wrong"));
    return 3;
  }

  print(cstr("declared="));
  println(declared);
  print(cstr("builtin="));
  println(builtin);
  print(cstr("field="));
  println(field);
  return 0;
}
