import "std/io";
@noinline fn sh(a: uint64, n: int32) -> uint64 { return a << (uint64)n; }
@noinline fn sr(a: uint64, n: int32) -> uint64 { return a >> (uint64)n; }
@noinline fn sa(a: int64, n: int32) -> int64 { return a >> (int64)n; }
@noinline fn s32(a: int32, n: int32) -> int32 { return a << n; }
@noinline fn r32(a: uint32, n: uint32) -> uint32 { return a >> n; }
@noinline fn selfs(a: int64) -> int64 { return a << a; }
@noinline fn mix(a: uint64, b: uint64, n: uint64) -> uint64 { var x: uint64 = a << n; var y: uint64 = b >> n; return x | y | (n << n); }
@noinline fn mask(a: int64) -> int32 { if ((a & 128) != 0) { return 1; } if ((a & 1) == 0) { return 2; } return 3; }
@noinline fn big(a: int64) -> int32 { if ((a & 0x7FFFFFFF) != 0) { return 1; } if ((a & 0x100000000) != 0) { return 2; } return 3; }
fn main() -> int32 {
  println("{sh(3, 4)} {sr(48, 4)} {sa(-48, 4)} {s32(3, 4)} {r32(48, 4)} {selfs(3)} {mix(1, 256, 4)}");
  println("{mask(128)} {mask(2)} {mask(1)} {big(5)} {big(0x100000000)} {big(0x80000000)}");
  return 0;
}
