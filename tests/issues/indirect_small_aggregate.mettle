import "std/io";

enum Msg { Add(int32), Reset }
enum FMsg { F(float32), None }
struct St { n: int32; }
struct B1 { a: int8; }
struct B2 { a: int8; b: int8; }
struct B3 { a: int8; b: int8; c: int8; }
struct I2 { x: int32; y: int32; }
struct F1 { x: float64; }
struct F2 { x: float32; y: float32; }
struct D2 { x: float64; y: float64; }
struct Mix { x: float64; n: int32; }
struct Big { a: int64; b: int64; c: int64; }

fn handle(st: St*, m: Msg) -> int32 {
  return match (m) { case Add(v): v, default: st->n };
}
fn fhandle(m: FMsg) -> float32 {
  return match (m) { case F(v): v, default: (float32)0.0 };
}
fn b1(v: B1, k: int32) -> int32 { return (int32)v.a + k; }
fn b2(k: int32, v: B2) -> int32 { return (int32)v.a + (int32)v.b + k; }
fn b3(v: B3) -> int32 { return (int32)v.a + (int32)v.b + (int32)v.c; }
fn i2(v: I2, w: I2) -> int32 { return v.x + v.y * 10 + w.x * 100 + w.y * 1000; }
fn f1(v: F1) -> float64 { return v.x * 2.0; }
fn f2(v: F2) -> float64 { return (float64)v.x + (float64)v.y; }
fn d2(v: D2, k: int32) -> float64 { return v.x + v.y + (float64)k; }
fn mix(v: Mix) -> float64 { return v.x + (float64)v.n; }
fn big(k: int32, v: Big) -> int64 { return v.a + v.b + v.c + (int64)k; }
fn ret2(v: I2) -> I2 { var r: I2; r.x = v.y; r.y = v.x; return r; }
fn retf(v: F2) -> F2 { var r: F2; r.x = v.y; r.y = v.x; return r; }

fn through(g: fn(St*, Msg) -> int32, st: St*, m: Msg) -> int32 { return g(st, m); }

fn main() -> int32 {
  var st: St;
  st.n = 40;
  var g: fn(St*, Msg) -> int32 = &handle;
  var m: Msg = Add(6);
  var r: Msg = Reset;
  println("{g(&st, m)} {g(&st, r)} {through(g, &st, m)}");
  var fg: fn(FMsg) -> float32 = &fhandle;
  var fm: FMsg = F((float32)2.5);
  println("{fg(fm)}");
  var a1: B1; a1.a = (int8)5;
  var a2: B2; a2.a = (int8)6; a2.b = (int8)7;
  var a3: B3; a3.a = (int8)1; a3.b = (int8)2; a3.c = (int8)3;
  var g1: fn(B1, int32) -> int32 = &b1;
  var g2: fn(int32, B2) -> int32 = &b2;
  var g3: fn(B3) -> int32 = &b3;
  println("{g1(a1, 1)} {g2(1, a2)} {g3(a3)}");
  var p: I2; p.x = 1; p.y = 2;
  var q: I2; q.x = 3; q.y = 4;
  var gi: fn(I2, I2) -> int32 = &i2;
  println("{gi(p, q)}");
  var v1: F1; v1.x = 1.5;
  var v2: F2; v2.x = (float32)1.5; v2.y = (float32)2.5;
  var v3: D2; v3.x = 1.25; v3.y = 2.25;
  var v4: Mix; v4.x = 0.5; v4.n = 3;
  var gf1: fn(F1) -> float64 = &f1;
  var gf2: fn(F2) -> float64 = &f2;
  var gd2: fn(D2, int32) -> float64 = &d2;
  var gmix: fn(Mix) -> float64 = &mix;
  println("{gf1(v1)} {gf2(v2)} {gd2(v3, 1)} {gmix(v4)}");
  var bg: Big; bg.a = 1; bg.b = 2; bg.c = 3;
  var gbig: fn(int32, Big) -> int64 = &big;
  println("{gbig(4, bg)}");
  var gr: fn(I2) -> I2 = &ret2;
  var gq: fn(F2) -> F2 = &retf;
  var rr: I2 = gr(p);
  var rf: F2 = gq(v2);
  println("{rr.x} {rr.y} {rf.x} {rf.y}");
  var c: Fn(I2) -> int32 = fn(v: I2) -> int32 { return v.x + v.y + st.n; };
  println("{c(p)}");
  return 0;
}
