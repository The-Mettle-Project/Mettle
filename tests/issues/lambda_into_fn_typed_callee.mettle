import "std/io";
struct Holder { f: Fn(Fn(int64) -> int64) -> int64; }
struct Maker { base: int64; }
fn Maker_get(m: Maker) -> Fn(Fn(int64) -> int64) -> int64 { return fn(h: Fn(int64) -> int64) -> int64 { return h(20); }; }
fn getf() -> Fn(Fn(int64) -> int64) -> int64 { return fn(h: Fn(int64) -> int64) -> int64 { return h(10); }; }
fn twice(f: Fn(Fn(int64) -> int64) -> int64) -> int64 { return f(fn(z: int64) -> int64 { return z + 1; }) * 2; }
fn main() -> int32 {
  var k: int64 = 5;
  var g: Fn(Fn(int64) -> int64) -> int64 = fn(h: Fn(int64) -> int64) -> int64 { return h(20); };
  var hs: Holder[2];
  hs[1].f = fn(h: Fn(int64) -> int64) -> int64 { return h(3) + k; };
  var hp: Holder* = &hs[1];
  var m: Maker; m.base = 1;
  println("{g(fn(z: int64) -> int64 { return z + 1; })} {twice(g)} {hs[1].f(fn(z: int64) -> int64 { return z * 7; })}");
  println("{hp->f(fn(z: int64) -> int64 { return z * 6; })} {getf()(fn(z: int64) -> int64 { return z + 2; })} {m.get()(fn(z: int64) -> int64 { return z - 2; })}");
  return 0;
}
