import "std/io";
var seen: int64 = 0;
@noinline fn cmp(a: cstring, b: cstring, len: int64) -> int64 {
  var i: int64 = 0;
  while (i < len) {
    var av_i: int32 = (int32)a[i];
    var av: uint8 = (uint8)av_i;
    var bv_i: int32 = (int32)b[i];
    var bv: uint8 = (uint8)bv_i;
    if (av != bv) {
      return (int64)av - (int64)bv;
    }
    i = i + 1;
  }
  return 0;
}
@noinline fn cmp_count(a: cstring, b: cstring, len: int64) -> int64 {
  var i: int64 = 0;
  while (i < len) {
    var av_i: int32 = (int32)a[i];
    var av: uint8 = (uint8)av_i;
    var bv_i: int32 = (int32)b[i];
    var bv: uint8 = (uint8)bv_i;
    seen = seen + 1;
    if (av != bv) {
      return (int64)av - (int64)bv;
    }
    i = i + 1;
  }
  return 0;
}
@noinline fn cmp_rev(a: cstring, b: cstring, len: int64) -> int64 {
  var i: int64 = 0;
  while (i < len) {
    var av_i: int32 = (int32)a[i];
    var av: uint8 = (uint8)av_i;
    var bv_i: int32 = (int32)b[i];
    var bv: uint8 = (uint8)bv_i;
    if (av != bv) {
      return (int64)av - (int64)bv;
    }
    i = i + 2;
  }
  return 0;
}
fn main() -> int32 {
  println("{cmp("apple", "apricot", 5)} {cmp("zz", "za", 2)} {cmp("same", "same", 4)} {cmp_count("abcd", "abzz", 4)} {seen} {cmp_rev("axcx", "aycy", 4)}");
  return 0;
}
