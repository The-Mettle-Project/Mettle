import "std/io";
import "std/mem";
const BITS: int32 = 12;
var g_hold: int64 = 5;
fn sum(p: uint8*, n: int64) -> int64 { var t: int64 = 0; for i in 0..n { t = t * 3 + (int64)p[i]; } return t; }
@noinline fn fill_each(p: uint8*) {
  memset(p, 7, 1); memset(p + 1, 9, 2); memset(p + 3, 11, 3); memset(p + 6, 13, 5); memset(p + 11, 15, 7);
  memset(p + 18, 17, 8); memset(p + 26, 19, 15); memset(p + 41, 21, 16); memset(p + 57, 200, 31); memset(p + 88, 255, 128);
}
@noinline fn copy_each(d: uint8*, s: uint8*) {
  memcpy(d, s, 1); memcpy(d + 1, s + 1, 2); memcpy(d + 3, s + 3, 3); memcpy(d + 6, s + 6, 5); memcpy(d + 11, s + 11, 7);
  memcpy(d + 18, s + 18, 8); memcpy(d + 26, s + 26, 15); memcpy(d + 41, s + 41, 16); memcpy(d + 57, s + 57, 31); memcpy(d + 88, s + 88, 128);
  memcpy(d + 216, s + 216, 129);
}
@noinline fn shift_const(x: uint64, y: uint32, z: int32) -> int64 {
  return (int64)(x >> (uint64)(64 - BITS)) + (int64)(y >> (uint32)(32 - BITS)) + (int64)(z >> (32 - BITS)) + (int64)(x << (uint64)BITS);
}
@noinline fn alias_global() -> int64 {
  var p: uint8* = (uint8*)&g_hold;
  g_hold = 1;
  memset(p, 0, 8);
  var a: int64 = g_hold;
  g_hold = 3;
  memcpy(p, (uint8*)&a, 8);
  return g_hold + a;
}
fn main() -> int32 {
  var a: uint8* = (uint8*)calloc(400, 1);
  var b: uint8* = (uint8*)calloc(400, 1);
  fill_each(a);
  for i in 216..345 { a[i] = (uint8)(i * 3); }
  println("{sum(a, 400)}");
  copy_each(b, a);
  println("{sum(b, 400)}");
  println("{(int32)(int8)((uint8)200)} {(int64)(uint32)-1} {(uint8)300} {(int16)70000} {(uint64)-1 > (uint64)1}");
  println("{shift_const(0xFFFFFFFFFFFFFFFF, 0xFFFFFFFF, -4096)}");
  println("{alias_global()}");
  return 0;
}
