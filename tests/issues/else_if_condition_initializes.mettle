import "std/io";

fn pick(a: int32, b: int32) -> int32 {
  var x: int32;
  if (a == 0) {
    return 1;
  } else if ({ x = b; x } == 0) {
    return x + 2;
  } else {
    return x + 3;
  }
}

fn fall(b: int32) -> int32 {
  var y: int32;
  if (b > 100) {
    return 0;
  } else if ({ y = b * 2; y } > 50) {
    return 1;
  }
  return y;
}

fn main() -> int32 {
  println("{pick(1, 4)} {pick(1, 0)} {fall(7)}");
  return 0;
}
