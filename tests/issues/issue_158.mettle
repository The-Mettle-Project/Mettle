import "std/io";

struct Node { next: Node*; v: int64; }

var g_calls: int64 = 0;

fn len(n: Node*, stop: Node*) -> int64 {
  var c: int64 = 0;
  while (n != stop) { c = c + n->v; n = n->next; }
  return c;
}

@noinline fn len_far(n: int64, m: int64) -> int64 {
  g_calls = g_calls + 1;
  return n * 10 + m;
}

@inline fn len_near(n: int64, m: int64) -> int64 {
  return n * 10 + m;
}

fn width(a: string, b: string) -> int64 {
  return (int64)a.length * 100 + (int64)b.length;
}

fn main() -> int32 {
  var c: Node;
  c.next = (Node*)0;
  c.v = 4;
  var b: Node;
  b.next = &c;
  b.v = 2;
  var a: Node;
  a.next = &b;
  a.v = 1;
  println("{len(&a, &b)} {len(&a, &c)} {len(&a, (Node*)0)}");
  var n: int64 = 3;
  var m: int64 = 4;
  var x: int64 = 5;
  println("{len_far(n, m)} {len_far(n, x)} {len_far(n, m)} {g_calls}");
  println("{len_near(n, m)} {len_near(n, x)}");
  var s: string = "ab";
  var t: string = "cde";
  println("{width(s, t)} {width(s, s)} {width(t, s)}");
  return 0;
}
