import "std/io";
@noinline fn neg32() -> int32 { return -1; }
@noinline fn neg64() -> int64 { return -1; }
@noinline fn neg8() -> int8 { return (int8)-1; }
@noinline fn u8v() -> uint8 { return (uint8)3; }
@noinline fn u16v() -> uint16 { return (uint16)3; }
@noinline fn u32v() -> uint32 { return (uint32)3; }
@noinline fn u32big() -> uint32 { return (uint32)4000000000; }
fn main() -> int32 {
  var a: int32 = neg32();
  var b: int64 = neg64();
  var c: int8 = neg8();
  var x: uint8 = u8v();
  var y: uint16 = u16v();
  var z: uint32 = u32v();
  var w: uint32 = u32big();
  println("{a < x} {a < y} {b < x} {b < y} {b < z} {b < w} {c < (int8)0}");
  println("{x > a} {y > a} {x > b} {z > b} {w > b} {w > (int64)2} {b == (int64)w}");
  println("{(int64)w < b} {b > w} {b >= w} {b <= w} {a == x} {b != z}");
  var g: int64 = 5000000000;
  println("{g > w} {w < g} {g > z} {z > g}");
  return 0;
}
