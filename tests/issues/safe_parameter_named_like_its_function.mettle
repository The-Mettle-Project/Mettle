import "std/io";

fn length_of(s: string) -> int64 {
  var total: int64 = 0;
  for i in 0..s.length {
    total = total + (int64)s[i];
  }
  return total;
}

fn count(count: int32, s: string) -> int64 {
  return (int64)count + length_of(s);
}

fn size(s: string) -> int64 {
  var size: int64 = length_of(s);
  size = size + 1;
  return size;
}

fn main() -> int32 {
  println("{count(25, "xyz")} {size("ab")}");
  return 0;
}
