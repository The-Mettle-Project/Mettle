import "std/io";
import "std/mem";

fn churn_strings(rounds: int64) -> int64 {
  var total: int64 = 0;
  for i in 0..rounds {
    var s: string = "k{i}";
    s = s + "-" + s;
    total = total + (int64)s.length;
  }
  return total;
}

fn churn_blocks(rounds: int64) -> int64 {
  var total: int64 = 0;
  for i in 0..rounds {
    var p: int64* = (int64*)malloc(16);
    p[0] = i;
    total = total + p[0];
    free((rawptr)p);
  }
  return total;
}

@test fn recycles_freed_strings() -> int32 {
  if (churn_strings(100000) != 1277780) { return 1; }
  return 0;
}

@test fn recycles_freed_blocks() -> int32 {
  if (churn_blocks(70000) != 2449965000) { return 1; }
  return 0;
}

fn main() -> int32 {
  println("{churn_strings(100000)} {churn_blocks(70000)}");
  return 0;
}
