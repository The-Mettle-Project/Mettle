import "std/io";
@noinline fn wc_comma(buf: cstring, len: int64) -> int64 {
  var count: int64 = 0;
  var i: int64 = 0;
  var in_word: int32 = 0;
  while (i < len) {
    var c: uint8 = (uint8)buf[i];
    if (c == 32 || c == 9 || c == 10 || c == 13 || c == 44) {
      in_word = 0;
    } else {
      if (in_word == 0) {
        count = count + 1;
      }
      in_word = 1;
    }
    i = i + 1;
  }
  return count;
}
@noinline fn wc_sum(buf: cstring, len: int64) -> int64 {
  var count: int64 = 0;
  var i: int64 = 0;
  var in_word: int32 = 0;
  var spaces: int64 = 0;
  while (i < len) {
    var c: uint8 = (uint8)buf[i];
    if (c == 32 || c == 9 || c == 10 || c == 13) {
      in_word = 0;
      spaces = spaces + 1;
    } else {
      if (in_word == 0) {
        count = count + 1;
      }
      in_word = 1;
    }
    i = i + 1;
  }
  return count * 1000 + spaces;
}
@noinline fn wc_double(buf: cstring, len: int64) -> int64 {
  var count: int64 = 0;
  var i: int64 = 0;
  var in_word: int32 = 0;
  while (i < len) {
    var c: uint8 = (uint8)buf[i];
    if (c == 32 || c == 9 || c == 10 || c == 13) {
      in_word = 0;
    } else {
      if (in_word == 0) {
        count = count + 1;
      }
      in_word = 0;
    }
    i = i + 1;
  }
  return count;
}
@noinline fn wc_plain(buf: cstring, len: int64) -> int64 {
  var count: int64 = 0;
  var i: int64 = 0;
  var in_word: int32 = 0;
  while (i < len) {
    var c: uint8 = (uint8)buf[i];
    if (c == 32 || c == 9 || c == 10 || c == 13) {
      in_word = 0;
    } else {
      if (in_word == 0) {
        count = count + 1;
      }
      in_word = 1;
    }
    i = i + 1;
  }
  return count;
}
fn main() -> int32 {
  var s: cstring = "ab,cd ef\tgh,,ij\nk  lm\r\nno,p";
  var n: int64 = 27;
  println("{wc_comma(s, n)} {wc_sum(s, n)} {wc_double(s, n)} {wc_plain(s, n)}");
  return 0;
}
