import "std/io";
fn mul(a: int64, b: int64) -> int64 { return a * b; }
fn main(argc: int32, argv: cstring*) -> int32 {
  println("{mul(0, 5)} {mul(5, 0)} {mul(-1, 5)} {mul(5, -1)} {mul(3037000499, 3037000499)} {mul(-1, -9223372036854775807)}");
  var low: int64 = -9223372036854775807 - 1;
  println("{mul(1, low)} {mul(low, 1)} {mul(0, low)}");
  if (argc == 1) { println("{mul(-1, low)}"); }
  println("{mul(low, -1)}");
  return 0;
}
