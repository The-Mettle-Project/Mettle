import "std/io";

@noinline fn steps(start: int32) -> int64 {
  var x: int32 = start;
  var n: int64 = 0;
  while (x > 1) {
    if (x % 2 == 0) {
      x = x / 2;
    } else {
      x = 3 * x + 1;
    }
    n = n + 1;
  }
  return n * 100000 + (int64)x;
}

@noinline fn longest(limit: int64) -> int64 {
  var best: int64 = 0;
  var best_start: int64 = 0;
  var s: int64 = 1;
  while (s < limit) {
    var x: int64 = s;
    var n: int64 = 0;
    while (x > 1) {
      if (x % 2 == 0) {
        x = x >> 1;
      } else {
        x = 3 * x + 1;
      }
      n = n + 1;
    }
    if (n > best) {
      best = n;
      best_start = s;
    }
    s = s + 1;
  }
  return best_start * 1000 + best;
}

fn main() -> int32 {
  println("{steps(1431655765)} {steps(715827883)} {steps(27)} {longest(10000)}");
  return 0;
}
