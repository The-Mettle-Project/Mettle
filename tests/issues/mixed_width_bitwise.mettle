import "std/io";

var narrow: int32 = 5;

fn show<T>(v: T) -> T { return v; }

fn main() -> int32 {
  var wide: int64 = 4294967296;
  var f: float32 = 0.5;
  var a: int64 = show(narrow ^ wide);
  var b: int64 = show(narrow + wide);
  var c: float32 = show(f + 0.25);
  var d: float64 = show(narrow * 0.5);
  var e: float32 = show(narrow * f);
  var h: int32 = show(narrow | 3);
  var k: int32 = (int32)(if (wide > 0) wide else (narrow | wide));
  println("{a} {b} {c} {d} {e} {h} {k}");
  var crc: uint32 = 77;
  var mask: uint32 = 5;
  crc = (crc >> 1) + (3988292384 + mask);
  var x: uint32 = (crc >> 1) ^ (3988292384 & mask);
  println("{crc} {x}");
  var byte: uint8 = 0xAB;
  var low = byte & 0x0F;
  var hi = 0xF0 & byte;
  var h: int16 = 300;
  println("{low} {hi} {show((h - 100) * (f * byte))} {show((h - 100) * wide)} {show(0xF0 & byte)}");
  return 0;
}
