import "std/io";

fn take(x: uint16) -> int64 { return (int64)x; }

fn check() -> int32 {
  var u: uint16 = 1;
  var s: int16 = -21351;
  var a: uint8 = 200;
  var c: int8 = -3;
  var bad: int32 = 0;
  if ((u ^ s) != 44184) { bad = bad | 1; }
  var w: int64 = (u ^ s);
  if (w != 44184 || take(u ^ s) != 44184) { bad = bad | 2; }
  if ((a ^ c) != 53 || (a | c) != 253 || (a & c) != 200) { bad = bad | 4; }
  var big: uint16 = 65535;
  var neg: int16 = -3;
  if (big / neg != 1 || big % neg != 2) { bad = bad | 8; }
  if (neg / big != 3 || neg % big != 0) { bad = bad | 16; }
  var ui: uint32 = 4000000000;
  var si: int32 = -7;
  if (ui / si != 0 || ui % si != 4000000000 || si / ui != 0 || si % ui != -7) { bad = bad | 32; }
  var low: int16 = -32768;
  if (low / big != -32768) { bad = bad | 64; }
  var small: uint8 = 9;
  var minus: int32 = -3;
  var seven: int16 = -7;
  if (a / minus != -66 || a % minus != 2 || small / seven != -1 || seven / small != 0) { bad = bad | 128; }
  return bad;
}

@test fn mixed_sign_narrow() -> int32 { return check(); }

fn main() -> int32 {
  var u: uint16 = 1;
  var s: int16 = -21351;
  println("{u ^ s} {check()}");
  return 0;
}
