import "std/io";
struct Box<T> { v: T; }
struct Pair<A, B> { a: A; b: B; }
fn Box_get<T>(b: Box<T>) -> T { return b.v; }
fn Pair_first<A, B>(p: Pair<A, B>) -> A { return p.a; }
fn wrap<T>(v: T) -> Box<T> { var b: Box<T>; b.v = v; return b; }
fn mkpair<A, B>(a: A, b: B) -> Pair<A, B> { var p: Pair<A, B>; p.a = a; p.b = b; return p; }
fn main() -> int32 {
  var k: int64 = 3;
  var f: Fn(int64) -> int64 = fn(x: int64) -> int64 { return x * k; };
  var bf: Box<Fn(int64) -> int64> = wrap(f);
  var g: Fn(int64) -> int64 = bf.get();
  var add: Fn(int64, int64) -> int64 = fn(x: int64, y: int64) -> int64 { return x + y * 10; };
  var p: Pair<Fn(int64, int64) -> int64, string> = mkpair(add, "tag");
  var q: Pair<Pair<int64, Fn(int64, int64) -> int64>, int64> = mkpair(mkpair((int64)4, add), (int64)9);
  var h: Fn(int64, int64) -> int64 = p.first();
  var arr: Pair<int64, Fn(int64, int64) -> int64>[2];
  arr[1].b = add;
  println("{g(7)} {bf.v(2)} {h(1, 2)} {p.b} {q.a.b(3, 4)} {q.first().a} {arr[1].b(7, 1)}");
  return 0;
}
