import "std/io";

var a: int64 = 1;
var b: int32 = 2;
var c: uint8 = 3;
var d: float64 = 1.5;
var e: float32 = 2.5;
var f: int16 = -7;
var counter: int64 = 0;
var table: int64 = 100;
var hook: fn(int64) -> int64 = 0;

fn bump() { counter = counter + 1; }
fn set_a(v: int64) { a = v; }
fn read_a() -> int64 { return a; }
@noinline fn set_b(v: int32) { b = v; }
@noinline fn read_b() -> int32 { return b; }
fn twice(x: int64) -> int64 { return x * 2; }
fn through(p: int64*) { *p = *p + 5; }
fn leave() -> int64 {
  bump();
  return counter;
}

fn write_call_read() -> int64 {
  a = 10;
  bump();
  var x: int64 = a;
  set_a(20);
  x = x + a;
  a = a + 1;
  x = x + read_a();
  return x;
}
fn narrow() -> int32 {
  b = 7;
  c = (uint8)250;
  f = (int16)-300;
  bump();
  set_b(b + 1);
  c = (uint8)(c + (uint8)10);
  bump();
  return b + (int32)c + (int32)f + read_b();
}
fn floats() -> float64 {
  d = 2.25;
  e = (float32)1.5;
  bump();
  d = d + (float64)e;
  bump();
  e = e * (float32)2.0;
  return d + (float64)e;
}
fn aliased() -> int64 {
  table = 1;
  through(&table);
  var p: int64* = &table;
  *p = *p + 1;
  bump();
  table = table * 2;
  bump();
  return *p + table;
}
fn indirect() -> int64 {
  hook = twice;
  bump();
  var r: int64 = hook(21);
  bump();
  return r;
}
fn in_loop(n: int32) -> int64 {
  var t: int64 = 0;
  counter = 0;
  for i in 0..n {
    bump();
    t = t + counter;
    if (i % 2 == 0) {
      a = (int64)i;
      bump();
    }
    t = t + a;
  }
  return t;
}
fn branchy(k: int32) -> int64 {
  if (k > 0) {
    a = 5;
    bump();
  } else {
    a = 6;
  }
  bump();
  if (a == 5) {
    return a + 100;
  }
  return a + 200;
}
fn call_result_into_global() -> int64 {
  a = twice(4);
  bump();
  b = read_b();
  a = a + twice(a);
  bump();
  return a;
}
fn compare_branch() -> int32 {
  counter = 3;
  bump();
  while (counter < 8) {
    bump();
  }
  if (counter == 8) { return 1; }
  return 0;
}
fn hot_reader(n: int32) -> int64 {
  var t: int64 = 0;
  a = 3;
  for i in 0..n { t = t + a; }
  bump();
  return t + a;
}
fn many() -> int64 {
  a = 1; b = 2; c = (uint8)3; f = (int16)4; table = 5; counter = 6;
  bump();
  a = a + 1; bump(); b = b + 1; bump(); c = (uint8)(c + (uint8)1); bump();
  f = (int16)(f + (int16)1); bump(); table = table + 1; bump();
  return a + (int64)b + (int64)c + (int64)f + table + counter;
}

fn main() -> int32 {
  println("{write_call_read()} {narrow()} {floats()} {aliased()}");
  println("{indirect()} {in_loop(5)} {branchy(1)} {branchy(0)}");
  println("{call_result_into_global()} {compare_branch()} {hot_reader(1000)} {many()}");
  println("{a} {b} {c} {d} {e} {f} {counter} {table} {leave()}");
  return 0;
}
