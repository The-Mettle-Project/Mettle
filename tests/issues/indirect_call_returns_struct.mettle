import "std/io";
struct S { a: int64; b: int64; c: int64; }
fn pass(v: S) -> S { return v; }
fn indirect(f: fn(S) -> S, v: S) -> S { return f(v); }
fn closure(f: Fn(S) -> S, v: S) -> S { return f(v); }
fn local(f: fn(S) -> S, v: S) -> S { var r: S = f(v); return r; }
fn main() -> int32 {
  var s: S = { a: 1, b: 2, c: 3 };
  println("{indirect(pass, s).c} {closure(&pass, s).c} {local(pass, s).b}");
  return 0;
}
