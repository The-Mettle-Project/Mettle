import "std/io";
struct Box<T> { v: T; }
struct Pair<A, B> { a: A; b: B; }
fn Box_get<T>(x: Box<T>) -> T { return x.v; }
fn Pair_first<A, B>(p: Pair<A, B>) -> A { return p.a; }
fn Pair_swap<A, B>(p: Pair<A, B>) -> Pair<B, A> { var q: Pair<B, A>; q.a = p.b; q.b = p.a; return q; }
fn main() -> int32 {
  var inner: Box<int64>;
  inner.v = 7;
  var outer: Box<Box<int64>>;
  outer.v = inner;
  var p: Pair<int64, float64>;
  p.a = 3; p.b = 1.5;
  println("{outer.get().get()} {p.first()} {p.swap().first()} {p.swap().swap().first()}");
  return 0;
}
