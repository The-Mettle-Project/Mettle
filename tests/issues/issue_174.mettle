import "std/io";

struct S { a: int64; b: int64; c: int64; }
struct Small { a: int32; b: int32; }

fn parse(s: string, out: string*, n: int32*) -> int32 { *out = "{s}!"; *n = 1; return 0; }
fn parse2(a: string*, b: string*) { *a = "aa"; *b = "bb"; }
fn make(k: int64) -> S { var r: S; r.a = k; r.b = k + 1; r.c = k + 2; return r; }
fn small(k: int32) -> Small { var r: Small; r.a = k; r.b = k + 1; return r; }
fn text(k: int32) -> string { return "t{k}"; }

fn run(x: string, y: string) -> int32 {
  x = "{x}+";
  y = "lit";
  var s: string;
  var n: int32 = 0;
  parse(x, &s, &n);
  var t: string;
  var u: string;
  parse2(&t, &u);
  y = s;
  println("{x} {y} {s} {t} {u} {n}");
  x = t;
  println("{x}");
  return 0;
}
fn run2(x: string) -> string {
  var s: string;
  parse2(&x, &s);
  return x;
}
fn run3(x: string, y: string) -> string {
  if (x.length > 1) { x = y; }
  var tmp: string;
  parse2(&tmp, &y);
  defer println("bye {y}");
  return "{x}{tmp}";
}
fn from_call(x: string) -> string { x = text(4); return x; }
fn from_literal(x: string) -> int64 { x = ""; return (int64)x.length; }
fn struct_from_call(s: S) -> int64 { s = make(10); return s.a + s.c; }
fn small_from_call(s: Small) -> int32 { s = small(10); return s.a + s.b; }
fn struct_from_literal(s: S) -> int64 { s = { a: 1, b: 2, c: 3 }; return s.b; }
fn in_loop(x: string) -> int64 {
  var t: int64 = 0;
  for i in 0..3 {
    x = "{x}{i}";
    t = t + (int64)x.length;
  }
  return t;
}
fn main() -> int32 {
  var keep: string = "keep";
  var ks: S = make(1);
  run(keep, "b");
  println(run2(keep));
  println(run3("zz", "q"));
  println(from_call(keep));
  println("{from_literal(keep)} {struct_from_call(ks)} {small_from_call(small(1))} {struct_from_literal(ks)} {in_loop("ab")}");
  println("{keep} {ks.a} {ks.c}");
  return 0;
}
