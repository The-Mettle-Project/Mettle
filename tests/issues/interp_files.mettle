import "std/io";
import "std/mem";
import "std/file";
import "std/fs";

fn pattern(p: uint8*, n: int64, seed: int64) {
  for i: int64 in 0..n { p[i] = (uint8)((i * 7 + seed) & 255); }
}

fn scratch() -> bool { return fs_mkdir_all(".tmp/interp_files", 493) == 0; }

fn mismatches(a: uint8*, b: uint8*, n: int64) -> int64 {
  var bad: int64 = 0;
  for i: int64 in 0..n {
    if (a[i] != b[i]) { bad = bad + 1; }
  }
  return bad;
}

@test fn positioned_reads_and_writes() -> int64 {
  assert(scratch());
  fs_remove_all(".tmp/interp_files/a");
  assert_eq(fs_mkdir(".tmp/interp_files/a", 493), 0);
  var fd: int64 = file_open(".tmp/interp_files/a/data.bin", FILE_READ | FILE_WRITE | FILE_CREATE | FILE_TRUNCATE);
  assert(fd >= 0);
  var out: uint8* = (uint8*)malloc(5000);
  var back: uint8* = (uint8*)malloc(5100);
  pattern(out, 5000, 3);
  assert_eq(file_write_at(fd, out, 5000, 0), 5000);
  assert_eq(file_write_at(fd, out, 100, 5000), 100);
  assert_eq(file_size(fd), 5100);
  assert_eq(file_read_at(fd, back, 5100, 0), 5100);
  assert_eq(mismatches(out, back, 5000), 0);
  assert_eq(mismatches(out, back + 5000, 100), 0);
  assert_eq(file_read_at(fd, back, 50, 5080), 20);
  assert_eq(file_truncate(fd, 10), 0);
  assert_eq(file_size(fd), 10);
  assert_eq(file_sync(fd), 0);
  assert_eq(file_close(fd), 0);
  assert(file_open(".tmp/interp_files/a/missing.bin", FILE_READ) < 0);
  free((rawptr)out);
  free((rawptr)back);
  assert_eq(fs_remove_all(".tmp/interp_files/a"), 0);
  assert(!fs_exists(".tmp/interp_files/a"));
  return 0;
}

fn touch(path: string, bytes: int64) -> int64 {
  var fd: int64 = file_open(path, FILE_WRITE | FILE_CREATE | FILE_TRUNCATE);
  if (fd < 0) { return fd; }
  var b: uint8[64];
  pattern(&b[0], 64, bytes);
  var wrote: int64 = file_write_at(fd, &b[0], bytes, 0);
  if (file_close(fd) != 0) { return -1; }
  return wrote;
}

@test fn directories_rename_and_listing() -> int64 {
  assert(scratch());
  fs_remove_all(".tmp/interp_files/b");
  assert_eq(fs_mkdir_all(".tmp/interp_files/b/inner/deep", 493), 0);
  assert(fs_is_dir(".tmp/interp_files/b/inner/deep"));
  assert_eq(touch(".tmp/interp_files/b/one.txt", 11), 11);
  assert_eq(touch(".tmp/interp_files/b/two.txt", 22), 22);
  assert_eq(file_rename(".tmp/interp_files/b/one.txt", ".tmp/interp_files/b/three.txt"), 0);
  assert(!fs_exists(".tmp/interp_files/b/one.txt"));
  assert(fs_is_file(".tmp/interp_files/b/three.txt"));
  var st: FsStat;
  assert_eq(fs_stat(".tmp/interp_files/b/two.txt", &st), 0);
  assert_eq(st.size, 22);
  assert_eq(st.kind, FS_FILE);
  var d: FsDir* = new FsDir;
  var e: FsDirEntry;
  assert_eq(fs_dir_open(".tmp/interp_files/b", d), 0);
  var files: int64 = 0;
  var dirs: int64 = 0;
  var bytes: int64 = 0;
  while (fs_dir_next(d, &e) == 1) {
    if (e.kind == FS_DIR) { dirs = dirs + 1; }
    if (e.kind == FS_FILE) {
      files = files + 1;
      bytes = bytes + (int64)e.name.length;
    }
  }
  assert_eq(fs_dir_close(d), 0);
  free((rawptr)d);
  assert_eq(files, 2);
  assert_eq(dirs, 1);
  assert_eq(bytes, 16);
  assert_eq(file_remove(".tmp/interp_files/b/two.txt"), 0);
  assert(!fs_exists(".tmp/interp_files/b/two.txt"));
  assert_eq(fs_remove_all(".tmp/interp_files/b"), 0);
  assert(!fs_exists(".tmp/interp_files/b"));
  return 0;
}

@test fn mapped_file_round_trip() -> int64 {
  assert(scratch());
  fs_remove_all(".tmp/interp_files/c.bin");
  var fd: int64 = file_open(".tmp/interp_files/c.bin", FILE_READ | FILE_WRITE | FILE_CREATE | FILE_TRUNCATE);
  assert(fd >= 0);
  assert_eq(file_truncate(fd, 70000), 0);
  var src: uint8* = (uint8*)malloc(70000);
  pattern(src, 70000, 9);
  assert_eq(file_write_at(fd, src, 70000, 0), 70000);
  var m: FileMap;
  assert_eq(file_map(fd, 66000, 4000, FILE_MAP_READ | FILE_MAP_WRITE, &m), 0);
  assert_eq(mismatches(m.data, src + 66000, 4000), 0);
  for i: int64 in 0..4000 { m.data[i] = (uint8)(255 - (int64)m.data[i]); }
  assert_eq(file_map_sync(&m), 0);
  assert_eq(file_unmap(&m), 0);
  var back: uint8* = (uint8*)malloc(4000);
  assert_eq(file_read_at(fd, back, 4000, 66000), 4000);
  var bad: int64 = 0;
  for i: int64 in 0..4000 {
    if ((int64)back[i] != 255 - (int64)src[66000 + i]) { bad = bad + 1; }
  }
  assert_eq(bad, 0);
  assert_eq(file_close(fd), 0);
  free((rawptr)src);
  free((rawptr)back);
  assert_eq(file_remove(".tmp/interp_files/c.bin"), 0);
  return 0;
}

@test fn stdio_streams() -> int64 {
  assert(scratch());
  var w: cstring = fopen(".tmp/interp_files/d.txt", "wb");
  assert(w != (cstring)0);
  fputs("first line\n", w);
  fwrite("0123456789", 1, 10, w);
  fclose(w);
  var r: cstring = fopen(".tmp/interp_files/d.txt", "rb");
  assert(r != (cstring)0);
  var line: uint8[64];
  assert(fgets((cstring)&line[0], 64, r) != (cstring)0);
  assert_eq((int64)line[0], 102);
  assert_eq((int64)line[10], 10);
  var rest: uint8[32];
  assert_eq(fread((cstring)&rest[0], 1, 32, r), 10);
  assert_eq((int64)rest[9], 57);
  fclose(r);
  assert(fopen(".tmp/interp_files/missing.txt", "rb") == (cstring)0);
  assert_eq(file_remove(".tmp/interp_files/d.txt"), 0);
  return 0;
}

fn main() -> int32 { return 0; }
