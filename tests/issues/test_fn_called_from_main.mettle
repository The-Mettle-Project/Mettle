import "std/io";

fn square(x: int32) -> int32 { return x * x; }

@test fn checks_square() -> int32 {
  assert(square(7) == 49);
  assert_eq(square(-2), 4);
  if (square(7) != 49) { return 1; }
  return 0;
}

@test fn checks_both() -> int32 {
  return checks_square() + (if (square(-3) == 9) { 0 } else { 1 });
}

@test fn never_called() -> int32 { return 0; }

fn main() -> int32 {
  var runner: fn() -> int32 = &checks_square;
  println("{checks_both()} {runner()}");
  return 0;
}
