import "std/io";

struct Conv { kernel: int32; }

fn kernel_sum(kernel: int32*, n: int64) -> int32 {
  var s: int32 = 0;
  for i: int64 in 0..n { s = s + kernel[i]; }
  return s;
}

fn pick(c: bool, x: int32) -> int32 { return if (c) -x else x; }
fn pick_paren(c: bool, x: int32) -> int32 { return if (c) (x + 1) * 2 else x; }

fn still_a_condition(a: int32, b: int32) -> int32 {
  if (a) - b > 0 { return 1; }
  return 0;
}

fn classify(n: int32) -> int32 {
  switch (n) {
    case 1, 2, 10..12: { return 1; }
    case 3: { return 3; }
    default: { return 0; }
  }
  return -1;
}

fn classify_value(n: int32) -> int32 {
  return switch (n) { case 1, 2: 10, case 5..7, 9: 20, default: 0 };
}

fn main() -> int32 {
  var kernel: int32[3];
  kernel[0] = 1; kernel[1] = 2; kernel[2] = 3;
  var c: Conv = { kernel: 7 };
  println("{kernel_sum(&kernel[0], 3)} {c.kernel}");
  println("{pick(true, 5)} {pick(false, 5)} {pick_paren(true, 5)} {still_a_condition(5, 2)} {still_a_condition(1, 2)}");
  println("{classify(1)} {classify(2)} {classify(11)} {classify(3)} {classify(4)}");
  println("{classify_value(1)} {classify_value(2)} {classify_value(6)} {classify_value(9)} {classify_value(8)}");
  return 0;
}
