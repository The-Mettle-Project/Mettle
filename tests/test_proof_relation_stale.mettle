import "std/io";
import "std/mem";
type Index = int64 where value >= 0 && value < buf.length;

fn get(buf: int32[], other: int32[], i: int64) -> int32 {
  if (i >= 0 && i < buf.length) {
    var at: Index = (Index)i;
    buf = other;
    return buf[(int64)at];
  }
  return 0;
}

fn main() -> int32 {
  var big: int32[] = new int32[100];
  var small: int32[] = new int32[2];
  println("{get(big, small, 50)}");
  return 0;
}
