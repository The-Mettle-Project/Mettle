import "layout"
import "page"

const HEADER_BYTES: uint64 = 32
const ALIGNMENT: uint64 = 16
const SPLIT_THRESHOLD: uint64 = HEADER_BYTES + 64

struct Block {
    size: uint64;
    used: uint64;
    next: uint64;
    span: uint64;
}

var first: uint64 = 0
var claimed: uint64 = 0
var handed_out: uint64 = 0
var live: uint64 = 0

export fn heap_used() -> uint64 {
    return handed_out
}

export fn heap_claimed() -> uint64 {
    return claimed
}

export fn heap_live_blocks() -> uint64 {
    return live
}

export fn heap_largest_request() -> uint64 {
    return page_largest_run() * PAGE_SIZE - HEADER_BYTES
}

fn block_at(address: uint64) -> Block* {
    return (Block*)address
}

fn last_block() -> Block* {
    var walk: uint64 = first
    while (block_at(walk)->next != 0) {
        walk = block_at(walk)->next
    }
    return block_at(walk)
}

fn grow(need: uint64) -> bool {
    var wanted: uint64 = (need + HEADER_BYTES + PAGE_SIZE - 1) / PAGE_SIZE
    if (wanted < 4) {
        wanted = 4
    }
    var run: uint64 = page_alloc_pages(wanted)
    if (run == 0 && wanted > 4) {
        return false
    }
    if (run == 0) {
        wanted = 1
        run = page_alloc_pages(1)
    }
    if (run == 0) {
        return false
    }
    var block: Block* = block_at(run)
    block->size = wanted * PAGE_SIZE - HEADER_BYTES
    block->used = 0
    block->next = 0
    block->span = wanted
    claimed += wanted * PAGE_SIZE
    if (first == 0) {
        first = run
    } else {
        last_block()->next = run
    }
    return true
}

fn split(block: Block*, address: uint64, need: uint64) {
    var rest: uint64 = address + HEADER_BYTES + need
    var tail: Block* = block_at(rest)
    tail->size = block->size - need - HEADER_BYTES
    tail->used = 0
    tail->next = block->next
    tail->span = 0
    block->size = need
    block->next = rest
}

export fn heap_alloc(size: uint64) -> uint64 {
    var need: uint64 = (size + ALIGNMENT - 1) / ALIGNMENT * ALIGNMENT
    if (need == 0) {
        need = ALIGNMENT
    }
    for attempt: uint64 in 0..2 {
        var walk: uint64 = first
        while (walk != 0) {
            var block: Block* = block_at(walk)
            if (block->used == 0 && block->size >= need) {
                if (block->size >= need + SPLIT_THRESHOLD) {
                    split(block, walk, need)
                }
                block->used = 1
                handed_out += block->size
                live++
                return walk + HEADER_BYTES
            }
            walk = block->next
        }
        if (!grow(need)) {
            return 0
        }
    }
    return 0
}

export fn heap_zeroed(size: uint64) -> uint64 {
    var address: uint64 = heap_alloc(size)
    if (address == 0) {
        return 0
    }
    var bytes: uint8* = (uint8*)address
    for i: uint64 in 0..size {
        bytes[i] = 0
    }
    return address
}

fn merge_neighbours() {
    var walk: uint64 = first
    while (walk != 0) {
        var block: Block* = block_at(walk)
        var next: uint64 = block->next
        if (block->used == 0 && next != 0 && block_at(next)->used == 0 &&
            block_at(next)->span == 0 &&
            walk + HEADER_BYTES + block->size == next) {
            block->size += HEADER_BYTES + block_at(next)->size
            block->next = block_at(next)->next
        } else {
            walk = next
        }
    }
}

export fn heap_free(pointer: uint64) {
    if (pointer == 0) {
        return
    }
    var block: Block* = block_at(pointer - HEADER_BYTES)
    if (block->used == 0) {
        return
    }
    block->used = 0
    if (handed_out >= block->size) {
        handed_out -= block->size
    }
    if (live > 0) {
        live--
    }
    merge_neighbours()
}
