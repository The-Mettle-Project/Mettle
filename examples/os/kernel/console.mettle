import "vga"
import "format"

const STREAM_SLOTS: uint64 = 4

struct Stream {
    emit: fn(uint8) -> void;
}

var streams: Stream[4]
var stream_count: uint64 = 0

export fn console_add_stream(emit: fn(uint8) -> void) {
    if (stream_count >= STREAM_SLOTS) {
        return
    }
    streams[stream_count].emit = emit
    stream_count++
}

export fn console_put(ch: uint8) {
    vga_put(ch)
    for i: uint64 in 0..stream_count {
        streams[i].emit(ch)
    }
}

export fn console_write(text: cstring) {
    var i: uint64 = 0
    while (text[i] != 0) {
        console_put(text[i])
        i++
    }
}

export fn console_write_line(text: cstring) {
    console_write(text)
    console_put('\n')
}

export fn console_pad(text: cstring, width: uint64) {
    var written: uint64 = 0
    while (text[written] != 0) {
        console_put(text[written])
        written++
    }
    while (written < width) {
        console_put(' ')
        written++
    }
}

export fn console_write_decimal(value: uint64) {
    var text: uint8[FORMAT_BYTES]
    format_decimal(value, &text[0])
    console_write((cstring)&text[0])
}

export fn console_write_padded(value: uint64, width: uint64) {
    var text: uint8[FORMAT_BYTES]
    format_decimal(value, &text[0])
    console_pad((cstring)&text[0], width)
}

export fn console_write_hex(value: uint64, digits: uint64) {
    var text: uint8[FORMAT_BYTES]
    format_hex(value, digits, &text[0])
    console_write("0x")
    console_write((cstring)&text[0])
}

export fn console_write_hex_byte(value: uint64) {
    var text: uint8[FORMAT_BYTES]
    format_hex_byte(value, &text[0])
    console_write((cstring)&text[0])
}

export fn console_color(value: uint8) {
    vga_set_color(value)
}

export fn console_write_colored(text: cstring, value: uint8) {
    var previous: uint8 = vga_color()
    vga_set_color(value)
    console_write(text)
    vga_set_color(previous)
}

export fn console_clear() {
    vga_clear()
}

export fn console_sync_cursor() {
    vga_sync_cursor()
}
