import "layout"
import "port"
import "console"
import "vga"
import "page"
import "heap"
import "clock"
import "process"
import "ata"
import "fscmd"
import "fs"
import "file"
import "status"
import "jobs"
import "shell"
import "text"

const VENDOR_BYTES: uint64 = 16
const DUMP_ROWS: uint64 = 8
const DUMP_COLUMNS: uint64 = 16
const KEYBOARD_COMMAND_PORT: uint16 = 0x64
const KEYBOARD_RESET_PULSE: uint8 = 0xfe
const BEEP_TICKS: uint64 = CLOCK_HZ / 5
const PRINTABLE_FIRST: uint8 = 32
const PRINTABLE_LAST: uint8 = 126

var vendor: uint8[16]

fn cmd_help(argument: cstring) {
    shell_help()
}

fn cmd_clear(argument: cstring) {
    console_clear()
}

fn cmd_echo(argument: cstring) {
    console_write_line(argument)
}

fn print_memory_map() -> uint64 {
    var usable: uint64 = 0
    console_write_line("base                 length               kind")
    for i: uint64 in 0..memory_map_count() {
        var region: MemoryRegion* = memory_map_region(i)
        console_write_hex(region->base, 16)
        console_write("   ")
        console_write_hex(region->length, 16)
        console_write("   ")
        console_write_line(memory_map_kind_name(region->kind))
        if (region->kind == 1) {
            usable += region->length
        }
    }
    return usable
}

fn cmd_mem(argument: cstring) {
    if (memory_map_count() == 0) {
        console_write_line("the firmware reported no memory map")
    } else {
        console_write("firmware calls ")
        console_write_decimal(print_memory_map() / BYTES_PER_MB)
        console_write_line(" mb usable")
    }
    console_write("pages ")
    console_write_decimal(page_free_count())
    console_write(" free of ")
    console_write_decimal(page_total_count())
    console_write(", ")
    console_write_decimal(page_free_bytes() / BYTES_PER_KB)
    console_write_line(" kb available")
    console_write("heap ")
    console_write_decimal(heap_used())
    console_write(" bytes handed out of ")
    console_write_decimal(heap_claimed())
    console_write_line(" bytes claimed")
}

fn cmd_disk(argument: cstring) {
    if (!ata_present()) {
        console_write_line("no ata disk answered on the primary channel")
        return
    }
    console_write("model ")
    console_write_line(ata_model())
    console_write("size ")
    console_write_decimal(ata_capacity_bytes() / BYTES_PER_MB)
    console_write(" mb in ")
    console_write_decimal(ata_sector_count())
    console_write_line(" sectors of 512 bytes")
    console_write("traffic ")
    console_write_decimal(ata_read_count())
    console_write(" sectors read, ")
    console_write_decimal(ata_write_count())
    console_write(" written, ")
    console_write_decimal(ata_fault_count())
    console_write_line(" faults")
}

fn cmd_sector(argument: cstring) {
    if (text_empty(argument)) {
        console_write_line("sector <number>")
        return
    }
    var lba: uint64 = text_parse_number(argument)
    var buffer: uint64 = heap_alloc(SECTOR_BYTES)
    if (buffer == 0) {
        console_write_line("no room for a sector buffer")
        return
    }
    if (!ata_read(lba, 1, buffer)) {
        console_write_line("that sector did not read")
        heap_free(buffer)
        return
    }
    console_write("sector ")
    console_write_decimal(lba)
    console_write_line("")
    var bytes: uint8* = (uint8*)buffer
    for row: uint64 in 0..DUMP_ROWS {
        console_write_hex(row * DUMP_COLUMNS, 4)
        console_write("  ")
        dump_row(bytes, row * DUMP_COLUMNS)
    }
    heap_free(buffer)
}

fn filesystem_check() {
    if (!fs_mounted()) {
        console_write_line("no filesystem to check")
        return
    }
    var span: uint64 = 100000
    var out: uint64 = heap_alloc(span)
    var back: uint64 = heap_alloc(span)
    if (out == 0 || back == 0) {
        console_write_line("no room for the file buffers")
        heap_free(out)
        heap_free(back)
        return
    }
    var source: uint8* = (uint8*)out
    var target: uint8* = (uint8*)back
    for i: uint64 in 0..span {
        source[i] = (uint8)((i * 31 + i / 251) & 0xff)
        target[i] = 0
    }
    var name: cstring = "selftest.bin"
    if (!file_store(name, out, span)) {
        console_write_line("a 100000 byte file would not write")
    } else {
        var got: uint64 = file_load(name, back, span)
        var wrong: uint64 = 0
        for i: uint64 in 0..span {
            if (source[i] != target[i]) {
                wrong++
            }
        }
        console_write("a ")
        console_write_decimal(span)
        console_write(" byte file read back as ")
        console_write_decimal(got)
        console_write(" bytes, ")
        console_write_decimal(wrong)
        console_write_line(" bytes wrong")
        var handle: uint64 = file_open(name, OPEN_READ)
        file_seek(handle, 90000)
        var chunk: uint64 = file_read(handle, back, 512)
        var seek_wrong: uint64 = 0
        for i: uint64 in 0..chunk {
            if (target[i] != source[90000 + i]) {
                seek_wrong++
            }
        }
        file_close(handle)
        console_write("a seek to 90000 read ")
        console_write_decimal(chunk)
        console_write(" bytes, ")
        console_write_decimal(seek_wrong)
        console_write_line(" wrong")
        var before: uint64 = fs_free_blocks()
        fs_remove(name)
        console_write("removing it gave back ")
        console_write_decimal(fs_free_blocks() - before)
        console_write_line(" blocks")
    }
    heap_free(out)
    heap_free(back)
}

fn cmd_selftest(argument: cstring) {
    console_write_line("checking the heap, the pages and the disk")
    var big: uint64 = heap_alloc(200000)
    if (big == 0) {
        console_write_line("heap refused 200000 bytes")
    } else {
        var bytes: uint8* = (uint8*)big
        for i: uint64 in 0..200000 {
            bytes[i] = (uint8)(i & 0xff)
        }
        var wrong: uint64 = 0
        for i: uint64 in 0..200000 {
            if (bytes[i] != (uint8)(i & 0xff)) {
                wrong++
            }
        }
        console_write("heap handed out 200000 bytes at ")
        console_write_hex(big, 16)
        console_write(", ")
        console_write_decimal(wrong)
        console_write_line(" bytes wrong")
        heap_free(big)
    }

    var run: uint64 = page_alloc_pages(64)
    if (run == 0) {
        console_write_line("no contiguous run of 64 pages")
    } else {
        console_write("64 contiguous pages at ")
        console_write_hex(run, 16)
        console_write_line("")
        page_free_pages(run, 64)
    }

    var buffer: uint64 = heap_alloc(SECTOR_BYTES * 4)
    var check: uint64 = heap_alloc(SECTOR_BYTES * 4)
    if (buffer == 0 || check == 0) {
        console_write_line("no room for the disk buffers")
        return
    }
    var out: uint8* = (uint8*)buffer
    var back: uint8* = (uint8*)check
    for i: uint64 in 0..(SECTOR_BYTES * 4) {
        out[i] = (uint8)((i * 7 + 3) & 0xff)
        back[i] = 0
    }
    if (!ata_write(DISK_PARTITION_LBA, 4, buffer)) {
        console_write_line("the disk refused a four sector write")
    } else if (!ata_read(DISK_PARTITION_LBA, 4, check)) {
        console_write_line("the disk refused to read those sectors back")
    } else {
        var wrong: uint64 = 0
        for i: uint64 in 0..(SECTOR_BYTES * 4) {
            if (out[i] != back[i]) {
                wrong++
            }
        }
        console_write("four sectors written and read back, ")
        console_write_decimal(wrong)
        console_write_line(" bytes wrong")
    }
    heap_free(buffer)
    heap_free(check)
    filesystem_check()
    console_write("heap ")
    console_write_decimal(heap_used())
    console_write(" in use of ")
    console_write_decimal(heap_claimed())
    console_write(" claimed, ")
    console_write_decimal(heap_live_blocks())
    console_write_line(" live blocks")
}

fn cmd_alloc(argument: cstring) {
    var sizes: uint64[8] = [16, 64, 200, 1000, 32, 512, 24, 700]
    var blocks: uint64[8]
    var failures: uint64 = 0
    for i: uint64 in 0..8 {
        blocks[i] = heap_alloc(sizes[i])
        if (blocks[i] == 0) {
            failures++
        } else {
            var bytes: uint8* = (uint8*)blocks[i]
            for j: uint64 in 0..sizes[i] {
                bytes[j] = (uint8)(i + 1)
            }
        }
    }
    for i: uint64 in 0..8 {
        if (blocks[i] != 0) {
            var bytes: uint8* = (uint8*)blocks[i]
            for j: uint64 in 0..sizes[i] {
                if (bytes[j] != (uint8)(i + 1)) {
                    failures++
                }
            }
        }
    }
    console_write("eight blocks written and read back, ")
    console_write_decimal(failures)
    console_write_line(" failures")
    for i: uint64 in 0..8 {
        heap_free(blocks[i])
    }
    console_write("heap now holds ")
    console_write_decimal(heap_used())
    console_write(" bytes over ")
    console_write_decimal(heap_claimed())
    console_write_line(" claimed")
}

fn cmd_uptime(argument: cstring) {
    var seconds: uint64 = clock_seconds()
    console_write("up ")
    console_write_decimal(seconds / 60)
    console_write("m ")
    console_write_decimal(seconds % 60)
    console_write("s over ")
    console_write_decimal(clock_ticks())
    console_write_line(" timer ticks")
}

fn cmd_date(argument: cstring) {
    console_write_decimal(clock_year())
    console_put('-')
    console_write_decimal(clock_month())
    console_put('-')
    console_write_decimal(clock_day())
    console_put(' ')
    console_write_decimal(clock_hour())
    console_put(':')
    console_write_decimal(clock_minute())
    console_put(':')
    console_write_decimal(clock_second())
    console_write_line(" by the cmos clock")
}

fn cmd_cpu(argument: cstring) {
    cpu_vendor(&vendor[0])
    console_write("vendor ")
    console_write_line((cstring)&vendor[0])
    console_write_line("long mode, one gigabyte identity mapped with two megabyte pages")
}

fn print_row(slot: uint64) {
    console_write_padded(process_pid(slot), 5)
    console_pad(process_name(slot), 12)
    console_pad(process_state_name(slot), 10)
    console_pad(process_priority_name(slot), 8)
    console_write_padded(process_percent(slot), 5)
    console_write_padded(process_cpu_ticks(slot), 8)
    console_write_padded(process_slices(slot), 8)
    console_write_decimal(process_parent(slot))
    console_write_line("")
}

fn print_header() {
    console_write_line("pid  name        state     pri     cpu%   cpu ms  switches parent")
}

fn print_totals() {
    console_write_decimal(process_count())
    console_write(" processes, ")
    console_write_decimal(process_switch_count())
    console_write_line(" context switches")
}

fn cmd_ps(argument: cstring) {
    print_header()
    for slot: uint64 in 0..PROCESS_SLOTS {
        if (process_live(slot)) {
            print_row(slot)
        }
    }
    print_totals()
}

fn cmd_top(argument: cstring) {
    var seen: uint64[16]
    for i: uint64 in 0..PROCESS_SLOTS {
        seen[i] = 0
    }
    print_header()
    for round: uint64 in 0..PROCESS_SLOTS {
        var best: uint64 = PROCESS_SLOTS
        for slot: uint64 in 0..PROCESS_SLOTS {
            if (process_live(slot) && seen[slot] == 0) {
                if (best == PROCESS_SLOTS ||
                    process_percent(slot) > process_percent(best)) {
                    best = slot
                }
            }
        }
        if (best == PROCESS_SLOTS) {
            print_totals()
            return
        }
        seen[best] = 1
        print_row(best)
    }
    print_totals()
}

fn rest_after_word(argument: cstring) -> uint64 {
    var i: uint64 = 0
    while (argument[i] != 0 && argument[i] != ' ') {
        i++
    }
    while (argument[i] == ' ') {
        i++
    }
    return i
}

fn cmd_kill(argument: cstring) {
    var pid: uint64 = text_parse_number(argument)
    if (pid == 0) {
        console_write_line("kill wants a pid from ps")
        return
    }
    if (!process_kill(pid)) {
        console_write_line("no such process, or it may not be killed")
        return
    }
    console_write("asked ")
    console_write_decimal(pid)
    console_write_line(" to stop")
}

fn cmd_nice(argument: cstring) {
    var pid: uint64 = text_parse_number(argument)
    var rest: cstring = (cstring)&argument[rest_after_word(argument)]
    var priority: uint64 = PRIORITY_COUNT
    if (text_equals(rest, "high")) {
        priority = PRIORITY_HIGH
    } else if (text_equals(rest, "normal")) {
        priority = PRIORITY_NORMAL
    } else if (text_equals(rest, "low")) {
        priority = PRIORITY_LOW
    }
    if (pid == 0 || priority == PRIORITY_COUNT) {
        console_write_line("nice wants a pid and one of high, normal, low")
        return
    }
    if (!process_set_priority(pid, priority)) {
        console_write_line("no such process")
        return
    }
    console_write("pid ")
    console_write_decimal(pid)
    console_write(" now runs at ")
    console_write_line(rest)
}

fn cmd_spawn(argument: cstring) {
    var count: uint64 = text_parse_number(argument)
    if (count == 0) {
        count = 1
    }
    for i: uint64 in 0..count {
        var pid: uint64 = jobs_counter(PRIORITY_LOW)
        if (pid == 0) {
            console_write_line("no free process slot or no free page")
            return
        }
        console_write("started counter as pid ")
        console_write_decimal(pid)
        console_write_line("")
    }
}

fn cmd_work(argument: cstring) {
    var span: uint64 = text_parse_number(argument)
    if (span == 0) {
        span = 500
    }
    var pid: uint64 = jobs_worker(span, PRIORITY_NORMAL)
    if (pid == 0) {
        console_write_line("no free process slot or no free page")
        return
    }
    console_write("pid ")
    console_write_decimal(pid)
    console_write(" is burning cpu for ")
    console_write_decimal(span)
    console_write_line(" ms, watch it in top")
}

fn cmd_mailbox(argument: cstring) {
    var pid: uint64 = jobs_mailbox()
    if (pid == 0) {
        console_write_line("no free process slot or no free page")
        return
    }
    console_write("pid ")
    console_write_decimal(pid)
    console_write_line(" is blocked waiting for mail, send it a number")
}

fn cmd_send(argument: cstring) {
    var pid: uint64 = text_parse_number(argument)
    var rest: cstring = (cstring)&argument[rest_after_word(argument)]
    var message: uint64 = text_parse_number(rest)
    if (pid == 0) {
        console_write_line("send wants a pid and a number, zero ends it")
        return
    }
    if (!process_send(pid, message)) {
        console_write_line("no such process, or its mailbox is full")
        return
    }
    console_write("sent ")
    console_write_decimal(message)
    console_write(" to ")
    console_write_decimal(pid)
    console_write_line("")
}

fn cmd_wait(argument: cstring) {
    var pid: uint64 = text_parse_number(argument)
    if (pid == 0) {
        console_write_line("wait wants a pid")
        return
    }
    if (process_slot_of(pid) == NO_PROCESS) {
        console_write_line("no such process")
        return
    }
    if (pid == process_pid(process_current())) {
        console_write_line("a process cannot wait for itself")
        return
    }
    console_write("waiting for ")
    console_write_decimal(pid)
    console_write_line("")
    var code: uint64 = process_wait(pid)
    console_write("pid ")
    console_write_decimal(pid)
    console_write(" exited with ")
    console_write_decimal(code)
    console_write_line("")
}

fn dump_row(bytes: uint8*, offset: uint64) {
    for i: uint64 in 0..DUMP_COLUMNS {
        console_write_hex_byte((uint64)bytes[offset + i])
        console_put(' ')
    }
    console_put(' ')
    for i: uint64 in 0..DUMP_COLUMNS {
        var ch: uint8 = bytes[offset + i]
        if (ch >= PRINTABLE_FIRST && ch <= PRINTABLE_LAST) {
            console_put(ch)
        } else {
            console_put('.')
        }
    }
    console_put('\n')
}

fn cmd_hexdump(argument: cstring) {
    var address: uint64 = text_parse_number(argument)
    if (address == 0) {
        address = KERNEL_BASE
    }
    var bytes: uint8* = (uint8*)address
    for row: uint64 in 0..DUMP_ROWS {
        console_write_hex(address + row * DUMP_COLUMNS, 16)
        console_write("  ")
        dump_row(bytes, row * DUMP_COLUMNS)
    }
}

fn cmd_beep(argument: cstring) {
    speaker_beep(BEEP_TICKS)
}

export fn cmd_banner(argument: cstring) {
    console_write_colored("  mettle os  ", COLOR_TITLE)
    console_put('\n')
    console_write_colored("a kernel compiled straight to a flat image by the mettle compiler",
                          COLOR_NOTE)
    console_put('\n')
    console_write_line("type help for the command list")
    console_put('\n')
}

fn cmd_reboot(argument: cstring) {
    console_write_line("resetting")
    cpu_disable_interrupts()
    port_out(KEYBOARD_COMMAND_PORT, KEYBOARD_RESET_PULSE)
    cpu_stop()
}

fn cmd_halt(argument: cstring) {
    console_write_line("halted, close the window when you are done")
    cpu_stop()
}

export fn commands_init() {
    fs_commands_init()
    shell_register("help", "this list", &cmd_help)
    shell_register("clear", "wipe the screen", &cmd_clear)
    shell_register("echo", "print the rest of the line", &cmd_echo)
    shell_register("mem", "memory map, free pages, heap", &cmd_mem)
    shell_register("alloc", "exercise the heap and report", &cmd_alloc)
    shell_register("disk", "the drive the kernel is running from", &cmd_disk)
    shell_register("selftest", "exercise the heap, the pages and the disk", &cmd_selftest)
    shell_register("sector", "128 bytes of a disk sector", &cmd_sector)
    shell_register("uptime", "seconds and ticks since boot", &cmd_uptime)
    shell_register("date", "the clock the firmware keeps", &cmd_date)
    shell_register("cpu", "what the processor calls itself", &cmd_cpu)
    shell_register("ps", "the process table", &cmd_ps)
    shell_register("top", "processes by processor share", &cmd_top)
    shell_register("spawn", "start counter processes", &cmd_spawn)
    shell_register("work", "burn processor for a while", &cmd_work)
    shell_register("wait", "wait for a process and read its code", &cmd_wait)
    shell_register("kill", "ask a process to stop", &cmd_kill)
    shell_register("nice", "change a process priority", &cmd_nice)
    shell_register("mailbox", "start a process that waits for mail", &cmd_mailbox)
    shell_register("send", "send a number to a process", &cmd_send)
    shell_register("hexdump", "128 bytes of memory", &cmd_hexdump)
    shell_register("beep", "a note on the speaker", &cmd_beep)
    shell_register("banner", "draw the greeting again", &cmd_banner)
    shell_register("reboot", "pulse the keyboard controller reset", &cmd_reboot)
    shell_register("halt", "stop the processor", &cmd_halt)
}
