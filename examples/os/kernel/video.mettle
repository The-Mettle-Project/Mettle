import "layout"
import "svga"

const INFO_WIDTH: uint64 = BOOT_INFO_BASE + 2
const INFO_HEIGHT: uint64 = BOOT_INFO_BASE + 4
const INFO_PITCH: uint64 = BOOT_INFO_BASE + 6
const INFO_FRAMEBUFFER: uint64 = BOOT_INFO_BASE + 12

var width: uint64 = 0
var height: uint64 = 0
var pitch: uint64 = 0
var framebuffer: uint64 = 0
var back: uint64 = 0
var accelerated: uint64 = 0

const OFF_LEFT: uint64 = 0x8000000000000000

var clip_left: uint64 = 0
var clip_top: uint64 = 0
var clip_right: uint64 = 0
var clip_bottom: uint64 = 0

fn adopt(new_width: uint64, new_height: uint64, new_pitch: uint64,
         new_framebuffer: uint64) -> bool {
    if (new_width == 0 || new_height == 0 || new_framebuffer == 0) {
        return false
    }
    if (new_width > SCREEN_LIMIT_WIDTH || new_height > SCREEN_LIMIT_HEIGHT) {
        return false
    }
    width = new_width
    height = new_height
    pitch = new_pitch
    framebuffer = new_framebuffer
    back = BACK_BUFFER_BASE
    clip_left = 0
    clip_top = 0
    clip_right = width
    clip_bottom = height
    return true
}

fn try_gpu() -> bool {
    if (!svga_probe()) {
        return false
    }
    var wanted_width: uint64 = SCREEN_LIMIT_WIDTH
    var wanted_height: uint64 = SCREEN_LIMIT_HEIGHT
    if (svga_max_width() < wanted_width || svga_max_height() < wanted_height) {
        wanted_width = 1024
        wanted_height = 768
    }
    if (svga_max_width() < wanted_width || svga_max_height() < wanted_height) {
        wanted_width = 800
        wanted_height = 600
    }
    if (!svga_set_mode(wanted_width, wanted_height)) {
        return false
    }
    if (!adopt(wanted_width, wanted_height, svga_pitch(), svga_framebuffer())) {
        return false
    }
    accelerated = 1
    return true
}

fn try_firmware() -> bool {
    var words: uint16* = (uint16*)INFO_WIDTH
    var frame: uint32* = (uint32*)INFO_FRAMEBUFFER
    return adopt((uint64)words[0], (uint64)words[1], (uint64)words[2],
                 (uint64)frame[0])
}

export fn video_init() -> bool {
    if (try_gpu()) {
        return true
    }
    return try_firmware()
}

export fn video_accelerated() -> bool {
    return accelerated != 0
}

export fn video_width() -> uint64 {
    return width
}

export fn video_height() -> uint64 {
    return height
}

export fn video_set_clip(x: uint64, y: uint64, w: uint64, h: uint64) {
    clip_left = x
    clip_top = y
    clip_right = x + w
    clip_bottom = y + h
    if (clip_right > width) {
        clip_right = width
    }
    if (clip_bottom > height) {
        clip_bottom = height
    }
}

export fn video_clear_clip() {
    clip_left = 0
    clip_top = 0
    clip_right = width
    clip_bottom = height
}

fn span_start(value: uint64, low: uint64) -> uint64 {
    if (value >= OFF_LEFT || value < low) {
        return low
    }
    return value
}

fn span_end(start: uint64, size: uint64, high: uint64) -> uint64 {
    var edge: uint64 = start + size
    if (edge >= OFF_LEFT) {
        return 0
    }
    if (edge > high) {
        return high
    }
    return edge
}

export fn video_visible(x: uint64, y: uint64, w: uint64, h: uint64) -> bool {
    return span_start(x, clip_left) < span_end(x, w, clip_right) &&
           span_start(y, clip_top) < span_end(y, h, clip_bottom)
}

export fn video_inside(x: uint64, y: uint64, w: uint64, h: uint64) -> bool {
    return x < OFF_LEFT && y < OFF_LEFT && x >= clip_left && y >= clip_top &&
           x + w <= clip_right && y + h <= clip_bottom
}

export fn video_row(y: uint64) -> uint64 {
    return back + y * width * 4
}

fn row_address(y: uint64) -> uint64 {
    return back + y * width * 4
}

export fn video_pixel(x: uint64, y: uint64, color: uint32) {
    if (x >= OFF_LEFT || y >= OFF_LEFT) {
        return
    }
    if (x < clip_left || y < clip_top || x >= clip_right || y >= clip_bottom) {
        return
    }
    var row: uint32* = (uint32*)row_address(y)
    row[x] = color
}

export fn video_read(x: uint64, y: uint64) -> uint32 {
    if (x >= width || y >= height) {
        return 0
    }
    var row: uint32* = (uint32*)row_address(y)
    return row[x]
}

export fn video_mix(under: uint32, over: uint32, alpha: uint64) -> uint32 {
    if (alpha >= 255) {
        return over
    }
    if (alpha == 0) {
        return under
    }
    var rest: uint64 = 255 - alpha
    var red: uint64 = ((uint64)((over >> 16) & 255) * alpha +
                       (uint64)((under >> 16) & 255) * rest + 128) >> 8
    var green: uint64 = ((uint64)((over >> 8) & 255) * alpha +
                         (uint64)((under >> 8) & 255) * rest + 128) >> 8
    var blue: uint64 = ((uint64)(over & 255) * alpha +
                        (uint64)(under & 255) * rest + 128) >> 8
    return (uint32)((red << 16) | (green << 8) | blue)
}

fn fill_span(start: uint64, count: uint64, color: uint32) {
    var pair: uint64 = ((uint64)color << 32) | (uint64)color
    var pairs: uint64 = count / 2
    var wide: uint64* = (uint64*)start
    for i: uint64 in 0..pairs {
        wide[i] = pair
    }
    if (count % 2 != 0) {
        var tail: uint32* = (uint32*)(start + pairs * 8)
        tail[0] = color
    }
}

export fn video_fill(x: uint64, y: uint64, w: uint64, h: uint64, color: uint32) {
    var left: uint64 = span_start(x, clip_left)
    var top: uint64 = span_start(y, clip_top)
    var right: uint64 = span_end(x, w, clip_right)
    var bottom: uint64 = span_end(y, h, clip_bottom)
    if (left >= right || top >= bottom) {
        return
    }
    for row: uint64 in top..bottom {
        fill_span(row_address(row) + left * 4, right - left, color)
    }
}

export fn video_gradient(x: uint64, y: uint64, w: uint64, h: uint64,
                         top: uint32, bottom: uint32) {
    if (h == 0) {
        return
    }
    for row: uint64 in 0..h {
        video_fill(x, y + row, w, 1, video_mix(top, bottom, row * 255 / h))
    }
}

export fn video_frame(x: uint64, y: uint64, w: uint64, h: uint64, color: uint32) {
    video_fill(x, y, w, 1, color)
    video_fill(x, y + h - 1, w, 1, color)
    video_fill(x, y, 1, h, color)
    video_fill(x + w - 1, y, 1, h, color)
}

export fn video_bevel(x: uint64, y: uint64, w: uint64, h: uint64, light: uint32,
                      dark: uint32) {
    video_fill(x, y, w - 1, 1, light)
    video_fill(x, y, 1, h - 1, light)
    video_fill(x, y + h - 1, w, 1, dark)
    video_fill(x + w - 1, y, 1, h, dark)
}

export fn video_notch(x: uint64, y: uint64, w: uint64, color: uint32) {
    video_fill(x, y, 2, 1, color)
    video_fill(x + w - 2, y, 2, 1, color)
    video_fill(x, y + 1, 1, 1, color)
    video_fill(x + w - 1, y + 1, 1, 1, color)
}

export fn video_blit(source: uint64, source_pitch: uint64, x: uint64, y: uint64,
                     w: uint64, h: uint64) {
    for row: uint64 in 0..h {
        var target_y: uint64 = y + row
        if (target_y >= clip_top && target_y < clip_bottom) {
            var from: uint32* = (uint32*)(source + row * source_pitch)
            for column: uint64 in 0..w {
                video_pixel(x + column, target_y, from[column])
            }
        }
    }
}

export fn video_blit_alpha(source: uint64, x: uint64, y: uint64, w: uint64,
                           h: uint64) {
    var pixels: uint32* = (uint32*)source
    for row: uint64 in 0..h {
        for column: uint64 in 0..w {
            var value: uint32 = pixels[row * w + column]
            var alpha: uint64 = (uint64)(value >> 24)
            if (alpha != 0) {
                var target_x: uint64 = x + column
                var target_y: uint64 = y + row
                if (target_x < width && target_y < height) {
                    var line: uint32* = (uint32*)row_address(target_y)
                    line[target_x] = video_mix(line[target_x], value & 0xffffff,
                                               alpha)
                }
            }
        }
    }
}

export fn video_capture(into: uint64, x: uint64, y: uint64, w: uint64, h: uint64) {
    var pixels: uint32* = (uint32*)into
    for row: uint64 in 0..h {
        for column: uint64 in 0..w {
            pixels[row * w + column] = video_read(x + column, y + row)
        }
    }
}

export fn video_restore(from: uint64, x: uint64, y: uint64, w: uint64, h: uint64) {
    var pixels: uint32* = (uint32*)from
    for row: uint64 in 0..h {
        var target_y: uint64 = y + row
        if (target_y < height) {
            var line: uint32* = (uint32*)row_address(target_y)
            for column: uint64 in 0..w {
                if (x + column < width) {
                    line[x + column] = pixels[row * w + column]
                }
            }
        }
    }
}

export fn video_present(x: uint64, y: uint64, w: uint64, h: uint64) {
    if (width == 0 || x >= width || y >= height) {
        return
    }
    var right: uint64 = x + w
    var bottom: uint64 = y + h
    if (right > width) {
        right = width
    }
    if (bottom > height) {
        bottom = height
    }
    var count: uint64 = right - x
    for row: uint64 in y..bottom {
        var from: uint64* = (uint64*)(row_address(row) + x * 4)
        var to: uint64* = (uint64*)(framebuffer + row * pitch + x * 4)
        for i: uint64 in 0..(count / 2) {
            to[i] = from[i]
        }
        if (count % 2 != 0) {
            var from_tail: uint32* = (uint32*)(row_address(row) + (right - 1) * 4)
            var to_tail: uint32* = (uint32*)(framebuffer + row * pitch +
                                             (right - 1) * 4)
            to_tail[0] = from_tail[0]
        }
    }
    if (accelerated != 0) {
        svga_update(x, y, right - x, bottom - y)
    }
}

export fn video_present_all() {
    video_present(0, 0, width, height)
}
