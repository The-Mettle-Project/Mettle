import "layout"
import "vga"
import "clock"
import "process"
import "page"
import "heap"

const STATUS_ROW: uint64 = 23
const FIELD_GAP: uint64 = 3
const STATUS_PERIOD: uint64 = CLOCK_HZ / 4

fn label(column: uint64, text: cstring) -> uint64 {
    return column + vga_draw_text(STATUS_ROW, column, text, COLOR_STATUS) + 1
}

fn field(column: uint64, text: cstring, value: uint64, suffix: cstring) -> uint64 {
    var at: uint64 = label(column, text)
    at += vga_draw_number(STATUS_ROW, at, value, COLOR_STATUS)
    at += vga_draw_text(STATUS_ROW, at, suffix, COLOR_STATUS)
    return at + FIELD_GAP
}

fn clock_field(column: uint64) -> uint64 {
    var at: uint64 = label(column, "time")
    at += vga_draw_two_digits(STATUS_ROW, at, clock_hour(), COLOR_STATUS)
    at += vga_draw_text(STATUS_ROW, at, ":", COLOR_STATUS)
    at += vga_draw_two_digits(STATUS_ROW, at, clock_minute(), COLOR_STATUS)
    at += vga_draw_text(STATUS_ROW, at, ":", COLOR_STATUS)
    at += vga_draw_two_digits(STATUS_ROW, at, clock_second(), COLOR_STATUS)
    return at + FIELD_GAP
}

fn draw_status_bar() {
    vga_fill_row(STATUS_ROW, COLOR_STATUS)
    var at: uint64 = 1
    at += vga_draw_text(STATUS_ROW, at, "mettle os", COLOR_STATUS) + FIELD_GAP
    at = clock_field(at)
    at = field(at, "up", clock_seconds(), "s")
    at = field(at, "free", page_free_bytes() / BYTES_PER_MB, "mb")
    at = field(at, "heap", heap_used(), "b")
    field(at, "tasks", process_count(), "")
}

fn status_task(argument: uint64) {
    while (!process_stop_wanted()) {
        draw_status_bar()
        process_sleep(STATUS_PERIOD)
    }
    process_exit(0)
}

export fn status_start() -> uint64 {
    return process_spawn((uint64)&status_task, "status", PRIORITY_LOW, 0)
}


