export fn theme_text_color(attribute: uint8) -> uint32 {
    var index: uint64 = (uint64)attribute & 15
    if (index == 0) { return 0x000000 }
    if (index == 1) { return 0x000080 }
    if (index == 2) { return 0x008000 }
    if (index == 3) { return 0x008080 }
    if (index == 4) { return 0x800000 }
    if (index == 5) { return 0x800080 }
    if (index == 6) { return 0x808000 }
    if (index == 7) { return 0xc0c0c0 }
    if (index == 8) { return 0x808080 }
    if (index == 9) { return 0x0000ff }
    if (index == 10) { return 0x00ff00 }
    if (index == 11) { return 0x00ffff }
    if (index == 12) { return 0xff0000 }
    if (index == 13) { return 0xff00ff }
    if (index == 14) { return 0xffff00 }
    return 0xffffff
}
