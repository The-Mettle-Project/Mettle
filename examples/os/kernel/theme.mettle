export const ICON_TEXT: uint32 = 0xdde3ee

export fn theme_text_color(attribute: uint8) -> uint32 {
    var index: uint64 = (uint64)attribute & 15
    if (index == 0) { return 0x353b47 }
    if (index == 1) { return 0x4f7fe0 }
    if (index == 2) { return 0x54c98a }
    if (index == 3) { return 0x45c4cf }
    if (index == 4) { return 0xdc6259 }
    if (index == 5) { return 0xb96ee0 }
    if (index == 6) { return 0xd0a95a }
    if (index == 7) { return 0xd3dcea }
    if (index == 8) { return 0x66708a }
    if (index == 9) { return 0x7fa8ff }
    if (index == 10) { return 0x6fe8b4 }
    if (index == 11) { return 0x7ee6f0 }
    if (index == 12) { return 0xff8b82 }
    if (index == 13) { return 0xd8a0ff }
    if (index == 14) { return 0xf5d67c }
    return 0xffffff
}
