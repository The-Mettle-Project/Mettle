export const SKY_TOP: uint32 = 0x0b1020
export const SKY_BOTTOM: uint32 = 0x24406e

export const BAR: uint32 = 0x0e1118
export const BAR_EDGE: uint32 = 0x2b3346
export const BAR_TEXT: uint32 = 0xaab4c4

export const WINDOW_BODY: uint32 = 0x171a21
export const WINDOW_EDGE: uint32 = 0x2f3644
export const WINDOW_TEXT: uint32 = 0xd6dbe4
export const WINDOW_FAINT: uint32 = 0x8a93a3

export const TITLE_ACTIVE: uint32 = 0x2a6ab0
export const TITLE_IDLE: uint32 = 0x272c36
export const TITLE_TEXT: uint32 = 0xffffff
export const TITLE_IDLE_TEXT: uint32 = 0x9aa3b2

export const CLOSE_BOX: uint32 = 0xc05252
export const ACCENT: uint32 = 0x54c9a4
export const SHADOW: uint32 = 0x070a12

export const ICON_FACE: uint32 = 0x1d2534
export const ICON_EDGE: uint32 = 0x3d4b64
export const ICON_TEXT: uint32 = 0xdde3ee

export const TERMINAL_BACK: uint32 = 0x0b0d12
export const TERMINAL_TEXT: uint32 = 0xc9d2e0

export const CURSOR_FILL: uint32 = 0xffffff
export const CURSOR_EDGE: uint32 = 0x000000

export fn theme_text_color(attribute: uint8) -> uint32 {
    var index: uint64 = (uint64)attribute & 15
    if (index == 0) { return 0x30363f }
    if (index == 1) { return 0x3b6fd6 }
    if (index == 2) { return 0x4fbf7a }
    if (index == 3) { return 0x3fb6bf }
    if (index == 4) { return 0xd0564f }
    if (index == 5) { return 0xb05cd0 }
    if (index == 6) { return 0xc09a4a }
    if (index == 7) { return 0xc9d2e0 }
    if (index == 8) { return 0x5a6270 }
    if (index == 9) { return 0x6f9bff }
    if (index == 10) { return 0x77e2a1 }
    if (index == 11) { return 0x74dbe6 }
    if (index == 12) { return 0xff8078 }
    if (index == 13) { return 0xdb8cff }
    if (index == 14) { return 0xf0cc70 }
    return 0xffffff
}
