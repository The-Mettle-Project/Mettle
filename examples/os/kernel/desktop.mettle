import "layout"
import "video"
import "font"
import "theme"
import "window"
import "terminal"
import "apps"
import "mouse"
import "cursor"
import "keyboard"
import "clock"
import "process"
import "console"

const TASKBAR_HEIGHT: uint64 = 30
const START_WIDTH: uint64 = 78
const TASK_WIDTH: uint64 = 158
const TASK_GAP: uint64 = 4
const TRAY_WIDTH: uint64 = 78
const MENU_WIDTH: uint64 = 208
const MENU_ROW: uint64 = 26
const MENU_SIDE_WIDTH: uint64 = 26
const ICON_LEFT: uint64 = 12
const ICON_TOP: uint64 = 14
const ICON_WIDTH: uint64 = 80
const ICON_HEIGHT: uint64 = 62
const TILE: uint64 = 30
const LAUNCHER_SLOTS: uint64 = 5

struct Launcher {
    label: cstring;
    kind: uint64;
    open: fn() -> uint64;
}

var launchers: Launcher[5]
var launcher_count: uint64 = 0

var damage_left: uint64 = 0
var damage_top: uint64 = 0
var damage_right: uint64 = 0
var damage_bottom: uint64 = 0

var dragging: uint64 = WINDOW_SLOTS
var drag_x: int64 = 0
var drag_y: int64 = 0
var was_down: uint64 = 0
var menu_open: uint64 = 0
var last_second: uint64 = 0

var software_x: uint64 = 0
var software_y: uint64 = 0
var software_saved: uint64 = 0
var saved_pixels: uint32[560]

fn mark(x: uint64, y: uint64, w: uint64, h: uint64) {
    var left: uint64 = x
    var top: uint64 = y
    var right: uint64 = x + w
    var bottom: uint64 = y + h
    if (right > video_width()) {
        right = video_width()
    }
    if (bottom > video_height()) {
        bottom = video_height()
    }
    if (left >= right || top >= bottom) {
        return
    }
    if (damage_right <= damage_left) {
        damage_left = left
        damage_top = top
        damage_right = right
        damage_bottom = bottom
        return
    }
    if (left < damage_left) {
        damage_left = left
    }
    if (top < damage_top) {
        damage_top = top
    }
    if (right > damage_right) {
        damage_right = right
    }
    if (bottom > damage_bottom) {
        damage_bottom = bottom
    }
}

fn mark_window(id: uint64) {
    mark((uint64)window_x(id), (uint64)window_y(id), window_width(id),
         window_height(id))
}

fn mark_all() {
    mark(0, 0, video_width(), video_height())
}

fn work_height() -> uint64 {
    return video_height() - TASKBAR_HEIGHT
}

fn taskbar_top() -> uint64 {
    return video_height() - TASKBAR_HEIGHT
}

fn menu_height() -> uint64 {
    return launcher_count * MENU_ROW + 16
}

fn menu_top() -> uint64 {
    return taskbar_top() - menu_height()
}

fn register(label: cstring, kind: uint64, open: fn() -> uint64) {
    if (launcher_count >= LAUNCHER_SLOTS) {
        return
    }
    launchers[launcher_count].label = label
    launchers[launcher_count].kind = kind
    launchers[launcher_count].open = open
    launcher_count++
}

fn launch(index: uint64) {
    var existing: uint64 = window_of_kind(launchers[index].kind)
    if (existing < WINDOW_SLOTS) {
        window_show(existing)
        window_raise(existing)
        mark_window(existing)
        return
    }
    var opened: uint64 = launchers[index].open()
    if (opened < WINDOW_SLOTS) {
        mark_window(opened)
    }
}

fn draw_tile(x: uint64, y: uint64) {
    video_fill(x, y, TILE, TILE, ICON_FACE)
    video_frame(x, y, TILE, TILE, ICON_EDGE)
    video_fill(x + 4, y + 4, TILE - 8, 3, SELECT)
    video_fill(x + 4, y + 11, TILE - 8, TILE - 15, FACE)
}

fn draw_desktop_icons() {
    for i: uint64 in 0..launcher_count {
        var top: uint64 = ICON_TOP + i * (ICON_HEIGHT + 6)
        if (video_visible(ICON_LEFT, top, ICON_WIDTH, ICON_HEIGHT)) {
            draw_tile(ICON_LEFT + (ICON_WIDTH - TILE) / 2, top)
            var text: cstring = launchers[i].label
            var text_width: uint64 = font_text_width(text)
            var text_x: uint64 = ICON_LEFT + (ICON_WIDTH - text_width) / 2
            font_draw_text(text_x + 1, top + TILE + 7, text, ICON_SHADOW)
            font_draw_text(text_x, top + TILE + 6, text, ICON_TEXT)
        }
    }
}

fn draw_button(x: uint64, y: uint64, w: uint64, h: uint64, top: uint32,
               bottom: uint32, edge: uint32) {
    video_gradient(x, y, w, h, top, bottom)
    video_frame(x, y, w, h, edge)
    video_fill(x + 1, y + 1, w - 2, 1, video_mix(top, FACE_LIGHT, 90))
}

fn draw_title_buttons(id: uint64, active: bool) {
    var top: uint64 = window_close_y(id)
    for index: uint64 in 0..3 {
        var left: uint64 = window_button_x(id, index)
        var face_top: uint32 = BUTTON_TOP
        var face_bottom: uint32 = BUTTON_BOTTOM
        var edge: uint32 = BUTTON_EDGE
        if (index == 2) {
            face_top = CLOSE_TOP
            face_bottom = CLOSE_BOTTOM
            edge = CLOSE_EDGE
        }
        if (!active) {
            face_top = video_mix(face_top, FACE_LIGHT, 90)
            face_bottom = video_mix(face_bottom, FACE_LIGHT, 90)
        }
        draw_button(left, top, CLOSE_SIZE, CLOSE_SIZE, face_top, face_bottom, edge)
        var mark_x: uint64 = left + 5
        var mark_y: uint64 = top + 5
        if (index == 0) {
            video_fill(mark_x, top + CLOSE_SIZE - 7, 9, 2, TITLE_TEXT)
        } else if (index == 1) {
            video_frame(mark_x, mark_y, 9, 9, TITLE_TEXT)
            video_fill(mark_x, mark_y, 9, 2, TITLE_TEXT)
        } else {
            for step: uint64 in 0..7 {
                video_fill(mark_x + step, mark_y + step, 2, 2, TITLE_TEXT)
                video_fill(mark_x + 6 - step, mark_y + step, 2, 2, TITLE_TEXT)
            }
        }
    }
}

fn draw_window(id: uint64, active: bool) {
    var left: uint64 = (uint64)window_x(id)
    var top: uint64 = (uint64)window_y(id)
    var w: uint64 = window_width(id)
    var h: uint64 = window_height(id)
    if (!video_visible(left, top, w, h)) {
        return
    }

    var frame: uint32 = FRAME_IDLE
    var title_top: uint32 = TITLE_TOP_IDLE
    var title_bottom: uint32 = TITLE_BOTTOM_IDLE
    var title_text: uint32 = TITLE_TEXT_IDLE
    if (active) {
        frame = FRAME_ACTIVE
        title_top = TITLE_TOP
        title_bottom = TITLE_BOTTOM
        title_text = TITLE_TEXT
    }

    video_fill(left, top, w, h, frame)
    if (active) {
        video_gradient(left + 1, top + 1, w - 2, TITLE_HEIGHT / 2, title_top,
                       TITLE_MID)
        video_gradient(left + 1, top + 1 + TITLE_HEIGHT / 2, w - 2,
                       TITLE_HEIGHT / 2 - 1, TITLE_MID, title_bottom)
    } else {
        video_gradient(left + 1, top + 1, w - 2, TITLE_HEIGHT - 2, title_top,
                       title_bottom)
    }
    video_notch(left, top, w, DESKTOP)
    video_fill(left + 2, top + 1, w - 4, 1, video_mix(title_top, FACE_LIGHT, 70))

    font_draw_text(left + 8, top + 5, window_title(id), title_text)
    draw_title_buttons(id, active)

    video_fill(left + BORDER - 1, top + TITLE_HEIGHT - 1,
               w - BORDER * 2 + 2, h - TITLE_HEIGHT - BORDER + 1, FACE)
    window_draw_content(id)
}

fn draw_clock() {
    var left: uint64 = video_width() - TRAY_WIDTH
    var top: uint64 = taskbar_top()
    video_gradient(left, top + 1, TRAY_WIDTH, TASKBAR_HEIGHT - 1, TRAY_TOP,
                   TRAY_BOTTOM)
    video_fill(left, top + 1, 1, TASKBAR_HEIGHT - 1, TRAY_EDGE)
    var at: uint64 = left + 12
    at += font_draw_two_digits(at, top + 7, clock_hour(), TRAY_TEXT)
    at += font_draw_text(at, top + 7, ":", TRAY_TEXT)
    font_draw_two_digits(at, top + 7, clock_minute(), TRAY_TEXT)
}

fn task_button_x(index: uint64) -> uint64 {
    return START_WIDTH + 8 + index * (TASK_WIDTH + TASK_GAP)
}

fn draw_taskbar() {
    var top: uint64 = taskbar_top()
    if (!video_visible(0, top, video_width(), TASKBAR_HEIGHT)) {
        return
    }
    video_fill(0, top, video_width(), 1, TASKBAR_EDGE)
    video_gradient(0, top + 1, video_width(), TASKBAR_HEIGHT - 1, TASKBAR_TOP,
                   TASKBAR_BOTTOM)

    var start_down: uint32 = START_TOP
    var start_up: uint32 = START_BOTTOM
    if (menu_open != 0) {
        start_down = START_BOTTOM
        start_up = START_TOP
    }
    video_gradient(0, top + 2, START_WIDTH, TASKBAR_HEIGHT - 4, start_down,
                   start_up)
    video_fill(0, top + 2, START_WIDTH, 1, video_mix(START_TOP, FACE_LIGHT, 110))
    video_fill(START_WIDTH - 1, top + 2, 1, TASKBAR_HEIGHT - 4, START_EDGE)
    font_draw_text(16, top + 8, "start", START_TEXT)

    for i: uint64 in 0..window_count() {
        var id: uint64 = window_at_depth(i)
        var left: uint64 = task_button_x(i)
        if (left + TASK_WIDTH < video_width() - TRAY_WIDTH) {
            var face_top: uint32 = TASK_TOP
            var face_bottom: uint32 = TASK_BOTTOM
            if (id == window_front() && !window_hidden(id)) {
                face_top = TASK_DOWN_TOP
                face_bottom = TASK_DOWN_BOTTOM
            }
            video_gradient(left, top + 4, TASK_WIDTH, TASKBAR_HEIGHT - 8,
                           face_top, face_bottom)
            video_frame(left, top + 4, TASK_WIDTH, TASKBAR_HEIGHT - 8,
                        TASKBAR_EDGE)
            font_draw_text(left + 8, top + 8, window_title(id), TASK_TEXT)
        }
    }

    draw_clock()
}

fn draw_menu() {
    if (menu_open == 0) {
        return
    }
    var top: uint64 = menu_top()
    var height: uint64 = menu_height()
    if (!video_visible(0, top, MENU_WIDTH, height)) {
        return
    }
    video_fill(0, top, MENU_WIDTH, height, MENU_FACE)
    video_frame(0, top, MENU_WIDTH, height, MENU_EDGE)
    video_gradient(1, top + 1, MENU_SIDE_WIDTH, height - 2, MENU_SIDE,
                   video_mix(MENU_SIDE, 0x000000, 90))
    for i: uint64 in 0..launcher_count {
        var row: uint64 = top + 8 + i * MENU_ROW
        video_fill(MENU_SIDE_WIDTH + 6, row + 3, 14, 14, SELECT)
        font_draw_text(MENU_SIDE_WIDTH + 28, row + 4, launchers[i].label, TEXT)
    }
}

fn paint() {
    video_fill(0, 0, video_width(), work_height(), DESKTOP)
    draw_desktop_icons()
    var front: uint64 = window_front()
    for i: uint64 in 0..window_count() {
        var id: uint64 = window_at_depth(i)
        if (!window_hidden(id)) {
            draw_window(id, id == front)
        }
    }
    draw_taskbar()
    draw_menu()
}

fn flush() {
    if (damage_right <= damage_left) {
        return
    }
    var x: uint64 = damage_left
    var y: uint64 = damage_top
    var w: uint64 = damage_right - damage_left
    var h: uint64 = damage_bottom - damage_top
    video_set_clip(x, y, w, h)
    paint()
    video_clear_clip()
    video_present(x, y, w, h)
    damage_left = 0
    damage_right = 0
    damage_top = 0
    damage_bottom = 0
}

fn software_cursor_hide() {
    if (software_saved == 0) {
        return
    }
    video_restore((uint64)&saved_pixels[0], software_x, software_y, CURSOR_WIDTH,
                  CURSOR_HEIGHT)
    video_present(software_x, software_y, CURSOR_WIDTH, CURSOR_HEIGHT)
    software_saved = 0
}

fn software_cursor_show() {
    software_x = mouse_x()
    software_y = mouse_y()
    if (software_x + CURSOR_WIDTH > video_width()) {
        software_x = video_width() - CURSOR_WIDTH
    }
    if (software_y + CURSOR_HEIGHT > video_height()) {
        software_y = video_height() - CURSOR_HEIGHT
    }
    video_capture((uint64)&saved_pixels[0], software_x, software_y, CURSOR_WIDTH,
                  CURSOR_HEIGHT)
    cursor_draw(software_x, software_y)
    video_present(software_x, software_y, CURSOR_WIDTH, CURSOR_HEIGHT)
    software_saved = 1
}

fn icon_under(x: uint64, y: uint64) -> uint64 {
    for i: uint64 in 0..launcher_count {
        var top: uint64 = ICON_TOP + i * (ICON_HEIGHT + 6)
        if (x >= ICON_LEFT && x < ICON_LEFT + ICON_WIDTH && y >= top &&
            y < top + ICON_HEIGHT) {
            return i
        }
    }
    return launcher_count
}

fn close_menu() {
    if (menu_open != 0) {
        menu_open = 0
        mark(0, menu_top(), MENU_WIDTH, menu_height())
    }
}

fn press_taskbar(x: uint64, y: uint64) {
    if (x < START_WIDTH) {
        if (menu_open != 0) {
            close_menu()
        } else {
            menu_open = 1
            mark(0, menu_top(), MENU_WIDTH, menu_height())
        }
        mark(0, taskbar_top(), START_WIDTH, TASKBAR_HEIGHT)
        return
    }
    close_menu()
    for i: uint64 in 0..window_count() {
        var left: uint64 = task_button_x(i)
        if (x >= left && x < left + TASK_WIDTH) {
            var id: uint64 = window_at_depth(i)
            if (window_hidden(id)) {
                window_show(id)
                window_raise(id)
            } else if (id == window_front()) {
                window_hide(id)
            } else {
                window_raise(id)
            }
            mark_window(id)
            mark(0, taskbar_top(), video_width(), TASKBAR_HEIGHT)
            return
        }
    }
}

fn press_menu(x: uint64, y: uint64) -> bool {
    if (menu_open == 0) {
        return false
    }
    var top: uint64 = menu_top()
    if (x >= MENU_WIDTH || y < top || y >= top + menu_height()) {
        return false
    }
    if (y >= top + 8) {
        var index: uint64 = (y - top - 8) / MENU_ROW
        if (index < launcher_count) {
            close_menu()
            launch(index)
            mark(0, taskbar_top(), video_width(), TASKBAR_HEIGHT)
            return true
        }
    }
    return true
}

fn press(x: uint64, y: uint64) {
    if (y >= taskbar_top()) {
        press_taskbar(x, y)
        return
    }
    if (press_menu(x, y)) {
        return
    }
    close_menu()

    var id: uint64 = window_under(x, y)
    if (id < WINDOW_SLOTS && !window_hidden(id)) {
        var was_front: bool = id == window_front()
        window_raise(id)
        if (!was_front) {
            mark_window(id)
            mark(0, taskbar_top(), video_width(), TASKBAR_HEIGHT)
        }
        var button: uint64 = window_button_at(id, x, y)
        if (button == 2) {
            mark_window(id)
            window_close(id)
            mark(0, taskbar_top(), video_width(), TASKBAR_HEIGHT)
            return
        }
        if (button == 0) {
            mark_window(id)
            window_hide(id)
            mark(0, taskbar_top(), video_width(), TASKBAR_HEIGHT)
            return
        }
        if (button == 1) {
            mark_window(id)
            window_toggle_grow(id, video_width(), work_height())
            mark_window(id)
            return
        }
        if (window_on_title(id, y)) {
            dragging = id
            drag_x = (int64)x
            drag_y = (int64)y
            return
        }
        var content_x: uint64 = window_content_x(id)
        var content_y: uint64 = window_content_y(id)
        if (x >= content_x && y >= content_y) {
            window_send_click(id, x - content_x, y - content_y)
            mark_window(id)
        }
        return
    }

    var icon: uint64 = icon_under(x, y)
    if (icon < launcher_count) {
        launch(icon)
        mark(0, taskbar_top(), video_width(), TASKBAR_HEIGHT)
    }
}

fn poll_mouse() {
    var moved: bool = mouse_take_motion()
    var down: uint64 = 0
    if (mouse_left_down()) {
        down = 1
    }
    var x: uint64 = mouse_x()
    var y: uint64 = mouse_y()

    if (moved) {
        cursor_move(x, y)
    }
    if (down != 0 && was_down == 0) {
        press(x, y)
    }
    if (down == 0 && was_down != 0) {
        dragging = WINDOW_SLOTS
    }
    was_down = down

    if (moved && dragging < WINDOW_SLOTS) {
        mark_window(dragging)
        window_move(dragging, (int64)x - drag_x, (int64)y - drag_y)
        drag_x = (int64)x
        drag_y = (int64)y
        mark_window(dragging)
    }
}

fn poll_keys() {
    while (keyboard_ready()) {
        var ch: uint8 = keyboard_read()
        var front: uint64 = window_front()
        if (front < WINDOW_SLOTS && !window_hidden(front)) {
            window_send_key(front, ch)
        }
    }
}

export fn desktop_init() {
    register("terminal", KIND_TERMINAL, &app_terminal_open)
    register("files", KIND_FILES, &app_files_open)
    register("tasks", KIND_TASKS, &app_tasks_open)
    register("clock", KIND_CLOCK, &app_clock_open)
    register("about", KIND_ABOUT, &app_about_open)
    mouse_init(video_width(), video_height())
    cursor_build()
    if (cursor_upload()) {
        console_write_line("the pointer is a hardware cursor")
        cursor_move(video_width() / 2, video_height() / 2)
    }
}

export fn desktop_run() {
    mark_all()
    flush()
    if (!cursor_on_gpu()) {
        software_cursor_show()
    }
    while (true) {
        if (!cursor_on_gpu()) {
            software_cursor_hide()
        }
        poll_keys()
        poll_mouse()
        if (terminal_touched()) {
            terminal_settle()
            var id: uint64 = window_of_kind(KIND_TERMINAL)
            if (id < WINDOW_SLOTS && !window_hidden(id)) {
                mark(window_content_x(id), window_content_y(id),
                     window_content_width(id), window_content_height(id))
            }
        }
        if (clock_ticks() / CLOCK_HZ != last_second) {
            last_second = clock_ticks() / CLOCK_HZ
            mark(video_width() - TRAY_WIDTH, taskbar_top(), TRAY_WIDTH,
                 TASKBAR_HEIGHT)
            var open_clock: uint64 = window_of_kind(KIND_CLOCK)
            if (open_clock < WINDOW_SLOTS && !window_hidden(open_clock)) {
                mark_window(open_clock)
            }
            var monitor: uint64 = window_of_kind(KIND_TASKS)
            if (monitor < WINDOW_SLOTS && !window_hidden(monitor)) {
                mark_window(monitor)
            }
        }
        flush()
        if (!cursor_on_gpu()) {
            software_cursor_show()
        }
        process_sleep(1)
    }
}
