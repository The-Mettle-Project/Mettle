import "layout"
import "video"
import "font"
import "theme"
import "window"
import "terminal"
import "apps"
import "mouse"
import "cursor"
import "keyboard"
import "clock"
import "page"
import "console"

const DOCK_HEIGHT: uint64 = 64
const DOCK_MARGIN: uint64 = 20
const DOCK_RADIUS: uint64 = 18
const DOCK_SLOT: uint64 = 96
const DOCK_PAD: uint64 = 16
const WINDOW_RADIUS: uint64 = 10
const SHADOW_SPREAD: uint64 = 12
const DOT_RADIUS: uint64 = 6
const LAUNCHER_SLOTS: uint64 = 5
const REFRESH_TICKS: uint64 = 20
const BLUR_REACH: uint64 = 3
const DOCK_SPRITE: uint64 = SPRITE_BASE + 0x1000

struct Launcher {
    label: cstring;
    kind: uint64;
    open: fn() -> uint64;
}

var launchers: Launcher[5]
var launcher_count: uint64 = 0

var dock_x: uint64 = 0
var dock_y: uint64 = 0
var dock_width: uint64 = 0

var stale: uint64 = 1
var dragging: uint64 = WINDOW_SLOTS
var drag_x: int64 = 0
var drag_y: int64 = 0
var was_down: uint64 = 0
var last_refresh: uint64 = 0
var hover_slot: uint64 = LAUNCHER_SLOTS
var software_x: uint64 = 0
var software_y: uint64 = 0
var software_saved: uint64 = 0
var saved_pixels: uint32[560]

fn register(label: cstring, kind: uint64, open: fn() -> uint64) {
    if (launcher_count >= LAUNCHER_SLOTS) {
        return
    }
    launchers[launcher_count].label = label
    launchers[launcher_count].kind = kind
    launchers[launcher_count].open = open
    launcher_count++
}

fn launch(index: uint64) {
    var existing: uint64 = window_of_kind(launchers[index].kind)
    if (existing < WINDOW_SLOTS) {
        window_raise(existing)
        return
    }
    launchers[index].open()
}

fn wallpaper_pixel(x: uint64, y: uint64) -> uint32 {
    var w: uint64 = video_width()
    var h: uint64 = video_height()
    var shade: uint64 = y * 255 / h
    var dither: uint64 = ((x & 3) + (y & 3) * 2) % 5
    if (shade + dither < 255) {
        shade += dither
    }
    var color: uint32 = video_mix(SKY_TOP, SKY_BOTTOM, shade)

    var teal_x: int64 = (int64)(w / 4)
    var teal_y: int64 = (int64)(h / 5)
    var dx: int64 = (int64)x - teal_x
    var dy: int64 = ((int64)y - teal_y) * 2
    var far: uint64 = (uint64)(dx * dx + dy * dy) / (w * 2)
    if (far < 200) {
        color = video_mix(color, GLOW_TEAL, (200 - far) * 90 / 200)
    }

    var violet_x: int64 = (int64)(w * 4 / 5)
    var violet_y: int64 = (int64)(h * 3 / 4)
    dx = (int64)x - violet_x
    dy = ((int64)y - violet_y) * 2
    far = (uint64)(dx * dx + dy * dy) / (w * 2)
    if (far < 220) {
        color = video_mix(color, GLOW_VIOLET, (220 - far) * 80 / 220)
    }

    var edge_x: int64 = (int64)x - (int64)(w / 2)
    var edge_y: int64 = (int64)y - (int64)(h / 2)
    var reach: uint64 = (uint64)(edge_x * edge_x) / w + (uint64)(edge_y * edge_y) / h
    var vignette: uint64 = reach * 255 / (w / 3 + h / 3)
    if (vignette > 120) {
        vignette = 120
    }
    return video_mix(color, 0x000000, vignette)
}

fn build_wallpaper() {
    var pixels: uint32* = (uint32*)WALLPAPER_BASE
    for y: uint64 in 0..video_height() {
        for x: uint64 in 0..video_width() {
            pixels[y * video_width() + x] = wallpaper_pixel(x, y)
        }
    }
}

fn wallpaper_at(x: uint64, y: uint64) -> uint32 {
    var pixels: uint32* = (uint32*)WALLPAPER_BASE
    return pixels[y * video_width() + x]
}

fn build_dock_sprite() {
    var sprite: uint32* = (uint32*)DOCK_SPRITE
    for row: uint64 in 0..DOCK_HEIGHT {
        for column: uint64 in 0..dock_width {
            var red: uint64 = 0
            var green: uint64 = 0
            var blue: uint64 = 0
            var taken: uint64 = 0
            for step_y: uint64 in 0..(BLUR_REACH * 2 + 1) {
                for step_x: uint64 in 0..(BLUR_REACH * 2 + 1) {
                    var sample_x: uint64 = dock_x + column + step_x
                    var sample_y: uint64 = dock_y + row + step_y
                    if (sample_x >= BLUR_REACH && sample_y >= BLUR_REACH) {
                        sample_x -= BLUR_REACH
                        sample_y -= BLUR_REACH
                        if (sample_x < video_width() && sample_y < video_height()) {
                            var value: uint32 = wallpaper_at(sample_x, sample_y)
                            red += (uint64)((value >> 16) & 255)
                            green += (uint64)((value >> 8) & 255)
                            blue += (uint64)(value & 255)
                            taken++
                        }
                    }
                }
            }
            var blurred: uint32 = 0
            if (taken != 0) {
                blurred = (uint32)(((red / taken) << 16) | ((green / taken) << 8) |
                                   (blue / taken))
            }
            sprite[row * dock_width + column] = video_mix(blurred, DOCK_TINT, 150)
        }
    }
}

fn draw_dock() {
    video_blit(DOCK_SPRITE, dock_width * 4, 0, 0, dock_x, dock_y, dock_width,
               DOCK_HEIGHT)
    video_rounded_outline(dock_x, dock_y, dock_width, DOCK_HEIGHT, DOCK_RADIUS,
                          DOCK_EDGE, 110)
    video_blend_fill(dock_x + DOCK_RADIUS, dock_y, dock_width - DOCK_RADIUS * 2, 1,
                     HIGHLIGHT, 40)

    for i: uint64 in 0..launcher_count {
        var slot_x: uint64 = dock_x + DOCK_PAD + i * DOCK_SLOT
        var open: uint64 = window_of_kind(launchers[i].kind)
        if (i == hover_slot) {
            video_rounded_fill(slot_x, dock_y + 8, DOCK_SLOT - 12, DOCK_HEIGHT - 22,
                               8, DOCK_ACTIVE)
        }
        var glyph_x: uint64 = slot_x + (DOCK_SLOT - 12) / 2 - 12
        video_rounded_gradient(glyph_x, dock_y + 12, 24, 20, 6, ACCENT, ACCENT_DEEP,
                               true)
        video_blend_fill(glyph_x + 4, dock_y + 17, 16, 10, 0x0b1220, 200)
        var text_width: uint64 = font_text_width(launchers[i].label)
        font_draw_text_soft(slot_x + (DOCK_SLOT - 12 - text_width) / 2,
                            dock_y + DOCK_HEIGHT - 22, launchers[i].label,
                            DOCK_TEXT, 150)
        if (open < WINDOW_SLOTS) {
            video_disc(slot_x + (DOCK_SLOT - 12) / 2, dock_y + DOCK_HEIGHT - 5, 2,
                       ACCENT)
        }
    }
}

fn draw_status() {
    var text_y: uint64 = 14
    var right: uint64 = video_width() - 150
    var at: uint64 = right
    at += font_draw_two_digits(at, text_y, clock_hour(), 0xffffff)
    at += font_draw_text(at, text_y, ":", 0xffffff)
    at += font_draw_two_digits(at, text_y, clock_minute(), 0xffffff)
    at += font_draw_text(at, text_y, ":", 0xffffff)
    font_draw_two_digits(at, text_y, clock_second(), 0xffffff)

    at = right
    at += font_draw_number(at, text_y + 18, page_free_bytes() / BYTES_PER_MB,
                           WINDOW_FAINT)
    at += font_draw_text(at, text_y + 18, " mb free", WINDOW_FAINT)

    var badge: cstring = "framebuffer"
    if (video_accelerated()) {
        badge = "gpu"
    }
    font_draw_text_soft(28, text_y, "mettle os", 0xffffff, 160)
    font_draw_text_soft(28, text_y + 18, badge, ACCENT, 160)
}

fn draw_window(id: uint64, active: bool) {
    var left: uint64 = (uint64)window_x(id)
    var top: uint64 = (uint64)window_y(id)
    var w: uint64 = window_width(id)
    var h: uint64 = window_height(id)

    video_shadow(left, top, w, h, WINDOW_RADIUS, SHADOW_SPREAD, SHADOW, 210)
    video_rounded_fill(left, top, w, h, WINDOW_RADIUS, WINDOW_BODY)

    var top_shade: uint32 = TITLE_TOP_IDLE
    var bottom_shade: uint32 = TITLE_BOTTOM_IDLE
    var text_shade: uint32 = TITLE_TEXT_IDLE
    var dot: uint32 = CLOSE_DOT_IDLE
    if (active) {
        top_shade = TITLE_TOP
        bottom_shade = TITLE_BOTTOM
        text_shade = TITLE_TEXT
        dot = CLOSE_DOT
    }
    video_rounded_gradient(left, top, w, TITLE_HEIGHT, WINDOW_RADIUS, top_shade,
                           bottom_shade, false)
    if (active) {
        video_blend_fill(left + 1, top + TITLE_HEIGHT, w - 2, 1, ACCENT, 190)
    } else {
        video_blend_fill(left + 1, top + TITLE_HEIGHT, w - 2, 1, WINDOW_EDGE, 160)
    }
    video_blend_fill(left + WINDOW_RADIUS, top + 1, w - WINDOW_RADIUS * 2, 1,
                     HIGHLIGHT, 30)

    font_draw_text_soft(left + 14, top + 4, window_title(id), text_shade, 170)
    video_disc(window_close_x(id) + CLOSE_SIZE / 2,
               window_close_y(id) + CLOSE_SIZE / 2, DOT_RADIUS, dot)

    window_draw_content(id)
    video_rounded_outline(left, top, w, h, WINDOW_RADIUS, WINDOW_EDGE, 200)
}

fn compose() {
    video_blit(WALLPAPER_BASE, video_width() * 4, 0, 0, 0, 0, video_width(),
               video_height())
    draw_status()
    var front: uint64 = window_front()
    for i: uint64 in 0..window_count() {
        var id: uint64 = window_at_depth(i)
        draw_window(id, id == front)
    }
    draw_dock()
}

fn restore_under_cursor() {
    for row: uint64 in 0..CURSOR_HEIGHT {
        for column: uint64 in 0..CURSOR_WIDTH {
            video_pixel(software_x + column, software_y + row,
                        saved_pixels[row * CURSOR_WIDTH + column])
        }
    }
    video_present(software_x, software_y, CURSOR_WIDTH, CURSOR_HEIGHT)
}

fn software_cursor_hide() {
    if (software_saved == 0) {
        return
    }
    restore_under_cursor()
    software_saved = 0
}

fn software_cursor_show() {
    software_x = mouse_x()
    software_y = mouse_y()
    if (software_x + CURSOR_WIDTH > video_width()) {
        software_x = video_width() - CURSOR_WIDTH
    }
    if (software_y + CURSOR_HEIGHT > video_height()) {
        software_y = video_height() - CURSOR_HEIGHT
    }
    video_capture((uint64)&saved_pixels[0], software_x, software_y, CURSOR_WIDTH,
                  CURSOR_HEIGHT)
    cursor_draw(software_x, software_y)
    video_present(software_x, software_y, CURSOR_WIDTH, CURSOR_HEIGHT)
    software_saved = 1
}

fn dock_slot_under(x: uint64, y: uint64) -> uint64 {
    if (y < dock_y || y >= dock_y + DOCK_HEIGHT || x < dock_x + DOCK_PAD) {
        return LAUNCHER_SLOTS
    }
    var slot: uint64 = (x - dock_x - DOCK_PAD) / DOCK_SLOT
    if (slot < launcher_count) {
        return slot
    }
    return LAUNCHER_SLOTS
}

fn press(x: uint64, y: uint64) {
    stale = 1
    var slot: uint64 = dock_slot_under(x, y)
    if (slot < launcher_count) {
        launch(slot)
        return
    }

    var id: uint64 = window_under(x, y)
    if (id < WINDOW_SLOTS) {
        window_raise(id)
        if (window_on_close(id, x, y)) {
            window_close(id)
            return
        }
        if (window_on_title(id, y)) {
            dragging = id
            drag_x = (int64)x
            drag_y = (int64)y
            return
        }
        var content_x: uint64 = window_content_x(id)
        var content_y: uint64 = window_content_y(id)
        if (x >= content_x && y >= content_y) {
            window_send_click(id, x - content_x, y - content_y)
        }
    }
}

fn poll_mouse() {
    var moved: bool = mouse_take_motion()
    var down: uint64 = 0
    if (mouse_left_down()) {
        down = 1
    }
    var x: uint64 = mouse_x()
    var y: uint64 = mouse_y()

    if (moved) {
        cursor_move(x, y)
        var slot: uint64 = dock_slot_under(x, y)
        if (slot != hover_slot) {
            hover_slot = slot
            stale = 1
        }
    }

    if (down != 0 && was_down == 0) {
        press(x, y)
    }
    if (down == 0 && was_down != 0) {
        dragging = WINDOW_SLOTS
    }
    was_down = down

    if (moved && dragging < WINDOW_SLOTS) {
        window_move(dragging, (int64)x - drag_x, (int64)y - drag_y)
        drag_x = (int64)x
        drag_y = (int64)y
        stale = 1
    }
}

fn poll_keys() {
    while (keyboard_ready()) {
        var ch: uint8 = keyboard_read()
        var front: uint64 = window_front()
        if (front < WINDOW_SLOTS) {
            window_send_key(front, ch)
        }
    }
}

export fn desktop_dirty() {
    stale = 1
}

export fn desktop_init() {
    register("terminal", KIND_TERMINAL, &app_terminal_open)
    register("files", KIND_FILES, &app_files_open)
    register("tasks", KIND_TASKS, &app_tasks_open)
    register("clock", KIND_CLOCK, &app_clock_open)
    register("about", KIND_ABOUT, &app_about_open)

    dock_width = launcher_count * DOCK_SLOT + DOCK_PAD * 2 - 12
    dock_x = (video_width() - dock_width) / 2
    dock_y = video_height() - DOCK_HEIGHT - DOCK_MARGIN

    console_write_line("painting the wallpaper")
    build_wallpaper()
    build_dock_sprite()
    cursor_build()
    mouse_init(video_width(), video_height())
    if (cursor_upload()) {
        console_write_line("the pointer is a hardware cursor")
        cursor_move(video_width() / 2, video_height() / 2)
    }
}

export fn desktop_run() {
    compose()
    video_present_all()
    if (!cursor_on_gpu()) {
        software_cursor_show()
    }
    while (true) {
        if (!cursor_on_gpu()) {
            software_cursor_hide()
        }
        poll_keys()
        poll_mouse()
        if (terminal_touched()) {
            terminal_settle()
            stale = 1
        }
        if (clock_ticks() - last_refresh >= REFRESH_TICKS) {
            last_refresh = clock_ticks()
            stale = 1
        }
        if (stale != 0) {
            compose()
            video_present_all()
            stale = 0
        }
        if (!cursor_on_gpu()) {
            software_cursor_show()
        }
        clock_sleep(1)
    }
}
