const SETTLE_PORT: uint16 = 0x80

export fn port_out(port: uint16, value: uint8) {
    asm {
        mov dx, {port}
        mov al, {value}
        out dx, al
    }
}

export fn port_in(port: uint16) -> uint8 {
    var value: uint8 = 0
    asm {
        mov dx, {port}
        in al, dx
        mov {value}, al
    }
    return value
}

export fn port_out32(port: uint16, value: uint32) {
    asm {
        mov dx, {port}
        mov eax, {value}
        out dx, eax
    }
}

export fn port_in32(port: uint16) -> uint32 {
    var value: uint32 = 0
    asm {
        mov dx, {port}
        in eax, dx
        mov {value}, eax
    }
    return value
}

export fn port_settle() {
    port_out(SETTLE_PORT, 0)
}

export fn cpu_enable_interrupts() {
    asm {
        sti
    }
}

export fn cpu_disable_interrupts() {
    asm {
        cli
    }
}

export fn cpu_interrupts_on() -> bool {
    var flags: uint64 = 0
    asm {
        pushfq
        pop rax
        mov {flags}, rax
    }
    return (flags & 0x200) != 0
}

export fn cpu_restore_interrupts(was_on: bool) {
    if (was_on) {
        cpu_enable_interrupts()
    }
}

export fn cpu_halt() {
    asm {
        hlt
    }
}

export fn cpu_idle() {
    asm {
        sti
        hlt
    }
}

export fn cpu_stop() {
    cpu_disable_interrupts()
    while (true) {
        cpu_halt()
    }
}

export fn cpu_vendor(out: uint8*) {
    asm {
        push rbx
        mov rdi, {out}
        xor eax, eax
        cpuid
        mov [rdi], ebx
        mov [rdi + 4], edx
        mov [rdi + 8], ecx
        pop rbx
    }
    out[12] = 0
}

export fn port_out16(port: uint16, value: uint16) {
    asm {
        mov dx, {port}
        mov ax, {value}
        out dx, ax
    }
}

export fn port_in16(port: uint16) -> uint16 {
    var value: uint16 = 0
    asm {
        mov dx, {port}
        in ax, dx
        mov {value}, ax
    }
    return value
}

export fn port_read_words(port: uint16, buffer: uint64, words: uint64) {
    asm {
        push rdi
        push rcx
        mov dx, {port}
        mov rdi, {buffer}
        mov rcx, {words}
        cld
        rep insw
        pop rcx
        pop rdi
    }
}

export fn port_write_words(port: uint16, buffer: uint64, words: uint64) {
    asm {
        push rsi
        push rcx
        mov dx, {port}
        mov rsi, {buffer}
        mov rcx, {words}
        cld
        rep outsw
        pop rcx
        pop rsi
    }
}
