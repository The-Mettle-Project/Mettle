import "kernel/layout"
import "kernel/port"
import "kernel/serial"
import "kernel/vga"
import "kernel/console"
import "kernel/interrupt"
import "kernel/clock"
import "kernel/page"
import "kernel/heap"
import "kernel/process"
import "kernel/jobs"
import "kernel/keyboard"
import "kernel/archive"
import "kernel/shell"
import "kernel/commands"
import "kernel/status"
import "kernel/video"
import "kernel/font"
import "kernel/theme"
import "kernel/terminal"
import "kernel/window"
import "kernel/apps"
import "kernel/desktop"
import "kernel/pci"
import "kernel/svga"
import "kernel/cursor"

@naked fn _start() {
    asm {
        mov rsp, 0x90000
        call kernel_main
    parked:
        cli
        hlt
        jmp parked
    }
}

fn show_motd() {
    var motd: cstring = "motd.txt"
    if (archive_holds(archive_find(motd))) {
        cmd_cat(motd)
        console_put('\n')
    }
}

fn shell_task(argument: uint64) {
    console_write_line("")
    cmd_banner("")
    show_motd()
    shell_run(&terminal_read_key)
}

fn machine_init() {
    serial_init()
    console_add_sink(&serial_put, &serial_ignore_tint, &serial_ignore_wipe)
    page_init()
    pic_init()
    interrupt_init()
    clock_init()
    process_init()
    keyboard_init()
    cpu_enable_interrupts()
    commands_init()
}

fn text_mode() {
    console_write_line("no linear framebuffer, using the text console")
    console_add_sink(&vga_put, &vga_set_color, &vga_clear)
    console_color(COLOR_TEXT)
    console_clear()
    cmd_banner("")
    status_start()
    show_motd()
    shell_run(&keyboard_read)
}

fn desktop_mode() {
    console_write("framebuffer ")
    console_write_decimal(video_width())
    console_write(" by ")
    console_write_decimal(video_height())
    console_write_line(" in 32 bit colour")
    if (video_accelerated()) {
        console_write("the svga device is driving the screen, capabilities ")
        console_write_hex((uint64)svga_capabilities(), 8)
        console_write_line("")
    }
    console_add_sink(&terminal_put, &terminal_tint, &terminal_clear)
    terminal_clear()
    desktop_init()
    app_terminal_open()
    process_spawn((uint64)&shell_task, "shell", PRIORITY_NORMAL, 0)
    desktop_run()
}

fn kernel_main() -> uint64 {
    machine_init()
    if (video_init()) {
        desktop_mode()
    } else {
        text_mode()
    }
    return 0
}
