import "kernel/layout"
import "kernel/port"
import "kernel/serial"
import "kernel/vga"
import "kernel/console"
import "kernel/interrupt"
import "kernel/clock"
import "kernel/page"
import "kernel/task"
import "kernel/keyboard"
import "kernel/archive"
import "kernel/shell"
import "kernel/commands"
import "kernel/status"

@naked fn _start() {
    asm {
        mov rsp, 0x90000
        call kernel_main
    parked:
        cli
        hlt
        jmp parked
    }
}

fn devices_init() {
    serial_init()
    console_add_stream(&serial_put)
    console_color(COLOR_TEXT)
    console_clear()
}

fn interrupts_init() {
    pic_init()
    interrupt_init()
    clock_init()
    task_init()
    keyboard_init()
    cpu_enable_interrupts()
}

fn show_motd() {
    var motd: cstring = "motd.txt"
    if (archive_holds(archive_find(motd))) {
        cmd_cat(motd)
        console_put('\n')
    }
}

fn kernel_main() -> uint64 {
    devices_init()
    cmd_banner("")
    page_init()
    interrupts_init()
    commands_init()
    status_start()
    show_motd()
    shell_run()
    return 0
}
