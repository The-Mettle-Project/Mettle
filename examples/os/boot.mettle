@naked fn _start() {
    asm {
        bits 16
        cli
        xor ax, ax
        mov ds, ax
        mov es, ax
        mov ss, ax
        mov sp, 0x7c00
        cld
        mov [boot_drive], dl
        sti

        mov si, loading_text
        call print

        mov cx, 8
        mov si, 1
        mov bp, 0x0800
        call load_run

        mov cx, 384
        mov si, 9
        mov bp, 0x2000
        call load_run

        mov dl, [boot_drive]
        jmp 0x0000:0x8000

    load_run:
        call read_sector
        inc si
        add bp, 0x20
        loop load_run
        ret

    read_sector:
        push cx
        push si
        push bp
        mov ax, si
        xor dx, dx
        mov di, 18
        div di
        mov cl, dl
        inc cl
        xor dx, dx
        mov di, 2
        div di
        mov ch, al
        mov dh, dl
        mov dl, [boot_drive]
        mov ax, bp
        mov es, ax
        xor bx, bx
        mov ax, 0x0201
        int 0x13
        jc read_failed
        pop bp
        pop si
        pop cx
        ret
    read_failed:
        mov si, disk_text
        call print
    stopped:
        hlt
        jmp stopped

    print:
        push bx
    print_byte:
        lodsb
        test al, al
        jz print_done
        mov ah, 0x0e
        mov bx, 7
        int 0x10
        jmp print_byte
    print_done:
        pop bx
        ret

    boot_drive:
        db 0
    loading_text:
        db "loading mettle os", 13, 10, 0
    disk_text:
        db "disk error", 13, 10, 0
    }
}
