@naked fn _start() {
    asm {
        bits 16
        cli
        xor ax, ax
        mov ds, ax
        mov es, ax
        mov ss, ax
        mov sp, 0x7c00
        cld
        mov [boot_drive], dl
        sti

        mov si, loading_text
        call print

        mov ah, 0x41
        mov bx, 0x55aa
        mov dl, [boot_drive]
        int 0x13
        jc no_extensions
        cmp bx, 0xaa55
        jne no_extensions

        mov si, packet
        mov ah, 0x42
        mov dl, [boot_drive]
        int 0x13
        jc read_failed

        mov dl, [boot_drive]
        jmp 0x0000:0x8000

    no_extensions:
        mov si, plain_text
        call print
        jmp stopped
    read_failed:
        mov si, disk_text
        call print
    stopped:
        hlt
        jmp stopped

    print:
        push bx
    print_byte:
        lodsb
        test al, al
        jz print_done
        mov ah, 0x0e
        mov bx, 7
        int 0x10
        jmp print_byte
    print_done:
        pop bx
        ret

        align 4
    packet:
        db 0x10
        db 0
        dw 32
        dw 0x8000
        dw 0x0000
        dd 1
        dd 0

    boot_drive:
        db 0
    loading_text:
        db "mettle os", 13, 10, 0
    disk_text:
        db "disk error", 13, 10, 0
    plain_text:
        db "no lba bios", 13, 10, 0
    }
}
