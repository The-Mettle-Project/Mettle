extern fn DrawText(text: cstring, x: int32, y: int32, font_size: int32, color: Color) = "DrawText";
extern fn DrawFPS(x: int32, y: int32) = "DrawFPS";
extern fn MeasureText(text: cstring, font_size: int32) -> int32 = "MeasureText";
extern fn DrawRectangle(x: int32, y: int32, width: int32, height: int32, color: Color) = "DrawRectangle";
extern fn DrawRectangleLines(x: int32, y: int32, width: int32, height: int32, color: Color) = "DrawRectangleLines";

extern fn DrawSphere(center: Vector3, radius: float32, color: Color) = "DrawSphere";
extern fn DrawSphereEx(center: Vector3, radius: float32, rings: int32, slices: int32, color: Color) = "DrawSphereEx";
extern fn DrawSphereWires(center: Vector3, radius: float32, rings: int32, slices: int32, color: Color) = "DrawSphereWires";
extern fn DrawCube(position: Vector3, width: float32, height: float32, length: float32, color: Color) = "DrawCube";
extern fn DrawGrid(slices: int32, spacing: float32) = "DrawGrid";

extern fn GenMeshSphere(radius: float32, rings: int32, slices: int32) -> Mesh = "GenMeshSphere";
extern fn GenMeshCube(width: float32, height: float32, length: float32) -> Mesh = "GenMeshCube";
extern fn UploadMesh(mesh: Mesh*, is_dynamic: uint8) = "UploadMesh";
extern fn UnloadMesh(mesh: Mesh) = "UnloadMesh";
extern fn DrawMesh(mesh: Mesh, material: Material, transform: Matrix) = "DrawMesh";
extern fn DrawMeshInstanced(mesh: Mesh, material: Material, transforms: Matrix*, instances: int32) = "DrawMeshInstanced";

extern fn LoadMaterialDefault() -> Material = "LoadMaterialDefault";
extern fn SetMaterialTexture(material: Material*, map_type: int32, texture: Texture2D) = "SetMaterialTexture";
extern fn LoadModelFromMesh(mesh: Mesh) -> Model = "LoadModelFromMesh";
extern fn UnloadModel(model: Model) = "UnloadModel";
extern fn DrawModel(model: Model, position: Vector3, scale: float32, tint: Color) = "DrawModel";
extern fn DrawModelEx(model: Model, position: Vector3, rotation_axis: Vector3, rotation_angle: float32, scale: Vector3, tint: Color) = "DrawModelEx";
extern fn DrawModelWires(model: Model, position: Vector3, scale: float32, tint: Color) = "DrawModelWires";

extern fn LoadTextureFromImage(image: Image) -> Texture2D = "LoadTextureFromImage";
extern fn UnloadTexture(texture: Texture2D) = "UnloadTexture";
extern fn GenTextureMipmaps(texture: Texture2D*) = "GenTextureMipmaps";
extern fn SetTextureFilter(texture: Texture2D, filter: int32) = "SetTextureFilter";

extern fn LoadShaderFromMemory(vs_code: cstring, fs_code: cstring) -> Shader = "LoadShaderFromMemory";
extern fn GetShaderLocation(shader: Shader, uniform_name: cstring) -> int32 = "GetShaderLocation";
extern fn SetShaderValue(shader: Shader, loc_index: int32, value: rawptr, uniform_type: int32) = "SetShaderValue";
extern fn UnloadShader(shader: Shader) = "UnloadShader";

fn vec2(x: float32, y: float32) -> Vector2 {
  var v: Vector2;
  v.x = x;
  v.y = y;
  return v;
}

fn vec3(x: float32, y: float32, z: float32) -> Vector3 {
  var v: Vector3;
  v.x = x;
  v.y = y;
  v.z = z;
  return v;
}

fn rgba(r: uint8, g: uint8, b: uint8, a: uint8) -> Color {
  var c: Color;
  c.r = r;
  c.g = g;
  c.b = b;
  c.a = a;
  return c;
}

fn rgb(r: uint8, g: uint8, b: uint8) -> Color {
  return rgba(r, g, b, 255);
}

fn RAYWHITE() -> Color  { return rgb(245, 245, 245); }
fn WHITE() -> Color     { return rgb(255, 255, 255); }
fn BLACK() -> Color     { return rgb(0, 0, 0); }
fn RED() -> Color       { return rgb(230, 41, 55); }
fn GREEN() -> Color     { return rgb(0, 228, 48); }
fn BLUE() -> Color      { return rgb(0, 121, 241); }
fn GOLD() -> Color      { return rgb(255, 203, 0); }
fn ORANGE() -> Color    { return rgb(255, 161, 0); }
fn SKYBLUE() -> Color   { return rgb(102, 191, 255); }
fn DARKGRAY() -> Color  { return rgb(80, 80, 80); }
fn LIGHTGRAY() -> Color { return rgb(200, 200, 200); }
