struct Vector2 {
  x: float32;
  y: float32;
}

struct Vector3 {
  x: float32;
  y: float32;
  z: float32;
}

struct Vector4 {
  x: float32;
  y: float32;
  z: float32;
  w: float32;
}

struct Matrix {
  m0: float32;  m4: float32;  m8: float32;   m12: float32;
  m1: float32;  m5: float32;  m9: float32;   m13: float32;
  m2: float32;  m6: float32;  m10: float32;  m14: float32;
  m3: float32;  m7: float32;  m11: float32;  m15: float32;
}

struct Color {
  r: uint8;
  g: uint8;
  b: uint8;
  a: uint8;
}

struct Rectangle {
  x: float32;
  y: float32;
  width: float32;
  height: float32;
}

struct Image {
  data: rawptr;
  width: int32;
  height: int32;
  mipmaps: int32;
  format: int32;
}

struct Texture2D {
  id: uint32;
  width: int32;
  height: int32;
  mipmaps: int32;
  format: int32;
}

struct Camera3D {
  position: Vector3;
  target: Vector3;
  up: Vector3;
  fovy: float32;
  projection: int32;
}

struct Mesh {
  vertexCount: int32;
  triangleCount: int32;
  vertices: float32*;
  texcoords: float32*;
  texcoords2: float32*;
  normals: float32*;
  tangents: float32*;
  colors: uint8*;
  indices: uint16*;
  animVertices: float32*;
  animNormals: float32*;
  boneIds: uint8*;
  boneWeights: float32*;
  boneMatrices: Matrix*;
  boneCount: int32;
  vaoId: uint32;
  vboId: uint32*;
}

struct Shader {
  id: uint32;
  locs: int32*;
}

struct MaterialMap {
  texture: Texture2D;
  color: Color;
  value: float32;
}

struct Material {
  shader: Shader;
  maps: MaterialMap*;
  params: float32[4];
}

struct Model {
  transform: Matrix;
  meshCount: int32;
  materialCount: int32;
  meshes: Mesh*;
  materials: Material*;
  meshMaterial: int32*;
  boneCount: int32;
  bones: rawptr;
  bindPose: rawptr;
}

const FLAG_FULLSCREEN_MODE    = 0x00000002;
const FLAG_WINDOW_RESIZABLE   = 0x00000004;
const FLAG_WINDOW_UNDECORATED = 0x00000008;
const FLAG_MSAA_4X_HINT       = 0x00000020;
const FLAG_VSYNC_HINT         = 0x00000040;
const FLAG_WINDOW_HIDDEN      = 0x00000080;

const LOG_ALL     = 0;
const LOG_INFO    = 3;
const LOG_WARNING = 4;
const LOG_ERROR   = 5;
const LOG_NONE    = 7;

const CAMERA_PERSPECTIVE  = 0;
const CAMERA_ORTHOGRAPHIC = 1;

const KEY_SPACE  = 32;
const KEY_ONE    = 49;
const KEY_TWO    = 50;
const KEY_THREE  = 51;
const KEY_S      = 83;
const KEY_T      = 84;
const KEY_V      = 86;
const KEY_W      = 87;
const KEY_ESCAPE = 256;
const KEY_ENTER  = 257;
const KEY_RIGHT  = 262;
const KEY_LEFT   = 263;
const KEY_DOWN   = 264;
const KEY_UP     = 265;

const PIXELFORMAT_UNCOMPRESSED_R8G8B8A8 = 7;

const MATERIAL_MAP_DIFFUSE = 0;

const TEXTURE_FILTER_POINT     = 0;
const TEXTURE_FILTER_BILINEAR  = 1;
const TEXTURE_FILTER_TRILINEAR = 2;

const SHADER_UNIFORM_FLOAT = 0;
const SHADER_UNIFORM_VEC2  = 1;
const SHADER_UNIFORM_VEC3  = 2;
const SHADER_UNIFORM_VEC4  = 3;
const SHADER_UNIFORM_INT   = 4;

