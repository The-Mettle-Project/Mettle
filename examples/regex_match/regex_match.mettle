// Mettle backtracking regex benchmark (Suite 3)
//
// Compiles five patterns (literals, wildcards, bracket classes, greedy
// quantifiers, anchors) into instruction programs, then matches each one
// against 4000 generated log lines at every start offset. The matcher is
// recursive with greedy backtracking, so the work per position depends on the
// text it just read and the call depth changes constantly.
//
// Build: build.bat
// Run: regex_match.exe

import "std/io";
import "std/mem";
import "std/bench";

const LINES: int32 = 4000;
const TEXT_CAP: int64 = 655360;
const MAX_INST: int32 = 64;
const MAX_CLASS: int32 = 16;
const PATTERNS: int32 = 5;
const PASSES: int32 = 3;

const K_CHAR: int32 = 0;
const K_ANY: int32 = 1;
const K_CLASS: int32 = 2;
const K_START: int32 = 3;
const K_END: int32 = 4;

const Q_ONE: int32 = 0;
const Q_STAR: int32 = 1;
const Q_PLUS: int32 = 2;
const Q_OPT: int32 = 3;

struct Inst {
  kind: int32;
  ch: int32;
  cls: int32;
  quant: int32;
}

struct Regex {
  inst: Inst*;
  count: int32;
  class_bits: uint8*;
  class_count: int32;
  anchored: int32;
}

fn emit_cstr(dst: uint8*, pos: int32, s: cstring) -> int32 {
  var i: int32 = 0;
  while (s[i] != 0) {
    dst[pos + i] = (uint8)s[i];
    i += 1;
  }
  return pos + i;
}

fn emit_pad_int(dst: uint8*, pos: int32, v: int32, width: int32) -> int32 {
  var tmp: uint8[16];
  var n: int32 = 0;
  if (v == 0) {
    tmp[0] = 48;
    n = 1;
  }
  while (v > 0) {
    tmp[n] = (uint8)(48 + v % 10);
    v = v / 10;
    n += 1;
  }
  while (n < width) {
    tmp[n] = 48;
    n += 1;
  }
  while (n > 0) {
    n -= 1;
    dst[pos] = tmp[n];
    pos += 1;
  }
  return pos;
}

fn emit_hex(dst: uint8*, pos: int32, v: uint32, digits: int32) -> int32 {
  var i: int32 = digits;
  while (i > 0) {
    i -= 1;
    var nibble: int32 = (int32)((v >> (uint32)(i * 4)) & 15);
    if (nibble < 10) {
      dst[pos] = (uint8)(48 + nibble);
    } else {
      dst[pos] = (uint8)(87 + nibble);
    }
    pos += 1;
  }
  return pos;
}

fn gen_corpus(dst: uint8*, line_off: int32*, line_len: int32*) -> int32 {
  var state: uint32 = 3735928559;
  var pos: int32 = 0;
  var line: int32 = 0;
  while (line < LINES) {
    line_off[line] = pos;
    state = state ^ (state << 13);
    state = state ^ (state >> 17);
    state = state ^ (state << 5);

    pos = emit_pad_int(dst, pos, 2020 + (int32)(state % 7), 4);
    dst[pos] = 45;
    pos += 1;
    pos = emit_pad_int(dst, pos, 1 + (int32)(state % 12), 2);
    dst[pos] = 45;
    pos += 1;
    pos = emit_pad_int(dst, pos, 1 + (int32)(state % 28), 2);
    dst[pos] = 84;
    pos += 1;
    pos = emit_pad_int(dst, pos, (int32)(state % 24), 2);
    dst[pos] = 58;
    pos += 1;
    pos = emit_pad_int(dst, pos, (int32)(state % 60), 2);
    dst[pos] = 58;
    pos += 1;
    pos = emit_pad_int(dst, pos, (int32)((state >> 8) % 60), 2);

    var level: int32 = (int32)(state % 5);
    if (level == 0) {
      pos = emit_cstr(dst, pos, " [ERROR] ");
    } else if (level == 1) {
      pos = emit_cstr(dst, pos, " [WARN ] ");
    } else if (level == 2) {
      pos = emit_cstr(dst, pos, " [DEBUG] ");
    } else {
      pos = emit_cstr(dst, pos, " [INFO ] ");
    }

    pos = emit_cstr(dst, pos, "mod-");
    pos = emit_pad_int(dst, pos, (int32)(state % 64), 1);
    pos = emit_cstr(dst, pos, ": request id=");
    pos = emit_hex(dst, pos, state, 8);
    pos = emit_cstr(dst, pos, " status=");
    var status: int32 = 200;
    var roll: int32 = (int32)(state % 100);
    if (roll < 8) {
      status = 500 + (int32)(state % 4);
    } else if (roll < 20) {
      status = 400 + (int32)(state % 5);
    } else if (roll < 30) {
      status = 300 + (int32)(state % 3);
    }
    pos = emit_pad_int(dst, pos, status, 3);
    pos = emit_cstr(dst, pos, " took=");
    pos = emit_pad_int(dst, pos, 1 + (int32)((state >> 4) % 9000), 1);
    pos = emit_cstr(dst, pos, "ms");

    line_len[line] = pos - line_off[line];
    dst[pos] = 10;
    pos += 1;
    line += 1;
  }
  dst[pos] = 0;
  return pos;
}

fn class_set(re: Regex*, cls: int32, ch: int32) {
  var base: int32 = cls * 32;
  re->class_bits[base + ch / 8] = (uint8)((int32)re->class_bits[base + ch / 8] | (1 << (ch % 8)));
}

fn class_has(re: Regex*, cls: int32, ch: int32) -> int32 {
  var base: int32 = cls * 32;
  return ((int32)re->class_bits[base + ch / 8] >> (ch % 8)) & 1;
}

fn compile(re: Regex*, pattern: cstring) {
  re->count = 0;
  re->class_count = 0;
  re->anchored = 0;
  var i: int32 = 0;
  while (i < MAX_CLASS * 32) {
    re->class_bits[i] = 0;
    i += 1;
  }
  i = 0;
  while (pattern[i] != 0 && re->count < MAX_INST) {
    var c: int32 = (int32)pattern[i];
    var kind: int32 = K_CHAR;
    var ch: int32 = c;
    var cls: int32 = -1;
    if (c == 94 && i == 0) {
      kind = K_START;
      re->anchored = 1;
      i += 1;
    } else if (c == 36 && pattern[i + 1] == 0) {
      kind = K_END;
      i += 1;
    } else if (c == 46) {
      kind = K_ANY;
      i += 1;
    } else if (c == 91) {
      kind = K_CLASS;
      cls = re->class_count;
      re->class_count += 1;
      i += 1;
      var negate: int32 = 0;
      if ((int32)pattern[i] == 94) {
        negate = 1;
        i += 1;
      }
      while (pattern[i] != 0 && (int32)pattern[i] != 93) {
        var lo: int32 = (int32)pattern[i];
        if ((int32)pattern[i + 1] == 45 && pattern[i + 2] != 0 && (int32)pattern[i + 2] != 93) {
          var hi: int32 = (int32)pattern[i + 2];
          var v: int32 = lo;
          while (v <= hi) {
            class_set(re, cls, v);
            v += 1;
          }
          i += 3;
        } else {
          class_set(re, cls, lo);
          i += 1;
        }
      }
      if ((int32)pattern[i] == 93) {
        i += 1;
      }
      if (negate != 0) {
        var b: int32 = 0;
        while (b < 32) {
          re->class_bits[cls * 32 + b] = (uint8)(~(int32)re->class_bits[cls * 32 + b] & 255);
          b += 1;
        }
      }
    } else {
      i += 1;
    }

    var quant: int32 = Q_ONE;
    var q: int32 = (int32)pattern[i];
    if (q == 42) {
      quant = Q_STAR;
      i += 1;
    } else if (q == 43) {
      quant = Q_PLUS;
      i += 1;
    } else if (q == 63) {
      quant = Q_OPT;
      i += 1;
    }

    re->inst[re->count].kind = kind;
    re->inst[re->count].ch = ch;
    re->inst[re->count].cls = cls;
    re->inst[re->count].quant = quant;
    re->count += 1;
  }
}

fn inst_matches(re: Regex*, pc: int32, ch: int32) -> int32 {
  var kind: int32 = re->inst[pc].kind;
  if (kind == K_ANY) {
    return 1;
  }
  if (kind == K_CHAR) {
    if (re->inst[pc].ch == ch) {
      return 1;
    }
    return 0;
  }
  if (kind == K_CLASS) {
    return class_has(re, re->inst[pc].cls, ch);
  }
  return 0;
}

fn match_here(re: Regex*, pc: int32, text: uint8*, pos: int32, end: int32) -> int32 {
  if (pc >= re->count) {
    return pos;
  }
  var kind: int32 = re->inst[pc].kind;
  if (kind == K_START) {
    return match_here(re, pc + 1, text, pos, end);
  }
  if (kind == K_END) {
    if (pos == end) {
      return match_here(re, pc + 1, text, pos, end);
    }
    return -1;
  }
  var quant: int32 = re->inst[pc].quant;
  if (quant == Q_STAR || quant == Q_PLUS) {
    var run: int32 = 0;
    while (pos + run < end && inst_matches(re, pc, (int32)text[pos + run]) != 0) {
      run += 1;
    }
    var floor_count: int32 = 0;
    if (quant == Q_PLUS) {
      floor_count = 1;
    }
    while (run >= floor_count) {
      var r: int32 = match_here(re, pc + 1, text, pos + run, end);
      if (r >= 0) {
        return r;
      }
      if (run == 0) {
        break;
      }
      run -= 1;
    }
    return -1;
  }
  if (quant == Q_OPT) {
    if (pos < end && inst_matches(re, pc, (int32)text[pos]) != 0) {
      var r: int32 = match_here(re, pc + 1, text, pos + 1, end);
      if (r >= 0) {
        return r;
      }
    }
    return match_here(re, pc + 1, text, pos, end);
  }
  if (pos < end && inst_matches(re, pc, (int32)text[pos]) != 0) {
    return match_here(re, pc + 1, text, pos + 1, end);
  }
  return -1;
}

fn scan_lines(re: Regex*, text: uint8*, line_off: int32*, line_len: int32*, out_span: int64*) -> int32 {
  var hits: int32 = 0;
  var span: int64 = 0;
  var line: int32 = 0;
  while (line < LINES) {
    var start: int32 = line_off[line];
    var end: int32 = start + line_len[line];
    var pos: int32 = start;
    for (;;) {
      var r: int32 = match_here(re, 0, text, pos, end);
      if (r >= 0) {
        hits += 1;
        span = span + (int64)(r - pos);
        break;
      }
      if (re->anchored != 0 || pos >= end) {
        break;
      }
      pos += 1;
    }
    line += 1;
  }
  *out_span = span;
  return hits;
}

fn pattern_text(index: int32) -> cstring {
  switch (index) {
    case 0: return "^[0-9]+-[0-9]+-[0-9]+T";
    case 1: return "status=5[0-9][0-9]";
    case 2: return "id=[a-f0-9]+ ";
    case 3: return "took=[0-9]+ms$";
    default: return "mod-[0-9]+: r.quest";
  }
}

fn run_patterns(re: Regex*, text: uint8*, line_off: int32*, line_len: int32*) -> uint64 {
  var h: uint64 = 14695981039346656037;
  var p: int32 = 0;
  while (p < PATTERNS) {
    compile(re, pattern_text(p));
    var span: int64 = 0;
    var hits: int32 = scan_lines(re, text, line_off, line_len, &span);
    h = h * 1000003 + (uint64)hits;
    h = h * 31 + (uint64)span;
    h = h ^ (uint64)(re->count * 7 + re->class_count);
    p += 1;
  }
  return h;
}

fn main() -> int32 {
  var text: uint8* = malloc(TEXT_CAP);
  var line_off: int32* = malloc((int64)LINES * 4);
  var line_len: int32* = malloc((int64)LINES * 4);
  var inst: Inst* = malloc((int64)MAX_INST * sizeof(Inst));
  var class_bits: uint8* = malloc((int64)MAX_CLASS * 32);
  if (text == 0 || line_off == 0 || line_len == 0 || inst == 0 || class_bits == 0) {
    println("malloc failed");
    return 1;
  }

  var text_len: int32 = gen_corpus(text, line_off, line_len);

  var re: Regex;
  re.inst = inst;
  re.count = 0;
  re.class_bits = class_bits;
  re.class_count = 0;
  re.anchored = 0;

  println("Regex match: {LINES} log lines, {text_len} bytes, {PATTERNS} patterns");

  var p: int32 = 0;
  while (p < PATTERNS) {
    compile(&re, pattern_text(p));
    var span: int64 = 0;
    var hits: int32 = scan_lines(&re, text, line_off, line_len, &span);
    println("  pattern {p}: {re.count} instructions, {hits} lines matched, span {span}");
    p += 1;
  }

  var check: uint64 = run_patterns(&re, text, line_off, line_len);
  println("Checksum = {check}");

  println("Benchmark: {PASSES} passes ({PATTERNS} patterns over {LINES} lines each)");

  var t0: int64 = bench_time_us();
  var bench_hash: uint64 = 0;
  var pass: int32 = 0;
  while (pass < PASSES) {
    bench_hash = bench_hash * 1000003 + run_patterns(&re, text, line_off, line_len);
    pass += 1;
  }
  var elapsed_us: int64 = bench_time_us() - t0;

  println("Bench hash = {bench_hash}");
  print("Time: ");
  print("{elapsed_us}");
  println(" us");

  var per_pass: int64 = elapsed_us / PASSES;
  print("Per pass: ~");
  print("{per_pass}");
  println(" us");

  free(text);
  free(line_off);
  free(line_len);
  free(inst);
  free(class_bits);
  return 0;
}
