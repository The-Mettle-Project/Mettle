// Mettle prime-count benchmark
//
// Counts primes up to 50000 via trial division. 200 passes.
//
// Build: build.bat
// Run: prime_count.exe

import "std/io";
import "std/bench";

fn is_prime(n: int64) -> int32 {
  if (n < 2) {
    return 0;
  }
  var d: int64 = 2;
  while (d * d <= n) {
    if (n % d == 0) {
      return 0;
    }
    d = d + 1;
  }
  return 1;
}

fn count_primes(limit: int64) -> int64 {
  var count: int64 = 0;
  var n: int64 = 2;
  while (n <= limit) {
    if (is_prime(n) != 0) {
      count = count + 1;
    }
    n = n + 1;
  }
  return count;
}

fn main() -> int32 {
  var limit: int64 = 50000;
  var passes: int32 = 200;

  println("Prime count: trial division up to 50000");

  var primes: int64 = count_primes(limit);
  print("Primes = ");
  println_int(primes);

  println("Benchmark: 200 passes (count_primes)");

  var t0: int64 = bench_time_us();
  var bench_sum: int64 = 0;
  var p: int32 = 0;
  while (p < passes) {
    bench_sum = bench_sum + count_primes(limit);
    p = p + 1;
  }
  var elapsed_us: int64 = bench_time_us() - t0;

  print("Bench sum = ");
  println_int(bench_sum);

  print("Time: ");
  print_int(elapsed_us);
  println(" us");

  var per_pass: int64 = elapsed_us / passes;
  print("Per pass: ~");
  print_int(per_pass);
  println(" us");

  return 0;
}
