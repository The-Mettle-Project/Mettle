// Mettle Collatz benchmark
//
// Collatz sequence: n -> n/2 (if even) or 3n+1 (if odd), until n==1.
// Counts steps for n=1..100000, sums them. Benchmarks 10 full passes.
//
// Build: build.bat
// Run: collatz.exe

import "std/io";
import "std/bench";

// Returns number of steps to reach 1 from n (n >= 1)
fn collatz_steps(n: int64) -> int64 {
  var count: int64 = 0;
  var x: int64 = n;
  while (x > 1) {
    if (x % 2 == 0) {
      x = x / 2;
    } else {
      x = 3 * x + 1;
    }
    count = count + 1;
  }
  return count;
}

fn main() -> int32 {
  println("Collatz: sum of steps for n=1..100000");

  var sum: int64 = 0;
  var n: int64 = 1;
  while (n <= 100000) {
    sum = sum + collatz_steps(n);
    n = n + 1;
  }
  print("Sum (1..100000) = ");
  println("{sum}");

  var passes: int32 = 10;
  println("Benchmark: 10 passes (sum steps 1..100000 each)");

  var t0: int64 = bench_time_us();
  var p: int32 = 0;
  var bench_sum: int64 = 0;
  while (p < passes) {
    var i: int64 = 1;
    while (i <= 100000) {
      bench_sum = bench_sum + collatz_steps(i);
      i = i + 1;
    }
    p = p + 1;
  }
  var elapsed_us: int64 = bench_time_us() - t0;

  print("Bench sum = ");
  println("{bench_sum}");

  print("Time: ");
  print("{elapsed_us}");
  println(" us");

  var per_pass: int64 = elapsed_us / passes;
  print("Per pass: ~");
  print("{per_pass}");
  println(" us");

  return 0;
}
