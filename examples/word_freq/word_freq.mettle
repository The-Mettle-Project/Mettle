// Mettle word-frequency benchmark (Suite 3)
//
// Generates a 1 MB document over a skewed 4096-word vocabulary, tokenizes it,
// counts every word in an open-addressing hash map that grows and rehashes as
// it fills, then selects the sixteen most frequent words. The hot path is a
// probe loop whose next address depends on the hash of bytes just read, so it
// is latency bound and unpredictable rather than streamable.
//
// Build: build.bat
// Run: word_freq.exe

import "std/io";
import "std/mem";
import "std/bench";

const VOCAB: int32 = 4096;
const DOC_CAP: int64 = 1310720;
const DOC_TARGET: int32 = 1048576;
const INITIAL_CAP: int32 = 256;
const MAX_CAP: int32 = 65536;
const TOP_K: int32 = 16;
const PASSES: int32 = 15;

struct Table {
  key_off: int32*;
  key_len: int32*;
  hashes: uint32*;
  counts: int32*;
  cap: int32;
  used: int32;
}

fn make_word(dst: uint8*, pos: int32, idx: int32) -> int32 {
  var len: int32 = 3 + idx % 7;
  var v: int32 = idx;
  var k: int32 = 0;
  while (k < len) {
    dst[pos + k] = (uint8)(97 + v % 26);
    v = v / 26 + k * 7 + 3;
    k += 1;
  }
  return pos + len;
}

fn gen_doc(dst: uint8*) -> int32 {
  var state: uint32 = 2463534242;
  var pos: int32 = 0;
  var column: int32 = 0;
  while (pos < DOC_TARGET) {
    state = state ^ (state << 13);
    state = state ^ (state >> 17);
    state = state ^ (state << 5);
    var roll: int32 = (int32)(state % 1000);
    var word: int32 = 0;
    if (roll < 500) {
      word = (int32)(state % 32);
    } else if (roll < 850) {
      word = (int32)(state % 512);
    } else {
      word = (int32)(state % (uint32)VOCAB);
    }
    pos = make_word(dst, pos, word);
    if (roll % 17 == 0) {
      dst[pos] = 46;
      pos += 1;
    } else if (roll % 23 == 0) {
      dst[pos] = 44;
      pos += 1;
    }
    column += 1;
    if (column >= 12) {
      dst[pos] = 10;
      column = 0;
    } else {
      dst[pos] = 32;
    }
    pos += 1;
  }
  dst[pos] = 0;
  return pos;
}

fn hash_word(doc: uint8*, off: int32, len: int32) -> uint32 {
  var h: uint32 = 2166136261;
  var i: int32 = 0;
  while (i < len) {
    h = (h ^ (uint32)doc[off + i]) * 16777619;
    i += 1;
  }
  return h;
}

fn keys_equal(doc: uint8*, a_off: int32, b_off: int32, len: int32) -> int32 {
  var i: int32 = 0;
  while (i < len) {
    if (doc[a_off + i] != doc[b_off + i]) {
      return 0;
    }
    i += 1;
  }
  return 1;
}

fn table_reset(t: Table*, cap: int32) {
  t->cap = cap;
  t->used = 0;
  var i: int32 = 0;
  while (i < cap) {
    t->key_len[i] = 0;
    t->counts[i] = 0;
    i += 1;
  }
}

fn table_insert_raw(t: Table*, doc: uint8*, off: int32, len: int32, hash: uint32, count: int32) {
  var mask: int32 = t->cap - 1;
  var slot: int32 = (int32)(hash & (uint32)mask);
  for (;;) {
    if (t->key_len[slot] == 0) {
      t->key_off[slot] = off;
      t->key_len[slot] = len;
      t->hashes[slot] = hash;
      t->counts[slot] = count;
      t->used += 1;
      return;
    }
    if (t->hashes[slot] == hash && t->key_len[slot] == len &&
        keys_equal(doc, t->key_off[slot], off, len) != 0) {
      t->counts[slot] += count;
      return;
    }
    slot = (slot + 1) & mask;
  }
}

fn table_grow(t: Table*, doc: uint8*, spare: Table*) {
  var old_cap: int32 = t->cap;
  var new_cap: int32 = old_cap * 2;
  if (new_cap > MAX_CAP) {
    return;
  }
  table_reset(spare, new_cap);
  var i: int32 = 0;
  while (i < old_cap) {
    if (t->key_len[i] != 0) {
      table_insert_raw(spare, doc, t->key_off[i], t->key_len[i], t->hashes[i], t->counts[i]);
    }
    i += 1;
  }
  var swap_off: int32* = t->key_off;
  var swap_len: int32* = t->key_len;
  var swap_hash: uint32* = t->hashes;
  var swap_count: int32* = t->counts;
  t->key_off = spare->key_off;
  t->key_len = spare->key_len;
  t->hashes = spare->hashes;
  t->counts = spare->counts;
  t->cap = spare->cap;
  t->used = spare->used;
  spare->key_off = swap_off;
  spare->key_len = swap_len;
  spare->hashes = swap_hash;
  spare->counts = swap_count;
  spare->cap = old_cap;
}

fn count_words(t: Table*, spare: Table*, doc: uint8*, doc_len: int32) -> int32 {
  table_reset(t, INITIAL_CAP);
  var tokens: int32 = 0;
  var i: int32 = 0;
  while (i < doc_len) {
    var c: int32 = (int32)doc[i];
    if (c < 97 || c > 122) {
      i += 1;
      continue;
    }
    var start: int32 = i;
    while (i < doc_len) {
      var d: int32 = (int32)doc[i];
      if (d < 97 || d > 122) {
        break;
      }
      i += 1;
    }
    var len: int32 = i - start;
    var hash: uint32 = hash_word(doc, start, len);
    table_insert_raw(t, doc, start, len, hash, 1);
    tokens += 1;
    if (t->used * 10 >= t->cap * 7) {
      table_grow(t, doc, spare);
    }
  }
  return tokens;
}

fn top_k_hash(t: Table*, doc: uint8*, taken: int32*) -> uint64 {
  var i: int32 = 0;
  while (i < t->cap) {
    taken[i] = 0;
    i += 1;
  }
  var h: uint64 = 14695981039346656037;
  var rank: int32 = 0;
  while (rank < TOP_K) {
    var best: int32 = -1;
    var best_count: int32 = 0;
    i = 0;
    while (i < t->cap) {
      if (t->key_len[i] != 0 && taken[i] == 0 && t->counts[i] > best_count) {
        best = i;
        best_count = t->counts[i];
      }
      i += 1;
    }
    if (best < 0) {
      break;
    }
    taken[best] = 1;
    h = h * 1000003 + (uint64)(best_count * (rank + 1));
    var k: int32 = 0;
    var letters: int32 = 0;
    while (k < t->key_len[best]) {
      letters = letters * 31 + (int32)doc[t->key_off[best] + k];
      k += 1;
    }
    h = h * 31 + (uint64)letters;
    rank += 1;
  }
  return h;
}

fn main() -> int32 {
  var doc: uint8* = malloc(DOC_CAP);
  var taken: int32* = malloc((int64)MAX_CAP * 4);
  if (doc == 0 || taken == 0) {
    println("malloc failed");
    return 1;
  }

  var t: Table;
  var spare: Table;
  t.key_off = malloc((int64)MAX_CAP * 4);
  t.key_len = malloc((int64)MAX_CAP * 4);
  t.hashes = malloc((int64)MAX_CAP * 4);
  t.counts = malloc((int64)MAX_CAP * 4);
  t.cap = 0;
  t.used = 0;
  spare.key_off = malloc((int64)MAX_CAP * 4);
  spare.key_len = malloc((int64)MAX_CAP * 4);
  spare.hashes = malloc((int64)MAX_CAP * 4);
  spare.counts = malloc((int64)MAX_CAP * 4);
  spare.cap = 0;
  spare.used = 0;

  var doc_len: int32 = gen_doc(doc);
  println("Word frequency: {doc_len} byte document, {VOCAB} word vocabulary");

  var tokens: int32 = count_words(&t, &spare, doc, doc_len);
  var check: uint64 = top_k_hash(&t, doc, taken);
  println("Tokens = {tokens} distinct = {t.used} slots = {t.cap} checksum = {check}");

  println("Benchmark: {PASSES} passes (tokenize + count + top {TOP_K})");

  var t0: int64 = bench_time_us();
  var bench_hash: uint64 = 0;
  var total_tokens: int64 = 0;
  var pass: int32 = 0;
  while (pass < PASSES) {
    total_tokens = total_tokens + (int64)count_words(&t, &spare, doc, doc_len);
    bench_hash = bench_hash * 1000003 + top_k_hash(&t, doc, taken);
    pass += 1;
  }
  var elapsed_us: int64 = bench_time_us() - t0;

  println("Bench hash = {bench_hash}");
  println("Tokens seen = {total_tokens}");
  print("Time: ");
  print("{elapsed_us}");
  println(" us");

  var per_pass: int64 = elapsed_us / PASSES;
  print("Per pass: ~");
  print("{per_pass}");
  println(" us");

  free(doc);
  free(taken);
  return 0;
}
