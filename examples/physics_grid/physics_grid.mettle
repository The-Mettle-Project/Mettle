// Mettle particle simulation benchmark (Suite 3)
//
// A game-engine step loop: bucket 8192 particles into a 64x64 uniform grid with
// a counting sort, resolve collisions against the nine neighbouring cells, then
// integrate and bounce off the walls. Integer bucketing feeds float64 pair
// tests through an indirection, so the float work never sees a contiguous run.
//
// The collision response is written in its sqrt-free form (the normal impulse
// is (v_rel . delta) / |delta|^2 * delta, which needs only the squared
// distance) so both languages perform the identical IEEE sequence. Every float
// constant here is exactly representable in binary for the same reason: a
// decimal like 0.35 must round, and the two front ends need not round it the
// same way.
//
// Build: build.bat
// Run: physics_grid.exe

import "std/io";
import "std/mem";
import "std/bench";

const COUNT: int32 = 8192;
const GRID: int32 = 64;
const CELLS: int32 = 4096;
const STEPS: int32 = 12;
const PASSES: int32 = 2;
const BOX: float64 = 1024.0;
const CELL_SIZE: float64 = 16.0;
const RADIUS: float64 = 3.0;
const MIN_DIST2: float64 = 36.0;
const DT: float64 = 0.25;

struct Particle {
  x: float64;
  y: float64;
  vx: float64;
  vy: float64;
}

struct World {
  live: Particle*;
  start: Particle*;
  cell_start: int32*;
  cursor: int32*;
  items: int32*;
  collisions: int64;
}

fn seed_world(w: World*) {
  var state: uint32 = 2654435761;
  var i: int32 = 0;
  while (i < COUNT) {
    state = state ^ (state << 13);
    state = state ^ (state >> 17);
    state = state ^ (state << 5);
    var px: float64 = RADIUS + (float64)(state % 4000) * 0.25;
    state = state ^ (state << 13);
    state = state ^ (state >> 17);
    state = state ^ (state << 5);
    var py: float64 = RADIUS + (float64)(state % 4000) * 0.25;
    state = state ^ (state << 13);
    state = state ^ (state >> 17);
    state = state ^ (state << 5);
    var vx: float64 = ((float64)(state % 256) - 128.0) / 128.0;
    state = state ^ (state << 13);
    state = state ^ (state >> 17);
    state = state ^ (state << 5);
    var vy: float64 = ((float64)(state % 256) - 128.0) / 128.0;
    w->start[i].x = px;
    w->start[i].y = py;
    w->start[i].vx = vx;
    w->start[i].vy = vy;
    i += 1;
  }
}

fn reset_world(w: World*) {
  var i: int32 = 0;
  while (i < COUNT) {
    w->live[i].x = w->start[i].x;
    w->live[i].y = w->start[i].y;
    w->live[i].vx = w->start[i].vx;
    w->live[i].vy = w->start[i].vy;
    i += 1;
  }
  w->collisions = 0;
}

fn cell_of(w: World*, i: int32) -> int32 {
  var cx: int32 = (int32)(w->live[i].x / CELL_SIZE);
  var cy: int32 = (int32)(w->live[i].y / CELL_SIZE);
  if (cx < 0) {
    cx = 0;
  }
  if (cy < 0) {
    cy = 0;
  }
  if (cx >= GRID) {
    cx = GRID - 1;
  }
  if (cy >= GRID) {
    cy = GRID - 1;
  }
  return cy * GRID + cx;
}

fn bucket(w: World*) {
  var c: int32 = 0;
  while (c <= CELLS) {
    w->cell_start[c] = 0;
    c += 1;
  }
  var i: int32 = 0;
  while (i < COUNT) {
    w->cell_start[cell_of(w, i) + 1] += 1;
    i += 1;
  }
  c = 0;
  while (c < CELLS) {
    w->cell_start[c + 1] += w->cell_start[c];
    c += 1;
  }
  c = 0;
  while (c <= CELLS) {
    w->cursor[c] = w->cell_start[c];
    c += 1;
  }
  i = 0;
  while (i < COUNT) {
    var cell: int32 = cell_of(w, i);
    w->items[w->cursor[cell]] = i;
    w->cursor[cell] += 1;
    i += 1;
  }
}

fn resolve(w: World*, i: int32, j: int32) {
  var dx: float64 = w->live[j].x - w->live[i].x;
  var dy: float64 = w->live[j].y - w->live[i].y;
  var d2: float64 = dx * dx + dy * dy;
  if (d2 >= MIN_DIST2 || d2 <= 0.0) {
    return;
  }
  w->collisions = w->collisions + 1;

  var rvx: float64 = w->live[j].vx - w->live[i].vx;
  var rvy: float64 = w->live[j].vy - w->live[i].vy;
  var approach: float64 = rvx * dx + rvy * dy;
  if (approach < 0.0) {
    var factor: float64 = approach / d2;
    w->live[i].vx = w->live[i].vx + factor * dx;
    w->live[i].vy = w->live[i].vy + factor * dy;
    w->live[j].vx = w->live[j].vx - factor * dx;
    w->live[j].vy = w->live[j].vy - factor * dy;
  }

  var push: float64 = (MIN_DIST2 - d2) / (MIN_DIST2 * 8.0);
  w->live[i].x = w->live[i].x - dx * push;
  w->live[i].y = w->live[i].y - dy * push;
  w->live[j].x = w->live[j].x + dx * push;
  w->live[j].y = w->live[j].y + dy * push;
}

fn collide(w: World*) {
  var i: int32 = 0;
  while (i < COUNT) {
    var cx: int32 = (int32)(w->live[i].x / CELL_SIZE);
    var cy: int32 = (int32)(w->live[i].y / CELL_SIZE);
    if (cx < 0) {
      cx = 0;
    }
    if (cy < 0) {
      cy = 0;
    }
    if (cx >= GRID) {
      cx = GRID - 1;
    }
    if (cy >= GRID) {
      cy = GRID - 1;
    }
    var gy: int32 = cy - 1;
    while (gy <= cy + 1) {
      if (gy >= 0 && gy < GRID) {
        var gx: int32 = cx - 1;
        while (gx <= cx + 1) {
          if (gx >= 0 && gx < GRID) {
            var cell: int32 = gy * GRID + gx;
            var k: int32 = w->cell_start[cell];
            var stop: int32 = w->cell_start[cell + 1];
            while (k < stop) {
              var j: int32 = w->items[k];
              if (j > i) {
                resolve(w, i, j);
              }
              k += 1;
            }
          }
          gx += 1;
        }
      }
      gy += 1;
    }
    i += 1;
  }
}

fn integrate(w: World*) {
  var i: int32 = 0;
  while (i < COUNT) {
    w->live[i].x = w->live[i].x + w->live[i].vx * DT;
    w->live[i].y = w->live[i].y + w->live[i].vy * DT;
    if (w->live[i].x < RADIUS) {
      w->live[i].x = RADIUS;
      w->live[i].vx = -w->live[i].vx;
    }
    if (w->live[i].x > BOX - RADIUS) {
      w->live[i].x = BOX - RADIUS;
      w->live[i].vx = -w->live[i].vx;
    }
    if (w->live[i].y < RADIUS) {
      w->live[i].y = RADIUS;
      w->live[i].vy = -w->live[i].vy;
    }
    if (w->live[i].y > BOX - RADIUS) {
      w->live[i].y = BOX - RADIUS;
      w->live[i].vy = -w->live[i].vy;
    }
    i += 1;
  }
}

fn simulate(w: World*) -> uint64 {
  reset_world(w);
  var step: int32 = 0;
  while (step < STEPS) {
    bucket(w);
    collide(w);
    integrate(w);
    step += 1;
  }
  var h: uint64 = 14695981039346656037;
  var i: int32 = 0;
  while (i < COUNT) {
    h = h * 1000003 + (uint64)(int64)(w->live[i].x * 1000.0);
    h = h * 31 + (uint64)(int64)(w->live[i].y * 1000.0);
    h = h ^ (uint64)(int64)(w->live[i].vx * 100000.0);
    h = h ^ (uint64)(int64)(w->live[i].vy * 100000.0);
    i += 1;
  }
  h = h * 31 + (uint64)w->collisions;
  return h;
}

fn main() -> int32 {
  var live: Particle* = malloc((int64)COUNT * sizeof(Particle));
  var start: Particle* = malloc((int64)COUNT * sizeof(Particle));
  var cell_start: int32* = malloc((int64)(CELLS + 1) * 4);
  var cursor: int32* = malloc((int64)(CELLS + 1) * 4);
  var items: int32* = malloc((int64)COUNT * 4);
  if (live == 0 || start == 0 || cell_start == 0 || cursor == 0 || items == 0) {
    println("malloc failed");
    return 1;
  }

  var w: World;
  w.live = live;
  w.start = start;
  w.cell_start = cell_start;
  w.cursor = cursor;
  w.items = items;
  w.collisions = 0;

  seed_world(&w);

  println("Particle sim: {COUNT} particles, {GRID}x{GRID} grid, {STEPS} steps");

  var check: uint64 = simulate(&w);
  println("Collisions = {w.collisions} checksum = {check}");

  println("Benchmark: {PASSES} passes ({STEPS} steps each)");

  var t0: int64 = bench_time_us();
  var bench_hash: uint64 = 0;
  var total_collisions: int64 = 0;
  var pass: int32 = 0;
  while (pass < PASSES) {
    bench_hash = bench_hash * 1000003 + simulate(&w);
    total_collisions = total_collisions + w.collisions;
    pass += 1;
  }
  var elapsed_us: int64 = bench_time_us() - t0;

  println("Bench hash = {bench_hash}");
  println("Collisions = {total_collisions}");
  print("Time: ");
  print("{elapsed_us}");
  println(" us");

  var per_pass: int64 = elapsed_us / PASSES;
  print("Per pass: ~");
  print("{per_pass}");
  println(" us");

  free(live);
  free(start);
  free(cell_start);
  free(cursor);
  free(items);
  return 0;
}
