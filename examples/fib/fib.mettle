// Mettle Fibonacci benchmark
//
// - fib(n): iterative loop (matches fib.c)
// - fib35(): fully unrolled fib(35)
// - bench_looped / bench_unrolled: no I/O, no calls in hot path (fair vs C timing)
//
// Build: build.bat
// Run: fib.exe

import "std/io";
import "std/bench";

fn fib(n: int32) -> int64 {
  if (n <= 1) {
    return n;
  }
  var a: int64 = 0;
  var b: int64 = 1;
  var next: int64 = 0;
  var i: int32 = 2;
  while (i <= n) {
    next = a + b;
    a = b;
    b = next;
    i = i + 1;
  }
  return b;
}

fn fib35() -> int64 {
  var a: int64 = 0;
  var b: int64 = 1;
  var next: int64 = 0;
    next = a + b; a = b; b = next;
    next = a + b; a = b; b = next;
    next = a + b; a = b; b = next;
    next = a + b; a = b; b = next;
    next = a + b; a = b; b = next;
    next = a + b; a = b; b = next;
    next = a + b; a = b; b = next;
    next = a + b; a = b; b = next;
    next = a + b; a = b; b = next;
    next = a + b; a = b; b = next;
    next = a + b; a = b; b = next;
    next = a + b; a = b; b = next;
    next = a + b; a = b; b = next;
    next = a + b; a = b; b = next;
    next = a + b; a = b; b = next;
    next = a + b; a = b; b = next;
    next = a + b; a = b; b = next;
    next = a + b; a = b; b = next;
    next = a + b; a = b; b = next;
    next = a + b; a = b; b = next;
    next = a + b; a = b; b = next;
    next = a + b; a = b; b = next;
    next = a + b; a = b; b = next;
    next = a + b; a = b; b = next;
    next = a + b; a = b; b = next;
    next = a + b; a = b; b = next;
    next = a + b; a = b; b = next;
    next = a + b; a = b; b = next;
    next = a + b; a = b; b = next;
    next = a + b; a = b; b = next;
    next = a + b; a = b; b = next;
    next = a + b; a = b; b = next;
    next = a + b; a = b; b = next;
    next = a + b; a = b; b = next;
  return b;
}

// Inner while (i <= 35) is unrolled by the optimizer; hot path has no calls.
fn bench_looped(iter: int32) -> int64 {
  var bench_sum: int64 = 0;
  var j: int32 = 0;
  while (j < iter) {
    var a: int64 = 0;
    var b: int64 = 1;
    var next: int64 = 0;
    var i: int32 = 2;
    while (i <= 35) {
      next = a + b;
      a = b;
      b = next;
      i = i + 1;
    }
    bench_sum = bench_sum + b;
    j = j + 1;
  }
  return bench_sum;
}

// Stress-test: 10M x unrolled fib(35) body (no calls).
fn bench_unrolled(iter: int32) -> int64 {
  var bench_sum: int64 = 0;
  var j: int32 = 0;
  while (j < iter) {
    var a: int64 = 0;
    var b: int64 = 1;
    var next: int64 = 0;
    next = a + b; a = b; b = next;
    next = a + b; a = b; b = next;
    next = a + b; a = b; b = next;
    next = a + b; a = b; b = next;
    next = a + b; a = b; b = next;
    next = a + b; a = b; b = next;
    next = a + b; a = b; b = next;
    next = a + b; a = b; b = next;
    next = a + b; a = b; b = next;
    next = a + b; a = b; b = next;
    next = a + b; a = b; b = next;
    next = a + b; a = b; b = next;
    next = a + b; a = b; b = next;
    next = a + b; a = b; b = next;
    next = a + b; a = b; b = next;
    next = a + b; a = b; b = next;
    next = a + b; a = b; b = next;
    next = a + b; a = b; b = next;
    next = a + b; a = b; b = next;
    next = a + b; a = b; b = next;
    next = a + b; a = b; b = next;
    next = a + b; a = b; b = next;
    next = a + b; a = b; b = next;
    next = a + b; a = b; b = next;
    next = a + b; a = b; b = next;
    next = a + b; a = b; b = next;
    next = a + b; a = b; b = next;
    next = a + b; a = b; b = next;
    next = a + b; a = b; b = next;
    next = a + b; a = b; b = next;
    next = a + b; a = b; b = next;
    next = a + b; a = b; b = next;
    next = a + b; a = b; b = next;
    next = a + b; a = b; b = next;
    bench_sum = bench_sum + b;
    j = j + 1;
  }
  return bench_sum;
}

fn main() -> int32 {
  var iter: int32 = 10000000;
  var check: int64 = fib35();
  if (fib(35) != check) {
    return 1;
  }

  var t0: int64 = bench_time_us();
  var bench_sum: int64 = bench_unrolled(iter);
  var elapsed_us: int64 = bench_time_us() - t0;

  println("Fibonacci 0..35:");

  var seq_a: int64 = 0;
  var seq_b: int64 = 1;
  print("{seq_a}");
  var n: int32 = 1;
  while (n <= 35) {
    print(" ");
    print("{seq_b}");
    var next: int64 = seq_a + seq_b;
    seq_a = seq_b;
    seq_b = next;
    n = n + 1;
  }
  newline();

  println("Benchmark: fib(35) x 10,000,000");

  print("fib(35) = ");
  println("{check}");

  print("Bench sum mod check = ");
  println("{bench_sum % check}");

  print("Time: ");
  print("{elapsed_us}");
  println(" us");

  var per_call: int64 = elapsed_us * 1000 / iter;
  print("Per call: ~");
  print("{per_call}");
  println(" ns");

  var t2: int64 = bench_time_us();
  var bench_looped_sum: int64 = bench_looped(iter);
  var t3: int64 = bench_time_us();
  if (bench_looped_sum % check != 0) {
    return 2;
  }

  print("Time (looped fib, vs C): ");
  print("{t3 - t2}");
  println(" us");

  return 0;
}
