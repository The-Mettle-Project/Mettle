// Mettle popcount microbenchmark
//
// Population count over 256 KB byte buffer, 200 passes.

import "std/io";
import "std/mem";
import "std/bench";

fn popcount_byte(b: uint8) -> int32 {
  var count: int32 = 0;
  var v: uint8 = b;
  while (v != 0) {
    count = count + (int32)(v & 1);
    v = (uint8)(v / 2);
  }
  return count;
}

fn popcount_buffer(buf: cstring, len: int64) -> int64 {
  var total: int64 = 0;
  var i: int64 = 0;
  while (i < len) {
    total = total + (int64)popcount_byte((uint8)buf[i]);
    i = i + 1;
  }
  return total;
}

fn main() -> int32 {
  var buf_size: int64 = 262144;
  var template: string = "0123456789abcdef";
  var template_len: int64 = 16;
  var passes: int32 = 200;

  var buf: cstring = malloc(buf_size);
  if (buf == 0) {
    println("malloc failed");
    return 1;
  }

  var pos: int64 = 0;
  while (pos < buf_size) {
    var chunk: int64 = template_len;
    if (pos + chunk > buf_size) {
      chunk = buf_size - pos;
    }
    memcpy(buf + pos, template, chunk);
    pos = pos + chunk;
  }

  println("Popcount: 256 KB buffer x 200 passes");

  var t0: int64 = bench_time_us();
  var bench_sum: int64 = 0;
  var p: int32 = 0;
  while (p < passes) {
    bench_sum = bench_sum + popcount_buffer(buf, buf_size);
    p = p + 1;
  }
  var elapsed_us: int64 = bench_time_us() - t0;

  print("Bench sum = ");
  println("{bench_sum}");
  print("Time: ");
  print("{elapsed_us}");
  println(" us");

  free(buf);
  return 0;
}
