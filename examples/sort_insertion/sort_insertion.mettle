// Mettle insertion-sort benchmark
//
// Sorts 512 int32 values (deterministic pseudo-random fill). 200 passes.
//
// Build: build.bat
// Run: sort_insertion.exe

import "std/io";
import "std/mem";
import "std/bench";

const DATA_LEN: int32 = 512;

fn fill_data(data: int32*, seed: int32) {
  var i: int32 = 0;
  while (i < DATA_LEN) {
    var v: int32 = (i * 1103515245 + seed + 12345) % 1024;
    data[i] = v;
    i = i + 1;
  }
}

fn insertion_sort(data: int32*, len: int32) {
  var i: int32 = 1;
  var cur: int32* = data + 1;
  while (i < len) {
    var key: int32 = *cur;
    var scan: int32* = cur;
    var j: int32 = i - 1;
    while (j >= 0) {
      var prev: int32* = scan - 1;
      var current: int32 = *prev;
      if (current <= key) {
        break;
      }
      *scan = current;
      scan = prev;
      j = j - 1;
    }
    *scan = key;
    cur = cur + 1;
    i = i + 1;
  }
}

fn sum_array(data: int32*, len: int32) -> int64 {
  var sum: int64 = 0;
  var i: int32 = 0;
  while (i < len) {
    sum = sum + (int64)data[i];
    i = i + 1;
  }
  return sum;
}

fn copy_array(dst: int32*, src: int32*, len: int32) {
  memcpy((cstring)((int64)dst), (cstring)((int64)src), (int64)len * 4);
}

fn main() -> int32 {
  var passes: int32 = 200;
  var data: int32[512];
  var scratch: int32[512];

  fill_data(&data[0], 42);

  println("Insertion sort: 512 int32 values");

  copy_array(&scratch[0], &data[0], DATA_LEN);
  insertion_sort(&scratch[0], DATA_LEN);
  var check: int64 = sum_array(&scratch[0], DATA_LEN);
  print("Sorted sum = ");
  println("{check}");

  println("Benchmark: 200 passes (insertion_sort)");

  var t0: int64 = bench_time_us();
  var bench_sum: int64 = 0;
  var p: int32 = 0;
  while (p < passes) {
    copy_array(&scratch[0], &data[0], DATA_LEN);
    insertion_sort(&scratch[0], DATA_LEN);
    bench_sum = bench_sum + sum_array(&scratch[0], DATA_LEN);
    p = p + 1;
  }
  var elapsed_us: int64 = bench_time_us() - t0;

  print("Bench sum = ");
  println("{bench_sum}");

  print("Time: ");
  print("{elapsed_us}");
  println(" us");

  var per_pass: int64 = elapsed_us / passes;
  print("Per pass: ~");
  print("{per_pass}");
  println(" us");

  return 0;
}
