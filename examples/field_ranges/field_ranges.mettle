// Range-constrained struct fields, checked at compile time.
//
// This is the Mettle answer to the C++26 reflection idiom where each member
// carries a [[=Range{...}]] annotation and a template walks
// nonstatic_data_members_of() to validate them. Mettle has no reflection, so
// the constraints live in a constant table beside the struct instead of on the
// members, and one generic function walks that table for any struct type.
//
// What the C++ version gets from static_assert, this gets from @test: the
// checks run inside the compiler's IR interpreter (mettle test), never reach
// the binary, and fail the build with the offending values.
//
// Test:  mettle test examples\field_ranges\field_ranges.mettle
// Build: mettle --build examples\field_ranges\field_ranges.mettle -o field_ranges

import "std/io";

// ---------------------------------------------------------------------------
// The constraint, and the schema it hangs off.
// ---------------------------------------------------------------------------

struct Range {
  lo: int32;
  hi: int32;
}

// One row per field, in declaration order. `name` is only for the failure
// message; the compile-time checks never touch it, because a constant holding
// a link-time address is outside the interpreter's subset.
struct Field {
  name:  cstring;
  range: Range;
}

// ---------------------------------------------------------------------------
// Two annotated types. The validator below is written once for both.
// ---------------------------------------------------------------------------

struct Config {
  port:        int32;
  max_threads: int32;
  timeout_ms:  int32;
}

const CONFIG_ARITY = sizeof(Config) / sizeof(int32);

const CONFIG_SCHEMA: Field[3] = [
  { name: "port",        range: { lo: 1,   hi: 65535 } },
  { name: "max_threads", range: { lo: 1,   hi: 256   } },
  { name: "timeout_ms",  range: { lo: 100, hi: 30000 } }
];

struct Window {
  width:      int32;
  height:     int32;
  refresh_hz: int32;
}

const WINDOW_ARITY = sizeof(Window) / sizeof(int32);

const WINDOW_SCHEMA: Field[3] = [
  { name: "width",      range: { lo: 320, hi: 7680 } },
  { name: "height",     range: { lo: 240, hi: 4320 } },
  { name: "refresh_hz", range: { lo: 24,  hi: 480  } }
];

// The ranges alone, in the same order. The schema above carries the names for
// runtime reporting; this one is what the compile-time tests read.
const CONFIG_BOUNDS: Range[3] = [
  { lo: 1, hi: 65535 }, { lo: 1, hi: 256 }, { lo: 100, hi: 30000 }
];

const WINDOW_BOUNDS: Range[3] = [
  { lo: 320, hi: 7680 }, { lo: 240, hi: 4320 }, { lo: 24, hi: 480 }
];

// ---------------------------------------------------------------------------
// The walk. `template for (member : nonstatic_data_members_of(^^T))` becomes a
// counted loop over the schema; `obj.[:member:]` becomes an indexed read
// through the struct's int32 view, which is exact for an all-int32 layout.
// ---------------------------------------------------------------------------

// Index of the first field outside its range, or -1 when everything holds.
fn first_violation<T>(obj: T*, bounds: Range*, n: int32) -> int32 {
  var values: int32* = (int32*)obj;
  for i in 0..n {
    var v: int32 = values[i];
    if (v < bounds[i].lo || v > bounds[i].hi) { return i; }
  }
  return -1;
}

fn validate<T>(obj: T*, bounds: Range*, n: int32) -> int32 {
  return first_violation<T>(obj, bounds, n) < 0;
}

// ---------------------------------------------------------------------------
// Sample values. They are globals rather than locals so the interpreter can
// reach them from a @test.
// ---------------------------------------------------------------------------

const GOOD_CONFIG: Config = { port: 1000, max_threads: 50,  timeout_ms: 20000 };
const BAD_CONFIG:  Config = { port: 0,    max_threads: 0,   timeout_ms: 0     };
const SLOW_CONFIG: Config = { port: 8080, max_threads: 8,   timeout_ms: 90000 };

const GOOD_WINDOW: Window = { width: 1920, height: 1080, refresh_hz: 144 };
const BAD_WINDOW:  Window = { width: 1920, height: 1080, refresh_hz: 1000 };

// ---------------------------------------------------------------------------
// The static_asserts.
// ---------------------------------------------------------------------------

@test fn test_config_bounds() -> int64 {
  assert(validate<Config>(&GOOD_CONFIG, &CONFIG_BOUNDS[0], CONFIG_ARITY) == 1);
  assert(validate<Config>(&BAD_CONFIG,  &CONFIG_BOUNDS[0], CONFIG_ARITY) == 0);
  return 0;
}

// The name table pays off here: a violation is reported per field, not as one
// opaque false.
@test fn test_config_names_the_field() -> int64 {
  assert_eq(first_violation<Config>(&GOOD_CONFIG, &CONFIG_BOUNDS[0], CONFIG_ARITY), -1);
  assert_eq(first_violation<Config>(&BAD_CONFIG,  &CONFIG_BOUNDS[0], CONFIG_ARITY), 0);
  assert_eq(first_violation<Config>(&SLOW_CONFIG, &CONFIG_BOUNDS[0], CONFIG_ARITY), 2);
  return 0;
}

// Same validator, different struct: this is the part the C++ template gets
// from being a template.
@test fn test_window_bounds() -> int64 {
  assert(validate<Window>(&GOOD_WINDOW, &WINDOW_BOUNDS[0], WINDOW_ARITY) == 1);
  assert_eq(first_violation<Window>(&BAD_WINDOW, &WINDOW_BOUNDS[0], WINDOW_ARITY), 2);
  return 0;
}

// Guards the one thing the positional schema cannot check for itself: adding a
// field to Config without adding its Range. sizeof knows the struct grew.
@test fn test_schema_matches_layout() -> int64 {
  assert_eq(CONFIG_ARITY, 3);
  assert_eq(WINDOW_ARITY, 3);
  return 0;
}

// ---------------------------------------------------------------------------
// The same check at runtime, where the names are worth carrying.
// ---------------------------------------------------------------------------

fn report<T>(label: cstring, obj: T*, schema: Field*, bounds: Range*, n: int32) {
  var bad: int32 = first_violation<T>(obj, bounds, n);
  print(label);
  if (bad < 0) {
    println(": ok");
    return;
  }
  var values: int32* = (int32*)obj;
  print(": ");
  print(schema[bad].name);
  print(" = ");
  print_int((int64)values[bad]);
  print(" is outside ");
  print_int((int64)bounds[bad].lo);
  print("..");
  print_int((int64)bounds[bad].hi);
  println("");
}

fn main() -> int32 {
  report<Config>("good config", &GOOD_CONFIG, &CONFIG_SCHEMA[0], &CONFIG_BOUNDS[0], CONFIG_ARITY);
  report<Config>("bad config",  &BAD_CONFIG,  &CONFIG_SCHEMA[0], &CONFIG_BOUNDS[0], CONFIG_ARITY);
  report<Config>("slow config", &SLOW_CONFIG, &CONFIG_SCHEMA[0], &CONFIG_BOUNDS[0], CONFIG_ARITY);
  report<Window>("good window", &GOOD_WINDOW, &WINDOW_SCHEMA[0], &WINDOW_BOUNDS[0], WINDOW_ARITY);
  report<Window>("bad window",  &BAD_WINDOW,  &WINDOW_SCHEMA[0], &WINDOW_BOUNDS[0], WINDOW_ARITY);
  return 0;
}
