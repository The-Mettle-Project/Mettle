import "std/io";
import "std/mem";
import "std/bench";
import "std/layout";

const REC_COUNT: int32 = 1048576;

@soa struct Rec {
  f0: int32;
  f1: int32;
  f2: int32;
  f3: int32;
  f4: int32;
  f5: int32;
  f6: int32;
  f7: int32;
}

fn build_records(pool: Rec[], count: int32) {
  var state: uint32 = 2463534242;
  var i: int32 = 0;
  while (i < count) {
    pool[i].f0 = i & 4095;
    state = state ^ (state << 13);
    state = state ^ (state >> 17);
    state = state ^ (state << 5);
    pool[i].f1 = (int32)(state & 65535);
    pool[i].f2 = (int32)(state >> 16);
    pool[i].f3 = i * 3;
    pool[i].f4 = i - count;
    pool[i].f5 = (i ^ 12345) & 4095;
    pool[i].f6 = i + 7;
    pool[i].f7 = (int32)(state ^ (uint32)i);
    i = i + 1;
  }
}

fn sum_field0(pool: Rec[], count: int32, seed: int64) -> int64 {
  var total: int64 = seed;
  var i: int32 = 0;
  while (i < count) {
    total = total + (int64)pool[i].f0;
    i = i + 1;
  }
  return total;
}

fn main() -> int32 {
  var count: int32 = REC_COUNT;
  var pool: Rec[] = new Rec[count];

  build_records(pool, count);

  println("Field-selective walk: 1048576 records (32B), field 0 only");

  var check: int64 = sum_field0(pool, count, 0);
  print("Checksum = ");
  println("{check}");

  var passes: int32 = 100;
  println("Benchmark: 100 passes (field_sum)");

  var t0: int64 = bench_time_us();
  var bench_sum: int64 = 0;
  var p: int32 = 0;
  while (p < passes) {
    bench_sum = bench_sum + sum_field0(pool, count, (int64)p);
    p = p + 1;
  }
  var elapsed_us: int64 = bench_time_us() - t0;

  print("Bench sum = ");
  println("{bench_sum}");
  print("Time: ");
  print("{elapsed_us}");
  println(" us");

  var per_pass: int64 = elapsed_us / passes;
  print("Per pass: ~");
  print("{per_pass}");
  println(" us");

  free(pool.data);
  return 0;
}
