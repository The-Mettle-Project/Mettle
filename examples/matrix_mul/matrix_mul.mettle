// Mettle matrix-multiply benchmark
//
// 32x32 int32 matrix multiply (naive triple loop). 200 passes.
//
// Build: build.bat
// Run: matrix_mul.exe

import "std/io";
import "std/bench";

const N: int32 = 32;

fn mat_idx(row: int32, col: int32) -> int64 {
  return (int64)row * N + col;
}

fn fill_matrix(m: int32*, seed: int32) {
  var row: int32 = 0;
  var row_base: int64 = 0;
  while (row < N) {
    var col: int32 = 0;
    var idx: int64 = row_base;
    while (col < N) {
      var v: int32 = (row * 131 + col * 17 + seed) % 251;
      m[idx] = v;
      idx = idx + 1;
      col = col + 1;
    }
    row_base = row_base + N;
    row = row + 1;
  }
}

fn matmul(a: int32*, b: int32*, c: int32*) {
  var row: int32 = 0;
  var row_base: int64 = 0;
  while (row < N) {
    var col: int32 = 0;
    while (col < N) {
      var sum0: int32 = 0;
      var sum1: int32 = 0;
      var sum2: int32 = 0;
      var sum3: int32 = 0;
      var a_idx: int64 = row_base;
      var b0_idx: int64 = col;
      var b1_idx: int64 = b0_idx + 1;
      var b2_idx: int64 = b0_idx + 2;
      var b3_idx: int64 = b0_idx + 3;
      var k: int32 = 0;
      while (k < N) {
        var av: int32 = a[a_idx];
        sum0 = sum0 + av * b[b0_idx];
        sum1 = sum1 + av * b[b1_idx];
        sum2 = sum2 + av * b[b2_idx];
        sum3 = sum3 + av * b[b3_idx];
        a_idx = a_idx + 1;
        b0_idx = b0_idx + N;
        b1_idx = b1_idx + N;
        b2_idx = b2_idx + N;
        b3_idx = b3_idx + N;
        k = k + 1;
      }
      var c_idx: int64 = row_base + col;
      c[c_idx] = sum0;
      c[c_idx + 1] = sum1;
      c[c_idx + 2] = sum2;
      c[c_idx + 3] = sum3;
      col = col + 4;
    }
    row_base = row_base + N;
    row = row + 1;
  }
}

fn trace_matrix(m: int32*) -> int64 {
  var sum: int64 = 0;
  var i: int32 = 0;
  var idx: int64 = 0;
  while (i < N) {
    sum = sum + m[idx];
    idx = idx + N + 1;
    i = i + 1;
  }
  return sum;
}

fn main() -> int32 {
  var passes: int32 = 200;
  var a: int32[1024];
  var b: int32[1024];
  var c: int32[1024];

  fill_matrix(&a[0], 3);
  fill_matrix(&b[0], 7);

  println("Matrix multiply: 32x32 int32 (naive)");

  matmul(&a[0], &b[0], &c[0]);
  var check: int64 = trace_matrix(&c[0]);
  print("Trace = ");
  println("{check}");

  println("Benchmark: 200 passes (matmul)");

  var t0: int64 = bench_time_us();
  var bench_sum: int64 = 0;
  var p: int32 = 0;
  while (p < passes) {
    matmul(&a[0], &b[0], &c[0]);
    bench_sum = bench_sum + trace_matrix(&c[0]);
    p = p + 1;
  }
  var elapsed_us: int64 = bench_time_us() - t0;

  print("Bench sum = ");
  println("{bench_sum}");

  print("Time: ");
  print("{elapsed_us}");
  println(" us");

  var per_pass: int64 = elapsed_us / passes;
  print("Per pass: ~");
  print("{per_pass}");
  println(" us");

  return 0;
}
