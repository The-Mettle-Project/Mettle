// Mettle byte-hash benchmark (djb2)
//
// Hashes a 256 KB buffer with djb2 (hash = hash * 33 + byte, seed 5381).
// Same workload as byte_hash.c: 200 passes over the filled buffer.
//
// Build: build.bat
// Run: byte_hash.exe

import "std/io";
import "std/mem";
import "std/bench";

fn byte_hash(buf: cstring, len: int64) -> int64 {
  var hash: int64 = 5381;
  var i: int64 = 0;
  while (i < len) {
    var b: int64 = (int64)(uint8)buf[i];
    hash = hash * 33 + b;
    i = i + 1;
  }
  return hash;
}

fn main() -> int32 {
  var buf_size: int64 = 262144;
  var template: string = "a b c d e f g h ";
  var template_len: int64 = 16;

  var buf: cstring = malloc(buf_size);
  if (buf == 0) {
    println("malloc failed");
    return 1;
  }

  var pos: int64 = 0;
  while (pos < buf_size) {
    var chunk: int64 = template_len;
    if (pos + chunk > buf_size) {
      chunk = buf_size - pos;
    }
    memcpy(buf + pos, template, chunk);
    pos = pos + chunk;
  }

  println("Byte hash (djb2): 256 KB buffer");

  var hash: int64 = byte_hash(buf, buf_size);
  print("Hash = ");
  println("{hash}");

  var passes: int32 = 200;
  println("Benchmark: 200 passes (byte_hash)");

  var t0: int64 = bench_time_us();
  var bench_sum: int64 = 0;
  var p: int32 = 0;
  while (p < passes) {
    bench_sum = bench_sum + byte_hash(buf, buf_size);
    p = p + 1;
  }
  var elapsed_us: int64 = bench_time_us() - t0;

  print("Bench sum = ");
  println("{bench_sum}");

  print("Time: ");
  print("{elapsed_us}");
  println(" us");

  var per_pass: int64 = elapsed_us / passes;
  print("Per pass: ~");
  print("{per_pass}");
  println(" us");

  free(buf);
  return 0;
}
