                          ws: int32, hs: int32, bits: rawptr, info: Bitmap*, usage: uint32, rop: uint32) -> int32 = "StretchDIBits";
extern fn W_QueryPerformanceCounter(counter: int64*) -> int32 = "QueryPerformanceCounter";
