struct Bitmap {
  size: uint32;
  width: int32;
  height: int32;
  planes: uint16;
  bits: uint16;
  compression: uint32;
  image_size: uint32;
  xppm: int32;
  yppm: int32;
  used: uint32;
  important: uint32;
}

struct Monitor {
  size: uint32;
  monitor: UiRect;
  work: UiRect;
  flags: uint32;
}

struct Level {
  x: float32*;
  b: float32*;
  r: float32*;
  flags: uint8*;
  nx: int32;
  ny: int32;
  nz: int32;
}

