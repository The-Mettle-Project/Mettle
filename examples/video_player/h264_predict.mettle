import "h264_decode";

fn h264_luma_sample(v: H264Video*, x: int32, y: int32) -> int32 {
  return (int32)v->luma[(int64)y * (int64)v->luma_stride + (int64)x];
}

fn h264_chroma_sample(plane: uint8*, stride: int32, x: int32, y: int32) -> int32 {
  return (int32)plane[(int64)y * (int64)stride + (int64)x];
}

fn h264_intra4x4_available(v: H264Video*, blk: int32, direction: int32) -> int32 {
  var raster: int32 = v->blk_raster[blk];
  var bx: int32 = raster & 3;
  var by: int32 = raster >> 2;

  if (direction == 0) {
    if (bx > 0) { return 1; }
    if (v->mb_x > 0) { return 1; }
    return 0;
  }
  if (direction == 1) {
    if (by > 0) { return 1; }
    if (v->mb_y > 0) { return 1; }
    return 0;
  }
  if (direction == 2) {
    if (bx > 0 && by > 0) { return 1; }
    if (bx > 0) {
      if (v->mb_y > 0) { return 1; }
      return 0;
    }
    if (by > 0) {
      if (v->mb_x > 0) { return 1; }
      return 0;
    }
    if (v->mb_x > 0 && v->mb_y > 0) { return 1; }
    return 0;
  }
  if (by > 0) {
    if (bx == 3) { return 0; }
    if (v->raster_blk[(by - 1) * 4 + bx + 1] < blk) { return 1; }
    return 0;
  }
  if (bx < 3) {
    if (v->mb_y > 0) { return 1; }
    return 0;
  }
  if (v->mb_y > 0 && v->mb_x < v->mb_width - 1) { return 1; }
  return 0;
}

fn h264_predict_intra4x4(v: H264Video*, blk: int32, mode: int32, prediction: int32*) {
  var raster: int32 = v->blk_raster[blk];
  var x: int32 = v->mb_x * 16 + (raster & 3) * 4;
  var y: int32 = v->mb_y * 16 + (raster >> 2) * 4;

  var left_ok: int32 = h264_intra4x4_available(v, blk, 0);
  var top_ok: int32 = h264_intra4x4_available(v, blk, 1);
  var corner_ok: int32 = h264_intra4x4_available(v, blk, 2);
  var right_ok: int32 = h264_intra4x4_available(v, blk, 3);

  var top: int32[9];
  var left: int32[5];
  for i in 0..9 { top[i] = 0; }
  for i in 0..5 { left[i] = 0; }

  if (top_ok != 0) {
    for i in 0..4 { top[1 + i] = h264_luma_sample(v, x + i, y - 1); }
    if (right_ok != 0) {
      for i in 4..8 { top[1 + i] = h264_luma_sample(v, x + i, y - 1); }
    } else {
      for i in 4..8 { top[1 + i] = top[4]; }
    }
  }
  if (left_ok != 0) {
    for i in 0..4 { left[1 + i] = h264_luma_sample(v, x - 1, y + i); }
  }
  if (corner_ok != 0) {
    var corner: int32 = h264_luma_sample(v, x - 1, y - 1);
    top[0] = corner;
    left[0] = corner;
  }

  if (mode == 0) {
    for row in 0..4 {
      for column in 0..4 { prediction[row * 4 + column] = top[1 + column]; }
    }
    return;
  }
  if (mode == 1) {
    for row in 0..4 {
      for column in 0..4 { prediction[row * 4 + column] = left[1 + row]; }
    }
    return;
  }
  if (mode == 2) {
    var value: int32 = 128;
    if (left_ok != 0 && top_ok != 0) {
      value = (top[1] + top[2] + top[3] + top[4] + left[1] + left[2] + left[3] + left[4] + 4) >> 3;
    } else if (left_ok != 0) {
      value = (left[1] + left[2] + left[3] + left[4] + 2) >> 2;
    } else if (top_ok != 0) {
      value = (top[1] + top[2] + top[3] + top[4] + 2) >> 2;
    }
    for i in 0..16 { prediction[i] = value; }
    return;
  }
  if (mode == 3) {
    for row in 0..4 {
      for column in 0..4 {
        var index: int32 = column + row;
        if (index == 6) {
          prediction[row * 4 + column] = (top[7] + 3 * top[8] + 2) >> 2;
        } else {
          prediction[row * 4 + column] = (top[1 + index] + 2 * top[2 + index] + top[3 + index] + 2) >> 2;
        }
      }
    }
    return;
  }
  if (mode == 4) {
    for row in 0..4 {
      for column in 0..4 {
        var value: int32 = 0;
        if (column > row) {
          var index: int32 = column - row - 1;
          value = (top[index] + 2 * top[index + 1] + top[index + 2] + 2) >> 2;
        } else if (column < row) {
          var index: int32 = row - column - 1;
          value = (left[index] + 2 * left[index + 1] + left[index + 2] + 2) >> 2;
        } else {
          value = (top[1] + 2 * top[0] + left[1] + 2) >> 2;
        }
        prediction[row * 4 + column] = value;
      }
    }
    return;
  }
  if (mode == 5) {
    for row in 0..4 {
      for column in 0..4 {
        var z: int32 = 2 * column - row;
        var value: int32 = 0;
        if (z >= 0) {
          var index: int32 = column - (row >> 1);
          if ((z & 1) == 0) {
            value = (top[index] + top[index + 1] + 1) >> 1;
          } else {
            value = (top[index - 1] + 2 * top[index] + top[index + 1] + 2) >> 2;
          }
        } else if (z == -1) {
          value = (left[1] + 2 * top[0] + top[1] + 2) >> 2;
        } else {
          value = (left[row] + 2 * left[row - 1] + left[row - 2] + 2) >> 2;
        }
        prediction[row * 4 + column] = value;
      }
    }
    return;
  }
  if (mode == 6) {
    for row in 0..4 {
      for column in 0..4 {
        var z: int32 = 2 * row - column;
        var value: int32 = 0;
        if (z >= 0) {
          var index: int32 = row - (column >> 1);
          if ((z & 1) == 0) {
            value = (left[index] + left[index + 1] + 1) >> 1;
          } else {
            value = (left[index - 1] + 2 * left[index] + left[index + 1] + 2) >> 2;
          }
        } else if (z == -1) {
          value = (left[1] + 2 * top[0] + top[1] + 2) >> 2;
        } else {
          value = (top[column] + 2 * top[column - 1] + top[column - 2] + 2) >> 2;
        }
        prediction[row * 4 + column] = value;
      }
    }
    return;
  }
  if (mode == 7) {
    for row in 0..4 {
      for column in 0..4 {
        var index: int32 = column + (row >> 1);
        var value: int32 = 0;
        if ((row & 1) == 0) {
          value = (top[1 + index] + top[2 + index] + 1) >> 1;
        } else {
          value = (top[1 + index] + 2 * top[2 + index] + top[3 + index] + 2) >> 2;
        }
        prediction[row * 4 + column] = value;
      }
    }
    return;
  }
  for row in 0..4 {
    for column in 0..4 {
      var z: int32 = column + 2 * row;
      var index: int32 = row + (column >> 1);
      var value: int32 = 0;
      if (z >= 0 && z <= 4 && (z & 1) == 0) {
        value = (left[1 + index] + left[2 + index] + 1) >> 1;
      } else if (z == 1 || z == 3) {
        value = (left[1 + index] + 2 * left[2 + index] + left[3 + index] + 2) >> 2;
      } else if (z == 5) {
        value = (left[3] + 3 * left[4] + 2) >> 2;
      } else {
        value = left[4];
      }
      prediction[row * 4 + column] = value;
    }
  }
}

fn h264_predict_intra16x16(v: H264Video*, mode: int32) {
  var x: int32 = v->mb_x * 16;
  var y: int32 = v->mb_y * 16;
  var left_ok: int32 = 0;
  var top_ok: int32 = 0;
  if (v->mb_x > 0) { left_ok = 1; }
  if (v->mb_y > 0) { top_ok = 1; }

  if (mode == 0) {
    for row in 0..16 {
      for column in 0..16 {
        v->luma[(int64)(y + row) * (int64)v->luma_stride + (int64)(x + column)] =
          v->luma[(int64)(y - 1) * (int64)v->luma_stride + (int64)(x + column)];
      }
    }
    return;
  }
  if (mode == 1) {
    for row in 0..16 {
      var value: uint8 = v->luma[(int64)(y + row) * (int64)v->luma_stride + (int64)(x - 1)];
      for column in 0..16 {
        v->luma[(int64)(y + row) * (int64)v->luma_stride + (int64)(x + column)] = value;
      }
    }
    return;
  }
  if (mode == 2) {
    var total: int32 = 0;
    var count: int32 = 0;
    if (top_ok != 0) {
      for i in 0..16 { total = total + h264_luma_sample(v, x + i, y - 1); }
      count = count + 16;
    }
    if (left_ok != 0) {
      for i in 0..16 { total = total + h264_luma_sample(v, x - 1, y + i); }
      count = count + 16;
    }
    var value: int32 = 128;
    if (count == 32) {
      value = (total + 16) >> 5;
    } else if (count == 16) {
      value = (total + 8) >> 4;
    }
    for row in 0..16 {
      for column in 0..16 {
        v->luma[(int64)(y + row) * (int64)v->luma_stride + (int64)(x + column)] = (uint8)value;
      }
    }
    return;
  }

  var horizontal: int32 = 0;
  var vertical: int32 = 0;
  for i in 0..8 {
    horizontal = horizontal + (i + 1) * (h264_luma_sample(v, x + 8 + i, y - 1) - h264_luma_sample(v, x + 6 - i, y - 1));
    vertical = vertical + (i + 1) * (h264_luma_sample(v, x - 1, y + 8 + i) - h264_luma_sample(v, x - 1, y + 6 - i));
  }
  var b: int32 = (5 * horizontal + 32) >> 6;
  var c: int32 = (5 * vertical + 32) >> 6;
  var a: int32 = 16 * (h264_luma_sample(v, x - 1, y + 15) + h264_luma_sample(v, x + 15, y - 1));
  for row in 0..16 {
    for column in 0..16 {
      var value: int32 = (a + b * (column - 7) + c * (row - 7) + 16) >> 5;
      v->luma[(int64)(y + row) * (int64)v->luma_stride + (int64)(x + column)] = h264_clip_sample(value);
    }
  }
}

fn h264_predict_chroma(v: H264Video*, plane: uint8*, mode: int32) {
  var stride: int32 = v->chroma_stride;
  var x: int32 = v->mb_x * 8;
  var y: int32 = v->mb_y * 8;
  var left_ok: int32 = 0;
  var top_ok: int32 = 0;
  if (v->mb_x > 0) { left_ok = 1; }
  if (v->mb_y > 0) { top_ok = 1; }

  if (mode == 1) {
    for row in 0..8 {
      var value: uint8 = plane[(int64)(y + row) * (int64)stride + (int64)(x - 1)];
      for column in 0..8 {
        plane[(int64)(y + row) * (int64)stride + (int64)(x + column)] = value;
      }
    }
    return;
  }
  if (mode == 2) {
    for row in 0..8 {
      for column in 0..8 {
        plane[(int64)(y + row) * (int64)stride + (int64)(x + column)] =
          plane[(int64)(y - 1) * (int64)stride + (int64)(x + column)];
      }
    }
    return;
  }
  if (mode == 3) {
    var horizontal: int32 = 0;
    var vertical: int32 = 0;
    for i in 0..4 {
      horizontal = horizontal + (i + 1) * (h264_chroma_sample(plane, stride, x + 4 + i, y - 1) -
                                           h264_chroma_sample(plane, stride, x + 2 - i, y - 1));
      vertical = vertical + (i + 1) * (h264_chroma_sample(plane, stride, x - 1, y + 4 + i) -
                                       h264_chroma_sample(plane, stride, x - 1, y + 2 - i));
    }
    var b: int32 = (34 * horizontal + 32) >> 6;
    var c: int32 = (34 * vertical + 32) >> 6;
    var a: int32 = 16 * (h264_chroma_sample(plane, stride, x - 1, y + 7) +
                         h264_chroma_sample(plane, stride, x + 7, y - 1));
    for row in 0..8 {
      for column in 0..8 {
        var value: int32 = (a + b * (column - 3) + c * (row - 3) + 16) >> 5;
        plane[(int64)(y + row) * (int64)stride + (int64)(x + column)] = h264_clip_sample(value);
      }
    }
    return;
  }

  for block in 0..4 {
    var bx: int32 = (block & 1) * 4;
    var by: int32 = (block >> 1) * 4;
    var use_top: int32 = 0;
    var use_left: int32 = 0;
    if (block == 0) {
      if (top_ok != 0) { use_top = 1; }
      if (left_ok != 0) { use_left = 1; }
    } else if (block == 1) {
      if (top_ok != 0) {
        use_top = 1;
      } else if (left_ok != 0) {
        use_left = 1;
      }
    } else if (block == 2) {
      if (left_ok != 0) {
        use_left = 1;
      } else if (top_ok != 0) {
        use_top = 1;
      }
    } else {
      if (top_ok != 0) { use_top = 1; }
      if (left_ok != 0) { use_left = 1; }
    }

    var total: int32 = 0;
    var count: int32 = 0;
    if (use_top != 0) {
      for i in 0..4 { total = total + h264_chroma_sample(plane, stride, x + bx + i, y - 1); }
      count = count + 4;
    }
    if (use_left != 0) {
      for i in 0..4 { total = total + h264_chroma_sample(plane, stride, x - 1, y + by + i); }
      count = count + 4;
    }
    var value: int32 = 128;
    if (count == 8) {
      value = (total + 4) >> 3;
    } else if (count == 4) {
      value = (total + 2) >> 2;
    }

    for row in 0..4 {
      for column in 0..4 {
        plane[(int64)(y + by + row) * (int64)stride + (int64)(x + bx + column)] = (uint8)value;
      }
    }
  }
}
