import "std/mem";
import "h264";
import "h264_decode";
import "h264_inter";

fn h264_decode_skip_flag(v: H264Video*) -> int32 {
  var base: int32 = H264_CTX_SKIP_P;
  if (v->slice_type == H264_SLICE_B) { base = H264_CTX_SKIP_B; }

  var increment: int32 = 0;
  var left: int32 = h264_left_index(v);
  var above: int32 = h264_above_index(v);
  if (left >= 0 && v->macroblocks[left].skipped == 0) { increment = increment + 1; }
  if (above >= 0 && v->macroblocks[above].skipped == 0) { increment = increment + 1; }
  return h264_decode_bin(v, base + increment);
}

fn h264_decode_intra_suffix(v: H264Video*, base: int32, out_cbp_luma: int32*,
                            out_cbp_chroma: int32*, out_mode: int32*) -> int32 {
  if (h264_decode_bin(v, base) == 0) { return H264_MB_I_NXN; }
  if (h264_decode_terminate(v) != 0) { return H264_MB_I_PCM; }
  var cbp_luma: int32 = 0;
  if (h264_decode_bin(v, base + 1) != 0) { cbp_luma = 15; }
  var cbp_chroma: int32 = 0;
  if (h264_decode_bin(v, base + 2) != 0) {
    cbp_chroma = 1;
    if (h264_decode_bin(v, base + 2) != 0) { cbp_chroma = 2; }
  }
  var mode: int32 = h264_decode_bin(v, base + 3) << 1;
  mode = mode | h264_decode_bin(v, base + 3);
  *out_cbp_luma = cbp_luma;
  *out_cbp_chroma = cbp_chroma;
  *out_mode = mode;
  return H264_MB_I_16X16;
}

fn h264_decode_mb_type_p(v: H264Video*, out_cbp_luma: int32*, out_cbp_chroma: int32*,
                         out_mode: int32*) -> int32 {
  if (h264_decode_bin(v, H264_CTX_MB_TYPE_P) != 0) {
    return h264_decode_intra_suffix(v, 17, out_cbp_luma, out_cbp_chroma, out_mode);
  }
  var second: int32 = h264_decode_bin(v, H264_CTX_MB_TYPE_P + 1);
  if (second == 0) {
    if (h264_decode_bin(v, H264_CTX_MB_TYPE_P + 2) == 0) { return H264_MB_P_16X16; }
    return H264_MB_P_8X8;
  }
  if (h264_decode_bin(v, H264_CTX_MB_TYPE_P + 3) == 0) { return H264_MB_P_8X16; }
  return H264_MB_P_16X8;
}

fn h264_decode_sub_type_p(v: H264Video*) -> int32 {
  if (h264_decode_bin(v, H264_CTX_SUB_TYPE_P) != 0) { return 0; }
  if (h264_decode_bin(v, H264_CTX_SUB_TYPE_P + 1) == 0) { return 1; }
  if (h264_decode_bin(v, H264_CTX_SUB_TYPE_P + 2) != 0) { return 2; }
  return 3;
}

fn h264_reference_available(v: H264Video*, block_x: int32, block_y: int32) -> int32 {
  if (block_x < 0 || block_y < 0) { return 0; }
  if (block_x >= v->mb_width * 4) { return 0; }
  if (block_y >= v->mb_height * 4) { return 0; }
  var mb: int32 = (block_y >> 2) * v->mb_width + (block_x >> 2);
  if (mb == v->mb_index) {
    return v->ref_filled[(block_y & 3) * 4 + (block_x & 3)];
  }
  if (mb > v->mb_index) { return 0; }
  if (v->macroblocks[mb].coded == 0) { return 0; }
  return 1;
}

fn h264_store_partition_reference(v: H264Video*, mb: H264Macroblock*, list: int32,
                                  part_x: int32, part_y: int32, part_w: int32, part_h: int32,
                                  reference: int32) {
  for row in 0..part_h {
    for column in 0..part_w {
      v->ref_filled[(part_y + row) * 4 + part_x + column] = 1;
    }
  }
  for row in 0..((part_h + 1) / 2) {
    for column in 0..((part_w + 1) / 2) {
      var block8: int32 = ((part_y / 2) + row) * 2 + (part_x / 2) + column;
      if (block8 >= 0 && block8 < 4) {
        mb->ref_index[list * 4 + block8] = reference;
        var picture: int32 = -1;
        if (list == 0 && reference >= 0 && reference < v->ref_count0) {
          picture = v->ref_list0[reference];
        }
        if (list == 1 && reference >= 0 && reference < v->ref_count1) {
          picture = v->ref_list1[reference];
        }
        mb->ref_picture[list * 4 + block8] = picture;
      }
    }
  }
}

fn h264_reference_context(v: H264Video*, list: int32, block_x: int32, block_y: int32) -> int32 {
  if (h264_reference_available(v, block_x, block_y) == 0) { return 0; }
  var mb: int32 = (block_y >> 2) * v->mb_width + (block_x >> 2);
  var info: H264Macroblock* = &v->macroblocks[mb];
  if (info->is_intra != 0) { return 0; }
  if (info->skipped != 0) { return 0; }
  var inside: int32 = (block_y & 3) * 4 + (block_x & 3);
  var block8: int32 = (inside >> 3) * 2 + ((inside & 3) >> 1);
  if (v->slice_type == H264_SLICE_B && info->direct8x8[block8] != (uint8)0) { return 0; }
  if (info->ref_index[list * 4 + block8] > 0) { return 1; }
  return 0;
}

fn h264_decode_reference_index(v: H264Video*, list: int32, part_x: int32, part_y: int32,
                               count: int32) -> int32 {
  if (count <= 1) { return 0; }
  var origin_x: int32 = v->mb_x * 4 + part_x;
  var origin_y: int32 = v->mb_y * 4 + part_y;
  var increment: int32 = h264_reference_context(v, list, origin_x - 1, origin_y) +
                         2 * h264_reference_context(v, list, origin_x, origin_y - 1);

  var result: int32 = 0;
  if (h264_decode_bin(v, H264_CTX_REF_IDX + increment) != 0) {
    if (h264_decode_bin(v, H264_CTX_REF_IDX + 4) == 0) {
      result = 1;
    } else {
      result = 2;
      while (result < 32 && h264_decode_bin(v, H264_CTX_REF_IDX + 5) != 0) {
        result = result + 1;
      }
    }
  }
  return result;
}

fn h264_neighbour_mvd(v: H264Video*, list: int32, component: int32,
                      block_x: int32, block_y: int32) -> int32 {
  if (h264_block_available(v, block_x, block_y) == 0) { return 0; }
  var mb: int32 = (block_y >> 2) * v->mb_width + (block_x >> 2);
  var info: H264Macroblock* = &v->macroblocks[mb];
  if (info->is_intra != 0 || info->skipped != 0) { return 0; }
  var inside: int32 = (block_y & 3) * 4 + (block_x & 3);
  var value: int32 = info->mvd_x[list * 16 + inside];
  if (component == 1) { value = info->mvd_y[list * 16 + inside]; }
  if (value < 0) { return 0 - value; }
  return value;
}

fn h264_decode_mvd(v: H264Video*, list: int32, component: int32,
                   part_x: int32, part_y: int32) -> int32 {
  var origin_x: int32 = v->mb_x * 4 + part_x;
  var origin_y: int32 = v->mb_y * 4 + part_y;
  var total: int32 = h264_neighbour_mvd(v, list, component, origin_x - 1, origin_y) +
                     h264_neighbour_mvd(v, list, component, origin_x, origin_y - 1);

  var increment: int32 = 0;
  if (total >= 3) { increment = 1; }
  if (total > 32) { increment = 2; }

  var base: int32 = H264_CTX_MVD_X;
  if (component == 1) { base = H264_CTX_MVD_Y; }

  if (h264_decode_bin(v, base + increment) == 0) { return 0; }

  var prefix: int32 = 1;
  while (prefix < 9) {
    var context: int32 = 3 + prefix - 1;
    if (context > 6) { context = 6; }
    if (h264_decode_bin(v, base + context) == 0) { break; }
    prefix = prefix + 1;
  }

  var value: int32 = prefix;
  if (prefix == 9) {
    var k: int32 = 3;
    var extra: int32 = 0;
    while (h264_decode_bypass(v) != 0 && k < 30) {
      extra = extra + (1 << k);
      k = k + 1;
    }
    var suffix: int32 = 0;
    while (k > 0) {
      k = k - 1;
      suffix = (suffix << 1) | h264_decode_bypass(v);
    }
    value = 9 + extra + suffix;
  }

  if (h264_decode_bypass(v) != 0) { return 0 - value; }
  return value;
}

fn h264_decode_partition_motion(v: H264Video*, mb: H264Macroblock*, list: int32,
                                part_x: int32, part_y: int32, part_w: int32, part_h: int32,
                                reference: int32) {
  var predicted_x: int32 = 0;
  var predicted_y: int32 = 0;
  h264_predict_motion_vector(v, list, part_x, part_y, part_w, part_h, reference,
                             &predicted_x, &predicted_y);
  var delta_x: int32 = h264_decode_mvd(v, list, 0, part_x, part_y);
  var delta_y: int32 = h264_decode_mvd(v, list, 1, part_x, part_y);
  h264_store_partition_motion(v, mb, list, part_x, part_y, part_w, part_h, reference,
                              predicted_x + delta_x, predicted_y + delta_y, delta_x, delta_y);
}

fn h264_decode_p_motion(v: H264Video*, mb: H264Macroblock*, count: int32) {
  if (mb->kind == H264_MB_P_16X16) {
    var reference: int32 = h264_decode_reference_index(v, 0, 0, 0, count);
    h264_store_partition_reference(v, mb, 0, 0, 0, 4, 4, reference);
    h264_decode_partition_motion(v, mb, 0, 0, 0, 4, 4, reference);
    return;
  }
  if (mb->kind == H264_MB_P_16X8) {
    var reference0: int32 = h264_decode_reference_index(v, 0, 0, 0, count);
    h264_store_partition_reference(v, mb, 0, 0, 0, 4, 2, reference0);
    var reference1: int32 = h264_decode_reference_index(v, 0, 0, 2, count);
    h264_store_partition_reference(v, mb, 0, 0, 2, 4, 2, reference1);
    h264_decode_partition_motion(v, mb, 0, 0, 0, 4, 2, reference0);
    h264_decode_partition_motion(v, mb, 0, 0, 2, 4, 2, reference1);
    return;
  }
  if (mb->kind == H264_MB_P_8X16) {
    var reference0: int32 = h264_decode_reference_index(v, 0, 0, 0, count);
    h264_store_partition_reference(v, mb, 0, 0, 0, 2, 4, reference0);
    var reference1: int32 = h264_decode_reference_index(v, 0, 2, 0, count);
    h264_store_partition_reference(v, mb, 0, 2, 0, 2, 4, reference1);
    h264_decode_partition_motion(v, mb, 0, 0, 0, 2, 4, reference0);
    h264_decode_partition_motion(v, mb, 0, 2, 0, 2, 4, reference1);
    return;
  }

  var sub_types: int32[4];
  for block in 0..4 {
    sub_types[block] = h264_decode_sub_type_p(v);
    if (sub_types[block] != 0) { mb->sub_8x8_small = 1; }
  }
  var references: int32[4];
  for block in 0..4 {
    references[block] = h264_decode_reference_index(v, 0, (block & 1) * 2, (block >> 1) * 2, count);
    h264_store_partition_reference(v, mb, 0, (block & 1) * 2, (block >> 1) * 2, 2, 2, references[block]);
  }
  for block in 0..4 {
    var base_x: int32 = (block & 1) * 2;
    var base_y: int32 = (block >> 1) * 2;
    var kind: int32 = sub_types[block];
    if (kind == 0) {
      h264_decode_partition_motion(v, mb, 0, base_x, base_y, 2, 2, references[block]);
    } else if (kind == 1) {
      h264_decode_partition_motion(v, mb, 0, base_x, base_y, 2, 1, references[block]);
      h264_decode_partition_motion(v, mb, 0, base_x, base_y + 1, 2, 1, references[block]);
    } else if (kind == 2) {
      h264_decode_partition_motion(v, mb, 0, base_x, base_y, 1, 2, references[block]);
      h264_decode_partition_motion(v, mb, 0, base_x + 1, base_y, 1, 2, references[block]);
    } else {
      h264_decode_partition_motion(v, mb, 0, base_x, base_y, 1, 1, references[block]);
      h264_decode_partition_motion(v, mb, 0, base_x + 1, base_y, 1, 1, references[block]);
      h264_decode_partition_motion(v, mb, 0, base_x, base_y + 1, 1, 1, references[block]);
      h264_decode_partition_motion(v, mb, 0, base_x + 1, base_y + 1, 1, 1, references[block]);
    }
  }
}

fn h264_skip_motion(v: H264Video*, mb: H264Macroblock*) {
  var origin_x: int32 = v->mb_x * 4;
  var origin_y: int32 = v->mb_y * 4;

  var ref_a: int32 = 0;
  var mv_ax: int32 = 0;
  var mv_ay: int32 = 0;
  var has_a: int32 = h264_neighbour_motion(v, 0, origin_x - 1, origin_y, &ref_a, &mv_ax, &mv_ay);

  var ref_b: int32 = 0;
  var mv_bx: int32 = 0;
  var mv_by: int32 = 0;
  var has_b: int32 = h264_neighbour_motion(v, 0, origin_x, origin_y - 1, &ref_b, &mv_bx, &mv_by);

  var mv_x: int32 = 0;
  var mv_y: int32 = 0;
  var zero: int32 = 0;
  if (has_a == 0 || has_b == 0) { zero = 1; }
  if (ref_a == 0 && mv_ax == 0 && mv_ay == 0) { zero = 1; }
  if (ref_b == 0 && mv_bx == 0 && mv_by == 0) { zero = 1; }
  if (zero == 0) {
    h264_predict_motion_vector(v, 0, 0, 0, 4, 4, 0, &mv_x, &mv_y);
  }
  h264_store_partition_motion(v, mb, 0, 0, 0, 4, 4, 0, mv_x, mv_y, 0, 0);
  mb->uniform = (uint8)1;
}

@inline fn h264_pack_byte(value: int32) -> uint8 {
  if (value < 0) { return (uint8)0; }
  if (value > 255) { return (uint8)255; }
  return (uint8)value;
}

var g_weight_table: uint8[768];
var g_weight_key: int32[3];

fn h264_weight_u8(src: uint8*, src_stride: int32, dst: uint8*, dst_stride: int32,
                  w: int32, h: int32, weight: int32, offset: int32, denominator: int32,
                  slot: int32) {
  var key: int32 = (weight + 512) | ((offset + 512) << 11) | (denominator << 22);
  var base: int32 = slot * 256;
  if (g_weight_key[slot] != key) {
    var round: int32 = 0;
    if (denominator >= 1) { round = 1 << (denominator - 1); }
    for i in 0..256 {
      g_weight_table[base + i] = h264_pack_byte(((i * weight + round) >> denominator) + offset);
    }
    g_weight_key[slot] = key;
  }
  for row in 0..h {
    var source: int32 = row * src_stride;
    var target: int32 = row * dst_stride;
    for column in 0..w {
      dst[target + column] = g_weight_table[base + (int32)src[source + column]];
    }
  }
}

var g_pair_left: int32[256];
var g_pair_right: int32[256];
var g_pair_key: int32 = 0;

fn h264_weight_pair_u8(a: uint8*, b: uint8*, dst: uint8*, dst_stride: int32,
                       w: int32, h: int32, weight0: int32, weight1: int32,
                       offset0: int32, offset1: int32, denominator: int32) {
  var round: int32 = 1 << denominator;
  var shift: int32 = denominator + 1;
  var offset: int32 = (offset0 + offset1 + 1) >> 1;
  var key: int32 = (weight0 + 512) | ((weight1 + 512) << 11) | (denominator << 22);
  if (g_pair_key != key) {
    for i in 0..256 {
      g_pair_left[i] = i * weight0;
      g_pair_right[i] = i * weight1;
    }
    g_pair_key = key;
  }
  for row in 0..h {
    var source: int32 = row * w;
    var target: int32 = row * dst_stride;
    for column in 0..w {
      var value: int32 = (g_pair_left[(int32)a[source + column]] +
                          g_pair_right[(int32)b[source + column]] + round) >> shift;
      dst[target + column] = h264_pack_byte(value + offset);
    }
  }
}

var g_pred_luma: uint8[256];
var g_pred_cb: uint8[64];
var g_pred_cr: uint8[64];
var g_ref0_luma: uint8[256];
var g_ref1_luma: uint8[256];
var g_ref0_chroma: uint8[64];
var g_ref1_chroma: uint8[64];

fn h264_blend_u8(a: uint8*, b: uint8*, out: uint8*, w: int32, h: int32, out_stride: int32,
                 weight0: int32, weight1: int32, implicit: int32) {
  if (implicit == 0) {
    for row in 0..h {
      h264_average_row_u8(&a[row * w], &b[row * w], &out[row * out_stride], w);
    }
    return;
  }
  if (weight1 == 32) {
    for row in 0..h {
      h264_average_row_u8(&a[row * w], &b[row * w], &out[row * out_stride], w);
    }
    return;
  }
  for row in 0..h {
    var store: int32 = row * out_stride;
    var source: int32 = row * w;
    for column in 0..w {
      var base: int32 = (int32)a[source + column];
      out[store + column] =
        h264_pack_byte(base + ((((int32)b[source + column] - base) * weight1 + 32) >> 6));
    }
  }
}

fn h264_uniform_region(mb: H264Macroblock*, bx: int32, by: int32,
                       bw: int32, bh: int32) -> int32 {
  var first: int32 = by * 4 + bx;
  var mv0x: int32 = (int32)mb->mv_x[first];
  var mv0y: int32 = (int32)mb->mv_y[first];
  var mv1x: int32 = (int32)mb->mv_x[16 + first];
  var mv1y: int32 = (int32)mb->mv_y[16 + first];
  for row in 0..bh {
    var base: int32 = (by + row) * 4 + bx;
    for column in 0..bw {
      var raster: int32 = base + column;
      if ((int32)mb->mv_x[raster] != mv0x) { return 0; }
      if ((int32)mb->mv_y[raster] != mv0y) { return 0; }
      if ((int32)mb->mv_x[16 + raster] != mv1x) { return 0; }
      if ((int32)mb->mv_y[16 + raster] != mv1y) { return 0; }
    }
  }
  var block8: int32 = (by >> 1) * 2 + (bx >> 1);
  var r0: int32 = mb->ref_index[block8];
  var r1: int32 = mb->ref_index[4 + block8];
  for row in 0..((bh + 1) / 2) {
    for column in 0..((bw + 1) / 2) {
      var eight: int32 = block8 + row * 2 + column;
      if (mb->ref_index[eight] != r0) { return 0; }
      if (mb->ref_index[4 + eight] != r1) { return 0; }
    }
  }
  return 1;
}

fn h264_predict_region(v: H264Video*, mb: H264Macroblock*, bx: int32, by: int32,
                       bw: int32, bh: int32) -> int32 {
  var raster: int32 = by * 4 + bx;
  var block8: int32 = (by >> 1) * 2 + (bx >> 1);

  var reference0: int32 = mb->ref_index[block8];
  var reference1: int32 = mb->ref_index[4 + block8];
  if (reference0 >= v->ref_count0) { reference0 = v->ref_count0 - 1; }
  if (reference1 >= v->ref_count1) { reference1 = v->ref_count1 - 1; }
  var use0: int32 = 0;
  var use1: int32 = 0;
  if (reference0 >= 0) { use0 = 1; }
  if (reference1 >= 0) { use1 = 1; }
  if (use0 == 0 && use1 == 0) {
    if (v->ref_count0 <= 0) { return 0; }
    reference0 = 0;
    use0 = 1;
  }

  var x: int32 = v->mb_x * 16 + bx * 4;
  var y: int32 = v->mb_y * 16 + by * 4;
  var cx: int32 = v->mb_x * 8 + bx * 2;
  var cy: int32 = v->mb_y * 8 + by * 2;
  var w: int32 = bw * 4;
  var h: int32 = bh * 4;
  var cw: int32 = bw * 2;
  var ch: int32 = bh * 2;

  var picture0: H264Picture* = &v->pictures[0];
  var picture1: H264Picture* = &v->pictures[0];
  if (use0 != 0) { picture0 = &v->pictures[v->ref_list0[reference0]]; }
  if (use1 != 0) { picture1 = &v->pictures[v->ref_list1[reference1]]; }

  var luma_stride_out: int32 = v->pred_luma_stride;
  var luma_out: uint8* = &v->pred_luma[(int64)(by * 4) * (int64)luma_stride_out + (int64)(bx * 4)];
  var chroma_stride_out: int32 = v->pred_chroma_stride;
  var chroma_shift: int64 = (int64)(by * 2) * (int64)chroma_stride_out + (int64)(bx * 2);

  var mv0x: int32 = (int32)mb->mv_x[raster];
  var mv0y: int32 = (int32)mb->mv_y[raster];
  var mv1x: int32 = (int32)mb->mv_x[16 + raster];
  var mv1y: int32 = (int32)mb->mv_y[16 + raster];
  var luma_offset: int32 = (by * 4) * 16 + bx * 4;

  var plain: int32 = 0;
  if (v->use_weights == 0) { plain = 1; }
  var single: int32 = 0;
  if (use1 == 0 && plain != 0) { single = 1; }
  var both: int32 = 0;
  if (use0 != 0 && use1 != 0 && plain != 0) { both = 1; }
  var luma_full0: int32 = 0;
  if ((mv0x & 3) == 0 && (mv0y & 3) == 0) { luma_full0 = 1; }
  var luma_full1: int32 = 0;
  if ((mv1x & 3) == 0 && (mv1y & 3) == 0) { luma_full1 = 1; }
  var luma_width: int32 = v->mb_width * 16;
  var luma_height: int32 = v->mb_height * 16;
  var implicit_w1: int32 = 0;
  if (v->implicit_weights != 0 && use0 != 0 && use1 != 0) {
    implicit_w1 = v->implicit_w1[reference0 * 32 + reference1];
  }

  if (use0 != 0 && use1 != 0) {
    h264_mc_luma_u8(v, picture0->luma, &g_ref0_luma[0], w, x, y, w, h, mv0x, mv0y);
    h264_mc_luma_u8(v, picture1->luma, &g_ref1_luma[0], w, x, y, w, h, mv1x, mv1y);
    if (plain != 0) {
      h264_blend_u8(&g_ref0_luma[0], &g_ref1_luma[0], luma_out, w, h, luma_stride_out,
                    64 - implicit_w1, implicit_w1, v->implicit_weights);
    } else {
      h264_weight_pair_u8(&g_ref0_luma[0], &g_ref1_luma[0], luma_out, luma_stride_out, w, h,
                          v->weight_luma[reference0], v->weight_luma_l1[reference1],
                          v->weight_luma_offset[reference0],
                          v->weight_luma_offset_l1[reference1], v->luma_log2_denom);
    }
  } else {
    var source_plane: uint8* = picture0->luma;
    var single_x: int32 = mv0x;
    var single_y: int32 = mv0y;
    var single_weight: int32 = 0;
    var single_offset: int32 = 0;
    if (use0 == 0) {
      source_plane = picture1->luma;
      single_x = mv1x;
      single_y = mv1y;
      single_weight = v->weight_luma_l1[reference1];
      single_offset = v->weight_luma_offset_l1[reference1];
    } else {
      single_weight = v->weight_luma[reference0];
      single_offset = v->weight_luma_offset[reference0];
    }
    if (plain != 0) {
      h264_mc_luma_u8(v, source_plane, luma_out, luma_stride_out, x, y, w, h,
                      single_x, single_y);
    } else {
      h264_mc_luma_u8(v, source_plane, &g_ref0_luma[0], w, x, y, w, h, single_x, single_y);
      h264_weight_u8(&g_ref0_luma[0], w, luma_out, luma_stride_out, w, h,
                     single_weight, single_offset, v->luma_log2_denom, 0);
    }
  }

  var chroma_offset: int32 = (by * 2) * 8 + bx * 2;
  var chroma_full0: int32 = 0;
  if ((mv0x & 7) == 0 && (mv0y & 7) == 0) { chroma_full0 = 1; }
  var chroma_full1: int32 = 0;
  if ((mv1x & 7) == 0 && (mv1y & 7) == 0) { chroma_full1 = 1; }
  var chroma_width: int32 = v->mb_width * 8;
  var chroma_height: int32 = v->mb_height * 8;
  var chroma_direct: int32 = 0;
  if (single != 0 && chroma_full0 != 0) { chroma_direct = 1; }
  var chroma_blend: int32 = 0;
  if (both != 0 && chroma_full0 != 0 && chroma_full1 != 0) { chroma_blend = 1; }
  for component in 0..2 {
    var source0: uint8* = picture0->cb;
    var source1: uint8* = picture1->cb;
    if (component == 1) {
      source0 = picture0->cr;
      source1 = picture1->cr;
    }
    var store: uint8* = &v->pred_cb[chroma_shift];
    if (component == 1) { store = &v->pred_cr[chroma_shift]; }
    if (use0 != 0 && use1 != 0) {
      h264_mc_chroma_u8(v, source0, &g_ref0_chroma[0], cw, cx, cy, cw, ch, mv0x, mv0y);
      h264_mc_chroma_u8(v, source1, &g_ref1_chroma[0], cw, cx, cy, cw, ch, mv1x, mv1y);
      if (plain != 0) {
        h264_blend_u8(&g_ref0_chroma[0], &g_ref1_chroma[0], store, cw, ch, chroma_stride_out,
                      64 - implicit_w1, implicit_w1, v->implicit_weights);
      } else {
        h264_weight_pair_u8(&g_ref0_chroma[0], &g_ref1_chroma[0], store, chroma_stride_out,
                            cw, ch,
                            v->weight_chroma[reference0 * 2 + component],
                            v->weight_chroma_l1[reference1 * 2 + component],
                            v->weight_chroma_offset[reference0 * 2 + component],
                            v->weight_chroma_offset_l1[reference1 * 2 + component],
                            v->chroma_log2_denom);
      }
      continue;
    }
    var chroma_plane: uint8* = source0;
    var chroma_x: int32 = mv0x;
    var chroma_y: int32 = mv0y;
    var chroma_weight: int32 = 0;
    var chroma_offset_value: int32 = 0;
    if (use0 == 0) {
      chroma_plane = source1;
      chroma_x = mv1x;
      chroma_y = mv1y;
      chroma_weight = v->weight_chroma_l1[reference1 * 2 + component];
      chroma_offset_value = v->weight_chroma_offset_l1[reference1 * 2 + component];
    } else {
      chroma_weight = v->weight_chroma[reference0 * 2 + component];
      chroma_offset_value = v->weight_chroma_offset[reference0 * 2 + component];
    }
    if (plain != 0) {
      h264_mc_chroma_u8(v, chroma_plane, store, chroma_stride_out, cx, cy, cw, ch,
                        chroma_x, chroma_y);
    } else {
      h264_mc_chroma_u8(v, chroma_plane, &g_ref0_chroma[0], cw, cx, cy, cw, ch,
                        chroma_x, chroma_y);
      h264_weight_u8(&g_ref0_chroma[0], cw, store, chroma_stride_out, cw, ch,
                     chroma_weight, chroma_offset_value, v->chroma_log2_denom, component + 1);
    }
  }
  return 1;
}

fn h264_predict_inter(v: H264Video*, mb: H264Macroblock*) -> int32 {
  if (mb->uniform != (uint8)0) {
    return h264_predict_region(v, mb, 0, 0, 4, 4);
  }
  if (h264_uniform_region(mb, 0, 0, 4, 4) != 0) {
    mb->uniform = (uint8)1;
    return h264_predict_region(v, mb, 0, 0, 4, 4);
  }
  for quadrant in 0..4 {
    var qx: int32 = (quadrant & 1) * 2;
    var qy: int32 = (quadrant >> 1) * 2;
    if (h264_uniform_region(mb, qx, qy, 2, 2) != 0) {
      if (h264_predict_region(v, mb, qx, qy, 2, 2) == 0) { return 0; }
      continue;
    }
    if (h264_uniform_region(mb, qx, qy, 2, 1) != 0 &&
        h264_uniform_region(mb, qx, qy + 1, 2, 1) != 0) {
      if (h264_predict_region(v, mb, qx, qy, 2, 1) == 0) { return 0; }
      if (h264_predict_region(v, mb, qx, qy + 1, 2, 1) == 0) { return 0; }
      continue;
    }
    if (h264_uniform_region(mb, qx, qy, 1, 2) != 0 &&
        h264_uniform_region(mb, qx + 1, qy, 1, 2) != 0) {
      if (h264_predict_region(v, mb, qx, qy, 1, 2) == 0) { return 0; }
      if (h264_predict_region(v, mb, qx + 1, qy, 1, 2) == 0) { return 0; }
      continue;
    }
    for inner in 0..4 {
      var ix: int32 = qx + (inner & 1);
      var iy: int32 = qy + (inner >> 1);
      if (h264_predict_region(v, mb, ix, iy, 1, 1) == 0) { return 0; }
    }
  }
  return 1;
}

fn h264_reconstruct_inter(v: H264Video*, mb: H264Macroblock*, pps: H264Pps*) {
  var scaled: int32[16];
  var residual: int32[16];

  var luma_origin: int64 = (int64)(v->mb_y * 16) * (int64)v->luma_stride + (int64)(v->mb_x * 16);
  var chroma_origin: int64 = (int64)(v->mb_y * 8) * (int64)v->chroma_stride +
                             (int64)(v->mb_x * 8);
  var direct_luma: int32 = 0;
  if (mb->cbp_luma == 0) { direct_luma = 1; }
  var direct_chroma: int32 = 0;
  if (mb->cbp_chroma == 0) { direct_chroma = 1; }

  if (direct_luma != 0) {
    v->pred_luma = &v->luma[luma_origin];
    v->pred_luma_stride = v->luma_stride;
  } else {
    v->pred_luma = &g_pred_luma[0];
    v->pred_luma_stride = 16;
  }
  if (direct_chroma != 0) {
    v->pred_cb = &v->cb[chroma_origin];
    v->pred_cr = &v->cr[chroma_origin];
    v->pred_chroma_stride = v->chroma_stride;
  } else {
    v->pred_cb = &g_pred_cb[0];
    v->pred_cr = &g_pred_cr[0];
    v->pred_chroma_stride = 8;
  }

  if (h264_predict_inter(v, mb) == 0) { return; }

  if (direct_luma != 0) {
  } else if (mb->transform_8x8 != 0) {
    var scaled8: int32[64];
    var residual8: int32[64];
    for blk in 0..4 {
      var x: int32 = v->mb_x * 16 + (blk & 1) * 8;
      var y: int32 = v->mb_y * 16 + (blk >> 1) * 8;
      var source_x: int32 = (blk & 1) * 8;
      var source_y: int32 = (blk >> 1) * 8;
      var coded8: int32 = 0;
      if ((mb->cbp_luma & (1 << blk)) != 0) {
        h264_scale_block_8x8(v, &v->luma_8x8[blk * 64], &scaled8[0], mb->qp);
        h264_inverse_transform_8x8(v, &scaled8[0], &residual8[0]);
        coded8 = 1;
      }
      for row in 0..8 {
        var base: int64 = (int64)(y + row) * (int64)v->luma_stride + (int64)x;
        var source: int32 = (source_y + row) * 16 + source_x;
        for column in 0..8 {
          var value: int32 = (int32)g_pred_luma[source + column];
          if (coded8 != 0) { value = value + residual8[row * 8 + column]; }
          v->luma[base + (int64)column] = h264_clip_sample(value);
        }
      }
    }
  } else {
  for raster in 0..16 {
    var bx: int32 = raster & 3;
    var by: int32 = raster >> 2;
    var x: int32 = v->mb_x * 16 + bx * 4;
    var y: int32 = v->mb_y * 16 + by * 4;
    var coded: int32 = 0;
    if (mb->luma_nonzero[raster] != (uint8)0) {
      var blk: int32 = v->raster_blk[raster];
      h264_scale_block(v, &v->luma_ac[blk * 16], &scaled[0], mb->qp, 0);
      h264_inverse_transform_4x4(v, &scaled[0], &residual[0]);
      coded = 1;
    }
    for row in 0..4 {
      var base: int64 = (int64)(y + row) * (int64)v->luma_stride + (int64)x;
      var source: int32 = (by * 4 + row) * 16 + bx * 4;
      if (coded != 0) {
        var offset: int32 = row * 4;
        for column in 0..4 {
          v->luma[base + (int64)column] =
            h264_clip_sample((int32)g_pred_luma[source + column] + residual[offset + column]);
        }
      } else {
        for column in 0..4 {
          v->luma[base + (int64)column] = g_pred_luma[source + column];
        }
      }
    }
  }
  }

  if (direct_chroma != 0) { return; }
  for row in 0..8 {
    var base: int64 = chroma_origin + (int64)(row * v->chroma_stride);
    h264_copy_row(&v->cb[base], &g_pred_cb[row * 8], 8);
    h264_copy_row(&v->cr[base], &g_pred_cr[row * 8], 8);
  }
  var dc: int32[4];
  for component in 0..2 {
    var offset: int32 = pps->chroma_qp_index_offset;
    if (component == 1) { offset = pps->second_chroma_qp_index_offset; }
    var qp: int32 = h264_chroma_qp(v, mb->qp, offset);
    h264_chroma_dc_transform(v, component, qp, &dc[0]);
    var plane: uint8* = v->cb;
    if (component == 1) { plane = v->cr; }
    for blk in 0..4 {
      var x: int32 = v->mb_x * 8 + (blk & 1) * 4;
      var y: int32 = v->mb_y * 8 + (blk >> 1) * 4;
      if (mb->chroma_nonzero[component * 4 + blk] != (uint8)0) {
        h264_scale_ac_block(v, &v->chroma_ac[(component * 4 + blk) * 16], &scaled[0], qp);
      } else {
        if (dc[blk] == 0) { continue; }
        for i in 0..16 { scaled[i] = 0; }
      }
      scaled[0] = dc[blk];
      h264_inverse_transform_4x4(v, &scaled[0], &residual[0]);
      h264_add_residual(plane, v->chroma_stride, x, y, &residual[0]);
    }
  }
}
