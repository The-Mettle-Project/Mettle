import "std/mem";
import "h264";
import "h264_decode";
import "h264_predict";
import "h264_deblock";
import "h264_inter";
import "h264_pslice";
import "h264_bslice";

fn h264_store_prediction(v: H264Video*, x: int32, y: int32, prediction: int32*) {
  for row in 0..4 {
    var base: int64 = (int64)(y + row) * (int64)v->luma_stride + (int64)x;
    for column in 0..4 {
      v->luma[base + (int64)column] = h264_clip_sample(prediction[row * 4 + column]);
    }
  }
}

fn h264_store_prediction_with_residual(v: H264Video*, x: int32, y: int32,
                                       prediction: int32*, residual: int32*) {
  for row in 0..4 {
    var base: int64 = (int64)(y + row) * (int64)v->luma_stride + (int64)x;
    for column in 0..4 {
      v->luma[base + (int64)column] =
        h264_clip_sample(prediction[row * 4 + column] + residual[row * 4 + column]);
    }
  }
}

fn h264_clear_residual(v: H264Video*) {
  for i in 0..256 { v->luma_ac[i] = 0; }
  for i in 0..16 { v->luma_dc[i] = 0; }
  for i in 0..128 { v->chroma_ac[i] = 0; }
  for i in 0..8 { v->chroma_dc[i] = 0; }
}

fn h264_reconstruct_intra_nxn(v: H264Video*, mb: H264Macroblock*) {
  var prediction: int32[16];
  var scaled: int32[16];
  var residual: int32[16];

  for blk in 0..16 {
    var raster: int32 = v->blk_raster[blk];
    var x: int32 = v->mb_x * 16 + (raster & 3) * 4;
    var y: int32 = v->mb_y * 16 + (raster >> 2) * 4;
    h264_predict_intra4x4(v, blk, (int32)mb->intra4x4_modes[raster], &prediction[0]);

    if (mb->luma_nonzero[raster] != (uint8)0) {
      h264_scale_block(v, &v->luma_ac[blk * 16], &scaled[0], mb->qp, 0);
      h264_inverse_transform_4x4(v, &scaled[0], &residual[0]);
      h264_store_prediction_with_residual(v, x, y, &prediction[0], &residual[0]);
    } else {
      h264_store_prediction(v, x, y, &prediction[0]);
    }
  }
}

fn h264_reconstruct_intra_16x16(v: H264Video*, mb: H264Macroblock*) {
  h264_predict_intra16x16(v, mb->intra16x16_mode);

  var dc: int32[16];
  h264_luma_dc_transform(v, mb->qp, &dc[0]);

  var scaled: int32[16];
  var residual: int32[16];
  for blk in 0..16 {
    var raster: int32 = v->blk_raster[blk];
    var x: int32 = v->mb_x * 16 + (raster & 3) * 4;
    var y: int32 = v->mb_y * 16 + (raster >> 2) * 4;
    h264_scale_ac_block(v, &v->luma_ac[blk * 16], &scaled[0], mb->qp);
    scaled[0] = dc[raster];
    h264_inverse_transform_4x4(v, &scaled[0], &residual[0]);
    h264_add_residual(v->luma, v->luma_stride, x, y, &residual[0]);
  }
}

fn h264_reconstruct_chroma(v: H264Video*, mb: H264Macroblock*, pps: H264Pps*) {
  h264_predict_chroma(v, v->cb, mb->chroma_mode);
  h264_predict_chroma(v, v->cr, mb->chroma_mode);
  if (mb->cbp_chroma == 0) { return; }

  var scaled: int32[16];
  var residual: int32[16];
  var dc: int32[4];

  for component in 0..2 {
    var offset: int32 = pps->chroma_qp_index_offset;
    if (component == 1) { offset = pps->second_chroma_qp_index_offset; }
    var qp: int32 = h264_chroma_qp(v, mb->qp, offset);
    h264_chroma_dc_transform(v, component, qp, &dc[0]);

    var plane: uint8* = v->cb;
    if (component == 1) { plane = v->cr; }

    for blk in 0..4 {
      var x: int32 = v->mb_x * 8 + (blk & 1) * 4;
      var y: int32 = v->mb_y * 8 + (blk >> 1) * 4;
      h264_scale_ac_block(v, &v->chroma_ac[(component * 4 + blk) * 16], &scaled[0], qp);
      scaled[0] = dc[blk];
      h264_inverse_transform_4x4(v, &scaled[0], &residual[0]);
      h264_add_residual(plane, v->chroma_stride, x, y, &residual[0]);
    }
  }
}

fn h264_decode_macroblock(v: H264Video*, pps: H264Pps*, header: H264SliceHeader*) -> int32 {
  var mb: H264Macroblock* = &v->macroblocks[v->mb_index];
  memset(mb, 0, sizeof(H264Macroblock));
  mb->coded = 1;
  for i in 0..16 { v->block_filled[i] = 0; }
  for i in 0..16 { v->ref_filled[i] = 0; }
  for i in 0..8 { mb->ref_index[i] = -1; }
  for i in 0..8 { mb->ref_picture[i] = -1; }

  if (v->slice_type != H264_SLICE_I) {
    if (h264_decode_skip_flag(v) != 0) {
      mb->skipped = 1;
      mb->qp = v->qp;
      v->qp_delta_nonzero = 0;
      if (v->slice_type == H264_SLICE_B) {
        mb->kind = H264_MB_B_SKIP;
        h264_direct_prediction(v, mb, 0, 0, 4, 4);
      } else {
        mb->kind = H264_MB_P_SKIP;
        h264_skip_motion(v, mb);
      }
      h264_clear_residual(v);
      h264_reconstruct_inter(v, mb, pps);
      return H264_OK;
    }
  }

  var cbp_luma: int32 = 0;
  var cbp_chroma: int32 = 0;
  var mode16: int32 = 0;
  var kind: int32 = 0;
  var b_value: int32 = 0;
  if (v->slice_type == H264_SLICE_I) {
    kind = h264_decode_mb_type_intra(v, &cbp_luma, &cbp_chroma, &mode16);
  } else if (v->slice_type == H264_SLICE_B) {
    kind = h264_decode_mb_type_b(v, &cbp_luma, &cbp_chroma, &mode16, &b_value);
  } else {
    kind = h264_decode_mb_type_p(v, &cbp_luma, &cbp_chroma, &mode16);
  }
  mb->kind = kind;
  if (g_trace_mb != 0) { println("  type mb {v->mb_index} kind {kind} mode16 {mode16} b {b_value} cbp {cbp_luma}/{cbp_chroma}"); fflush(0); }
  if (kind == H264_MB_I_PCM) { return H264_ERR_UNSUPPORTED; }

  var intra: int32 = 0;
  if (kind == H264_MB_I_NXN || kind == H264_MB_I_16X16) { intra = 1; }
  mb->is_intra = intra;

  if (intra != 0) {
    if (kind == H264_MB_I_NXN) {
      h264_decode_intra4x4_modes(v, mb);
    } else {
      mb->intra16x16_mode = mode16;
      mb->cbp_luma = cbp_luma;
      mb->cbp_chroma = cbp_chroma;
    }
    mb->chroma_mode = h264_decode_chroma_mode(v);
  } else if (v->slice_type == H264_SLICE_B) {
    h264_decode_b_motion(v, mb, b_value, header->num_ref_idx_l0_active,
                         header->num_ref_idx_l1_active);
  } else {
    h264_decode_p_motion(v, mb, header->num_ref_idx_l0_active);
  }

  if (kind != H264_MB_I_16X16) {
    var luma: int32 = 0;
    var chroma: int32 = 0;
    h264_decode_cbp(v, &luma, &chroma);
    mb->cbp_luma = luma;
    mb->cbp_chroma = chroma;
  }

  var has_residual: int32 = 0;
  if (mb->cbp_luma != 0 || mb->cbp_chroma != 0 || kind == H264_MB_I_16X16) { has_residual = 1; }

  if (has_residual != 0) {
    var delta: int32 = h264_decode_qp_delta(v);
    v->qp = (v->qp + delta + 52) % 52;
  } else {
    v->qp_delta_nonzero = 0;
  }
  mb->qp = v->qp;

  if (has_residual != 0) {
    h264_decode_residual(v, mb);
  } else {
    h264_clear_residual(v);
  }

  if (intra != 0) {
    if (kind == H264_MB_I_NXN) {
      h264_reconstruct_intra_nxn(v, mb);
    } else {
      h264_reconstruct_intra_16x16(v, mb);
    }
    h264_reconstruct_chroma(v, mb, pps);
  } else {
    h264_reconstruct_inter(v, mb, pps);
  }
  return H264_OK;
}

fn h264_compute_picture_order(v: H264Video*, sps: H264Sps*, header: H264SliceHeader*) {
  if (sps->pic_order_cnt_type == 0) {
    var previous_msb: int32 = v->previous_poc_msb;
    var previous_lsb: int32 = v->previous_poc_lsb;
    if (header->is_idr != 0) {
      previous_msb = 0;
      previous_lsb = 0;
    }
    var maximum: int32 = v->max_poc_lsb;
    var lsb: int32 = header->pic_order_cnt_lsb;
    var msb: int32 = previous_msb;
    if (lsb < previous_lsb && previous_lsb - lsb >= maximum / 2) {
      msb = previous_msb + maximum;
    } else if (lsb > previous_lsb && lsb - previous_lsb > maximum / 2) {
      msb = previous_msb - maximum;
    }
    v->poc = msb + lsb;
    if (header->nal_ref_idc != 0) {
      v->previous_poc_msb = msb;
      v->previous_poc_lsb = lsb;
    }
    return;
  }

  var offset: int32 = v->previous_frame_num_offset;
  if (header->is_idr != 0) {
    offset = 0;
  } else if (v->previous_frame_num > header->frame_num) {
    offset = v->previous_frame_num_offset + v->max_frame_num;
  }
  v->previous_frame_num_offset = offset;
  v->poc = 2 * (offset + header->frame_num);
  if (header->nal_ref_idc == 0) { v->poc = v->poc - 1; }
}

fn h264_clear_references(v: H264Video*) {
  for i in 0..H264_MAX_PICTURES {
    v->pictures[i].is_reference = 0;
    v->pictures[i].used = 0;
  }
}

fn h264_sort_by_frame_number(v: H264Video*, list: int32*, count: int32) {
  for i in 1..count {
    var value: int32 = list[i];
    var key: int32 = v->pictures[value].frame_num_wrap;
    var j: int32 = i;
    while (j > 0 && v->pictures[list[j - 1]].frame_num_wrap < key) {
      list[j] = list[j - 1];
      j = j - 1;
    }
    list[j] = value;
  }
}

fn h264_sort_by_order_count(v: H264Video*, list: int32*, count: int32, ascending: int32) {
  for i in 1..count {
    var value: int32 = list[i];
    var key: int32 = v->pictures[value].poc;
    var j: int32 = i;
    while (j > 0) {
      var previous: int32 = v->pictures[list[j - 1]].poc;
      var swap: int32 = 0;
      if (ascending != 0 && previous > key) { swap = 1; }
      if (ascending == 0 && previous < key) { swap = 1; }
      if (swap == 0) { break; }
      list[j] = list[j - 1];
      j = j - 1;
    }
    list[j] = value;
  }
}

fn h264_apply_list_modification(v: H264Video*, header: H264SliceHeader*, list: int32*,
                                count: int32*, size: int32, operations: int32,
                                kinds: int32*, values: int32*) {
  if (*count == 0) { return; }
  for i in *count..size {
    list[i] = list[*count - 1];
  }

  var predicted: int32 = header->frame_num;
  var index: int32 = 0;
  for operation in 0..operations {
    var kind: int32 = kinds[operation];
    if (kind != 0 && kind != 1) { continue; }
    var difference: int32 = values[operation] + 1;
    var no_wrap: int32 = predicted - difference;
    if (kind == 1) { no_wrap = predicted + difference; }
    if (no_wrap < 0) { no_wrap = no_wrap + v->max_frame_num; }
    if (no_wrap >= v->max_frame_num) { no_wrap = no_wrap - v->max_frame_num; }
    predicted = no_wrap;

    var wanted: int32 = no_wrap;
    if (wanted > header->frame_num) { wanted = wanted - v->max_frame_num; }

    var found: int32 = -1;
    for i in 0..H264_MAX_PICTURES {
      if (i == v->current_picture) { continue; }
      if (v->pictures[i].used == 0 || v->pictures[i].is_reference == 0) { continue; }
      if (v->pictures[i].frame_num_wrap == wanted) { found = i; }
    }
    if (found < 0) { continue; }

    var slot: int32 = size;
    while (slot > index) {
      list[slot] = list[slot - 1];
      slot = slot - 1;
    }
    list[index] = found;
    index = index + 1;

    var next: int32 = index;
    for scan in index..(size + 1) {
      if (list[scan] != found) {
        list[next] = list[scan];
        next = next + 1;
      }
    }
  }

  if (operations > 0) {
    *count = size;
  } else if (*count > size) {
    *count = size;
  }
}

fn h264_build_reference_lists(v: H264Video*, header: H264SliceHeader*) {
  v->ref_count0 = 0;
  v->ref_count1 = 0;
  if (v->slice_type == H264_SLICE_I) { return; }

  var available: int32[32];
  var count: int32 = 0;
  for i in 0..H264_MAX_PICTURES {
    if (i == v->current_picture) { continue; }
    if (v->pictures[i].used == 0 || v->pictures[i].is_reference == 0) { continue; }
    var wrap: int32 = v->pictures[i].frame_num;
    if (wrap > header->frame_num) { wrap = wrap - v->max_frame_num; }
    v->pictures[i].frame_num_wrap = wrap;
    if (count < 32) {
      available[count] = i;
      count = count + 1;
    }
  }
  if (count == 0) { return; }

  if (v->slice_type != H264_SLICE_B) {
    for i in 0..count { v->ref_list0[i] = available[i]; }
    v->ref_count0 = count;
    h264_sort_by_frame_number(v, &v->ref_list0[0], v->ref_count0);

    var size: int32 = header->num_ref_idx_l0_active;
    if (size > 31) { size = 31; }
    if (size < 1) { size = 1; }
    h264_apply_list_modification(v, header, &v->ref_list0[0], &v->ref_count0, size,
                                 header->modification_count, &header->modification_op[0],
                                 &header->modification_value[0]);
    return;
  }

  var before: int32[32];
  var after: int32[32];
  var before_count: int32 = 0;
  var after_count: int32 = 0;
  for i in 0..count {
    if (v->pictures[available[i]].poc < v->poc) {
      before[before_count] = available[i];
      before_count = before_count + 1;
    } else {
      after[after_count] = available[i];
      after_count = after_count + 1;
    }
  }
  h264_sort_by_order_count(v, &before[0], before_count, 0);
  h264_sort_by_order_count(v, &after[0], after_count, 1);

  for i in 0..before_count { v->ref_list0[i] = before[i]; }
  for i in 0..after_count { v->ref_list0[before_count + i] = after[i]; }
  v->ref_count0 = before_count + after_count;

  for i in 0..after_count { v->ref_list1[i] = after[i]; }
  for i in 0..before_count { v->ref_list1[after_count + i] = before[i]; }
  v->ref_count1 = after_count + before_count;

  if (v->ref_count1 > 1) {
    var identical: int32 = 1;
    for i in 0..v->ref_count1 {
      if (v->ref_list0[i] != v->ref_list1[i]) { identical = 0; }
    }
    if (identical != 0) {
      var swap: int32 = v->ref_list1[0];
      v->ref_list1[0] = v->ref_list1[1];
      v->ref_list1[1] = swap;
    }
  }

  var size0: int32 = header->num_ref_idx_l0_active;
  if (size0 > 31) { size0 = 31; }
  if (size0 < 1) { size0 = 1; }
  h264_apply_list_modification(v, header, &v->ref_list0[0], &v->ref_count0, size0,
                               header->modification_count, &header->modification_op[0],
                               &header->modification_value[0]);

  var size1: int32 = header->num_ref_idx_l1_active;
  if (size1 > 31) { size1 = 31; }
  if (size1 < 1) { size1 = 1; }
  h264_apply_list_modification(v, header, &v->ref_list1[0], &v->ref_count1, size1,
                               header->modification_count_l1, &header->modification_op_l1[0],
                               &header->modification_value_l1[0]);
}

fn h264_compute_implicit_weights(v: H264Video*) {
  for i in 0..v->ref_count0 {
    for j in 0..v->ref_count1 {
      var poc0: int32 = v->pictures[v->ref_list0[i]].poc;
      var poc1: int32 = v->pictures[v->ref_list1[j]].poc;
      var weight: int32 = 32;
      var td: int32 = h264_clip3(poc1 - poc0, -128, 127);
      if (td != 0) {
        var tb: int32 = h264_clip3(v->poc - poc0, -128, 127);
        var half: int32 = td;
        if (half < 0) { half = 0 - half; }
        half = half / 2;
        var tx: int32 = (16384 + half) / td;
        var scale: int32 = h264_clip3((tb * tx + 32) >> 6, -1024, 1023);
        var candidate: int32 = scale >> 2;
        if (candidate >= -64 && candidate <= 128) { weight = candidate; }
      }
      v->implicit_w1[i * 32 + j] = weight;
    }
  }
}

fn h264_store_colocated_motion(v: H264Video*) {
  var picture: H264Picture* = &v->pictures[v->current_picture];
  if (picture->col_capacity < v->mb_count * 16) { return; }
  for m in 0..v->mb_count {
    var mb: H264Macroblock* = &v->macroblocks[m];
    for blk in 0..16 {
      var index: int32 = m * 16 + blk;
      if (mb->is_intra != 0 || mb->coded == 0) {
        picture->col_ref[index] = -1;
        picture->col_picture[index] = -1;
        picture->col_mv_x[index] = 0;
        picture->col_mv_y[index] = 0;
        continue;
      }
      var block8: int32 = ((blk >> 2) >> 1) * 2 + ((blk & 3) >> 1);
      if (mb->ref_index[block8] >= 0) {
        picture->col_ref[index] = mb->ref_index[block8];
        picture->col_picture[index] = mb->ref_picture[block8];
        picture->col_mv_x[index] = mb->mv_x[blk];
        picture->col_mv_y[index] = mb->mv_y[blk];
      } else {
        picture->col_ref[index] = mb->ref_index[4 + block8];
        picture->col_picture[index] = mb->ref_picture[4 + block8];
        picture->col_mv_x[index] = mb->mv_x[16 + blk];
        picture->col_mv_y[index] = mb->mv_y[16 + blk];
      }
    }
  }
}

fn h264_begin_picture(v: H264Video*, sps: H264Sps*, pps: H264Pps*, header: H264SliceHeader*) -> int32 {
  var status: int32 = h264_prepare_picture(v, sps);
  if (status != H264_OK) { return status; }

  v->max_frame_num = 1 << sps->log2_max_frame_num;
  v->max_poc_lsb = 1 << sps->log2_max_pic_order_cnt_lsb;

  if (header->is_idr != 0) { h264_clear_references(v); }

  h264_compute_picture_order(v, sps, header);

  for i in 0..H264_MAX_PICTURES {
    if (i == v->current_picture) { continue; }
    if (v->pictures[i].used != 0 && v->pictures[i].is_reference == 0) {
      v->pictures[i].used = 0;
    }
  }

  var index: int32 = h264_pick_free_picture(v);
  status = h264_picture_allocate(v, index);
  if (status != H264_OK) { return status; }

  v->current_picture = index;
  v->pictures[index].used = 1;
  v->pictures[index].is_reference = 0;
  v->pictures[index].poc = v->poc;
  v->pictures[index].frame_num = header->frame_num;
  v->luma = v->pictures[index].luma;
  v->cb = v->pictures[index].cb;
  v->cr = v->pictures[index].cr;

  for i in 0..v->mb_count {
    v->macroblocks[i].coded = 0;
  }

  h264_build_reference_lists(v, header);
  return H264_OK;
}

fn h264_mark_short_term_unused(v: H264Video*, pic_num: int32, current_frame_num: int32) {
  for i in 0..H264_MAX_PICTURES {
    if (i == v->current_picture) { continue; }
    if (v->pictures[i].used == 0 || v->pictures[i].is_reference == 0) { continue; }
    var wrap: int32 = v->pictures[i].frame_num;
    if (wrap > current_frame_num) { wrap = wrap - v->max_frame_num; }
    if (wrap == pic_num) {
      v->pictures[i].is_reference = 0;
      return;
    }
  }
}

fn h264_apply_marking(v: H264Video*, header: H264SliceHeader*) {
  for i in 0..header->marking_count {
    var operation: int32 = header->marking_op[i];
    if (operation == 1) {
      h264_mark_short_term_unused(v, header->frame_num - (header->marking_arg[i] + 1),
                                  header->frame_num);
    } else if (operation == 5) {
      h264_clear_references(v);
    }
  }
}

fn h264_end_picture(v: H264Video*, sps: H264Sps*, header: H264SliceHeader*) {
  h264_store_colocated_motion(v);
  h264_deblock_picture(v);
  v->previous_frame_num = header->frame_num;

  if (header->nal_ref_idc == 0) { return; }

  if (header->has_marking != 0) { h264_apply_marking(v, header); }

  var picture: H264Picture* = &v->pictures[v->current_picture];
  picture->is_reference = 1;
  picture->frame_num = header->frame_num;

  var limit: int32 = sps->max_num_ref_frames;
  if (limit < 1) { limit = 1; }

  var count: int32 = 0;
  for i in 0..H264_MAX_PICTURES {
    if (v->pictures[i].used != 0 && v->pictures[i].is_reference != 0) { count = count + 1; }
  }
  while (count > limit) {
    var oldest: int32 = -1;
    for i in 0..H264_MAX_PICTURES {
      if (i == v->current_picture) { continue; }
      if (v->pictures[i].used == 0 || v->pictures[i].is_reference == 0) { continue; }
      var wrap: int32 = v->pictures[i].frame_num;
      if (wrap > header->frame_num) { wrap = wrap - v->max_frame_num; }
      if (oldest < 0) {
        oldest = i;
      } else {
        var best: int32 = v->pictures[oldest].frame_num;
        if (best > header->frame_num) { best = best - v->max_frame_num; }
        if (wrap < best) { oldest = i; }
      }
    }
    if (oldest < 0) { break; }
    v->pictures[oldest].is_reference = 0;
    v->pictures[oldest].used = 0;
    count = count - 1;
  }
}

fn h264_decode_slice(v: H264Video*, header: H264SliceHeader*) -> int32 {
  var parser: H264Decoder* = v->parser;
  var pps: H264Pps* = &parser->pps[parser->active_pps];
  var sps: H264Sps* = &parser->sps[parser->active_sps];

  if (pps->entropy_coding_mode == 0) { return H264_ERR_UNSUPPORTED; }
  if (sps->chroma_format_idc != 1) { return H264_ERR_UNSUPPORTED; }
  if (pps->transform_8x8_mode != 0) { return H264_ERR_UNSUPPORTED; }
  if (header->slice_type == H264_SLICE_SP || header->slice_type == H264_SLICE_SI) {
    return H264_ERR_UNSUPPORTED;
  }


  v->slice_type = header->slice_type;
  v->weighted_bipred = pps->weighted_bipred_idc;
  v->direct_spatial = header->direct_spatial_mv_pred;
  v->direct_8x8_inference = sps->direct_8x8_inference;

  if (g_trace_mb != 0) { println("slice type {header->slice_type} frame_num {header->frame_num} poc {v->poc} direct_spatial {header->direct_spatial_mv_pred} l0_active {header->num_ref_idx_l0_active} l1_active {header->num_ref_idx_l1_active} built {v->ref_count0}/{v->ref_count1} mods {header->modification_count}/{header->modification_count_l1}"); fflush(0); }
  if (header->first_mb_in_slice == 0) {
    var status: int32 = h264_begin_picture(v, sps, pps, header);
    if (status != H264_OK) { return status; }
  }

  var start_bit: int64 = (header->data_bit_offset + (int64)7) & ~(int64)7;
  h264_cabac_start(v, parser->rbsp, header->rbsp_size, start_bit);

  var model: int32 = 0;
  if (header->slice_type != H264_SLICE_I) { model = header->cabac_init_idc + 1; }
  h264_cabac_init_contexts(v, header->qp, model);

  v->qp = header->qp;
  v->qp_delta_nonzero = 0;
  v->disable_deblocking = header->disable_deblocking_filter_idc;
  v->alpha_offset = header->slice_alpha_c0_offset;
  v->beta_offset = header->slice_beta_offset;
  v->chroma_offset[0] = pps->chroma_qp_index_offset;
  v->chroma_offset[1] = pps->second_chroma_qp_index_offset;

  v->use_weights = 0;
  v->implicit_weights = 0;
  if (pps->weighted_bipred_idc == 2 && header->slice_type == H264_SLICE_B) {
    v->implicit_weights = 1;
    h264_compute_implicit_weights(v);
  }
  if (header->has_weights != 0 && header->slice_type != H264_SLICE_I) {
    v->use_weights = 1;
    v->luma_log2_denom = header->luma_log2_denom;
    v->chroma_log2_denom = header->chroma_log2_denom;
    for i in 0..32 {
      v->weight_luma[i] = header->luma_weight[i];
      v->weight_luma_offset[i] = header->luma_offset[i];
      v->weight_chroma[i * 2] = header->chroma_weight[i * 2];
      v->weight_chroma[i * 2 + 1] = header->chroma_weight[i * 2 + 1];
      v->weight_chroma_offset[i * 2] = header->chroma_offset[i * 2];
      v->weight_chroma_offset[i * 2 + 1] = header->chroma_offset[i * 2 + 1];
      v->weight_luma_l1[i] = header->luma_weight_l1[i];
      v->weight_luma_offset_l1[i] = header->luma_offset_l1[i];
      v->weight_chroma_l1[i * 2] = header->chroma_weight_l1[i * 2];
      v->weight_chroma_l1[i * 2 + 1] = header->chroma_weight_l1[i * 2 + 1];
      v->weight_chroma_offset_l1[i * 2] = header->chroma_offset_l1[i * 2];
      v->weight_chroma_offset_l1[i * 2 + 1] = header->chroma_offset_l1[i * 2 + 1];
    }
  }

  var address: int32 = header->first_mb_in_slice;
  while (address < v->mb_count) {
    v->mb_index = address;
    v->mb_x = address % v->mb_width;
    v->mb_y = address / v->mb_width;

    var mb_status: int32 = h264_decode_macroblock(v, pps, header);
    if (g_trace_mb != 0) {
      var mb: H264Macroblock* = &v->macroblocks[address];
      println("mb {address} kind {mb->kind} skip {mb->skipped} intra {mb->is_intra} cbp {mb->cbp_luma}/{mb->cbp_chroma} qp {mb->qp} mv0 {mb->mv_x[0]},{mb->mv_y[0]} r {mb->ref_index[0]}/{mb->ref_index[4]}");
      fflush(0);
    }
    if (mb_status != H264_OK) { return mb_status; }

    if (h264_decode_terminate(v) != 0) { break; }
    address = address + 1;
  }
  return H264_OK;
}

fn h264_decode_sample(v: H264Video*, sample: uint8*, size: int64) -> int32 {
  var parser: H264Decoder* = v->parser;
  var count: int32 = h264_nal_count(parser, sample, size);
  var decoded: int32 = 0;
  var last: H264SliceHeader;

  for i in 0..count {
    var nal_size: int64 = 0;
    var nal: uint8* = h264_nal_at(parser, sample, size, i, &nal_size);
    if (nal == 0) { continue; }
    var kind: int32 = h264_nal_type(nal);

    if (kind == H264_NAL_SPS) {
      h264_parse_sps(parser, nal, nal_size);
    } else if (kind == H264_NAL_PPS) {
      h264_parse_pps(parser, nal, nal_size);
    } else if (kind == H264_NAL_SLICE || kind == H264_NAL_IDR) {
      var header: H264SliceHeader;
      var status: int32 = h264_parse_slice_header(parser, nal, nal_size, &header);
      if (status != H264_OK) { return status; }
      status = h264_decode_slice(v, &header);
      if (status != H264_OK) { return status; }
      last = header;
      decoded = decoded + 1;
    }
  }
  if (decoded == 0) { return H264_ERR_BITSTREAM; }
  h264_end_picture(v, &parser->sps[parser->active_sps], &last);
  return H264_OK;
}

fn h264_video_reset(v: H264Video*) {
  for i in 0..H264_MAX_PICTURES {
    v->pictures[i].used = 0;
    v->pictures[i].is_reference = 0;
  }
  v->current_picture = 0;
  v->ref_count0 = 0;
  v->ref_count1 = 0;
  v->previous_poc_msb = 0;
  v->previous_poc_lsb = 0;
  v->previous_frame_num = 0;
  v->previous_frame_num_offset = 0;
}

fn h264_write_pixels_to(v: H264Video*, out: uint32*) {
  var pairs: int32 = v->width / 2;
  for y in 0..v->height {
    var source_y: int32 = y + v->crop_top;
    var luma_row: int64 = (int64)source_y * (int64)v->luma_stride + (int64)v->crop_left;
    var chroma_row: int64 = (int64)(source_y >> 1) * (int64)v->chroma_stride +
                            (int64)(v->crop_left >> 1);
    var target: int64 = (int64)y * (int64)v->width;

    for i in 0..pairs {
      var blue_diff: int32 = (int32)v->cb[chroma_row + (int64)i] - 128;
      var red_diff: int32 = (int32)v->cr[chroma_row + (int64)i] - 128;
      var red_bias: int32 = 104597 * red_diff + 32768;
      var green_bias: int32 = 32768 - 25675 * blue_diff - 53279 * red_diff;
      var blue_bias: int32 = 132201 * blue_diff + 32768;

      var luma: int32 = (int32)v->luma[luma_row + (int64)(i * 2)] - 16;
      var base: int32 = 76309 * luma;
      var red: int32 = (base + red_bias) >> 16;
      var green: int32 = (base + green_bias) >> 16;
      var blue: int32 = (base + blue_bias) >> 16;
      if (red < 0) { red = 0; }
      if (red > 255) { red = 255; }
      if (green < 0) { green = 0; }
      if (green > 255) { green = 255; }
      if (blue < 0) { blue = 0; }
      if (blue > 255) { blue = 255; }
      out[target + (int64)(i * 2)] = ((uint32)red << 16) | ((uint32)green << 8) | (uint32)blue;

      luma = (int32)v->luma[luma_row + (int64)(i * 2 + 1)] - 16;
      base = 76309 * luma;
      red = (base + red_bias) >> 16;
      green = (base + green_bias) >> 16;
      blue = (base + blue_bias) >> 16;
      if (red < 0) { red = 0; }
      if (red > 255) { red = 255; }
      if (green < 0) { green = 0; }
      if (green > 255) { green = 255; }
      if (blue < 0) { blue = 0; }
      if (blue > 255) { blue = 255; }
      out[target + (int64)(i * 2 + 1)] = ((uint32)red << 16) | ((uint32)green << 8) | (uint32)blue;
    }
    for x in (pairs * 2)..v->width {
      var luma: int32 = (int32)v->luma[luma_row + (int64)x] - 16;
      var blue_diff: int32 = (int32)v->cb[chroma_row + (int64)(x >> 1)] - 128;
      var red_diff: int32 = (int32)v->cr[chroma_row + (int64)(x >> 1)] - 128;
      var base: int32 = 76309 * luma;
      var red: int32 = (base + 104597 * red_diff + 32768) >> 16;
      var green: int32 = (base - 25675 * blue_diff - 53279 * red_diff + 32768) >> 16;
      var blue: int32 = (base + 132201 * blue_diff + 32768) >> 16;
      if (red < 0) { red = 0; }
      if (red > 255) { red = 255; }
      if (green < 0) { green = 0; }
      if (green > 255) { green = 255; }
      if (blue < 0) { blue = 0; }
      if (blue > 255) { blue = 255; }
      out[target + (int64)x] = ((uint32)red << 16) | ((uint32)green << 8) | (uint32)blue;
    }
  }
}

fn h264_write_pixels(v: H264Video*) {
  h264_write_pixels_to(v, v->pixels);
}
