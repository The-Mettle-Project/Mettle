import "h264_decode"

var g_bs_vertical: int32[16]
var g_bs_horizontal: int32[16]

@inline fn h264_clip3(value: int32, low: int32, high: int32) -> int32 {
  if value < low { return low }
  if value > high { return high }
  return value
}

@inline fn h264_vectors_differ(a: H264Macroblock*, b: H264Macroblock*,
                               block_a: int32, block_b: int32,
                               list_a: int32, list_b: int32) -> bool {
  var dx = (int32)a.mv_x[list_a * 16 + block_a] - (int32)b.mv_x[list_b * 16 + block_b]
  if dx < 0 { dx = -dx }
  if dx >= 4 { return true }
  var dy = (int32)a.mv_y[list_a * 16 + block_a] - (int32)b.mv_y[list_b * 16 + block_b]
  if dy < 0 { dy = -dy }
  return dy >= 4
}

fn h264_motion_differs(a: H264Macroblock*, b: H264Macroblock*,
                       block_a: int32, block_b: int32) -> int32 {
  var eight_a = (block_a >> 3) * 2 + ((block_a & 3) >> 1)
  var eight_b = (block_b >> 3) * 2 + ((block_b & 3) >> 1)

  var a0 = a.ref_picture[eight_a]
  var a1 = a.ref_picture[4 + eight_a]
  var b0 = b.ref_picture[eight_b]
  var b1 = b.ref_picture[4 + eight_b]

  var straight = a0 == b0 && a1 == b1
  var crossed = a0 == b1 && a1 == b0
  if !straight && !crossed { return 1 }

  if a0 == a1 {
    if h264_vectors_differ(a, b, block_a, block_b, 0, 0) ||
       h264_vectors_differ(a, b, block_a, block_b, 1, 1) {
      if h264_vectors_differ(a, b, block_a, block_b, 0, 1) ||
         h264_vectors_differ(a, b, block_a, block_b, 1, 0) {
        return 1
      }
    }
    return 0
  }

  if straight {
    if a0 >= 0 && h264_vectors_differ(a, b, block_a, block_b, 0, 0) { return 1 }
    if a1 >= 0 && h264_vectors_differ(a, b, block_a, block_b, 1, 1) { return 1 }
    return 0
  }

  if a0 >= 0 && h264_vectors_differ(a, b, block_a, block_b, 0, 1) { return 1 }
  if a1 >= 0 && h264_vectors_differ(a, b, block_a, block_b, 1, 0) { return 1 }
  return 0
}

@inline fn h264_boundary_strength(a: H264Macroblock*, b: H264Macroblock*,
                                  current_block: int32, neighbour_block: int32,
                                  mb_edge: bool) -> int32 {
  if a.is_intra != 0 || b.is_intra != 0 {
    return if mb_edge { 4 } else { 3 }
  }
  if a.luma_nonzero[current_block] != 0 { return 2 }
  if b.luma_nonzero[neighbour_block] != 0 { return 2 }
  return h264_motion_differs(a, b, current_block, neighbour_block)
}

@inline fn h264_edge_is_plain(a: H264Macroblock*, b: H264Macroblock*) -> bool {
  if a.is_intra != 0 || b.is_intra != 0 { return false }
  if a.nonzero_any != 0 || b.nonzero_any != 0 { return false }
  return a.uniform != 0 && b.uniform != 0
}

fn h264_edge_strengths_vertical(v: H264Video*, current: int32, edge: int32, out: int32*) -> bool {
  var mb_edge = edge == 0
  var neighbour = if mb_edge { current - 1 } else { current }
  var a = &v.macroblocks[current]
  var b = &v.macroblocks[neighbour]

  if h264_edge_is_plain(a, b) {
    var previous = if mb_edge { 3 } else { edge - 1 }
    var same = h264_motion_differs(a, b, edge, previous)
    out[0] = same
    out[1] = same
    out[2] = same
    out[3] = same
    return same != 0
  }

  var any = false
  for group in 0..4 {
    var current_block = group * 4 + edge
    var neighbour_block = if mb_edge { group * 4 + 3 } else { current_block - 1 }
    var strength = h264_boundary_strength(a, b, current_block, neighbour_block, mb_edge)
    out[group] = strength
    if strength != 0 { any = true }
  }
  return any
}

fn h264_edge_strengths_horizontal(v: H264Video*, current: int32, edge: int32, out: int32*) -> bool {
  var mb_edge = edge == 0
  var neighbour = if mb_edge { current - v.mb_width } else { current }
  var a = &v.macroblocks[current]
  var b = &v.macroblocks[neighbour]

  if h264_edge_is_plain(a, b) {
    var previous = if mb_edge { 12 } else { edge * 4 - 4 }
    var same = h264_motion_differs(a, b, edge * 4, previous)
    out[0] = same
    out[1] = same
    out[2] = same
    out[3] = same
    return same != 0
  }

  var any = false
  for group in 0..4 {
    var current_block = edge * 4 + group
    var neighbour_block = if mb_edge { 12 + group } else { current_block - 4 }
    var strength = h264_boundary_strength(a, b, current_block, neighbour_block, mb_edge)
    out[group] = strength
    if strength != 0 { any = true }
  }
  return any
}

fn h264_filter_luma_line(plane: uint8*, base: int64, s1: int64,
                         strength: int32, alpha: int32, beta: int32, tc0: int32) {
  var q0 = (int32)plane[base]
  var p0 = (int32)plane[base - s1]
  var difference = p0 - q0
  if difference < 0 { difference = -difference }
  if difference >= alpha { return }

  var s2 = s1 + s1
  var p1 = (int32)plane[base - s2]
  var edge_p = p1 - p0
  if edge_p < 0 { edge_p = -edge_p }
  if edge_p >= beta { return }

  var q1 = (int32)plane[base + s1]
  var edge_q = q1 - q0
  if edge_q < 0 { edge_q = -edge_q }
  if edge_q >= beta { return }

  var s3 = s2 + s1
  var p2 = (int32)plane[base - s3]
  var q2 = (int32)plane[base + s2]

  var ap = p2 - p0
  if ap < 0 { ap = -ap }
  var aq = q2 - q0
  if aq < 0 { aq = -aq }

  if strength < 4 {
    var tc = tc0
    if ap < beta { tc += 1 }
    if aq < beta { tc += 1 }
    var delta = h264_clip3((((q0 - p0) * 4) + (p1 - q1) + 4) >> 3, -tc, tc)
    plane[base - s1] = h264_clip_sample(p0 + delta)
    plane[base] = h264_clip_sample(q0 - delta)
    if ap < beta {
      plane[base - s2] = (uint8)(p1 + h264_clip3((p2 + ((p0 + q0 + 1) >> 1) - (p1 * 2)) >> 1, -tc0, tc0))
    }
    if aq < beta {
      plane[base + s1] = (uint8)(q1 + h264_clip3((q2 + ((p0 + q0 + 1) >> 1) - (q1 * 2)) >> 1, -tc0, tc0))
    }
    return
  }

  var narrow = (alpha >> 2) + 2
  if ap < beta && difference < narrow {
    var p3 = (int32)plane[base - s3 - s1]
    plane[base - s1] = (uint8)((p2 + 2 * p1 + 2 * p0 + 2 * q0 + q1 + 4) >> 3)
    plane[base - s2] = (uint8)((p2 + p1 + p0 + q0 + 2) >> 2)
    plane[base - s3] = (uint8)((2 * p3 + 3 * p2 + p1 + p0 + q0 + 4) >> 3)
  } else {
    plane[base - s1] = (uint8)((2 * p1 + p0 + q1 + 2) >> 2)
  }
  if aq < beta && difference < narrow {
    var q3 = (int32)plane[base + s3]
    plane[base] = (uint8)((q2 + 2 * q1 + 2 * q0 + 2 * p0 + p1 + 4) >> 3)
    plane[base + s1] = (uint8)((q2 + q1 + q0 + p0 + 2) >> 2)
    plane[base + s2] = (uint8)((2 * q3 + 3 * q2 + q1 + q0 + p0 + 4) >> 3)
  } else {
    plane[base] = (uint8)((2 * q1 + q0 + p1 + 2) >> 2)
  }
}

fn h264_filter_chroma_line(plane: uint8*, base: int64, s1: int64,
                           strength: int32, alpha: int32, beta: int32, tc0: int32) {
  var q0 = (int32)plane[base]
  var p0 = (int32)plane[base - s1]
  var difference = p0 - q0
  if difference < 0 { difference = -difference }
  if difference >= alpha { return }

  var p1 = (int32)plane[base - s1 - s1]
  var edge_p = p1 - p0
  if edge_p < 0 { edge_p = -edge_p }
  if edge_p >= beta { return }

  var q1 = (int32)plane[base + s1]
  var edge_q = q1 - q0
  if edge_q < 0 { edge_q = -edge_q }
  if edge_q >= beta { return }

  if strength < 4 {
    var tc = tc0 + 1
    var delta = h264_clip3((((q0 - p0) * 4) + (p1 - q1) + 4) >> 3, -tc, tc)
    plane[base - s1] = h264_clip_sample(p0 + delta)
    plane[base] = h264_clip_sample(q0 - delta)
    return
  }
  plane[base - s1] = (uint8)((2 * p1 + p0 + q1 + 2) >> 2)
  plane[base] = (uint8)((2 * q1 + q0 + p1 + 2) >> 2)
}

@inline fn h264_edge_limits(v: H264Video*, qp_a: int32, qp_b: int32,
                            out_alpha: int32*, out_beta: int32*, tc: int32*) {
  var average = (qp_a + qp_b + 1) >> 1
  var index_a = h264_clip3(average + v.alpha_offset, 0, 51)
  var index_b = h264_clip3(average + v.beta_offset, 0, 51)
  *out_alpha = v.deblock_alpha[index_a]
  *out_beta = v.deblock_beta[index_b]
  tc[0] = 0
  tc[1] = v.deblock_tc[index_a * 3]
  tc[2] = v.deblock_tc[index_a * 3 + 1]
  tc[3] = v.deblock_tc[index_a * 3 + 2]
}

fn h264_deblock_vertical_luma(v: H264Video*, mb_x: int32, mb_y: int32, edge: int32,
                              strengths: int32*, qp_a: int32, qp_b: int32) {
  var alpha = 0
  var beta = 0
  var tc: int32[4]
  h264_edge_limits(v, qp_a, qp_b, &alpha, &beta, &tc[0])
  if alpha == 0 { return }

  var stride = (int64)v.luma_stride
  var base = (int64)(mb_y * 16) * stride + (int64)(mb_x * 16 + edge * 4)
  for group in 0..4 {
    var strength = strengths[group]
    if strength == 0 {
      base += stride * 4
      continue
    }
    var limit = if strength < 4 { tc[strength] } else { 0 }
    for line in 0..4 {
      h264_filter_luma_line(v.luma, base, 1, strength, alpha, beta, limit)
      base += stride
    }
  }
}

fn h264_deblock_horizontal_luma(v: H264Video*, mb_x: int32, mb_y: int32, edge: int32,
                                strengths: int32*, qp_a: int32, qp_b: int32) {
  var alpha = 0
  var beta = 0
  var tc: int32[4]
  h264_edge_limits(v, qp_a, qp_b, &alpha, &beta, &tc[0])
  if alpha == 0 { return }

  var stride = (int64)v.luma_stride
  var base = (int64)(mb_y * 16 + edge * 4) * stride + (int64)(mb_x * 16)
  for group in 0..4 {
    var strength = strengths[group]
    if strength == 0 {
      base += 4
      continue
    }
    var limit = if strength < 4 { tc[strength] } else { 0 }
    for line in 0..4 {
      h264_filter_luma_line(v.luma, base, stride, strength, alpha, beta, limit)
      base += 1
    }
  }
}

fn h264_deblock_vertical_chroma(v: H264Video*, mb_x: int32, mb_y: int32, edge: int32,
                                strengths: int32*, qp_cur: int32, qp_nb: int32) {
  var stride = (int64)v.chroma_stride
  var origin = (int64)(mb_y * 8) * stride + (int64)(mb_x * 8 + edge * 4)
  for component in 0..2 {
    var plane = if component == 1 { v.cr } else { v.cb }
    var qp_a = h264_chroma_qp(v, qp_cur, v.chroma_offset[component])
    var qp_b = h264_chroma_qp(v, qp_nb, v.chroma_offset[component])
    var alpha = 0
    var beta = 0
    var tc: int32[4]
    h264_edge_limits(v, qp_a, qp_b, &alpha, &beta, &tc[0])
    if alpha == 0 { continue }

    var base = origin
    for group in 0..4 {
      var strength = strengths[group]
      if strength == 0 {
        base += stride + stride
        continue
      }
      var limit = if strength < 4 { tc[strength] } else { 0 }
      for line in 0..2 {
        h264_filter_chroma_line(plane, base, 1, strength, alpha, beta, limit)
        base += stride
      }
    }
  }
}

fn h264_deblock_horizontal_chroma(v: H264Video*, mb_x: int32, mb_y: int32, edge: int32,
                                  strengths: int32*, qp_cur: int32, qp_nb: int32) {
  var stride = (int64)v.chroma_stride
  var origin = (int64)(mb_y * 8 + edge * 4) * stride + (int64)(mb_x * 8)
  for component in 0..2 {
    var plane = if component == 1 { v.cr } else { v.cb }
    var qp_a = h264_chroma_qp(v, qp_cur, v.chroma_offset[component])
    var qp_b = h264_chroma_qp(v, qp_nb, v.chroma_offset[component])
    var alpha = 0
    var beta = 0
    var tc: int32[4]
    h264_edge_limits(v, qp_a, qp_b, &alpha, &beta, &tc[0])
    if alpha == 0 { continue }

    var base = origin
    for group in 0..4 {
      var strength = strengths[group]
      if strength == 0 {
        base += 2
        continue
      }
      var limit = if strength < 4 { tc[strength] } else { 0 }
      for line in 0..2 {
        h264_filter_chroma_line(plane, base, stride, strength, alpha, beta, limit)
        base += 1
      }
    }
  }
}

fn h264_deblock_picture(v: H264Video*) {
  if v.disable_deblocking == 1 || v.skip_deblocking != 0 { return }

  var any_v: bool[4]
  var any_h: bool[4]

  for mb_y in 0..v.mb_height {
    for mb_x in 0..v.mb_width {
      var current = mb_y * v.mb_width + mb_x
      var mb = &v.macroblocks[current]
      var eight = mb.transform_8x8 != 0
      var qp_cur = mb.qp
      var qp_left = if mb_x > 0 { v.macroblocks[current - 1].qp } else { qp_cur }
      var qp_above = if mb_y > 0 { v.macroblocks[current - v.mb_width].qp } else { qp_cur }
      var quiet = mb.is_intra == 0 && mb.nonzero_any == 0 && mb.uniform != 0

      for edge in 0..4 {
        any_v[edge] = false
        any_h[edge] = false
      }

      for edge in 0..4 {
        if edge == 0 && mb_x == 0 { continue }
        if eight && (edge & 1) != 0 { continue }
        if edge != 0 && quiet { continue }
        any_v[edge] = h264_edge_strengths_vertical(v, current, edge, &g_bs_vertical[edge * 4])
        if !any_v[edge] { continue }
        var qp_nb = if edge == 0 { qp_left } else { qp_cur }
        h264_deblock_vertical_luma(v, mb_x, mb_y, edge, &g_bs_vertical[edge * 4], qp_cur, qp_nb)
      }
      for edge in 0..2 {
        var luma_edge = edge * 2
        if !any_v[luma_edge] { continue }
        var qp_nb = if edge == 0 { qp_left } else { qp_cur }
        h264_deblock_vertical_chroma(v, mb_x, mb_y, edge, &g_bs_vertical[luma_edge * 4], qp_cur, qp_nb)
      }
      for edge in 0..4 {
        if edge == 0 && mb_y == 0 { continue }
        if eight && (edge & 1) != 0 { continue }
        if edge != 0 && quiet { continue }
        any_h[edge] = h264_edge_strengths_horizontal(v, current, edge, &g_bs_horizontal[edge * 4])
        if !any_h[edge] { continue }
        var qp_nb = if edge == 0 { qp_above } else { qp_cur }
        h264_deblock_horizontal_luma(v, mb_x, mb_y, edge, &g_bs_horizontal[edge * 4], qp_cur, qp_nb)
      }
      for edge in 0..2 {
        var luma_edge = edge * 2
        if !any_h[luma_edge] { continue }
        var qp_nb = if edge == 0 { qp_above } else { qp_cur }
        h264_deblock_horizontal_chroma(v, mb_x, mb_y, edge, &g_bs_horizontal[luma_edge * 4], qp_cur, qp_nb)
      }
    }
  }
}
