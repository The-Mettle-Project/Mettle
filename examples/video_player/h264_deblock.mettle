import "h264_decode";

var g_bs_vertical: int32[16];
var g_bs_horizontal: int32[16];

fn h264_clip3(value: int32, low: int32, high: int32) -> int32 {
  if (value < low) { return low; }
  if (value > high) { return high; }
  return value;
}

fn h264_vectors_differ(a: H264Macroblock*, b: H264Macroblock*, block_a: int32, block_b: int32,
                       list_a: int32, list_b: int32) -> int32 {
  var difference_x: int32 = (int32)a->mv_x[list_a * 16 + block_a] -
                            (int32)b->mv_x[list_b * 16 + block_b];
  if (difference_x < 0) { difference_x = 0 - difference_x; }
  if (difference_x >= 4) { return 1; }
  var difference_y: int32 = (int32)a->mv_y[list_a * 16 + block_a] -
                            (int32)b->mv_y[list_b * 16 + block_b];
  if (difference_y < 0) { difference_y = 0 - difference_y; }
  if (difference_y >= 4) { return 1; }
  return 0;
}

fn h264_motion_differs(a: H264Macroblock*, b: H264Macroblock*,
                       block_a: int32, block_b: int32) -> int32 {
  var eight_a: int32 = (block_a >> 3) * 2 + ((block_a & 3) >> 1);
  var eight_b: int32 = (block_b >> 3) * 2 + ((block_b & 3) >> 1);

  var a0: int32 = a->ref_picture[eight_a];
  var a1: int32 = a->ref_picture[4 + eight_a];
  var b0: int32 = b->ref_picture[eight_b];
  var b1: int32 = b->ref_picture[4 + eight_b];

  var straight: int32 = 0;
  var crossed: int32 = 0;
  if (a0 == b0 && a1 == b1) { straight = 1; }
  if (a0 == b1 && a1 == b0) { crossed = 1; }
  if (straight == 0 && crossed == 0) { return 1; }

  if (a0 == a1) {
    if (h264_vectors_differ(a, b, block_a, block_b, 0, 0) != 0 ||
        h264_vectors_differ(a, b, block_a, block_b, 1, 1) != 0) {
      if (h264_vectors_differ(a, b, block_a, block_b, 0, 1) != 0 ||
          h264_vectors_differ(a, b, block_a, block_b, 1, 0) != 0) {
        return 1;
      }
    }
    return 0;
  }

  if (straight != 0) {
    if (a0 >= 0 && h264_vectors_differ(a, b, block_a, block_b, 0, 0) != 0) { return 1; }
    if (a1 >= 0 && h264_vectors_differ(a, b, block_a, block_b, 1, 1) != 0) { return 1; }
    return 0;
  }

  if (a0 >= 0 && h264_vectors_differ(a, b, block_a, block_b, 0, 1) != 0) { return 1; }
  if (a1 >= 0 && h264_vectors_differ(a, b, block_a, block_b, 1, 0) != 0) { return 1; }
  return 0;
}

fn h264_boundary_strength(v: H264Video*, current: int32, neighbour: int32,
                          current_block: int32, neighbour_block: int32,
                          mb_edge: int32) -> int32 {
  var a: H264Macroblock* = &v->macroblocks[current];
  var b: H264Macroblock* = &v->macroblocks[neighbour];
  if (mb_edge != 0 && (a->is_intra != 0 || b->is_intra != 0)) { return 4; }
  if (a->is_intra != 0 || b->is_intra != 0) { return 3; }
  if (a->luma_nonzero[current_block] != (uint8)0) { return 2; }
  if (b->luma_nonzero[neighbour_block] != (uint8)0) { return 2; }
  return h264_motion_differs(a, b, current_block, neighbour_block);
}

fn h264_edge_strengths_vertical(v: H264Video*, current: int32, edge: int32, out: int32*) -> int32 {
  var mb_edge: int32 = 0;
  var neighbour: int32 = current;
  if (edge == 0) {
    mb_edge = 1;
    neighbour = current - 1;
  }
  var any: int32 = 0;
  for group in 0..4 {
    var current_block: int32 = group * 4 + edge;
    var neighbour_block: int32 = current_block - 1;
    if (edge == 0) { neighbour_block = group * 4 + 3; }
    var strength: int32 = h264_boundary_strength(v, current, neighbour, current_block,
                                                 neighbour_block, mb_edge);
    out[group] = strength;
    if (strength != 0) { any = 1; }
  }
  return any;
}

fn h264_edge_strengths_horizontal(v: H264Video*, current: int32, edge: int32,
                                  out: int32*) -> int32 {
  var mb_edge: int32 = 0;
  var neighbour: int32 = current;
  if (edge == 0) {
    mb_edge = 1;
    neighbour = current - v->mb_width;
  }
  var any: int32 = 0;
  for group in 0..4 {
    var current_block: int32 = edge * 4 + group;
    var neighbour_block: int32 = current_block - 4;
    if (edge == 0) { neighbour_block = 12 + group; }
    var strength: int32 = h264_boundary_strength(v, current, neighbour, current_block,
                                                 neighbour_block, mb_edge);
    out[group] = strength;
    if (strength != 0) { any = 1; }
  }
  return any;
}

fn h264_filter_luma_line(plane: uint8*, base: int64, s1: int64,
                         strength: int32, alpha: int32, beta: int32, tc0: int32) {
  var q0: int32 = (int32)plane[base];
  var p0: int32 = (int32)plane[base - s1];
  var difference: int32 = p0 - q0;
  if (difference < 0) { difference = 0 - difference; }
  if (difference >= alpha) { return; }

  var s2: int64 = s1 + s1;
  var p1: int32 = (int32)plane[base - s2];
  var edge_p: int32 = p1 - p0;
  if (edge_p < 0) { edge_p = 0 - edge_p; }
  if (edge_p >= beta) { return; }

  var q1: int32 = (int32)plane[base + s1];
  var edge_q: int32 = q1 - q0;
  if (edge_q < 0) { edge_q = 0 - edge_q; }
  if (edge_q >= beta) { return; }

  var s3: int64 = s2 + s1;
  var p2: int32 = (int32)plane[base - s3];
  var q2: int32 = (int32)plane[base + s2];

  var ap: int32 = p2 - p0;
  if (ap < 0) { ap = 0 - ap; }
  var aq: int32 = q2 - q0;
  if (aq < 0) { aq = 0 - aq; }

  if (strength < 4) {
    var tc: int32 = tc0;
    if (ap < beta) { tc = tc + 1; }
    if (aq < beta) { tc = tc + 1; }
    var delta: int32 = h264_clip3((((q0 - p0) * 4) + (p1 - q1) + 4) >> 3, 0 - tc, tc);
    plane[base - s1] = h264_clip_sample(p0 + delta);
    plane[base] = h264_clip_sample(q0 - delta);
    if (ap < beta) {
      plane[base - s2] =
        (uint8)(p1 + h264_clip3((p2 + ((p0 + q0 + 1) >> 1) - (p1 * 2)) >> 1, 0 - tc0, tc0));
    }
    if (aq < beta) {
      plane[base + s1] =
        (uint8)(q1 + h264_clip3((q2 + ((p0 + q0 + 1) >> 1) - (q1 * 2)) >> 1, 0 - tc0, tc0));
    }
    return;
  }

  var narrow: int32 = (alpha >> 2) + 2;
  if (ap < beta && difference < narrow) {
    var p3: int32 = (int32)plane[base - s3 - s1];
    plane[base - s1] = (uint8)((p2 + 2 * p1 + 2 * p0 + 2 * q0 + q1 + 4) >> 3);
    plane[base - s2] = (uint8)((p2 + p1 + p0 + q0 + 2) >> 2);
    plane[base - s3] = (uint8)((2 * p3 + 3 * p2 + p1 + p0 + q0 + 4) >> 3);
  } else {
    plane[base - s1] = (uint8)((2 * p1 + p0 + q1 + 2) >> 2);
  }
  if (aq < beta && difference < narrow) {
    var q3: int32 = (int32)plane[base + s3];
    plane[base] = (uint8)((q2 + 2 * q1 + 2 * q0 + 2 * p0 + p1 + 4) >> 3);
    plane[base + s1] = (uint8)((q2 + q1 + q0 + p0 + 2) >> 2);
    plane[base + s2] = (uint8)((2 * q3 + 3 * q2 + q1 + q0 + p0 + 4) >> 3);
  } else {
    plane[base] = (uint8)((2 * q1 + q0 + p1 + 2) >> 2);
  }
}

fn h264_filter_chroma_line(plane: uint8*, base: int64, s1: int64,
                           strength: int32, alpha: int32, beta: int32, tc0: int32) {
  var q0: int32 = (int32)plane[base];
  var p0: int32 = (int32)plane[base - s1];
  var difference: int32 = p0 - q0;
  if (difference < 0) { difference = 0 - difference; }
  if (difference >= alpha) { return; }

  var p1: int32 = (int32)plane[base - s1 - s1];
  var edge_p: int32 = p1 - p0;
  if (edge_p < 0) { edge_p = 0 - edge_p; }
  if (edge_p >= beta) { return; }

  var q1: int32 = (int32)plane[base + s1];
  var edge_q: int32 = q1 - q0;
  if (edge_q < 0) { edge_q = 0 - edge_q; }
  if (edge_q >= beta) { return; }

  if (strength < 4) {
    var tc: int32 = tc0 + 1;
    var delta: int32 = h264_clip3((((q0 - p0) * 4) + (p1 - q1) + 4) >> 3, 0 - tc, tc);
    plane[base - s1] = h264_clip_sample(p0 + delta);
    plane[base] = h264_clip_sample(q0 - delta);
    return;
  }
  plane[base - s1] = (uint8)((2 * p1 + p0 + q1 + 2) >> 2);
  plane[base] = (uint8)((2 * q1 + q0 + p1 + 2) >> 2);
}

fn h264_edge_limits(v: H264Video*, qp_a: int32, qp_b: int32,
                    out_alpha: int32*, out_beta: int32*, tc: int32*) {
  var average: int32 = (qp_a + qp_b + 1) >> 1;
  var index_a: int32 = h264_clip3(average + v->alpha_offset, 0, 51);
  var index_b: int32 = h264_clip3(average + v->beta_offset, 0, 51);
  *out_alpha = v->deblock_alpha[index_a];
  *out_beta = v->deblock_beta[index_b];
  tc[0] = 0;
  tc[1] = v->deblock_tc[index_a * 3];
  tc[2] = v->deblock_tc[index_a * 3 + 1];
  tc[3] = v->deblock_tc[index_a * 3 + 2];
}

fn h264_deblock_vertical_luma(v: H264Video*, mb_x: int32, mb_y: int32, edge: int32,
                              strengths: int32*, qp_a: int32, qp_b: int32) {
  var alpha: int32 = 0;
  var beta: int32 = 0;
  var tc: int32[4];
  h264_edge_limits(v, qp_a, qp_b, &alpha, &beta, &tc[0]);
  if (alpha == 0) { return; }

  var stride: int64 = (int64)v->luma_stride;
  var base: int64 = (int64)(mb_y * 16) * stride + (int64)(mb_x * 16 + edge * 4);
  for group in 0..4 {
    var strength: int32 = strengths[group];
    if (strength == 0) {
      base = base + stride * (int64)4;
      continue;
    }
    var limit: int32 = 0;
    if (strength < 4) { limit = tc[strength]; }
    for line in 0..4 {
      h264_filter_luma_line(v->luma, base, (int64)1, strength, alpha, beta, limit);
      base = base + stride;
    }
  }
}

fn h264_deblock_horizontal_luma(v: H264Video*, mb_x: int32, mb_y: int32, edge: int32,
                                strengths: int32*, qp_a: int32, qp_b: int32) {
  var alpha: int32 = 0;
  var beta: int32 = 0;
  var tc: int32[4];
  h264_edge_limits(v, qp_a, qp_b, &alpha, &beta, &tc[0]);
  if (alpha == 0) { return; }

  var stride: int64 = (int64)v->luma_stride;
  var base: int64 = (int64)(mb_y * 16 + edge * 4) * stride + (int64)(mb_x * 16);
  for group in 0..4 {
    var strength: int32 = strengths[group];
    if (strength == 0) {
      base = base + (int64)4;
      continue;
    }
    var limit: int32 = 0;
    if (strength < 4) { limit = tc[strength]; }
    for line in 0..4 {
      h264_filter_luma_line(v->luma, base, stride, strength, alpha, beta, limit);
      base = base + (int64)1;
    }
  }
}

fn h264_deblock_vertical_chroma(v: H264Video*, mb_x: int32, mb_y: int32, edge: int32,
                                strengths: int32*, qp_cur: int32, qp_nb: int32) {
  var stride: int64 = (int64)v->chroma_stride;
  var origin: int64 = (int64)(mb_y * 8) * stride + (int64)(mb_x * 8 + edge * 4);
  for component in 0..2 {
    var plane: uint8* = v->cb;
    if (component == 1) { plane = v->cr; }
    var qp_a: int32 = h264_chroma_qp(v, qp_cur, v->chroma_offset[component]);
    var qp_b: int32 = h264_chroma_qp(v, qp_nb, v->chroma_offset[component]);
    var alpha: int32 = 0;
    var beta: int32 = 0;
    var tc: int32[4];
    h264_edge_limits(v, qp_a, qp_b, &alpha, &beta, &tc[0]);
    if (alpha == 0) { continue; }

    var base: int64 = origin;
    for group in 0..4 {
      var strength: int32 = strengths[group];
      if (strength == 0) {
        base = base + stride + stride;
        continue;
      }
      var limit: int32 = 0;
      if (strength < 4) { limit = tc[strength]; }
      for line in 0..2 {
        h264_filter_chroma_line(plane, base, (int64)1, strength, alpha, beta, limit);
        base = base + stride;
      }
    }
  }
}

fn h264_deblock_horizontal_chroma(v: H264Video*, mb_x: int32, mb_y: int32, edge: int32,
                                  strengths: int32*, qp_cur: int32, qp_nb: int32) {
  var stride: int64 = (int64)v->chroma_stride;
  var origin: int64 = (int64)(mb_y * 8 + edge * 4) * stride + (int64)(mb_x * 8);
  for component in 0..2 {
    var plane: uint8* = v->cb;
    if (component == 1) { plane = v->cr; }
    var qp_a: int32 = h264_chroma_qp(v, qp_cur, v->chroma_offset[component]);
    var qp_b: int32 = h264_chroma_qp(v, qp_nb, v->chroma_offset[component]);
    var alpha: int32 = 0;
    var beta: int32 = 0;
    var tc: int32[4];
    h264_edge_limits(v, qp_a, qp_b, &alpha, &beta, &tc[0]);
    if (alpha == 0) { continue; }

    var base: int64 = origin;
    for group in 0..4 {
      var strength: int32 = strengths[group];
      if (strength == 0) {
        base = base + (int64)2;
        continue;
      }
      var limit: int32 = 0;
      if (strength < 4) { limit = tc[strength]; }
      for line in 0..2 {
        h264_filter_chroma_line(plane, base, stride, strength, alpha, beta, limit);
        base = base + (int64)1;
      }
    }
  }
}

fn h264_deblock_picture(v: H264Video*) {
  if (v->disable_deblocking == 1 || v->skip_deblocking != 0) { return; }

  var any_v: int32[4];
  var any_h: int32[4];

  for mb_y in 0..v->mb_height {
    for mb_x in 0..v->mb_width {
      var current: int32 = mb_y * v->mb_width + mb_x;
      var mb: H264Macroblock* = &v->macroblocks[current];
      var eight: int32 = mb->transform_8x8;
      var qp_cur: int32 = mb->qp;
      var qp_left: int32 = qp_cur;
      if (mb_x > 0) { qp_left = v->macroblocks[current - 1].qp; }
      var qp_above: int32 = qp_cur;
      if (mb_y > 0) { qp_above = v->macroblocks[current - v->mb_width].qp; }

      var quiet: int32 = 0;
      if (mb->is_intra == 0 && mb->nonzero_any == (uint8)0 && mb->uniform != (uint8)0) {
        quiet = 1;
      }

      for edge in 0..4 { any_v[edge] = 0; }
      for edge in 0..4 { any_h[edge] = 0; }

      for edge in 0..4 {
        if (edge == 0 && mb_x == 0) { continue; }
        if (eight != 0 && (edge & 1) != 0) { continue; }
        if (edge != 0 && quiet != 0) { continue; }
        any_v[edge] = h264_edge_strengths_vertical(v, current, edge, &g_bs_vertical[edge * 4]);
        if (any_v[edge] == 0) { continue; }
        var qp_nb: int32 = qp_cur;
        if (edge == 0) { qp_nb = qp_left; }
        h264_deblock_vertical_luma(v, mb_x, mb_y, edge, &g_bs_vertical[edge * 4], qp_cur, qp_nb);
      }
      for edge in 0..2 {
        var luma_edge: int32 = edge * 2;
        if (any_v[luma_edge] == 0) { continue; }
        var qp_nb: int32 = qp_cur;
        if (edge == 0) { qp_nb = qp_left; }
        h264_deblock_vertical_chroma(v, mb_x, mb_y, edge, &g_bs_vertical[luma_edge * 4],
                                     qp_cur, qp_nb);
      }
      for edge in 0..4 {
        if (edge == 0 && mb_y == 0) { continue; }
        if (eight != 0 && (edge & 1) != 0) { continue; }
        if (edge != 0 && quiet != 0) { continue; }
        any_h[edge] = h264_edge_strengths_horizontal(v, current, edge, &g_bs_horizontal[edge * 4]);
        if (any_h[edge] == 0) { continue; }
        var qp_nb: int32 = qp_cur;
        if (edge == 0) { qp_nb = qp_above; }
        h264_deblock_horizontal_luma(v, mb_x, mb_y, edge, &g_bs_horizontal[edge * 4],
                                     qp_cur, qp_nb);
      }
      for edge in 0..2 {
        var luma_edge: int32 = edge * 2;
        if (any_h[luma_edge] == 0) { continue; }
        var qp_nb: int32 = qp_cur;
        if (edge == 0) { qp_nb = qp_above; }
        h264_deblock_horizontal_chroma(v, mb_x, mb_y, edge, &g_bs_horizontal[luma_edge * 4],
                                       qp_cur, qp_nb);
      }
    }
  }
}
