import "std/io";
import "std/mem";
import "jpeg";
import "source";
import "audio";
import "mp4";
import "h264";
import "h264_decode";
import "h264_frame";
import "aac";
import "aac_decode";

extern fn Win_QueryPerformanceCounter(counter: int64*) -> int32 = "QueryPerformanceCounter";
extern fn Win_QueryPerformanceFrequency(frequency: int64*) -> int32 = "QueryPerformanceFrequency";
extern fn Win_Sleep(milliseconds: uint32) = "Sleep";

var g_qpc_frequency: int64 = 1;

fn now_microseconds() -> int64 {
  if (g_qpc_frequency <= 1) { Win_QueryPerformanceFrequency(&g_qpc_frequency); }
  var counter: int64 = 0;
  Win_QueryPerformanceCounter(&counter);
  var seconds: int64 = counter / g_qpc_frequency;
  var remainder: int64 = counter % g_qpc_frequency;
  return seconds * (int64)1000000 + remainder * (int64)1000000 / g_qpc_frequency;
}

fn cstring_equals(a: cstring, b: cstring) -> int32 {
  var i: int64 = 0;
  while (a[i] != (uint8)0 && b[i] != (uint8)0) {
    if (a[i] != b[i]) { return 0; }
    i = i + 1;
  }
  if (a[i] != b[i]) { return 0; }
  return 1;
}

fn read_whole_file(path: cstring, out_size: int64*) -> uint8* {
  var fp: cstring = fopen(path, "rb");
  if (fp == 0) { return 0; }
  defer fclose(fp);
  if (_fseeki64(fp, 0, 2) != 0) { return 0; }
  var size: int64 = _ftelli64(fp);
  if (size <= 0) { return 0; }
  if (_fseeki64(fp, 0, 0) != 0) { return 0; }
  var buffer: uint8* = malloc(size);
  if (buffer == 0) { return 0; }
  var got: int64 = fread(buffer, 1, size, fp);
  if (got != size) {
    free(buffer);
    return 0;
  }
  *out_size = size;
  return buffer;
}

fn write_ppm(path: cstring, pixels: uint32*, width: int32, height: int32) -> int32 {
  var fp: cstring = fopen(path, "wb");
  if (fp == 0) { return 0; }
  defer fclose(fp);
  var header: uint8* = malloc(64);
  if (header == 0) { return 0; }
  defer free(header);
  var n: int32 = 0;
  header[n] = (uint8)80; n = n + 1;
  header[n] = (uint8)54; n = n + 1;
  header[n] = (uint8)10; n = n + 1;
  n = n + write_decimal(&header[n], width);
  header[n] = (uint8)32; n = n + 1;
  n = n + write_decimal(&header[n], height);
  header[n] = (uint8)10; n = n + 1;
  header[n] = (uint8)50; n = n + 1;
  header[n] = (uint8)53; n = n + 1;
  header[n] = (uint8)53; n = n + 1;
  header[n] = (uint8)10; n = n + 1;
  fwrite(header, 1, (int64)n, fp);

  var count: int64 = (int64)width * (int64)height;
  var rgb: uint8* = malloc(count * 3);
  if (rgb == 0) { return 0; }
  defer free(rgb);
  for i in 0..count {
    var value: uint32 = pixels[i];
    rgb[i * 3] = (uint8)((value >> 16) & (uint32)255);
    rgb[i * 3 + 1] = (uint8)((value >> 8) & (uint32)255);
    rgb[i * 3 + 2] = (uint8)(value & (uint32)255);
  }
  fwrite(rgb, 1, count * 3, fp);
  return 1;
}

fn write_decimal(out: uint8*, value: int32) -> int32 {
  if (value == 0) {
    out[0] = (uint8)48;
    return 1;
  }
  var digits: uint8[12];
  var count: int32 = 0;
  var left: int32 = value;
  while (left > 0) {
    digits[count] = (uint8)(48 + left % 10);
    left = left / 10;
    count = count + 1;
  }
  for i in 0..count {
    out[i] = digits[count - 1 - i];
  }
  return count;
}

fn command_jpeg(input: cstring, output: cstring) -> int32 {
  var size: int64 = 0;
  var data: uint8* = read_whole_file(input, &size);
  if (data == 0) {
    println("cannot read input");
    return 1;
  }
  defer free(data);

  var decoder: JpegDecoder* = jpeg_decoder_new();
  if (decoder == 0) {
    println("out of memory");
    return 1;
  }
  defer jpeg_decoder_free(decoder);

  var status: int32 = jpeg_decode(decoder, data, size);
  if (status != JPEG_OK) {
    println("decode failed with status {status}");
    return 1;
  }
  println("{decoder->width}x{decoder->height} components={decoder->component_count} sampling={decoder->components[0].h}x{decoder->components[0].v}");
  if (write_ppm(output, decoder->pixels, decoder->width, decoder->height) == 0) {
    println("cannot write output");
    return 1;
  }
  return 0;
}

fn command_info(path: cstring) -> int32 {
  var status: int32 = 0;
  var file: MediaSource* = source_open(path, &status);
  if (file == 0) {
    println("cannot open file, status {status}");
    return 1;
  }
  defer source_close(file);

  var microseconds: int64 = file->duration_us;
  print("container     ");
  println(source_container_name(file));
  print("video codec   ");
  println(source_video_codec_name(file));
  println("size          {file->width}x{file->height}");
  println("video frames  {file->video_frame_count}");
  println("duration      {microseconds / 1000000}.{(microseconds / 1000) % 1000} s");
  println("largest frame {file->max_video_size} bytes");
  if (source_has_audio(file) != 0) {
    println("audio         {file->audio_channels} ch, {file->audio_sample_rate} Hz, {file->audio_bits} bit, {file->audio_chunk_count} chunks, {file->audio_total_bytes} bytes");
  } else if (file->audio_codec == SOURCE_AUDIO_AAC) {
    println("audio         AAC, {file->audio_channels} ch, {file->audio_sample_rate} Hz, not decoded yet");
  } else {
    println("audio         none");
  }
  return 0;
}

fn command_frame(path: cstring, frame_index: int32, output: cstring) -> int32 {
  var status: int32 = 0;
  var file: MediaSource* = source_open(path, &status);
  if (file == 0) {
    println("cannot open file, status {status}");
    return 1;
  }
  defer source_close(file);

  var buffer: uint8* = malloc((int64)file->max_video_size);
  if (buffer == 0) { return 1; }
  defer free(buffer);

  var size: int32 = source_read_video(file, frame_index, buffer, (int64)file->max_video_size);
  if (size <= 0) {
    println("cannot read frame {frame_index}");
    return 1;
  }

  var decoder: JpegDecoder* = jpeg_decoder_new();
  if (decoder == 0) { return 1; }
  defer jpeg_decoder_free(decoder);

  var decode_status: int32 = jpeg_decode(decoder, buffer, (int64)size);
  if (decode_status != JPEG_OK) {
    println("decode failed with status {decode_status}");
    return 1;
  }
  println("frame {frame_index}: {size} bytes, {decoder->width}x{decoder->height}");
  if (write_ppm(output, decoder->pixels, decoder->width, decoder->height) == 0) {
    println("cannot write output");
    return 1;
  }
  return 0;
}

fn command_bench(path: cstring) -> int32 {
  var status: int32 = 0;
  var file: MediaSource* = source_open(path, &status);
  if (file == 0) {
    println("cannot open file, status {status}");
    return 1;
  }
  defer source_close(file);

  var buffer: uint8* = malloc((int64)file->max_video_size);
  if (buffer == 0) { return 1; }
  defer free(buffer);

  var decoder: JpegDecoder* = jpeg_decoder_new();
  if (decoder == 0) { return 1; }
  defer jpeg_decoder_free(decoder);

  var decoded: int32 = 0;
  var failed: int32 = 0;
  var checksum: int64 = 0;
  for i in 0..file->video_frame_count {
    var size: int32 = source_read_video(file, i, buffer, (int64)file->max_video_size);
    if (size <= 0) {
      failed = failed + 1;
      if (failed <= 5) { println("frame {i}: empty or unreadable"); }
      continue;
    }
    var frame_status: int32 = jpeg_decode(decoder, buffer, (int64)size);
    if (frame_status != JPEG_OK) {
      failed = failed + 1;
      if (failed <= 5) { println("frame {i}: decode status {frame_status}, {size} bytes"); }
      continue;
    }
    decoded = decoded + 1;
    var count: int64 = (int64)decoder->width * (int64)decoder->height;
    var pixels: uint32* = decoder->pixels;
    var hash: int64 = checksum;
    for p in 0..count {
      hash = hash * (int64)31 + (int64)pixels[p];
    }
    checksum = hash;
  }
  println("decoded {decoded} frames, {failed} failures, checksum {checksum}");
  return 0;
}

fn command_audio(path: cstring, seconds: int32) -> int32 {
  var status: int32 = 0;
  var file: MediaSource* = source_open(path, &status);
  if (file == 0) {
    println("cannot open file, status {status}");
    return 1;
  }
  defer source_close(file);

  var player: AudioPlayer* = audio_open(file);
  if (player == 0) { return 1; }
  defer audio_close(player);

  if (player->ready == 0) {
    println("audio device did not open");
    return 1;
  }
  audio_seek(player, file, 0);

  var frequency: int64 = 1;
  Win_QueryPerformanceFrequency(&frequency);
  var counter: int64 = 0;
  Win_QueryPerformanceCounter(&counter);
  var start: int64 = counter;

  var elapsed_us: int64 = 0;
  var limit_us: int64 = (int64)seconds * (int64)1000000;
  while (elapsed_us < limit_us) {
    audio_pump(player, file);
    Win_Sleep((uint32)200);
    Win_QueryPerformanceCounter(&counter);
    elapsed_us = (counter - start) * (int64)1000000 / frequency;
    var audio_us: int64 = audio_position_microseconds(player);
    println("wall {elapsed_us / 1000} ms   audio {audio_us / 1000} ms   drift {(audio_us - elapsed_us) / 1000} ms");
  }
  return 0;
}

fn print_fourcc(code: uint32) {
  var text: uint8[8];
  text[0] = (uint8)((code >> 24) & (uint32)255);
  text[1] = (uint8)((code >> 16) & (uint32)255);
  text[2] = (uint8)((code >> 8) & (uint32)255);
  text[3] = (uint8)(code & (uint32)255);
  text[4] = (uint8)0;
  for i in 0..4 {
    if (text[i] < (uint8)32 || text[i] > (uint8)126) { text[i] = (uint8)46; }
  }
  print_cstr((cstring)&text[0]);
}

fn command_mp4info(path: cstring) -> int32 {
  var status: int32 = 0;
  var file: Mp4File* = mp4_open(path, &status);
  if (file == 0) {
    println("cannot open mp4, status {status}");
    return 1;
  }
  defer mp4_close(file);

  var duration: int64 = mp4_duration_microseconds(file);
  println("tracks        {file->track_count}");
  println("duration      {duration / 1000000}.{(duration / 1000) % 1000} s");
  for i in 0..file->track_count {
    print("track {i}      ");
    print_fourcc(file->tracks[i].format);
    print(" kind={file->tracks[i].kind} timescale={file->tracks[i].timescale} samples={file->tracks[i].sample_count}");
    println(" sync={file->tracks[i].sync_count} largest={file->tracks[i].max_size} config={file->tracks[i].codec_config_size}");
    if (file->tracks[i].kind == MP4_TRACK_VIDEO) {
      println("              {file->tracks[i].width}x{file->tracks[i].height}");
    }
    if (file->tracks[i].kind == MP4_TRACK_AUDIO) {
      println("              {file->tracks[i].channels} ch, {file->tracks[i].sample_rate} Hz, {file->tracks[i].bits_per_sample} bit");
    }
  }
  return 0;
}

fn command_mp4samples(path: cstring, track: int32, count: int32) -> int32 {
  var status: int32 = 0;
  var file: Mp4File* = mp4_open(path, &status);
  if (file == 0) {
    println("cannot open mp4, status {status}");
    return 1;
  }
  defer mp4_close(file);

  if (track < 0 || track >= file->track_count) {
    println("no such track");
    return 1;
  }
  var limit: int32 = count;
  if (limit > file->tracks[track].sample_count) { limit = file->tracks[track].sample_count; }
  for i in 0..limit {
    println("{i} {file->tracks[track].offsets[i]} {file->tracks[track].sizes[i]} {file->tracks[track].decode_times[i]} {file->tracks[track].presentation_times[i]} {file->tracks[track].sync_flags[i]}");
  }
  return 0;
}

fn command_h264info(path: cstring, sample_limit: int32, print_limit: int32) -> int32 {
  var status: int32 = 0;
  var file: MediaSource* = source_open(path, &status);
  if (file == 0) {
    println("cannot open file, status {status}");
    return 1;
  }
  defer source_close(file);

  if (file->video_codec != SOURCE_VIDEO_H264) {
    println("video track is not H.264");
    return 1;
  }

  var decoder: H264Decoder* = h264_decoder_new();
  if (decoder == 0) { return 1; }
  defer h264_decoder_free(decoder);

  var config_status: int32 = h264_read_config(decoder, file->codec_config, file->codec_config_size);
  if (config_status != H264_OK) {
    println("avcC parse failed with status {config_status}");
    return 1;
  }

  var sps: H264Sps* = &decoder->sps[decoder->active_sps];
  var pps: H264Pps* = &decoder->pps[decoder->active_pps];
  print("profile       ");
  print(h264_profile_name(sps->profile_idc));
  println(" ({sps->profile_idc}) level {sps->level_idc / 10}.{sps->level_idc % 10}");
  println("size          {sps->width}x{sps->height} from {sps->pic_width_in_mbs}x{sps->pic_height_in_map_units} macroblocks");
  println("crop          l{sps->crop_left} r{sps->crop_right} t{sps->crop_top} b{sps->crop_bottom}");
  println("chroma        format {sps->chroma_format_idc}, {sps->bit_depth_luma} bit luma, {sps->bit_depth_chroma} bit chroma");
  println("frame num     {sps->log2_max_frame_num} bits, poc type {sps->pic_order_cnt_type}, poc lsb {sps->log2_max_pic_order_cnt_lsb} bits");
  println("ref frames    {sps->max_num_ref_frames}, frame_mbs_only {sps->frame_mbs_only}, direct8x8 {sps->direct_8x8_inference}");
  println("entropy       {pps->entropy_coding_mode} (0 CAVLC, 1 CABAC)");
  println("pps           init qp {pps->pic_init_qp}, chroma offset {pps->chroma_qp_index_offset}, deblock control {pps->deblocking_filter_control_present}");
  println("              weighted pred {pps->weighted_pred}, bipred idc {pps->weighted_bipred_idc}, transform8x8 {pps->transform_8x8_mode}");
  println("nal length    {decoder->nal_length_size} bytes");
  println("scaling lists {decoder->sps[decoder->active_sps].scaling_matrix_present}");
  var missing: cstring = h264_unsupported_reason(decoder);
  if (missing != 0) {
    print("unsupported   ");
    println_cstr(missing);
  } else {
    println("unsupported   nothing, this stream decodes");
  }

  var buffer: uint8* = malloc((int64)file->max_video_size);
  if (buffer == 0) { return 1; }
  defer free(buffer);

  var counts: int32[8];
  for i in 0..8 { counts[i] = 0; }
  var limit: int32 = sample_limit;
  if (limit > file->video_frame_count) { limit = file->video_frame_count; }
  var failures: int32 = 0;

  for i in 0..limit {
    var size: int32 = source_read_video(file, i, buffer, (int64)file->max_video_size);
    if (size <= 0) { failures = failures + 1; continue; }
    var nal_total: int32 = h264_nal_count(decoder, buffer, (int64)size);
    for n in 0..nal_total {
      var nal_size: int64 = 0;
      var nal: uint8* = h264_nal_at(decoder, buffer, (int64)size, n, &nal_size);
      if (nal == 0) { continue; }
      var kind: int32 = h264_nal_type(nal);
      if (kind == H264_NAL_SLICE || kind == H264_NAL_IDR) {
        var header: H264SliceHeader;
        if (h264_parse_slice_header(decoder, nal, nal_size, &header) != H264_OK) {
          failures = failures + 1;
          continue;
        }
        counts[header.slice_type] = counts[header.slice_type] + 1;
        if (i < print_limit) {
          print("sample {i} nal {n}: ");
          print(h264_slice_type_name(header.slice_type));
          println(" frame_num {header.frame_num} poc_lsb {header.pic_order_cnt_lsb} qp {header.qp} idr {header.is_idr} direct_spatial {header.direct_spatial_mv_pred} l0 {header.num_ref_idx_l0_active} l1 {header.num_ref_idx_l1_active} mods {header.modification_count}/{header.modification_count_l1}");
        }
      }
    }
  }
  println("slices        I {counts[H264_SLICE_I]}  P {counts[H264_SLICE_P]}  B {counts[H264_SLICE_B]}  failures {failures}");
  return 0;
}

fn command_h264dump(path: cstring, frame_limit: int32, output: cstring, skip_filter: int32) -> int32 {
  var status: int32 = 0;
  var file: MediaSource* = source_open(path, &status);
  if (file == 0) {
    println("cannot open file, status {status}");
    return 1;
  }
  defer source_close(file);

  if (file->video_codec != SOURCE_VIDEO_H264) {
    println("video track is not H.264");
    return 1;
  }

  var parser: H264Decoder* = h264_decoder_new();
  if (parser == 0) { return 1; }
  defer h264_decoder_free(parser);
  if (h264_read_config(parser, file->codec_config, file->codec_config_size) != H264_OK) {
    println("avcC parse failed");
    return 1;
  }

  var video: H264Video* = h264_video_new(parser);
  if (video == 0) { return 1; }
  defer h264_video_free(video);
  video->skip_deblocking = skip_filter;

  var buffer: uint8* = malloc((int64)file->max_video_size);
  if (buffer == 0) { return 1; }
  defer free(buffer);

  var fp: cstring = fopen(output, "wb");
  if (fp == 0) {
    println("cannot open output");
    return 1;
  }
  defer fclose(fp);

  var limit: int32 = frame_limit;
  if (limit > file->video_frame_count) { limit = file->video_frame_count; }
  var written: int32 = 0;

  var frame_bytes: int64 = 0;
  var store: uint8* = 0;
  var have: uint8* = 0;

  for i in 0..limit {
    var size: int32 = source_read_video_by_sample(file, i, buffer, (int64)file->max_video_size);
    if (size <= 0) {
      println("sample {i}: unreadable");
      return 1;
    }
    var decode_status: int32 = h264_decode_sample(video, buffer, (int64)size);
    if (decode_status != H264_OK) {
      println("sample {i}: decode status {decode_status}");
      return 1;
    }
    if (store == 0) {
      frame_bytes = (int64)video->width * (int64)video->height * 3 / 2;
      store = malloc(frame_bytes * (int64)limit);
      have = malloc((int64)limit);
      if (store == 0 || have == 0) { return 1; }
      memset(have, 0, (int64)limit);
    }
    var position: int32 = source_display_position(file, i);
    if (position < 0 || position >= limit) { continue; }
    var target: int64 = (int64)position * frame_bytes;
    var offset: int64 = 0;
    for y in 0..video->height {
      var row: int64 = (int64)(y + video->crop_top) * (int64)video->luma_stride + (int64)video->crop_left;
      for x in 0..video->width {
        store[target + offset] = video->luma[row + (int64)x];
        offset = offset + 1;
      }
    }
    for y in 0..(video->height / 2) {
      var row: int64 = (int64)(y + video->crop_top / 2) * (int64)video->chroma_stride + (int64)(video->crop_left / 2);
      for x in 0..(video->width / 2) {
        store[target + offset] = video->cb[row + (int64)x];
        offset = offset + 1;
      }
    }
    for y in 0..(video->height / 2) {
      var row: int64 = (int64)(y + video->crop_top / 2) * (int64)video->chroma_stride + (int64)(video->crop_left / 2);
      for x in 0..(video->width / 2) {
        store[target + offset] = video->cr[row + (int64)x];
        offset = offset + 1;
      }
    }
    have[position] = (uint8)1;
    written = written + 1;
  }

  if (store != 0) {
    for i in 0..limit {
      if (have[i] == (uint8)0) { continue; }
      fwrite(&store[(int64)i * frame_bytes], 1, frame_bytes, fp);
    }
    free(store);
    free(have);
  }

  println("decoded {written} frames, {video->width}x{video->height}");
  return 0;
}

var g_pcm_scale: float64 = 1.0;
var g_aac_trace: int32 = 0;

fn command_aacwav(path: cstring, frame_limit: int32, output: cstring) -> int32 {
  var status: int32 = 0;
  var file: MediaSource* = source_open(path, &status);
  if (file == 0) { return 1; }
  defer source_close(file);
  if (file->audio_codec != SOURCE_AUDIO_AAC) { println("not AAC"); return 1; }

  var config: AacConfig;
  if (aac_read_config(&config, file->audio_config, file->audio_config_size) != AAC_OK) {
    println("config parse failed");
    return 1;
  }
  var decoder: AacDecoder* = aac_decoder_new(&config);
  if (decoder == 0) { return 1; }
  defer aac_decoder_free(decoder);

  var buffer: uint8* = malloc((int64)file->max_audio_size);
  if (buffer == 0) { return 1; }
  defer free(buffer);

  var limit: int32 = frame_limit;
  if (limit > file->audio_frame_count) { limit = file->audio_frame_count; }

  var fp: cstring = fopen(output, "wb");
  if (fp == 0) { println("cannot open output"); return 1; }
  defer fclose(fp);

  var pcm: float64* = malloc(2048 * 8);
  if (pcm == 0) { return 1; }
  defer free(pcm);

  var written: int32 = 0;
  for i in 0..limit {
    var size: int32 = source_read_audio(file, i, buffer, (int64)file->max_audio_size);
    if (size <= 0) { break; }
    if (aac_decode_pcm(decoder, buffer, (int64)size, pcm) != AAC_OK) {
      println("frame {i}: decode failed");
      return 1;
    }
    var channels: int32 = decoder->frame_channels;
    var samples: uint8[4096];
    var at: int32 = 0;
    for n in 0..1024 {
      for ch in 0..channels {
        var value: float64 = pcm[ch * 1024 + n] * g_pcm_scale;
        var rounded: float64 = value + 0.5;
        if (value < 0.0) { rounded = value - 0.5; }
        var scaled: int32 = (int32)rounded;
        if (scaled > 32767) { scaled = 32767; }
        if (scaled < -32768) { scaled = -32768; }
        samples[at] = (uint8)(scaled & 255);
        samples[at + 1] = (uint8)((scaled >> 8) & 255);
        at = at + 2;
      }
    }
    if (g_aac_trace != 0) {
      var _unused: int32 = 0;
      var tns0: int32 = 0;
      for w in 0..8 { tns0 = tns0 + decoder->channels[0].tns_filters[w]; }
      var tns1: int32 = 0;
      for w in 0..8 { tns1 = tns1 + decoder->channels[1].tns_filters[w]; }
      println("f {i} win {decoder->channels[0].window_sequence} tns {tns0}/{tns1} ord {decoder->channels[0].tns_order[0]} dir {decoder->channels[0].tns_direction[0]} len {decoder->channels[0].tns_length[0]} pns {g_aac_frame_pns} pulse {g_aac_frame_pulse}");
    }
    fwrite(&samples[0], 1, (int64)at, fp);
    written = written + 1;
  }
  println("wrote {written} frames of raw 16 bit PCM");
  print("codebook use:");
  for i in 0..16 { print(" {i}:{g_aac_book_use[i]}"); }
  println("");
  println("windows: long {g_aac_window_use[0]} start {g_aac_window_use[1]} short {g_aac_window_use[2]} stop {g_aac_window_use[3]}");
  return 0;
}

fn command_aacparse(path: cstring, frame_limit: int32) -> int32 {
  var status: int32 = 0;
  var file: MediaSource* = source_open(path, &status);
  if (file == 0) { return 1; }
  defer source_close(file);
  if (file->audio_codec != SOURCE_AUDIO_AAC) { println("not AAC"); return 1; }

  var config: AacConfig;
  if (aac_read_config(&config, file->audio_config, file->audio_config_size) != AAC_OK) {
    println("config parse failed");
    return 1;
  }
  var decoder: AacDecoder* = aac_decoder_new(&config);
  if (decoder == 0) { return 1; }
  defer aac_decoder_free(decoder);

  var buffer: uint8* = malloc((int64)file->max_audio_size);
  if (buffer == 0) { return 1; }
  defer free(buffer);

  var limit: int32 = frame_limit;
  if (limit > file->audio_frame_count) { limit = file->audio_frame_count; }
  var good: int32 = 0;
  var failures: int32 = 0;
  var shown: int32 = 0;
  for i in 0..limit {
    var size: int32 = source_read_audio(file, i, buffer, (int64)file->max_audio_size);
    if (size <= 0) { println("frame {i}: unreadable"); return 1; }
    var result: int32 = aac_decode_frame(decoder, buffer, (int64)size);
    if (result == AAC_OK) {
      good = good + 1;
    } else {
      failures = failures + 1;
      if (shown < 6) {
        println("frame {i}: status {result} ({size} bytes) win {decoder->channels[0].window_sequence} max_sfb {decoder->channels[0].max_sfb} groups {decoder->channels[0].num_groups} stage {decoder->fail_stage} at_bit {decoder->fail_bits} of {size * 8}");
        shown = shown + 1;
      }
    }
  }
  println("parsed {good} of {limit} frames, {failures} failures");
  return 0;
}

fn command_aacinfo(path: cstring, frame_limit: int32) -> int32 {
  var status: int32 = 0;
  var file: MediaSource* = source_open(path, &status);
  if (file == 0) { return 1; }
  defer source_close(file);

  if (file->audio_codec != SOURCE_AUDIO_AAC) {
    println("audio track is not AAC");
    return 1;
  }

  print("esds {file->audio_config_size} bytes:");
  for i in 0..file->audio_config_size {
    var byte: int32 = (int32)file->audio_config[i];
    print(" {byte}");
  }
  println("");

  var offset: int32 = 0;
  var length: int32 = 0;
  if (aac_find_specific_config(file->audio_config, file->audio_config_size,
                               &offset, &length) != AAC_OK) {
    println("cannot locate AudioSpecificConfig");
    return 1;
  }
  print("AudioSpecificConfig at {offset}, {length} bytes:");
  for i in 0..length {
    var byte: int32 = (int32)file->audio_config[offset + i];
    print(" {byte}");
  }
  println("");

  var config: AacConfig;
  var parsed: int32 = aac_read_config(&config, file->audio_config, file->audio_config_size);
  if (parsed != AAC_OK) {
    println("config parse failed, status {parsed}");
    return 1;
  }
  print("object ");
  print_cstr(aac_object_name(config.object_type));
  println(", {config.sample_rate} Hz (index {config.sample_rate_index}), {config.channels} ch, frame {config.frame_length}");
  println("frames {file->audio_frame_count}, largest {file->max_audio_size} bytes");

  var limit: int32 = frame_limit;
  if (limit > file->audio_frame_count) { limit = file->audio_frame_count; }
  var buffer: uint8* = malloc((int64)file->max_audio_size);
  if (buffer == 0) { return 1; }
  defer free(buffer);
  for i in 0..limit {
    var size: int32 = source_read_audio(file, i, buffer, (int64)file->max_audio_size);
    if (size <= 0) {
      println("frame {i}: unreadable");
      return 1;
    }
    var r: AacBits;
    aac_bits_start(&r, buffer, (int64)size);
    var element: int32 = aac_read_bits(&r, 3);
    println("frame {i}: {size} bytes, first element {element}");
  }
  return 0;
}

fn command_syncmap(path: cstring) -> int32 {
  var status: int32 = 0;
  var file: MediaSource* = source_open(path, &status);
  if (file == 0) { return 1; }
  defer source_close(file);
  var count: int32 = 0;
  var previous: int32 = -1;
  var worst: int32 = 0;
  for i in 0..file->video_frame_count {
    if (source_is_sync_sample(file, i) == 0) { continue; }
    if (count < 12) { print(" {i}"); }
    if (previous >= 0 && i - previous > worst) { worst = i - previous; }
    previous = i;
    count = count + 1;
  }
  println("");
  println("sync samples {count} of {file->video_frame_count}, largest gap {worst}");
  return 0;
}

fn command_h264hdr(path: cstring, sample_index: int32) -> int32 {
  var status: int32 = 0;
  var file: MediaSource* = source_open(path, &status);
  if (file == 0) { return 1; }
  defer source_close(file);
  var parser: H264Decoder* = h264_decoder_new();
  if (parser == 0) { return 1; }
  defer h264_decoder_free(parser);
  if (h264_read_config(parser, file->codec_config, file->codec_config_size) != H264_OK) { return 1; }
  var buffer: uint8* = malloc((int64)file->max_video_size);
  if (buffer == 0) { return 1; }
  defer free(buffer);
  var size: int32 = source_read_video_by_sample(file, sample_index, buffer, (int64)file->max_video_size);
  if (size <= 0) { return 1; }
  var count: int32 = h264_nal_count(parser, buffer, (int64)size);
  println("sample {sample_index}: {size} bytes, {count} nals");
  for n in 0..count {
    var nal_size: int64 = 0;
    var nal: uint8* = h264_nal_at(parser, buffer, (int64)size, n, &nal_size);
    if (nal == 0) { continue; }
    var kind: int32 = h264_nal_type(nal);
    print("nal {n} type {kind} size {nal_size} bytes:");
    var limit: int64 = 24;
    if (nal_size < limit) { limit = nal_size; }
    for i in 0..limit {
      var byte: int32 = (int32)nal[i];
      print(" {byte}");
    }
    println("");
    if (kind == H264_NAL_SLICE || kind == H264_NAL_IDR) {
      var header: H264SliceHeader;
      if (h264_parse_slice_header(parser, nal, nal_size, &header) == H264_OK) {
        println("  type {header.slice_type} frame_num {header.frame_num} poc_lsb {header.pic_order_cnt_lsb} qp {header.qp} bit_offset {header.data_bit_offset} ref_idc {header.nal_ref_idc}");
      }
    }
  }
  return 0;
}

fn command_h264trace(path: cstring, sample_index: int32) -> int32 {
  var status: int32 = 0;
  var file: MediaSource* = source_open(path, &status);
  if (file == 0) { return 1; }
  defer source_close(file);
  var parser: H264Decoder* = h264_decoder_new();
  if (parser == 0) { return 1; }
  defer h264_decoder_free(parser);
  if (h264_read_config(parser, file->codec_config, file->codec_config_size) != H264_OK) { return 1; }
  var video: H264Video* = h264_video_new(parser);
  if (video == 0) { return 1; }
  defer h264_video_free(video);
  var buffer: uint8* = malloc((int64)file->max_video_size);
  if (buffer == 0) { return 1; }
  defer free(buffer);
  for i in 0..(sample_index + 1) {
    var size: int32 = source_read_video_by_sample(file, i, buffer, (int64)file->max_video_size);
    if (size <= 0) { return 1; }
    if (i == sample_index) { g_trace_mb = 1; }
    if (h264_decode_sample(video, buffer, (int64)size) != H264_OK) {
      println("sample {i}: decode failed");
      return 1;
    }
    var display: int32 = source_display_position(file, i);
    if (i + 8 >= sample_index) { println("sample {i} -> display {display} poc {video->poc}"); }
  }
  return 0;
}

fn command_h264stats(path: cstring, frame_limit: int32) -> int32 {
  var status: int32 = 0;
  var file: MediaSource* = source_open(path, &status);
  if (file == 0) { return 1; }
  defer source_close(file);

  var parser: H264Decoder* = h264_decoder_new();
  if (parser == 0) { return 1; }
  defer h264_decoder_free(parser);
  if (h264_read_config(parser, file->codec_config, file->codec_config_size) != H264_OK) { return 1; }

  var video: H264Video* = h264_video_new(parser);
  if (video == 0) { return 1; }
  defer h264_video_free(video);

  var buffer: uint8* = malloc((int64)file->max_video_size);
  if (buffer == 0) { return 1; }
  defer free(buffer);

  var limit: int32 = frame_limit;
  if (limit > file->video_frame_count) { limit = file->video_frame_count; }
  for i in 0..limit {
    var size: int32 = source_read_video_by_sample(file, i, buffer, (int64)file->max_video_size);
    if (size <= 0) { return 1; }
    if (h264_decode_sample(video, buffer, (int64)size) != H264_OK) {
      println("frame {i}: decode failed");
      return 1;
    }
    var skip: int32 = 0;
    var intra: int32 = 0;
    var p16: int32 = 0;
    var p8: int32 = 0;
    var other: int32 = 0;
    for m in 0..video->mb_count {
      var kind: int32 = video->macroblocks[m].kind;
      if (video->macroblocks[m].skipped != 0) { skip = skip + 1; }
      else if (video->macroblocks[m].is_intra != 0) { intra = intra + 1; }
      else if (kind == H264_MB_P_16X16) { p16 = p16 + 1; }
      else if (kind == H264_MB_P_8X8) { p8 = p8 + 1; }
      else { other = other + 1; }
    }
    var used_ref1: int32 = 0;
    var used_ref2: int32 = 0;
    for m in 0..video->mb_count {
      for b in 0..4 {
        if (video->macroblocks[m].ref_index[b] == 1) { used_ref1 = used_ref1 + 1; }
        if (video->macroblocks[m].ref_index[b] > 1) { used_ref2 = used_ref2 + 1; }
      }
    }
    print("sample {i}: poc {video->poc} skip {skip} intra {intra} L0");
    for r in 0..video->ref_count0 {
      print(" [{video->pictures[video->ref_list0[r]].frame_num}/{video->pictures[video->ref_list0[r]].poc}]");
    }
    print(" L1");
    for r in 0..video->ref_count1 {
      print(" [{video->pictures[video->ref_list1[r]].frame_num}/{video->pictures[video->ref_list1[r]].poc}]");
    }
    println("");
  }
  return 0;
}

fn command_h264bench(path: cstring, frame_limit: int32) -> int32 {
  var status: int32 = 0;
  var file: MediaSource* = source_open(path, &status);
  if (file == 0) { return 1; }
  defer source_close(file);

  var parser: H264Decoder* = h264_decoder_new();
  if (parser == 0) { return 1; }
  defer h264_decoder_free(parser);
  if (h264_read_config(parser, file->codec_config, file->codec_config_size) != H264_OK) { return 1; }

  var video: H264Video* = h264_video_new(parser);
  if (video == 0) { return 1; }
  defer h264_video_free(video);

  var buffer: uint8* = malloc((int64)file->max_video_size);
  if (buffer == 0) { return 1; }
  defer free(buffer);

  var limit: int32 = frame_limit;
  if (limit > file->video_frame_count) { limit = file->video_frame_count; }

  var read_us: int64 = 0;
  var decode_us: int64 = 0;
  var write_us: int64 = 0;
  var decoded: int32 = 0;
  var worst: int64 = 0;
  var worst_index: int32 = 0;
  var late_us: int64 = 0;
  var late_count: int32 = 0;
  for i in 0..limit {
    var t0: int64 = now_microseconds();
    var size: int32 = source_read_video_by_sample(file, i, buffer, (int64)file->max_video_size);
    if (size <= 0) { return 1; }
    var t1: int64 = now_microseconds();
    if (h264_decode_sample(video, buffer, (int64)size) != H264_OK) {
      println("sample {i}: decode failed");
      return 1;
    }
    var t2: int64 = now_microseconds();
    h264_write_pixels(video);
    var t3: int64 = now_microseconds();
    read_us = read_us + (t1 - t0);
    decode_us = decode_us + (t2 - t1);
    write_us = write_us + (t3 - t2);
    if (t2 - t1 > worst) {
      worst = t2 - t1;
      worst_index = i;
    }
    if (i >= limit / 2) {
      late_us = late_us + (t2 - t1);
      late_count = late_count + 1;
    }
    decoded = decoded + 1;
  }

  var total: int64 = read_us + decode_us + write_us;
  println("{decoded} frames {video->width}x{video->height}");
  println("read   {read_us} us");
  println("decode {decode_us} us");
  println("write  {write_us} us");
  println("total  {total} us");
  var per: int64 = total / (int64)decoded;
  println("per frame {per} us");
  println("worst frame {worst_index}: {worst} us");
  if (late_count > 0) {
    var late_per: int64 = late_us / (int64)late_count;
    println("second half per frame {late_per} us");
  }
  return 0;
}

fn command_h264mb(path: cstring, frame_index: int32, mb_index: int32) -> int32 {
  var status: int32 = 0;
  var file: MediaSource* = source_open(path, &status);
  if (file == 0) { return 1; }
  defer source_close(file);
  var parser: H264Decoder* = h264_decoder_new();
  if (parser == 0) { return 1; }
  defer h264_decoder_free(parser);
  if (h264_read_config(parser, file->codec_config, file->codec_config_size) != H264_OK) { return 1; }
  var video: H264Video* = h264_video_new(parser);
  if (video == 0) { return 1; }
  defer h264_video_free(video);
  var buffer: uint8* = malloc((int64)file->max_video_size);
  if (buffer == 0) { return 1; }
  defer free(buffer);

  for i in 0..(frame_index + 1) {
    var size: int32 = source_read_video_by_sample(file, i, buffer, (int64)file->max_video_size);
    if (size <= 0) { return 1; }
    if (h264_decode_sample(video, buffer, (int64)size) != H264_OK) { return 1; }
  }
  var mb: H264Macroblock* = &video->macroblocks[mb_index];
  println("mb {mb_index}: kind {mb->kind} intra {mb->is_intra} skip {mb->skipped} qp {mb->qp} cbp {mb->cbp_luma}/{mb->cbp_chroma}");
  print("  nonzero");
  for i in 0..16 { print(" {mb->luma_nonzero[i]}"); }
  println("");
  print("  L0 refidx");
  for i in 0..4 { print(" {mb->ref_index[i]}"); }
  print(" refpic");
  for i in 0..4 { print(" {mb->ref_picture[i]}"); }
  println("");
  print("  L1 refidx");
  for i in 0..4 { print(" {mb->ref_index[4 + i]}"); }
  print(" refpic");
  for i in 0..4 { print(" {mb->ref_picture[4 + i]}"); }
  println("");
  print("  mv1");
  for i in 0..16 { print(" {mb->mv_x[16 + i]},{mb->mv_y[16 + i]}"); }
  println("");
  print("  mv");
  for i in 0..16 { print(" {mb->mv_x[i]},{mb->mv_y[i]}"); }
  println("");
  return 0;
}

fn command_h264rgb(path: cstring, count: int32, output: cstring) -> int32 {
  var status: int32 = 0;
  var file: MediaSource* = source_open(path, &status);
  if (file == 0) { return 1; }
  defer source_close(file);
  var parser: H264Decoder* = h264_decoder_new();
  if (parser == 0) { return 1; }
  defer h264_decoder_free(parser);
  if (h264_read_config(parser, file->codec_config, file->codec_config_size) != H264_OK) { return 1; }
  var video: H264Video* = h264_video_new(parser);
  if (video == 0) { return 1; }
  defer h264_video_free(video);
  var buffer: uint8* = malloc((int64)file->max_video_size);
  if (buffer == 0) { return 1; }
  defer free(buffer);

  for i in 0..count {
    var size: int32 = source_read_video_by_sample(file, i, buffer, (int64)file->max_video_size);
    if (size <= 0) { return 1; }
    if (h264_decode_sample(video, buffer, (int64)size) != H264_OK) {
      println("sample {i} failed");
      return 1;
    }
  }
  println("size {video->width}x{video->height} stride {video->luma_stride}/{video->chroma_stride} crop {video->crop_left},{video->crop_top}");
  println("luma {video->luma[0]} {video->luma[1000]} {video->luma[100000]} cb {video->cb[0]} {video->cb[1000]} cr {video->cr[0]}");
  h264_write_pixels(video);
  println("pixels {video->pixels[0]} {video->pixels[1000]} {video->pixels[100000]}");
  if (write_ppm(output, video->pixels, video->width, video->height) == 0) { return 1; }
  return 0;
}

fn parse_int(text: cstring) -> int32 {
  var value: int32 = 0;
  var i: int64 = 0;
  while (text[i] >= (uint8)48 && text[i] <= (uint8)57) {
    value = value * 10 + (int32)(text[i] - (uint8)48);
    i = i + 1;
  }
  return value;
}

fn print_usage() {
  println("usage:");
  println("  vptool info  <input>");
  println("  vptool frame <input> <index> <output.ppm>");
  println("  vptool bench <input>");
  println("  vptool jpeg  <input.jpg> <output.ppm>");
  println("  vptool audio <input> [seconds]");
  println("  vptool h264info <input.mp4> [samples]");
  println("  vptool h264dump <input.mp4> <frames> <out.yuv>");
  println("  vptool mp4info <input.mp4>");
  println("  vptool mp4samples <input.mp4> <track> <count>");
}

fn main(argc: int32, argv: cstring*) -> int32 {
  if (argc < 3) {
    print_usage();
    return 0;
  }
  var command: cstring = argv[1];
  if (cstring_equals(command, "jpeg") != 0 && argc >= 4) {
    return command_jpeg(argv[2], argv[3]);
  }
  if (cstring_equals(command, "info") != 0) {
    return command_info(argv[2]);
  }
  if (cstring_equals(command, "frame") != 0 && argc >= 5) {
    return command_frame(argv[2], parse_int(argv[3]), argv[4]);
  }
  if (cstring_equals(command, "h264bench") != 0 && argc >= 3) {
    var bench_limit: int32 = 1000000;
    if (argc >= 4) { bench_limit = parse_int(argv[3]); }
    return command_h264bench(argv[2], bench_limit);
  }
  if (cstring_equals(command, "bench") != 0) {
    return command_bench(argv[2]);
  }
  if (cstring_equals(command, "h264mb") != 0 && argc >= 5) {
    return command_h264mb(argv[2], parse_int(argv[3]), parse_int(argv[4]));
  }
  if (cstring_equals(command, "h264rgb") != 0 && argc >= 5) {
    return command_h264rgb(argv[2], parse_int(argv[3]), argv[4]);
  }
  if (cstring_equals(command, "aacwav") != 0 && argc >= 5) {
    if (argc >= 6) { g_pcm_scale = 1.0 / (float64)parse_int(argv[5]); }
    if (argc >= 7) { g_aac_use_tns = 0; }
    return command_aacwav(argv[2], parse_int(argv[3]), argv[4]);
  }
  if (cstring_equals(command, "aacparse") != 0 && argc >= 3) {
    var parse_limit: int32 = 1000000;
    if (argc >= 4) { parse_limit = parse_int(argv[3]); }
    return command_aacparse(argv[2], parse_limit);
  }
  if (cstring_equals(command, "aacinfo") != 0 && argc >= 3) {
    var aac_limit: int32 = 4;
    if (argc >= 4) { aac_limit = parse_int(argv[3]); }
    return command_aacinfo(argv[2], aac_limit);
  }
  if (cstring_equals(command, "syncmap") != 0 && argc >= 3) {
    return command_syncmap(argv[2]);
  }
  if (cstring_equals(command, "h264hdr") != 0 && argc >= 4) {
    return command_h264hdr(argv[2], parse_int(argv[3]));
  }
  if (cstring_equals(command, "h264trace") != 0 && argc >= 4) {
    return command_h264trace(argv[2], parse_int(argv[3]));
  }
  if (cstring_equals(command, "h264stats") != 0) {
    var limit: int32 = 10;
    if (argc >= 4) { limit = parse_int(argv[3]); }
    return command_h264stats(argv[2], limit);
  }
  if (cstring_equals(command, "h264dump") != 0 && argc >= 5) {
    var skip_filter: int32 = 0;
    if (argc >= 6) { skip_filter = 1; }
    return command_h264dump(argv[2], parse_int(argv[3]), argv[4], skip_filter);
  }
  if (cstring_equals(command, "h264info") != 0) {
    var limit: int32 = 200;
    if (argc >= 4) { limit = parse_int(argv[3]); }
    var shown: int32 = 8;
    if (argc >= 5) { shown = parse_int(argv[4]); }
    return command_h264info(argv[2], limit, shown);
  }
  if (cstring_equals(command, "mp4info") != 0) {
    return command_mp4info(argv[2]);
  }
  if (cstring_equals(command, "mp4samples") != 0 && argc >= 5) {
    return command_mp4samples(argv[2], parse_int(argv[3]), parse_int(argv[4]));
  }
  if (cstring_equals(command, "audio") != 0) {
    var seconds: int32 = 5;
    if (argc >= 4) { seconds = parse_int(argv[3]); }
    return command_audio(argv[2], seconds);
  }
  print_usage();
  return 0;
}
