import "std/io";
import "std/mem";
import "aac";
import "aac_tables";

const AAC_MAX_WINDOWS = 8;
const AAC_MAX_SFB = 51;
const AAC_MAX_GROUPS = 8;
const AAC_SPECTRUM = 1024;

const AAC_HCB_ZERO = 0;
const AAC_HCB_ESCAPE = 11;
const AAC_HCB_NOISE = 13;
const AAC_HCB_INTENSITY2 = 14;
const AAC_HCB_INTENSITY = 15;
const AAC_HCB_FIRST_PAIR = 5;

const AAC_WINDOW_LONG = 0;
const AAC_WINDOW_START = 1;
const AAC_WINDOW_SHORT = 2;
const AAC_WINDOW_STOP = 3;

struct AacChannel {
  window_sequence: int32;
  window_shape: int32;
  previous_window_shape: int32;
  max_sfb: int32;
  num_windows: int32;
  num_groups: int32;
  group_length: int32[8];
  num_swb: int32;
  swb_offset: int32[64];
  global_gain: int32;

  sfb_codebook: int32[408];
  scale_factor: int32[408];

  pulse_present: int32;
  pulse_count: int32;
  pulse_start_sfb: int32;
  pulse_offset: int32[4];
  pulse_amplitude: int32[4];

  tns_present: int32;
  tns_filters: int32[8];
  tns_length: int32[24];
  tns_order: int32[24];
  tns_direction: int32[24];
  tns_coefficient: float64[480];

  spectrum: float64[1024];
  overlap: float64[1024];
}

struct AacDecoder {
  config: AacConfig;

  huffman_length: int32*;
  huffman_code: int32*;
  huffman_value: int32*;
  book_offset: int32[16];
  book_count: int32[16];
  book_dim: int32[16];
  book_value_offset: int32[16];
  book_unsigned: int32[16];
  first_code: int32[384];
  first_index: int32[384];
  length_count: int32[384];

  swb_long: int32*;
  swb_short: int32*;
  swb_long_count: int32[16];
  swb_short_count: int32[16];
  tns_coefficients: float64*;

  channels: AacChannel[2];
  channel_count: int32;

  ms_mask: int32;
  ms_used: int32[408];

  window_long_sine: float64*;
  window_long_kbd: float64*;
  window_short_sine: float64*;
  window_short_kbd: float64*;
  cos_long: float64*;
  cos_short: float64*;
  transform: float64[2048];
  scratch: float64[2048];

  frame_channels: int32;
  fail_stage: int32;
  fail_bits: int64;
  samples: float64[2048];
  error: int32;
}

var g_aac_use_tns: int32 = 1;
var g_aac_frame_pns: int32 = 0;
var g_aac_frame_pulse: int32 = 0;
var g_aac_book_use: int64[16];
var g_aac_window_use: int64[4];

const AAC_PI = 3.14159265358979323846;

fn aac_fabs(x: float64) -> float64 {
  if (x < 0.0) { return 0.0 - x; }
  return x;
}

fn aac_sqrt(x: float64) -> float64 {
  if (x <= 0.0) { return 0.0; }
  var value: float64 = x;
  if (value > 1.0) { value = x / 2.0; }
  for i in 0..40 { value = 0.5 * (value + x / value); }
  return value;
}

fn aac_cbrt(x: float64) -> float64 {
  if (x <= 0.0) { return 0.0; }
  var value: float64 = x;
  var scale: float64 = 1.0;
  while (value >= 8.0) { value = value / 8.0; scale = scale * 2.0; }
  while (value < 1.0) { value = value * 8.0; scale = scale / 2.0; }
  var y: float64 = 1.5;
  for i in 0..24 { y = (2.0 * y + value / (y * y)) / 3.0; }
  return y * scale;
}

fn aac_sin_core(x: float64) -> float64 {
  var x2: float64 = x * x;
  var term: float64 = 1.0 / 362880.0;
  term = 0.0 - 1.0 / 5040.0 + x2 * term;
  term = 1.0 / 120.0 + x2 * term;
  term = 0.0 - 1.0 / 6.0 + x2 * term;
  term = 1.0 + x2 * term;
  return x * term;
}

fn aac_cos_core(x: float64) -> float64 {
  var x2: float64 = x * x;
  var term: float64 = 1.0 / 40320.0;
  term = 0.0 - 1.0 / 720.0 + x2 * term;
  term = 1.0 / 24.0 + x2 * term;
  term = 0.0 - 0.5 + x2 * term;
  return 1.0 + x2 * term;
}

fn aac_cos(angle: float64) -> float64 {
  var turns: float64 = angle / (2.0 * AAC_PI);
  var whole: float64 = (float64)((int64)turns);
  if (turns < 0.0) { whole = whole - 1.0; }
  var reduced: float64 = angle - whole * 2.0 * AAC_PI;

  var quadrant: int32 = (int32)(reduced / (AAC_PI / 2.0));
  if (quadrant > 3) { quadrant = 3; }
  var offset: float64 = reduced - (float64)quadrant * (AAC_PI / 2.0);

  if (quadrant == 0) { return aac_cos_core(offset); }
  if (quadrant == 1) { return 0.0 - aac_sin_core(offset); }
  if (quadrant == 2) { return 0.0 - aac_cos_core(offset); }
  return aac_sin_core(offset);
}

fn aac_sin(angle: float64) -> float64 {
  return aac_cos(angle - AAC_PI / 2.0);
}

fn aac_scale_gain(scale: int32) -> float64 {
  var exponent: int32 = scale - 100;
  var whole: int32 = exponent >> 2;
  var remainder: int32 = exponent - whole * 4;
  var quarters: float64[4] = [1.0, 1.18920711500272107, 1.41421356237309515, 1.68179283050742909];
  var value: float64 = quarters[remainder];
  if (whole >= 0) {
    for i in 0..whole { value = value * 2.0; }
  } else {
    for i in 0..(0 - whole) { value = value / 2.0; }
  }
  return value;
}

fn aac_bessel_i0(x: float64) -> float64 {
  var sum: float64 = 1.0;
  var term: float64 = 1.0;
  for i in 1..32 {
    var k: float64 = (float64)i;
    term = term * (x / (2.0 * k)) * (x / (2.0 * k));
    sum = sum + term;
  }
  return sum;
}

fn aac_build_kbd(window: float64*, count: int32, alpha: float64) {
  var half: int32 = count / 2;
  var scratch: float64[1025];
  var total: float64 = 0.0;
  var denominator: float64 = aac_bessel_i0(AAC_PI * alpha);
  for i in 0..(half + 1) {
    var ratio: float64 = (float64)(2 * i) / (float64)half - 1.0;
    var inner: float64 = 1.0 - ratio * ratio;
    if (inner < 0.0) { inner = 0.0; }
    scratch[i] = aac_bessel_i0(AAC_PI * alpha * aac_sqrt(inner)) / denominator;
  }
  for i in 0..(half + 1) { total = total + scratch[i]; }
  var running: float64 = 0.0;
  for i in 0..half {
    running = running + scratch[i];
    window[i] = aac_sqrt(running / total);
  }
}

fn aac_build_windows(d: AacDecoder*) {
  var pi: float64 = AAC_PI;

  for i in 0..1024 {
    d->window_long_sine[i] = aac_sin(pi / 2048.0 * ((float64)i + 0.5));
  }
  for i in 0..128 {
    d->window_short_sine[i] = aac_sin(pi / 256.0 * ((float64)i + 0.5));
  }
  aac_build_kbd(d->window_long_kbd, 2048, 4.0);
  aac_build_kbd(d->window_short_kbd, 256, 6.0);

  for i in 0..8192 {
    d->cos_long[i] = aac_cos(2.0 * pi * (float64)i / 8192.0);
  }
  for i in 0..1024 {
    d->cos_short[i] = aac_cos(2.0 * pi * (float64)i / 1024.0);
  }
}

fn aac_window_half(d: AacDecoder*, shape: int32, long_window: int32) -> float64* {
  if (long_window != 0) {
    if (shape != 0) { return d->window_long_kbd; }
    return d->window_long_sine;
  }
  if (shape != 0) { return d->window_short_kbd; }
  return d->window_short_sine;
}

fn aac_decoder_new(config: AacConfig*) -> AacDecoder* {
  var d: AacDecoder* = malloc(sizeof(AacDecoder));
  if (d == 0) { return 0; }
  memset(d, 0, sizeof(AacDecoder));
  d->config = *config;

  d->huffman_length = malloc((int64)AAC_HUFFMAN_ENTRIES * 4);
  d->huffman_code = malloc((int64)AAC_HUFFMAN_ENTRIES * 4);
  d->huffman_value = malloc((int64)AAC_HUFFMAN_VALUES * 4);
  d->swb_long = malloc((int64)AAC_SWB_LONG_STRIDE * 12 * 4);
  d->swb_short = malloc((int64)AAC_SWB_SHORT_STRIDE * 12 * 4);
  d->tns_coefficients = malloc((int64)AAC_TNS_VALUES * 8);
  if (d->huffman_length == 0 || d->huffman_code == 0 || d->huffman_value == 0 ||
      d->swb_long == 0 || d->swb_short == 0 || d->tns_coefficients == 0) {
    aac_decoder_free(d);
    return 0;
  }

  aac_fill_huffman_lengths(d->huffman_length);
  aac_fill_huffman_codes(d->huffman_code);
  aac_fill_huffman_values(d->huffman_value);
  aac_fill_book_offset(&d->book_offset[0]);
  aac_fill_book_count(&d->book_count[0]);
  aac_fill_book_dim(&d->book_dim[0]);
  aac_fill_book_value_offset(&d->book_value_offset[0]);
  aac_fill_book_unsigned(&d->book_unsigned[0]);
  aac_fill_swb_long(d->swb_long);
  aac_fill_swb_short(d->swb_short);
  aac_fill_swb_long_count(&d->swb_long_count[0]);
  aac_fill_swb_short_count(&d->swb_short_count[0]);
  aac_fill_tns_coefficients(d->tns_coefficients);

  d->window_long_sine = malloc(2048 * 8);
  d->window_long_kbd = malloc(2048 * 8);
  d->window_short_sine = malloc(256 * 8);
  d->window_short_kbd = malloc(256 * 8);
  d->cos_long = malloc(8192 * 8);
  d->cos_short = malloc(1024 * 8);
  if (d->window_long_sine == 0 || d->window_long_kbd == 0 ||
      d->window_short_sine == 0 || d->window_short_kbd == 0 ||
      d->cos_long == 0 || d->cos_short == 0) {
    aac_decoder_free(d);
    return 0;
  }
  aac_build_windows(d);

  for book in 0..AAC_BOOK_COUNT {
    var base: int32 = book * 24;
    for i in 0..24 {
      d->length_count[base + i] = 0;
      d->first_code[base + i] = 0;
      d->first_index[base + i] = 0;
    }
    var start: int32 = d->book_offset[book];
    var count: int32 = d->book_count[book];
    for i in 0..count {
      var length: int32 = d->huffman_length[start + i];
      if (d->length_count[base + length] == 0) {
        d->first_code[base + length] = d->huffman_code[start + i];
        d->first_index[base + length] = i;
      }
      d->length_count[base + length] = d->length_count[base + length] + 1;
    }
  }
  return d;
}

fn aac_decoder_free(d: AacDecoder*) {
  if (d == 0) { return; }
  if (d->huffman_length != 0) { free(d->huffman_length); }
  if (d->huffman_code != 0) { free(d->huffman_code); }
  if (d->huffman_value != 0) { free(d->huffman_value); }
  if (d->swb_long != 0) { free(d->swb_long); }
  if (d->swb_short != 0) { free(d->swb_short); }
  if (d->tns_coefficients != 0) { free(d->tns_coefficients); }
  if (d->window_long_sine != 0) { free(d->window_long_sine); }
  if (d->window_long_kbd != 0) { free(d->window_long_kbd); }
  if (d->window_short_sine != 0) { free(d->window_short_sine); }
  if (d->window_short_kbd != 0) { free(d->window_short_kbd); }
  if (d->cos_long != 0) { free(d->cos_long); }
  if (d->cos_short != 0) { free(d->cos_short); }
  free(d);
}

fn aac_decode_symbol(d: AacDecoder*, r: AacBits*, book: int32) -> int32 {
  var base: int32 = book * 24;
  var code: int32 = 0;
  var length: int32 = 0;
  while (length < 22) {
    code = (code << 1) | aac_read_bit(r);
    length = length + 1;
    var count: int32 = d->length_count[base + length];
    if (count > 0) {
      var offset: int32 = code - d->first_code[base + length];
      if (offset >= 0 && offset < count) {
        return d->first_index[base + length] + offset;
      }
    }
    if (r->overrun != 0) { return -1; }
  }
  return -1;
}

fn aac_read_escape(r: AacBits*) -> int32 {
  var count: int32 = 0;
  while (count < 16 && aac_read_bit(r) != 0) { count = count + 1; }
  if (count >= 16) { return 0; }
  var width: int32 = count + 4;
  var value: int32 = aac_read_bits(r, width);
  return (1 << width) + value;
}

fn aac_window_count(sequence: int32) -> int32 {
  if (sequence == AAC_WINDOW_SHORT) { return 8; }
  return 1;
}

fn aac_setup_bands(d: AacDecoder*, c: AacChannel*) -> int32 {
  var index: int32 = d->config.sample_rate_index;
  if (index < 0 || index > 11) { return AAC_ERR_UNSUPPORTED; }

  if (c->window_sequence == AAC_WINDOW_SHORT) {
    c->num_swb = d->swb_short_count[index];
    for i in 0..(c->num_swb + 1) {
      c->swb_offset[i] = d->swb_short[index * AAC_SWB_SHORT_STRIDE + i];
    }
  } else {
    c->num_swb = d->swb_long_count[index];
    for i in 0..(c->num_swb + 1) {
      c->swb_offset[i] = d->swb_long[index * AAC_SWB_LONG_STRIDE + i];
    }
  }
  if (c->max_sfb > c->num_swb) { return AAC_ERR_BITSTREAM; }
  return AAC_OK;
}

fn aac_read_ics_info(d: AacDecoder*, r: AacBits*, c: AacChannel*) -> int32 {
  aac_read_bit(r);
  c->window_sequence = aac_read_bits(r, 2);
  c->window_shape = aac_read_bit(r);

  c->num_windows = aac_window_count(c->window_sequence);
  c->num_groups = 1;
  for i in 0..AAC_MAX_WINDOWS { c->group_length[i] = 1; }

  if (c->window_sequence == AAC_WINDOW_SHORT) {
    c->max_sfb = aac_read_bits(r, 4);
    var grouping: int32 = aac_read_bits(r, 7);
    c->num_groups = 1;
    c->group_length[0] = 1;
    for i in 0..7 {
      var bit: int32 = (grouping >> (6 - i)) & 1;
      if (bit != 0) {
        c->group_length[c->num_groups - 1] = c->group_length[c->num_groups - 1] + 1;
      } else {
        c->num_groups = c->num_groups + 1;
        c->group_length[c->num_groups - 1] = 1;
      }
    }
  } else {
    c->max_sfb = aac_read_bits(r, 6);
    if (aac_read_bit(r) != 0) { return AAC_ERR_UNSUPPORTED; }
  }
  return aac_setup_bands(d, c);
}

fn aac_read_section_data(d: AacDecoder*, r: AacBits*, c: AacChannel*) -> int32 {
  var bits: int32 = 5;
  if (c->window_sequence == AAC_WINDOW_SHORT) { bits = 3; }
  var escape: int32 = (1 << bits) - 1;

  for g in 0..c->num_groups {
    var sfb: int32 = 0;
    while (sfb < c->max_sfb) {
      var book: int32 = aac_read_bits(r, 4);
      var run: int32 = 0;
      var piece: int32 = aac_read_bits(r, bits);
      run = piece;
      while (piece == escape) {
        piece = aac_read_bits(r, bits);
        run = run + piece;
      }
      if (sfb + run > c->max_sfb) { return AAC_ERR_BITSTREAM; }
      for i in 0..run {
        c->sfb_codebook[g * AAC_MAX_SFB + sfb + i] = book;
      }
      sfb = sfb + run;
      if (r->overrun != 0) { return AAC_ERR_BITSTREAM; }
    }
  }
  return AAC_OK;
}

fn aac_decode_scale_delta(d: AacDecoder*, r: AacBits*) -> int32 {
  var entry: int32 = aac_decode_symbol(d, r, 11);
  if (entry < 0) { return -1000; }
  return d->huffman_value[d->book_value_offset[11] + entry] - 60;
}

fn aac_read_scale_factors(d: AacDecoder*, r: AacBits*, c: AacChannel*) -> int32 {
  var scale: int32 = c->global_gain;
  var intensity: int32 = 0;
  var noise: int32 = c->global_gain - 90;
  var noise_started: int32 = 0;

  for g in 0..c->num_groups {
    for sfb in 0..c->max_sfb {
      var book: int32 = c->sfb_codebook[g * AAC_MAX_SFB + sfb];
      if (book == AAC_HCB_ZERO) {
        c->scale_factor[g * AAC_MAX_SFB + sfb] = 0;
        continue;
      }
      if (book == AAC_HCB_INTENSITY || book == AAC_HCB_INTENSITY2) {
        var delta: int32 = aac_decode_scale_delta(d, r);
        if (delta == -1000) { return AAC_ERR_BITSTREAM; }
        intensity = intensity + delta;
        c->scale_factor[g * AAC_MAX_SFB + sfb] = intensity;
        continue;
      }
      if (book == AAC_HCB_NOISE) {
        if (noise_started == 0) {
          noise_started = 1;
          noise = noise + aac_read_bits(r, 9) - 256;
        } else {
          var delta: int32 = aac_decode_scale_delta(d, r);
          if (delta == -1000) { return AAC_ERR_BITSTREAM; }
          noise = noise + delta;
        }
        c->scale_factor[g * AAC_MAX_SFB + sfb] = noise;
        continue;
      }
      var step: int32 = aac_decode_scale_delta(d, r);
      if (step == -1000) { return AAC_ERR_BITSTREAM; }
      scale = scale + step;
      if (scale < 0 || scale > 255) { return AAC_ERR_BITSTREAM; }
      c->scale_factor[g * AAC_MAX_SFB + sfb] = scale;
    }
  }
  return AAC_OK;
}

fn aac_read_pulse_data(r: AacBits*, c: AacChannel*) -> int32 {
  var count: int32 = aac_read_bits(r, 2);
  c->pulse_count = count + 1;
  c->pulse_start_sfb = aac_read_bits(r, 6);
  for i in 0..(count + 1) {
    c->pulse_offset[i] = aac_read_bits(r, 5);
    c->pulse_amplitude[i] = aac_read_bits(r, 4);
  }
  if (c->pulse_start_sfb > c->num_swb) { return AAC_ERR_BITSTREAM; }
  c->pulse_present = 1;
  g_aac_frame_pulse = g_aac_frame_pulse + 1;
  return AAC_OK;
}

fn aac_apply_pulses(c: AacChannel*) {
  if (c->pulse_present == 0) { return; }
  if (c->window_sequence == AAC_WINDOW_SHORT) { return; }
  var k: int32 = c->swb_offset[c->pulse_start_sfb];
  for i in 0..c->pulse_count {
    k = k + c->pulse_offset[i];
    if (k < 0 || k >= AAC_SPECTRUM) { return; }
    if (c->spectrum[k] > 0.0) {
      c->spectrum[k] = c->spectrum[k] + (float64)c->pulse_amplitude[i];
    } else {
      c->spectrum[k] = c->spectrum[k] - (float64)c->pulse_amplitude[i];
    }
  }
}

fn aac_read_tns_data(d: AacDecoder*, r: AacBits*, c: AacChannel*) -> int32 {
  var filter_bits: int32 = 2;
  var length_bits: int32 = 6;
  var order_bits: int32 = 5;
  var order_limit: int32 = 20;
  if (c->window_sequence == AAC_WINDOW_SHORT) {
    filter_bits = 1;
    length_bits = 4;
    order_bits = 3;
    order_limit = 7;
  }

  for w in 0..c->num_windows {
    var filters: int32 = aac_read_bits(r, filter_bits);
    c->tns_filters[w] = filters;
    if (filters == 0) { continue; }
    var resolution: int32 = aac_read_bit(r);
    for f in 0..filters {
      var slot: int32 = w * 3 + f;
      if (f >= 3) { return AAC_ERR_UNSUPPORTED; }
      c->tns_length[slot] = aac_read_bits(r, length_bits);
      var order: int32 = aac_read_bits(r, order_bits);
      c->tns_order[slot] = order;
      if (order == 0) { continue; }
      if (order > order_limit) { return AAC_ERR_BITSTREAM; }
      c->tns_direction[slot] = aac_read_bit(r);
      var compress: int32 = aac_read_bit(r);
      var coefficient_bits: int32 = 3 + resolution - compress;
      var table: int32 = compress * 2 + resolution;
      for i in 0..order {
        var raw: int32 = aac_read_bits(r, coefficient_bits);
        c->tns_coefficient[slot * 20 + i] = d->tns_coefficients[table * 16 + raw];
      }
    }
  }
  c->tns_present = 1;
  return AAC_OK;
}

fn aac_read_spectral_data(d: AacDecoder*, r: AacBits*, c: AacChannel*) -> int32 {
  for i in 0..AAC_SPECTRUM { c->spectrum[i] = 0.0; }

  var group_start: int32 = 0;
  for g in 0..c->num_groups {
    var window_span: int32 = c->group_length[g];
    for sfb in 0..c->max_sfb {
      var book: int32 = c->sfb_codebook[g * AAC_MAX_SFB + sfb];
      if (book == AAC_HCB_ZERO || book == AAC_HCB_NOISE ||
          book == AAC_HCB_INTENSITY || book == AAC_HCB_INTENSITY2) {
        continue;
      }
      if (book > 11) { return AAC_ERR_BITSTREAM; }

      var low: int32 = c->swb_offset[sfb];
      var high: int32 = c->swb_offset[sfb + 1];
      var width: int32 = high - low;
      var dimension: int32 = d->book_dim[book - 1];
      var is_unsigned: int32 = d->book_unsigned[book - 1];

      for w in 0..window_span {
        var base: int32 = (group_start + w) * 128 + low;
        if (c->window_sequence != AAC_WINDOW_SHORT) { base = low; }
        var k: int32 = 0;
        while (k < width) {
          var entry: int32 = aac_decode_symbol(d, r, book - 1);
          if (entry < 0) { return AAC_ERR_BITSTREAM; }
          var values: int32 = d->book_value_offset[book - 1] + entry * dimension;
          var raw: int32[4];
          for t in 0..dimension { raw[t] = d->huffman_value[values + t]; }
          if (is_unsigned != 0) {
            for t in 0..dimension {
              if (raw[t] != 0) {
                if (aac_read_bit(r) != 0) { raw[t] = 0 - raw[t]; }
              }
            }
          }
          if (book == AAC_HCB_ESCAPE) {
            for t in 0..dimension {
              if (raw[t] == 16 || raw[t] == -16) {
                var magnitude: int32 = aac_read_escape(r);
                if (raw[t] < 0) { raw[t] = 0 - magnitude; } else { raw[t] = magnitude; }
              }
            }
          }
          for t in 0..dimension { c->spectrum[base + k + t] = (float64)raw[t]; }
          k = k + dimension;
        }
      }
    }
    group_start = group_start + window_span;
  }
  return AAC_OK;
}

fn aac_read_channel_stream(d: AacDecoder*, r: AacBits*, c: AacChannel*,
                           common_window: int32) -> int32 {
  c->global_gain = aac_read_bits(r, 8);
  c->tns_present = 0;
  c->pulse_present = 0;
  for i in 0..AAC_MAX_WINDOWS { c->tns_filters[i] = 0; }

  if (common_window == 0) {
    d->fail_stage = 1;
    var early: int32 = aac_read_ics_info(d, r, c);
    if (early != AAC_OK) { d->fail_bits = r->position; return early; }
  }

  d->fail_stage = 2;
  var status: int32 = aac_read_section_data(d, r, c);
  if (status != AAC_OK) { d->fail_bits = r->position; return status; }
  d->fail_stage = 3;
  status = aac_read_scale_factors(d, r, c);
  if (status != AAC_OK) { d->fail_bits = r->position; return status; }

  d->fail_stage = 4;
  if (aac_read_bit(r) != 0) {
    status = aac_read_pulse_data(r, c);
    if (status != AAC_OK) { d->fail_bits = r->position; return status; }
  }
  d->fail_stage = 5;
  if (aac_read_bit(r) != 0) {
    status = aac_read_tns_data(d, r, c);
    if (status != AAC_OK) { d->fail_bits = r->position; return status; }
  }
  d->fail_stage = 6;
  if (aac_read_bit(r) != 0) { d->fail_bits = r->position; return AAC_ERR_UNSUPPORTED; }

  d->fail_stage = 7;
  status = aac_read_spectral_data(d, r, c);
  if (status != AAC_OK) { d->fail_bits = r->position; }
  aac_apply_pulses(c);
  return status;
}

fn aac_copy_ics(from: AacChannel*, to: AacChannel*) {
  to->window_sequence = from->window_sequence;
  to->window_shape = from->window_shape;
  to->max_sfb = from->max_sfb;
  to->num_windows = from->num_windows;
  to->num_groups = from->num_groups;
  to->num_swb = from->num_swb;
  for i in 0..AAC_MAX_WINDOWS { to->group_length[i] = from->group_length[i]; }
  for i in 0..64 { to->swb_offset[i] = from->swb_offset[i]; }
}

fn aac_read_single_channel(d: AacDecoder*, r: AacBits*) -> int32 {
  aac_read_bits(r, 4);
  d->frame_channels = 1;
  return aac_read_channel_stream(d, r, &d->channels[0], 0);
}

fn aac_read_channel_pair(d: AacDecoder*, r: AacBits*) -> int32 {
  aac_read_bits(r, 4);
  d->frame_channels = 2;
  d->ms_mask = 0;
  for i in 0..408 { d->ms_used[i] = 0; }

  var common_window: int32 = aac_read_bit(r);
  if (common_window != 0) {
    var status: int32 = aac_read_ics_info(d, r, &d->channels[0]);
    if (status != AAC_OK) { return status; }
    aac_copy_ics(&d->channels[0], &d->channels[1]);

    d->ms_mask = aac_read_bits(r, 2);
    if (d->ms_mask == 1) {
      for g in 0..d->channels[0].num_groups {
        for sfb in 0..d->channels[0].max_sfb {
          d->ms_used[g * AAC_MAX_SFB + sfb] = aac_read_bit(r);
        }
      }
    } else if (d->ms_mask == 2) {
      for i in 0..408 { d->ms_used[i] = 1; }
    } else if (d->ms_mask == 3) {
      return AAC_ERR_BITSTREAM;
    }
  }

  var status: int32 = aac_read_channel_stream(d, r, &d->channels[0], common_window);
  if (status != AAC_OK) { return status; }
  return aac_read_channel_stream(d, r, &d->channels[1], common_window);
}

fn aac_skip_fill(r: AacBits*) -> int32 {
  var count: int32 = aac_read_bits(r, 4);
  if (count == 15) {
    var extra: int32 = aac_read_bits(r, 8);
    count = count + extra - 1;
  }
  for i in 0..count { aac_read_bits(r, 8); }
  return AAC_OK;
}

fn aac_skip_data_stream(r: AacBits*) -> int32 {
  aac_read_bits(r, 4);
  var align: int32 = aac_read_bit(r);
  var count: int32 = aac_read_bits(r, 8);
  if (count == 255) { count = count + aac_read_bits(r, 8); }
  if (align != 0) {
    while ((r->position & (int64)7) != (int64)0) { aac_read_bit(r); }
  }
  for i in 0..count { aac_read_bits(r, 8); }
  return AAC_OK;
}

fn aac_decode_frame(d: AacDecoder*, data: uint8*, size: int64) -> int32 {
  var r: AacBits;
  aac_bits_start(&r, data, size);
  d->frame_channels = 0;

  var guard: int32 = 0;
  while (guard < 64) {
    guard = guard + 1;
    if (aac_bits_left(&r) < (int64)3) { return AAC_ERR_BITSTREAM; }
    var element: int32 = aac_read_bits(&r, 3);

    if (element == AAC_ELEMENT_END) { break; }

    var status: int32 = AAC_OK;
    if (element == AAC_ELEMENT_SCE) {
      status = aac_read_single_channel(d, &r);
    } else if (element == AAC_ELEMENT_CPE) {
      status = aac_read_channel_pair(d, &r);
    } else if (element == AAC_ELEMENT_FIL) {
      status = aac_skip_fill(&r);
    } else if (element == AAC_ELEMENT_DSE) {
      status = aac_skip_data_stream(&r);
    } else {
      return AAC_ERR_UNSUPPORTED;
    }
    if (status != AAC_OK) { return status; }
    if (r.overrun != 0) { return AAC_ERR_BITSTREAM; }
  }

  if (r.overrun != 0) { return AAC_ERR_BITSTREAM; }
  if (d->frame_channels == 0) { return AAC_ERR_BITSTREAM; }

  var left: int64 = aac_bits_left(&r);
  if (left < 0 || left >= (int64)8) {
    d->fail_stage = 8;
    d->fail_bits = r.position;
    return AAC_ERR_BITSTREAM;
  }
  return AAC_OK;
}


fn aac_dequantize(d: AacDecoder*, c: AacChannel*) {
  var group_start: int32 = 0;
  for g in 0..c->num_groups {
    var span: int32 = c->group_length[g];
    for sfb in 0..c->max_sfb {
      var book: int32 = c->sfb_codebook[g * AAC_MAX_SFB + sfb];
      g_aac_book_use[book] = g_aac_book_use[book] + (int64)1;
      if (book == AAC_HCB_NOISE) { g_aac_frame_pns = g_aac_frame_pns + 1; }
      if (book == AAC_HCB_ZERO || book == AAC_HCB_NOISE ||
          book == AAC_HCB_INTENSITY || book == AAC_HCB_INTENSITY2) {
        continue;
      }
      var scale: int32 = c->scale_factor[g * AAC_MAX_SFB + sfb];
      var gain: float64 = aac_scale_gain(scale);
      var low: int32 = c->swb_offset[sfb];
      var high: int32 = c->swb_offset[sfb + 1];
      for w in 0..span {
        var base: int32 = (group_start + w) * 128;
        if (c->window_sequence != AAC_WINDOW_SHORT) { base = 0; }
        for k in low..high {
          var value: float64 = c->spectrum[base + k];
          if (value == 0.0) { continue; }
          var magnitude: float64 = aac_fabs(value);
          var scaled: float64 = magnitude * aac_cbrt(magnitude) * gain;
          if (value < 0.0) { scaled = 0.0 - scaled; }
          c->spectrum[base + k] = scaled;
        }
      }
    }
    group_start = group_start + span;
  }
}

fn aac_apply_ms(d: AacDecoder*) {
  if (d->ms_mask == 0 || d->frame_channels < 2) { return; }
  var left: AacChannel* = &d->channels[0];
  var right: AacChannel* = &d->channels[1];

  var group_start: int32 = 0;
  for g in 0..left->num_groups {
    var span: int32 = left->group_length[g];
    for sfb in 0..left->max_sfb {
      if (d->ms_used[g * AAC_MAX_SFB + sfb] == 0) { continue; }
      var book: int32 = right->sfb_codebook[g * AAC_MAX_SFB + sfb];
      if (book == AAC_HCB_INTENSITY || book == AAC_HCB_INTENSITY2) { continue; }
      var low: int32 = left->swb_offset[sfb];
      var high: int32 = left->swb_offset[sfb + 1];
      for w in 0..span {
        var base: int32 = (group_start + w) * 128;
        if (left->window_sequence != AAC_WINDOW_SHORT) { base = 0; }
        for k in low..high {
          var a: float64 = left->spectrum[base + k];
          var b: float64 = right->spectrum[base + k];
          left->spectrum[base + k] = a + b;
          right->spectrum[base + k] = a - b;
        }
      }
    }
    group_start = group_start + span;
  }
}

fn aac_tns_band_limit(c: AacChannel*, window: int32, filter: int32, out_start: int32*,
                      out_end: int32*) {
  var slot: int32 = window * 3 + filter;
  var top: int32 = c->num_swb;
  for f in 0..filter { top = top - c->tns_length[window * 3 + f]; }
  var bottom: int32 = top - c->tns_length[slot];
  if (bottom < 0) { bottom = 0; }
  if (top < 0) { top = 0; }
  if (top > c->max_sfb) { top = c->max_sfb; }
  if (bottom > c->max_sfb) { bottom = c->max_sfb; }
  if (bottom > top) { bottom = top; }
  *out_start = c->swb_offset[bottom];
  *out_end = c->swb_offset[top];
}

fn aac_apply_tns(d: AacDecoder*, c: AacChannel*) {
  if (c->tns_present == 0) { return; }
  var size: int32 = 1024;
  if (c->window_sequence == AAC_WINDOW_SHORT) { size = 128; }

  for w in 0..c->num_windows {
    var filters: int32 = c->tns_filters[w];
    for f in 0..filters {
      var slot: int32 = w * 3 + f;
      var order: int32 = c->tns_order[slot];
      if (order == 0) { continue; }
      var limit: int32 = 12;
      if (c->window_sequence == AAC_WINDOW_SHORT) { limit = 7; }
      if (order > limit) { order = limit; }

      var start: int32 = 0;
      var end: int32 = 0;
      aac_tns_band_limit(c, w, f, &start, &end);
      if (end > size) { end = size; }
      var span: int32 = end - start;
      if (span <= 0) { continue; }

      var lpc: float64[21];
      var work: float64[21];
      lpc[0] = 1.0;
      for m in 1..(order + 1) {
        var coefficient: float64 = 0.0 - c->tns_coefficient[slot * 20 + m - 1];
        for i in 1..m { work[i] = lpc[i] + coefficient * lpc[m - i]; }
        for i in 1..m { lpc[i] = work[i]; }
        lpc[m] = coefficient;
      }

      var base: int32 = w * 128;
      if (c->window_sequence != AAC_WINDOW_SHORT) { base = 0; }

      if (c->tns_direction[slot] != 0) {
        var index: int32 = end - 1;
        for i in 0..span {
          var sum: float64 = c->spectrum[base + index];
          for m in 1..(order + 1) {
            if (i - m >= 0) { sum = sum - lpc[m] * c->spectrum[base + index + m]; }
          }
          c->spectrum[base + index] = sum;
          index = index - 1;
        }
      } else {
        var index: int32 = start;
        for i in 0..span {
          var sum: float64 = c->spectrum[base + index];
          for m in 1..(order + 1) {
            if (i - m >= 0) { sum = sum - lpc[m] * c->spectrum[base + index - m]; }
          }
          c->spectrum[base + index] = sum;
          index = index + 1;
        }
      }
    }
  }
}

fn aac_imdct(d: AacDecoder*, input: float64*, output: float64*, size: int32) {
  var half: int32 = size / 2;
  var mask: int32 = size * 4 - 1;
  var table: float64* = d->cos_long;
  if (size == 256) { table = d->cos_short; }

  var quarter: int32 = size / 2;
  for n in 0..size {
    var total: float64 = 0.0;
    var step: int32 = (2 * n + 1 + quarter) & mask;
    var phase: int32 = step;
    for k in 0..half {
      total = total + input[k] * table[phase];
      phase = (phase + 2 * step) & mask;
    }
    output[n] = total * (2.0 / (float64)size);
  }
}

fn aac_filterbank(d: AacDecoder*, c: AacChannel*, output: float64*) {
  var previous: float64* = aac_window_half(d, c->previous_window_shape, 1);
  var current: float64* = aac_window_half(d, c->window_shape, 1);
  var previous_short: float64* = aac_window_half(d, c->previous_window_shape, 0);
  var current_short: float64* = aac_window_half(d, c->window_shape, 0);

  var transform: float64* = &d->transform[0];

  if (c->window_sequence == AAC_WINDOW_SHORT) {
    var accumulated: float64[2048];
    for i in 0..2048 { accumulated[i] = 0.0; }
    for w in 0..8 {
      aac_imdct(d, &c->spectrum[w * 128], transform, 256);
      var offset: int32 = 448 + w * 128;
      var left: float64* = previous_short;
      if (w > 0) { left = current_short; }
      for i in 0..128 {
        accumulated[offset + i] = accumulated[offset + i] + transform[i] * left[i];
      }
      for i in 0..128 {
        accumulated[offset + 128 + i] =
          accumulated[offset + 128 + i] + transform[128 + i] * current_short[127 - i];
      }
    }
    for i in 0..1024 { output[i] = c->overlap[i] + accumulated[i]; }
    for i in 0..1024 { c->overlap[i] = accumulated[1024 + i]; }
  } else {
    aac_imdct(d, &c->spectrum[0], transform, 2048);
    var left: float64[1024];
    var right: float64[1024];

    if (c->window_sequence == AAC_WINDOW_STOP) {
      for i in 0..448 { left[i] = 0.0; }
      for i in 0..128 { left[448 + i] = previous_short[i]; }
      for i in 0..448 { left[576 + i] = 1.0; }
    } else {
      for i in 0..1024 { left[i] = previous[i]; }
    }

    if (c->window_sequence == AAC_WINDOW_START) {
      for i in 0..448 { right[i] = 1.0; }
      for i in 0..128 { right[448 + i] = current_short[127 - i]; }
      for i in 0..448 { right[576 + i] = 0.0; }
    } else {
      for i in 0..1024 { right[i] = current[1023 - i]; }
    }

    for i in 0..1024 { output[i] = c->overlap[i] + transform[i] * left[i]; }
    for i in 0..1024 { c->overlap[i] = transform[1024 + i] * right[i]; }
  }
  g_aac_window_use[c->window_sequence] = g_aac_window_use[c->window_sequence] + (int64)1;
  c->previous_window_shape = c->window_shape;
}

fn aac_reconstruct(d: AacDecoder*, output: float64*) {
  g_aac_frame_pns = 0;
  g_aac_frame_pulse = 0;
  for ch in 0..d->frame_channels {
    aac_dequantize(d, &d->channels[ch]);
  }
  aac_apply_ms(d);
  for ch in 0..d->frame_channels {
    if (g_aac_use_tns != 0) { aac_apply_tns(d, &d->channels[ch]); }
    aac_filterbank(d, &d->channels[ch], &output[ch * 1024]);
  }
}

fn aac_decoder_reset(d: AacDecoder*) {
  for ch in 0..2 {
    for i in 0..AAC_SPECTRUM { d->channels[ch].overlap[i] = 0.0; }
    for i in 0..AAC_SPECTRUM { d->channels[ch].spectrum[i] = 0.0; }
    d->channels[ch].previous_window_shape = 0;
    d->channels[ch].window_sequence = AAC_WINDOW_LONG;
  }
}

fn aac_decode_pcm(d: AacDecoder*, data: uint8*, size: int64, output: float64*) -> int32 {
  var status: int32 = aac_decode_frame(d, data, size);
  if (status != AAC_OK) { return status; }
  aac_reconstruct(d, output);
  return AAC_OK;
}
