import "std/mem";
import "h264";
import "h264_decode";

var g_mc_src: int32[441];
var g_mc_half_h: int32[272];
var g_mc_half_v: int32[272];
var g_mc_partial: int32[336];
var g_mc_center: int32[256];
var g_mc_chroma: int32[289];

fn h264_reference_sample(plane: uint8*, stride: int32, width: int32, height: int32,
                         x: int32, y: int32) -> int32 {
  var cx: int32 = x;
  var cy: int32 = y;
  if (cx < 0) { cx = 0; }
  if (cx > width - 1) { cx = width - 1; }
  if (cy < 0) { cy = 0; }
  if (cy > height - 1) { cy = height - 1; }
  return (int32)plane[(int64)cy * (int64)stride + (int64)cx];
}

fn h264_copy_plane_u8(plane: uint8*, stride: int32, width: int32, height: int32,
                      x0: int32, y0: int32, w: int32, h: int32,
                      out: uint8*, out_stride: int32) {
  var inside: int32 = 0;
  if (x0 >= 0 && x0 + w <= width) { inside = 1; }
  for row in 0..h {
    var sy: int32 = y0 + row;
    if (sy < 0) { sy = 0; }
    if (sy > height - 1) { sy = height - 1; }
    var base: int64 = (int64)sy * (int64)stride;
    var target: int32 = row * out_stride;
    if (inside != 0) {
      memcpy(&out[target], &plane[base + (int64)x0], (int64)w);
    } else {
      for column in 0..w {
        var sx: int32 = x0 + column;
        if (sx < 0) { sx = 0; }
        if (sx > width - 1) { sx = width - 1; }
        out[target + column] = plane[base + (int64)sx];
      }
    }
  }
}

fn h264_fetch_padded(plane: uint8*, stride: int32, width: int32, height: int32,
                     x0: int32, y0: int32, w: int32, h: int32, out: int32*) {
  var inside: int32 = 0;
  if (x0 >= 0 && x0 + w <= width) { inside = 1; }
  for row in 0..h {
    var sy: int32 = y0 + row;
    if (sy < 0) { sy = 0; }
    if (sy > height - 1) { sy = height - 1; }
    var base: int64 = (int64)sy * (int64)stride;
    var target: int32 = row * w;
    if (inside != 0) {
      var offset: int64 = base + (int64)x0;
      for column in 0..w {
        out[target + column] = (int32)plane[offset + (int64)column];
      }
    } else {
      for column in 0..w {
        var sx: int32 = x0 + column;
        if (sx < 0) { sx = 0; }
        if (sx > width - 1) { sx = width - 1; }
        out[target + column] = (int32)plane[base + (int64)sx];
      }
    }
  }
}

fn h264_motion_compensate_luma(v: H264Video*, reference: H264Picture*, target: int32*,
                               block_x: int32, block_y: int32, block_w: int32, block_h: int32,
                               mv_x: int32, mv_y: int32) {
  var width: int32 = v->mb_width * 16;
  var height: int32 = v->mb_height * 16;
  var base_x: int32 = block_x + (mv_x >> 2);
  var base_y: int32 = block_y + (mv_y >> 2);
  var x_frac: int32 = mv_x & 3;
  var y_frac: int32 = mv_y & 3;

  if (x_frac == 0 && y_frac == 0) {
    h264_fetch_padded(reference->luma, v->luma_stride, width, height,
                      base_x, base_y, block_w, block_h, target);
    return;
  }

  var src: int32* = &g_mc_src[0];
  var pad_w: int32 = block_w + 5;
  var pad_h: int32 = block_h + 5;
  h264_fetch_padded(reference->luma, v->luma_stride, width, height,
                    base_x - 2, base_y - 2, pad_w, pad_h, src);

  var half_h: int32* = &g_mc_half_h[0];
  var half_v: int32* = &g_mc_half_v[0];
  var partial: int32* = &g_mc_partial[0];
  var center: int32* = &g_mc_center[0];
  var wide: int32 = block_w + 1;

  if (x_frac != 0 && y_frac != 2) {
    for row in 0..(block_h + 1) {
      var source: int32 = (row + 2) * pad_w + 2;
      var store: int32 = row * block_w;
      for column in 0..block_w {
        var p: int32 = source + column;
        var value: int32 = src[p - 2] - 5 * src[p - 1] + 20 * src[p] +
                           20 * src[p + 1] - 5 * src[p + 2] + src[p + 3];
        half_h[store + column] = (int32)h264_clip_sample((value + 16) >> 5);
      }
    }
  }

  if (y_frac != 0 && x_frac != 2) {
    for row in 0..block_h {
      var source: int32 = (row + 2) * pad_w + 2;
      var store: int32 = row * wide;
      for column in 0..wide {
        var p: int32 = source + column;
        var value: int32 = src[p - pad_w - pad_w] - 5 * src[p - pad_w] + 20 * src[p] +
                           20 * src[p + pad_w] - 5 * src[p + pad_w + pad_w] +
                           src[p + pad_w + pad_w + pad_w];
        half_v[store + column] = (int32)h264_clip_sample((value + 16) >> 5);
      }
    }
  }

  var need_center: int32 = 0;
  if (x_frac == 2 && y_frac != 0) { need_center = 1; }
  if (y_frac == 2 && x_frac != 0) { need_center = 1; }
  if (need_center != 0) {
    for row in 0..(block_h + 5) {
      var source: int32 = row * pad_w + 2;
      var store: int32 = row * block_w;
      for column in 0..block_w {
        var p: int32 = source + column;
        partial[store + column] = src[p - 2] - 5 * src[p - 1] + 20 * src[p] +
                                  20 * src[p + 1] - 5 * src[p + 2] + src[p + 3];
      }
    }
    for row in 0..block_h {
      var store: int32 = row * block_w;
      for column in 0..block_w {
        var p: int32 = store + column;
        var value: int32 = partial[p] - 5 * partial[p + block_w] +
                           20 * partial[p + block_w * 2] +
                           20 * partial[p + block_w * 3] - 5 * partial[p + block_w * 4] +
                           partial[p + block_w * 5];
        center[p] = (int32)h264_clip_sample((value + 512) >> 10);
      }
    }
  }

  for row in 0..block_h {
    var integer: int32 = (row + 2) * pad_w + 2;
    var below: int32 = integer + pad_w;
    var flat: int32 = row * block_w;
    var tall: int32 = row * wide;
    var next: int32 = flat + block_w;
    for column in 0..block_w {
      var value: int32 = 0;
      if (y_frac == 0) {
        var b: int32 = half_h[flat + column];
        if (x_frac == 2) { value = b; }
        else if (x_frac == 1) { value = (src[integer + column] + b + 1) >> 1; }
        else { value = (src[integer + column + 1] + b + 1) >> 1; }
      } else if (x_frac == 0) {
        var e: int32 = half_v[tall + column];
        if (y_frac == 2) { value = e; }
        else if (y_frac == 1) { value = (src[integer + column] + e + 1) >> 1; }
        else { value = (src[below + column] + e + 1) >> 1; }
      } else if (x_frac == 2 && y_frac == 2) {
        value = center[flat + column];
      } else if (y_frac == 2) {
        if (x_frac == 1) { value = (half_v[tall + column] + center[flat + column] + 1) >> 1; }
        else { value = (center[flat + column] + half_v[tall + column + 1] + 1) >> 1; }
      } else if (x_frac == 2) {
        if (y_frac == 1) { value = (half_h[flat + column] + center[flat + column] + 1) >> 1; }
        else { value = (center[flat + column] + half_h[next + column] + 1) >> 1; }
      } else if (y_frac == 1) {
        if (x_frac == 1) { value = (half_h[flat + column] + half_v[tall + column] + 1) >> 1; }
        else { value = (half_h[flat + column] + half_v[tall + column + 1] + 1) >> 1; }
      } else {
        if (x_frac == 1) { value = (half_v[tall + column] + half_h[next + column] + 1) >> 1; }
        else { value = (half_v[tall + column + 1] + half_h[next + column] + 1) >> 1; }
      }
      target[flat + column] = value;
    }
  }
}

fn h264_motion_compensate_chroma(v: H264Video*, plane: uint8*, target: int32*,
                                 block_x: int32, block_y: int32, block_w: int32, block_h: int32,
                                 mv_x: int32, mv_y: int32) {
  var width: int32 = v->mb_width * 8;
  var height: int32 = v->mb_height * 8;
  var base_x: int32 = block_x + (mv_x >> 3);
  var base_y: int32 = block_y + (mv_y >> 3);
  var x_frac: int32 = mv_x & 7;
  var y_frac: int32 = mv_y & 7;

  var src: int32* = &g_mc_chroma[0];
  var pad_w: int32 = block_w + 1;
  h264_fetch_padded(plane, v->chroma_stride, width, height,
                    base_x, base_y, pad_w, block_h + 1, src);

  var w00: int32 = (8 - x_frac) * (8 - y_frac);
  var w01: int32 = x_frac * (8 - y_frac);
  var w10: int32 = (8 - x_frac) * y_frac;
  var w11: int32 = x_frac * y_frac;

  for row in 0..block_h {
    var top: int32 = row * pad_w;
    var bottom: int32 = top + pad_w;
    var store: int32 = row * block_w;
    for column in 0..block_w {
      target[store + column] =
        (w00 * src[top + column] + w01 * src[top + column + 1] +
         w10 * src[bottom + column] + w11 * src[bottom + column + 1] + 32) >> 6;
    }
  }
}

fn h264_block_available(v: H264Video*, block_x: int32, block_y: int32) -> int32 {
  if (block_x < 0 || block_y < 0) { return 0; }
  if (block_x >= v->mb_width * 4) { return 0; }
  if (block_y >= v->mb_height * 4) { return 0; }
  var mb: int32 = (block_y >> 2) * v->mb_width + (block_x >> 2);
  if (mb == v->mb_index) {
    var inside: int32 = (block_y & 3) * 4 + (block_x & 3);
    return v->block_filled[inside];
  }
  if (mb > v->mb_index) { return 0; }
  if (v->macroblocks[mb].coded == 0) { return 0; }
  return 1;
}

fn h264_neighbour_motion(v: H264Video*, list: int32, block_x: int32, block_y: int32,
                         out_ref: int32*, out_mv_x: int32*, out_mv_y: int32*) -> int32 {
  *out_ref = -1;
  *out_mv_x = 0;
  *out_mv_y = 0;
  if (h264_block_available(v, block_x, block_y) == 0) { return 0; }

  var mb: int32 = (block_y >> 2) * v->mb_width + (block_x >> 2);
  var inside: int32 = (block_y & 3) * 4 + (block_x & 3);
  var info: H264Macroblock* = &v->macroblocks[mb];
  if (info->is_intra != 0) { return 1; }

  var slot: int32 = list * 16 + inside;
  *out_ref = info->ref_index[list * 4 + ((inside >> 3) * 2 + ((inside & 3) >> 1))];
  *out_mv_x = info->mv_x[slot];
  *out_mv_y = info->mv_y[slot];
  return 1;
}

fn h264_predict_motion_vector(v: H264Video*, list: int32, part_x: int32, part_y: int32,
                              part_w: int32, part_h: int32, reference: int32,
                              out_mv_x: int32*, out_mv_y: int32*) {
  var origin_x: int32 = v->mb_x * 4 + part_x;
  var origin_y: int32 = v->mb_y * 4 + part_y;

  var ref_a: int32 = 0;
  var mv_ax: int32 = 0;
  var mv_ay: int32 = 0;
  var has_a: int32 = h264_neighbour_motion(v, list, origin_x - 1, origin_y, &ref_a, &mv_ax, &mv_ay);

  var ref_b: int32 = 0;
  var mv_bx: int32 = 0;
  var mv_by: int32 = 0;
  var has_b: int32 = h264_neighbour_motion(v, list, origin_x, origin_y - 1, &ref_b, &mv_bx, &mv_by);

  var ref_c: int32 = 0;
  var mv_cx: int32 = 0;
  var mv_cy: int32 = 0;
  var has_c: int32 = h264_neighbour_motion(v, list, origin_x + part_w, origin_y - 1, &ref_c, &mv_cx, &mv_cy);
  if (has_c == 0) {
    has_c = h264_neighbour_motion(v, list, origin_x - 1, origin_y - 1, &ref_c, &mv_cx, &mv_cy);
  }

  if (has_b == 0 && has_c == 0 && has_a != 0) {
    *out_mv_x = mv_ax;
    *out_mv_y = mv_ay;
    return;
  }

  if (part_w == 4 && part_h == 2) {
    if (part_y == 0) {
      if (ref_b == reference) { *out_mv_x = mv_bx; *out_mv_y = mv_by; return; }
    } else {
      if (ref_a == reference) { *out_mv_x = mv_ax; *out_mv_y = mv_ay; return; }
    }
  } else if (part_w == 2 && part_h == 4) {
    if (part_x == 0) {
      if (ref_a == reference) { *out_mv_x = mv_ax; *out_mv_y = mv_ay; return; }
    } else {
      if (ref_c == reference) { *out_mv_x = mv_cx; *out_mv_y = mv_cy; return; }
    }
  }

  var matches: int32 = 0;
  var only_x: int32 = 0;
  var only_y: int32 = 0;
  if (ref_a == reference) { matches = matches + 1; only_x = mv_ax; only_y = mv_ay; }
  if (ref_b == reference) { matches = matches + 1; only_x = mv_bx; only_y = mv_by; }
  if (ref_c == reference) { matches = matches + 1; only_x = mv_cx; only_y = mv_cy; }
  if (matches == 1) {
    *out_mv_x = only_x;
    *out_mv_y = only_y;
    return;
  }

  *out_mv_x = h264_median(mv_ax, mv_bx, mv_cx);
  *out_mv_y = h264_median(mv_ay, mv_by, mv_cy);
}

fn h264_median(a: int32, b: int32, c: int32) -> int32 {
  var low: int32 = a;
  if (b < low) { low = b; }
  if (c < low) { low = c; }
  var high: int32 = a;
  if (b > high) { high = b; }
  if (c > high) { high = c; }
  return a + b + c - low - high;
}

fn h264_store_partition_motion(v: H264Video*, mb: H264Macroblock*, list: int32,
                               part_x: int32, part_y: int32, part_w: int32, part_h: int32,
                               reference: int32, mv_x: int32, mv_y: int32,
                               mvd_x: int32, mvd_y: int32) {
  for row in 0..part_h {
    for column in 0..part_w {
      var inside: int32 = (part_y + row) * 4 + part_x + column;
      mb->mv_x[list * 16 + inside] = mv_x;
      mb->mv_y[list * 16 + inside] = mv_y;
      mb->mvd_x[list * 16 + inside] = mvd_x;
      mb->mvd_y[list * 16 + inside] = mvd_y;
      v->block_filled[inside] = 1;
    }
  }
  var picture: int32 = -1;
  if (list == 0 && reference >= 0 && reference < v->ref_count0) { picture = v->ref_list0[reference]; }
  if (list == 1 && reference >= 0 && reference < v->ref_count1) { picture = v->ref_list1[reference]; }
  for row in 0..((part_h + 1) / 2) {
    for column in 0..((part_w + 1) / 2) {
      var block8: int32 = ((part_y / 2) + row) * 2 + (part_x / 2) + column;
      if (block8 >= 0 && block8 < 4) {
        mb->ref_index[list * 4 + block8] = reference;
        mb->ref_picture[list * 4 + block8] = picture;
      }
    }
  }
}
