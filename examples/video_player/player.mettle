const HOVER_BAR = 1;
const HOVER_PLAY = 2;
const HOVER_BACK = 3;
const HOVER_FORWARD = 4;
const HOVER_VOLUME = 5;
const HOVER_VOLUME_TRACK = 6;
const HOVER_FULLSCREEN = 7;
