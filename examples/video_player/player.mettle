var g_dropped: int64 = 0;
var g_decode_failures: int64 = 0;
var g_resets: int64 = 0;
var g_samples_decoded: int64 = 0;
var g_samples_skipped: int64 = 0;
var g_ring_miss: int64 = 0;
var g_worst_decode_us: int64 = 0;
var g_worst_batch: int64 = 0;
var g_report_at_us: int64 = 0;
var g_last_report_frame: int32 = 0;
var g_present_count: int64 = 0;

fn now_microseconds() -> int64 {
  var counter: int64 = 0;
  Win_QueryPerformanceCounter(&counter);
  var seconds: int64 = counter / g_qpc_frequency;
  var remainder: int64 = counter % g_qpc_frequency;
  return seconds * (int64)1000000 + remainder * (int64)1000000 / g_qpc_frequency;
}

fn append_byte(buffer: uint8*, index: int32, value: int32) -> int32 {
  buffer[index] = (uint8)value;
  return index + 1;
}

fn append_number(buffer: uint8*, index: int32, value: int64, min_digits: int32) -> int32 {
  var digits: uint8[24];
  var count: int32 = 0;
  var left: int64 = value;
  if (left < 0) { left = 0; }
  while (left > 0) {
    digits[count] = (uint8)(48 + (int32)(left % (int64)10));
    left = left / (int64)10;
    count = count + 1;
  }
  while (count < min_digits) {
    digits[count] = (uint8)48;
    count = count + 1;
  }
  if (count == 0) {
    digits[0] = (uint8)48;
    count = 1;
  }
  var out: int32 = index;
  for i in 0..count {
    buffer[out] = digits[count - 1 - i];
    out = out + 1;
  }
  return out;
}

fn append_text(buffer: uint8*, index: int32, text: cstring) -> int32 {
  var out: int32 = index;
  var i: int64 = 0;
  while (text[i] != (uint8)0) {
    buffer[out] = text[i];
    out = out + 1;
    i = i + 1;
  }
  return out;
}

fn append_clock(buffer: uint8*, index: int32, microseconds: int64) -> int32 {
  var total_seconds: int64 = microseconds / (int64)1000000;
  if (total_seconds < 0) { total_seconds = 0; }
  var hours: int64 = total_seconds / (int64)3600;
  var minutes: int64 = (total_seconds / (int64)60) % (int64)60;
  var seconds: int64 = total_seconds % (int64)60;
  var out: int32 = index;
  if (hours > 0) {
    out = append_number(buffer, out, hours, 1);
    out = append_byte(buffer, out, 58);
    out = append_number(buffer, out, minutes, 2);
  } else {
    out = append_number(buffer, out, minutes, 1);
  }
  out = append_byte(buffer, out, 58);
  out = append_number(buffer, out, seconds, 2);
  return out;
}

fn frame_at_position(microseconds: int64) -> int32 {
  return source_video_index_at_time(g_file, microseconds);
}

fn decode_frame(index: int32) -> int32 {
  if (g_file->video_codec == SOURCE_VIDEO_H264) {
    return decode_frame_h264(index);
  }
  var size: int32 = source_read_video(g_file, index, g_frame_buffer, g_frame_capacity);
  if (size < 0) { return 0; }
  if (size == 0) { return 1; }
  var started: int64 = now_microseconds();
  var status: int32 = jpeg_decode(g_decoder, g_frame_buffer, (int64)size);
  if (status != JPEG_OK) { return 0; }
  g_decode_us = now_microseconds() - started;
  g_decode_total_us = g_decode_total_us + g_decode_us;
  g_decode_samples = g_decode_samples + 1;
  g_pixels = g_decoder->pixels;
  g_picture_width = g_decoder->width;
  g_picture_height = g_decoder->height;
  g_has_picture = 1;
  return 1;
}

fn ring_slot(display: int32) -> int32 {
  return display % FRAME_RING;
}

fn ring_prepare() -> int32 {
  var count: int64 = (int64)g_video->width * (int64)g_video->height;
  if (count <= 0) { return 0; }
  if (g_ring != 0 && g_ring_frame == count) { return 1; }
  if (g_ring != 0) { h264_gpu_host_free((uint8*)g_ring); }
  g_ring = (uint32*)h264_gpu_host_alloc(count * 4 * (int64)FRAME_RING);
  if (g_ring == 0) {
    g_ring_frame = 0;
    return 0;
  }
  g_ring_frame = count;
  for i in 0..FRAME_RING { g_ring_display[i] = -1; }
  return 1;
}

fn ring_store(display: int32) {
  if (ring_prepare() == 0) { return; }
  var slot: int32 = ring_slot(display);
  h264_write_pixels_deferred(g_video, &g_ring[(int64)slot * g_ring_frame]);
  g_ring_display[slot] = display;
}

fn ring_has(display: int32) -> int32 {
  if (g_ring == 0 || display < 0) { return 0; }
  if (g_ring_display[ring_slot(display)] != display) { return 0; }
  return 1;
}

fn decode_ahead() {
  if (g_video == 0 || g_ring == 0) { return; }
  if (g_last_sample < 0 || g_last_sample + 1 >= g_file->video_frame_count) { return; }

  var wanted: int32 = g_displayed_frame + 1;
  var ready: int32 = 0;
  while (ready < RING_TARGET_AHEAD && ring_has(wanted + ready) != 0) {
    ready = ready + 1;
  }
  if (ready >= RING_TARGET_AHEAD) { return; }

  var next: int32 = g_last_sample + 1;
  var display: int32 = source_display_position(g_file, next);
  if (display > g_displayed_frame + FRAME_RING - 2) { return; }
  var occupant: int32 = g_ring_display[ring_slot(display)];
  if (occupant > g_displayed_frame && occupant != display) { return; }

  var size: int32 = source_read_video_by_sample(g_file, next, g_frame_buffer, g_frame_capacity);
  if (size <= 0) { return; }
  if (h264_decode_sample(g_video, g_frame_buffer, (int64)size) != H264_OK) {
    g_last_sample = next;
    return;
  }
  ring_store(display);
  g_last_sample = next;
}

fn ring_show(display: int32) -> int32 {
  var slot: int32 = ring_slot(display);
  if (g_ring == 0 || g_ring_display[slot] != display) { return 0; }
  h264_gpu_wait();
  g_pixels = &g_ring[(int64)slot * g_ring_frame];
  g_picture_width = g_video->width;
  g_picture_height = g_video->height;
  g_has_picture = 1;
  return 1;
}

fn decode_frame_h264(index: int32) -> int32 {
  if (ring_show(index) != 0) { return 1; }

  var target: int32 = source_sample_for_display(g_file, index);
  if (target < 0) { return 0; }

  g_ring_miss = g_ring_miss + (int64)1;
  var next: int32 = g_last_sample + 1;
  if (g_last_sample < 0 || target <= g_last_sample) {
    next = source_sync_sample_at_or_before(g_file, target);
    h264_video_reset(g_video);
    for i in 0..FRAME_RING { g_ring_display[i] = -1; }
    g_resets = g_resets + (int64)1;
  }

  var started: int64 = now_microseconds();
  var guard: int32 = 0;
  while (next < g_file->video_frame_count && guard < 4096) {
    var size: int32 = source_read_video_by_sample(g_file, next, g_frame_buffer, g_frame_capacity);
    if (size <= 0) { return 0; }
    var display: int32 = source_display_position(g_file, next);

    if (display < index && h264_sample_is_droppable(g_video, g_frame_buffer, (int64)size) != 0) {
      g_last_sample = next;
      next = next + 1;
      guard = guard + 1;
      g_samples_skipped = g_samples_skipped + (int64)1;
      continue;
    }

    if (h264_decode_sample(g_video, g_frame_buffer, (int64)size) != H264_OK) {
      g_last_sample = next;
      return 0;
    }
    if (display >= index && display < index + FRAME_RING) {
      ring_store(display);
    }
    g_last_sample = next;
    next = next + 1;
    guard = guard + 1;
    g_samples_decoded = g_samples_decoded + (int64)1;
    if (ring_show(index) != 0) { break; }
  }

  g_decode_us = now_microseconds() - started;
  if (g_decode_us > g_worst_decode_us) { g_worst_decode_us = g_decode_us; }
  if ((int64)guard > g_worst_batch) { g_worst_batch = (int64)guard; }
  g_decode_total_us = g_decode_total_us + g_decode_us;
  g_decode_samples = g_decode_samples + 1;
  return ring_show(index);
}

fn compute_destination(client: UiRect*) {
  var client_width: int32 = client->right - client->left;
  var client_height: int32 = client->bottom - client->top;
  if (client_width <= 0 || client_height <= 0) { return; }
  var source_width: int32 = g_file->width;
  var source_height: int32 = g_file->height;
  if (g_picture_width > 0) { source_width = g_picture_width; }
  if (g_picture_height > 0) { source_height = g_picture_height; }
  if (source_width <= 0 || source_height <= 0) { return; }

  var width: int32 = client_width;
  var height: int32 = (int32)((int64)client_width * (int64)source_height / (int64)source_width);
  if (height > client_height) {
    height = client_height;
    width = (int32)((int64)client_height * (int64)source_width / (int64)source_height);
  }
  g_dest_left = (client_width - width) / 2;
  g_dest_top = (client_height - height) / 2;
  g_dest_width = width;
  g_dest_height = height;
}

fn paint_letterbox(hdc: int64, client: UiRect*) {
  var black: uint32 = ui_rgb((uint32)0, (uint32)0, (uint32)0);
  if (g_dest_top > 0) {
    ui_fill_rect_color(hdc, 0, 0, client->right, g_dest_top, black);
  }
  var bottom: int32 = g_dest_top + g_dest_height;
  if (bottom < client->bottom) {
    ui_fill_rect_color(hdc, 0, bottom, client->right, client->bottom, black);
  }
  if (g_dest_left > 0) {
    ui_fill_rect_color(hdc, 0, g_dest_top, g_dest_left, bottom, black);
  }
  var right: int32 = g_dest_left + g_dest_width;
  if (right < client->right) {
    ui_fill_rect_color(hdc, right, g_dest_top, client->right, bottom, black);
  }
}

fn paint_picture(hdc: int64) {
  if (g_has_picture == 0) { return; }
  var info: BitmapInfoHeader;
  info.size = (uint32)40;
  info.width = g_picture_width;
  info.height = 0 - g_picture_height;
  info.planes = (uint16)1;
  info.bit_count = (uint16)32;
  info.compression = (uint32)0;
  info.size_image = (uint32)0;
  info.x_pels_per_meter = 0;
  info.y_pels_per_meter = 0;
  info.clr_used = (uint32)0;
  info.clr_important = (uint32)0;
  Gdi_SetStretchBltMode(hdc, 3);
  Gdi_StretchDIBits(hdc, g_dest_left, g_dest_top, g_dest_width, g_dest_height,
                    0, 0, g_picture_width, g_picture_height,
                    g_pixels, &info, (uint32)0, (uint32)0x00CC0020);
}

fn compute_layout(client: UiRect*) {
  var width: int32 = client->right - client->left;
  var height: int32 = client->bottom - client->top;
  g_bar_left = OSD_MARGIN;
  g_bar_right = width - OSD_MARGIN;
  g_bar_y = height - 74;
  g_row_y = height - 34;
  g_play_x = OSD_MARGIN + 20;
  g_back_x = g_play_x + BUTTON_STEP;
  g_forward_x = g_back_x + BUTTON_STEP;
  g_volume_x = g_forward_x + BUTTON_STEP;
  if (width < 540) {
    g_back_x = 0 - 1000;
    g_forward_x = 0 - 1000;
    g_volume_x = g_play_x + BUTTON_STEP;
  }
  g_volume_left = g_volume_x + 20;
  g_volume_right = g_volume_left + VOLUME_TRACK * g_volume_grow / 255;
  g_time_x = g_volume_right + 14;
  g_fullscreen_x = width - OSD_MARGIN - 20;
}

fn near_button(x: int32, center: int32) -> int32 {
  var offset: int32 = x - center;
  if (offset < 0) { offset = 0 - offset; }
  if (offset <= BUTTON_RADIUS + 3) { return 1; }
  return 0;
}

fn hover_at(x: int32, y: int32) -> int32 {
  if (g_file == 0) { return HOVER_NONE; }
  var client: UiRect = ui_window_client_rect(g_window);
  compute_layout(&client);
  if (y >= g_bar_y - 13 && y <= g_bar_y + 13 &&
      x >= g_bar_left - 10 && x <= g_bar_right + 10) {
    return HOVER_BAR;
  }
  if (y >= g_row_y - 20 && y <= g_row_y + 20) {
    if (near_button(x, g_play_x) != 0) { return HOVER_PLAY; }
    if (near_button(x, g_back_x) != 0) { return HOVER_BACK; }
    if (near_button(x, g_forward_x) != 0) { return HOVER_FORWARD; }
    if (near_button(x, g_fullscreen_x) != 0) { return HOVER_FULLSCREEN; }
    if (g_volume_grow > 100 && x >= g_volume_left - 6 && x <= g_volume_right + 10) {
      return HOVER_VOLUME_TRACK;
    }
    if (near_button(x, g_volume_x) != 0) { return HOVER_VOLUME; }
  }
  return HOVER_NONE;
}

fn osd_wanted() -> int32 {
  if (g_playing == 0) { return 1; }
  if (g_pressed != HOVER_NONE) { return 1; }
  if (g_pointer_inside != 0 && g_hover != HOVER_NONE) { return 1; }
  if (now_microseconds() < g_osd_until_us) { return 1; }
  return 0;
}

fn osd_visible() -> int32 {
  if (g_osd_alpha > 0) { return 1; }
  return 0;
}

fn approach(current: int32, target: int32, elapsed_us: int64, duration_us: int64) -> int32 {
  if (current == target) { return current; }
  var step: int32 = (int32)((int64)255 * elapsed_us / duration_us);
  if (step < 2) { step = 2; }
  var value: int32 = current;
  if (value < target) {
    value = value + step;
    if (value > target) { value = target; }
  } else {
    value = value - step;
    if (value < target) { value = target; }
  }
  return value;
}

fn flash_show(kind: int32) {
  g_flash_kind = kind;
  g_flash_start_us = now_microseconds();
}

fn flash_alpha() -> int32 {
  if (g_flash_kind == FLASH_NONE) { return 0; }
  var elapsed: int64 = now_microseconds() - g_flash_start_us;
  if (elapsed < 0) { return 0; }
  if (elapsed >= (int64)FLASH_HOLD_US) { return 0; }
  var remaining: float64 = 1.0 - (float64)elapsed / (float64)FLASH_HOLD_US;
  return (int32)(255.0 * remaining * remaining);
}

fn animation_step() -> int32 {
  var now: int64 = now_microseconds();
  var elapsed: int64 = now - g_animation_us;
  if (elapsed < 0) { elapsed = 0; }
  if (elapsed > (int64)120000) { elapsed = (int64)120000; }
  g_animation_us = now;

  var before_osd: int32 = g_osd_alpha;
  var before_bar: int32 = g_bar_grow;
  var before_volume: int32 = g_volume_grow;
  var before_flash: int32 = flash_alpha();

  var osd_target: int32 = 0;
  if (osd_wanted() != 0) { osd_target = 255; }
  var fade: int64 = 260000;
  if (osd_target == 255) { fade = 130000; }
  g_osd_alpha = approach(g_osd_alpha, osd_target, elapsed, fade);

  var bar_target: int32 = 0;
  if (g_hover == HOVER_BAR || g_pressed == HOVER_BAR) { bar_target = 255; }
  if (g_osd_alpha == 0) { bar_target = 0; }
  g_bar_grow = approach(g_bar_grow, bar_target, elapsed, 130000);

  var volume_target: int32 = 0;
  if (g_hover == HOVER_VOLUME || g_hover == HOVER_VOLUME_TRACK) { volume_target = 255; }
  if (g_pressed == HOVER_VOLUME_TRACK) { volume_target = 255; }
  if (g_osd_alpha == 0) { volume_target = 0; }
  g_volume_grow = approach(g_volume_grow, volume_target, elapsed, 150000);

  var changed: int32 = 0;
  for control in 0..8 {
    var target: int32 = 0;
    if (g_hover == control && control != HOVER_NONE) { target = 255; }
    var before: int32 = g_hover_alpha[control];
    g_hover_alpha[control] = approach(before, target, elapsed, 110000);
    if (g_hover_alpha[control] != before) { changed = 1; }
  }

  if (g_osd_alpha != before_osd) { changed = 1; }
  if (g_bar_grow != before_bar) { changed = 1; }
  if (g_volume_grow != before_volume) { changed = 1; }
  if (flash_alpha() != before_flash) { changed = 1; }
  if (g_flash_kind != FLASH_NONE && flash_alpha() == 0) { g_flash_kind = FLASH_NONE; }
  return changed;
}

fn icon_play(canvas: Canvas*, x: float64, y: float64, scale: float64, color: uint32, alpha: int32) {
  paint_triangle(canvas, x - 6.0 * scale, y - 8.5 * scale,
                 x - 6.0 * scale, y + 8.5 * scale,
                 x + 9.0 * scale, y, color, alpha);
}

fn icon_pause(canvas: Canvas*, x: float64, y: float64, scale: float64, color: uint32, alpha: int32) {
  paint_round_rect(canvas, x - 6.8 * scale, y - 8.5 * scale, x - 2.2 * scale, y + 8.5 * scale,
                   1.6 * scale, color, alpha);
  paint_round_rect(canvas, x + 2.2 * scale, y - 8.5 * scale, x + 6.8 * scale, y + 8.5 * scale,
                   1.6 * scale, color, alpha);
}

fn icon_rewind(canvas: Canvas*, x: float64, y: float64, scale: float64, color: uint32, alpha: int32) {
  paint_triangle(canvas, x - 9.0 * scale, y, x - 1.0 * scale, y - 7.5 * scale,
                 x - 1.0 * scale, y + 7.5 * scale, color, alpha);
  paint_triangle(canvas, x - 1.0 * scale, y, x + 7.0 * scale, y - 7.5 * scale,
                 x + 7.0 * scale, y + 7.5 * scale, color, alpha);
}

fn icon_forward(canvas: Canvas*, x: float64, y: float64, scale: float64, color: uint32, alpha: int32) {
  paint_triangle(canvas, x + 9.0 * scale, y, x + 1.0 * scale, y - 7.5 * scale,
                 x + 1.0 * scale, y + 7.5 * scale, color, alpha);
  paint_triangle(canvas, x + 1.0 * scale, y, x - 7.0 * scale, y - 7.5 * scale,
                 x - 7.0 * scale, y + 7.5 * scale, color, alpha);
}

fn icon_volume(canvas: Canvas*, x: float64, y: float64, scale: float64, level: int32,
               muted: int32, color: uint32, alpha: int32) {
  paint_round_rect(canvas, x - 9.0 * scale, y - 3.2 * scale, x - 4.6 * scale, y + 3.2 * scale,
                   1.0 * scale, color, alpha);
  paint_triangle(canvas, x - 5.0 * scale, y, x - 0.5 * scale, y - 8.0 * scale,
                 x - 0.5 * scale, y + 8.0 * scale, color, alpha);
  if (muted != 0) {
    paint_capsule(canvas, x + 3.0 * scale, y - 4.6 * scale, x + 9.4 * scale, y + 1.8 * scale,
                  2.0 * scale, color, alpha);
    paint_capsule(canvas, x + 9.4 * scale, y - 4.6 * scale, x + 3.0 * scale, y + 1.8 * scale,
                  2.0 * scale, color, alpha);
    return;
  }
  if (level > 0) {
    paint_arc(canvas, x - 0.5 * scale, y, 4.4 * scale, 6.0 * scale, 1.0, color, alpha);
  }
  if (level >= 50) {
    paint_arc(canvas, x - 0.5 * scale, y, 7.6 * scale, 9.2 * scale, 1.0, color, alpha);
  }
}

fn icon_fullscreen(canvas: Canvas*, x: float64, y: float64, scale: float64, exiting: int32,
                   color: uint32, alpha: int32) {
  var outer: float64 = 8.6 * scale;
  var inner: float64 = 2.6 * scale;
  var thickness: float64 = 2.1 * scale;
  if (exiting != 0) {
    paint_capsule(canvas, x - inner, y - inner, x - outer, y - inner, thickness, color, alpha);
    paint_capsule(canvas, x - inner, y - inner, x - inner, y - outer, thickness, color, alpha);
    paint_capsule(canvas, x + inner, y - inner, x + outer, y - inner, thickness, color, alpha);
    paint_capsule(canvas, x + inner, y - inner, x + inner, y - outer, thickness, color, alpha);
    paint_capsule(canvas, x - inner, y + inner, x - outer, y + inner, thickness, color, alpha);
    paint_capsule(canvas, x - inner, y + inner, x - inner, y + outer, thickness, color, alpha);
    paint_capsule(canvas, x + inner, y + inner, x + outer, y + inner, thickness, color, alpha);
    paint_capsule(canvas, x + inner, y + inner, x + inner, y + outer, thickness, color, alpha);
    return;
  }
  paint_capsule(canvas, x - outer, y - outer, x - inner, y - outer, thickness, color, alpha);
  paint_capsule(canvas, x - outer, y - outer, x - outer, y - inner, thickness, color, alpha);
  paint_capsule(canvas, x + outer, y - outer, x + inner, y - outer, thickness, color, alpha);
  paint_capsule(canvas, x + outer, y - outer, x + outer, y - inner, thickness, color, alpha);
  paint_capsule(canvas, x - outer, y + outer, x - inner, y + outer, thickness, color, alpha);
  paint_capsule(canvas, x - outer, y + outer, x - outer, y + inner, thickness, color, alpha);
  paint_capsule(canvas, x + outer, y + outer, x + inner, y + outer, thickness, color, alpha);
  paint_capsule(canvas, x + outer, y + outer, x + outer, y + inner, thickness, color, alpha);
}

fn button_backdrop(canvas: Canvas*, x: int32, y: int32, control: int32, alpha: int32) {
  var lift: int32 = g_hover_alpha[control];
  if (lift <= 0) { return; }
  paint_circle(canvas, (float64)x, (float64)y, (float64)BUTTON_RADIUS,
               paint_rgb(255, 255, 255), 30 * lift / 255 * alpha / 255);
}

fn bar_position_at(x: int32) -> int64 {
  var span: int32 = g_bar_right - g_bar_left;
  if (span <= 0) { return 0; }
  var offset: int32 = x - g_bar_left;
  if (offset < 0) { offset = 0; }
  if (offset > span) { offset = span; }
  return g_duration_us * (int64)offset / (int64)span;
}

fn paint_progress(canvas: Canvas*, alpha: int32) {
  var thickness: float64 = 4.0 + 3.0 * (float64)g_bar_grow / 255.0;
  var half: float64 = thickness * 0.5;
  var center: float64 = (float64)g_bar_y;
  var left: float64 = (float64)g_bar_left;
  var right: float64 = (float64)g_bar_right;
  if (right <= left) { return; }

  paint_round_rect(canvas, left, center - half, right, center + half, half,
                   paint_rgb(255, 255, 255), 58 * alpha / 255);

  var played: float64 = 0.0;
  if (g_duration_us > 0) {
    played = (right - left) * (float64)g_position_us / (float64)g_duration_us;
  }
  if (played < 0.0) { played = 0.0; }
  if (played > right - left) { played = right - left; }
  if (played > 0.5) {
    paint_round_rect(canvas, left, center - half, left + played, center + half, half,
                     paint_rgb(255, 255, 255), alpha);
  }

  var handle: float64 = 7.5 * (float64)g_bar_grow / 255.0;
  if (g_pressed == HOVER_BAR) { handle = 8.5; }
  if (handle > 0.4) {
    paint_circle(canvas, left + played, center, handle + 1.6, paint_rgb(0, 0, 0),
                 70 * alpha / 255);
    paint_circle(canvas, left + played, center, handle, paint_rgb(255, 255, 255), alpha);
  }
}

fn paint_volume(canvas: Canvas*, alpha: int32) {
  if (g_volume_grow <= 4) { return; }
  if (g_audio == 0 || g_audio->ready == 0) { return; }
  var left: float64 = (float64)g_volume_left;
  var right: float64 = (float64)g_volume_right;
  if (right - left < 4.0) { return; }
  var center: float64 = (float64)g_row_y;
  var faded: int32 = alpha * g_volume_grow / 255;

  paint_round_rect(canvas, left, center - 1.6, right, center + 1.6, 1.6,
                   paint_rgb(255, 255, 255), 70 * faded / 255);
  var level: int32 = g_audio->volume;
  if (g_audio->muted != 0) { level = 0; }
  var filled: float64 = (right - left) * (float64)level / 100.0;
  if (filled > 0.5) {
    paint_round_rect(canvas, left, center - 1.6, left + filled, center + 1.6, 1.6,
                     paint_rgb(255, 255, 255), faded);
  }
  paint_circle(canvas, left + filled, center, 5.0, paint_rgb(255, 255, 255), faded);
}

fn paint_flash(canvas: Canvas*, client: UiRect*) {
  var alpha: int32 = flash_alpha();
  if (alpha <= 0) { return; }
  var center_x: float64 = (float64)(client->right - client->left) * 0.5;
  var center_y: float64 = (float64)(client->bottom - client->top) * 0.5;
  var grow: float64 = 1.0 + 0.35 * (1.0 - (float64)alpha / 255.0);
  var half: float64 = 38.0 * grow;
  paint_round_rect(canvas, center_x - half, center_y - half, center_x + half, center_y + half,
                   half * 0.42, paint_rgb(0, 0, 0), 120 * alpha / 255);

  var white: uint32 = paint_rgb(255, 255, 255);
  var scale: float64 = 1.5 * grow;
  if (g_flash_kind == FLASH_PLAY) { icon_play(canvas, center_x, center_y, scale, white, alpha); }
  if (g_flash_kind == FLASH_PAUSE) { icon_pause(canvas, center_x, center_y, scale, white, alpha); }
  if (g_flash_kind == FLASH_FORWARD) { icon_forward(canvas, center_x, center_y, scale, white, alpha); }
  if (g_flash_kind == FLASH_BACK) { icon_rewind(canvas, center_x, center_y, scale, white, alpha); }
  if (g_flash_kind == FLASH_VOLUME || g_flash_kind == FLASH_MUTED) {
    var level: int32 = 0;
    var muted: int32 = 1;
    if (g_audio != 0) {
      level = g_audio->volume;
      muted = g_audio->muted;
    }
    icon_volume(canvas, center_x, center_y - 8.0 * grow, scale, level, muted, white, alpha);
    var track_half: float64 = 26.0 * grow;
    var track_y: float64 = center_y + 22.0 * grow;
    paint_round_rect(canvas, center_x - track_half, track_y - 2.0, center_x + track_half,
                     track_y + 2.0, 2.0, white, 90 * alpha / 255);
    var shown: int32 = level;
    if (muted != 0) { shown = 0; }
    var filled: float64 = track_half * 2.0 * (float64)shown / 100.0;
    if (filled > 1.0) {
      paint_round_rect(canvas, center_x - track_half, track_y - 2.0,
                       center_x - track_half + filled, track_y + 2.0, 2.0, white, alpha);
    }
  }
}

fn paint_overlay(canvas: Canvas*, client: UiRect*) {
  if (canvas->pixels == 0) { return; }
  var alpha: int32 = g_osd_alpha;
  if (alpha <= 0) {
    paint_flash(canvas, client);
    return;
  }
  var width: int32 = client->right - client->left;
  var height: int32 = client->bottom - client->top;
  var black: uint32 = paint_rgb(0, 0, 0);
  var white: uint32 = paint_rgb(255, 255, 255);

  paint_gradient(canvas, 0, height - OSD_SCRIM_HEIGHT, width, height, black,
                 0, 205 * alpha / 255, 2);
  if (g_fullscreen != 0) {
    paint_gradient(canvas, 0, 0, width, OSD_TITLE_HEIGHT, black, 175 * alpha / 255, 0, 2);
  }

  paint_progress(canvas, alpha);

  var icon: int32 = 240 * alpha / 255;
  button_backdrop(canvas, g_play_x, g_row_y, HOVER_PLAY, alpha);
  if (g_playing != 0) {
    icon_pause(canvas, (float64)g_play_x, (float64)g_row_y, 1.0, white, icon);
  } else {
    icon_play(canvas, (float64)g_play_x, (float64)g_row_y, 1.0, white, icon);
  }

  if (g_back_x > 0) {
    button_backdrop(canvas, g_back_x, g_row_y, HOVER_BACK, alpha);
    icon_rewind(canvas, (float64)g_back_x, (float64)g_row_y, 1.0, white, icon);
    button_backdrop(canvas, g_forward_x, g_row_y, HOVER_FORWARD, alpha);
    icon_forward(canvas, (float64)g_forward_x, (float64)g_row_y, 1.0, white, icon);
  }

  if (g_audio != 0 && g_audio->ready != 0) {
    button_backdrop(canvas, g_volume_x, g_row_y, HOVER_VOLUME, alpha);
    icon_volume(canvas, (float64)g_volume_x, (float64)g_row_y, 1.0, g_audio->volume,
                g_audio->muted, white, icon);
    paint_volume(canvas, alpha);
  }

  button_backdrop(canvas, g_fullscreen_x, g_row_y, HOVER_FULLSCREEN, alpha);
  icon_fullscreen(canvas, (float64)g_fullscreen_x, (float64)g_row_y, 1.0, g_fullscreen,
                  white, icon);

  paint_flash(canvas, client);
}

fn text_width(hdc: int64, text: cstring, length: int32) -> int32 {
  var size: UiSize;
  size.width = 0;
  size.height = 0;
  Gdi_TextExtentA(hdc, text, length, &size);
  return size.width;
}

fn fade_grey(level: int32, alpha: int32) -> uint32 {
  var value: uint32 = (uint32)(level * alpha / 255);
  return ui_rgb(value, value, value);
}

fn paint_tooltip(canvas: Canvas*, hdc: int64, client: UiRect*, alpha: int32) {
  if (alpha <= 0) { return; }
  var text: uint8[64];
  var length: int32 = append_clock(&text[0], 0, bar_position_at(g_mouse_x));
  text[length] = (uint8)0;
  var measured: int32 = text_width(hdc, (cstring)&text[0], length);
  var half: int32 = measured / 2 + 11;
  var center: int32 = g_mouse_x;
  var limit: int32 = client->right - client->left;
  if (center - half < 6) { center = half + 6; }
  if (center + half > limit - 6) { center = limit - 6 - half; }
  var bottom: int32 = g_bar_y - 18;
  paint_round_rect(canvas, (float64)(center - half), (float64)(bottom - 26),
                   (float64)(center + half), (float64)bottom, 6.0,
                   paint_rgb(0, 0, 0), 205 * alpha / 255);
  var saved: int64 = 0;
  if (g_osd_font != 0) { saved = ui_select_object(hdc, g_osd_font); }
  ui_set_text_transparent(hdc);
  ui_draw_text_transparent(hdc, center - measured / 2, bottom - 22, (cstring)&text[0],
                           fade_grey(240, alpha));
  if (saved != 0) { ui_select_object(hdc, saved); }
}

fn paint_overlay_text(canvas: Canvas*, hdc: int64, client: UiRect*) {
  var alpha: int32 = g_osd_alpha;
  if (alpha <= 0) { return; }
  var saved: int64 = 0;
  if (g_osd_font != 0) { saved = ui_select_object(hdc, g_osd_font); }
  ui_set_text_transparent(hdc);

  var current: uint8[64];
  var current_length: int32 = append_clock(&current[0], 0, g_position_us);
  current[current_length] = (uint8)0;
  var total: uint8[80];
  var total_length: int32 = append_text(&total[0], 0, " / ");
  total_length = append_clock(&total[0], total_length, g_duration_us);
  total[total_length] = (uint8)0;

  var baseline: int32 = g_row_y - 10;
  ui_draw_text_transparent(hdc, g_time_x, baseline, (cstring)&current[0], fade_grey(245, alpha));
  var advance: int32 = text_width(hdc, (cstring)&current[0], current_length);
  ui_draw_text_transparent(hdc, g_time_x + advance, baseline, (cstring)&total[0],
                           fade_grey(155, alpha));

  if (g_fullscreen != 0 && g_title_length > 0) {
    var title_saved: int64 = 0;
    if (g_title_font != 0) { title_saved = ui_select_object(hdc, g_title_font); }
    ui_set_text_color(hdc, fade_grey(245, alpha));
    Gdi_TextOutW(hdc, OSD_MARGIN + 4, 26, &g_title_wide[0], g_title_length);
    if (title_saved != 0) { ui_select_object(hdc, title_saved); }
  }

  if (saved != 0) { ui_select_object(hdc, saved); }

  var tooltip: int32 = 0;
  if (g_hover == HOVER_BAR) { tooltip = alpha; }
  if (g_pressed == HOVER_BAR) { tooltip = alpha; }
  if (tooltip > 0) { paint_tooltip(canvas, hdc, client, tooltip); }
}

fn paint_window(hdc: int64, canvas: Canvas*) {
  var client: UiRect = ui_window_client_rect(g_window);
  compute_destination(&client);
  paint_letterbox(hdc, &client);
  paint_picture(hdc);
  compute_layout(&client);
  Gdi_GdiFlush();
  paint_overlay(canvas, &client);
  paint_overlay_text(canvas, hdc, &client);
}

fn back_buffer_release() {
  if (g_back_dc != 0) {
    if (g_back_previous != 0) { ui_select_object(g_back_dc, g_back_previous); }
    Gdi_DeleteDC(g_back_dc);
    g_back_dc = 0;
    g_back_previous = 0;
  }
  if (g_back_bitmap != 0) {
    ui_delete_object(g_back_bitmap);
    g_back_bitmap = 0;
  }
  g_back_pixels = 0;
  g_back_width = 0;
  g_back_height = 0;
}

fn back_buffer_ready(hdc: int64, width: int32, height: int32) -> int32 {
  if (width <= 0 || height <= 0) { return 0; }
  if (g_back_dc != 0 && g_back_width == width && g_back_height == height) { return 1; }
  back_buffer_release();
  g_back_dc = Gdi_CreateCompatibleDC(hdc);
  if (g_back_dc == 0) { return 0; }
  var info: BitmapInfoHeader;
  info.size = (uint32)40;
  info.width = width;
  info.height = 0 - height;
  info.planes = (uint16)1;
  info.bit_count = (uint16)32;
  info.compression = (uint32)0;
  info.size_image = (uint32)0;
  info.x_pels_per_meter = 0;
  info.y_pels_per_meter = 0;
  info.clr_used = (uint32)0;
  info.clr_important = (uint32)0;
  var bits: rawptr = 0;
  g_back_bitmap = Gdi_CreateDIBSection(g_back_dc, &info, (uint32)0, &bits, 0, (uint32)0);
  if (g_back_bitmap == 0 || bits == 0) {
    Gdi_DeleteDC(g_back_dc);
    g_back_dc = 0;
    g_back_bitmap = 0;
    return 0;
  }
  g_back_pixels = (uint32*)bits;
  g_back_previous = ui_select_object(g_back_dc, g_back_bitmap);
  g_back_width = width;
  g_back_height = height;
  return 1;
}

fn paint_buffered(hdc: int64) {
  var client: UiRect = ui_window_client_rect(g_window);
  var width: int32 = client.right - client.left;
  var height: int32 = client.bottom - client.top;
  var canvas: Canvas;
  canvas.pixels = 0;
  canvas.width = width;
  canvas.height = height;
  if (back_buffer_ready(hdc, width, height) == 0) {
    paint_window(hdc, &canvas);
    return;
  }
  canvas.pixels = g_back_pixels;
  paint_window(g_back_dc, &canvas);
  Gdi_BitBlt(hdc, 0, 0, width, height, g_back_dc, 0, 0, (uint32)0x00CC0020);
}

fn present() {
  var hdc: int64 = Ui_GetDC(g_window);
  if (hdc == 0) { return; }
  paint_buffered(hdc);
  Ui_ReleaseDC(g_window, hdc);
}

fn show_frame(index: int32) {
  if (index == g_displayed_frame) { return; }
  if (decode_frame(index) == 0) {
    g_displayed_frame = index;
    g_decode_failures = g_decode_failures + (int64)1;
    present();
    return;
  }
  if (index > g_displayed_frame + 1) {
    g_dropped = g_dropped + (int64)(index - g_displayed_frame - 1);
  }
  g_displayed_frame = index;
  g_present_count = g_present_count + (int64)1;
  present();
}

fn wake_osd() {
  g_osd_until_us = now_microseconds() + (int64)OSD_HOLD_US;
  if (g_cursor_hidden != 0) {
    Win_ShowCursor(1);
    g_cursor_hidden = 0;
  }
}

fn set_playing(playing: int32) {
  if (playing == g_playing) { return; }
  if (playing != 0 && g_position_us >= g_duration_us) {
    g_playing = 1;
    seek_to(0);
    audio_resume(g_audio);
    return;
  }
  g_playing = playing;
  if (playing != 0) { flash_show(FLASH_PLAY); } else { flash_show(FLASH_PAUSE); }
  if (playing != 0) {
    g_clock_base_us = g_position_us;
    g_clock_start_us = now_microseconds();
    audio_resume(g_audio);
  } else {
    audio_pause(g_audio);
  }
  present();
}

fn seek_to(microseconds: int64) {
  var target: int64 = microseconds;
  if (target < 0) { target = 0; }
  if (target > g_duration_us) { target = g_duration_us; }
  g_position_us = target;
  g_clock_base_us = target;
  g_clock_start_us = now_microseconds();
  audio_seek(g_audio, g_file, target);
  var index: int32 = frame_at_position(target);
  if (index != g_displayed_frame) {
    decode_frame(index);
  }
  g_displayed_frame = index;
  g_present_count = g_present_count + (int64)1;
  present();
}

fn nudge_position(delta: int64) {
  if (delta >= 0) { flash_show(FLASH_FORWARD); } else { flash_show(FLASH_BACK); }
  seek_to(g_position_us + delta);
}

fn step_frames(delta: int32) {
  var index: int32 = frame_at_position(g_position_us) + delta;
  if (index < 0) { index = 0; }
  if (index >= g_file->video_frame_count) { index = g_file->video_frame_count - 1; }
  set_playing(0);
  seek_to(source_video_time_us(g_file, index));
}

fn update_playback() {
  var use_audio: int32 = 0;
  if (g_audio->ready != 0 && g_audio->finished == 0 && g_playing != 0) { use_audio = 1; }

  if (use_audio != 0) {
    var audio_position: int64 = audio_position_microseconds(g_audio);
    if (audio_position < 0) { audio_position = 0; }
    g_position_us = audio_position;
    g_clock_base_us = audio_position;
    g_clock_start_us = now_microseconds();
  } else if (g_playing != 0) {
    g_position_us = g_clock_base_us + (now_microseconds() - g_clock_start_us);
  }

  if (g_position_us >= g_duration_us) {
    g_position_us = g_duration_us;
    if (g_playing != 0) {
      set_playing(0);
      wake_osd();
    }
  }

  show_frame(frame_at_position(g_position_us));

  if (g_playing != 0 && g_osd_alpha == 0 && g_pointer_inside != 0 && g_cursor_hidden == 0) {
    Win_ShowCursor(0);
    g_cursor_hidden = 1;
  }
}

fn seek_from_mouse(x: int32) {
  seek_to(bar_position_at(x));
}

fn volume_from_mouse(x: int32) {
  if (g_audio == 0) { return; }
  var span: int32 = g_volume_right - g_volume_left;
  if (span <= 0) { return; }
  var offset: int32 = x - g_volume_left;
  if (offset < 0) { offset = 0; }
  if (offset > span) { offset = span; }
  if (g_audio->muted != 0) { audio_toggle_mute(g_audio); }
  audio_set_volume(g_audio, offset * 100 / span);
}

fn toggle_fullscreen() {
  if (g_fullscreen == 0) {
    var window: UiRect = ui_window_rect(g_window);
    g_saved_left = window.left;
    g_saved_top = window.top;
    g_saved_width = window.right - window.left;
    g_saved_height = window.bottom - window.top;
    g_saved_style = Ui_GetWindowLongPtrA(g_window, GWL_STYLE);

    var monitor: int64 = Win_MonitorFromWindow(g_window, (uint32)MONITOR_DEFAULTTONEAREST);
    var info: MonitorInfo;
    info.size = (uint32)sizeof(MonitorInfo);
    if (Win_GetMonitorInfoA(monitor, &info) == 0) { return; }

    Ui_SetWindowLongPtrA(g_window, GWL_STYLE, g_saved_style & ~(int64)UI_WS_OVERLAPPEDWINDOW());
    Ui_SetWindowPos(g_window, 0, info.monitor.left, info.monitor.top,
                    info.monitor.right - info.monitor.left,
                    info.monitor.bottom - info.monitor.top,
                    (uint32)(SWP_FRAMECHANGED | SWP_NOOWNERZORDER));
    g_fullscreen = 1;
  } else {
    Ui_SetWindowLongPtrA(g_window, GWL_STYLE, g_saved_style);
    Ui_SetWindowPos(g_window, 0, g_saved_left, g_saved_top, g_saved_width, g_saved_height,
                    (uint32)(SWP_FRAMECHANGED | SWP_NOOWNERZORDER));
    g_fullscreen = 0;
    if (g_cursor_hidden != 0) {
      Win_ShowCursor(1);
      g_cursor_hidden = 0;
    }
  }
  g_dest_width = -1;
  wake_osd();
  present();
}

fn handle_key(key: int64) {
  wake_osd();
  if (key == 32 || key == 75) {
    if (g_playing != 0) { set_playing(0); } else { set_playing(1); }
    return;
  }
  if (key == 39) { nudge_position((int64)SEEK_STEP_US); return; }
  if (key == 37) { nudge_position(0 - (int64)SEEK_STEP_US); return; }
  if (key == 76) { nudge_position((int64)SEEK_LONG_US); return; }
  if (key == 74) { nudge_position(0 - (int64)SEEK_LONG_US); return; }
  if (key == 38) {
    if (g_audio->muted != 0) { audio_toggle_mute(g_audio); }
    audio_set_volume(g_audio, g_audio->volume + 5);
    flash_show(FLASH_VOLUME);
    present();
    return;
  }
  if (key == 40) {
    audio_set_volume(g_audio, g_audio->volume - 5);
    flash_show(FLASH_VOLUME);
    present();
    return;
  }
  if (key == 77) {
    audio_toggle_mute(g_audio);
    flash_show(FLASH_MUTED);
    present();
    return;
  }
  if (key == 36) { seek_to(0); return; }
  if (key == 35) { seek_to(g_duration_us); return; }
  if (key == 190) { step_frames(1); return; }
  if (key == 188) { step_frames(-1); return; }
  if (key == 70 || key == 122) { toggle_fullscreen(); return; }
  if (key == 27) {
    if (g_fullscreen != 0) { toggle_fullscreen(); return; }
    g_running = 0;
    ui_window_close(g_window);
    return;
  }
  if (key == 81) {
    g_running = 0;
    ui_window_close(g_window);
    return;
  }
}

fn window_proc(hwnd: int64, msg: uint32, wparam: int64, lparam: int64) -> int64 {
  if (msg == UI_WM_ERASEBKGND()) { return 1; }

  if (msg == UI_WM_PAINT()) {
    var paint: UiPaintStruct;
    var hdc: int64 = ui_begin_paint(hwnd, &paint);
    g_dest_width = -1;
    paint_buffered(hdc);
    ui_end_paint(hwnd, &paint);
    return 0;
  }

  if (msg == UI_WM_SIZE()) {
    g_dest_width = -1;
    present();
    return 0;
  }

  if (msg == UI_WM_KEYDOWN()) {
    handle_key(wparam);
    return 0;
  }

  if (msg == UI_WM_MOUSEMOVE()) {
    var moved: int32 = 0;
    if (ui_mouse_x(lparam) != g_mouse_x || ui_mouse_y(lparam) != g_mouse_y) { moved = 1; }
    g_mouse_x = ui_mouse_x(lparam);
    g_mouse_y = ui_mouse_y(lparam);
    if (g_pointer_inside == 0) {
      var track: TrackMouse;
      track.size = (uint32)sizeof(TrackMouse);
      track.flags = (uint32)2;
      track.target = hwnd;
      track.hover_time = (uint32)0;
      Win_TrackMouseEvent(&track);
      g_pointer_inside = 1;
    }
    if (moved != 0) { wake_osd(); }
    if (g_pressed == HOVER_BAR) {
      seek_from_mouse(g_mouse_x);
    } else if (g_pressed == HOVER_VOLUME_TRACK) {
      volume_from_mouse(g_mouse_x);
      present();
    } else {
      g_hover = hover_at(g_mouse_x, g_mouse_y);
    }
    return 0;
  }

  if (msg == WM_MOUSELEAVE) {
    g_pointer_inside = 0;
    g_hover = HOVER_NONE;
    return 0;
  }

  if (msg == UI_WM_LBUTTONDOWN()) {
    var x: int32 = ui_mouse_x(lparam);
    var y: int32 = ui_mouse_y(lparam);
    g_mouse_x = x;
    g_mouse_y = y;
    wake_osd();
    var target: int32 = hover_at(x, y);
    g_hover = target;
    if (target == HOVER_BAR || target == HOVER_VOLUME_TRACK) {
      g_pressed = target;
      g_scrubbing = 1;
      Win_SetCapture(hwnd);
      if (target == HOVER_BAR) { seek_from_mouse(x); } else { volume_from_mouse(x); }
      present();
      return 0;
    }
    if (target != HOVER_NONE) {
      g_pressed = target;
      return 0;
    }
    if (g_osd_alpha > 200 && y > g_bar_y - 24) { return 0; }
    if (g_playing != 0) { set_playing(0); } else { set_playing(1); }
    return 0;
  }

  if (msg == UI_WM_LBUTTONUP()) {
    var x: int32 = ui_mouse_x(lparam);
    var y: int32 = ui_mouse_y(lparam);
    if (g_scrubbing != 0) {
      g_scrubbing = 0;
      Win_ReleaseCapture();
    }
    var released: int32 = g_pressed;
    g_pressed = HOVER_NONE;
    if (released != HOVER_NONE && released == hover_at(x, y)) {
      if (released == HOVER_PLAY) {
        if (g_playing != 0) { set_playing(0); } else { set_playing(1); }
      }
      if (released == HOVER_BACK) { nudge_position(0 - (int64)SEEK_STEP_US); }
      if (released == HOVER_FORWARD) { nudge_position((int64)SEEK_STEP_US); }
      if (released == HOVER_VOLUME) {
        audio_toggle_mute(g_audio);
        flash_show(FLASH_MUTED);
        present();
      }
      if (released == HOVER_FULLSCREEN) { toggle_fullscreen(); }
    }
    g_hover = hover_at(x, y);
    return 0;
  }

  if (msg == UI_WM_LBUTTONDBLCLK()) {
    var y: int32 = ui_mouse_y(lparam);
    if (g_osd_alpha > 200 && y > g_bar_y - 24) { return 0; }
    toggle_fullscreen();
    return 0;
  }

  if (msg == UI_WM_MOUSEWHEEL()) {
    var delta: int32 = (int32)((wparam >> 16) & 0xFFFF);
    if (delta >= 32768) { delta = delta - 65536; }
    if (g_audio->muted != 0 && delta > 0) { audio_toggle_mute(g_audio); }
    audio_set_volume(g_audio, g_audio->volume + delta / 120 * 5);
    flash_show(FLASH_VOLUME);
    wake_osd();
    present();
    return 0;
  }

  if (msg == UI_WM_DESTROY()) {
    g_running = 0;
    ui_quit(0);
    return 0;
  }

  return ui_def_window_proc_auto(hwnd, msg, wparam, lparam);
}

fn initial_window_size(video_width: int32, video_height: int32, out_width: int32*, out_height: int32*) {
  var screen_width: int32 = win32_get_system_metrics(SM_CXSCREEN());
  var screen_height: int32 = win32_get_system_metrics(SM_CYSCREEN());
  var limit_width: int32 = screen_width * 8 / 10;
  var limit_height: int32 = screen_height * 8 / 10;
  var width: int32 = video_width;
  var height: int32 = video_height;
  if (width > limit_width) {
    height = height * limit_width / width;
    width = limit_width;
  }
  if (height > limit_height) {
    width = width * limit_height / height;
    height = limit_height;
  }
  if (width < 320) { width = 320; }
  if (height < 240) { height = 240; }

  var rect: UiRect = ui_make_rect(0, 0, width, height);
  Win_AdjustWindowRect(&rect, UI_WS_OVERLAPPEDWINDOW(), 0);
  *out_width = rect.right - rect.left;
  *out_height = rect.bottom - rect.top;
}

fn file_name_of(path: cstring) -> cstring {
  var last: int64 = -1;
  var i: int64 = 0;
  while (path[i] != (uint8)0) {
    if (path[i] == (uint8)47 || path[i] == (uint8)92) { last = i; }
    i = i + 1;
  }
  return &path[last + 1];
}

fn release_decoders() {
  back_buffer_release();
  if (g_video != 0) { h264_video_free(g_video); g_video = 0; }
  if (g_parser != 0) { h264_decoder_free(g_parser); g_parser = 0; }
  if (g_ring != 0) { h264_gpu_host_free((uint8*)g_ring); g_ring = 0; }
}

fn widen_text(input: cstring, output: uint16*, capacity: int32) -> int32 {
  var written: int32 = 0;
  var i: int64 = 0;
  while (input[i] != (uint8)0 && written + 2 < capacity) {
    var code: int32 = (int32)input[i];
    i = i + 1;
    var extra: int32 = 0;
    if (code >= 240) { code = code & 7; extra = 3; }
    else if (code >= 224) { code = code & 15; extra = 2; }
    else if (code >= 192) { code = code & 31; extra = 1; }
    while (extra > 0) {
      var next: int32 = (int32)input[i];
      if ((next & 192) != 128) { break; }
      code = (code << 6) | (next & 63);
      i = i + 1;
      extra = extra - 1;
    }
    if (code >= 65536) {
      var value: int32 = code - 65536;
      output[written] = (uint16)(55296 + (value >> 10));
      output[written + 1] = (uint16)(56320 + (value & 1023));
      written = written + 2;
    } else {
      output[written] = (uint16)code;
      written = written + 1;
    }
  }
  output[written] = (uint16)0;
  return written;
}

fn report(message: string) {
  var text: cstring = cstr(message, malloc);
  if (text == 0) { return; }
  Ui_MessageBoxA(0, text, "Player", (uint32)48);
  free(text);
}

fn report_cstr(prefix: string, tail: cstring) {
  var length: int64 = 0;
  while (tail[length] != 0) { length = length + 1; }
  var total: int64 = (int64)prefix.length + length + 1;
  var text: cstring = malloc(total);
  if (text == 0) { report(prefix); return; }
  var source: cstring = prefix.chars;
  var i: int64 = 0;
  while (i < (int64)prefix.length) { text[i] = source[i]; i = i + 1; }
  var j: int64 = 0;
  while (j < length) { text[i + j] = tail[j]; j = j + 1; }
  text[i + length] = 0;
  Ui_MessageBoxA(0, text, "Player", (uint32)48);
  free(text);
}

fn print_usage() {
  report("Open a video file with this player, or pass one on the command line.\n\nIt plays H.264 and Motion JPEG video with AAC or PCM audio, from AVI, MP4 and MOV.\n\ncontrols\n  space or K     play and pause\n  left / right   seek 5 seconds\n  J / L          seek 30 seconds\n  , / .          step one frame\n  home / end     start and end\n  up / down      volume, mouse wheel does the same\n  M              mute\n  F or F11       fullscreen, double click does the same\n  click the bar  seek, drag to scrub\n  esc or Q       quit");
}

fn main(argc: int32, argv: cstring*) -> int32 {
  if (argc < 2) {
    print_usage();
    return 0;
  }

  Win_AttachConsole((uint32)4294967295);

  Win_QueryPerformanceFrequency(&g_qpc_frequency);
  if (g_qpc_frequency <= 0) { g_qpc_frequency = 1; }

  var status: int32 = 0;
  g_file = source_open(argv[1], &status);
  if (g_file == 0) {
    if (status == SOURCE_ERR_OPEN) { report_cstr("No such file: ", argv[1]); }
    else if (status == SOURCE_ERR_FORMAT) { report_cstr("Not an AVI, MP4 or MOV file: ", argv[1]); }
    else if (status == SOURCE_ERR_NO_VIDEO) { report_cstr("No video track in ", argv[1]); }
    else { report_cstr("Cannot open ", argv[1]); }
    return 1;
  }
  defer source_close(g_file);

  if (g_file->video_codec == SOURCE_VIDEO_UNKNOWN) {
    report("This file carries video this player cannot decode.");
    return 1;
  }

  g_decoder = jpeg_decoder_new();
  if (g_decoder == 0) { return 1; }
  defer jpeg_decoder_free(g_decoder);

  if (g_file->video_codec == SOURCE_VIDEO_H264) {
    g_parser = h264_decoder_new();
    if (g_parser == 0) { return 1; }
    if (h264_read_config(g_parser, g_file->codec_config, g_file->codec_config_size) != H264_OK) {
      report("The H.264 parameter sets in this file cannot be read.");
      return 1;
    }
    var missing: cstring = h264_unsupported_reason(g_parser);
    if (missing != 0) {
      report_cstr("This file needs ", missing);
      return 1;
    }
    g_video = h264_video_new(g_parser);
    if (g_video == 0) { return 1; }
  }
  defer release_decoders();

  g_frame_capacity = (int64)g_file->max_video_size;
  g_frame_buffer = malloc(g_frame_capacity);
  if (g_frame_buffer == 0) { return 1; }
  defer free(g_frame_buffer);

  g_audio = audio_open(g_file);
  if (g_audio == 0) { return 1; }
  defer audio_close(g_audio);

  g_duration_us = g_file->duration_us;

  print(source_container_name(g_file));
  print(", ");
  print(source_video_codec_name(g_file));
  print(" {g_file->width}x{g_file->height}, {g_file->video_frame_count} frames");
  if (g_audio->ready != 0) {
    println(", audio {g_file->audio_channels} ch {g_file->audio_sample_rate} Hz");
  } else if (g_file->audio_codec == SOURCE_AUDIO_AAC) {
    println(", AAC audio unavailable");
  } else if (source_has_audio(g_file) != 0) {
    println(", audio device unavailable");
  } else {
    println(", no audio");
  }

  var window_width: int32 = 0;
  var window_height: int32 = 0;
  initial_window_size(g_file->width, g_file->height, &window_width, &window_height);

  var wide_title: uint16[512];
  widen_text(file_name_of(argv[1]), &wide_title[0], 512);

  g_window = ui_window_create_centered_unicode(&wide_title[0], window_width, window_height,
                                               &window_proc);
  if (g_window == 0) {
    report("The player could not create its window.");
    return 1;
  }
  Win_SetWindowTextW(g_window, &wide_title[0]);
  g_title_length = widen_text(file_name_of(argv[1]), &g_title_wide[0], 512);
  g_osd_font = ui_create_font(15, "Segoe UI", 600);
  g_title_font = ui_create_font(19, "Segoe UI", UI_FW_NORMAL());
  g_animation_us = now_microseconds();
  ui_window_show(g_window);
  wake_osd();

  decode_frame(0);
  g_displayed_frame = 0;
  present();

  g_clock_base_us = 0;
  g_clock_start_us = now_microseconds();
  audio_seek(g_audio, g_file, 0);

  var message: UiMsg;
  while (g_running != 0) {
    while (Ui_PeekMessageA(&message, 0, 0, 0, UI_PM_REMOVE()) != 0) {
      if (message.message == UI_WM_QUIT()) {
        g_running = 0;
        break;
      }
      Ui_TranslateMessage(&message);
      Ui_DispatchMessageA(&message);
    }
    if (g_running == 0) { break; }

    if (g_playing != 0) {
      audio_pump(g_audio, g_file);
    }
    update_playback();
    if (g_playing != 0 && g_file->video_codec == SOURCE_VIDEO_H264) {
      var upcoming: int32 = frame_at_position(g_position_us) + 1;
      if (upcoming < g_file->video_frame_count) {
        var slack: int64 = source_video_time_us(g_file, upcoming) - g_position_us;
        if (slack > (int64)24000) { decode_ahead(); }
      }
    }
    if (animation_step() != 0) {
      var since: int64 = now_microseconds() - g_last_present_us;
      if (since >= (int64)14000) {
        g_last_present_us = now_microseconds();
        present();
      }
    }
    if (g_playing != 0 && now_microseconds() >= g_report_at_us) {
      var shown: int32 = g_displayed_frame - g_last_report_frame;
      println("t {g_position_us} shown {shown} present {g_present_count} dropped {g_dropped} miss {g_ring_miss} reset {g_resets} decoded {g_samples_decoded} worst {g_worst_decode_us}");
      g_last_report_frame = g_displayed_frame;
      g_report_at_us = now_microseconds() + (int64)2000000;
    }
    win32_sleep_ms((uint32)1);
  }

  if (g_cursor_hidden != 0) { Win_ShowCursor(1); }
  if (g_osd_font != 0) { ui_delete_object(g_osd_font); }
  if (g_title_font != 0) { ui_delete_object(g_title_font); }
  back_buffer_release();
  println("played to {g_position_us / 1000000} s, {g_dropped} frames skipped");
  if (g_decode_failures > 0) {
    println("{g_decode_failures} frames failed to decode");
  }
  println("ring misses {g_ring_miss}, decoder resets {g_resets}, samples decoded {g_samples_decoded}");
  println("worst decode call {g_worst_decode_us} us, worst batch {g_worst_batch} samples");
  return 0;
}
