const SEEK_STEP_US = 5000000;
const SEEK_LONG_US = 30000000;
const OSD_HOLD_US = 2600000;
const OSD_BAND_HEIGHT = 108;
const OSD_MARGIN = 22;
const OSD_SCRIM_HEIGHT = 176;
const OSD_TITLE_HEIGHT = 96;
const BUTTON_RADIUS = 19;
const BUTTON_STEP = 44;
const VOLUME_TRACK = 68;
const FLASH_HOLD_US = 620000;
const WM_MOUSELEAVE = 0x02A3;
