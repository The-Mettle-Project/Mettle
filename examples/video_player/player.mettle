const FLASH_BACK = 4;
const FLASH_VOLUME = 5;
const FLASH_MUTED = 6;
const GWL_STYLE = -16;
const SWP_FRAMECHANGED = 0x0020;
const SWP_NOOWNERZORDER = 0x0200;
const MONITOR_DEFAULTTONEAREST = 2;
const FRAME_RING = 16;
const RING_TARGET_AHEAD = 6;

struct BitmapInfoHeader {
  size: uint32;
  width: int32;
  height: int32;
  planes: uint16;
  bit_count: uint16;
  compression: uint32;
  size_image: uint32;
  x_pels_per_meter: int32;
  y_pels_per_meter: int32;
  clr_used: uint32;
  clr_important: uint32;
}

struct TrackMouse {
  size: uint32;
  flags: uint32;
  target: int64;
  hover_time: uint32;
}

struct MonitorInfo {
  size: uint32;
  monitor: UiRect;
  work: UiRect;
  flags: uint32;
}

